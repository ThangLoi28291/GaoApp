{
  "ConnectionStrings": { "DefaultConnection": "" },
  "DataProtection": {
    "KeysPath": "", "RequirePortableKeys": true,
    "CertificatePath": "", "CertificatePassword": ""
  },
  "SeedData": { "EnableDemoSeed": false, "EnableDefaultAdminSeed": false },
  "ProductionBootstrap": { "Enabled": false },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
