{
  "DOTNET_ENVIRONMENT": "Production",
  "ASPNETCORE_ENVIRONMENT": "Production",
  "ConnectionStrings__DefaultConnection": "",
  "AppUrl__BaseUrl": "https://staging.example.com",
  "AppUrl__AdminUrl": "https://admin.staging.example.com",
  "Tenant__RootDomain": "staging.example.com",
  "Tenant__AdminSubdomain": "admin",
  "AllowedHosts": "staging.example.com;admin.staging.example.com;*.staging.example.com",
  "Storage__UploadRoot": "CHANGE_ME_ABSOLUTE_EXTERNAL_UPLOAD_DIRECTORY",
  "Storage__CreateIfMissing": "false",
  "DataProtection__KeysPath": "CHANGE_ME_ABSOLUTE_EXTERNAL_KEY_DIRECTORY",
  "DataProtection__RequirePortableKeys": "true",
  "DataProtection__CertificatePath": "CHANGE_ME_ABSOLUTE_EXTERNAL_PFX_PATH",
  "DataProtection__CertificatePassword": "",
  "SeedData__EnableDemoSeed": "false",
  "SeedData__EnableDefaultAdminSeed": "false",
  "ProductionBootstrap__Enabled": "false",
  "Proxy__EnableForwardedHeaders": "true",
  "Proxy__KnownProxies__0": "127.0.0.1",
  "Proxy__KnownProxies__1": "::1",
  "TaxCodeLookup__Enabled": "false",
  "Serilog__WriteTo__1__Name": "File",
  "Serilog__WriteTo__1__Args__path": "CHANGE_ME_ABSOLUTE_EXTERNAL_LOG_PATH_web-.log",
  "Serilog__WriteTo__1__Args__rollingInterval": "Day",
  "Serilog__WriteTo__1__Args__fileSizeLimitBytes": "10485760",
  "Serilog__WriteTo__1__Args__retainedFileCountLimit": "14",
  "Serilog__WriteTo__1__Args__rollOnFileSizeLimit": "true",
  "Serilog__WriteTo__1__Args__shared": "true"
}
