<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="ChonThanh root to admin" stopProcessing="true">
            <match url="^$" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTP_HOST}" pattern="^chonthanh\.gaomart\.com\.vn(:\d+)?$" />
              <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            </conditions>
            <action type="Redirect" url="/admin" appendQueryString="true" redirectType="Found" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\GaoApp.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <directoryBrowse enabled="false" />
      <httpProtocol>
        <customHeaders><remove name="X-Powered-By" /></customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering>
          <!-- Supports the existing 50 MiB media limit plus multipart overhead. -->
          <requestLimits maxAllowedContentLength="67108864" />
          <hiddenSegments>
            <remove segment="App_Data" /><add segment="App_Data" />
            <remove segment="Logs" /><add segment="Logs" />
            <remove segment=".git" /><add segment=".git" />
            <remove segment=".env" /><add segment=".env" />
            <remove segment="appsettings.json" /><add segment="appsettings.json" />
          </hiddenSegments>
          <fileExtensions>
            <remove fileExtension=".pfx" /><add fileExtension=".pfx" allowed="false" />
            <remove fileExtension=".p12" /><add fileExtension=".p12" allowed="false" />
            <remove fileExtension=".pem" /><add fileExtension=".pem" allowed="false" />
            <remove fileExtension=".key" /><add fileExtension=".key" allowed="false" />
            <remove fileExtension=".bak" /><add fileExtension=".bak" allowed="false" />
            <remove fileExtension=".mdf" /><add fileExtension=".mdf" allowed="false" />
            <remove fileExtension=".ldf" /><add fileExtension=".ldf" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
