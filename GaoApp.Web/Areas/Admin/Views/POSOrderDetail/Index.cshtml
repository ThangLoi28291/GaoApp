@section PageScripts {
    <script>
        const orderActionModal = new bootstrap.Modal(document.getElementById('orderActionModal'));
        const paymentHistoryModal = new bootstrap.Modal(document.getElementById('paymentHistoryModal'));
        const returnRefundModal = new bootstrap.Modal(document.getElementById('returnRefundModal'));
        const returnHistoryModal = new bootstrap.Modal(document.getElementById('returnHistoryModal'));

        const btnConfirmOrderAction = document.getElementById('btnConfirmOrderAction');
        const btnSubmitReturnRefund = document.getElementById('btnSubmitReturnRefund');
        const returnRefundModalBody = document.getElementById('returnRefundModalBody');
        const returnHistoryModalBody = document.getElementById('returnHistoryModalBody');

        const returnState = {
            orderId: 0,
            eligibility: null
        };

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function notifySuccess(msg) {
            if (window.toastr) toastr.success(msg);
            else alert(msg || 'Thành công');
        }

        function notifyError(msg) {
            if (window.toastr) toastr.error(msg);
            else alert(msg || 'Có lỗi xảy ra');
        }

        async function fetchJson(url, options = {}) {
            const res = await fetch(url, options);
            const contentType = res.headers.get('content-type') || '';

            let jsonData = null;
            let textData = '';

            try {
                if (contentType.includes('application/json')) {
                    jsonData = await res.json();
                } else {
                    textData = await res.text();
                }
            } catch { }

            if (!res.ok) {
                const msg =
                    jsonData?.message ||
                    jsonData?.title ||
                    jsonData?.error ||
                    textData ||
                    `Yêu cầu thất bại (${res.status})`;

                throw new Error(msg);
            }

            return jsonData ?? textData ?? null;
        }

        function formatMoney(value) {
            const n = Number(value || 0);
            return `${n.toLocaleString('vi-VN')} đ`;
        }

        function formatNumber(value) {
            return formatMoney(value).replace(' đ', '');
        }

        function formatDateTime(value) {
            if (!value) return '-';
            return new Date(value).toLocaleString('vi-VN');
        }

        async function refreshOrderDetail(orderId) {
            if (typeof loadOrderDetail === 'function') {
                await loadOrderDetail(orderId);
                return;
            }

            window.location.reload();
        }

        function openPaymentHistoryModal() {
            paymentHistoryModal.show();
        }

        function openOrderActionModal(type, orderId) {
            document.getElementById('orderActionType').value = type || '';
            document.getElementById('orderActionOrderId').value = orderId || 0;
            document.getElementById('orderActionReason').value = '';

            const subtitle = document.getElementById('orderActionSubtitle');
            const callout = document.getElementById('orderActionCallout');

            if (type === 'void') {
                subtitle.textContent = 'Hủy sau khi chốt cho đơn vừa hoàn thành';
                callout.textContent = 'Void dùng khi hóa đơn vừa chốt nhưng cần hủy ngay. Hãy nhập lý do rõ ràng để audit và truy vết.';
            } else {
                subtitle.textContent = 'Refund toàn phần theo flow cũ';
                callout.textContent = 'Refund dùng cho nghiệp vụ hoàn tiền theo flow cũ. Hãy nhập lý do rõ ràng để audit về sau.';
            }

            orderActionModal.show();
        }

        async function submitOrderAction() {
            const type = document.getElementById('orderActionType').value;
            const orderId = parseInt(document.getElementById('orderActionOrderId').value || '0');
            const reason = (document.getElementById('orderActionReason').value || '').trim();
            const antiForgeryToken = getAntiForgeryToken();

            if (!orderId) {
                notifyError('Không xác định được đơn hàng.');
                return;
            }

            if (!reason) {
                notifyError('Vui lòng nhập lý do.');
                return;
            }

            const endpoint = type === 'refund'
                ? `/admin/pos/orders/${orderId}/refund`
                : `/admin/pos/orders/${orderId}/void`;

            try {
                btnConfirmOrderAction.disabled = true;

                const result = await fetchJson(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {})
                    },
                    body: JSON.stringify({ reason })
                });

                orderActionModal.hide();
                notifySuccess(result?.message || 'Xử lý thành công.');
                await refreshOrderDetail(orderId);
            } catch (err) {
                notifyError(err.message || 'Không thể xử lý đơn.');
            } finally {
                btnConfirmOrderAction.disabled = false;
            }
        }

        async function openReturnRefundModal(orderId) {
            if (!orderId) {
                notifyError('Không xác định được đơn hàng.');
                return;
            }

            try {
                returnState.orderId = orderId;
                returnRefundModalBody.innerHTML = `<div class="text-center py-5 text-muted">Đang tải dữ liệu...</div>`;
                returnRefundModal.show();

                const data = await fetchJson(`/admin/pos/returns/order/${orderId}/eligibility`);
                returnState.eligibility = data;
                returnRefundModalBody.innerHTML = renderReturnRefundForm(data);
                bindReturnRefundEvents();
            } catch (err) {
                notifyError(err.message || 'Không tải được dữ liệu trả hàng / hoàn tiền.');
            }
        }

        function renderReturnRefundForm(data) {
            const lines = data?.lines || [];

            const refundMethodOptions = `
                <option value="0">Tiền mặt</option>
                <option value="1">Chuyển khoản</option>
                <option value="2">Thẻ</option>
                <option value="3">Ví điện tử</option>
                <option value="99">Khác</option>
            `;

            const lineRows = lines.length === 0
                ? `
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không có dòng hàng nào để xử lý.</td>
                    </tr>
                `
               : lines.map((line, index) => {
    const maxQty = Number(line.returnableQuantity || 0);
    const soldQty = Number(
        line.quantity ??
        line.soldQuantity ??
        line.originalQuantity ??
        line.orderedQuantity ??
        0
    );
    const multiplier = Number(line.multiplier || 1);
    const unitPrice = Number(line.unitPrice || 0);
    const defaultRefundUnit = Number(line.refundUnitAmount ?? unitPrice);

    return `
        <tr class="align-middle" data-order-line-id="${line.orderLineId}">
            <td class="text-center">${index + 1}</td>
            <td>
                <div class="fw-semibold">${line.itemName || ''}</div>
                <div class="small text-muted">
                    SKU: ${line.sku || '-'}
                    ${line.unitName ? ` - ĐVT: ${line.unitName}` : ''}
                </div>
            </td>
            <td class="text-end">${formatNumber(soldQty)}</td>
            <td class="text-end text-primary fw-semibold">${formatNumber(maxQty)}</td>
            <td style="width: 120px;">
                <input type="number"
                       class="form-control text-end js-return-qty"
                       data-order-line-id="${line.orderLineId}"
                       data-max="${maxQty}"
                       data-multiplier="${multiplier}"
                       min="0"
                       max="${maxQty}"
                       step="1"
                       value="0">
            </td>
            <td style="width: 140px;">
                <input type="number"
                       class="form-control text-end js-refund-unit"
                       data-order-line-id="${line.orderLineId}"
                       min="0"
                       step="100"
                       value="${defaultRefundUnit}">
            </td>
            <td class="text-center" style="width: 110px;">
                <div class="form-check d-inline-flex align-items-center gap-2 m-0">
                    <input type="checkbox"
                           class="form-check-input js-restock"
                           data-order-line-id="${line.orderLineId}"
                           checked>
                    <label class="form-check-label small text-muted">Nhập kho</label>
                </div>
            </td>
            <td>
                <input type="text"
                       class="form-control js-line-reason"
                       data-order-line-id="${line.orderLineId}"
                       placeholder="Lý do dòng này (nếu có)">
            </td>
            <td class="text-end fw-semibold js-line-total"
                data-order-line-id="${line.orderLineId}">
                ${formatMoney(0)}
            </td>
        </tr>
    `;
}).join('');

            return `
                <div class="return-refund-form">
                    <div class="ord-popup-callout">
                        Mặc định <strong>Nhập kho</strong> đang bật. Nếu hàng lỗi / không muốn nhập lại kho, hãy <strong>bỏ chọn</strong> ở đúng dòng hàng.
                    </div>

                    <div class="ret-summary">
                        <div class="ret-stat">
                            <div class="ret-stat-label">Đơn hàng</div>
                            <div class="ret-stat-value">${data?.orderNumber || '-'}</div>
                        </div>
                        <div class="ret-stat">
                            <div class="ret-stat-label">Khách hàng</div>
                            <div class="ret-stat-value">${data?.customerName || 'Khách lẻ'}</div>
                        </div>
                        <div class="ret-stat">
                            <div class="ret-stat-label">Tổng thanh toán</div>
                            <div class="ret-stat-value">${formatMoney(data?.grandTotal || 0)}</div>
                        </div>
                        <div class="ret-stat">
                            <div class="ret-stat-label">Đã hoàn trước đó</div>
                            <div class="ret-stat-value text-danger">${formatMoney(data?.alreadyRefunded || 0)}</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Loại xử lý</label>
                            <select class="form-select" id="returnType">
                                <option value="3" selected>Trả hàng + hoàn tiền</option>
                                <option value="2">Chỉ trả hàng</option>
                                <option value="1">Chỉ hoàn tiền</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Lý do chung</label>
                            <input type="text" class="form-control" id="returnReason" placeholder="Nhập lý do chung">
                        </div>
                    </div>

                    <div class="ord-box mb-3">
                        <div class="table-responsive">
                            <table class="table ord-table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 60px;">#</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-end" style="width: 100px;">Đã bán</th>
                                        <th class="text-end" style="width: 120px;">Còn trả được</th>
                                        <th class="text-end" style="width: 120px;">SL trả</th>
                                        <th class="text-end" style="width: 140px;">Đơn giá hoàn</th>
                                        <th class="text-center" style="width: 110px;">Nhập kho</th>
                                        <th style="width: 220px;">Lý do dòng</th>
                                        <th class="text-end" style="width: 140px;">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="returnLinesBody">
                                    ${lineRows}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Phương thức hoàn</label>
                            <select class="form-select" id="refundMethod">
                                ${refundMethodOptions}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Số tiền hoàn</label>
                            <input type="number" class="form-control" id="refundAmount" min="0" step="100" value="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Mã tham chiếu</label>
                            <input type="text" class="form-control" id="refundReference" placeholder="Nếu có">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Tổng tiền hàng trả</label>
                            <input type="text" class="form-control fw-bold" id="returnSubtotalDisplay" value="0 đ" readonly>
                        </div>
                    </div>
                </div>
            `;
        }

        function bindReturnRefundEvents() {
            document.querySelectorAll('.js-return-qty, .js-refund-unit').forEach(el => {
                el.addEventListener('input', recalcReturnRefundSubtotal);
            });

            const returnType = document.getElementById('returnType');
            const refundAmount = document.getElementById('refundAmount');

            function applyReturnTypeUi() {
                const type = parseInt(returnType?.value || '3');

                const qtyInputs = document.querySelectorAll('.js-return-qty');
                const refundUnitInputs = document.querySelectorAll('.js-refund-unit');
                const restockInputs = document.querySelectorAll('.js-restock');
                const lineReasonInputs = document.querySelectorAll('.js-line-reason');

                if (type === 1) {
                    qtyInputs.forEach(x => {
                        x.value = '0';
                        x.setAttribute('readonly', 'readonly');
                    });

                    refundUnitInputs.forEach(x => {
                        x.setAttribute('readonly', 'readonly');
                    });

                    restockInputs.forEach(x => {
                        x.checked = false;
                        x.setAttribute('disabled', 'disabled');
                    });

                    lineReasonInputs.forEach(x => {
                        x.value = '';
                        x.setAttribute('readonly', 'readonly');
                    });

                    refundAmount.removeAttribute('readonly');
                }
                else if (type === 2) {
                    qtyInputs.forEach(x => x.removeAttribute('readonly'));
                    refundUnitInputs.forEach(x => x.removeAttribute('readonly'));
                    restockInputs.forEach(x => x.removeAttribute('disabled'));
                    lineReasonInputs.forEach(x => x.removeAttribute('readonly'));

                    refundAmount.value = '0';
                    refundAmount.setAttribute('readonly', 'readonly');
                }
                else {
                    qtyInputs.forEach(x => x.removeAttribute('readonly'));
                    refundUnitInputs.forEach(x => x.removeAttribute('readonly'));
                    restockInputs.forEach(x => x.removeAttribute('disabled'));
                    lineReasonInputs.forEach(x => x.removeAttribute('readonly'));

                    refundAmount.removeAttribute('readonly');
                }

                recalcReturnRefundSubtotal();
            }

            if (returnType) {
                returnType.addEventListener('change', applyReturnTypeUi);
            }

            applyReturnTypeUi();
        }

        function recalcReturnRefundSubtotal() {
            let subtotal = 0;

            document.querySelectorAll('.js-return-qty').forEach(qtyInput => {
                const row = qtyInput.closest('tr');
                if (!row) return;

                const max = parseFloat(qtyInput.dataset.max || '0');
                let qty = parseFloat(qtyInput.value || '0');

                if (qty < 0) qty = 0;
                if (qty > max) {
                    qty = max;
                    qtyInput.value = max;
                }

                const priceInput = row.querySelector('.js-refund-unit');
                const lineTotalEl = row.querySelector('.js-line-total');
                const price = parseFloat(priceInput?.value || '0');

                const lineTotal = qty * price;
                subtotal += lineTotal;

                if (lineTotalEl) {
                    lineTotalEl.textContent = formatMoney(lineTotal);
                }
            });

            const subtotalDisplay = document.getElementById('returnSubtotalDisplay');
            if (subtotalDisplay) {
                subtotalDisplay.value = formatMoney(subtotal);
            }
        }

        function buildReturnRefundRequest() {
            const orderId = returnState.orderId;
            const type = parseInt(document.getElementById('returnType')?.value || '3');
            const reason = (document.getElementById('returnReason')?.value || '').trim();
            const refundAmount = parseFloat(document.getElementById('refundAmount')?.value || '0');
            const refundMethod = parseInt(document.getElementById('refundMethod')?.value || '0');
            const refundReference = (document.getElementById('refundReference')?.value || '').trim();

            const lines = [];

            if (type === 2 || type === 3) {
                document.querySelectorAll('.js-return-qty').forEach(qtyInput => {
                    const qty = parseFloat(qtyInput.value || '0');
                    if (qty <= 0) return;

                    const row = qtyInput.closest('tr');
                    if (!row) return;

                    const orderLineId = parseInt(qtyInput.dataset.orderLineId || '0');
                    const multiplier = parseFloat(qtyInput.dataset.multiplier || '1');

                    const refundUnitInput = row.querySelector('.js-refund-unit');
                    const restockInput = row.querySelector('.js-restock');
                    const lineReasonInput = row.querySelector('.js-line-reason');

                    const refundUnitAmount = parseFloat(refundUnitInput?.value || '0');
                    const restock = !!restockInput?.checked;
                    const lineReason = (lineReasonInput?.value || '').trim();

                    lines.push({
                        orderLineId,
                        returnQuantity: qty,
                        returnBaseQuantity: qty * multiplier,
                        refundUnitAmount,
                        action: restock ? 1 : 0,
                        reason: lineReason || null
                    });
                });
            }

            const payments = [];

            if ((type === 1 || type === 3) && refundAmount > 0) {
                payments.push({
                    method: refundMethod,
                    amount: refundAmount,
                    referenceCode: refundReference
                });
            }

            return {
                orderId,
                posShiftId: 0,
                type,
                reason,
                lines,
                payments
            };
        }

        async function submitReturnRefund() {
            try {
                const payload = buildReturnRefundRequest();

                if (!payload.orderId) {
                    notifyError('Không xác định được đơn hàng.');
                    return;
                }

                if (!payload.reason) {
                    notifyError('Vui lòng nhập lý do.');
                    return;
                }

                if ((payload.type === 2 || payload.type === 3) && payload.lines.length === 0) {
                    notifyError('Vui lòng nhập ít nhất một dòng hàng trả.');
                    return;
                }

                if ((payload.type === 1 || payload.type === 3) && payload.payments.length === 0) {
                    notifyError('Vui lòng nhập số tiền hoàn.');
                    return;
                }

                btnSubmitReturnRefund.disabled = true;

                const result = await fetchJson(`/admin/pos/returns`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                returnRefundModal.hide();
                notifySuccess(result?.message || 'Đã tạo phiếu trả hàng / hoàn tiền thành công.');

                if (returnState.orderId) {
                    await refreshOrderDetail(returnState.orderId);
                }
            } catch (error) {
                notifyError(error?.message || 'Không thể tạo phiếu trả hàng / hoàn tiền.');
            } finally {
                btnSubmitReturnRefund.disabled = false;
            }
        }

        async function openReturnHistoryModal(orderId) {
            if (!orderId) {
                notifyError('Không xác định được đơn hàng.');
                return;
            }

            try {
                returnHistoryModalBody.innerHTML = `<div class="text-center py-5 text-muted">Đang tải lịch sử...</div>`;
                returnHistoryModal.show();

                const data = await fetchJson(`/admin/pos/returns/order/${orderId}/history`);
                returnHistoryModalBody.innerHTML = renderReturnHistory(data);
            } catch (err) {
                notifyError(err.message || 'Không tải được lịch sử return.');
            }
        }

        function renderReturnHistory(items) {
            if (!items || items.length === 0) {
                return `
                    <div class="ord-empty">
                        <div class="ord-empty-title">Chưa có lịch sử trả hàng / hoàn tiền</div>
                        <div class="ord-empty-desc">Đơn này hiện chưa phát sinh nghiệp vụ hậu mãi.</div>
                    </div>
                `;
            }

            const totalRefund = items.reduce((sum, x) => sum + Number(x.refundTotal || 0), 0);
            const totalCount = items.length;

            return `
                <div class="ord-popup-callout">
                    Đây là toàn bộ các phiếu hậu mãi phát sinh trên đơn này. Mỗi phiếu có thể chứa hàng trả, payment hoàn và thông tin nhập kho.
                </div>

                <div class="ret-summary-modern">
                    <div class="ret-hero-main">
                        <div class="ret-hero-label">Tổng tiền đã hoàn</div>
                        <div class="ret-hero-value">${formatMoney(totalRefund)}</div>
                        <div class="ret-hero-sub">
                            Tính từ toàn bộ phiếu return/refund đã ghi nhận trên đơn này.
                        </div>
                    </div>

                    <div class="ret-hero-stats">
                        <div class="ret-mini-stat">
                            <div class="ret-mini-label">Số phiếu hậu mãi</div>
                            <div class="ret-mini-value">${totalCount}</div>
                        </div>
                        <div class="ret-mini-stat">
                            <div class="ret-mini-label">Tổng tiền đơn</div>
                            <div class="ret-mini-value">${formatMoney(@Model.GrandTotal)}</div>
                        </div>
                        <div class="ret-mini-stat">
                            <div class="ret-mini-label">Đã thanh toán</div>
                            <div class="ret-mini-value">${formatMoney(@Model.PaidTotal)}</div>
                        </div>
                        <div class="ret-mini-stat">
                            <div class="ret-mini-label">Còn có thể hoàn</div>
                            <div class="ret-mini-value">${formatMoney(@Model.RefundableRemaining)}</div>
                        </div>
                    </div>
                </div>

                <div class="ret-list">
                    ${items.map(x => {
                        const typeText = getReturnTypeText(x.type);
                        const statusText = getReturnStatusText(x.status);
                        const lineCount = x.lines?.length || 0;
                        const paymentCount = x.payments?.length || 0;

                        return `
                            <div class="ret-history-item">
                                <div class="ret-history-header">
                                    <div>
                                        <div class="ret-code">${x.returnNumber}</div>

                                        <div class="ret-meta-line">
                                            <span class="ord-badge ord-badge-info">${typeText}</span>
                                            <span class="ord-badge ord-badge-success">${statusText}</span>
                                            <span class="ret-meta-text">${formatDateTime(x.createdAtUtc)}</span>
                                        </div>

                                        <div class="ret-meta-line">
                                            <span class="ret-meta-text">${lineCount} dòng hàng trả</span>
                                            <span class="ret-meta-text">•</span>
                                            <span class="ret-meta-text">${paymentCount} payment hoàn</span>
                                        </div>
                                    </div>

                                    <div class="ret-amount-box">
                                        <div class="ret-amount-label">Hoàn tiền</div>
                                        <div class="ret-amount-value">${formatMoney(x.refundTotal)}</div>
                                        <div class="ret-amount-sub">Tổng giá trị phiếu</div>
                                    </div>
                                </div>

                                <div class="ret-reason-box">
                                    <div class="ret-reason-label">Lý do</div>
                                    <div class="ret-reason-value">${x.reason || '-'}</div>
                                </div>

                                <div class="ret-action-row">
                                    <button type="button"
                                            class="btn btn-sm btn-ord btn-ord-soft"
                                            onclick="toggleReturnHistoryDetail(${x.id})">
                                        Xem chi tiết phiếu
                                    </button>
                                </div>

                                <div id="return-history-detail-${x.id}" class="ret-detail-shell" style="display:none;">
                                    ${renderReturnHistoryDetail(x)}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
        }

        function renderReturnHistoryDetail(item) {
            const lines = item.lines || [];
            const payments = item.payments || [];

            const linesHtml = lines.length === 0
                ? `<div class="ret-empty-box">Không có dòng hàng trả.</div>`
                : `
                    <div class="ret-panel">
                        <div class="ret-panel-head">Dòng hàng trả</div>
                        <div class="ret-panel-body">
                            <div class="table-responsive">
                                <table class="table ret-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-end">SL trả</th>
                                            <th class="text-end">SL quy đổi</th>
                                            <th class="text-end">Đơn giá hoàn</th>
                                            <th class="text-end">Thành tiền</th>
                                            <th class="text-center">Nhập kho</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${lines.map(l => `
                                            <tr>
                                                <td><strong>${l.itemName}</strong></td>
                                                <td class="text-end">${l.returnQuantity}</td>
                                                <td class="text-end">${l.returnBaseQuantity}</td>
                                                <td class="text-end">${formatMoney(l.refundUnitAmount)}</td>
                                                <td class="text-end fw-bold">${formatMoney(l.refundLineTotal)}</td>
                                                <td class="text-center">${getRestockText(l.action)}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>`;

            const paymentsHtml = payments.length === 0
                ? `<div class="ret-empty-box">Không có payment hoàn tiền.</div>`
                : `
                    <div class="ret-panel">
                        <div class="ret-panel-head">Payment hoàn tiền</div>
                        <div class="ret-panel-body">
                            <div class="table-responsive">
                                <table class="table ret-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Phương thức</th>
                                            <th>Mã tham chiếu</th>
                                            <th>Provider</th>
                                            <th>Thời gian</th>
                                            <th class="text-end">Số tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${payments.map(p => `
                                            <tr>
                                                <td><strong>${p.method}</strong></td>
                                                <td>${p.referenceCode || '-'}</td>
                                                <td>${p.provider || '-'}</td>
                                                <td>${formatDateTime(p.paidAtUtc)}</td>
                                                <td class="text-end fw-bold">${formatMoney(p.amount)}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>`;

            return `
                <div class="ret-detail-grid">
                    ${linesHtml}
                    ${paymentsHtml}
                </div>
            `;
        }

        function toggleReturnHistoryDetail(id) {
            const el = document.getElementById(`return-history-detail-${id}`);
            if (!el) return;
            el.style.display = el.style.display === 'none' ? '' : 'none';
        }

        function getReturnTypeText(type) {
            const value = (type || '').toString();
            switch (value) {
                case '1':
                case 'RefundOnly':
                    return 'Chỉ hoàn tiền';
                case '2':
                case 'ReturnOnly':
                    return 'Chỉ trả hàng';
                case '3':
                case 'ReturnAndRefund':
                    return 'Trả hàng + hoàn tiền';
                case '4':
                case 'Exchange':
                    return 'Đổi hàng';
                default:
                    return value;
            }
        }

        function getReturnStatusText(status) {
            const value = (status || '').toString();
            switch (value) {
                case '0':
                case 'Draft':
                    return 'Nháp';
                case '1':
                case 'Completed':
                    return 'Hoàn tất';
                case '2':
                case 'Cancelled':
                    return 'Đã hủy';
                default:
                    return value;
            }
        }

        function getRestockText(action) {
            const value = (action || '').toString();
            switch (value) {
                case '1':
                case 'Restock':
                    return 'Có';
                case '0':
                case 'NoRestock':
                    return 'Không';
                default:
                    return '-';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            btnConfirmOrderAction?.addEventListener('click', submitOrderAction);
            btnSubmitReturnRefund?.addEventListener('click', submitReturnRefund);
        });
    </script>
}