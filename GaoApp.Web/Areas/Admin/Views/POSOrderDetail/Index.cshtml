                        </div>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="ord-card">
                <div class="ord-card-head">
                    <h5 class="ord-card-title">Danh sách hàng hóa</h5>
                    <div class="ord-card-subtitle">Thông tin chính được làm nổi bật để nhìn nhanh hơn</div>
                </div>

                <div class="ord-card-body">
                    <div class="ord-table-wrap">
                        <div class="table-responsive">
                            <table class="table ord-table align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:68px;">#</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-end">SL</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Lines == null || !Model.Lines.Any())
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="ord-empty">
                                                    <div class="ord-empty-title">Chưa có sản phẩm</div>
                                                    <div class="ord-empty-desc">Đơn hàng này hiện chưa có dữ liệu dòng bán.</div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var index = 1;
                                        foreach (var line in Model.Lines)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="ord-index">@index</span>
                                                </td>
                                                <td>
                                                    <div class="ord-product-name">@line.ItemName</div>
                                                    <div class="ord-product-meta">
                                                        @(line.SellingUnitName ?? line.UnitName)
                                                        @if (!string.IsNullOrWhiteSpace(line.Sku))
                                                        {
                                                            <span> | SKU: @line.Sku</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(line.Barcode))
                                                        {
                                                            <span> | Barcode: @line.Barcode</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <div class="ord-cell-main">@line.Quantity</div>
                                                </td>
                                                <td class="text-end">
                                                    <div class="ord-cell-main">@line.UnitPrice.ToString("N0")</div>
                                                </td>
                                                <td class="text-end">
                                                    <div class="ord-cell-main">@line.LineTotal.ToString("N0")</div>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="ord-section ord-payment-section">
                        <div class="ord-payment-card">
                            <div>
                                <div class="ord-payment-title">Lịch sử thanh toán</div>
                                <div class="ord-payment-subtitle">
                                    Xem đầy đủ các lần thanh toán của đơn trong popup riêng để màn hình chính gọn hơn
                                </div>
                            </div>

                            <button type="button" class="ord-link-btn ord-payment-btn" onclick="openPaymentHistoryModal()">
                                Xem lịch sử thanh toán
