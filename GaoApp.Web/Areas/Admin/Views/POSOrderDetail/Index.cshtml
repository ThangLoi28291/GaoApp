@model GaoApp.Application.DTOs.POS.OrderReceiptDto

@{
    ViewData["Title"] = "Chi tiết đơn POS";
    Layout = "_ContentNavbarLayout";

    var cleanUserNote = GetCleanUserNote(Model.Note);
    var operationLogCount = CountOperationLogLines(Model.Note);
    var hasAfterSaleHistory =
        string.Equals(Model.Status, "Refunded", StringComparison.OrdinalIgnoreCase)
        || Model.RefundedTotal > 0;

    var paymentCount = Model.Payments?.Count ?? 0;
    var lineCount = Model.Lines?.Count ?? 0;

    var rewardVouchers = Model.RewardVouchers
        ?? new List<GaoApp.Application.DTOs.POS.OrderRewardVoucherDto>();

    var voucherCount = rewardVouchers.Count;
    var hasVoucher = Model.VoucherDiscountTotal > 0 || voucherCount > 0;

    var canOpenLegalEntityInvoices =
        ViewBag.CanOpenLegalEntityInvoices as bool? == true;

  var canRefund = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase)
                && Model.RefundedTotal <= 0;
    var canVoid = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase) && Model.RefundedTotal <= 0;
    var canReturn = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.Status, "Refunded", StringComparison.OrdinalIgnoreCase);
}

<link rel="stylesheet" href="~/Admin/css/pos/acb.lookup.css" asp-append-version="true" />
<script src="~/Admin/js/pos/acb.lookup.launcher.js" asp-append-version="true" defer></script>
@if (canReturn)
{
    @if (ViewBag.CanCompleteReturnRestock as bool? == true)
    {
        <div class="mb-3"><a href="/admin/pos/returns/pending-restock" class="btn btn-outline-warning">Hàng trả chờ nhập kho</a></div>
    }
    <div class="mb-3"><a href="/admin/pos-shift/requests?tab=payment&amp;orderId=@Model.OrderId" class="btn btn-outline-primary">Yêu cầu sửa thanh toán</a></div>
}
@if (Model.HasBankTransfer)
{
    <div class="mb-3"><a href="/admin/acb/payments/orders/@Model.OrderId" data-acb-order-id="@Model.OrderId" class="btn btn-outline-primary">Thông tin chuyển khoản</a></div>
}

@functions {
    public string GetStatusBadgeClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "ord-badge-muted";

        var s = status.Trim().ToLowerInvariant();

        return s switch
        {
            "completed" => "ord-badge-success",
            "draft" => "ord-badge-muted",
            "cancelled" => "ord-badge-danger",
            "onhold" => "ord-badge-warning",
            "voided" => "ord-badge-dark",
            "refunded" => "ord-badge-info",
            _ => "ord-badge-muted"
        };
    }

    public string GetPaymentBadgeClass(string? paymentStatus)
    {
        if (string.IsNullOrWhiteSpace(paymentStatus)) return "ord-badge-muted";

        var s = paymentStatus.Trim().ToLowerInvariant();

        if (s.Contains("refund")) return "ord-badge-info";
        if (s.Contains("partial")) return "ord-badge-warning";
        if (s.Contains("unpaid")) return "ord-badge-danger";
        if (s.Contains("paid")) return "ord-badge-success";

        return "ord-badge-muted";
    }

    public string GetStatusTextVi(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "-";

        var s = status.Trim().ToLowerInvariant();

        return s switch
        {
            "completed" => "Đã chốt",
            "draft" => "Nháp",
            "cancelled" => "Đã hủy",
            "onhold" => "Đang giữ",
            "voided" => "Hủy sau chốt",
            "refunded" => "Đã hoàn tiền",
            _ => status!
        };
    }

    public string GetPaymentStatusTextVi(string? paymentStatus)
    {
        if (string.IsNullOrWhiteSpace(paymentStatus)) return "-";

        var s = paymentStatus.Trim().ToLowerInvariant();

        if (s.Contains("refund")) return "Đã hoàn tiền";
        if (s.Contains("partial")) return "Thanh toán một phần";
        if (s.Contains("unpaid")) return "Chưa thanh toán";
        if (s.Contains("paid")) return "Đã thanh toán";

        return paymentStatus!;
    }

    public string GetCleanUserNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note)) return string.Empty;

        var lines = note
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
            .Select(x => x?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(x =>
                !x!.StartsWith("[RETURN/REFUND", StringComparison.OrdinalIgnoreCase) &&
                !x.StartsWith("[HỦY SAU KHI CHỐT", StringComparison.OrdinalIgnoreCase))
            .ToList();

        return string.Join(Environment.NewLine, lines);
    }

    public int CountOperationLogLines(string? note)
    {
        if (string.IsNullOrWhiteSpace(note)) return 0;

        return note
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
            .Count(x =>
                !string.IsNullOrWhiteSpace(x) &&
                (x.Contains("[RETURN/REFUND", StringComparison.OrdinalIgnoreCase) ||
                 x.Contains("[HỦY SAU KHI CHỐT", StringComparison.OrdinalIgnoreCase)));
    }

    public string DisplayCustomerName()
    {
        return string.IsNullOrWhiteSpace(Model.CustomerName) ? "Khách lẻ" : Model.CustomerName!;
    }

    public string DisplayCustomerPhone()
    {
        return string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "-" : Model.CustomerPhone!;
    }

    public string DisplayCashierName()
    {
        return string.IsNullOrWhiteSpace(Model.CashierName) ? "-" : Model.CashierName!;
    }
}

@section VendorStyles {
    <link rel="stylesheet"
          href="~/Admin/css/pos/pos-order-detail.css"
          asp-append-version="true" />
}

@section header {
    <div class="order-head">
        <div>
            <h3 class="order-title">Chi tiết đơn POS</h3>
            <div class="order-subtitle">
                Theo dõi đơn hàng, hậu mãi và thanh toán trên một màn hình gọn, dễ hiểu
            </div>
        </div>

        <div class="order-actions order-actions-modern">

    <div class="order-action-group order-action-group-nav">

        <div class="order-action-group-label">
            Điều hướng
        </div>

        <div class="order-action-group-controls">

            <a href="/admin/pos/orders-page"
               class="btn btn-ord btn-ord-soft">
                Quay lại
            </a>

            <a href="/admin/pos/orders/@Model.OrderId/print?autoPrint=false"
               target="_blank"
               class="btn btn-ord btn-ord-primary">
                In hóa đơn
            </a>

        </div>

    </div>

    @if (canReturn)
    {
        <div class="order-action-group order-action-group-aftersale">

            <div class="order-action-group-label">
                Hậu mãi
            </div>

            <div class="order-action-group-controls">

                <button type="button"
                        class="btn btn-ord btn-ord-info"
                        onclick="openReturnRefundModal(@Model.OrderId)">
                    Trả hàng / hoàn tiền
                </button>

                <button type="button"
                        class="btn btn-ord btn-ord-soft"
                        onclick="openReturnHistoryModal(@Model.OrderId)">
                    Lịch sử hậu mãi
                </button>

            </div>

        </div>
    }

    @if (canVoid || canRefund)
    {
        <div class="order-action-group order-action-group-special">

            <div class="order-action-group-label">
                Thao tác đặc biệt
            </div>

            <div class="order-action-group-controls">

                @if (canVoid)
                {
                    <button type="button"
                            class="btn btn-ord btn-ord-danger-soft"
                            title="Hủy đơn vừa chốt"
                            onclick="openOrderActionModal('void', @Model.OrderId)">
                        Void đơn
                    </button>
                }

                @if (canRefund)
                {
                    <button type="button"
                            class="btn btn-ord btn-ord-warning-soft"
                            title="Refund toàn bộ đơn theo flow hiện tại"
                            onclick="openOrderActionModal('refund', @Model.OrderId)">
                        Hoàn tiền toàn bộ
                    </button>
                }

            </div>

        </div>
    }

</div>
    </div>
}

<div class="order-page">
    @Html.AntiForgeryToken()

