                <div style="border:1px solid #e6edf5; border-radius:14px; padding:10px 12px; background:#f8fbff;">
                    <div style="font-weight:900; color:#2957c8;">
                        @v.VoucherCode
                    </div>

                    <div style="font-size:.88rem; color:#667085; font-weight:700;">
                        Giá trị: @v.Value.ToString("N0") đ

                        @if (!string.IsNullOrWhiteSpace(v.Status))
                        {
                            <span> · Trạng thái: @v.Status</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
                    <div class="ord-info">
                        <div class="ord-info-label">Nhân viên / Ca POS</div>
                        <div class="ord-info-value">@DisplayCashierName()</div>
                        <div class="ord-info-sub">@(string.IsNullOrWhiteSpace(Model.ShiftCode) ? "-" : Model.ShiftCode)</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(cleanUserNote))
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Ghi chú</div>
                            <div class="ord-info-value" style="font-size:.96rem; font-weight:700; white-space:pre-line;">
                                @cleanUserNote
                            </div>
                        </div>
                    }

                    @if (hasAfterSaleHistory)
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Hậu mãi / hoàn trả</div>
                            <div class="ord-info-value">Đơn này đã phát sinh thao tác hoàn / trả.</div>
                            <div class="ord-info-sub">
                                Đã hoàn: <strong>@Model.RefundedTotal.ToString("N0") đ</strong>
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 ms-1"
                                        onclick="openReturnHistoryModal(@Model.OrderId)">
                                    Xem lịch sử
                                </button>
                            </div>
                        </div>
                    }

                    @if (operationLogCount > 0)
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Số lần thao tác hậu mãi</div>
                            <div class="ord-info-value">@operationLogCount lần</div>
                            <div class="ord-info-sub">Theo log ghi trong ghi chú nghiệp vụ</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="ord-card">
