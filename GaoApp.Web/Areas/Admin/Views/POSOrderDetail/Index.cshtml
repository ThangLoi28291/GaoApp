@model GaoApp.Application.DTOs.POS.OrderReceiptDto

@{
    ViewData["Title"] = "Chi tiết đơn POS";
    Layout = "_ContentNavbarLayout";

    var cleanUserNote = GetCleanUserNote(Model.Note);
    var operationLogCount = CountOperationLogLines(Model.Note);
    var hasAfterSaleHistory =
        string.Equals(Model.Status, "Refunded", StringComparison.OrdinalIgnoreCase)
        || Model.RefundedTotal > 0;

    var paymentCount = Model.Payments?.Count ?? 0;
    var lineCount = Model.Lines?.Count ?? 0;

    var canRefund = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var canVoid = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase) && Model.RefundedTotal <= 0;
    var canReturn = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.Status, "Refunded", StringComparison.OrdinalIgnoreCase);
}

@functions {
    public string GetStatusBadgeClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "ord-badge-muted";

        var s = status.Trim().ToLowerInvariant();

        return s switch
        {
            "completed" => "ord-badge-success",
            "draft" => "ord-badge-muted",
            "cancelled" => "ord-badge-danger",
            "onhold" => "ord-badge-warning",
            "voided" => "ord-badge-dark",
            "refunded" => "ord-badge-info",
            _ => "ord-badge-muted"
        };
    }

    public string GetPaymentBadgeClass(string? paymentStatus)
    {
        if (string.IsNullOrWhiteSpace(paymentStatus)) return "ord-badge-muted";

        var s = paymentStatus.Trim().ToLowerInvariant();

        if (s.Contains("paid")) return "ord-badge-success";
        if (s.Contains("partial")) return "ord-badge-warning";
        if (s.Contains("unpaid")) return "ord-badge-danger";
        if (s.Contains("refund")) return "ord-badge-info";

        return "ord-badge-muted";
    }

    public string GetStatusTextVi(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "-";

        var s = status.Trim().ToLowerInvariant();

        return s switch
        {
            "completed" => "Đã chốt",
            "draft" => "Nháp",
            "cancelled" => "Đã hủy",
            "onhold" => "Đang giữ",
            "voided" => "Hủy sau chốt",
            "refunded" => "Đã hoàn tiền",
            _ => status!
        };
    }

    public string GetPaymentStatusTextVi(string? paymentStatus)
    {
        if (string.IsNullOrWhiteSpace(paymentStatus)) return "-";

        var s = paymentStatus.Trim().ToLowerInvariant();

        if (s.Contains("refunded")) return "Đã hoàn tiền";
        if (s.Contains("paid")) return "Đã thanh toán";
        if (s.Contains("partial")) return "Thanh toán một phần";
        if (s.Contains("unpaid")) return "Chưa thanh toán";

        return paymentStatus!;
    }

    public string GetCleanUserNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note)) return string.Empty;

        var lines = note
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
            .Select(x => x?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(x =>
                !x!.StartsWith("[RETURN/REFUND", StringComparison.OrdinalIgnoreCase) &&
                !x.StartsWith("[HỦY SAU KHI CHỐT", StringComparison.OrdinalIgnoreCase))
            .ToList();

        return string.Join(Environment.NewLine, lines);
    }

    public int CountOperationLogLines(string? note)
    {
        if (string.IsNullOrWhiteSpace(note)) return 0;

        return note
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
            .Count(x =>
                !string.IsNullOrWhiteSpace(x) &&
                (x.Contains("[RETURN/REFUND", StringComparison.OrdinalIgnoreCase) ||
                 x.Contains("[HỦY SAU KHI CHỐT", StringComparison.OrdinalIgnoreCase)));
    }

    public string DisplayCustomerName()
    {
        return string.IsNullOrWhiteSpace(Model.CustomerName) ? "Khách lẻ" : Model.CustomerName!;
    }

    public string DisplayCustomerPhone()
    {
        return string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "-" : Model.CustomerPhone!;
    }

    public string DisplayCashierName()
    {
        return string.IsNullOrWhiteSpace(Model.CashierName) ? "-" : Model.CashierName!;
    }
}

