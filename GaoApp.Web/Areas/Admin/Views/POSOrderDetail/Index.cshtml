            <div class="ord-stat-label">Tổng tiền đơn</div>
            <div class="ord-stat-value">@Model.GrandTotal.ToString("N0") đ</div>
            <div class="ord-stat-sub">
                Tạm tính: <strong>@Model.Subtotal.ToString("N0") đ</strong>
            </div>
        </div>

        <div class="ord-stat success">
            <div class="ord-stat-label">Đã thanh toán</div>
            <div class="ord-stat-value">@Model.PaidTotal.ToString("N0") đ</div>
            @if (Model.DepositAmount > 0)
            {
                <div class="ord-stat-sub">Bao gồm tiền cọc: <strong>@Model.DepositAmount.ToString("N0") đ</strong></div>
            }
        </div>

        <div class="ord-stat info">
            <div class="ord-stat-label">Đã hoàn</div>
            <div class="ord-stat-value">@Model.RefundedTotal.ToString("N0") đ</div>
        </div>

        <div class="ord-stat warning">
            <div class="ord-stat-label">Còn có thể hoàn</div>
            <div class="ord-stat-value">@Model.RefundableRemaining.ToString("N0") đ</div>
        </div>

        <div class="ord-stat info">
            <div class="ord-stat-label">Số thanh toán</div>
            <div class="ord-stat-value">@paymentCount</div>
        </div>

        <div class="ord-stat danger">
    <div class="ord-stat-label">Voucher</div>
    <div class="ord-stat-value">
        @(hasVoucher ? Model.VoucherDiscountTotal.ToString("N0") + " đ" : "Chưa có")
    </div>
</div>
    </div>

    <div class="ord-layout">
        <div class="ord-card">
            <div class="ord-card-head">
                <h5 class="ord-card-title">Thông tin đơn hàng</h5>
                <div class="ord-card-subtitle">Giữ phần chính thật gọn để dễ xem, dễ thao tác tại quầy</div>
            </div>

            <div class="ord-card-body">
                <div class="ord-side-grid">
