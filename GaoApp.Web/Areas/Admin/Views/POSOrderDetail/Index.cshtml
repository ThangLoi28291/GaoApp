                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="ord-empty">
                                                    <div class="ord-empty-title">Chưa có sản phẩm</div>
                                                    <div class="ord-empty-desc">Đơn hàng này hiện chưa có dữ liệu dòng bán.</div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
