                            </div>
                        </div>
                    }

                    @if (operationLogCount > 0)
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Số lần thao tác hậu mãi</div>
                            <div class="ord-info-value">@operationLogCount lần</div>
