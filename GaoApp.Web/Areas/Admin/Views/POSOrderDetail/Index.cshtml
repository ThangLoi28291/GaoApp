    @if (Model.LegalEntityBreakdown != null)
    {
        var breakdown = Model.LegalEntityBreakdown;
        <div class="ord-card mt-4">
            <div class="ord-card-head">
                <div>
                    <h5 class="ord-card-title">Phân bổ Hộ kinh doanh</h5>
                    <div class="ord-card-subtitle">Chỉ người có quyền đối soát mới thấy allocation, kho nguồn và hóa đơn điện tử con.</div>
                </div>
                <span class="ord-badge @(breakdown.IsBalanced ? "ord-badge-success" : "ord-badge-danger")">
                    @(breakdown.IsBalanced ? "Đối soát khớp" : "Cần kiểm tra")
                </span>
            </div>
            <div class="ord-card-body">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">Tổng đơn gộp</div><div class="ord-info-value">@breakdown.UnifiedOrderTotal.ToString("N0") đ</div></div></div>
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">Allocation gốc</div><div class="ord-info-value">@breakdown.AllocationGrossTotal.ToString("N0") đ</div></div></div>
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">Đã đảo / trả</div><div class="ord-info-value">@breakdown.ReversalTotal.ToString("N0") đ</div></div></div>
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">Allocation ròng</div><div class="ord-info-value">@breakdown.AllocationNetTotal.ToString("N0") đ</div></div></div>
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">HĐ kỳ vọng</div><div class="ord-info-value">@breakdown.ExpectedInvoiceTotal.ToString("N0") đ</div></div></div>
                    <div class="col-6 col-lg-2"><div class="ord-info"><div class="ord-info-label">HĐ thực tế</div><div class="ord-info-value">@breakdown.ActualInvoiceTotal.ToString("N0") đ</div></div></div>
                </div>

                <div class="row g-3 mb-4">
                    @foreach (var entity in breakdown.EntitySummaries)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="ord-info h-100">
                                <div class="d-flex justify-content-between gap-3 flex-wrap">
                                    <div>
                                        <div class="ord-info-label">@entity.LegalEntityCode · ưu tiên @entity.SalePriority</div>
                                        <div class="ord-info-value">@entity.LegalEntityName</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="ord-info-label">Phân bổ ròng</div>
                                        <div class="ord-info-value">@entity.AllocationNetTotal.ToString("N0") đ</div>
                                    </div>
                                </div>
                                <div class="ord-info-sub mt-2">Gốc @entity.AllocationGrossTotal.ToString("N0") · đảo/trả @entity.ReversalTotal.ToString("N0") · hóa đơn @entity.ActualInvoiceTotal.ToString("N0")/@entity.ExpectedInvoiceTotal.ToString("N0")</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="ord-section-head"><h6 class="ord-section-title">Chi tiết allocation và kho nguồn</h6></div>
                <div class="ord-table-wrap mb-4">
                    <div class="table-responsive">
                        <table class="table ord-table align-middle">
                            <thead><tr><th>Allocation</th><th>Sản phẩm</th><th>HKD / Kho</th><th class="text-end">SL gốc</th><th class="text-end">Đã đảo</th><th class="text-end">Tiền gốc</th><th class="text-end">Còn lại</th><th>HĐ đầu vào</th></tr></thead>
                            <tbody>
                            @foreach (var line in breakdown.Allocations)
                            {
                                <tr>
                                    <td><strong>#@line.AllocationId</strong><div class="ord-product-meta">@line.AllocationSource</div></td>
                                    <td><div class="ord-product-name">@line.ProductName</div><div class="ord-product-meta">@(line.Sku ?? line.Barcode ?? $"Line #{line.OrderLineId}")</div></td>
                                    <td><strong>@line.LegalEntityCode</strong><div class="ord-product-meta">@line.WarehouseCode - @line.WarehouseName</div></td>
                                    <td class="text-end">@line.BaseQuantity.ToString("N2")</td>
                                    <td class="text-end">@line.ReversedBaseQuantity.ToString("N2")</td>
                                    <td class="text-end">@line.NetAmount.ToString("N0")</td>
                                    <td class="text-end"><strong>@line.RemainingAmount.ToString("N0")</strong></td>
                                    <td><span class="ord-badge @(line.HasInputInvoice ? "ord-badge-success" : "ord-badge-muted")">@(line.HasInputInvoice ? "Có" : "Không")</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="ord-section-head"><h6 class="ord-section-title">Hóa đơn điện tử con</h6></div>
                @if (breakdown.Invoices.Count == 0)
                {
                    <div class="ord-empty"><div class="ord-empty-title">Chưa có hóa đơn con</div><div class="ord-empty-desc">Order có allocation nhưng chưa tìm thấy InvoiceHead gốc.</div></div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var invoice in breakdown.Invoices)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="ord-info h-100">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="ord-info-label">@invoice.LegalEntityCode · Invoice #@invoice.InvoiceHeadId</div>
                                            <div class="ord-info-value">@invoice.GrandTotal.ToString("N0") đ</div>
                                            <div class="ord-info-sub">@invoice.ProviderStatus @(string.IsNullOrWhiteSpace(invoice.ProviderInvoiceNo) ? "" : $"· Số {invoice.ProviderInvoiceNo}")</div>
                                        </div>
                                        @if (canOpenLegalEntityInvoices)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="/Admin/Invoice/Detail?id=@invoice.InvoiceHeadId">Mở hóa đơn</a>
                                        }
                                        else
                                        {
                                            <span class="ord-badge ord-badge-muted">Chỉ xem</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="mt-3 text-end">
                    <a href="/admin/legal-entities/reconciliation?Keyword=@Uri.EscapeDataString(Model.OrderNumber ?? Model.OrderId.ToString())" class="btn btn-ord btn-ord-soft">Mở báo cáo đối soát</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade modal-clean" id="orderActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:620px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Xử lý đơn hàng</h5>
                    <div class="small text-muted mt-1" id="orderActionSubtitle">Refund / Void đơn hàng đã chốt</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

           <div class="modal-body">
    <input type="hidden" id="orderActionType" />
    <input type="hidden" id="orderActionOrderId" />

    <div class="ord-popup-callout mb-3" id="orderActionCallout">
        Xác nhận thao tác trên đơn đã chốt. Hãy nhập lý do rõ ràng để dễ audit về sau.
    </div>
    <div id="orderActionCostWarning" class="alert alert-warning" role="status" style="white-space:pre-line;overflow-wrap:anywhere" hidden></div>
    <div id="orderActionPendingRestockBox" class="form-check mb-3" hidden>
        <input class="form-check-input" type="checkbox" id="orderActionPendingRestock">
        <label class="form-check-label" for="orderActionPendingRestock">Nhận hàng và hoàn tiền ngay. Hàng chưa đủ giá vốn sẽ chờ nhập kho.</label>
    </div>

    <div id="orderActionRefundMethodBox" class="mb-3" style="display:none;">
        <label class="form-label fw-semibold">Phương thức hoàn tiền</label>

        <select id="orderActionRefundMethod" class="form-select">
            <option value="0" selected>Tiền mặt</option>
            <option value="1">Chuyển khoản</option>
            <option value="2">Thẻ</option>
            <option value="3">Ví điện tử</option>
        </select>

        <div class="form-text">
            Chọn đúng cách cửa hàng thực tế hoàn tiền cho khách.
            Ví dụ khách mua chuyển khoản nhưng cửa hàng trả lại tiền mặt thì chọn Tiền mặt.
        </div>
    </div>

    <div id="orderActionRefundNonCashBox" class="row g-2 mb-3" style="display:none;">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Mã tham chiếu</label>
            <input id="orderActionRefundReferenceCode"
                   class="form-control"
                   placeholder="Mã giao dịch nếu có" />
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Nhà cung cấp</label>
            <input id="orderActionRefundProvider"
                   class="form-control"
                   placeholder="ACB, VietQR, thẻ..." />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Lý do</label>
        <textarea id="orderActionReason"
                  class="form-control"
                  rows="4"
                  placeholder="Nhập lý do..."></textarea>
    </div>
</div>

            <div class="modal-footer">
                <button class="btn btn-ord btn-ord-soft" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-ord btn-ord-primary" id="btnConfirmOrderAction">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-clean" id="paymentHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Lịch sử thanh toán</h5>
                    <div class="small text-muted mt-1">Xem toàn bộ các lần thanh toán của đơn #@Model.OrderId</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="ord-popup-callout">
                    Theo dõi đầy đủ các lần thanh toán của đơn này theo thời gian, mã tham chiếu và số tiền.
                </div>

                <div class="ord-popup-hero">
                    <div class="ord-popup-stat">
                        <div class="ord-popup-stat-label">Tổng tiền đơn</div>
                        <div class="ord-popup-stat-value">@Model.GrandTotal.ToString("N0") đ</div>
                        <div class="ord-popup-stat-sub">
                            Tạm tính: @Model.Subtotal.ToString("N0") đ
                        </div>
                    </div>
                    <div class="ord-popup-stat">
                        <div class="ord-popup-stat-label">Đã thanh toán</div>
                        <div class="ord-popup-stat-value">@Model.PaidTotal.ToString("N0") đ</div>
                    </div>
                    <div class="ord-popup-stat">
                        <div class="ord-popup-stat-label">Số lần thanh toán</div>
                        <div class="ord-popup-stat-value">@paymentCount</div>
                    </div>
                    <div class="ord-popup-stat">
                        <div class="ord-popup-stat-label">Còn thiếu</div>
                        <div class="ord-popup-stat-value">@Model.BalanceDue.ToString("N0") đ</div>
                    </div>
                </div>

                <div class="ord-popup-table-wrap">
                    <div class="table-responsive">
                        <table class="table ord-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Phương thức</th>
                                    <th>Mã tham chiếu</th>
                                    <th>Thời gian</th>
                                    <th class="text-end">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DepositAmount > 0)
                                {
                                    <tr>
                                        <td><strong>Tiền cọc đã dùng</strong></td>
                                        <td>Trừ từ số dư cọc khách hàng</td>
                                        <td>—</td>
                                        <td class="text-end fw-bold">@Model.DepositAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                                @if ((Model.Payments == null || !Model.Payments.Any()) && Model.DepositAmount <= 0)
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="ord-empty">
                                                <div class="ord-empty-title">Chưa có thanh toán</div>
                                                <div class="ord-empty-desc">Đơn này chưa có dữ liệu payment.</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (Model.Payments != null)
                                {
                                    foreach (var p in Model.Payments)
                                    {
                                        <tr>
                                            <td><strong>@p.Method</strong></td>
                                            <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</td>
                                            <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end fw-bold">@p.Amount.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ord btn-ord-soft" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-clean" id="returnRefundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Trả hàng / hoàn tiền</h5>
                    <div class="small text-muted mt-1">Nhập nhanh số lượng trả, tiền hoàn và lưu thành phiếu</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="returnRefundModalBody">
                    <div class="text-center py-5 text-muted">Đang tải dữ liệu...</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ord btn-ord-soft" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-ord btn-ord-primary" id="btnSubmitReturnRefund">Lưu phiếu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-clean" id="returnHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Lịch sử trả hàng / hoàn tiền</h5>
                    <div class="small text-muted mt-1">Các lần xử lý hậu mãi của đơn #@Model.OrderId</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="returnHistoryModalBody">
                    <div class="text-center py-5 text-muted">Đang tải lịch sử...</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ord btn-ord-soft" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script id="posOrderDetailPageScript"
            src="~/Admin/js/pos/pos.order.detail.page.js"
            asp-append-version="true"
            data-subtotal="@System.Convert.ToString(Model.Subtotal, System.Globalization.CultureInfo.InvariantCulture)"
            data-grand-total="@System.Convert.ToString(Model.GrandTotal, System.Globalization.CultureInfo.InvariantCulture)"
            data-paid-total="@System.Convert.ToString(Model.PaidTotal, System.Globalization.CultureInfo.InvariantCulture)"
            data-refundable-remaining="@System.Convert.ToString(Model.RefundableRemaining, System.Globalization.CultureInfo.InvariantCulture)"></script>
}
