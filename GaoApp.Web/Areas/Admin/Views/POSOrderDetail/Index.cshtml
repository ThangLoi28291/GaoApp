                        <div class="ord-info-label">Mã đơn</div>
                        <div class="ord-info-value">@Model.OrderNumber</div>
                        <div class="ord-info-sub">ID: @Model.OrderId</div>
                    </div>

                    <div class="ord-info">
                        <div class="ord-info-label">Trạng thái</div>
                        <div class="ord-badges">
                            <span class="ord-badge @GetStatusBadgeClass(Model.Status)">
                                @GetStatusTextVi(Model.Status)
                            </span>
                            <span class="ord-badge @GetPaymentBadgeClass(Model.PaymentStatus)">
                                @GetPaymentStatusTextVi(Model.PaymentStatus)
                            </span>
                        </div>
                    </div>

                    <div class="ord-info">
                        <div class="ord-info-label">Khách hàng</div>
                        <div class="ord-info-value">@DisplayCustomerName()</div>
                        <div class="ord-info-sub">SĐT: @DisplayCustomerPhone()</div>
                    </div>
                    @if (Model.DepositAmount > 0)
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Tiền cọc đã dùng</div>
                            <div class="ord-info-value">@Model.DepositAmount.ToString("N0") đ</div>
                            <div class="ord-info-sub">Cần trả sau cọc: <strong>@Math.Max(0, Model.GrandTotal - Model.DepositAmount).ToString("N0") đ</strong></div>
                            <div class="ord-info-sub">Tiền cọc được tính vào thanh toán, không phải giảm giá.</div>
                        </div>
                    }
                    @if (hasVoucher)
{
    <div class="ord-info">
        <div class="ord-info-label">Voucher đã dùng</div>

        <div class="ord-info-value">
            @Model.VoucherDiscountTotal.ToString("N0") đ
        </div>

        <div class="ord-info-sub">
            @voucherCount phiếu áp dụng cho đơn này
        </div>

        <div style="margin-top:10px; display:grid; gap:8px;">
                                @foreach (var v in rewardVouchers)
