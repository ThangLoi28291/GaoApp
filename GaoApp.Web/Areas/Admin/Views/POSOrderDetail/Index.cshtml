        @@media (max-width: 767.98px) {
            .ord-overview,
            .ord-popup-hero,
            .ret-summary,
            .ret-hero-stats {
                grid-template-columns: 1fr;
            }

            .ord-card-body,
            .ord-card-head {
                padding: 16px;
            }

            .order-actions {
                width: 100%;
                justify-content: flex-start;
            }

            .order-actions > * {
                flex: 1 1 calc(50% - 8px);
            }

            .return-refund-form .table-responsive {
                border-radius: 16px;
            }
        }
    </style>
}

@section header {
    <div class="order-head">
        <div>
            <h3 class="order-title">Chi tiết đơn POS</h3>
            <div class="order-subtitle">
                Theo dõi đơn hàng, hậu mãi và thanh toán trên một màn hình gọn, dễ hiểu
            </div>
        </div>

        <div class="order-actions">
            <a href="/admin/pos/orders-page" class="btn btn-ord btn-ord-soft">Quay lại</a>

            <a href="/admin/pos/orders/@Model.OrderId/print?size=80&autoPrint=false"
               target="_blank"
               class="btn btn-ord btn-ord-primary">
                In lại hóa đơn
            </a>

            @if (canVoid)
            {
                <button type="button"
                        class="btn btn-ord btn-ord-danger"
                        onclick="openOrderActionModal('void', @Model.OrderId)">
                    Void
                </button>
            }

            @if (canRefund)
            {
                <button type="button"
                        class="btn btn-ord btn-ord-warning"
                        onclick="openOrderActionModal('refund', @Model.OrderId)">
                    Refund
                </button>
            }

            @if (canReturn)
            {
                <button type="button"
                        class="btn btn-ord btn-ord-info"
                        onclick="openReturnRefundModal(@Model.OrderId)">
                    Trả hàng / hoàn tiền
                </button>

                <button type="button"
                        class="btn btn-ord btn-ord-soft"
                        onclick="openReturnHistoryModal(@Model.OrderId)">
                    Lịch sử trả hàng
                </button>
            }
        </div>
    </div>
}

<div class="order-page">
    @Html.AntiForgeryToken()

    <div class="ord-overview">
        <div class="ord-stat primary">
            <div class="ord-stat-label">Tổng tiền đơn</div>
            <div class="ord-stat-value">@Model.GrandTotal.ToString("N0") đ</div>
        </div>

        <div class="ord-stat success">
            <div class="ord-stat-label">Đã thanh toán</div>
            <div class="ord-stat-value">@Model.PaidTotal.ToString("N0") đ</div>
        </div>

        <div class="ord-stat info">
            <div class="ord-stat-label">Đã hoàn</div>
            <div class="ord-stat-value">@Model.RefundedTotal.ToString("N0") đ</div>
        </div>

        <div class="ord-stat warning">
            <div class="ord-stat-label">Còn có thể hoàn</div>
            <div class="ord-stat-value">@Model.RefundableRemaining.ToString("N0") đ</div>
        </div>

        <div class="ord-stat info">
            <div class="ord-stat-label">Số thanh toán</div>
            <div class="ord-stat-value">@paymentCount</div>
        </div>

        <div class="ord-stat danger">
            <div class="ord-stat-label">Hậu mãi</div>
            <div class="ord-stat-value">@(hasAfterSaleHistory ? "Có phát sinh" : "Chưa có")</div>
        </div>
    </div>

    <div class="ord-layout">
        <div class="ord-card">
            <div class="ord-card-head">
                <h5 class="ord-card-title">Thông tin đơn hàng</h5>
                <div class="ord-card-subtitle">Giữ phần chính thật gọn để dễ xem, dễ thao tác tại quầy</div>
            </div>

            <div class="ord-card-body">
                <div class="ord-side-grid">
                    <div class="ord-info">
                        <div class="ord-info-label">Mã đơn</div>
                        <div class="ord-info-value">@Model.OrderNumber</div>
                        <div class="ord-info-sub">ID: @Model.OrderId</div>
                    </div>

                    <div class="ord-info">
                        <div class="ord-info-label">Trạng thái</div>
                        <div class="ord-badges">
                            <span class="ord-badge @GetStatusBadgeClass(Model.Status)">
                                @GetStatusTextVi(Model.Status)
                            </span>
                            <span class="ord-badge @GetPaymentBadgeClass(Model.PaymentStatus)">
                                @GetPaymentStatusTextVi(Model.PaymentStatus)
                            </span>
                        </div>
                    </div>

                    <div class="ord-info">
                        <div class="ord-info-label">Khách hàng</div>
                        <div class="ord-info-value">@DisplayCustomerName()</div>
                        <div class="ord-info-sub">SĐT: @DisplayCustomerPhone()</div>
                    </div>

                    <div class="ord-info">
                        <div class="ord-info-label">Nhân viên / Ca POS</div>
                        <div class="ord-info-value">@DisplayCashierName()</div>
                        <div class="ord-info-sub">@(string.IsNullOrWhiteSpace(Model.ShiftCode) ? "-" : Model.ShiftCode)</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(cleanUserNote))
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Ghi chú</div>
                            <div class="ord-info-value" style="font-size:.96rem; font-weight:700; white-space:pre-line;">
                                @cleanUserNote
                            </div>
                        </div>
                    }

                    @if (hasAfterSaleHistory)
                    {
                        <div class="ord-info">
                            <div class="ord-info-label">Hậu mãi / hoàn trả</div>
                            <div class="ord-info-value">Đơn này đã phát sinh thao tác hoàn / trả.</div>
                            <div class="ord-info-sub">
                                Đã hoàn: <strong>@Model.RefundedTotal.ToString("N0") đ</strong>
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 ms-1"
                                        onclick="openReturnHistoryModal(@Model.OrderId)">
                                    Xem lịch sử
