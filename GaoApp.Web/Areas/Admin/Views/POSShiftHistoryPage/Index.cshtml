@using GaoApp.Web.Areas.Admin.ViewModels.POS
@{
    ViewData["Title"] = "Lịch sử ca của tôi";
    Layout = "_ContentNavbarLayout";
    var posCtx = ViewBag.POSHeaderContext as POSHeaderContextViewModel ?? new POSHeaderContextViewModel();
}

@section VendorStyles {
    <link rel="stylesheet"
          href="~/Admin/css/pos/pos-shift-history.css"
          asp-append-version="true" />
}

@section header {
    <div class="py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3 class="mb-1 fw-bold">Lịch sử ca của tôi</h3>
            <div class="text-muted">Theo dõi các ca POS do chính bạn mở và chốt trong hệ thống</div>
        </div>
    </div>
}

<partial name="~/Areas/Admin/Views/Shared/_POSNavTabs.cshtml" />
<partial name="~/Areas/Admin/Views/Shared/_POSWorkContextBar.cshtml" model="posCtx" />

<div class="shift-history-shell">
    @Html.AntiForgeryToken()

    <div class="card filter-shell mb-3">
        <div class="card-body">
            <div class="shift-section-head">
                <h4 class="shift-section-title">Bộ lọc lịch sử ca</h4>
                <div class="shift-section-sub">Chọn khoảng thời gian và trạng thái để tìm đúng ca cần xem</div>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="filter-label">Trạng thái</label>
                    <select id="filterStatus" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1">Đang mở</option>
                        <option value="2">Đã đóng</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="filter-label">Từ ngày</label>
                    <input id="filterFrom" type="date" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="filter-label">Đến ngày</label>
                    <input id="filterTo" type="date" class="form-control" />
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button id="btnSearch" class="btn btn-primary w-100 search-btn">
                        Tìm kiếm
                    </button>
                </div>
            </div>

            <div class="quick-filter-group">
                <button id="btnToday" type="button" class="btn btn-outline-secondary quick-filter-btn">Hôm nay</button>
                <button id="btnLast7Days" type="button" class="btn btn-outline-secondary quick-filter-btn">7 ngày gần đây</button>
                <button id="btnLast30Days" type="button" class="btn btn-outline-secondary quick-filter-btn">30 ngày gần đây</button>
                <button id="btnClearDate" type="button" class="btn btn-outline-danger quick-filter-btn">Xóa lọc ngày</button>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-7 col-lg-7">
            <div class="card shift-history-card">
                <div class="card-body">
                    <div class="shift-section-head">
                        <h4 class="shift-section-title">Danh sách ca</h4>
                        <div class="shift-section-sub">Chọn một ca để xem tổng quan chi tiết ở khung bên phải</div>
                    </div>

                    <div class="history-table-wrap">
                        <div class="table-responsive">
                            <table class="table align-middle history-table">
                                <thead>
                                    <tr>
                                        <th style="width:150px;">Ca</th>
                                        <th style="width:130px;">Trạng thái</th>
                                        <th style="width:180px;">Mở lúc</th>
                                        <th style="width:180px;">Đóng lúc</th>
                                        <th style="width:150px;">Tiền đầu ca</th>
                                        <th style="width:150px;">DT tiền mặt</th>
                                    </tr>
                                </thead>
                                <tbody id="historyBody">
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Đang tải...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="paging-bar">
                        <div class="paging-left">
                            <div id="historyPagingInfo" class="paging-info">-</div>

                            <div class="paging-page-size">
                                <label for="pageSizeSelect">Hiển thị</label>
                                <select id="pageSizeSelect" class="form-select">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                </select>
                            </div>
                        </div>

                        <div class="paging-actions">
                            <button id="btnPrevPage" class="btn btn-outline-secondary paging-btn">Trang trước</button>
                            <button id="btnNextPage" class="btn btn-outline-secondary paging-btn">Trang sau</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5 col-lg-5">
            <div class="card shift-history-card">
                <div class="card-body">
                    <div class="shift-section-head">
                        <h4 class="shift-section-title">Tổng quan ca được chọn</h4>
                        <div class="shift-section-sub">Tóm tắt nhanh đơn hàng, doanh thu và thu chi tiền mặt của ca</div>
                    </div>

                    <div id="summaryEmpty" class="summary-empty">
                        Chọn một ca ở danh sách bên trái để xem chi tiết.
                    </div>

                    <div id="summaryContent" style="display:none;">
                        <div class="summary-selected-head">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <div id="selectedShiftCode" class="summary-stat-value" style="font-size:1.15rem;">-</div>
                                    <div class="shift-section-sub mt-1">Thông tin ca đang được chọn</div>
                                </div>
                                <div id="selectedShiftStatus"></div>
                            </div>

                            <div class="summary-selected-grid">
                                <div class="summary-selected-item">
                                    <div class="summary-selected-label">Mở lúc</div>
                                    <div id="selectedOpenedAt" class="summary-selected-value">-</div>
                                </div>
                                <div class="summary-selected-item">
                                    <div class="summary-selected-label">Đóng lúc</div>
                                    <div id="selectedClosedAt" class="summary-selected-value">-</div>
                                </div>
                            </div>
                        </div>

                        <div class="summary-stat-grid">
                            <div class="summary-stat-box">
                                <div class="summary-stat-label">Tổng đơn</div>
                                <div id="sumTotalOrders" class="summary-stat-value">0</div>
                            </div>

                            <div class="summary-stat-box">
                                <div class="summary-stat-label">Đơn hoàn tất</div>
                                <div id="sumCompletedOrders" class="summary-stat-value">0</div>
                            </div>

                            <div class="summary-stat-box">
                                <div class="summary-stat-label">Đơn nháp</div>
                                <div id="sumDraftOrders" class="summary-stat-value">0</div>
                            </div>

                            <div class="summary-stat-box">
                                <div class="summary-stat-label">Đơn đã hủy</div>
                                <div id="sumCancelledOrders" class="summary-stat-value">0</div>
                            </div>

                            <div class="summary-stat-box accent summary-stat-wide">
                                <div class="summary-stat-label">Tổng bán hoàn tất</div>
                                <div id="sumCompletedSalesTotal" class="summary-stat-value primary">0</div>
                            </div>
                        </div>

                        <section class="financial-snapshot" aria-labelledby="financialSnapshotTitle">
                            <div class="financial-snapshot-head">
                                <div>
                                    <h5 id="financialSnapshotTitle" class="financial-snapshot-title">Chi tiết tài chính ca</h5>
                                    <div class="financial-snapshot-sub">
                                        Số liệu tài chính được lấy trực tiếp từ tổng quan ca trong hệ thống.
                                    </div>
                                </div>
                                <span class="financial-snapshot-badge">Tài chính</span>
                            </div>

                            <div class="financial-snapshot-grid">
                                <div class="financial-group">
                                    <div class="financial-group-title">Doanh thu</div>

                                    <div class="financial-row">
                                        <span class="financial-label">Tiền mặt</span>
                                        <strong id="sumCashSalesTotal" class="financial-value success">0</strong>
                                    </div>

                                    <div class="financial-row">
                                        <span class="financial-label">Không tiền mặt</span>
                                        <strong id="sumNonCashSalesTotal" class="financial-value">0</strong>
                                    </div>
                                </div>

                                <div class="financial-group">
                                    <div class="financial-group-title">Hoàn tiền</div>

                                    <div class="financial-row">
                                        <span class="financial-label">Hoàn tiền mặt</span>
                                        <strong id="sumCashRefundTotal" class="financial-value danger">0</strong>
                                    </div>

                                    <div class="financial-row">
                                        <span class="financial-label">Hoàn không tiền mặt</span>
                                        <strong id="sumNonCashRefundTotal" class="financial-value danger">0</strong>
                                    </div>

                                    <div class="financial-row financial-row-total">
                                        <span class="financial-label">Tổng hoàn tiền</span>
                                        <strong id="sumRefundTotal" class="financial-value danger">0</strong>
                                    </div>
                                </div>

                                <div class="financial-group">
                                    <div class="financial-group-title">Dòng tiền két</div>

                                    <div class="financial-row">
                                        <span class="financial-label">Tiền đầu ca</span>
                                        <strong id="sumOpeningCash" class="financial-value primary">0</strong>
                                    </div>

                                    <div class="financial-row">
                                        <span class="financial-label">Thu thêm</span>
                                        <strong id="sumCashInTotal" class="financial-value success">0</strong>
                                    </div>

                                    <div class="financial-row">
                                        <span class="financial-label">Chi ra</span>
                                        <strong id="sumCashOutTotal" class="financial-value danger">0</strong>
                                    </div>
                                </div>

                                <div class="financial-group financial-group-emphasis">
                                    <div class="financial-group-title">Tiền cuối ca</div>

                                    <div class="financial-row">
                                        <span class="financial-label">Dự kiến</span>
                                        <strong id="sumClosingCashExpected" class="financial-value primary">0</strong>
                                    </div>

                                    <div class="financial-row">
                                        <span class="financial-label">Thực tế</span>
                                        <strong id="sumClosingCashActual" class="financial-value">-</strong>
                                    </div>

                                    <div id="sumClosingCashActualHint" class="financial-hint">
                                        Chưa ghi nhận tiền cuối ca thực tế.
                                    </div>
                                </div>
                            </div>

                            <div class="shift-note-grid">
                                <div class="shift-note-card">
                                    <div class="shift-note-title">Ghi chú mở ca</div>
                                    <div id="sumOpenNote" class="shift-note-text">-</div>
                                </div>

                                <div class="shift-note-card">
                                    <div class="shift-note-title">Ghi chú đóng ca</div>
                                    <div id="sumCloseNote" class="shift-note-text">-</div>
                                </div>
                            </div>
                        </section>

                        <div class="shift-report-toolbar" aria-label="Báo cáo ca">
                            <div class="shift-report-toolbar-copy">
                                <div class="shift-report-toolbar-title">Báo cáo ca</div>
                                <div class="shift-report-toolbar-sub">
                                    In báo cáo đầy đủ của ca đang chọn hoặc xuất CSV để lưu trữ / đối soát.
                                </div>
                            </div>

                            <div class="shift-report-toolbar-actions">
                                <button id="btnPrintShiftReport"
                                        type="button"
                                        class="btn btn-outline-primary shift-report-btn"
                                        disabled>
                                    In báo cáo
                                </button>

                                <button id="btnExportShiftReport"
                                        type="button"
                                        class="btn btn-outline-secondary shift-report-btn"
                                        disabled>
                                    Xuất CSV
                                </button>
                            </div>
                        </div>

                        <div class="summary-action-grid">
                            <div class="summary-action-card">
                                <div>
                                    <div class="summary-action-title">Danh sách đơn</div>
                                    <div class="summary-action-sub">Xem toàn bộ đơn thuộc ca đang chọn</div>
                                </div>
                                <div class="summary-action-meta">
                                    <div class="summary-action-number" id="ordersCountText">0</div>
                                    <button id="btnOpenOrdersModal" type="button" class="btn btn-primary summary-action-btn">
                                        Xem đơn
                                    </button>
                                </div>
                            </div>

                            <div class="summary-action-card">
                                <div>
                                    <div class="summary-action-title">Thu / chi tiền mặt</div>
                                    <div class="summary-action-sub">Xem các giao dịch tiền mặt phát sinh trong ca</div>
                                </div>
                                <div class="summary-action-meta">
                                    <div class="summary-action-number" id="cashTxnsCountText">0</div>
                                    <button id="btnOpenCashTxnsModal" type="button" class="btn btn-outline-primary summary-action-btn">
                                        Xem thu / chi
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade shift-history-modal" id="ordersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Danh sách đơn trong ca</h5>
                    <div class="shift-section-sub mt-1">Xem chi tiết các đơn thuộc ca đang chọn</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="history-table-wrap">
                    <div class="table-responsive">
                        <table class="table align-middle history-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:70px;">ID</th>
                                    <th style="width:170px;">Mã đơn</th>
                                    <th style="width:135px;">Trạng thái</th>
                                    <th style="width:165px;">Thanh toán</th>
                                    <th style="width:155px;">Tạo lúc</th>
                                    <th style="width:155px;">Hoàn tất lúc</th>
                                    <th style="width:145px;" class="text-end">Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody id="ordersModalBody">
                                <tr>
                                    <td colspan="7" class="summary-muted-empty">Không có dữ liệu.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-paging-bar">
                    <div id="ordersModalPagingInfo" class="modal-paging-info">0 đơn</div>
                    <div class="modal-paging-actions">
                        <button id="btnOrdersModalPrev" type="button" class="btn btn-outline-secondary modal-paging-btn">Trang trước</button>
                        <button id="btnOrdersModalNext" type="button" class="btn btn-outline-secondary modal-paging-btn">Trang sau</button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light modal-paging-btn" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade shift-history-modal" id="cashTxnsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Thu / chi tiền mặt trong ca</h5>
                    <div class="shift-section-sub mt-1">Xem loại giao dịch, số tiền, lý do, ghi chú và thời gian phát sinh</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="history-table-wrap">
                    <div class="table-responsive">
                        <table class="table align-middle history-table cash-txn-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:155px;">Thời gian</th>
                                    <th style="width:145px;">Loại</th>
                                    <th style="width:150px;" class="text-end">Số tiền</th>
                                    <th style="width:210px;">Lý do</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody id="cashTxnsModalBody">
                                <tr>
                                    <td colspan="5" class="summary-muted-empty">Không có dữ liệu.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-paging-bar">
                    <div id="cashTxnsModalPagingInfo" class="modal-paging-info">0 giao dịch</div>
                    <div class="modal-paging-actions">
                        <button id="btnCashTxnsModalPrev" type="button" class="btn btn-outline-secondary modal-paging-btn">Trang trước</button>
                        <button id="btnCashTxnsModalNext" type="button" class="btn btn-outline-secondary modal-paging-btn">Trang sau</button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light modal-paging-btn" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
@section PageScripts {
    <script src="~/Admin/js/printing/print.lifecycle.js" asp-append-version="true"></script>
    <script src="~/Admin/js/pos/pos.shift.history.page.js"
            asp-append-version="true"></script>
}
