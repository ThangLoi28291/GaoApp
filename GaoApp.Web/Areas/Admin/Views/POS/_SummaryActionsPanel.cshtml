@* =========================================================
   POS v0.2 P1
   State-driven Next Action area.

   Business handlers remain owned by existing POS JavaScript.
========================================================= *@

<div class="pos-cockpit-action-shell">

    <div id="posSummaryActionGrid"
         class="pos-action-grid pos-action-grid--smart pos-cockpit-actions is-empty">

        <button id="btnNewCart"
                type="button"
                class="d-none"
                tabindex="-1"
                aria-hidden="true">
            Tạo giỏ mới
        </button>

        <div class="pos-cockpit-primary-actions">

            <button id="btnOpenPayment"
                    class="btn pos-action-btn pos-action-btn--payment"
                    type="button">

                <span>Thanh toán</span>

                <span class="shortcut-badge">
                    F3
                </span>
            </button>

            <button id="btnFinalizeCart"
                    class="btn pos-action-btn pos-action-btn--finalize"
                    type="button">

                <span>Chốt đơn</span>

                <span class="shortcut-badge">
                    F4
                </span>
            </button>
        </div>

        <div class="pos-cockpit-secondary-actions">

            <button id="btnHoldCart"
                    class="btn pos-action-btn pos-action-btn--secondary"
                    type="button">

                <span>Giữ đơn</span>

                <span class="shortcut-badge">
                    F2
                </span>
            </button>

            <button id="btnClearCartLines"
                    class="btn pos-action-btn pos-action-btn--secondary"
                    type="button">
                <span>Xóa hết sản phẩm</span>
            </button>

            <button id="btnCancelCart"
                    class="btn pos-action-btn pos-action-btn--danger-soft"
                    type="button">
                Hủy giỏ
            </button>
        </div>
    </div>
</div>
