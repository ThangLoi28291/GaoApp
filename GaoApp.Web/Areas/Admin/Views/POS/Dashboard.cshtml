@{
    ViewData["Title"] = "POS Dashboard";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <link rel="stylesheet"
          href="~/Admin/css/pos/pos-dashboard.css"
          asp-append-version="true" />
}

@section header {
    <div class="pos-dashboard-page-head">
        <div class="pos-dashboard-heading">
            <div class="pos-dashboard-eyebrow">CURRENT SHIFT OPERATIONS</div>
            <h3 class="pos-dashboard-title">POS Dashboard</h3>
            <p class="pos-dashboard-subtitle mb-0">
                Theo dõi vận hành ca hiện tại, đơn hoàn tất và dòng tiền theo thời gian thực.
            </p>
        </div>

        <div class="pos-dashboard-live-tools">
            <div id="dashboardLiveStatus"
                 class="pos-dashboard-live-pill is-loading"
                 role="status"
                 aria-live="polite">
                <span class="pos-dashboard-live-mark" aria-hidden="true"></span>
                <span id="dashboardLiveStatusText">Đang kết nối</span>
            </div>

            <div class="pos-dashboard-refresh-meta">
                <span class="pos-dashboard-refresh-label">Cập nhật</span>
                <strong id="dashboardLastRefreshText">--:--:--</strong>
            </div>

            <button type="button"
                    id="btnRefreshDashboard"
                    class="btn btn-outline-primary pos-dashboard-refresh-btn">
                <i class="bx bx-refresh" aria-hidden="true"></i>
                <span>Làm mới</span>
            </button>
        </div>
    </div>
}

<partial name="~/Areas/Admin/Views/Shared/_POSNavTabs.cshtml" />

<div id="posDashboardV2"
     class="pos-dashboard-v2"
     data-pos-dashboard-v2
     data-probe-url="/admin/pos/shift/dashboard"
     data-summary-url-template="/admin/pos/shift/summary?shiftId={shiftId}"
     aria-busy="true">

    <div id="dashboardLiveRegion" class="visually-hidden" aria-live="polite"></div>

    <section id="dashboardSkeleton" class="pos-dashboard-skeleton" aria-label="Đang tải dashboard">
        <div class="pos-dashboard-skeleton-strip pos-dashboard-skeleton-block"></div>

        <div class="pos-dashboard-kpi-grid" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="pos-dashboard-kpi-card is-skeleton">
                    <span class="pos-dashboard-skeleton-line w-40"></span>
                    <span class="pos-dashboard-skeleton-line w-70 is-value"></span>
                    <span class="pos-dashboard-skeleton-line w-55"></span>
                </div>
            }
        </div>

        <div class="pos-dashboard-main-grid" aria-hidden="true">
            <div class="pos-dashboard-card pos-dashboard-skeleton-chart">
                <span class="pos-dashboard-skeleton-line w-40"></span>
                <span class="pos-dashboard-skeleton-block is-chart"></span>
            </div>
            <div class="pos-dashboard-card pos-dashboard-skeleton-chart">
                <span class="pos-dashboard-skeleton-line w-55"></span>
                <span class="pos-dashboard-skeleton-block is-chart"></span>
            </div>
        </div>

        <div class="pos-dashboard-secondary-grid" aria-hidden="true">
            <div class="pos-dashboard-card pos-dashboard-skeleton-chart">
                <span class="pos-dashboard-skeleton-line w-40"></span>
                <span class="pos-dashboard-skeleton-block is-chart compact"></span>
            </div>
            <div class="pos-dashboard-card pos-dashboard-skeleton-chart">
                <span class="pos-dashboard-skeleton-line w-55"></span>
                <span class="pos-dashboard-skeleton-block is-chart compact"></span>
            </div>
        </div>
    </section>

    <section id="dashboardStatePanel"
             class="pos-dashboard-state-panel"
             aria-live="polite"
             hidden>
        <div id="dashboardStateIcon" class="pos-dashboard-state-icon" aria-hidden="true">
            <i class="bx bx-info-circle"></i>
        </div>
        <h4 id="dashboardStateTitle" class="pos-dashboard-state-title">Không tải được dashboard</h4>
        <p id="dashboardStateMessage" class="pos-dashboard-state-message mb-0"></p>
        <div id="dashboardStateActions" class="pos-dashboard-state-actions"></div>
    </section>

    <div id="dashboardContent" class="pos-dashboard-content" hidden>
        <section class="pos-dashboard-shift-strip" aria-labelledby="currentShiftHeading">
            <div class="pos-dashboard-shift-main">
                <div class="pos-dashboard-shift-status-icon" aria-hidden="true">
                    <i class="bx bx-time-five"></i>
                </div>
                <div>
                    <div class="pos-dashboard-shift-label" id="currentShiftHeading">Ca hiện tại</div>
                    <div class="pos-dashboard-shift-title-row">
                        <strong id="dashboardShiftCode">-</strong>
                        <span class="pos-dashboard-status-badge">
                            <span class="pos-dashboard-status-dot" aria-hidden="true"></span>
                            Đang mở
                        </span>
                    </div>
                </div>
            </div>

            <div class="pos-dashboard-shift-facts">
                <div class="pos-dashboard-shift-fact">
                    <span>Mở lúc</span>
                    <strong id="dashboardOpenedAt">-</strong>
                </div>
                <div class="pos-dashboard-shift-fact">
                    <span>Đã hoạt động</span>
                    <strong id="dashboardElapsed">-</strong>
                </div>
            </div>
        </section>

        <section class="pos-dashboard-kpi-grid" aria-label="Chỉ số chính của ca hiện tại">
            <article class="pos-dashboard-kpi-card is-primary">
                <div class="pos-dashboard-kpi-head">
                    <span class="pos-dashboard-kpi-label">Giá trị đơn hoàn tất</span>
                    <span class="pos-dashboard-kpi-icon" aria-hidden="true"><i class="bx bx-wallet"></i></span>
                </div>
                <div id="kpiCompletedSales" class="pos-dashboard-kpi-value">0 ₫</div>
                <div class="pos-dashboard-kpi-note">Từ các đơn hiện đang hoàn tất trong ca</div>
            </article>

            <article class="pos-dashboard-kpi-card">
                <div class="pos-dashboard-kpi-head">
                    <span class="pos-dashboard-kpi-label">Đơn hoàn tất</span>
                    <span class="pos-dashboard-kpi-icon" aria-hidden="true"><i class="bx bx-receipt"></i></span>
                </div>
                <div id="kpiCompletedOrders" class="pos-dashboard-kpi-value">0</div>
                <div class="pos-dashboard-kpi-note">Trong ca hiện tại</div>
            </article>

            <article class="pos-dashboard-kpi-card">
                <div class="pos-dashboard-kpi-head">
                    <span class="pos-dashboard-kpi-label">Giá trị TB đơn hoàn tất</span>
                    <span class="pos-dashboard-kpi-icon" aria-hidden="true"><i class="bx bx-trending-up"></i></span>
                </div>
                <div id="kpiAverageOrderValue" class="pos-dashboard-kpi-value">0 ₫</div>
                <div id="kpiAverageOrderNote" class="pos-dashboard-kpi-note">Chưa có đơn hoàn tất</div>
            </article>

            <article class="pos-dashboard-kpi-card is-cash-position">
                <div class="pos-dashboard-kpi-head">
                    <span class="pos-dashboard-kpi-label">Tiền mặt dự kiến tại quầy</span>
                    <span class="pos-dashboard-kpi-icon" aria-hidden="true"><i class="bx bx-money"></i></span>
                </div>
                <div id="kpiClosingCashExpected" class="pos-dashboard-kpi-value">0 ₫</div>
                <div class="pos-dashboard-kpi-note">Theo trạng thái quỹ của ca</div>
            </article>
        </section>

        <section class="pos-dashboard-main-grid" aria-label="Phân tích trực quan chính">
            <article class="pos-dashboard-card pos-dashboard-chart-card">
                <div class="pos-dashboard-card-head">
                    <div>
                        <h4 class="pos-dashboard-card-title">Giá trị đơn hoàn tất theo giờ</h4>
                        <p class="pos-dashboard-card-subtitle mb-0">
                            Mỗi cột là một giờ có phát sinh đơn hoàn tất.
                        </p>
                    </div>
                    <span class="pos-dashboard-card-chip">Giờ có phát sinh</span>
                </div>
                <div class="pos-dashboard-card-body">
                    <div id="completedSalesChart"
                         class="pos-dashboard-chart"
                         role="img"
                         aria-label="Biểu đồ giá trị đơn hoàn tất theo giờ"></div>
                    <p id="completedSalesChartSummary" class="pos-dashboard-chart-summary mb-0"></p>
                </div>
            </article>

            <article class="pos-dashboard-card pos-dashboard-payment-card">
                <div class="pos-dashboard-card-head">
                    <div>
                        <h4 class="pos-dashboard-card-title">Cơ cấu tiền bán</h4>
                        <p class="pos-dashboard-card-subtitle mb-0">Tỷ trọng Cash và Non-cash của ca hiện tại.</p>
                    </div>
                </div>
                <div class="pos-dashboard-card-body">
                    <div class="pos-dashboard-mix-total">
                        <span>Tổng tiền bán theo payment bucket</span>
                        <strong id="paymentMixTotal">0 ₫</strong>
                    </div>

                    <div class="pos-dashboard-stack" aria-hidden="true">
                        <span id="paymentMixCashBar" class="pos-dashboard-stack-cash" style="width: 0%"></span>
                        <span id="paymentMixNonCashBar" class="pos-dashboard-stack-noncash" style="width: 0%"></span>
                    </div>

                    <div class="pos-dashboard-mix-list">
                        <div class="pos-dashboard-mix-row">
                            <span class="pos-dashboard-mix-label">
                                <span class="pos-dashboard-mix-swatch is-cash" aria-hidden="true"></span>
                                Tiền mặt
                            </span>
                            <span class="pos-dashboard-mix-value">
                                <strong id="paymentMixCashAmount">0 ₫</strong>
                                <small id="paymentMixCashPercent">0%</small>
                            </span>
                        </div>

                        <div class="pos-dashboard-mix-row">
                            <span class="pos-dashboard-mix-label">
                                <span class="pos-dashboard-mix-swatch is-noncash" aria-hidden="true"></span>
                                Không tiền mặt
                            </span>
                            <span class="pos-dashboard-mix-value">
                                <strong id="paymentMixNonCashAmount">0 ₫</strong>
                                <small id="paymentMixNonCashPercent">0%</small>
                            </span>
                        </div>
                    </div>

                    <p id="paymentMixSummary" class="pos-dashboard-chart-summary mb-0"></p>
                </div>
            </article>
        </section>

        <section class="pos-dashboard-secondary-grid" aria-label="Phân tích đơn hàng và dòng tiền">
            <article class="pos-dashboard-card pos-dashboard-chart-card">
                <div class="pos-dashboard-card-head">
                    <div>
                        <h4 class="pos-dashboard-card-title">Đơn hoàn tất theo giờ</h4>
                        <p class="pos-dashboard-card-subtitle mb-0">Mỗi cột thể hiện số đơn hoàn tất trong một giờ có phát sinh.</p>
                    </div>
                </div>
                <div class="pos-dashboard-card-body">
                    <div id="completedOrdersChart"
                         class="pos-dashboard-chart is-compact"
                         role="img"
                         aria-label="Biểu đồ số đơn hoàn tất theo giờ"></div>
                    <p id="completedOrdersChartSummary" class="pos-dashboard-chart-summary mb-0"></p>
                </div>
            </article>

            <article class="pos-dashboard-card pos-dashboard-shift-health">
                <div class="pos-dashboard-card-head">
                    <div>
                        <h4 class="pos-dashboard-card-title">Ca &amp; dòng tiền</h4>
                        <p class="pos-dashboard-card-subtitle mb-0">Ảnh chụp nhanh trạng thái quỹ của ca hiện tại.</p>
                    </div>
                </div>
                <div class="pos-dashboard-health-list">
                    <div class="pos-dashboard-health-row">
                        <span>Tiền đầu ca</span>
                        <strong id="healthOpeningCash">0 ₫</strong>
                    </div>
                    <div class="pos-dashboard-health-row">
                        <span>Tiền bán tiền mặt</span>
                        <strong id="healthCashSales">0 ₫</strong>
                    </div>
                    <div class="pos-dashboard-health-row">
                        <span>Tiền bán không tiền mặt</span>
                        <strong id="healthNonCashSales">0 ₫</strong>
                    </div>
                    <div class="pos-dashboard-health-row">
                        <span>Thu thêm</span>
                        <strong id="healthCashIn">0 ₫</strong>
                    </div>
                    <div class="pos-dashboard-health-row">
                        <span>Chi ra</span>
                        <strong id="healthCashOut">0 ₫</strong>
                    </div>
                    <div class="pos-dashboard-health-row">
                        <span>Hoàn tiền</span>
                        <strong><span id="healthRefundTotal">0 ₫</span> · <span id="healthRefundCount">0</span> lượt</strong>
                    </div>
                    <div class="pos-dashboard-health-row is-emphasis">
                        <span>Tiền mặt dự kiến</span>
                        <strong id="healthClosingCashExpected">0 ₫</strong>
                    </div>
                </div>
            </article>
        </section>

        <section class="pos-dashboard-attention" aria-labelledby="dashboardAttentionHeading">
            <div class="pos-dashboard-attention-copy">
                <div class="pos-dashboard-attention-icon" aria-hidden="true">
                    <i class="bx bx-pulse"></i>
                </div>
                <div>
                    <div class="pos-dashboard-section-eyebrow">CẦN CHÚ Ý</div>
                    <h4 id="dashboardAttentionHeading" class="pos-dashboard-attention-title">Hậu mãi &amp; thao tác ca</h4>
                    <p id="dashboardAttentionMessage" class="pos-dashboard-attention-message mb-0">
                        Không có refund hoặc void trong ca hiện tại.
                    </p>
                </div>
            </div>

            <div class="pos-dashboard-attention-metrics">
                <div class="pos-dashboard-attention-metric">
                    <span>Refund</span>
                    <strong id="attentionRefund">0 ₫ · 0 lượt</strong>
                </div>
                <div class="pos-dashboard-attention-metric">
                    <span>Void</span>
                    <strong id="attentionVoid">0</strong>
                </div>
            </div>

            <div class="pos-dashboard-actions" aria-label="Đi tới màn vận hành POS">
                <a href="/admin/pos/orders-page" class="btn btn-primary">
                    <i class="bx bx-receipt" aria-hidden="true"></i>
                    <span>Xem Đơn POS</span>
                </a>
                <a href="/admin/pos-shift" class="btn btn-outline-primary">
                    <i class="bx bx-time-five" aria-hidden="true"></i>
                    <span>Ca POS</span>
                </a>
                <a href="/admin/pos-shift/history" class="btn btn-outline-secondary">
                    <i class="bx bx-history" aria-hidden="true"></i>
                    <span>Lịch sử ca</span>
                </a>
            </div>
        </section>
    </div>
</div>

@section PageScripts {
    <script id="posDashboardPageScript"
            src="~/Admin/js/pos/pos.dashboard.page.js"
            asp-append-version="true"></script>
}
