    </div>

    <!-- Thông tin ca -->
    <div class="row g-3">
        <div class="col-12">
            <div class="shift-card">
                <div class="shift-card-header">
                    <h5 class="shift-card-title">Thông tin chi tiết ca đang mở</h5>
                    <div class="shift-card-subtitle">
                        Các chỉ số vận hành để kiểm tra nhanh tại quầy
                    </div>
                </div>

                <div class="shift-card-body">
                    <div class="shift-detail-grid">
                        <div class="shift-info-box">
                            <div class="shift-info-label">Mã ca</div>
                            <div id="shiftCode" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">Mã nhận diện ca bán hàng</div>
                        </div>

                        <div class="shift-info-box">
                            <div class="shift-info-label">Mở lúc</div>
                            <div id="openedAt" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">Thời điểm bắt đầu ca hiện tại</div>
                        </div>

                        <div class="shift-info-box">
                            <div class="shift-info-label">Void</div>
                            <div id="voidCount" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">Số đơn hủy sau chốt trong ca</div>
                        </div>

                        <div class="shift-info-box">
                            <div class="shift-info-label">Refund giao dịch</div>
                            <div id="refundCount" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">Số giao dịch hoàn tiền phát sinh</div>
                        </div>

                        <div class="shift-info-box">
                            <div class="shift-info-label">Refund tổng</div>
                            <div id="refundTotalDetail" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">Tổng tiền hoàn trong ca</div>
                        </div>

                        <div class="shift-info-box">
                            <div class="shift-info-label">Shift ID</div>
                            <div id="shiftId" class="shift-info-value dash-loading">Đang tải...</div>
                            <div class="shift-info-meta">ID nội bộ phục vụ đối soát</div>
                        </div>
                    </div>

                    <div class="shift-foot-note">
                        <div class="shift-foot-note-text">
                            Dashboard tự làm mới dữ liệu để nhân viên và quản lý theo dõi số liệu gần thời gian thực.
                        </div>
                        <div class="shift-last-refresh">
                            Cập nhật gần nhất: <span id="lastRefreshAt">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        function formatMoney(value) {
            const n = Number(value || 0);
            return n.toLocaleString('vi-VN');
        }

        function formatDateTime(value) {
            if (!value) return '-';

            const d = new Date(value);
            return d.toLocaleString('vi-VN');
        }

        function updateLastRefreshTime() {
            const now = new Date();
            document.getElementById('lastRefreshAt').textContent = now.toLocaleTimeString('vi-VN');
        }

        function showError(msg) {
            if (window.toastr) {
                toastr.error(msg || 'Có lỗi xảy ra');
            } else {
                alert(msg || 'Có lỗi xảy ra');
            }
        }

        async function fetchJson(url, options = {}) {
            const res = await fetch(url, options);
            const contentType = res.headers.get('content-type') || '';

            let jsonData = null;
            let textData = '';

            try {
                if (contentType.includes('application/json')) {
                    jsonData = await res.json();
                } else {
                    textData = await res.text();
                }
            } catch { }

            if (!res.ok) {
                const msg =
                    jsonData?.message ||
                    jsonData?.title ||
                    jsonData?.error ||
                    textData ||
                    `Yêu cầu thất bại (${res.status})`;

                throw new Error(msg);
            }

            return jsonData ?? textData ?? null;
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) {
                el.textContent = value;
                el.classList.remove('dash-error');
            }
        }

        function setErrorState() {
            const ids = [
                'totalSales', 'cashSales', 'bankSales', 'ordersCount',
                'refundTotal', 'refundTotalDetail',
                'shiftCode', 'openedAt', 'voidCount', 'refundCount', 'shiftId',
                'shiftCodeHero', 'openedAtHero', 'heroTotalSales', 'heroOrdersCount',
                'heroVoidCount', 'heroRefundCount'
            ];

            ids.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.textContent = '-';
                    el.classList.add('dash-error');
                }
            });

            document.getElementById('lastRefreshAt').textContent = '-';
        }

        function renderDashboard(data) {
            const totalSales = formatMoney(data.totalSales);
            const cashSales = formatMoney(data.cashSales);
            const bankSales = formatMoney(data.bankSales);
            const refundTotal = formatMoney(data.refundTotal);
            const ordersCount = data.ordersCount ?? 0;
            const shiftCode = data.shiftCode || '-';
            const openedAt = formatDateTime(data.openedAt);
            const voidCount = data.voidCount ?? 0;
            const refundCount = data.refundCount ?? 0;
            const shiftId = data.shiftId ?? '-';

            setText('shiftCodeHero', shiftCode);
            setText('openedAtHero', openedAt);
            setText('heroTotalSales', totalSales);
            setText('heroOrdersCount', ordersCount);
            setText('heroVoidCount', voidCount);
            setText('heroRefundCount', refundCount);

            setText('totalSales', totalSales);
            setText('cashSales', cashSales);
            setText('bankSales', bankSales);
            setText('ordersCount', ordersCount);
            setText('refundTotal', refundTotal);

            setText('shiftCode', shiftCode);
            setText('openedAt', openedAt);
            setText('voidCount', voidCount);
            setText('refundCount', refundCount);
            setText('refundTotalDetail', refundTotal);
            setText('shiftId', shiftId);

            updateLastRefreshTime();
        }

        async function loadDashboard() {
            try {
                const data = await fetchJson('/admin/pos/shift/dashboard');
                renderDashboard(data);
            } catch (err) {
                setErrorState();
                showError(err.message || 'Không tải được dashboard ca POS.');
            }
        }

        document.addEventListener('DOMContentLoaded', async function () {
            await loadDashboard();

            setInterval(async function () {
                await loadDashboard();
            }, 5000);
        });
    </script>
}