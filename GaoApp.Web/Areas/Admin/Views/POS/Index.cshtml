<script src="~/Admin/js/pos/pos.cockpit.js"
        asp-append-version="true"></script>

<script src="~/Admin/js/pos/pos.app.js"
        asp-append-version="true"></script>

    @* PRIME_ADAPTER_SCRIPT_BEGIN *@
    @if (isPrime)
    {
        <script src="~/Admin/js/pos/pos.prime.js" asp-append-version="true"></script>
    }
    @* PRIME_ADAPTER_SCRIPT_END *@
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            @* PRIME_ADAPTER_BOOTSTRAP_BEGIN *@
            @if (isPrime)
            {
                <text>
            // Install overlay guards before the existing keyboard owner binds.
            // Adapter failure keeps the P2 accessible fallback; startup continues.
            try {
                if (window.PosPrime) {
                    window.PosPrime.mount();
                } else {
                    console.warn('POS Prime mobile adapter unavailable; using fallback layout.');
                }
            } catch (error) {
                console.error('POS Prime mobile adapter failed; using fallback layout.', error);
            }
                </text>
            }
            @* PRIME_ADAPTER_BOOTSTRAP_END *@
            const app = window.PosApp.create();
            await app.init();
            window.posApp = app;
        });
    </script>
}
