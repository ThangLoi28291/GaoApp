                                </div>
                            </div>
                        </div>

                        <div id="heldOrdersOtherShiftList" class="pos-held-modal-section__body">
                            <div class="pos-held-modal-empty">
                                Đang tải dữ liệu đơn giữ...
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>
