        /* =========================================================
           L. PAYMENT NHANH
        ========================================================= */

        // Đổ đúng số tiền còn thiếu vào ô thanh toán
        function setPayAmountExact() {
            const draft = posState.currentDraft;

            if (!draft) {
                payAmount.value = '';
                renderPaymentPreview();
                return;
            }

            const balance = Number(draft.balanceDue || 0);
            payAmount.value = balance > 0 ? balance : 0;
            renderPaymentPreview();
        }

        // Chọn nhanh mệnh giá
        function setPayAmountQuick(amount) {
            payAmount.value = Number(amount || 0);
            payAmount.focus();
            payAmount.select();
            renderPaymentPreview();
        }

        // Cộng thêm tiền vào ô hiện tại
        function increasePayAmount(amount) {
            const current = Number(payAmount.value || 0);
            payAmount.value = current + Number(amount || 0);
            payAmount.focus();
            payAmount.select();
            renderPaymentPreview();
        }

        // Preview còn thiếu / tiền thừa
        function renderPaymentPreview() {
            const draft = posState.currentDraft;
            const currentInput = Number(payAmount.value || 0);

            if (!draft) {
                payPreviewBalance.textContent = '0';
                payPreviewChange.textContent = '0';
                return;
            }

            const balanceDue = Number(draft.balanceDue || 0);
            const expectedChange = Math.max(currentInput - balanceDue, 0);

            payPreviewBalance.textContent = formatMoney(balanceDue);
            payPreviewChange.textContent = formatMoney(expectedChange);
        }

        // Khi đổi phương thức thanh toán
        function onPayMethodChanged() {
            const method = parseInt(payMethod.value || '0');

            if (method === 0) {
                if (!payAmount.value) {
                    setPayAmountExact();
                } else {
                    renderPaymentPreview();
                }
                return;
            }

            setPayAmountExact();
        }

        /* =========================================================
           M. LOAD / ACTION CHÍNH
        ========================================================= */

        // Load toàn bộ màn hình POS
        async function loadScreen() {
            try {
                const screen = await fetchJson('/admin/pos/screen');

                posState.screen = screen;
                posState.currentDraft = screen.currentDraft;
                posState.currentOrderId = screen.currentCart ? screen.currentCart.currentOrderId : null;

                renderScreen(screen);
                focusBarcodeInput();
            } catch (err) {
                showError(err.message);
            }
        }

        // Quét / nhập barcode để thêm hàng
        async function scanCurrentCart() {
            const barcode = (txtBarcode.value || '').trim();
            if (!barcode) {
                focusBarcodeInput();
                return;
            }

            try {
                const draft = await postJson('/admin/pos/cart/current/scan', {
                    barcode: barcode,
                    quantity: 1
                });

                renderCurrentDraft(draft);
                renderCustomerInfo(draft);
                txtBarcode.value = '';
                hideBarcodeAutocomplete();
                showSuccess('Đã thêm sản phẩm vào giỏ');
                focusBarcodeInput();
            } catch (err) {
                if (!barcodeSearchState.items || !barcodeSearchState.items.length) {
                    showError(err.message);
                }
                focusBarcodeInput();
            }
        }

        // Thêm trực tiếp variant từ autocomplete vào giỏ
        async function addVariantToCurrentCart(variantId) {
            try {
                const currentOrderId = posState.currentDraft?.orderId || posState.currentOrderId;

                if (!currentOrderId) {
                    showError('Không có giỏ hiện tại.');
                    return;
                }

                const draft = await postJson(`/admin/pos/${currentOrderId}/items?variantId=${variantId}&qty=1`, {});
                renderCurrentDraft(draft);
                renderCustomerInfo(draft);

                txtBarcode.value = '';
                hideBarcodeAutocomplete();

                showSuccess('Đã thêm sản phẩm vào giỏ');
                focusBarcodeInput();
            } catch (err) {
                showError(err.message);
            }
        }

        // Tạo giỏ mới
        async function createNewCart() {
            await withButtonLoading(btnNewCart, async () => {
                try {
                    const result = await postJson('/admin/pos/cart/current/new', {
                        customerId: null,
                        note: null
                    });

                    showSuccess(result?.message || 'Đã sẵn sàng giỏ mới');
                    await loadScreen();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Mở modal giữ đơn
        function openHoldModal() {
            txtHoldNote.value = '';
            holdModal.show();
        }

        // Xác nhận giữ đơn hiện tại
        async function holdCurrentCart() {
            await withButtonLoading(btnConfirmHold, async () => {
                try {
                    await postJson('/admin/pos/cart/current/hold', {
                        holdNote: (txtHoldNote.value || '').trim() || null
                    });

                    holdModal.hide();
                    showSuccess('Đã giữ đơn');
                    await loadScreen();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Mở modal confirm dùng chung
        function openConfirmModal(options) {
            confirmTitle.textContent = options?.title || 'Xác nhận thao tác';
            confirmMessage.textContent = options?.message || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
            btnConfirmAction.className = `btn ${options?.confirmClass || 'btn-danger'} px-4`;
            btnConfirmAction.textContent = options?.confirmText || 'Xác nhận';

            if (options?.showNote) {
                confirmNoteBox.style.display = '';
                confirmNoteLabel.textContent = options.noteLabel || 'Nội dung';
                confirmNoteInput.value = options.noteValue || '';
                confirmNoteInput.placeholder = options.notePlaceholder || '';
            } else {
                confirmNoteBox.style.display = 'none';
                confirmNoteInput.value = '';
            }

            posState.pendingConfirmAction = options?.onConfirm || null;
            confirmModal.show();

            if (options?.showNote) {
                setTimeout(() => confirmNoteInput.focus(), 150);
            }
        }

        // Chốt đơn hiện tại
        async function finalizeCurrentCart() {
            openConfirmModal({
                title: 'Chốt đơn hiện tại',
                message: 'Xác nhận chốt đơn và in hóa đơn cho giỏ hiện tại?',
                confirmText: 'Chốt đơn',
                confirmClass: 'btn-success',
                onConfirm: async () => {
                    await withButtonLoading(btnConfirmAction, async () => {
                        try {
                            const result = await postJson('/admin/pos/cart/current/finalize', {});
                            confirmModal.hide();
                            showSuccess(result?.message || 'Đã chốt đơn');

                            if (result?.orderId) {
                                openReceiptPrint(result.orderId, '80', true);
                            }

                            await loadScreen();
                        } catch (err) {
                            showError(err.message);
                        }
                    });
                }
            });
        }

        // Hủy giỏ hiện tại
        async function cancelCurrentCart() {
            openConfirmModal({
                title: 'Hủy giỏ hiện tại',
                message: 'Giỏ hiện tại sẽ bị hủy. Bạn có chắc chắn muốn tiếp tục?',
                confirmText: 'Hủy giỏ',
                confirmClass: 'btn-danger',
                showNote: true,
                noteLabel: 'Lý do hủy',
                notePlaceholder: 'Nhập lý do hủy nếu cần...',
                onConfirm: async () => {
                    await withButtonLoading(btnConfirmAction, async () => {
                        try {
                            const reason = (confirmNoteInput.value || '').trim() || null;

                            await postJson('/admin/pos/cart/current/cancel', {
                                reason: reason
                            });

                            confirmModal.hide();
                            showSuccess('Đã hủy giỏ');
                            await loadScreen();
                        } catch (err) {
                            showError(err.message);
                        }
                    });
                }
            });
        }

        // Lấy lại đơn đang giữ
        async function resumeHeld(orderId) {
            try {
                await postJson(`/admin/pos/orders/${orderId}/resume`, {});
                showSuccess(`Đã lấy lại đơn #${orderId}`);
                await loadScreen();
            } catch (err) {
                showError(err.message);
            }
        }

        /* =========================================================
           N. PAYMENT ACTION
        ========================================================= */

        // Mở payment modal
        function openPaymentModal() {
            if (!posState.currentDraft) {
                showError('Chưa có giỏ hiện tại.');
                return;
            }

            payMethod.value = '0';
            payReference.value = '';
            payProvider.value = '';

            renderPaymentModalDraft(posState.currentDraft);
            setPayAmountExact();

            paymentModal.show();

            setTimeout(() => {
                payAmount.focus();
                payAmount.select();
            }, 180);
        }

        // Reset form payment
        function resetPaymentForm() {
            payMethod.value = '0';
            payAmount.value = '';
            payReference.value = '';
            payProvider.value = '';
            renderPaymentPreview();
        }

        // Thêm payment vào giỏ hiện tại
        async function addPayment() {
            const amount = parseFloat(payAmount.value || '0');

            await withButtonLoading(btnAddPayment, async () => {
                try {
                    const draft = await postJson('/admin/pos/cart/current/payments', {
                        method: parseInt(payMethod.value || '0'),
                        amount: amount,
                        referenceCode: payReference.value || null,
                        provider: payProvider.value || null
                    });

                    renderCurrentDraft(draft);
                    renderCustomerInfo(draft);
                    renderPaymentModalDraft(draft);

                    payAmount.value = draft.balanceDue || 0;
                    payReference.value = '';
                    payProvider.value = '';
                    renderPaymentPreview();

                    showSuccess('Đã thêm thanh toán');
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Chốt đơn từ payment modal
        async function finalizeFromPaymentModal() {
            await withButtonLoading(btnFinalizeFromPaymentModal, async () => {
                try {
                    const result = await postJson('/admin/pos/cart/current/finalize', {});

                    paymentModal.hide();
                    showSuccess(result?.message || 'Đã chốt đơn');

                    if (result?.orderId) {
                        window.open(`/admin/pos/orders/${result.orderId}/print?size=80&autoPrint=false`, '_blank');
                    }

                    await loadScreen();
                    focusBarcodeInput();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Xóa payment
        async function removePayment(paymentId) {
            openConfirmModal({
                title: 'Xóa thanh toán',
                message: 'Bạn có chắc chắn muốn xóa khoản thanh toán này?',
                confirmText: 'Xóa thanh toán',
                confirmClass: 'btn-danger',
                onConfirm: async () => {
                    await withButtonLoading(btnConfirmAction, async () => {
                        try {
                            const draft = await deleteWithToken(`/admin/pos/payments/${paymentId}`);
                            confirmModal.hide();

                            renderCurrentDraft(draft);
                            renderCustomerInfo(draft);
                            renderPaymentModalDraft(draft);
                            renderPaymentPreview();

                            showSuccess('Đã xóa thanh toán');
                        } catch (err) {
                            showError(err.message);
                        }
                    });
                }
            });
        }

        /* =========================================================
           O. CUSTOMER ACTION
        ========================================================= */

        // Mở modal chọn khách hàng
        function openCustomerModal() {
            customerSearchResult.innerHTML = `<div class="p-3 text-muted">Nhập từ khóa để tìm khách hàng.</div>`;
            txtCustomerKeyword.value = '';
            customerModal.show();
            setTimeout(() => txtCustomerKeyword.focus(), 180);
        }

        // Tìm khách hàng theo tên / số điện thoại
        async function searchCustomers() {
            const keyword = (txtCustomerKeyword.value || '').trim();

            if (!keyword) {
                customerSearchResult.innerHTML = `<div class="p-3 text-muted">Vui lòng nhập tên hoặc số điện thoại khách hàng.</div>`;
                return;
            }

            try {
                const items = await fetchJson(`/admin/pos/customers/search?keyword=${encodeURIComponent(keyword)}&take=20`);

                if (!Array.isArray(items) || items.length === 0) {
                    customerSearchResult.innerHTML = `<div class="p-3 text-muted">Không tìm thấy khách hàng phù hợp.</div>`;
                    return;
                }

                customerSearchResult.innerHTML = items.map(x => `
                    <button type="button"
                            class="pos-customer-search-item"
                            data-customer-id="${x.customerId}">
                        <div class="fw-bold">${escapeHtml(x.name || '')}</div>
                        <div class="small text-muted mt-1">
                            ${x.phone ? `SĐT: ${escapeHtml(x.phone)}` : 'Chưa có số điện thoại'}
                            ${x.address ? ` | Địa chỉ: ${escapeHtml(x.address)}` : ''}
                        </div>
                    </button>
                `).join('');
            } catch (err) {
                showError(err.message);
            }
        }

        // Gán khách hàng vào giỏ hiện tại
        async function setCustomerToCurrentCart(customerId) {
            try {
                const draft = await postJson(`/admin/pos/cart/current/customer/${customerId}`, {});
                customerModal.hide();
                renderCurrentDraft(draft);
                renderCustomerInfo(draft);
                renderCurrentBadge({ currentOrderId: draft.orderId }, draft);
                showSuccess('Đã chọn khách hàng cho giỏ hiện tại');
                focusBarcodeInput();
            } catch (err) {
                showError(err.message);
            }
        }

        // Bỏ khách hàng khỏi giỏ hiện tại
        async function clearCustomerFromCurrentCart() {
            try {
                const draft = await deleteWithToken('/admin/pos/cart/current/customer');
                renderCurrentDraft(draft);
                renderCustomerInfo(draft);
                showSuccess('Đã bỏ khách hàng khỏi giỏ');
                focusBarcodeInput();
            } catch (err) {
                showError(err.message);
            }
        }

        // Mở modal tạo nhanh khách hàng
        function openQuickCreateCustomerModal() {
            qcCustomerName.value = '';
            qcCustomerPhone.value = '';
            qcCustomerAddress.value = '';
            qcCustomerNote.value = '';

            quickCreateCustomerModal.show();

            setTimeout(() => {
                qcCustomerName.focus();
            }, 180);
        }

        // Tạo nhanh khách hàng và gán vào giỏ
        async function submitQuickCreateCustomer() {
            const payload = {
                name: (qcCustomerName.value || '').trim(),
                phone: (qcCustomerPhone.value || '').trim() || null,
                address: (qcCustomerAddress.value || '').trim() || null,
                note: (qcCustomerNote.value || '').trim() || null
            };

            await withButtonLoading(btnSubmitQuickCreateCustomer, async () => {
                try {
                    const draft = await postJson('/admin/pos/customers/quick-create', payload);

                    quickCreateCustomerModal.hide();
                    customerModal.hide();

                    renderCurrentDraft(draft);
                    renderCustomerInfo(draft);
                    renderCurrentBadge({ currentOrderId: draft.orderId }, draft);

                    showSuccess('Đã tạo và chọn khách hàng mới');
                    focusBarcodeInput();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        /* =========================================================
           P. NOTE / ORDER DISCOUNT / LINE DISCOUNT
        ========================================================= */

        // Lưu ghi chú đơn hiện tại
        async function saveCurrentCartNote() {
            await withButtonLoading(btnSaveOrderNote, async () => {
                try {
                    const draft = await postJson('/admin/pos/cart/current/note', {
                        note: (txtOrderNote.value || '').trim() || null
                    });

                    renderCurrentDraft(draft);
                    renderCustomerInfo(draft);
                    showSuccess('Đã lưu ghi chú đơn');
                    focusBarcodeInput();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Lưu giảm giá đơn hiện tại
        async function saveCurrentCartDiscount() {
            await withButtonLoading(btnSaveOrderDiscount, async () => {
                try {
                    const discountAmount = parseFloat(txtOrderDiscount.value || '0');

                    const draft = await postJson('/admin/pos/cart/current/discount', {
                        discountAmount: discountAmount
                    });

                    renderCurrentDraft(draft);
                    renderCustomerInfo(draft);
                    showSuccess('Đã cập nhật giảm giá đơn');
                    focusBarcodeInput();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Xóa giảm giá đơn
        async function clearCurrentCartDiscount() {
            txtOrderDiscount.value = 0;
            await saveCurrentCartDiscount();
        }

        // Mở modal giảm giá dòng
        function openLineDiscountModal(lineId, itemName, discountAmount) {
            lineDiscountLineId.value = lineId || '';
            lineDiscountItemName.textContent = itemName || 'Sản phẩm';
            lineDiscountAmount.value = discountAmount || 0;

            lineDiscountModal.show();

            setTimeout(() => {
                lineDiscountAmount.focus();
                lineDiscountAmount.select();
            }, 180);
        }

        // Lưu giảm giá dòng
        async function saveLineDiscount() {
            const lineId = parseInt(lineDiscountLineId.value || '0');
            const discountAmount = parseFloat(lineDiscountAmount.value || '0');

            if (!lineId) {
                showError('Không xác định được dòng hàng.');
                return;
            }

            await withButtonLoading(btnSaveLineDiscount, async () => {
                try {
                    const draft = await postJson(`/admin/pos/lines/${lineId}/discount`, {
                        discountAmount: discountAmount
                    });

                    lineDiscountModal.hide();
                    renderCurrentDraft(draft);
                    renderCustomerInfo(draft);
                    showSuccess('Đã cập nhật giảm giá dòng');
                    focusBarcodeInput();
                } catch (err) {
                    showError(err.message);
                }
            });
        }

        // Xóa giảm giá dòng
        async function clearLineDiscount() {
            lineDiscountAmount.value = 0;
            await saveLineDiscount();
        }

        /* =========================================================
           Q. CẬP NHẬT SỐ LƯỢNG / XÓA DÒNG
        ========================================================= */

        // Cập nhật số lượng dòng hàng
        async function updateLineQty(lineId, qty) {
            try {
                const draft = await patchWithToken(`/admin/pos/lines/${lineId}?qty=${encodeURIComponent(qty)}`);
                renderCurrentDraft(draft);
                renderCustomerInfo(draft);
                focusBarcodeInput();
            } catch (err) {
                showError(err.message);
            }
        }

        // Xóa dòng hàng khỏi giỏ
        async function removeLine(lineId) {
            openConfirmModal({
                title: 'Xóa dòng hàng',
                message: 'Bạn có chắc chắn muốn xóa dòng hàng này khỏi giỏ?',
                confirmText: 'Xóa dòng',
                confirmClass: 'btn-danger',
                onConfirm: async () => {
                    await withButtonLoading(btnConfirmAction, async () => {
                        try {
                            const draft = await deleteWithToken(`/admin/pos/lines/${lineId}`);
                            confirmModal.hide();
                            renderCurrentDraft(draft);
                            renderCustomerInfo(draft);
                            focusBarcodeInput();
                        } catch (err) {
                            showError(err.message);
                        }
                    });
                }
            });
        }

        /* =========================================================
           R. BIND EVENT - BUTTON / INPUT / CLICK
        ========================================================= */

        btnScan.addEventListener('click', scanCurrentCart);
        btnFocusBarcode.addEventListener('click', focusBarcodeInput);

        btnNewCart.addEventListener('click', createNewCart);
        btnHoldCart.addEventListener('click', openHoldModal);
        btnOpenPayment.addEventListener('click', openPaymentModal);
        btnFinalizeCart.addEventListener('click', finalizeCurrentCart);
        btnCancelCart.addEventListener('click', cancelCurrentCart);

        btnSaveOrderNote?.addEventListener('click', saveCurrentCartNote);
        btnSaveOrderDiscount?.addEventListener('click', saveCurrentCartDiscount);
        btnClearOrderDiscount?.addEventListener('click', clearCurrentCartDiscount);

        btnSearchCustomer.addEventListener('click', searchCustomers);
        btnClearCustomer.addEventListener('click', clearCustomerFromCurrentCart);
        btnOpenQuickCreateCustomer.addEventListener('click', openQuickCreateCustomerModal);
        btnSubmitQuickCreateCustomer.addEventListener('click', submitQuickCreateCustomer);

        btnConfirmHold.addEventListener('click', holdCurrentCart);
        btnConfirmAction.addEventListener('click', async function () {
            if (typeof posState.pendingConfirmAction === 'function') {
                await posState.pendingConfirmAction();
            }
        });

        btnAddPayment?.addEventListener('click', addPayment);
        btnFinalizeFromPaymentModal?.addEventListener('click', finalizeFromPaymentModal);
        btnPayExact?.addEventListener('click', setPayAmountExact);
        payMethod?.addEventListener('change', onPayMethodChanged);
        payAmount?.addEventListener('input', renderPaymentPreview);

        btnSaveLineDiscount?.addEventListener('click', saveLineDiscount);
        btnClearLineDiscount?.addEventListener('click', clearLineDiscount);

        txtCustomerKeyword.addEventListener('keydown', async function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                await searchCustomers();
            }
        });

        document.addEventListener('keydown', async function (e) {
            const isNoteFocused = document.activeElement === txtOrderNote;
            if (isNoteFocused && e.ctrlKey && e.key.toLowerCase() === 's') {
                e.preventDefault();
                await saveCurrentCartNote();
            }
        });

        lineDiscountAmount?.addEventListener('keydown', async function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                await saveLineDiscount();
            }
        });

        payAmount?.addEventListener('keydown', async function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                await addPayment();
            }
        });

        /* =========================================================
           S. KEYBOARD CHO BARCODE INPUT
        ========================================================= */
        txtBarcode.addEventListener('keydown', async function (e) {
            const hasAutocomplete = barcodeSearchState.items && barcodeSearchState.items.length > 0;

            if (e.key === 'ArrowDown') {
                if (!hasAutocomplete) return;
                e.preventDefault();
                setAutocompleteActive(barcodeSearchState.activeIndex + 1);
                return;
            }

            if (e.key === 'ArrowUp') {
                if (!hasAutocomplete) return;
                e.preventDefault();
                setAutocompleteActive(barcodeSearchState.activeIndex - 1);
                return;
            }

            if (e.key === 'Escape') {
                hideBarcodeAutocomplete();
                return;
            }

            if (e.key === 'Enter') {
                e.preventDefault();

                if (hasAutocomplete && barcodeSearchState.activeIndex >= 0) {
                    const selected = barcodeSearchState.items[barcodeSearchState.activeIndex];
                    if (selected?.variantId) {
                        await addVariantToCurrentCart(selected.variantId);
                        return;
                    }
                }

                if (hasAutocomplete && barcodeSearchState.items.length === 1) {
                    const selected = barcodeSearchState.items[0];
                    if (selected?.variantId) {
                        await addVariantToCurrentCart(selected.variantId);
                        return;
                    }
                }

                await scanCurrentCart();
            }
        });

        txtBarcode.addEventListener('input', function () {
            const keyword = (txtBarcode.value || '').trim();

            if (barcodeSearchState.debounceTimer) {
                clearTimeout(barcodeSearchState.debounceTimer);
            }

            if (!keyword) {
                hideBarcodeAutocomplete();
                return;
            }

            barcodeSearchState.debounceTimer = setTimeout(() => {
                searchBarcodeAutocomplete(keyword);
            }, 250);
        });

        /* =========================================================
           T. CLICK DELEGATION
        ========================================================= */

        barcodeAutocomplete.addEventListener('click', async function (e) {
            const item = e.target.closest('[data-variant-id]');
            if (!item) return;

            const variantId = parseInt(item.getAttribute('data-variant-id'));
            if (!variantId) return;

            await addVariantToCurrentCart(variantId);
        });

        customerSearchResult.addEventListener('click', async function (e) {
            const item = e.target.closest('[data-customer-id]');
            if (!item) return;

            const customerId = parseInt(item.getAttribute('data-customer-id'));
            if (!customerId) return;

            await setCustomerToCurrentCart(customerId);
        });

        currentDraftBody.addEventListener('click', function (e) {
            const decBtn = e.target.closest('[data-dec-line-id]');
            if (decBtn) {
                const lineId = parseInt(decBtn.getAttribute('data-dec-line-id'));
                const input = currentDraftBody.querySelector(`[data-qty-line-id="${lineId}"]`);
                const currentQty = parseFloat(input.value || '1');
                const nextQty = Math.max(1, currentQty - 1);
                input.value = nextQty;
                updateLineQty(lineId, nextQty);
                return;
            }

            const incBtn = e.target.closest('[data-inc-line-id]');
            if (incBtn) {
                const lineId = parseInt(incBtn.getAttribute('data-inc-line-id'));
                const input = currentDraftBody.querySelector(`[data-qty-line-id="${lineId}"]`);
                const currentQty = parseFloat(input.value || '1');
                const nextQty = currentQty + 1;
                input.value = nextQty;
                updateLineQty(lineId, nextQty);
                return;
            }

            const discountBtn = e.target.closest('[data-line-discount-id]');
            if (discountBtn) {
                const lineId = parseInt(discountBtn.getAttribute('data-line-discount-id'));
                const discountAmount = parseFloat(discountBtn.getAttribute('data-line-discount-amount') || '0');
                const itemName = discountBtn.getAttribute('data-line-name') || '';

                openLineDiscountModal(lineId, itemName, discountAmount);
                return;
            }

            const removeBtn = e.target.closest('[data-remove-line-id]');
            if (removeBtn) {
                const lineId = parseInt(removeBtn.getAttribute('data-remove-line-id'));
                removeLine(lineId);
                return;
            }
        });

        currentDraftBody.addEventListener('change', function (e) {
            const qtyInput = e.target.closest('[data-qty-line-id]');
            if (!qtyInput) return;

            const lineId = parseInt(qtyInput.getAttribute('data-qty-line-id'));
            let qty = parseFloat(qtyInput.value || '1');

            if (qty <= 0) qty = 1;

            qtyInput.value = qty;
            updateLineQty(lineId, qty);
        });

        paymentListBox.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-remove-payment-id]');
            if (!btn) return;

            const paymentId = parseInt(btn.getAttribute('data-remove-payment-id'));
            if (!paymentId) return;

            removePayment(paymentId);
        });

        heldList.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-resume-btn-id]');
            const item = e.target.closest('[data-resume-order-id]');

            const orderId = btn
                ? parseInt(btn.getAttribute('data-resume-btn-id'))
                : item
                    ? parseInt(item.getAttribute('data-resume-order-id'))
                    : 0;

            if (!orderId) return;

            resumeHeld(orderId);
        });

        paymentModalEl.addEventListener('click', function (e) {
            const quickBtn = e.target.closest('[data-pay-amount]');
            if (quickBtn) {
                const amount = parseFloat(quickBtn.getAttribute('data-pay-amount') || '0');
                setPayAmountQuick(amount);
                return;
            }

            const plusBtn = e.target.closest('[data-pay-plus]');
            if (plusBtn) {
                const amount = parseFloat(plusBtn.getAttribute('data-pay-plus') || '0');
                increasePayAmount(amount);
                return;
            }

            const removeBtn = e.target.closest('[data-remove-payment-id]');
            if (removeBtn) {
                const paymentId = parseInt(removeBtn.getAttribute('data-remove-payment-id') || '0');
                if (!paymentId) return;
                removePayment(paymentId);
                return;
            }
        });

        document.addEventListener('click', function (e) {
            const insideInput = e.target.closest('#txtBarcode');
            const insideAutocomplete = e.target.closest('#barcodeAutocomplete');

            if (!insideInput && !insideAutocomplete) {
                hideBarcodeAutocomplete();
            }
        });

        /* =========================================================
           U. MODAL EVENT
        ========================================================= */

        paymentModalEl.addEventListener('shown.bs.modal', function () {
            posState.paymentModalOpen = true;
        });

        paymentModalEl.addEventListener('hidden.bs.modal', function () {
            posState.paymentModalOpen = false;
            resetPaymentForm();
            focusBarcodeInput();
        });

        customerModalEl.addEventListener('shown.bs.modal', function () {
            posState.customerModalOpen = true;
        });

        customerModalEl.addEventListener('hidden.bs.modal', function () {
            posState.customerModalOpen = false;
            focusBarcodeInput();
        });

        quickCreateCustomerModalEl.addEventListener('shown.bs.modal', function () {
            posState.quickCreateCustomerModalOpen = true;
        });

        quickCreateCustomerModalEl.addEventListener('hidden.bs.modal', function () {
            posState.quickCreateCustomerModalOpen = false;
        });

        holdModalEl.addEventListener('shown.bs.modal', function () {
            posState.holdModalOpen = true;
        });

        holdModalEl.addEventListener('hidden.bs.modal', function () {
            posState.holdModalOpen = false;
            txtHoldNote.value = '';
            focusBarcodeInput();
        });

        confirmModalEl.addEventListener('shown.bs.modal', function () {
            posState.confirmModalOpen = true;
        });

        confirmModalEl.addEventListener('hidden.bs.modal', function () {
            posState.confirmModalOpen = false;
            posState.pendingConfirmAction = null;
            confirmNoteInput.value = '';
            focusBarcodeInput();
        });

        lineDiscountModalEl.addEventListener('shown.bs.modal', function () {
            posState.lineDiscountModalOpen = true;
        });

        lineDiscountModalEl.addEventListener('hidden.bs.modal', function () {
            posState.lineDiscountModalOpen = false;
            lineDiscountLineId.value = '';
            lineDiscountAmount.value = '';
            lineDiscountItemName.textContent = 'Sản phẩm';
            focusBarcodeInput();
        });

        /* =========================================================
           V. PHÍM TẮT TOÀN MÀN HÌNH
        ========================================================= */
        document.addEventListener('keydown', function (e) {
            const tag = (document.activeElement?.tagName || '').toLowerCase();
            const isTypingInTextarea = tag === 'textarea';

            if (isTypingInTextarea) return;

            if (e.key === 'F2') {
                e.preventDefault();
                if (!posState.paymentModalOpen && !posState.customerModalOpen && !posState.quickCreateCustomerModalOpen && !posState.confirmModalOpen) {
                    openHoldModal();
                }
            }

            if (e.key === 'F3') {
                e.preventDefault();
                if (!posState.customerModalOpen && !posState.quickCreateCustomerModalOpen && !posState.confirmModalOpen) {
                    openPaymentModal();
                }
            }

            if (e.key === 'F4') {
                e.preventDefault();
                if (!posState.paymentModalOpen && !posState.customerModalOpen && !posState.quickCreateCustomerModalOpen && !posState.confirmModalOpen) {
                    finalizeCurrentCart();
                }
            }

            if (e.key === 'F6') {
                e.preventDefault();
                if (!posState.paymentModalOpen && !posState.customerModalOpen && !posState.quickCreateCustomerModalOpen && !posState.confirmModalOpen) {
                    createNewCart();
                }
            }

            if (e.key === 'F7') {
                e.preventDefault();
                if (!posState.paymentModalOpen && !posState.quickCreateCustomerModalOpen && !posState.confirmModalOpen) {
                    openCustomerModal();
                }
            }

            if (e.key === 'F8') {
                e.preventDefault();
                focusBarcodeInput();
            }

            if (e.key === 'Escape') {
                if (posState.lineDiscountModalOpen) {
                    lineDiscountModal.hide();
                    return;
                }

                if (posState.quickCreateCustomerModalOpen) {
                    quickCreateCustomerModal.hide();
                    return;
                }

                if (posState.confirmModalOpen) {
                    confirmModal.hide();
                    return;
                }

                if (posState.holdModalOpen) {
                    holdModal.hide();
                    return;
                }

                if (posState.customerModalOpen) {
                    customerModal.hide();
                    return;
                }

                if (posState.paymentModalOpen) {
                    paymentModal.hide();
                    return;
                }

                if (document.activeElement === txtBarcode) {
                    txtBarcode.value = '';
                    hideBarcodeAutocomplete();
                }
            }
        });

        /* =========================================================
           W. KHỞI TẠO BAN ĐẦU
        ========================================================= */
        document.addEventListener('DOMContentLoaded', function () {
            loadScreen();
        });

        // Expose ra window để dùng cho onclick trong HTML động
        window.openCustomerModal = openCustomerModal;
        window.clearCustomerFromCurrentCart = clearCustomerFromCurrentCart;
    </script>
}