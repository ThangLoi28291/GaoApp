<!-- =========================================================
     INVOICE ISSUANCE INTENT
     Payment đã hoàn tất nhưng chưa được in bill
     cho tới khi cashier chọn một route.
========================================================== -->
<div class="modal fade"
     id="invoiceIntentModal"
     tabindex="-1"
     aria-labelledby="invoiceIntentModalTitle"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content pos-card">

            <div class="modal-body p-4">

                <div class="text-center mb-4">

                    <h4 class="mb-2"
                        id="invoiceIntentModalTitle">
                        Khách có lấy hóa đơn điện tử không?
                    </h4>

                    <div class="text-muted">
                        Đơn hàng
                        <strong id="invoiceIntentOrderText"></strong>
                        đã thanh toán thành công.
                        <span id="invoiceIntentDescription">Chọn phương thức hóa đơn trước khi in bill.</span>
                    </div>
                </div>

                <section id="cashReceiptSummary" class="pos-cash-summary" aria-label="Tiền mặt và tiền thối" hidden>
                    <div class="pos-cash-total"><span>Tổng tiền đơn</span><strong id="cashReceiptTotal"></strong></div>
                    <div class="pos-cash-total" id="cashReceiptOtherRow" hidden><span>Đã trả bằng phương thức khác</span><strong id="cashReceiptOther"></strong></div>
                    <div class="pos-cash-grid">
                        <div class="pos-cash-amount"><span>Tiền mặt khách đưa</span><strong id="cashReceiptReceived"></strong></div>
                        <div class="pos-cash-amount pos-cash-change"><span>TIỀN THỐI LẠI</span><strong id="cashReceiptChange"></strong></div>
                    </div>
                </section>

                <div id="invoiceIntentErrorBox"
                     class="alert alert-danger d-none mb-3"
                     role="alert">
                </div>

                <div class="d-grid gap-3" id="invoiceIntentChoices">

                    <button type="button"
                            class="btn btn-primary btn-lg text-start p-3 pos-invoice-option"
                            id="btnInvoiceIntentAutomatic">

                        <span class="d-block fw-semibold">
                            Không — Khách không lấy hóa đơn <kbd>Enter / K</kbd>
                        </span>

                        <small class="d-block opacity-75 mt-1">
                            Bán cho người tiêu dùng. Hệ thống đưa hóa đơn vào hàng đợi phát hành tự động.
                        </small>
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary btn-lg text-start p-3 pos-invoice-option"
                            id="btnInvoiceIntentManual">

                        <span class="d-block fw-semibold">
                            Có — Khách lấy hóa đơn <kbd>C</kbd>
                        </span>

                        <small class="d-block text-muted mt-1">
                            Bill có QR để khách nhập thông tin. Hóa đơn chờ quản lý phát hành thủ công.
                        </small>
                    </button>

                </div>

                <div id="receiptPrintChoices" class="d-grid gap-3" hidden>
                    <button type="button" id="btnReceiptDoNotPrint" class="btn btn-primary btn-lg text-start p-3 pos-invoice-option">
                        <span class="d-block fw-semibold">Không in bill <kbd>Enter / K</kbd></span>
                        <small class="d-block opacity-75 mt-1">Hoàn tất và tiếp tục bán hàng. Có thể in lại trong lịch sử đơn.</small>
                    </button>
                    <button type="button" id="btnReceiptPrint" class="btn btn-outline-secondary btn-lg text-start p-3 pos-invoice-option">
                        <span class="d-block fw-semibold">Có — In bill <kbd>C</kbd></span>
                        <small class="d-block text-muted mt-1">In bill giấy cho đơn vừa thanh toán.</small>
                    </button>
                </div>
                <div id="invoiceIntentHelp" class="small text-muted text-center mt-3">
                    Enter / K: Không lấy hóa đơn · C: Có lấy hóa đơn
                </div>

            </div>
        </div>
    </div>
</div>
