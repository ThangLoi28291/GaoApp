        const confirmModal = new bootstrap.Modal(confirmModalEl);

        const lineDiscountModalEl = document.getElementById('lineDiscountModal');
        const lineDiscountModal = new bootstrap.Modal(lineDiscountModalEl);

        /* =========================================================
           G. STATE CHO AUTOCOMPLETE SẢN PHẨM
        ========================================================= */
        const barcodeSearchState = {
            items: [],
            activeIndex: -1,
            debounceTimer: null,
            keyword: ''
        };

        /* =========================================================
           H. HÀM DÙNG CHUNG
        ========================================================= */

        // Lấy AntiForgeryToken để gọi API POST/PATCH/DELETE
        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        // Format tiền theo chuẩn Việt Nam
        function formatMoney(value) {
            const n = Number(value || 0);
            return n.toLocaleString('vi-VN');
        }

        // Toastr thành công
        function showSuccess(msg) {
            if (window.toastr) toastr.success(msg);
        }

        // Toastr lỗi
        function showError(msg) {
            if (window.toastr) toastr.error(msg || 'Có lỗi xảy ra');
        }

        // Escape HTML để tránh lỗi XSS khi render dữ liệu động
        function escapeHtml(str) {
            return (str || '')
                .toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        // Ghép tên hiển thị theo format:
        // Tên sản phẩm - Tên biến thể
    function buildVariantDisplayName(productName, productVariantName) {
    const pName = (productName || '').trim();
    const vName = (productVariantName || '').trim();

    if (!pName && !vName) return '';
    if (!vName) return pName;
    if (!pName) return vName;

    const pLower = pName.toLowerCase();
    const vLower = vName.toLowerCase();

    if (pLower === vLower) {
        return pName;
    }

    // Nếu tên biến thể đã chứa luôn tên sản phẩm thì chỉ hiện biến thể
    if (vLower.includes(pLower)) {
        return vName;
    }

    return `${pName} - ${vName}`;
}

        // Chuyển enum / source barcode thành text dễ hiểu
        function getBarcodeSourceText(source) {
            if (source === null || source === undefined) return '';

            const raw = typeof source === 'string' ? source : String(source);

            switch (raw) {
                case 'UnitBarcode':
                case '1':
                    return 'Barcode đơn vị';

                case 'VariantBarcode':
                case '2':
                    return 'Barcode variant';

                case 'BarcodeHistory':
                case '3':
                    return 'Barcode lịch sử';

                case 'ManualVariant':
                case '4':
                    return 'Chọn thủ công';

                default:
                    return '';
            }
        }

        // Meta ngắn hiển thị ngay dưới tên dòng hàng
        function buildCompactLineMeta(line) {
            const parts = [];

            

            if (line?.sku) {
                parts.push(`SKU: ${line.sku}`);
            }

            const sellingUnit = line?.sellingUnitName || line?.unitName || '';
            const baseUnit = line?.baseUnitName || '';
            const multiplier = Number(line?.multiplier || 1);

            if (sellingUnit) {
                if (baseUnit && multiplier > 1) {
                    parts.push(`1 ${sellingUnit} = ${formatMoney(multiplier)} ${baseUnit}`);
                } else {
                    parts.push(sellingUnit);
                }
            }

            return parts.map(x => escapeHtml(x)).join(' | ');
        }

        // Build nội dung chi tiết cho popover info
        function buildLineDetailHtml(line) {
            const details = [];
            const sourceText = getBarcodeSourceText(line?.barcodeSource);

            const fullName = buildVariantDisplayName(
                line?.productName || line?.itemName || '',
                line?.productVariantName || ''
            );

            if (fullName) {
                details.push(`<div><strong>Tên hiển thị:</strong> ${escapeHtml(fullName)}</div>`);
            }

            if (line?.productVariantName) {
                details.push(`<div><strong>Tên biến thể:</strong> ${escapeHtml(line.productVariantName)}</div>`);
            }

            if (line?.sku) {
                details.push(`<div><strong>SKU:</strong> ${escapeHtml(line.sku)}</div>`);
            }

            if (line?.scannedBarcode) {
                details.push(`<div><strong>Barcode quét:</strong> ${escapeHtml(line.scannedBarcode)}</div>`);
            } else if (line?.barcode) {
                details.push(`<div><strong>Barcode:</strong> ${escapeHtml(line.barcode)}</div>`);
            }

            if (line?.sellingUnitName) {
                details.push(`<div><strong>ĐVT bán:</strong> ${escapeHtml(line.sellingUnitName)}</div>`);
            }

            if (line?.baseUnitName) {
                details.push(`<div><strong>ĐVT gốc:</strong> ${escapeHtml(line.baseUnitName)}</div>`);
            }

            if (Number(line?.multiplier || 1) > 1 && line?.sellingUnitName && line?.baseUnitName) {
                details.push(
                    `<div><strong>Quy đổi:</strong> 1 ${escapeHtml(line.sellingUnitName)} = ${formatMoney(Number(line.multiplier || 1))} ${escapeHtml(line.baseUnitName)}</div>`
                );
            }

            if (sourceText) {
                details.push(`<div><strong>Nguồn:</strong> ${escapeHtml(sourceText)}</div>`);
            }

            return details.join('');
        }

        // Khởi tạo popover cho nút info từng dòng hàng
        function initLineInfoPopovers() {
            document.querySelectorAll('.pos-line-info-btn').forEach(btn => {
                const html = decodeURIComponent(btn.getAttribute('data-line-detail-html') || '');

                const existed = bootstrap.Popover.getInstance(btn);
                if (existed) {
                    existed.dispose();
                }

                new bootstrap.Popover(btn, {
                    trigger: 'hover focus',
                    placement: 'top',
                    html: true,
                    sanitize: false,
                    title: 'Chi tiết dòng hàng',
                    content: html
                });
            });
        }

        // Highlight từ khóa trong autocomplete
        function highlightMatch(text, keyword) {
            const safeText = escapeHtml(text || '');
            const rawKeyword = (keyword || '').trim();

            if (!rawKeyword) return safeText;

            const escapedKeyword = rawKeyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${escapedKeyword})`, 'ig');

            return safeText.replace(regex, '<mark>$1</mark>');
        }

        // Focus lại ô barcode để thu ngân thao tác nhanh
        function focusBarcodeInput() {
            setTimeout(() => {
                txtBarcode.focus();
                txtBarcode.select();
            }, 80);
        }

        // Mở cửa sổ in hóa đơn
        function openReceiptPrint(orderId, size = "80", autoPrint = true) {
            if (!orderId) return;
            const url = `/admin/pos/orders/${orderId}/print?size=${encodeURIComponent(size)}&autoPrint=${autoPrint}`;
            window.open(url, "_blank", "width=420,height=760,noopener,noreferrer");
        }

        // Hàm fetch JSON dùng chung
        async function fetchJson(url, options = {}) {
            const res = await fetch(url, options);
            const contentType = res.headers.get('content-type') || '';

            let jsonData = null;
            let textData = '';

            try {
                if (contentType.includes('application/json')) {
                    jsonData = await res.json();
                } else {
                    textData = await res.text();
                }
            } catch { }

            if (!res.ok) {
                const msg =
                    jsonData?.message ||
                    jsonData?.title ||
                    jsonData?.error ||
                    textData ||
                    `Yêu cầu thất bại (${res.status})`;

                throw new Error(msg);
            }

            return jsonData ?? textData ?? null;
        }

        // POST JSON có AntiForgeryToken
        async function postJson(url, data) {
            return await fetchJson(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify(data || {})
            });
        }

        // DELETE có token
        async function deleteWithToken(url) {
            return await fetchJson(url, {
                method: 'DELETE',
                headers: {
                    'RequestVerificationToken': getToken()
                }
            });
        }

        // PATCH có token
        async function patchWithToken(url) {
            return await fetchJson(url, {
                method: 'PATCH',
                headers: {
                    'RequestVerificationToken': getToken()
                }
            });
        }

        // Hiển thị loading tạm trên button
        async function withButtonLoading(button, action) {
            if (!button) return await action();
            if (button.disabled) return;

            const oldHtml = button.innerHTML;
            button.disabled = true;
            button.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý`;

            try {
                return await action();
            } finally {
                button.disabled = false;
                button.innerHTML = oldHtml;
            }
        }

        /* =========================================================
           I. AUTOCOMPLETE SẢN PHẨM
        ========================================================= */

        // Ẩn autocomplete và reset state
        function hideBarcodeAutocomplete() {
            barcodeAutocomplete.style.display = 'none';
            barcodeAutocomplete.innerHTML = '';
            barcodeSearchState.items = [];
            barcodeSearchState.activeIndex = -1;
            barcodeSearchState.keyword = '';
        }

        // Set item active khi dùng phím lên/xuống
        function setAutocompleteActive(index) {
            const buttons = barcodeAutocomplete.querySelectorAll('[data-autocomplete-index]');
            buttons.forEach(x => x.classList.remove('active'));

            if (!buttons.length) {
                barcodeSearchState.activeIndex = -1;
                return;
            }

            if (index < 0) index = 0;
            if (index >= buttons.length) index = buttons.length - 1;

            barcodeSearchState.activeIndex = index;
            buttons[index].classList.add('active');
            buttons[index].scrollIntoView({ block: 'nearest' });
        }

        // Render danh sách autocomplete sản phẩm
        function renderBarcodeAutocomplete(items) {
            barcodeSearchState.items = items || [];
            barcodeSearchState.activeIndex = -1;

            if (!items || !items.length) {
                hideBarcodeAutocomplete();
                return;
            }

            const keyword = barcodeSearchState.keyword || '';

            barcodeAutocomplete.innerHTML = items.map((x, index) => {
                const fullName = buildVariantDisplayName(
                    x.productName || x.displayName || '',
                    x.productVariantName || ''
                );

                const titleHtml = highlightMatch(fullName, keyword);
                const skuText = x.sku ? escapeHtml(x.sku) : '-';
                const barcodeText = x.barcode ? escapeHtml(x.barcode) : '-';
                const priceText = `${formatMoney(x.price)} đ`;

                return `
                    <button type="button"
                            class="pos-autocomplete-item"
                            data-autocomplete-index="${index}"
                            data-variant-id="${x.variantId}">
                        <div class="pos-autocomplete-row">
                            <div class="pos-autocomplete-main">
                                <div class="pos-autocomplete-title">${titleHtml}</div>
                                <div class="pos-autocomplete-meta">
                                    <span class="pos-meta-badge sku">
                                        SKU:&nbsp;<span class="pos-meta-text">${skuText}</span>
                                    </span>
                                    <span class="pos-meta-badge barcode">
                                        Barcode:&nbsp;<span class="pos-meta-text">${barcodeText}</span>
                                    </span>
                                </div>
                            </div>
                            <div class="pos-autocomplete-right">
                                <div class="pos-autocomplete-price">${priceText}</div>
                            </div>
                        </div>
                    </button>
                `;
            }).join('');

            barcodeAutocomplete.style.display = '';
            setAutocompleteActive(0);
        }

        // Gọi API tìm nhanh sản phẩm
        async function searchBarcodeAutocomplete(keyword) {
            keyword = (keyword || '').trim();
            barcodeSearchState.keyword = keyword;

            if (keyword.length < 2) {
                hideBarcodeAutocomplete();
                return;
            }

            try {
                const items = await fetchJson(`/admin/pos/products/search?keyword=${encodeURIComponent(keyword)}&take=10`);
                renderBarcodeAutocomplete(items || []);
            } catch {
                hideBarcodeAutocomplete();
            }
        }

