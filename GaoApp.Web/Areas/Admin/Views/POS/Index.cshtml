@{
    ViewData["Title"] = "POS Bán hàng";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <style>
        /* =========================================================
                   1. KHUNG GIAO DIỆN CHUNG
                ========================================================= */
        .pos-shell {
            min-height: calc(100vh - 132px);
        }

        .pos-card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 0.125rem 0.75rem rgba(0,0,0,.08);
            overflow: visible;
            background: #fff;
        }

            .pos-card .card-body {
                padding: 1rem;
            }

        .pos-section-title {
            font-size: 1rem;
            font-weight: 800;
            color: #212529;
            margin-bottom: .85rem;
        }

        .pos-subtext {
            color: #6c757d;
            font-size: .9rem;
        }

        .pos-current-badge {
            font-size: .92rem;
            padding: .65rem .85rem;
            border-radius: 999px;
        }

        .sticky-right {
            position: sticky;
            top: 16px;
        }

        /* =========================================================
                   2. THANH TÌM / QUÉT SẢN PHẨM
                ========================================================= */
        .pos-toolbar-card {
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
            position: relative;
            z-index: 30;
        }

        .pos-inline-label {
            font-size: .82rem;
            color: #6c757d;
            margin-bottom: 4px;
        }

        .pos-barcode-wrap {
            position: relative;
            z-index: 50;
        }

        .pos-barcode-input {
            height: 58px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 14px;
            padding-left: 16px;
            padding-right: 16px;
        }

        .pos-toolbar-btn {
            min-height: 58px;
            border-radius: 14px;
            font-weight: 700;
        }

        /* =========================================================
                   3. AUTOCOMPLETE SẢN PHẨM
                ========================================================= */
        .pos-autocomplete-menu {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            z-index: 9999;
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 14px;
            box-shadow: 0 0.5rem 1.25rem rgba(0,0,0,.12);
            overflow: hidden;
            max-height: 360px;
            overflow-y: auto;
        }

        .pos-autocomplete-item {
            display: block;
            width: 100%;
            text-align: left;
            background: #fff;
            border: 0;
            border-bottom: 1px solid #f1f3f5;
            padding: 12px 14px;
            cursor: pointer;
            transition: background-color .12s ease, box-shadow .12s ease;
        }

            .pos-autocomplete-item:last-child {
                border-bottom: 0;
            }

            .pos-autocomplete-item:hover {
                background: #f8fbff;
            }

            .pos-autocomplete-item.active {
                background: #eef5ff;
                box-shadow: inset 3px 0 0 #0d6efd;
            }

        .pos-autocomplete-row {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 12px;
        }

        .pos-autocomplete-main {
            min-width: 0;
            flex: 1 1 auto;
        }

        .pos-autocomplete-title {
            font-size: .98rem;
            font-weight: 800;
            color: #212529;
            line-height: 1.25;
            margin-bottom: 6px;
            word-break: break-word;
        }

            .pos-autocomplete-title mark {
                background: #fff3cd;
                color: #212529;
                padding: 0 2px;
                border-radius: 4px;
            }

        .pos-autocomplete-right {
            flex: 0 0 auto;
            text-align: right;
            min-width: 90px;
        }

        .pos-autocomplete-price {
            font-size: .98rem;
            font-weight: 800;
            color: #0d6efd;
            white-space: nowrap;
        }

        .pos-autocomplete-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .pos-meta-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 3px 8px;
            font-size: .76rem;
            font-weight: 700;
            line-height: 1.2;
            background: #f1f3f5;
            color: #495057;
            max-width: 100%;
        }

            .pos-meta-badge.sku {
                background: #eef5ff;
                color: #0d6efd;
            }

            .pos-meta-badge.barcode {
                background: #f8f9fa;
                color: #6c757d;
            }

        .pos-meta-text {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 220px;
        }

        /* =========================================================
                   4. BẢNG DÒNG HÀNG
                ========================================================= */
        .pos-table-wrap {
            border: 1px solid #edf0f2;
            border-radius: 16px;
            overflow: hidden;
        }

        .pos-line-table {
            margin-bottom: 0;
        }

            .pos-line-table thead th {
                background: #f8f9fa;
                font-size: .86rem;
                font-weight: 800;
                color: #495057;
                border-bottom-width: 1px;
                white-space: nowrap;
            }

            .pos-line-table td,
            .pos-line-table th {
                vertical-align: middle;
            }

        .pos-line-name {
            font-weight: 700;
            color: #212529;
        }

        .pos-line-meta {
            font-size: .82rem;
            color: #6c757d;
            margin-top: 4px;
        }

        .pos-line-name-wrap {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 8px;
            width: 100%;
        }

        .pos-line-name-main {
            min-width: 0;
            flex: 1 1 auto;
            padding-right: 4px;
        }

        .pos-line-name {
            font-weight: 700;
            color: #212529;
            line-height: 1.35;
            word-break: normal;
            overflow-wrap: break-word;
        }

        .pos-line-info-btn {
            width: 28px;
            height: 28px;
            min-width: 28px;
            border-radius: 999px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            flex: 0 0 auto;
            margin-top: 2px;
        }

  

        .pos-line-submeta {
            font-size: .84rem;
            color: #6c757d;
            margin-top: 4px;
            font-weight: 500;
        }

        .pos-line-info-btn {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .popover {
            max-width: 380px;
            border-radius: 14px;
            border: 1px solid #e9ecef;
            box-shadow: 0 0.5rem 1.25rem rgba(0,0,0,.12);
        }

        .popover-header {
            font-weight: 800;
            font-size: .9rem;
            background: #f8f9fa;
            border-bottom: 1px solid #edf0f2;
            border-top-left-radius: 14px;
            border-top-right-radius: 14px;
        }

        .popover-body {
            font-size: .88rem;
            line-height: 1.55;
            color: #495057;
        }

        .pos-line-discount-btn {
            min-width: 82px;
            padding-left: 10px;
            padding-right: 10px;
        }

        .qty-box {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .qty-box input {
                width: 70px;
                text-align: center;
                border-radius: 10px;
            }

        .qty-btn {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            padding: 0;
            font-weight: 700;
        }

        .pos-qty-cell {
            text-align: center;
        }

            .pos-qty-cell .qty-box {
                justify-content: center;
            }

        .pos-qty-summary {
            font-size: .84rem;
            color: #6c757d;
            margin-top: 6px;
            text-align: center;
            line-height: 1.35;
        }

        .pos-qty-summary {
            font-size: .84rem;
            color: #6c757d;
            margin-top: 6px;
            text-align: center;
            line-height: 1.35;
            word-break: keep-all;
        }
        .pos-col-product {
    width: auto;
}

.pos-line-name-cell {
    min-width: 260px;
    width: auto;
}


        /* =========================================================
                   5. THÔNG TIN BÊN PHẢI
                ========================================================= */
        .pos-customer-box {
            border: 1px dashed #d9e2f2;
            background: #f8fbff;
            border-radius: 14px;
            padding: 12px 14px;
        }

        .pos-customer-name {
            font-weight: 800;
            color: #0d3b7a;
        }

        .pos-customer-phone {
            color: #5b6773;
            font-size: .9rem;
        }

        .pos-customer-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .pos-kpi-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .pos-summary-box {
            border-radius: 14px;
            padding: 14px 14px;
            background: #f8f9fa;
            border: 1px solid #edf0f2;
        }

        .pos-summary-label {
            font-size: .85rem;
            color: #6c757d;
            margin-bottom: 6px;
        }

        .pos-summary-value {
            font-size: 1.18rem;
            font-weight: 800;
            color: #212529;
            line-height: 1.2;
        }

        .pos-action-btn {
            min-height: 52px;
            font-weight: 800;
            border-radius: 12px;
        }

        .pos-action-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .shortcut-badge {
            font-size: .72rem;
            margin-left: 6px;
        }

        /* =========================================================
                   6. DANH SÁCH ĐƠN GIỮ
                ========================================================= */
        .pos-list-item {
            border: 1px solid #e9ecef;
            border-radius: 14px;
            padding: 12px 14px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all .15s ease;
            background: #fff;
        }

            .pos-list-item:hover {
                border-color: #0d6efd;
                box-shadow: 0 0 0 2px rgba(13,110,253,.06);
            }

        .pos-list-meta {
            font-size: .84rem;
            color: #6c757d;
        }

        .pos-empty {
            color: #6c757d;
            font-style: italic;
        }

        /* =========================================================
                   7. MODAL / POPUP
                ========================================================= */
        .pos-modal-title {
            font-weight: 800;
        }

        .pos-modal-subtitle {
            color: #6c757d;
            font-size: .9rem;
        }

        .pos-customer-search-list {
            max-height: 360px;
            overflow-y: auto;
            border: 1px solid #edf0f2;
            border-radius: 14px;
        }

        .pos-customer-search-item {
            border: 0;
            border-bottom: 1px solid #edf0f2;
            padding: 12px 14px;
            width: 100%;
            background: #fff;
            text-align: left;
        }

            .pos-customer-search-item:last-child {
                border-bottom: 0;
            }

            .pos-customer-search-item:hover {
                background: #f8fbff;
            }

        .pos-modal-danger-icon {
            width: 64px;
            height: 64px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff1f2;
            color: #dc3545;
            font-size: 1.6rem;
            font-weight: 900;
        }

        .pos-note-box {
            background: #f8f9fa;
            border: 1px solid #edf0f2;
            border-radius: 14px;
            padding: 12px 14px;
        }

        /* =========================================================
                   8. PAYMENT MODAL - NÚT THANH TOÁN NHANH
                ========================================================= */
        .pay-quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .pay-quick-btn,
        .pay-plus-btn {
            font-weight: 700;
            border-radius: 10px;
        }

        .pay-preview-box {
            background: #f8f9fa;
            border: 1px solid #edf0f2;
            border-radius: 12px;
            padding: 10px 12px;
        }

        .pay-preview-label {
            color: #6c757d;
            font-size: .82rem;
        }

        .pay-preview-value {
            font-weight: 800;
        }

        /* =========================================================
                   9. RESPONSIVE
                ========================================================= */
        @@media (max-width: 991.98px) {
            .sticky-right {
                position: static;
                top: unset;
            }

            .pos-kpi-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .pos-kpi-grid {
                grid-template-columns: 1fr;
            }

            .pos-autocomplete-row {
                flex-direction: column;
            }

            .pos-autocomplete-right {
                min-width: auto;
                text-align: left;
            }

            .pay-quick-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .pos-line-meta-strong {
            font-size: .82rem;
            color: #495057;
            margin-top: 4px;
            font-weight: 700;
        }
    </style>
}

@section header {
    <div class="py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3 class="mb-0 fw-bold">POS Bán hàng</h3>
            <div class="text-muted">Màn hình thu ngân thao tác nhanh, rõ ràng, dễ dùng</div>
        </div>
        <div>
            <span id="lblCurrentOrder" class="badge bg-secondary pos-current-badge">Chưa có giỏ</span>
        </div>
    </div>
}

<partial name="~/Areas/Admin/Views/Shared/_POSNavTabs.cshtml" />

<div class="pos-shell">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <!-- =========================================================
             CỘT TRÁI: QUÉT HÀNG + GIỎ HIỆN TẠI + DANH SÁCH PAYMENT ĐÃ GHI NHẬN
        ========================================================= -->
        <div class="col-xl-8 col-lg-7">
            <div class="card pos-card pos-toolbar-card mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-start">
                        <div class="col-md-8">
                            <div class="pos-inline-label">Quét barcode / tìm nhanh sản phẩm</div>
                            <div class="pos-barcode-wrap">
                                <input id="txtBarcode"
                                       class="form-control pos-barcode-input"
                                       placeholder="Quét barcode hoặc gõ tên / SKU / barcode"
                                       autocomplete="off" />
                                <div id="barcodeAutocomplete" class="pos-autocomplete-menu" style="display:none;"></div>
                            </div>
                        </div>

                        <div class="col-md-2 d-grid">
                            <div class="pos-inline-label">&nbsp;</div>
                            <button id="btnScan" class="btn btn-primary pos-toolbar-btn" type="button">Thêm hàng</button>
                        </div>

                        <div class="col-md-2 d-grid">
                            <div class="pos-inline-label">&nbsp;</div>
                            <button id="btnFocusBarcode" class="btn btn-outline-secondary pos-toolbar-btn" type="button">Focus</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card pos-card">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="pos-section-title mb-1">Giỏ hiện tại</div>
                        <div id="currentCartInfo" class="pos-subtext">Đang tải...</div>
                    </div>

                    <div class="pos-table-wrap">
                        <div class="table-responsive">
                            <table class="table align-middle pos-line-table">
                                <thead>
                                    <tr>
                                        <th style="width:56px;">#</th>
                                        <th class="pos-col-product">Sản phẩm</th>
                                        <th style="width:170px;">SL</th>
                                        <th style="width:110px;">Đơn giá</th>
                                        <th style="width:110px;">Giảm giá</th>
                                        <th style="width:120px;">Thành tiền</th>
                                        <th style="width:80px;">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody id="currentDraftBody">
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">Đang tải dữ liệu...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="paymentListBox" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- =========================================================
             CỘT PHẢI: KHÁCH HÀNG + GHI CHÚ + GIẢM GIÁ ĐƠN + TỔNG KẾT + ACTION + ĐƠN GIỮ
        ========================================================= -->
        <div class="col-xl-4 col-lg-5">
            <div class="sticky-right">
                <!-- Khách hàng -->
                <div class="card pos-card mb-3">
                    <div class="card-body">
                        <div class="pos-section-title">Khách hàng</div>
                        <div id="customerInfoBox" class="pos-customer-box">
                            <div class="text-muted">Khách lẻ</div>
                        </div>
                    </div>
                </div>

                <!-- Ghi chú đơn -->
                <div class="card pos-card mb-3">
                    <div class="card-body">
                        <div class="pos-section-title">Ghi chú đơn</div>

                        <div class="mb-2">
                            <textarea id="txtOrderNote"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập ghi chú cho đơn hiện tại..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button id="btnSaveOrderNote" type="button" class="btn btn-outline-primary">
                                Lưu ghi chú
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Giảm giá đơn -->
                <div class="card pos-card mb-3">
                    <div class="card-body">
                        <div class="pos-section-title">Giảm giá đơn</div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold">Số tiền giảm</label>
                            <input id="txtOrderDiscount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="Nhập số tiền giảm giá" />
                        </div>

                        <div class="d-grid gap-2">
                            <button id="btnSaveOrderDiscount" type="button" class="btn btn-outline-primary">
                                Lưu giảm giá
                            </button>
                            <button id="btnClearOrderDiscount" type="button" class="btn btn-outline-secondary">
                                Xóa giảm giá
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tổng kết đơn -->
                <div class="card pos-card mb-3">
                    <div class="card-body">
                        <div class="pos-section-title">Tổng kết đơn</div>

                        <div class="pos-kpi-grid">
                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Tạm tính</div>
                                <div id="sumSubtotal" class="pos-summary-value">0</div>
                            </div>

                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Tổng giảm giá</div>
                                <div id="sumDiscount" class="pos-summary-value">0</div>
                            </div>

                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Thành tiền</div>
                                <div id="sumGrandTotal" class="pos-summary-value">0</div>
                            </div>

                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Đã thanh toán</div>
                                <div id="sumPaid" class="pos-summary-value">0</div>
                            </div>

                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Còn thiếu</div>
                                <div id="sumBalance" class="pos-summary-value">0</div>
                            </div>

                            <div class="pos-summary-box">
                                <div class="pos-summary-label">Tiền thừa</div>
                                <div id="sumChange" class="pos-summary-value">0</div>
                            </div>
                        </div>

                        <div class="pos-action-grid mt-3">
                            <button id="btnNewCart" class="btn btn-outline-primary pos-action-btn" type="button">
                                Tạo giỏ mới <span class="badge bg-light text-dark shortcut-badge">F6</span>
                            </button>

                            <button id="btnHoldCart" class="btn btn-warning pos-action-btn" type="button">
                                Giữ đơn <span class="badge bg-light text-dark shortcut-badge">F2</span>
                            </button>

                            <button id="btnOpenPayment" class="btn btn-info text-white pos-action-btn" type="button">
                                Thanh toán <span class="badge bg-light text-dark shortcut-badge">F3</span>
                            </button>

                            <button id="btnFinalizeCart" class="btn btn-success pos-action-btn" type="button">
                                Chốt đơn <span class="badge bg-light text-dark shortcut-badge">F4</span>
                            </button>

                            <button id="btnCancelCart" class="btn btn-outline-danger pos-action-btn" type="button">
                                Hủy giỏ
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Đơn đang giữ -->
                <div class="card pos-card">
                    <div class="card-body">
                        <div class="pos-section-title">Danh sách đơn đang giữ</div>
                        <div id="heldList">
                            <div class="pos-empty">Đang tải...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     PAYMENT MODAL - BƯỚC 16 + 17
     - Tổng kết thanh toán
     - Thêm payment
     - Nút thu đủ / mệnh giá nhanh / cộng thêm
     - Preview còn thiếu / tiền thừa
========================================================= -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content pos-card">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title pos-modal-title">Thanh toán giỏ hiện tại</h5>
                    <div class="pos-modal-subtitle">Thêm khoản thanh toán và chốt đơn khi đã đủ tiền</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <div class="fw-bold mb-3">Tổng kết thanh toán</div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Tạm tính</span>
                                    <strong id="paySumSubtotal">0</strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Tổng giảm giá</span>
                                    <strong id="paySumDiscount">0</strong>
                                </div>

