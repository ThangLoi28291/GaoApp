@model GaoApp.Web.Areas.Admin.ViewModels.POS.POSHeaderContextViewModel

@{
    var shiftText = Model.HasOpenShift
        ? "Ca đang mở"
        : "Chưa mở ca";

    var warehouseText = string.IsNullOrWhiteSpace(Model.WarehouseName)
        ? "Chưa chọn kho"
        : Model.WarehouseName;

    var userText = string.IsNullOrWhiteSpace(Model.UserName)
        ? "Chưa xác định nhân viên"
        : Model.UserName;

    var readinessClass = Model.HasOpenShift
        ? "is-ready"
        : "is-warning";

    var readinessText = Model.HasOpenShift
        ? "Sẵn sàng"
        : "Chưa mở ca";
}

<header class="pos-cockpit-header" data-pos-cockpit-header>
    <div class="pos-cockpit-header__identity">
        <button type="button" class="gao-mobile-shell-menu layout-menu-toggle" aria-controls="layout-menu" aria-label="Mở menu cửa hàng" aria-expanded="false">
            <i class="icon-base bx bx-menu" aria-hidden="true"></i>
        </button>
        <div class="pos-cockpit-header__title">
            BÁN HÀNG
        </div>

        <div class="pos-cockpit-header__context"
             aria-label="Ngữ cảnh bán hàng hiện tại">

            <span class="pos-cockpit-context-item"
                  title="@(Model.HasOpenShift ? Model.ShiftCode : "Chưa mở ca")">
                <i class="bx bx-time-five" aria-hidden="true"></i>
                <strong>@shiftText</strong>
            </span>

            <span class="pos-cockpit-context-divider"
                  aria-hidden="true">·</span>

            <span class="pos-cockpit-context-item"
                  title="Kho bán">
                <i class="bx bx-package" aria-hidden="true"></i>
                <span>@warehouseText</span>
            </span>

            <span class="pos-cockpit-context-divider"
                  aria-hidden="true">·</span>

            <span class="pos-cockpit-context-item"
                  title="Nhân viên">
                <i class="bx bx-user" aria-hidden="true"></i>
                <span>@userText</span>
            </span>
        </div>
    </div>

    <div class="pos-cockpit-header__actions">

        <div class="pos-cockpit-readiness @readinessClass"
             title="Trạng thái ca POS">
            <span class="pos-cockpit-readiness__dot"
                  aria-hidden="true"></span>
            <span>@readinessText</span>
        </div>

        <partial name="_HeldOrdersPanel" />

        <button type="button"
                class="pos-cockpit-header-button"
                data-pos-shortcuts-toggle
                aria-controls="posCockpitShortcutPanel"
                aria-expanded="false"
                title="Xem phím tắt">
            <i class="bx bx-keyboard" aria-hidden="true"></i>
            <span class="pos-cockpit-header-button__label">
                Phím tắt
            </span>
        </button>

        <partial name="_ConfiguredMoreMenu" />
        <div class="gao-account-toolbar-slot" data-account-toolbar-slot data-mobile-account-slot></div>
    </div>

    <div id="posCockpitShortcutPanel"
         class="pos-cockpit-shortcuts"
         hidden>

        <div class="pos-cockpit-shortcuts__header">
            <strong>Phím tắt POS</strong>

            <button type="button"
                    class="pos-cockpit-shortcuts__close"
                    data-pos-shortcuts-close
                    aria-label="Đóng bảng phím tắt">
                <i class="bx bx-x"></i>
            </button>
        </div>

        <div class="pos-cockpit-shortcuts__grid">
            <div><kbd>F2</kbd><span>Giữ đơn</span></div>
            <div><kbd>F3</kbd><span>Thanh toán</span></div>
            <div><kbd>F4</kbd><span>Chốt đơn</span></div>
            <div><kbd>F6</kbd><span>Đơn giữ</span></div>
            <div><kbd>F8</kbd><span>Sửa số lượng</span></div>
            <div><kbd>Alt+F7</kbd><span>Giảm giá dòng</span></div>
            <div><kbd>Ctrl+Del</kbd><span>Hủy giỏ</span></div>
            <div><kbd>Esc</kbd><span>Về ô quét</span></div>
        </div>
    </div>
</header>
