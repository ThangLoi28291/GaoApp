@* =========================================================
   POS v0.2 P1
   Customer region inside Checkout Panel.

   IMPORTANT:
   - Giữ duy nhất id="customerInfoBox"
   - Customer/reward/voucher behavior vẫn do JS cũ sở hữu
========================================================= *@

<section class="pos-cockpit-section pos-cockpit-customer-section">
    <div class="pos-cockpit-section__header">
        <div class="pos-cockpit-section__eyebrow">
            KHÁCH HÀNG
        </div>

        <button type="button"
                class="pos-cockpit-section__icon-action"
                data-pos-command-prefix="&#64;"
                title="Tìm hoặc đổi khách hàng"
                aria-label="Tìm hoặc đổi khách hàng">
            <i class="bx bx-chevron-right"></i>
        </button>
    </div>

    <div id="customerInfoBox"
         class="pos-customer-box pos-customer-box-checkout">
        <div class="text-muted">
            Khách lẻ
        </div>
    </div>
</section>