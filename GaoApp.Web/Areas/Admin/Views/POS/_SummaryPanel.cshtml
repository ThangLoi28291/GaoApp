@* =========================================================
   POS v0.2 P5-A3
   Persistent payment summary.

   Presentation only:
   - Keep canonical financial DOM ids.
   - Group Subtotal / Discount / Grand Total / Payment state
     in one decision area next to the payment actions.
========================================================= *@

<section class="pos-cockpit-summary-section">

    <div class="pos-cockpit-summary-head">
        <div class="pos-cockpit-section__eyebrow">
            TỔNG TIỀN
        </div>

        <button id="btnRefreshScreen"
                type="button"
                class="pos-cockpit-section__icon-action"
                title="Làm mới dữ liệu POS"
                aria-label="Làm mới dữ liệu POS">
            <i class="bx bx-refresh"></i>
        </button>
    </div>

    <div class="pos-cockpit-summary-breakdown"
         aria-label="Tóm tắt giá trị đơn hàng">

        <div class="pos-cockpit-summary-breakdown__item">
            <span>Tạm tính</span>
            <strong id="sumSubtotal">0</strong>
        </div>

        <div class="pos-cockpit-summary-breakdown__item">
            <span>Giảm giá</span>
            <strong id="sumDiscount">0</strong>
        </div>
    </div>

    <div id="posSummaryHero"
         class="pos-summary-hero pos-summary-hero--grand pos-summary-hero--empty">

        <div class="pos-summary-hero__label">
            Thành tiền
        </div>

        <div id="sumGrandTotal"
             class="pos-summary-hero__value">
            0
        </div>

        <div id="sumPaymentStateText"
             class="pos-summary-hero__state">
            Chưa thanh toán
        </div>
    </div>

    <div class="pos-cockpit-payment-status">

        <div class="pos-cockpit-payment-status__row is-due">
            <span>Còn thiếu</span>
            <strong id="sumBalance">0</strong>
        </div>

        <div class="pos-cockpit-payment-status__row is-paid">
            <span>Đã thu</span>
            <strong id="sumPaid">0</strong>
        </div>
    </div>
</section>
