@* =========================================================
   POS v0.2 P5-A3
   Compact order tools inside the unified Checkout Panel.

   Presentation only:
   - Keep canonical DOM ids and data hooks.
   - Financial subtotal/discount presentation belongs to Summary.
   - Note / order-discount editors keep existing behavior.
========================================================= *@

<section class="pos-cockpit-section pos-cockpit-order-section pos-cockpit-order-tools">

    <div class="pos-cockpit-section__eyebrow">
        CÔNG CỤ ĐƠN
    </div>

    <div class="pos-order-tools-grid">

        <div class="pos-meta-section pos-order-tool is-collapsed"
             data-meta-section="note">

            <div class="pos-meta-section__header">
                <div>
                    <div class="pos-meta-section__title">
                        Ghi chú
                    </div>

                    <div id="metaOrderNoteSummary"
                         class="pos-meta-summary text-muted small">
                        Chưa có ghi chú
                    </div>
                </div>

                <button type="button"
                        class="btn btn-sm btn-light pos-meta-toggle"
                        data-toggle-meta="note"
                        aria-label="Sửa ghi chú đơn">
                    Sửa
                </button>
            </div>

            <div class="pos-note-box">
                <textarea id="txtOrderNote"
                          class="form-control"
                          rows="3"
                          placeholder="Nhập ghi chú..."></textarea>

                <div class="d-grid mt-2">
                    <button id="btnSaveOrderNote"
                            type="button"
                            class="btn btn-outline-primary">
                        Lưu ghi chú
                    </button>
                </div>
            </div>
        </div>

        <div class="pos-meta-section pos-order-tool is-collapsed"
             data-meta-section="discount">

            <div class="pos-meta-section__header">
                <div>
                    <div class="pos-meta-section__title">
                        Giảm giá đơn
                    </div>

                    <div id="metaOrderDiscountSummary"
                         class="pos-meta-summary text-muted small">
                        0
                    </div>
                </div>

                <button type="button"
                        class="btn btn-sm btn-light pos-meta-toggle"
                        data-toggle-meta="discount"
                        aria-label="Sửa giảm giá đơn">
                    Sửa
                </button>
            </div>

            <div class="pos-note-box">
                <input id="txtOrderDiscount"
                       type="number"
                       min="0"
                       step="1000"
                       class="form-control"
                       placeholder="Nhập số tiền giảm" />

                <div class="row g-2 mt-2">
                    <div class="col-6 d-grid">
                        <button id="btnSaveOrderDiscount"
                                type="button"
                                class="btn btn-outline-warning">
                            Lưu
                        </button>
                    </div>

                    <div class="col-6 d-grid">
                        <button id="btnClearOrderDiscount"
                                type="button"
                                class="btn btn-outline-secondary">
                            Xóa
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
