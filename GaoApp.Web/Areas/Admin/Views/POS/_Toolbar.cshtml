<div class="pos-cockpit-command">
    <div class="pos-cockpit-command__main">

        <label for="txtBarcode"
               class="visually-hidden">
            Quét barcode hoặc tìm sản phẩm
        </label>

        <div class="pos-barcode-wrap pos-cockpit-search">
            <i class="bx bx-search pos-cockpit-search__icon"
               aria-hidden="true"></i>

            <input id="txtBarcode"
                   class="form-control pos-barcode-input pos-cockpit-search__input"
                   placeholder="Quét barcode hoặc tìm sản phẩm..."
                   autocomplete="off"
                   aria-describedby="posCockpitCommandHints" />

            <button id="posScanCameraOpen" class="pos-camera-trigger" type="button" hidden
                    aria-label="Quét mã vạch bằng camera" aria-controls="posScanCameraModal" title="Quét mã vạch bằng camera">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M4 8V4h4m8 0h4v4M4 16v4h4m8 0h4v-4M7 8v8m3-9v10m4-10v10m3-9v8" />
                </svg>
            </button>

            <div id="barcodeAutocomplete"
                 class="pos-autocomplete-menu"
                 style="display:none;">
            </div>
        </div>
    </div>

    <div id="posCockpitCommandHints"
         class="pos-cockpit-command__hints">

        <button type="button"
                class="pos-cockpit-command-chip"
                data-pos-command-focus>
            <i class="bx bx-package"></i>
            <span>Sản phẩm</span>
        </button>

        <button type="button"
                class="pos-cockpit-command-chip"
                data-pos-command-prefix="&#64;">
            <span class="pos-cockpit-command-chip__symbol">@@</span>
            <span>Khách</span>
        </button>

        <button type="button"
                class="pos-cockpit-command-chip"
                data-pos-command-prefix="#">
            <span class="pos-cockpit-command-chip__symbol">#</span>
            <span>Voucher</span>
        </button>

        <button type="button"
                class="pos-cockpit-command-chip"
                data-pos-command-prefix="4+">
            <span class="pos-cockpit-command-chip__symbol">4+</span>
            <span>SL</span>
        </button>

    </div>
</div>
<partial name="_ScanFeedback" />
