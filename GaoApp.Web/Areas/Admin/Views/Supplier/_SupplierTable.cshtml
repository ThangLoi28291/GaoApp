@using GaoApp.Application.Common.Security
@using GaoApp.Web.Areas.Admin.ViewModels.Suppliers
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@model SupplierIndexVM

@{
    var items = Model.Paged.Items;
    var totalItems = Model.Paged.TotalItems;
    var pageSize = Model.PageSize <= 0 ? 20 : Model.PageSize;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    var firstItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastItem = totalItems == 0 ? 0 : Math.Min(currentPage * pageSize, totalItems);

    var canUpdate = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Catalog.Supplier.Update)).Succeeded;
    var canDelete = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Catalog.Supplier.Delete)).Succeeded;
}

<div data-supplier-result
     data-total-suppliers="@Model.TotalSupplierCount"
     data-active-suppliers="@Model.ActiveSupplierCount"
     data-inactive-suppliers="@Model.InactiveSupplierCount">

    <section class="gds-list-panel" aria-label="Danh sách nhà cung cấp">
        @if (items == null || !items.Any())
        {
            <div class="gds-empty">
                <div class="gds-empty__icon" aria-hidden="true">
                    <i class="bx bx-store-alt"></i>
                </div>
                <div class="fw-semibold mb-1">Chưa có nhà cung cấp phù hợp</div>
                <div class="gds-empty__copy">
                    Thử thay đổi từ khóa hoặc trạng thái lọc.
                </div>
            </div>
        }
        else
        {
            <div class="gds-desktop-list">
                <div class="table-responsive">
                    <table class="table align-middle gds-table">
                        <thead>
                            <tr>
                                <th style="width: 150px;">Mã nhà cung cấp</th>
                                <th style="min-width: 190px;">Nhà cung cấp</th>
                                <th style="min-width: 210px;">Liên hệ</th>
                                <th style="width: 150px;">Mã số thuế</th>
                                <th style="width: 175px;">Trạng thái</th>
                                <th style="width: 125px;">Ngày tạo</th>
                                <th class="text-end" style="width: 110px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var x in items)
                            {
                                <tr>
                                    <td>
                                        <span class="gds-code">@x.Code</span>
                                    </td>

                                    <td>
                                        <div class="gds-table__primary">@x.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(x.BankName) || !string.IsNullOrWhiteSpace(x.MaskedBankAccountNumber))
                                        {
                                            <div class="gds-table__secondary text-break">
                                                <i class="bx bx-credit-card me-1" aria-hidden="true"></i>
                                                @x.BankName <span class="text-nowrap">@x.MaskedBankAccountNumber</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(x.ContactName))
                                        {
                                            <div class="gds-table__secondary">
                                                Liên hệ: @x.ContactName
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(x.Phone))
                                        {
                                            <a href="tel:@x.Phone" class="gds-table__secondary d-block">
                                                <i class="bx bx-phone me-1" aria-hidden="true"></i>@x.Phone
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(x.Email))
                                        {
                                            <a href="mailto:@x.Email" class="gds-table__secondary d-block">
                                                <i class="bx bx-envelope me-1" aria-hidden="true"></i>@x.Email
                                            </a>
                                        }
                                        @if (string.IsNullOrWhiteSpace(x.Phone) && string.IsNullOrWhiteSpace(x.Email))
                                        {
                                            <span class="gds-table__secondary">Chưa có thông tin</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="gds-table__secondary">
                                            @(string.IsNullOrWhiteSpace(x.TaxCode) ? "Chưa có" : x.TaxCode)
                                        </span>
                                    </td>

                                    <td>
                                        @if (canUpdate)
                                        {
                                            <button type="button"
                                                    class="gds-status gds-status--dot gds-status-button js-toggle-status @(x.Status ? "is-success" : "is-neutral")"
                                                    data-id="@x.Id"
                                                    data-name="@x.Name"
                                                    data-status="@x.Status.ToString().ToLowerInvariant()"
                                                    aria-label="@(x.Status ? $"Ngừng hoạt động nhà cung cấp {x.Name}" : $"Kích hoạt lại nhà cung cấp {x.Name}")"
                                                    title="@(x.Status ? "Bấm để ngừng hoạt động" : "Bấm để kích hoạt lại")"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top">
                                                @(x.Status ? "Đang hoạt động" : "Ngừng hoạt động")
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="gds-status gds-status--dot @(x.Status ? "is-success" : "is-neutral")">
                                                @(x.Status ? "Đang hoạt động" : "Ngừng hoạt động")
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="gds-table__secondary">
                                            @x.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        @if (canUpdate || canDelete)
                                        {
                                            <div class="gds-row-actions justify-content-end">
                                                @if (canUpdate)
                                                {
                                                    <a asp-area="Admin"
                                                       asp-controller="Supplier"
                                                       asp-action="Edit"
                                                       asp-route-id="@x.Id"
                                                       class="gds-icon-button gds-action-button"
                                                       aria-label="Sửa nhà cung cấp @x.Name"
                                                       title="Sửa"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top">
                                                        <i class="bx bx-edit" aria-hidden="true"></i>
                                                    </a>
                                                }

                                                @if (canDelete)
                                                {
                                                    <button type="button"
                                                            class="gds-icon-button gds-action-button is-danger js-delete"
                                                            data-id="@x.Id"
                                                            data-name="@x.Name"
                                                            aria-label="Xóa nhà cung cấp @x.Name"
                                                            title="Xóa"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                        <i class="bx bx-trash" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="gds-mobile-list" aria-label="Danh sách nhà cung cấp trên thiết bị di động">
                @foreach (var x in items)
                {
                    <article class="gds-row-card">
                        <div class="gds-row-card__header">
                            <div>
                                <div class="gds-row-card__title">@x.Name</div>
                                <div class="gds-code mt-1">@x.Code</div>
                            </div>

                            @if (canUpdate)
                            {
                                <button type="button"
                                        class="gds-status gds-status--dot gds-status-button js-toggle-status @(x.Status ? "is-success" : "is-neutral")"
                                        data-id="@x.Id"
                                        data-name="@x.Name"
                                        data-status="@x.Status.ToString().ToLowerInvariant()"
                                        aria-label="@(x.Status ? $"Ngừng hoạt động nhà cung cấp {x.Name}" : $"Kích hoạt lại nhà cung cấp {x.Name}")">
                                    @(x.Status ? "Đang hoạt động" : "Ngừng hoạt động")
                                </button>
                            }
                            else
                            {
                                <span class="gds-status gds-status--dot @(x.Status ? "is-success" : "is-neutral")">
                                    @(x.Status ? "Đang hoạt động" : "Ngừng hoạt động")
                                </span>
                            }
                        </div>

                        <div class="gds-row-card__meta">
                            @if (!string.IsNullOrWhiteSpace(x.BankName) || !string.IsNullOrWhiteSpace(x.MaskedBankAccountNumber))
                            {
                                <span class=" text-break">
                                    <i class="bx bx-credit-card me-1" aria-hidden="true"></i>
                                    @x.BankName <span class="text-nowrap">@x.MaskedBankAccountNumber</span>
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.ContactName))
                            {
                                <span>
                                    <i class="bx bx-user me-1" aria-hidden="true"></i>@x.ContactName
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.Phone))
                            {
                                <a href="tel:@x.Phone">
                                    <i class="bx bx-phone me-1" aria-hidden="true"></i>@x.Phone
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.Email))
                            {
                                <a href="mailto:@x.Email">
                                    <i class="bx bx-envelope me-1" aria-hidden="true"></i>@x.Email
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.TaxCode))
                            {
                                <span>
                                    <i class="bx bx-receipt me-1" aria-hidden="true"></i>MST @x.TaxCode
                                </span>
                            }
                            <span>
                                <i class="bx bx-calendar me-1" aria-hidden="true"></i>
                                Tạo @x.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")
                            </span>
                        </div>

                        @if (canUpdate || canDelete)
                        {
                            <div class="gds-row-card__actions">
                                @if (canUpdate)
                                {
                                    <a asp-area="Admin"
                                       asp-controller="Supplier"
                                       asp-action="Edit"
                                       asp-route-id="@x.Id"
                                       class="btn btn-sm btn-label-primary gds-action-button">
                                        <i class="bx bx-edit me-1" aria-hidden="true"></i>Sửa
                                    </a>
                                }

                                @if (canDelete)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-label-danger gds-action-button js-delete"
                                            data-id="@x.Id"
                                            data-name="@x.Name">
                                        <i class="bx bx-trash me-1" aria-hidden="true"></i>Xóa
                                    </button>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <div class="gds-list-footer">
        <div class="gds-list-footer__summary">
            @if (totalItems == 0)
            {
                <span>0 kết quả</span>
            }
            else
            {
                <span><strong>@firstItem–@lastItem</strong> / @totalItems kết quả</span>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Phân trang nhà cung cấp">
                <ul class="pagination mb-0">
                    @{
                        var start = Math.Max(1, currentPage - 3);
                        var end = Math.Min(totalPages, start + 6);
                        start = Math.Max(1, end - 6);
                    }

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage - 1)"
                           aria-label="Trang trước">
                            <i class="bx bx-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>

                    @for (var page = start; page <= end; page++)
                    {
                        <li class="page-item @(page == currentPage ? "active" : "")">
                            <a href="#" class="page-link js-page-link" data-page="@(page)">@(page)</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage + 1)"
                           aria-label="Trang sau">
                            <i class="bx bx-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
