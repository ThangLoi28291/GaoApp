@using GaoApp.Application.Common.Security
@using GaoApp.Web.Areas.Admin.ViewModels.Suppliers
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@model SupplierIndexVM

@{
    var items = Model.Paged.Items;
    var totalItems = Model.Paged.TotalItems;
    var pageSize = Model.PageSize <= 0 ? 20 : Model.PageSize;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    var canUpdate = (await AuthorizationService.AuthorizeAsync(User, PermissionCodes.Catalog.Supplier.Update)).Succeeded;
    var canDelete = (await AuthorizationService.AuthorizeAsync(User, PermissionCodes.Catalog.Supplier.Delete)).Succeeded;
}

<div class="card border-0 shadow-sm sp-table-card">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1 fw-bold">Danh sách nhà cung cấp</h5>
            <div class="text-muted small">
                Tổng cộng <b>@totalItems</b> nhà cung cấp
            </div>
        </div>
    </div>

    <div class="table-responsive sp-table-wrap">
        <table class="table table-hover align-middle mb-0 sp-table">
            <thead>
                <tr>
                    <th style="width:90px">ID</th>
                    <th style="width:160px">Mã</th>
                    <th>Nhà cung cấp</th>
                    <th style="width:180px">Liên hệ</th>
                    <th style="width:180px">Trạng thái</th>
                    <th class="text-end" style="width:120px">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (items == null || !items.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="sp-empty">
                                <div class="sp-empty-icon">
                                    <i class="bx bx-store-alt"></i>
                                </div>
                                <div class="fw-bold mb-1">Chưa có nhà cung cấp</div>
                                <div class="text-muted">
                                    Hãy thêm nhà cung cấp để quản lý nhập hàng và công nợ.
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var x in items)
                    {
                        <tr>
                            <td>
                                <span class="sp-id">#@x.Id</span>
                            </td>

                            <td>
                                <span class="sp-code">@x.Code</span>
                            </td>

                            <td>
                                <div class="fw-bold">@x.Name</div>
                                @if (!string.IsNullOrWhiteSpace(x.Phone))
                                {
                                    <div class="text-muted small d-md-none">
                                        <i class="bx bx-phone me-1"></i>@x.Phone
                                    </div>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(x.Phone))
                                {
                                    <a href="tel:@x.Phone" class="sp-phone">
                                        <i class="bx bx-phone me-1"></i>@x.Phone
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>

                            <td>
                                @if (canUpdate)
                                {
                                    <button type="button"
                                            class="sp-status-btn js-toggle-status @(x.Status ? "is-active" : "is-inactive")"
                                            data-id="@x.Id">
                                        <span class="sp-status-dot"></span>
                                        @(x.Status ? "Đang hoạt động" : "Ngưng giao dịch")
                                    </button>
                                }
                                else
                                {
                                    <span class="sp-status-badge @(x.Status ? "is-active" : "is-inactive")">
                                        <span class="sp-status-dot"></span>
                                        @(x.Status ? "Đang hoạt động" : "Ngưng giao dịch")
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-label-secondary"
                                            data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end">
                                        @if (canUpdate)
                                        {
                                            <a asp-area="Admin"
                                                   asp-controller="Supplier"
                                                   asp-action="Edit"
                                                   asp-route-id="@x.Id"
                                                   class="dropdown-item">
                                                <i class="bx bx-edit me-2"></i> Sửa
                                            </a>

                                            <button type="button"
                                                    class="dropdown-item js-toggle-status"
                                                    data-id="@x.Id">
                                                <i class="bx bx-power-off me-2"></i>
                                                @(x.Status ? "Ngưng hoạt động" : "Mở hoạt động")
                                            </button>
                                        }

                                        @if (canDelete)
                                        {
                                            <div class="dropdown-divider"></div>
                                            <button type="button"
                                                    class="dropdown-item text-danger js-delete"
                                                    data-id="@x.Id"
                                                    data-name="@x.Name">
                                                <i class="bx bx-trash me-2"></i> Xóa
                                            </button>
                                        }

                                        @if (!canUpdate && !canDelete)
                                        {
                                            <span class="dropdown-item text-muted">
                                                Không có quyền thao tác
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <div class="sp-pagination mt-3">
        <div class="text-muted">
            Trang <b>@currentPage</b> / <b>@totalPages</b>
        </div>

        <nav>
            <ul class="pagination mb-0">
                @{
                    var start = Math.Max(1, currentPage - 3);
                    var end = Math.Min(totalPages, start + 6);
                    start = Math.Max(1, end - 6);
                }

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a href="#" class="page-link js-page-link" data-page="@(currentPage - 1)">
                        <i class="bx bx-chevron-left"></i>
                    </a>
                </li>

                @for (int p = start; p <= end; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a href="#" class="page-link js-page-link" data-page="@p">@p</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a href="#" class="page-link js-page-link" data-page="@(currentPage + 1)">
                        <i class="bx bx-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}