@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Không có quyền truy cập</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/assets/vendor/css/core.css" rel="stylesheet" />
    <link href="~/assets/vendor/css/theme-default.css" rel="stylesheet" />
    <link href="~/assets/vendor/fonts/boxicons.css" rel="stylesheet" />
</head>

<body>
    <div class="container-xxl container-p-y">
        <div class="text-center" style="max-width: 720px; margin: 90px auto;">
            <div class="mb-4">
                <i class="bx bx-lock-alt text-warning" style="font-size: 90px;"></i>
            </div>

            <h1 class="mb-2" style="font-size: 72px; font-weight: 700;">
                403
            </h1>

            <h4 class="mb-2">
                Bạn không có quyền truy cập
            </h4>

            <p class="text-muted mb-4">
                Tài khoản hiện tại không được phép sử dụng chức năng này.
            </p>

            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <div class="alert alert-warning text-start">
                    <strong>Chức năng bị chặn:</strong>
                    <br />
                    <code>@returnUrl</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a href="/admin/pos-shift" class="btn btn-primary">
                    <i class="bx bx-home-alt me-1"></i>
                    Về trang chính
                </a>

                <a href="/admin/account/login" class="btn btn-outline-secondary">
                    <i class="bx bx-log-in me-1"></i>
                    Đăng nhập lại
                </a>

                <a href="javascript:history.back()" class="btn btn-label-secondary">
                    <i class="bx bx-arrow-back me-1"></i>
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</body>
</html>