@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
    var blockedPath = returnUrl?.Split('?', '#')[0].TrimEnd('/');
    var isDashboard = string.Equals(blockedPath, "/admin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(blockedPath, "/admin/home", StringComparison.OrdinalIgnoreCase)
        || string.Equals(blockedPath, "/admin/dashboard", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Không có quyền truy cập</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link href="~/vendor/css/core.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/vendor/fonts/iconify-icons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/demo.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Admin/css/gaoapp.mobile-account-states.css" rel="stylesheet" asp-append-version="true" />
</head>

<body data-mobile-state-document="true">
    <div class="container-xxl container-p-y" data-mobile-state-page="access-denied">
        <div class="text-center" style="max-width: 720px; margin: 90px auto;" data-mobile-state-card>
            <div class="mb-4" data-mobile-state-symbol>
                <i class="icon-base bx bx-lock-alt text-warning" style="font-size: 90px;" aria-hidden="true"></i>
            </div>

            <h1 class="mb-2" style="font-size: 72px; font-weight: 700;" data-mobile-state-code>
                403
            </h1>

            <h4 class="mb-2">
                Bạn không có quyền truy cập
            </h4>

            <p class="text-muted mb-4" data-mobile-state-message>
                Tài khoản hiện tại không được phép sử dụng chức năng này.
            </p>

            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <div class="alert alert-warning text-start" data-mobile-state-detail>
                    <strong>Chức năng bị chặn:</strong>
                    <br />
                    @if (isDashboard)
                    {
                        <div class="fw-semibold">Trang tổng quan quản trị (GaoApp Dashboard)</div>
                        <div>Tài khoản cần được cấp quyền “Xem trang tổng quan quản trị” để mở trang này.</div>
                    }
                    <code>@returnUrl</code>
                </div>
            }

            <p class="gao-mobile-state-help">Liên hệ quản lý cửa hàng nếu bạn cần được cấp quyền sử dụng chức năng này.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap" data-mobile-state-actions>
                <a href="/admin/pos-shift" class="btn btn-primary">
                    <i class="icon-base bx bx-home-alt me-1" aria-hidden="true"></i>
                    Về trang chính
                </a>

                <a href="/admin/account/login" class="btn btn-outline-secondary">
                    <i class="icon-base bx bx-log-in me-1" aria-hidden="true"></i>
                    Đăng nhập lại
                </a>

                <a href="#" data-csp-action="back" class="btn btn-label-secondary">
                    <i class="icon-base bx bx-arrow-back me-1" aria-hidden="true"></i>
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</body>
</html>
