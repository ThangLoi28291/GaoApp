@model GaoApp.Web.Areas.Admin.ViewModels.Account.LoginVm
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";

    var storeName = ViewBag.CurrentStoreName as string ?? "Chưa xác định cửa hàng";
    var terminalName = ViewBag.CurrentTerminalName as string ?? "Chưa xác định terminal";
    var terminalCode = ViewBag.CurrentTerminalCode as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            :root {
                --brand-1: #1d4ed8;
                --brand-2: #1e40af;
                --ink: #0f172a;
                --muted: #64748b;
                --line: #e2e8f0;
                --bg: #f8fafc;
                --soft: #f8fbff;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                background: radial-gradient(circle at top left, rgba(37, 99, 235, .10), transparent 30%), radial-gradient(circle at bottom right, rgba(30, 64, 175, .08), transparent 35%), linear-gradient(135deg, #f8fafc, #eef2f7);
                font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
                color: var(--ink);
            }

            .login-page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .login-shell {
                width: 100%;
                max-width: 1100px;
                background: #fff;
                border-radius: 30px;
                overflow: hidden;
                box-shadow: 0 30px 100px rgba(15, 23, 42, .12);
            }

            .login-side {
                background: linear-gradient(160deg, #1d4ed8, #1e3a8a);
                color: #fff;
                min-height: 700px;
                padding: 44px 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .brand-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                width: fit-content;
                padding: 8px 14px;
                border-radius: 999px;
                background: rgba(255,255,255,.12);
                border: 1px solid rgba(255,255,255,.16);
                font-size: 13px;
                font-weight: 800;
                letter-spacing: .02em;
            }

            .side-main {
                margin-top: 26px;
            }

            .side-title {
                font-size: 38px;
                line-height: 1.18;
                font-weight: 800;
                margin-bottom: 14px;
            }

            .side-desc {
                color: rgba(255,255,255,.86);
                line-height: 1.75;
                font-size: 15px;
                max-width: 480px;
            }

            .context-card {
                margin-top: 26px;
                padding: 18px;
                border-radius: 22px;
                background: rgba(255,255,255,.10);
                border: 1px solid rgba(255,255,255,.14);
                backdrop-filter: blur(10px);
            }

            .context-title {
                font-size: 13px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: rgba(255,255,255,.8);
                margin-bottom: 14px;
            }

            .context-grid {
                display: grid;
                gap: 12px;
            }

            .context-item {
                padding: 14px 16px;
                border-radius: 16px;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.12);
            }

            .context-label {
                font-size: 12px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: rgba(255,255,255,.72);
                margin-bottom: 6px;
            }

            .context-value {
                font-size: 22px;
                font-weight: 800;
                line-height: 1.3;
                color: #fff;
                word-break: break-word;
            }

            .context-sub {
                margin-top: 5px;
                font-size: 13px;
                color: rgba(255,255,255,.78);
                font-weight: 600;
            }

            .side-footer {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                margin-top: 28px;
            }

            .side-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 9px 14px;
                border-radius: 999px;
                background: rgba(255,255,255,.10);
                border: 1px solid rgba(255,255,255,.14);
                color: rgba(255,255,255,.92);
                font-size: 13px;
                font-weight: 700;
            }

            .login-main {
                background: #fff;
                min-height: 700px;
                padding: 48px 42px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 100%;
                max-width: 420px;
            }

            .login-title {
                font-size: 32px;
                line-height: 1.2;
                font-weight: 800;
                color: var(--ink);
                margin-bottom: 8px;
            }

            .login-subtitle {
                color: var(--muted);
                line-height: 1.7;
                margin-bottom: 24px;
                font-size: 15px;
            }

            .login-context-mini {
                display: none;
                margin-bottom: 20px;
                padding: 14px 16px;
                border-radius: 18px;
                border: 1px solid var(--line);
                background: var(--soft);
            }

                .login-context-mini .mini-row + .mini-row {
                    margin-top: 10px;
                }

                .login-context-mini .mini-label {
                    font-size: 12px;
                    font-weight: 800;
                    text-transform: uppercase;
                    color: #667085;
                    letter-spacing: .05em;
                    margin-bottom: 4px;
                }

                .login-context-mini .mini-value {
                    font-size: 16px;
                    font-weight: 800;
                    color: #111827;
                    line-height: 1.4;
                }

            .form-label {
                font-weight: 800;
                color: #1e293b;
                margin-bottom: 8px;
            }

            .form-control {
                min-height: 54px;
                border-radius: 16px;
                border: 1px solid #dbe2ea;
                padding-left: 16px;
                font-size: 15px;
                box-shadow: none !important;
            }

                .form-control:focus {
                    border-color: var(--brand-1);
                    box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12) !important;
                }

            .btn-login {
                min-height: 56px;
                border: none;
                border-radius: 16px;
                font-weight: 800;
                background: linear-gradient(145deg, var(--brand-1), var(--brand-2));
                color: #fff;
                margin-top: 8px;
                box-shadow: 0 18px 30px rgba(37, 99, 235, .18);
            }

                .btn-login:hover {
                    color: #fff;
                    opacity: .97;
                }

            .login-note {
                margin-top: 14px;
                font-size: 13px;
                color: var(--muted);
                text-align: center;
            }

            .validation-summary-errors,
            .text-danger.validation-summary-errors {
                background: #fef2f2;
                border: 1px solid #fecaca;
                color: #b91c1c !important;
                padding: 12px 14px;
                border-radius: 14px;
                font-size: 13px;
                margin-bottom: 16px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 18px;
                }

            @@media (max-width: 991.98px) {
                .login-side {
                    min-height: auto;
                    padding: 32px 24px;
                }

                .login-main {
                    min-height: auto;
                    padding: 34px 22px;
                }

                .side-title {
                    font-size: 30px;
                }

                .login-context-mini {
                    display: block;
                }
            }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-shell row g-0">
            <div class="col-lg-6">
                <div class="login-side">
                    <div>
                        <div class="brand-badge">
                            <span>GaoApp / GaoMart</span>
                        </div>

                        <div class="side-main">
                            <div class="side-title">
                                Đăng nhập vận hành POS
                            </div>

                            <div class="side-desc">
                                Truy cập nhanh vào màn hình bán hàng, mở ca và quản lý thu ngân theo đúng quầy làm việc.
                            </div>

                            <div class="context-card">
                                <div class="context-title">Môi trường làm việc hiện tại</div>

                                <div class="context-grid">
                                    <div class="context-item">
                                        <div class="context-label">Store</div>
                                        <div class="context-value">@storeName</div>
                                    </div>

                                    <div class="context-item">
                                        <div class="context-label">Terminal</div>
                                        <div class="context-value">@terminalName</div>
                                        @if (!string.IsNullOrWhiteSpace(terminalCode))
                                        {
                                            <div class="context-sub">@terminalCode</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="side-footer">
                        <div class="side-pill">
                            <span>POS</span>
                        </div>
                        <div class="side-pill">
                            <span>Shift</span>
                        </div>
                        <div class="side-pill">
                            <span>Cash Drawer</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="login-main">
                    <div class="login-card">
                        <div class="login-title">Đăng nhập hệ thống</div>
                        <div class="login-subtitle">
                            Nhập tài khoản để tiếp tục làm việc.
                        </div>

                        <div class="login-context-mini">
                            <div class="mini-row">
                                <div class="mini-label">Store</div>
                                <div class="mini-value">@storeName</div>
                            </div>
                            <div class="mini-row">
                                <div class="mini-label">Terminal</div>
                                <div class="mini-value">
                                    @terminalName
                                    @if (!string.IsNullOrWhiteSpace(terminalCode))
                                    {
                                        <span class="text-muted">· @terminalCode</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">Tên đăng nhập</label>
                                <input asp-for="UserName" class="form-control" placeholder="Nhập tài khoản..." autocomplete="username" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Mật khẩu</label>
                                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-login w-100">
                                Đăng nhập
                            </button>

                            <div class="login-note">
                                Đăng nhập đúng tài khoản để bắt đầu ca làm việc.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>