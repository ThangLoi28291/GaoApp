@model GaoApp.Web.Areas.Admin.ViewModels.Account.LoginVm
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập POS";

    var storeName = ViewBag.CurrentStoreName as string ?? "Chưa xác định cửa hàng";
    var terminalName = ViewBag.CurrentTerminalName as string ?? "Chưa xác định terminal";
    var terminalCode = ViewBag.CurrentTerminalCode as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>
    <script src="~/Admin/js/pos/pos.offline.privacy.js" asp-append-version="true" defer></script>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/Admin/css/account-login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Admin/css/account-login.mobile.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="login-halloween" data-mobile-login>
    <svg class="login-icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <symbol id="login-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></symbol>
            <symbol id="login-moon" viewBox="0 0 24 24"><path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a9 9 0 1 0 11 11Z" /></symbol>
            <symbol id="login-flashlight" viewBox="0 0 24 24"><path d="M8 3h8v4l-2 3v10H10V10L8 7Z" /><path d="M8 7h8m-6 6h4" /></symbol>
        </defs>
    </svg>
    <main class="login-page" id="loginHalloween" data-mode="night"
          data-halloween-atlas="@Url.Content("~/Admin/img/login-halloween/sprites-v1.webp")">
        <div class="halloween-backdrop" aria-hidden="true"></div>
        <div class="halloween-dawn" aria-hidden="true"></div>
        <canvas class="halloween-atmosphere" aria-hidden="true"></canvas>
        <section class="login-shell">
            <div class="gao-login-mobile-brand" aria-label="GaoApp POS"><span aria-hidden="true">G</span><div><strong>GaoApp</strong><span>Không gian làm việc của cửa hàng</span></div></div>

            <aside class="login-brand">
                <div class="halloween-brand-scene" aria-hidden="true"></div>
                <div class="halloween-moon" aria-hidden="true"></div>
                <div class="halloween-cloud halloween-sprite" aria-hidden="true"></div>
                <div class="halloween-cloud halloween-cloud-second halloween-sprite" aria-hidden="true"></div>
                <div class="halloween-wolf halloween-sprite" aria-hidden="true"></div>
                <div class="halloween-bat halloween-sprite" aria-hidden="true"></div>
                <div class="halloween-bat halloween-bat-second halloween-sprite" aria-hidden="true"></div>
                <div class="login-theme-switch" role="group" aria-label="Cảnh ngày và đêm">
                    <button type="button" data-login-theme="day" aria-label="Chuyển sang ban ngày" aria-pressed="false"><svg aria-hidden="true"><use href="#login-sun" /></svg></button>
                    <button type="button" data-login-theme="night" aria-label="Chuyển sang ban đêm" aria-pressed="true"><svg aria-hidden="true"><use href="#login-moon" /></svg></button>
                </div>
                <div class="brand-top">
                    <div class="brand-logo">G</div>
                    <div>
                        <div class="brand-name">GaoApp POS</div>
                        <div class="brand-sub">Bán hàng · Thu ngân · Mở ca</div>
                    </div>
                </div>

                <div class="store-card">
                    <div class="store-label">Cửa hàng hiện tại</div>
                    <div class="store-name">@storeName</div>

                    <div class="terminal-box">
                        <span>@terminalName</span>
                        @if (!string.IsNullOrWhiteSpace(terminalCode))
                        {
                            <strong>@terminalCode</strong>
                        }
                    </div>
                </div>

                <div class="brand-footer">
                    <span>POS</span>
                    <span>Shift</span>
                    <span>Realtime</span>
                </div>
            </aside>

            <section class="login-panel">
                <div class="login-card">
                    <div class="mobile-store">
                        <span class="gao-login-mobile-context-label">Cửa hàng &amp; máy POS</span>
                        <strong>@storeName</strong>
                        <span>
                            @terminalName
                            @if (!string.IsNullOrWhiteSpace(terminalCode))
                            {
                                <text> · @terminalCode</text>
                            }
                        </span>
                    </div>

                    <div class="login-title" role="heading" aria-level="1">@(Model.ManageTerminals ? "Quản lý máy POS" : "Đăng nhập")</div>

                    @if (TempData["PasswordChanged"] is string passwordChanged)
                    {
                        <div class="alert alert-success" role="status">@passwordChanged</div>
                    }

                    @if (Model.ManageTerminals)
                    {
                        <div class="login-desc">Đăng nhập bằng tài khoản admin của cửa hàng để tạo máy POS và cấp khóa thiết bị. Không cần ghép POS trước.</div>
                    }
                    else if (Model.RequireTerminalPairing)
                    {
                        <div class="login-desc">
                            Thiết bị này chưa được ghép máy POS. Chọn máy POS rồi đăng nhập để tiếp tục.
                        </div>
                    }
                    else
                    {
                        <div class="login-desc">
                            Nhập tài khoản để bắt đầu ca làm việc.
                        </div>
                    }

                    <form method="post"
                          asp-area="Admin"
                          asp-controller="Account"
                          asp-action="Login"
                          id="loginForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="ManageTerminals" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" id="loginValidationSummary" role="alert" tabindex="-1"></div>

                        @if (Model.RequireTerminalPairing && !Model.ManageTerminals)
                        {
                            <div class="alert alert-warning mb-3">
                                <strong>Thiết bị chưa được ghép POS.</strong><br />
                                Vui lòng chọn máy POS để ghép thiết bị này.
                            </div>

                            <div class="form-group">
                                <label asp-for="PairingKey">Khóa máy do admin cấp</label>
                                <input asp-for="PairingKey" class="form-control" autocomplete="off" spellcheck="false"
                                       placeholder="Dán khóa máy nếu đã được cấp" />
                                <span asp-validation-for="PairingKey" class="text-danger small"></span>
                                <div class="form-text">Có khóa máy thì không cần chọn máy POS bên dưới.</div>
                            </div>

                            <div class="form-group">
                                <label asp-for="SelectedTerminalId">Máy POS</label>

                                <select asp-for="SelectedTerminalId"
                                        class="form-select">
                                    <option value="">-- Chọn máy POS --</option>

                                    @foreach (var terminal in Model.AvailableTerminals)
                                    {
                                        <option value="@terminal.Id">
                                            @terminal.Code - @terminal.Name
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="SelectedTerminalId" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DeviceName">Tên thiết bị</label>

                                <input asp-for="DeviceName"
                                       class="form-control"
                                       placeholder="Ví dụ: PC Thu Ngân 1, iPad Quầy 1..." />

                                <span asp-validation-for="DeviceName" class="text-danger small"></span>
                            </div>
                        }

                        <div class="form-group login-username-group">
                            <label asp-for="UserName">Tên đăng nhập</label>
                            <div class="halloween-owl halloween-sprite" aria-hidden="true">
                                <span class="owl-pupil owl-pupil-left"></span><span class="owl-pupil owl-pupil-right"></span>
                            </div>
                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Nhập tài khoản..."
                                   autocomplete="username"
                                   autocapitalize="none" spellcheck="false" enterkeyhint="next"
                                   autofocus />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Mật khẩu</label>

                            <div class="password-wrap">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu..."
                                       autocomplete="current-password"
                                       enterkeyhint="go"
                                       id="PasswordInput" />
                                <div class="password-light-reveal" aria-hidden="true"><span></span></div>

                                <button type="button" id="btnTogglePassword" class="btn-eye" aria-label="Bật đèn pin để xem mật khẩu" aria-pressed="false" aria-controls="PasswordInput">
                                    <span class="btn-eye-label">Hiện</span>
                                    <svg class="login-flashlight" aria-hidden="true"><use href="#login-flashlight" /></svg>
                                </button>
                            </div>

                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn-login" id="btnLogin">
                            @if (Model.ManageTerminals)
                            {
                                <text>Đăng nhập quản lý POS</text>
                            }
                            else if (Model.RequireTerminalPairing)
                            {
                                <text>Ghép POS và đăng nhập</text>
                            }
                            else
                            {
                                <text>Đăng nhập</text>
                            }
                        </button>
                    </form>
                    <div class="login-management-link">
                        @if (Model.ManageTerminals)
                        {
                            <a href="/admin/account/login">← Quay lại đăng nhập bán hàng</a>
                        }
                        else
                        {
                            <a href="/admin/account/login?manageTerminals=true">Quản lý máy POS · Dành cho admin</a>
                        }
                    </div>
                </div>
            </section>

        </section>
        <canvas class="halloween-effects" aria-hidden="true"></canvas>
        <div class="halloween-props" aria-hidden="true">
            <div class="halloween-pumpkin halloween-pumpkin-tl halloween-sprite"></div>
            <div class="halloween-pumpkin halloween-pumpkin-tr halloween-sprite"></div>
            <div class="halloween-pumpkin halloween-pumpkin-bl halloween-sprite"></div>
            <div class="halloween-pumpkin halloween-pumpkin-br halloween-sprite"></div>
            <div class="halloween-lantern halloween-lantern-left"><div class="halloween-sprite"></div></div>
            <div class="halloween-lantern halloween-lantern-right"><div class="halloween-sprite"></div></div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/Admin/js/account-login.js" asp-append-version="true"></script>
    <script src="~/Admin/js/account-login.mobile.js" asp-append-version="true"></script>
</body>
</html>
