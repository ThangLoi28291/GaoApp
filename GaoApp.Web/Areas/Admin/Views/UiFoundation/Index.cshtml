            <div class="gds-dialog__header"><div><p class="gds-eyebrow">BÁN HÀNG · BẢN MẪU</p><h2 id="ui-pos-title">Giỏ hàng</h2></div><button type="button" class="gds-button gds-button--quiet gds-button--icon" data-gao-dialog-close aria-label="Đóng bán hàng mẫu"><svg class="gds-icon" aria-hidden="true"><use href="#ui-close" /></svg></button></div>
            <div class="gds-dialog__body"><dl class="gds-detail-list"><div><dt>Gạo ST25 · bao 5 kg<br /><span class="gds-muted">2 bao × 185.000 ₫</span></dt><dd>370.000 ₫</dd></div><div><dt>Gạo thơm · bao 10 kg<br /><span class="gds-muted">1 bao × 270.000 ₫</span></dt><dd>270.000 ₫</dd></div></dl><p class="gds-notice ui-preview__detail-note">Giỏ minh họa có 2 dòng hàng. Các thao tác trên trang chưa tạo đơn hoặc thu tiền.</p></div>
            <div class="gds-action-dock"><div class="gds-action-dock__summary"><span class="gds-muted">Tổng giá trị mẫu</span><br /><strong class="gds-amount">640.000 ₫</strong></div><button type="button" class="gds-button gds-button--primary" data-gao-dialog-close>Đã xem mẫu</button></div>
        </div>
    </dialog>
    <dialog id="ui-navigation-dialog" class="gds-dialog gds-dialog--sheet" aria-labelledby="ui-navigation-title">
        <div class="gds-dialog__frame">
            <div class="gds-dialog__header"><h2 id="ui-navigation-title">Menu</h2><button type="button" class="gds-button gds-button--quiet gds-button--icon" data-gao-dialog-close aria-label="Đóng menu mẫu"><svg class="gds-icon" aria-hidden="true"><use href="#ui-close" /></svg></button></div>
            <div class="gds-dialog__body">
                <p class="gds-muted">Mở nhanh các khu vực trong bản xem thử.</p>
                <div class="ui-preview__menu-grid">
                    @foreach (var item in navigation.Items)
                    {
                        <button type="button" class="gds-button ui-preview__menu-entry" data-preview-menu-go="@item.Key"><svg class="gds-icon" aria-hidden="true"><use href="#@item.IconId" /></svg><span>@item.Label</span><svg class="gds-icon" aria-hidden="true"><use href="#ui-arrow" /></svg></button>
                    }
                </div>
                <p class="ui-preview__sample-note ui-preview__detail-note">Đây là cấu hình minh họa. Menu sử dụng thực tế sẽ lấy từ cấu hình cửa hàng và quyền truy cập.</p>
            </div>
        </div>
    </dialog>
    @await Html.PartialAsync("Commerce/_BottomNavigation", navigation)
    <p class="ui-preview__toast" role="status" data-preview-toast hidden></p>
</div>
