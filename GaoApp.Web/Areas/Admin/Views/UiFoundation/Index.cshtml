                <progress class="ui-preview__progress" value="3" max="8" aria-label="Đã kiểm 3 trên 8 dòng hàng">3/8</progress>
                <dl class="gds-detail-list ui-preview__detail-note"><div><dt>Gạo ST25 · bao 5 kg</dt><dd>Đã kiểm 12 bao</dd></div><div><dt>Gạo thơm · bao 10 kg</dt><dd>Đã kiểm 6 bao</dd></div><div><dt>Nếp sáp · bao 5 kg</dt><dd>Đã kiểm 4 bao</dd></div></dl>
