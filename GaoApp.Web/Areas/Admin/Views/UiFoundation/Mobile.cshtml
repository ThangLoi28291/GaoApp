@using System.Text.Json
@model GaoApp.Web.Areas.Admin.ViewModels.Commerce.MobilePreview
@{
    Layout = "_CommerceMobileLayout";
}
<div class="m2" data-gao-ui="modern" data-gao-theme="commerce" data-mobile-v2>
    <a href="#m2-content" class="m2-skip">Đến nội dung chính</a>
    <svg class="m2-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="m2-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8" /></symbol>
        <symbol id="m2-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Zm3 5h6m-6 4h6" /></symbol>
        <symbol id="m2-box" viewBox="0 0 24 24"><path d="m3 7 9-5 9 5v10l-9 5-9-5V7Zm0 0 9 5 9-5m-9 5v10M8 4l9 5" /></symbol>
        <symbol id="m2-bag" viewBox="0 0 24 24"><path d="M5 7h14l1 14H4L5 7Zm3 0V5a4 4 0 0 1 8 0v2m-8 4a4 4 0 0 0 8 0" /></symbol>
        <symbol id="m2-menu" viewBox="0 0 24 24"><path d="M5 6h14M5 12h14M5 18h14" /></symbol>
        <symbol id="m2-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></symbol>
        <symbol id="m2-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></symbol>
        <symbol id="m2-arrow" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></symbol>
        <symbol id="m2-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="m2-minus" viewBox="0 0 24 24"><path d="M5 12h14" /></symbol>
        <symbol id="m2-close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6" /></symbol>
        <symbol id="m2-filter-icon" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4" /></symbol>
        <symbol id="m2-scan" viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5M7 7v10m4-10v10m3-10v10m3-10v10" /></symbol>
        <symbol id="m2-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
        <symbol id="m2-wallet" viewBox="0 0 24 24"><path d="M20 7H5a3 3 0 0 1 0-6h13v6M3 4v15a2 2 0 0 0 2 2h15V7m0 5h-6v5h6M17 14.5h.01" /></symbol>
        <symbol id="m2-chart" viewBox="0 0 24 24"><path d="M4 3v18h17M8 16v-5m5 5V6m5 10v-7" /></symbol>
        <symbol id="m2-truck" viewBox="0 0 24 24"><path d="M3 5h11v12H3V5Zm11 4h4l3 4v4h-7m-8 0h3m8 0h2" /><circle cx="7" cy="18" r="2" /><circle cx="18" cy="18" r="2" /></symbol>
        <symbol id="m2-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
        <symbol id="m2-person" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></symbol>
        <symbol id="m2-settings" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16" /><circle cx="9" cy="7" r="3" /><circle cx="15" cy="17" r="3" /></symbol>
        <symbol id="m2-rice" viewBox="0 0 64 80"><path d="M17 8h30l-3 12 9 44c1 7-5 10-21 10S10 71 11 64l9-44-3-12Z" /><path d="M20 20h24M17 8c8 3 22 3 30 0" /><path d="M32 34v24m0-16c-8 0-10-7-10-7 8 0 10 7 10 7Zm0 9c8 0 10-7 10-7-8 0-10 7-10 7Z" /></symbol>
    </svg>
    <header class="m2-appbar">
        <div class="m2-brand"><span class="m2-brand-mark" aria-hidden="true">g<span>•</span></span><div><span class="m2-brand-label">GAOAPP <span class="m2-demo-tag">DEMO</span></span><strong>@Model.Store</strong></div></div>
        <div class="m2-appbar-actions"><button type="button" class="m2-icon-button" data-m2-search aria-label="Tìm đơn hàng"><svg class="m2-icon" aria-hidden="true"><use href="#m2-search" /></svg></button><button type="button" class="m2-icon-button m2-notification-button" data-gao-dialog-open="m2-notifications" aria-label="Thông báo, 2 mục cần chú ý"><svg class="m2-icon" aria-hidden="true"><use href="#m2-bell" /></svg><span aria-hidden="true"></span></button></div>
    </header>
    <main id="m2-content" class="m2-content" tabindex="-1">
        <section class="m2-screen" data-m2-screen="home" aria-labelledby="m2-home-title">
            <div class="m2-page-heading"><div><p class="m2-kicker">CHỦ NHẬT, 25 THÁNG 10</p><h1 id="m2-home-title" tabindex="-1">Cửa hàng hôm nay</h1></div><span class="m2-avatar m2-avatar--profile" aria-label="Minh Anh">MA</span></div>
            <section class="m2-summary" aria-label="Tóm tắt giá trị đơn mẫu hôm nay">
                <div class="m2-summary-top"><span>Giá trị đơn hôm nay</span><svg class="m2-icon" aria-hidden="true"><use href="#m2-chart" /></svg></div>
                <strong class="m2-summary-value" data-m2-total>19.530.000 <small>₫</small></strong>
                <span class="m2-summary-note"><span class="m2-live-dot" aria-hidden="true"></span>4 đơn hàng · Dữ liệu minh họa</span>
                <div class="m2-summary-bottom"><div><span>Đã thu</span><strong data-m2-paid>16.160.000 ₫</strong></div><div><span>Chờ thu</span><strong data-m2-unpaid>3.370.000 ₫</strong></div></div>
            </section>
            <div class="m2-quick-actions"><button type="button" class="m2-button m2-button--primary" data-m2-go="pos"><svg class="m2-icon" aria-hidden="true"><use href="#m2-plus" /></svg>Bán hàng</button><button type="button" class="m2-button" data-gao-dialog-open="m2-scanner"><svg class="m2-icon" aria-hidden="true"><use href="#m2-scan" /></svg>Tra mã hàng</button></div>
            <div class="m2-section-heading"><h2>Cần xử lý</h2><span class="m2-subtle">2 việc</span></div>
            <div class="m2-task-group">
                <button type="button" class="m2-task" data-m2-unpaid-orders><span class="m2-task-icon m2-tone-amber"><svg class="m2-icon" aria-hidden="true"><use href="#m2-wallet" /></svg></span><span class="m2-task-copy"><strong>2 đơn đang chờ thu</strong><span>Tổng còn lại 3.370.000 ₫</span></span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button>
                <button type="button" class="m2-task" data-m2-go="receiving"><span class="m2-task-icon m2-tone-blue"><svg class="m2-icon" aria-hidden="true"><use href="#m2-box" /></svg></span><span class="m2-task-copy"><strong>Tiếp tục nhận hàng</strong><span>NH-0284 · <span data-m2-receiving-short>Đã kiểm 3/8 dòng</span></span></span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button>
            </div>
            <div class="m2-section-heading"><h2>Đơn gần đây</h2><button type="button" class="m2-text-button" data-m2-all-orders>Xem tất cả<svg class="m2-icon" aria-hidden="true"><use href="#m2-arrow" /></svg></button></div>
            <div class="m2-order-group" data-m2-recent></div>
            <p class="m2-demo-note">Bản xem thử · Thao tác chỉ thay đổi dữ liệu mẫu trên màn hình.</p>
        </section>
        <section class="m2-screen" data-m2-screen="orders" aria-labelledby="m2-orders-title" hidden>
            <div class="m2-page-heading"><div><p class="m2-kicker">BÁN HÀNG</p><h1 id="m2-orders-title" tabindex="-1">Đơn hàng</h1></div><button type="button" class="m2-icon-button m2-icon-button--primary" data-m2-go="pos" aria-label="Tạo đơn hàng mẫu"><svg class="m2-icon" aria-hidden="true"><use href="#m2-plus" /></svg></button></div>
            <div class="m2-search-row"><label class="m2-search"><svg class="m2-icon" aria-hidden="true"><use href="#m2-search" /></svg><input id="m2-order-search" type="search" autocomplete="off" placeholder="Tên khách, mã đơn…" aria-label="Tìm tên khách hoặc mã đơn" /></label><button type="button" class="m2-icon-button m2-filter-button" data-gao-dialog-open="m2-filter" aria-label="Bộ lọc đơn hàng"><svg class="m2-icon" aria-hidden="true"><use href="#m2-filter-icon" /></svg><span data-m2-filter-dot hidden></span></button></div>
            <div class="m2-tabs" role="group" aria-label="Trạng thái đơn hàng"><button type="button" data-m2-filter="all" aria-pressed="true">Tất cả <span>4</span></button><button type="button" data-m2-filter="unpaid" aria-pressed="false">Chờ thu <span>2</span></button><button type="button" data-m2-filter="shipping" aria-pressed="false">Đang giao <span>1</span></button><button type="button" data-m2-filter="completed" aria-pressed="false">Hoàn tất <span>1</span></button></div>
            <div class="m2-list-caption"><span>Hôm nay · 25/10/2026</span><span data-m2-order-count role="status">4 đơn hàng</span></div>
            <div class="m2-order-group" data-m2-orders></div>
            <div class="m2-empty" data-m2-order-empty hidden><svg class="m2-icon" aria-hidden="true"><use href="#m2-search" /></svg><h2>Chưa tìm thấy đơn</h2><p>Thử tên khách hoặc mã đơn khác.</p><button type="button" class="m2-button" data-m2-reset-orders>Đặt lại tìm kiếm</button></div>
        </section>
        <section class="m2-screen" data-m2-screen="receiving" aria-labelledby="m2-receiving-title" hidden>
            <div class="m2-page-heading"><div><p class="m2-kicker">HÀNG HÓA & KHO</p><h1 id="m2-receiving-title" tabindex="-1">Nhập hàng</h1></div><span class="m2-count-pill">1 phiếu</span></div>
            <div class="m2-receipt-card"><div class="m2-receipt-card-top"><span class="m2-document-icon m2-tone-blue"><svg class="m2-icon" aria-hidden="true"><use href="#m2-box" /></svg></span><div><h2>NH-0284</h2><p>Nhà cung cấp Minh Phát</p></div><span class="m2-status m2-status--info">Đang nhận</span></div><div class="m2-progress-label"><span>Tiến độ kiểm hàng</span><strong data-m2-receiving-progress>3/8 dòng</strong></div><progress class="m2-progress" value="3" max="8" data-m2-progress aria-label="Tiến độ kiểm từng dòng hàng">3/8</progress><p class="m2-receipt-tip">Kiểm theo từng quy cách, xác nhận số lượng thực nhận.</p></div>
            <div class="m2-section-heading"><h2>Hàng trong phiếu</h2><span class="m2-subtle">8 dòng</span></div>
            <div class="m2-receiving-group" data-m2-receiving-lines></div>
            <p class="m2-demo-note">Phiếu minh họa. Số lượng kiểm thử không ghi vào kho.</p>
        </section>
        <section class="m2-screen" data-m2-screen="pos" aria-labelledby="m2-pos-title" hidden>
            <div class="m2-page-heading"><div><p class="m2-kicker">TẠO ĐƠN MỚI</p><h1 id="m2-pos-title" tabindex="-1">Bán hàng</h1></div><button type="button" class="m2-icon-button" data-gao-dialog-open="m2-scanner" aria-label="Tra sản phẩm bằng mã"><svg class="m2-icon" aria-hidden="true"><use href="#m2-scan" /></svg></button></div>
            <label class="m2-search"><svg class="m2-icon" aria-hidden="true"><use href="#m2-search" /></svg><input id="m2-product-search" type="search" autocomplete="off" placeholder="Tìm sản phẩm…" aria-label="Tìm sản phẩm bán hàng" /></label>
            <div class="m2-tabs" role="group" aria-label="Nhóm sản phẩm"><button type="button" data-m2-category="all" aria-pressed="true">Tất cả</button><button type="button" data-m2-category="rice" aria-pressed="false">Gạo</button><button type="button" data-m2-category="sticky" aria-pressed="false">Nếp</button></div>
            <div class="m2-product-grid" data-m2-products></div>
            <div class="m2-empty" data-m2-product-empty hidden><h2>Chưa thấy sản phẩm</h2><p>Thử tên hoặc mã hàng khác.</p></div>
        </section>
        <section class="m2-screen" data-m2-screen="menu" aria-labelledby="m2-menu-title" hidden>
            <div class="m2-page-heading"><div><p class="m2-kicker">KHÔNG GIAN CỦA BẠN</p><h1 id="m2-menu-title" tabindex="-1">Menu</h1></div><span class="m2-version-pill">Bản mới</span></div>
            <div class="m2-profile-card"><span class="m2-avatar m2-avatar--profile">MA</span><div><h2>Minh Anh</h2><p>Quản lý cửa hàng · Tài khoản mẫu</p></div><span class="m2-profile-check" aria-label="Tài khoản minh họa"><svg class="m2-icon" aria-hidden="true"><use href="#m2-check" /></svg></span></div>
            <p class="m2-menu-label">CỬA HÀNG</p>
            <div class="m2-menu-group"><button type="button" class="m2-menu-row" data-m2-go="orders"><span class="m2-task-icon m2-tone-blue"><svg class="m2-icon" aria-hidden="true"><use href="#m2-receipt" /></svg></span><span>Đơn hàng</span><span class="m2-subtle">4</span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button><button type="button" class="m2-menu-row" data-m2-go="receiving"><span class="m2-task-icon m2-tone-teal"><svg class="m2-icon" aria-hidden="true"><use href="#m2-box" /></svg></span><span>Nhập hàng</span><span class="m2-subtle">1 phiếu</span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button><button type="button" class="m2-menu-row" data-m2-go="pos"><span class="m2-task-icon m2-tone-violet"><svg class="m2-icon" aria-hidden="true"><use href="#m2-bag" /></svg></span><span>Bán hàng</span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button></div>
            <p class="m2-menu-label">THEO DÕI & TÙY CHỈNH</p>
            <div class="m2-menu-group"><button type="button" class="m2-menu-row" data-gao-dialog-open="m2-report"><span class="m2-task-icon m2-tone-blue"><svg class="m2-icon" aria-hidden="true"><use href="#m2-chart" /></svg></span><span>Tổng kết hôm nay</span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button><button type="button" class="m2-menu-row" data-gao-dialog-open="m2-display"><span class="m2-task-icon m2-tone-neutral"><svg class="m2-icon" aria-hidden="true"><use href="#m2-settings" /></svg></span><span>Tùy chọn hiển thị</span><svg class="m2-icon m2-chevron" aria-hidden="true"><use href="#m2-arrow" /></svg></button></div>
            <p class="m2-demo-note">Các mục trên là cấu hình minh họa.<br />Khi áp dụng, menu lấy từ cửa hàng và quyền của bạn.</p>
        </section>
    </main>
    <div class="m2-cart-dock" data-m2-cart-dock hidden><div><span data-m2-cart-lines>0 dòng hàng</span><strong data-m2-cart-total>0 ₫</strong></div><button type="button" class="m2-button m2-button--primary" data-gao-dialog-open="m2-cart">Xem giỏ<svg class="m2-icon" aria-hidden="true"><use href="#m2-arrow" /></svg></button></div>
    <nav class="m2-nav" aria-label="Điều hướng điện thoại">
        @foreach (var item in Model.Navigation)
        {
            <button type="button" data-m2-go="@item.Key" data-m2-nav="@item.Key" aria-label="@item.Label" aria-current="@(item.Key == "home" ? "page" : null)"><span class="m2-nav-icon"><svg class="m2-icon" aria-hidden="true"><use href="#@item.IconId" /></svg></span><span>@item.Label</span></button>
        }
        <button type="button" data-m2-go="menu" data-m2-nav="menu" aria-label="Menu"><span class="m2-nav-icon"><svg class="m2-icon" aria-hidden="true"><use href="#m2-menu" /></svg></span><span>Menu</span></button>
    </nav>
    <div class="m2-toast" data-m2-toast role="status" hidden><span class="m2-toast-check" aria-hidden="true"><svg class="m2-icon"><use href="#m2-check" /></svg></span><span data-m2-toast-text></span></div>

    <dialog id="m2-order-detail" class="gds-dialog m2-sheet" aria-labelledby="m2-detail-title"><div class="m2-sheet-frame"><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><div><p class="m2-kicker">CHI TIẾT ĐƠN MẪU</p><h2 id="m2-detail-title" data-m2-detail-id>Đơn hàng</h2></div><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng chi tiết đơn"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><div class="m2-detail-hero"><span data-m2-detail-status></span><strong data-m2-detail-amount></strong></div><dl class="m2-detail-list"><div><dt>Khách hàng</dt><dd data-m2-detail-customer></dd></div><div><dt>Thời gian</dt><dd data-m2-detail-time></dd></div><div><dt>Số dòng hàng</dt><dd data-m2-detail-lines></dd></div><div><dt>Thanh toán</dt><dd data-m2-detail-payment></dd></div></dl><p class="m2-note">Dữ liệu dùng để đánh giá giao diện chi tiết trên điện thoại.</p></div><footer class="m2-sheet-footer"><button type="button" class="m2-button m2-button--primary" data-gao-dialog-close>Về danh sách</button></footer></div></dialog>
    <dialog id="m2-filter" class="gds-dialog m2-sheet" aria-labelledby="m2-filter-title"><form class="m2-sheet-frame" data-m2-filter-form><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><h2 id="m2-filter-title">Lọc đơn hàng</h2><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng bộ lọc"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><fieldset class="m2-radio-group"><legend>Trạng thái</legend><label><input type="radio" name="status" value="all" checked />Tất cả đơn hàng<span>4</span></label><label><input type="radio" name="status" value="unpaid" />Chờ thu tiền<span>2</span></label><label><input type="radio" name="status" value="paid" />Đã thanh toán<span>2</span></label><label><input type="radio" name="status" value="shipping" />Đang giao hàng<span>1</span></label><label><input type="radio" name="status" value="completed" />Hoàn tất<span>1</span></label></fieldset><label class="m2-field" for="m2-sort"><span>Sắp xếp</span><select id="m2-sort" name="sort"><option value="recent">Mới nhất trước</option><option value="amount">Giá trị cao nhất</option></select></label></div><footer class="m2-sheet-footer"><button type="button" class="m2-button" data-m2-clear-filter>Đặt lại</button><button type="submit" class="m2-button m2-button--primary">Áp dụng</button></footer></form></dialog>
    <dialog id="m2-receive-line" class="gds-dialog m2-sheet" aria-labelledby="m2-receive-title"><form class="m2-sheet-frame" data-m2-receive-form novalidate><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><div><p class="m2-kicker">KIỂM HÀNG MẪU</p><h2 id="m2-receive-title">Số lượng thực nhận</h2></div><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng kiểm hàng"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><h3 data-m2-receive-product></h3><p class="m2-subtle" data-m2-receive-expected></p><label class="m2-field" for="m2-receive-quantity"><span>Thực nhận theo quy cách</span><input id="m2-receive-quantity" type="number" inputmode="numeric" min="0" max="9999" required aria-describedby="m2-receive-error" /></label><p id="m2-receive-error" class="m2-error" hidden>Nhập số nguyên từ 0 đến 9.999.</p><p class="m2-note">Xác nhận chỉ cập nhật tiến độ minh họa, không ghi nhận tồn kho.</p></div><footer class="m2-sheet-footer"><button type="submit" class="m2-button m2-button--primary">Xác nhận dòng mẫu</button></footer></form></dialog>
    <dialog id="m2-cart" class="gds-dialog m2-sheet" aria-labelledby="m2-cart-title"><div class="m2-sheet-frame"><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><div><p class="m2-kicker">ĐƠN HÀNG MỚI</p><h2 id="m2-cart-title">Giỏ hàng</h2></div><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng giỏ hàng"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><div class="m2-cart-list" data-m2-cart-items></div><p class="m2-note" data-m2-cart-empty>Chọn sản phẩm để bắt đầu tạo giỏ hàng mẫu.</p></div><footer class="m2-sheet-footer m2-sheet-footer--cart"><div class="m2-cart-total-line"><span>Tổng giá trị</span><strong data-m2-cart-sheet-total>0 ₫</strong></div><button type="button" class="m2-button m2-button--primary" data-m2-open-payment disabled>Xem thanh toán mẫu<svg class="m2-icon" aria-hidden="true"><use href="#m2-arrow" /></svg></button></footer></div></dialog>
    <dialog id="m2-payment" class="gds-dialog m2-sheet" aria-labelledby="m2-payment-title"><form class="m2-sheet-frame" data-m2-payment-form novalidate><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><div><p class="m2-kicker">BẢN XEM THỬ</p><h2 id="m2-payment-title">Thanh toán mẫu</h2></div><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng thanh toán mẫu"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><div class="m2-payment-total"><span>Tổng cần thanh toán</span><strong data-m2-payment-total>0 ₫</strong></div><label class="m2-field" for="m2-cash"><span>Tiền khách đưa</span><input id="m2-cash" type="number" inputmode="numeric" min="0" step="1000" aria-describedby="m2-cash-error" placeholder="Nhập số tiền bằng đồng" required /></label><p id="m2-cash-error" class="m2-error" hidden>Số tiền cần lớn hơn hoặc bằng tổng giỏ hàng.</p><p class="m2-payment-change">Tiền thừa <strong data-m2-change>—</strong></p><p class="m2-note">Bản mẫu không thu tiền, không tạo đơn hay phát hành hóa đơn.</p><div class="m2-success" data-m2-payment-result role="status" hidden></div></div><footer class="m2-sheet-footer"><button type="submit" class="m2-button m2-button--primary">Kiểm tra thanh toán mẫu</button></footer></form></dialog>
    <dialog id="m2-scanner" class="gds-dialog m2-sheet" aria-labelledby="m2-scan-title"><form class="m2-sheet-frame" data-m2-scan-form><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><h2 id="m2-scan-title">Tra mã sản phẩm</h2><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng tra mã"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><div class="m2-scanner-art" aria-hidden="true"><svg class="m2-icon"><use href="#m2-scan" /></svg></div><label class="m2-field" for="m2-barcode"><span>Mã hàng trong bản mẫu</span><input id="m2-barcode" type="text" inputmode="numeric" autocomplete="off" value="893000000001" maxlength="30" /></label><p class="m2-note">Ví dụ: 893000000001 — Gạo ST25. Nhập mã để xem cách tra hàng.</p><p class="m2-error" data-m2-scan-error hidden>Chưa tìm thấy mã này trong danh mục mẫu.</p></div><footer class="m2-sheet-footer"><button type="submit" class="m2-button m2-button--primary">Tìm sản phẩm</button></footer></form></dialog>
    <dialog id="m2-notifications" class="gds-dialog m2-sheet" aria-labelledby="m2-notifications-title"><div class="m2-sheet-frame"><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><h2 id="m2-notifications-title">Cần chú ý</h2><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng thông báo"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><button type="button" class="m2-notification-row" data-m2-notification-go="orders"><span class="m2-task-icon m2-tone-amber"><svg class="m2-icon" aria-hidden="true"><use href="#m2-wallet" /></svg></span><span><strong>2 đơn cần thu tiền</strong><small>Tổng còn lại 3.370.000 ₫</small></span><svg class="m2-icon" aria-hidden="true"><use href="#m2-arrow" /></svg></button><button type="button" class="m2-notification-row" data-m2-notification-go="receiving"><span class="m2-task-icon m2-tone-blue"><svg class="m2-icon" aria-hidden="true"><use href="#m2-box" /></svg></span><span><strong>Phiếu nhập đang nhận</strong><small>NH-0284 · Minh Phát</small></span><svg class="m2-icon" aria-hidden="true"><use href="#m2-arrow" /></svg></button></div></div></dialog>
    <dialog id="m2-report" class="gds-dialog m2-sheet" aria-labelledby="m2-report-title"><div class="m2-sheet-frame"><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><h2 id="m2-report-title">Tổng kết hôm nay</h2><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng tổng kết"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><p class="m2-subtle">25/10/2026 · 4 đơn minh họa</p><dl class="m2-detail-list"><div><dt>Giá trị đơn</dt><dd>19.530.000 ₫</dd></div><div><dt>Đã thu</dt><dd>16.160.000 ₫</dd></div><div><dt>Chờ thu</dt><dd>3.370.000 ₫</dd></div></dl><p class="m2-note">Các chỉ số tính từ dữ liệu mẫu, không phải báo cáo cửa hàng thực tế.</p></div></div></dialog>
    <dialog id="m2-display" class="gds-dialog m2-sheet" aria-labelledby="m2-display-title"><div class="m2-sheet-frame"><div class="m2-sheet-handle" aria-hidden="true"></div><header class="m2-sheet-header"><h2 id="m2-display-title">Tùy chọn hiển thị</h2><button type="button" class="m2-icon-button" data-gao-dialog-close aria-label="Đóng tùy chọn hiển thị"><svg class="m2-icon" aria-hidden="true"><use href="#m2-close" /></svg></button></header><div class="m2-sheet-body"><label class="m2-toggle-row"><span><strong>Giảm chuyển động</strong><small>Chuyển màn và mở bảng nhẹ hơn</small></span><input type="checkbox" role="switch" data-m2-reduce-motion /></label><p class="m2-note">Lựa chọn chỉ dùng trong phiên xem thử này. Thiết lập giảm chuyển động của hệ thống luôn được tôn trọng.</p></div></div></dialog>
    <script type="application/json" id="m2-fixture">@Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>
