@model GaoApp.Web.Areas.Admin.Controllers.CustomerQualityPage
@{Layout="_ContentNavbarLayout";ViewData["Title"]="Chất lượng chăm sóc khách hàng";}
<link rel="stylesheet" href="~/Admin/css/customer-quality.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/Admin/css/customer-service-admin.mobile.css" asp-append-version="true" />
<main id="customerQuality" class="cq-root" data-base="@Url.Content("~/admin/customer-service/quality")" data-store="@Model.Staff.StoreId">
 @Html.AntiForgeryToken()
 <header class="cq-heading"><div><p class="cq-eyebrow">@Model.StoreName · CHĂM SÓC KHÁCH HÀNG</p><h2>Hiểu chỗ chưa đúng.<br/>Cải thiện có kiểm chứng.</h2><p>Phản hồi, xử lý và kiểm tra tìm hàng trong cùng một nơi.</p></div><nav><a href="@Url.Content("~/admin/customer-service")">Hộp thư khách</a><a href="@Url.Content("~/admin/assistant/search")">Duyệt cách gọi</a><a href="@Url.Content("~/admin/assistant/knowledge")">Chính sách cửa hàng</a></nav></header>
 <p id="cqNotice" role="status" aria-live="polite"></p>
 <form id="cqFilters" class="cq-filters"><label>Khoảng thời gian<select id="cqDays"><option value="1">1 ngày</option><option value="7" selected>7 ngày</option></select></label><label>Kênh<select id="cqSource"><option value="all">Tất cả kênh</option><option value="web">Web</option><option value="facebook">Messenger</option><option value="zalomarketing">Zalo cá nhân</option></select></label><button type="submit">Tải báo cáo</button><small>Hội thoại và phản hồi giữ tối đa @Model.RetentionDays ngày. Không có đánh giá không có nghĩa câu trả lời đúng.</small></form>
 <div id="cqMetrics" class="cq-metrics" aria-live="polite"></div><section class="cq-card"><h3>Hoạt động trong thời gian chọn</h3><div id="cqActivity" class="cq-activity"></div><p class="cq-muted">Trạng thái hội thoại và kết quả gửi là trạng thái hiện tại của dữ liệu còn lưu; số liệu thay đổi khi dữ liệu hết hạn. Tỷ lệ hữu ích chỉ từ khách đã đánh giá, không đo độ chính xác AI.</p></section>
 <section class="cq-card"><header class="cq-section-heading"><div><h3>Phản hồi cần xem</h3><p>Đối chiếu nguồn rồi mới đánh dấu xử lý. Đề xuất cách gọi vẫn cần duyệt riêng.</p></div><label>Trạng thái<select id="cqStatus"><option value="open">Chưa xử lý</option><option value="resolved">Đã xử lý / hữu ích</option><option value="all">Tất cả</option></select></label></header><div id="cqFeedback"></div><div class="cq-pages"><button id="cqPrevious" type="button">Trước</button><span id="cqPage"></span><button id="cqNext" type="button">Sau</button></div></section>
 <section class="cq-card"><header class="cq-section-heading"><div><h3>Bộ câu hỏi tìm hàng</h3><p>Chỉ lưu câu đã biên soạn và mã hàng đúng. Câu lấy từ phản hồi dùng để luyện.</p></div><div><a href="@Url.Content("~/admin/assistant/search/catalog.json")">Xuất danh mục</a> · <a href="@Url.Content("~/admin/customer-service/quality/cases.json")">Xuất câu hỏi</a></div></header>
  <form id="cqCaseForm" class="cq-case-form"><label class="cq-wide">Câu tìm sản phẩm đã loại thông tin riêng<input id="cqQuery" maxlength="200" required placeholder="Ví dụ: sữa TH có đường 180ml"/></label>
   <label>Điều cần kiểm tra<select id="cqKind"><option value="exact">Đúng mã đầu tiên</option><option value="ambiguous">Giữ các mã còn mơ hồ</option><option value="confirm">Phải yêu cầu xác nhận</option><option value="not_found">Không có sản phẩm</option></select></label>
   <label>Mã biến thể đúng (tối đa 5)<input id="cqExpected" placeholder="123, 456" inputmode="text"/></label>
   <label>Nhóm câu<select id="cqSplit"><option value="tune">Luyện / đã dùng cải tiến</option><option value="holdout">Nghiệm thu độc lập</option></select></label><label>Trạng thái<select id="cqCaseState"><option value="active">Đang dùng</option><option value="archived">Lưu trữ</option></select></label>
   <label class="cq-check cq-wide"><input id="cqIndependent" type="checkbox"/> Câu nghiệm thu chưa dùng để dạy, chỉnh thuật toán hoặc prompt.</label><label class="cq-check cq-wide"><input id="cqSanitized" type="checkbox" required/> Tôi đã bỏ thông tin cá nhân, nội dung đơn riêng và số liệu giá/tồn khỏi câu lưu lâu dài.</label>
   <div class="cq-wide cq-buttons"><button id="cqSaveCase" type="submit">Lưu câu hỏi</button><button id="cqNewCase" type="button">Câu mới</button><span id="cqCaseHint" class="cq-muted"></span></div>
  </form><div id="cqCases" class="cq-cases"></div>
 </section>
 <section class="cq-card"><header class="cq-section-heading"><div><h3>Kiểm tra sau cải tiến</h3><p>Chạy đúng bộ xếp hạng tên trên danh mục hiện tại. Không gọi model hoặc gửi tin khách.</p></div><button id="cqRun" type="button">Chạy kiểm tra tìm hàng</button></header><p class="cq-muted">Ngưỡng truy xuất: ít nhất 20 câu nghiệm thu độc lập, đạt từ 95%, không sai mã đầu ở câu rõ hoặc trả lời chắc nhưng sai. Kết quả này chưa nghiệm thu toàn bộ chat AI.</p><label>Lần chạy đã lưu<select id="cqRuns"></select></label><div id="cqEvaluation"></div></section>
 <dialog id="cqProposal"><form id="cqProposalForm"><h3>Đề xuất cách gọi sản phẩm</h3><p>Soạn lại cụm tìm hàng, chọn đúng mã. Không chép cả hội thoại hoặc dữ liệu khách.</p><label>Cụm từ<input id="cqProposalQuery" maxlength="200" required/></label><label>Mã biến thể đúng<input id="cqProposalVariant" type="number" min="1" step="1" required/></label><label class="cq-check"><input id="cqProposalSafe" type="checkbox" required/> Tôi đã kiểm tra mã hàng và loại bỏ thông tin riêng.</label><p id="cqProposalNotice" role="status"></p><div class="cq-buttons"><button type="submit">Gửi đề xuất chờ duyệt</button><button id="cqProposalCancel" type="button">Đóng</button></div></form></dialog>
</main>
@section PageScripts{<script src="~/Admin/js/customer-quality.js" asp-append-version="true"></script>}
