@{
    ViewData["Title"] = "Thẻ kho / Lịch sử giao dịch kho";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">Thẻ kho / Lịch sử giao dịch kho</h3>
                <p class="gds-page-header__subtitle mb-0">
                    Truy vết biến động tồn theo sản phẩm, kho và chứng từ nguồn.
                </p>
            </div>
            <div class="gds-page-header__actions">
                <a href="/admin/invoice-input-stock" class="btn btn-label-primary">Tồn hàng có hóa đơn XML</a>
                <button type="button"
                        class="btn btn-label-secondary gds-action-button"
                        id="ledgerReloadButton">
                    <i class="bx bx-refresh" aria-hidden="true"></i>
                    <span>Tải lại</span>
                </button>
            </div>
        </div>
    </div>
}

@section VendorStyles {
    <link href="~/Admin/css/inventory-ledger.css" rel="stylesheet" asp-append-version="true" />
}

<div class="inventory-ledger-page gds-page"
     data-gao-ui="modern"
     data-inventory-ledger-index
     data-data-url="@Url.Action("GetData", "InventoryLedger", new { area = "Admin" })"
     data-quick-view-url="@Url.Action("GetQuickView", "InventoryLedger", new { area = "Admin" })"
     data-warehouse-url="/admin/api/warehouses/select2?term=">

    <section aria-label="Tổng quan giao dịch kho">
        <div class="row row-cols-2 row-cols-xl-4 g-3">
            <div class="col">
                <button type="button"
                        class="ledger-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--primary h-100 w-100 is-active"
                        data-ledger-state=""
                        aria-pressed="true">
                    <span class="gds-kpi-card__icon is-primary" aria-hidden="true">
                        <i class="bx bx-transfer-alt"></i>
                    </span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Tổng giao dịch</span>
                        <span class="gds-kpi-card__value text-primary" id="ledgerTotalCount">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="ledger-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--success h-100 w-100"
                        data-ledger-state="increase"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon is-success" aria-hidden="true">
                        <i class="bx bx-trending-up"></i>
                    </span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Tăng tồn</span>
                        <span class="gds-kpi-card__value text-success" id="ledgerIncreaseCount">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="ledger-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-ledger-state="decrease"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-warning text-warning" aria-hidden="true">
                        <i class="bx bx-trending-down"></i>
                    </span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Giảm tồn</span>
                        <span class="gds-kpi-card__value text-warning" id="ledgerDecreaseCount">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="ledger-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-ledger-state="negative"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-danger text-danger" aria-hidden="true">
                        <i class="bx bx-error-circle"></i>
                    </span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Âm sau giao dịch</span>
                        <span class="gds-kpi-card__value text-danger" id="ledgerNegativeCount">0</span>
                    </span>
                </button>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0" aria-label="Bộ lọc lịch sử giao dịch kho">
        <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm rounded bg-label-primary" aria-hidden="true">
                    <i class="bx bx-filter-alt"></i>
                </span>
                <div>
                    <h5 class="mb-0 text-dark">Tra cứu giao dịch kho</h5>
                    <small class="text-muted">Tìm theo sản phẩm, SKU, barcode, chứng từ hoặc ghi chú.</small>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="ledger-filter-bar">
                <div class="ledger-search-wrap">
                    <label for="ledgerKeyword" class="form-label fw-semibold text-dark">Tìm kiếm</label>
                    <div class="gds-search-field">
                        <i class="bx bx-search" aria-hidden="true"></i>
                        <input type="search"
                               id="ledgerKeyword"
                               class="form-control"
                               placeholder="Nhập từ khóa theo mục đã chọn..."
                               autocomplete="off" />
                        <button type="button"
                                id="ledgerClearSearch"
                                class="gds-search-field__clear d-none"
                                aria-label="Xóa tìm kiếm"
                                title="Xóa tìm kiếm">
                            <i class="bx bx-x" aria-hidden="true"></i>
                        </button>
                    </div>
                    <label for="ledgerSearchScope" class="form-label mt-2">Tìm theo</label>
                    <select id="ledgerSearchScope" class="form-select">
                        <option value="product">Sản phẩm / SKU / barcode</option>
                        <option value="reference">Mã chứng từ</option>
                        <option value="note">Ghi chú</option>
                        <option value="all">Tất cả (nên chọn khoảng ngày)</option>
                    </select>
                </div>

                <div class="ledger-desktop-filters">
                    <div>
                        <label for="ledgerWarehouseFilter" class="form-label">Kho</label>
                        <select id="ledgerWarehouseFilter" class="form-select">
                            <option value="">Tất cả kho</option>
                        </select>
                    </div>
                    <div>
                        <label for="ledgerTransactionTypeFilter" class="form-label">Loại giao dịch</label>
                        <select id="ledgerTransactionTypeFilter" class="form-select">
                            <option value="">Tất cả giao dịch</option>
                            <option value="1">Số dư đầu kỳ</option>
                            <option value="10">Nhập mua hàng</option>
                            <option value="11">Trả hàng nhà cung cấp</option>
                            <option value="20">Xuất bán hàng</option>
                            <option value="21">Nhập lại hàng bán</option>
                            <option value="22">Hoàn kho do hủy đơn</option>
                            <option value="23">Khách trả hàng</option>
                            <option value="30">Điều chỉnh tăng</option>
                            <option value="31">Điều chỉnh giảm</option>
                            <option value="40">Nhập chuyển kho</option>
                            <option value="41">Xuất chuyển kho</option>
                            <option value="50">Kiểm kê tăng</option>
                            <option value="51">Kiểm kê giảm</option>
                            <option value="60">Giữ hàng</option>
                            <option value="61">Nhả giữ hàng</option>
                            <option value="70">Định giá lại</option>
                        </select>
                    </div>
                    <div>
                        <label for="ledgerReferenceTypeFilter" class="form-label">Nguồn / chứng từ</label>
                        <select id="ledgerReferenceTypeFilter" class="form-select">
                            <option value="">Tất cả nguồn</option>
                            <option value="0">Không có nguồn</option>
                            <option value="1">Đơn bán hàng</option>
                            <option value="2">Phiếu nhập mua</option>
                            <option value="3">Phiếu trả nhà cung cấp</option>
                            <option value="4">Hoàn trả</option>
                            <option value="5">Phiếu điều chỉnh</option>
                            <option value="6">Phiếu chuyển kho</option>
                            <option value="7">Phiếu kiểm kê</option>
                            <option value="8">Giữ hàng</option>
                            <option value="10">Chứng từ kho</option>
                        </select>
                    </div>
                    <div>
                        <label for="ledgerFromDate" class="form-label">Từ ngày</label>
                        <input type="date" id="ledgerFromDate" class="form-control" />
                    </div>
                    <div>
                        <label for="ledgerToDate" class="form-label">Đến ngày</label>
                        <input type="date" id="ledgerToDate" class="form-control" />
                    </div>
                    <div>
                        <label for="ledgerReferenceCode" class="form-label">Mã chứng từ</label>
                        <input type="text" id="ledgerReferenceCode" class="form-control" placeholder="Ví dụ: NK-..." />
                    </div>
                    <div>
                        <label for="ledgerSortBy" class="form-label">Sắp xếp</label>
                        <select id="ledgerSortBy" class="form-select">
                            <option value="date">Ngày giao dịch</option>
                            <option value="product">Tên sản phẩm</option>
                            <option value="warehouse">Kho</option>
                            <option value="change">Mức biến động</option>
                            <option value="after">Tồn sau giao dịch</option>
                        </select>
                    </div>
                    <div class="ledger-compact-filter">
                        <label for="ledgerSortDirection" class="form-label">Chiều</label>
                        <select id="ledgerSortDirection" class="form-select">
                            <option value="desc">Giảm dần</option>
                            <option value="asc">Tăng dần</option>
                        </select>
                    </div>
                    <div class="ledger-compact-filter">
                        <label for="ledgerPageSize" class="form-label">Số dòng / trang</label>
                        <select id="ledgerPageSize" class="form-select">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                    </div>
                    <button type="button"
                            class="gds-icon-button ledger-reset-button"
                            id="ledgerResetFilters"
                            aria-label="Xóa bộ lọc"
                            title="Xóa bộ lọc">
                        <i class="bx bx-reset" aria-hidden="true"></i>
                    </button>
                </div>

                <button type="button"
                        class="btn btn-label-primary ledger-mobile-filter-button"
                        id="ledgerOpenMobileFilters"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#ledgerMobileFilterSheet"
                        aria-controls="ledgerMobileFilterSheet">
                    <i class="bx bx-filter-alt" aria-hidden="true"></i>
                    <span>Bộ lọc</span>
                    <span class="badge bg-primary rounded-pill d-none" id="ledgerActiveFilterCount">0</span>
                </button>
                <div class="ledger-date-error d-none" id="ledgerDateError" role="alert">
                    Từ ngày không được lớn hơn đến ngày.
                </div>
            </div>
        </div>
    </section>

    <section class="gds-list-panel ledger-results-panel"
             id="ledgerResultsPanel"
             aria-label="Danh sách lịch sử giao dịch kho"
             aria-live="polite"
             aria-busy="false">
        <div class="ledger-results-heading">
            <div>
                <h5 class="mb-1 text-dark">Lịch sử giao dịch kho</h5>
                <small class="text-muted">Nhấp đúp một dòng hoặc bấm biểu tượng mắt để xem nhanh.</small>
                        <small class="text-muted d-block mt-1" data-ledger-cost-column hidden>Giá nhập là giá vốn theo lần nhập; giao dịch định giá lại hiển thị giá vốn sau điều chỉnh và phần chênh lệch giá trị tồn.</small>
            </div>
        </div>

        <div class="ledger-desktop-list" id="ledgerDesktopList">
            <div class="table-responsive">
                <table class="table align-middle gds-table mb-0 ledger-table">
                    <thead>
                        <tr>
                            <th>Ngày giao dịch</th>
                            <th>Sản phẩm</th>
                            <th>Biến động</th>
                            <th>Tồn trước → sau</th>
                            <th class="text-end" data-ledger-cost-column hidden>Giá vốn / điều chỉnh</th>
                            <th>Nguồn / chứng từ</th>
                            <th class="text-end">Trạng thái / thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="ledgerDesktopBody">
                        <tr><td colspan="6" class="gds-empty">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ledger-mobile-list" id="ledgerMobileList" aria-label="Lịch sử giao dịch kho trên thiết bị di động">
            <div class="gds-empty">Đang tải dữ liệu...</div>
        </div>
    </section>

    <div class="gds-list-footer ledger-list-footer">
        <div class="gds-list-footer__summary" id="ledgerResultSummary">0 kết quả</div>
        <nav aria-label="Phân trang lịch sử giao dịch kho">
            <ul class="pagination pagination-sm mb-0 ledger-pagination" id="ledgerPagination"></ul>
        </nav>
    </div>

    <div class="modal fade"
         id="ledgerQuickViewModal"
         tabindex="-1"
         aria-labelledby="ledgerQuickViewTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable ledger-quick-dialog">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <div>
                        <div class="text-primary fw-semibold small text-uppercase">Xem nhanh giao dịch kho</div>
                        <h4 class="modal-title text-dark" id="ledgerQuickViewTitle">Thông tin giao dịch</h4>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                            <span class="gds-code" id="ledgerQuickDate">—</span>
                            <span class="gds-status gds-status--dot is-neutral" id="ledgerQuickState">—</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body" id="ledgerQuickBody">
                    <div class="text-center text-muted py-5">
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        Đang tải thông tin...
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade"
         id="ledgerImagePreviewModal"
         tabindex="-1"
         aria-labelledby="ledgerImagePreviewTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered ledger-image-preview-dialog">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title" id="ledgerImagePreviewTitle">Ảnh sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body ledger-image-preview-body">
                    <img id="ledgerImagePreviewImage" alt="Ảnh sản phẩm phóng to" />
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-bottom ledger-filter-sheet"
         tabindex="-1"
         id="ledgerMobileFilterSheet"
         aria-labelledby="ledgerMobileFilterTitle">
        <div class="offcanvas-header">
            <div>
                <h5 class="offcanvas-title" id="ledgerMobileFilterTitle">Bộ lọc giao dịch kho</h5>
                <small class="text-muted">Thu hẹp lịch sử trên thiết bị di động.</small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row g-3">
                <div class="col-12">
                    <label for="ledgerMobileWarehouse" class="form-label">Kho</label>
                    <select id="ledgerMobileWarehouse" class="form-select"><option value="">Tất cả kho</option></select>
                </div>
                <div class="col-12">
                    <label for="ledgerMobileTransactionType" class="form-label">Loại giao dịch</label>
                    <select id="ledgerMobileTransactionType" class="form-select">
                        <option value="">Tất cả giao dịch</option>
                        <option value="1">Số dư đầu kỳ</option><option value="10">Nhập mua hàng</option>
                        <option value="11">Trả hàng nhà cung cấp</option><option value="20">Xuất bán hàng</option>
                        <option value="21">Nhập lại hàng bán</option><option value="22">Hoàn kho do hủy đơn</option>
                        <option value="23">Khách trả hàng</option><option value="30">Điều chỉnh tăng</option>
                        <option value="31">Điều chỉnh giảm</option><option value="40">Nhập chuyển kho</option>
                        <option value="41">Xuất chuyển kho</option><option value="50">Kiểm kê tăng</option>
                        <option value="51">Kiểm kê giảm</option><option value="60">Giữ hàng</option>
                        <option value="61">Nhả giữ hàng</option><option value="70">Định giá lại</option>
                    </select>
                </div>
                <div class="col-12">
                    <label for="ledgerMobileReferenceType" class="form-label">Nguồn / chứng từ</label>
                    <select id="ledgerMobileReferenceType" class="form-select">
                        <option value="">Tất cả nguồn</option><option value="0">Không có nguồn</option>
                        <option value="1">Đơn bán hàng</option><option value="2">Phiếu nhập mua</option>
                        <option value="3">Phiếu trả nhà cung cấp</option><option value="4">Hoàn trả</option>
                        <option value="5">Phiếu điều chỉnh</option><option value="6">Phiếu chuyển kho</option>
                        <option value="7">Phiếu kiểm kê</option><option value="8">Giữ hàng</option>
                        <option value="10">Chứng từ kho</option>
                    </select>
                </div>
                <div class="col-6">
                    <label for="ledgerMobileFromDate" class="form-label">Từ ngày</label>
                    <input type="date" id="ledgerMobileFromDate" class="form-control" />
                </div>
                <div class="col-6">
                    <label for="ledgerMobileToDate" class="form-label">Đến ngày</label>
                    <input type="date" id="ledgerMobileToDate" class="form-control" />
                </div>
                <div class="col-12">
                    <label for="ledgerMobileReferenceCode" class="form-label">Mã chứng từ</label>
                    <input type="text" id="ledgerMobileReferenceCode" class="form-control" />
                </div>
                <div class="col-7">
                    <label for="ledgerMobileSortBy" class="form-label">Sắp xếp</label>
                    <select id="ledgerMobileSortBy" class="form-select">
                        <option value="date">Ngày giao dịch</option><option value="product">Tên sản phẩm</option>
                        <option value="warehouse">Kho</option><option value="change">Mức biến động</option>
                        <option value="after">Tồn sau giao dịch</option>
                    </select>
                </div>
                <div class="col-5">
                    <label for="ledgerMobileSortDirection" class="form-label">Chiều</label>
                    <select id="ledgerMobileSortDirection" class="form-select">
                        <option value="desc">Giảm dần</option><option value="asc">Tăng dần</option>
                    </select>
                </div>
                <div class="col-12">
                    <label for="ledgerMobilePageSize" class="form-label">Số dòng / trang</label>
                    <select id="ledgerMobilePageSize" class="form-select">
                        <option value="10">10</option><option value="20" selected>20</option>
                        <option value="50">50</option><option value="100">100</option><option value="200">200</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="offcanvas-footer ledger-filter-sheet__footer">
            <button type="button" class="btn btn-label-secondary" id="ledgerMobileClearFilters">Xóa lọc</button>
            <button type="button" class="btn btn-primary flex-grow-1" id="ledgerMobileApplyFilters">Áp dụng</button>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/Admin/js/inventory-ledger.js" asp-append-version="true"></script>
}
