@model GaoApp.Application.DTOs.POS.OrderReceiptDto

@{
    Layout = null;
    ViewData["Title"] = "Hóa đơn POS";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn #@Model.OrderId</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 24px;
            background: #f5f5f5;
            color: #111;
        }

        .receipt-wrap {
            max-width: 820px;
            margin: 0 auto;
        }

        .receipt-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,.08);
            padding: 24px;
        }

        .receipt-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 16px;
            margin-bottom: 20px;
        }

        .receipt-title {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 4px 0;
        }

        .receipt-sub {
            color: #666;
            font-size: 14px;
        }

        .receipt-badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 999px;
            background: #eef5ff;
            color: #0d6efd;
            font-size: 13px;
            font-weight: 700;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin: 20px 0 10px 0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 12px;
        }

        .info-box {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .info-label {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 15px;
            font-weight: 700;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #dee2e6;
            padding: 10px 8px;
            font-size: 14px;
            vertical-align: middle;
        }

        th {
            background: #f8f9fa;
            text-align: left;
        }

        .text-end {
            text-align: right;
        }

        .summary {
            margin-top: 16px;
            margin-left: auto;
            width: 320px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px dashed #ddd;
        }

            .summary-row.total {
                font-size: 18px;
                font-weight: 700;
            }

        .toolbar {
            max-width: 820px;
            margin: 0 auto 12px auto;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            border: 0;
            border-radius: 10px;
            padding: 10px 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-print {
            background: #0d6efd;
            color: #fff;
        }

        .btn-close {
            background: #6c757d;
            color: #fff;
        }

        .muted {
            color: #666;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }

            .toolbar {
                display: none;
            }

            .receipt-card {
                box-shadow: none;
                border-radius: 0;
                padding: 0;
            }

            .receipt-wrap {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button class="btn btn-print" onclick="window.print()">In hóa đơn</button>
        <button class="btn btn-close" onclick="window.close()">Đóng</button>
    </div>

    <div class="receipt-wrap">
        <div class="receipt-card">
            <div class="receipt-header">
                <div>
                    <h1 class="receipt-title">HÓA ĐƠN BÁN HÀNG</h1>
                    <div class="receipt-sub">POS Receipt</div>
                </div>

                <div>
                    <div class="receipt-badge">@Model.Status / @Model.PaymentStatus</div>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-box">
                    <div class="info-label">Mã đơn</div>
                    <div class="info-value">#@Model.OrderId</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Số hóa đơn / mã đơn</div>
                    <div class="info-value">@(string.IsNullOrWhiteSpace(Model.OrderNumber) ? "-" : Model.OrderNumber)</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Khách hàng</div>
                    <div class="info-value">@(Model.CustomerId?.ToString() ?? "Khách lẻ")</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Ghi chú</div>
                    <div class="info-value">@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</div>
                </div>
            </div>

            <div class="section-title">Danh sách hàng</div>
            <table>
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Sản phẩm</th>
                        <th style="width:110px;">SL</th>
                        <th style="width:140px;">Đơn giá</th>
                        <th style="width:150px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines == null || !Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="5" class="muted">Không có dữ liệu.</td>
                        </tr>
                    }
                    else
                    {
                        var index = 1;
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@index</td>
                                <td>
                                    <div><strong>@line.ItemName</strong></div>
                                    <div class="muted">SKU: @line.Sku @(string.IsNullOrWhiteSpace(line.Barcode) ? "" : $"| Barcode: {line.Barcode}")</div>
                                </td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end">@line.UnitPrice.ToString("N0")</td>
                                <td class="text-end">@line.LineTotal.ToString("N0")</td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>

            <div class="section-title">Thanh toán</div>
            <table>
                <thead>
                    <tr>
                        <th style="width:70px;">#</th>
                        <th>Phương thức</th>
                        <th style="width:160px;">Số tiền</th>
                        <th>Mã tham chiếu</th>
                        <th style="width:180px;">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payments == null || !Model.Payments.Any())
                    {
                        <tr>
                            <td colspan="5" class="muted">Chưa có thanh toán.</td>
                        </tr>
                    }
                    else
                    {
                        var payIndex = 1;
                        foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@payIndex</td>
                                <td>@p.Method</td>
                                <td class="text-end">@p.Amount.ToString("N0")</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</td>
                                <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                            payIndex++;
                        }
                    }
                </tbody>
            </table>

            <div class="summary">
                <div class="summary-row">
                    <span>Tạm tính</span>
                    <strong>@Model.Subtotal.ToString("N0")</strong>
                </div>
                <div class="summary-row">
                    <span>Giảm giá</span>
                    <strong>@Model.DiscountTotal.ToString("N0")</strong>
                </div>
                <div class="summary-row total">
                    <span>Tổng tiền</span>
                    <strong>@Model.GrandTotal.ToString("N0")</strong>
                </div>
                <div class="summary-row">
                    <span>Đã thanh toán</span>
                    <strong>@Model.PaidTotal.ToString("N0")</strong>
                </div>
                <div class="summary-row">
                    <span>Còn thiếu</span>
                    <strong>@Model.BalanceDue.ToString("N0")</strong>
                </div>
                <div class="summary-row">
                    <span>Tiền thừa</span>
                    <strong>@Model.ChangeDue.ToString("N0")</strong>
                </div>
            </div>
        </div>
    </div>
</body>
</html>