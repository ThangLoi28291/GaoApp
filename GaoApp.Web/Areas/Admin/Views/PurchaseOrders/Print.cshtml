@model GaoApp.Web.Areas.Admin.Models.Purchases.PurchaseOrderPrintViewModel
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Purchases
@{
    Layout = null;
    var order = Model.Order;
    var watermark = order.Status switch
    {
        PurchaseOrderStatus.Cancelled => "ĐÃ HỦY",
        PurchaseOrderStatus.Rejected => "ĐÃ TỪ CHỐI",
        PurchaseOrderStatus.Draft or PurchaseOrderStatus.PendingApproval or PurchaseOrderStatus.ReturnedForRevision => "BẢN NHÁP",
        _ => null
    };
}
<!doctype html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@order.OrderNumber - Đơn đặt hàng</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#edf0f5;color:#1f2937;font-family:Arial,"Segoe UI",sans-serif;font-size:13px}.toolbar{position:sticky;top:0;z-index:5;background:#1f2937;color:#fff;padding:10px 16px;display:flex;justify-content:space-between;align-items:center}.toolbar button{border:0;border-radius:6px;padding:8px 14px;cursor:pointer}.paper{position:relative;width:210mm;min-height:297mm;margin:18px auto;background:#fff;padding:15mm 14mm;box-shadow:0 4px 20px rgba(15,23,42,.14);overflow:hidden}.watermark{position:absolute;top:45%;left:12%;right:12%;transform:rotate(-24deg);text-align:center;font-size:62px;font-weight:800;color:rgba(220,38,38,.10);letter-spacing:4px;pointer-events:none}.header{display:flex;justify-content:space-between;gap:30px;padding-bottom:14px;border-bottom:2px solid #1f2937}.company{max-width:58%}.company h2{font-size:18px;margin:0 0 6px;text-transform:uppercase}.company div{line-height:1.5}.document{text-align:right}.document h1{font-size:24px;margin:0 0 6px}.document .number{font-size:15px;font-weight:700}.meta{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:18px 0}.box{border:1px solid #d1d5db;border-radius:7px;padding:11px 13px}.box h3{font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:#6b7280;margin:0 0 8px}.box strong{font-size:14px}.row{display:grid;grid-template-columns:125px 1fr;gap:8px;margin-top:5px}.row span:first-child{color:#6b7280}table{width:100%;border-collapse:collapse;margin-top:16px}thead{display:table-header-group}th{background:#f3f4f6;text-transform:uppercase;font-size:10px;letter-spacing:.45px;text-align:left}th,td{border:1px solid #d1d5db;padding:7px 6px;vertical-align:top}tr{break-inside:avoid}.num{text-align:right;white-space:nowrap}.product{font-weight:600}.muted{color:#6b7280;font-size:11px;margin-top:3px}.totals{width:45%;margin:12px 0 0 auto}.totals div{display:flex;justify-content:space-between;padding:5px 2px}.totals .grand{font-size:15px;font-weight:700;border-top:2px solid #1f2937;padding-top:8px}.note{margin-top:16px;padding:10px 12px;background:#f9fafb;border-left:3px solid #6b7280;white-space:pre-wrap}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:80px;text-align:center;margin-top:34px;break-inside:avoid}.signatures strong{display:block}.signatures small{color:#6b7280}.signature-space{height:65px}.footer{position:absolute;bottom:8mm;left:14mm;right:14mm;text-align:center;color:#9ca3af;font-size:10px}@@page{size:A4;margin:0}@@media print{body{background:#fff}.toolbar{display:none}.paper{margin:0;box-shadow:none;width:210mm;min-height:297mm}.footer{position:fixed}}
</style></head><body>
<div class="toolbar"><span>Bản in cố định từ dữ liệu đơn đã lưu</span><div><button onclick="window.close()">Đóng</button> <button onclick="window.print()">In / Lưu PDF</button></div></div>
<main class="paper">
@if(!string.IsNullOrWhiteSpace(watermark)){<div class="watermark">@watermark</div>}
<section class="header"><div class="company"><h2>@order.LegalEntityLegalName</h2>@if(!string.IsNullOrWhiteSpace(order.LegalEntityTaxCode)){<div>MST: @order.LegalEntityTaxCode</div>}@if(!string.IsNullOrWhiteSpace(order.LegalEntityAddress)){<div>@order.LegalEntityAddress</div>}<div>@string.Join(" · ", new[]{order.LegalEntityPhone,order.LegalEntityEmail}.Where(x=>!string.IsNullOrWhiteSpace(x)))</div></div><div class="document"><h1>ĐƠN ĐẶT HÀNG</h1><div class="number">@order.OrderNumber</div><div>Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy")</div><div>Trạng thái: @PurchaseOrderPresentation.StatusLabel(order.Status)</div></div></section>
<section class="meta"><div class="box"><h3>Nhà cung cấp</h3><strong>@order.SupplierName</strong><div class="row"><span>Mã NCC</span><span>@order.SupplierCode</span></div>@if(!string.IsNullOrWhiteSpace(order.SupplierTaxCode)){<div class="row"><span>Mã số thuế</span><span>@order.SupplierTaxCode</span></div>}@if(!string.IsNullOrWhiteSpace(order.SupplierContactName)){<div class="row"><span>Người liên hệ</span><span>@order.SupplierContactName</span></div>}<div class="row"><span>Liên lạc</span><span>@string.Join(" · ",new[]{order.SupplierPhone,order.SupplierEmail}.Where(x=>!string.IsNullOrWhiteSpace(x)))</span></div>@if(!string.IsNullOrWhiteSpace(order.SupplierAddress)){<div class="row"><span>Địa chỉ</span><span>@order.SupplierAddress</span></div>}</div><div class="box"><h3>Giao hàng</h3><div class="row"><span>Kho nhận</span><span>@order.WarehouseCode - @order.WarehouseName</span></div>@if(!string.IsNullOrWhiteSpace(order.WarehouseLocation)){<div class="row"><span>Địa điểm</span><span>@order.WarehouseLocation</span></div>}<div class="row"><span>Dự kiến giao</span><span>@(order.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</span></div><div class="row"><span>Nguồn đơn</span><span>@(order.SourcePurchaseRequestId.HasValue ? $"Yêu cầu mua #{order.SourcePurchaseRequestId}" : "Ngoài yêu cầu mua")</span></div></div></section>
<table><thead><tr><th style="width:28px">#</th><th>Sản phẩm</th><th style="width:110px">Đơn vị</th><th class="num" style="width:100px">Số lượng đặt</th></tr></thead><tbody>@foreach(var line in order.Lines){<tr><td>@line.LineNo</td><td><div class="product">@line.ProductName</div>@if(line.ItemKind==PurchaseItemKind.Catalog){<div class="muted">@if(!string.IsNullOrWhiteSpace(line.Sku)){<span>SKU: @line.Sku · </span>}Quy đổi × @PurchaseQuantityFormatter.Display(line.ConversionFactor)</div>}</td><td>@line.UnitName</td><td class="num"><strong>@PurchaseQuantityFormatter.Display(line.OrderedQuantity)</strong></td></tr>}</tbody></table>
<div class="note"><strong>Lưu ý:</strong> Đơn đặt hàng này chỉ xác nhận tên, đơn vị và số lượng. Giá thực nhận, VAT và chi phí được xác nhận trên phiếu nhập kho.</div>
@if(!string.IsNullOrWhiteSpace(order.Note)){<div class="note"><strong>Ghi chú:</strong> @order.Note</div>}
<section class="signatures"><div><strong>ĐẠI DIỆN BÊN MUA</strong><small>(Ký, ghi rõ họ tên)</small><div class="signature-space"></div></div><div><strong>XÁC NHẬN NHÀ CUNG CẤP</strong><small>(Ký, ghi rõ họ tên)</small><div class="signature-space"></div></div></section>
<div class="footer">Đơn được in từ GaoApp lúc @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
</main>
@if(Model.AutoPrint){<script>window.addEventListener('load',function(){window.print();});</script>}
</body></html>
