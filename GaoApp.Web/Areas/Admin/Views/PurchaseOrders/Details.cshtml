@model GaoApp.Web.Areas.Admin.Models.Purchases.PurchaseOrderDetailsViewModel
@using System.Globalization
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Purchases
@{
    var order = Model.Order;
    ViewData["Title"] = $"Đơn {order.OrderNumber}";
    string Money(decimal value) => value.ToString("#,0.##", CultureInfo.GetCultureInfo("vi-VN")) + " đ";
    var productCount = order.Lines
        .Select(x => x.ProductVariantId.HasValue ? $"catalog:{x.ProductVariantId}" : $"free:{x.ProductName.Trim().ToLowerInvariant()}")
        .Distinct()
        .Count();
    var unresolvedCount = order.Lines.Count(x => x.ItemKind == PurchaseItemKind.FreeText && !x.ResolvedAtUtc.HasValue);
    var receivingLineCount = order.Lines.Count(x => x.ReceivedQuantity > 0m);
    var currentStage = order.Status switch
    {
        PurchaseOrderStatus.PendingApproval => 1,
        PurchaseOrderStatus.Approved => 2,
        PurchaseOrderStatus.SentToSupplier => 3,
        PurchaseOrderStatus.PartiallyReceived or PurchaseOrderStatus.FullyReceived or PurchaseOrderStatus.ShortClosed => 4,
        _ => 0
    };
    var workflowStopped = order.Status is PurchaseOrderStatus.Rejected or PurchaseOrderStatus.Cancelled;
    var receivingWorkbenchEnabled = ViewData["ReceivingWorkbenchEnabled"] as bool? == true;
    var editableReceipt = order.Receipts.FirstOrDefault(x =>
        x.Status is StockDocumentStatus.Draft or StockDocumentStatus.Rejected);
    var pendingReceipt = order.Receipts.FirstOrDefault(x =>
        x.Status == StockDocumentStatus.PendingApproval);
    var receivingActionTitle = editableReceipt != null
        ? "Tiếp tục nhận hàng"
        : order.Status == PurchaseOrderStatus.PartiallyReceived
            ? "Nhận đợt tiếp theo"
            : "Bắt đầu nhận hàng";
}
@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}
@section PageStyles { <link rel="stylesheet" href="~/Admin/css/purchase-order-details.css" asp-append-version="true" /> }

<div class="pod-page" id="purchaseOrderDetailsPage" data-supplier-lookup-url="@Url.Content("~/admin/purchase-orders/supplier-lookup")">
    <header class="pod-hero">
        <div class="pod-hero-main">
            <a class="pod-back" asp-action="Index" aria-label="Quay lại danh sách"><i class="bx bx-arrow-back"></i></a>
            <div class="pod-hero-copy">
                <div class="pod-eyebrow">ĐƠN ĐẶT HÀNG · @order.OrderNumber</div>
                <div class="pod-title-row">
                    <h3>@(string.IsNullOrWhiteSpace(order.Title) ? order.OrderNumber : order.Title)</h3>
                    <span class="pod-status @PurchaseOrderPresentation.StatusClass(order.Status)">@PurchaseOrderPresentation.StatusLabel(order.Status)</span>
                </div>
                <div class="pod-meta">
                    <span><i class="bx bx-user"></i> @order.CreatedByName</span>
                    <span><i class="bx bx-calendar"></i> @order.OrderDate.ToString("dd/MM/yyyy")</span>
                    @if (order.SourcePurchaseRequestId.HasValue)
                    {
                        <a class="pod-source pod-source-request" asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@order.SourcePurchaseRequestId"><i class="bx bx-link-alt"></i> Yêu cầu mua #@order.SourcePurchaseRequestId</a>
                    }
                    else
                    {
                        <span class="pod-source pod-source-direct"><i class="bx bx-file-blank"></i> Đơn trực tiếp</span>
                    }
                </div>
            </div>
        </div>
        <div class="pod-hero-actions">
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#purchaseOrderHelpModal"><i class="bx bx-help-circle me-1"></i>Hướng dẫn <kbd>F1</kbd></button>
            @if (Model.CanPrint){<a class="btn btn-outline-secondary" target="_blank" asp-action="Print" asp-route-id="@order.Id"><i class="bx bx-printer me-1"></i>In đơn</a>}
            @if (Model.CanEdit){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@order.Id"><i class="bx bx-edit-alt me-1"></i>Chỉnh sửa</a>}
        </div>
    </header>

    <section class="pod-progress-card" aria-label="Tiến trình đơn đặt hàng">
        @foreach (var step in new[]
        {
            (Index: 0, Icon: "bx-edit", Label: "Đơn nháp", Hint: "Khởi tạo"),
            (Index: 1, Icon: "bx-time-five", Label: "Chờ duyệt", Hint: "Quản lý kiểm tra"),
            (Index: 2, Icon: "bx-check-shield", Label: "Đã duyệt", Hint: "Chốt nhà cung cấp"),
            (Index: 3, Icon: "bx-send", Label: "Đã gửi NCC", Hint: "Chờ giao hàng"),
            (Index: 4, Icon: "bx-package", Label: "Nhận hàng", Hint: "Nhập kho")
        })
        {
            var stepClass = workflowStopped ? "is-muted" : step.Index < currentStage ? "is-done" : step.Index == currentStage ? "is-current" : string.Empty;
            <div class="pod-progress-step @stepClass">
                <span class="pod-progress-icon"><i class="bx @step.Icon"></i></span>
                <span><strong>@step.Label</strong><small>@step.Hint</small></span>
            </div>
        }
    </section>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    @if ((order.Status is PurchaseOrderStatus.ReturnedForRevision or PurchaseOrderStatus.Rejected or PurchaseOrderStatus.Cancelled) && !string.IsNullOrWhiteSpace(order.WorkflowNote))
    {
        <div class="alert @(order.Status == PurchaseOrderStatus.ReturnedForRevision ? "alert-warning" : "alert-danger") d-flex gap-2"><i class="bx bx-message-error fs-5"></i><div><strong>@(order.Status == PurchaseOrderStatus.ReturnedForRevision ? "Yêu cầu chỉnh sửa" : order.Status == PurchaseOrderStatus.Rejected ? "Lý do từ chối" : "Lý do hủy")</strong><div>@order.WorkflowNote</div></div></div>
    }

    <div class="pod-summary-grid">
        <div class="pod-kpi"><span class="icon ordered"><i class="bx bx-list-ul"></i></span><div><small>Dòng đặt hàng</small><strong>@order.Lines.Count</strong><span>Giữ riêng từng đơn vị</span></div></div>
        <div class="pod-kpi"><span class="icon product"><i class="bx bx-cube"></i></span><div><small>Sản phẩm</small><strong>@productCount</strong><span>@(unresolvedCount > 0 ? $"{unresolvedCount} dòng cần chuẩn hóa" : "Danh mục đã sẵn sàng")</span></div></div>
        <div class="pod-kpi"><span class="icon received"><i class="bx bx-package"></i></span><div><small>Tiến độ nhận</small><strong>@receivingLineCount/@order.Lines.Count dòng</strong><span>@order.Receipts.Count phiếu nhập liên quan</span></div></div>
        <div class="pod-kpi"><span class="icon source"><i class="bx bx-git-branch"></i></span><div><small>Nguồn tạo đơn</small><strong>@(order.SourcePurchaseRequestId.HasValue ? "Yêu cầu mua" : "Trực tiếp")</strong><span>@(order.SourcePurchaseRequestId.HasValue ? $"PR #{order.SourcePurchaseRequestId}" : "Không qua yêu cầu mua")</span></div></div>
    </div>

    <div class="card pod-card pod-info-card">
        <div class="pod-section-head"><div class="pod-section-icon"><i class="bx bx-receipt"></i></div><div><h5>Thông tin đặt hàng</h5><p>Thông tin giao dịch và nơi dự kiến nhận hàng.</p></div></div>
        <div class="card-body pt-0">
            <div class="pod-info-grid">
                <div class="pod-info-item @(order.SupplierId.HasValue ? string.Empty : "is-attention")"><span class="pod-info-icon"><i class="bx bx-store"></i></span><div><small>Nhà cung cấp</small><strong>@(order.SupplierId.HasValue ? order.SupplierName : "Chưa chọn nhà cung cấp")</strong><span>@(order.SupplierId.HasValue ? order.SupplierCode : "Quản lý chọn khi duyệt đơn")</span></div></div>
                <div class="pod-info-item"><span class="pod-info-icon"><i class="bx bx-buildings"></i></span><div><small>Đơn vị mua hàng</small><strong>@order.LegalEntityName</strong><span>@order.LegalEntityCode</span></div></div>
                <div class="pod-info-item"><span class="pod-info-icon"><i class="bx bx-map"></i></span><div><small>Kho dự kiến nhận</small><strong>@order.WarehouseName</strong><span>@order.WarehouseCode</span></div></div>
                <div class="pod-info-item"><span class="pod-info-icon"><i class="bx bx-calendar-check"></i></span><div><small>Đặt hàng / dự kiến giao</small><strong>@order.OrderDate.ToString("dd/MM/yyyy")</strong><span>@(order.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "Chưa xác định ngày giao")</span></div></div>
                @if (!order.SourcePurchaseRequestId.HasValue)
                {
                    <div class="pod-note-wrap"><small>Lý do đặt ngoài yêu cầu</small><div class="pod-note">@(order.OutsideRequestReason ?? "Dữ liệu cũ chưa có lý do")</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(order.Note))
                {
                    <div class="pod-note-wrap"><small>Ghi chú cho nhà cung cấp</small><div class="pod-note">@order.Note</div></div>
                }
            </div>
        </div>
    </div>

    <div class="card pod-card pod-products-card">
        <div class="pod-section-head"><div class="pod-section-icon is-purple"><i class="bx bx-cube"></i></div><div class="flex-grow-1"><h5>Hàng hóa đặt mua</h5><p>Mỗi đơn vị là một dòng riêng để đối chiếu chính xác khi nhận hàng.</p></div><span class="pod-lock"><i class="bx bx-lock-alt"></i> Khóa số lượng</span></div>
        <div class="table-responsive"><table class="table align-middle mb-0 pod-lines"><thead><tr><th class="pod-index-col">#</th><th>Sản phẩm</th><th>Đơn vị đặt</th><th class="text-end">Số đặt</th><th class="text-end">Đã nhận</th><th class="text-end">Còn chờ</th><th class="text-end">Đóng thiếu</th><th class="text-end">Thao tác</th></tr></thead><tbody>
        @foreach(var productGroup in order.Lines.GroupBy(x => x.ProductVariantId.HasValue
            ? $"catalog:{x.ProductVariantId}"
            : $"free:{x.ProductName.Trim().ToLowerInvariant()}"))
        {
            var groupFirstLine = productGroup.First();
            var groupSize = productGroup.Count();
            foreach (var line in productGroup)
            {
            <tr class="@(line.Id == groupFirstLine.Id ? "pod-product-group-start" : "pod-product-group-related")">
                <td><span class="pod-line-no">@line.LineNo</span></td>
                @if (line.Id == groupFirstLine.Id)
                {
                    <td rowspan="@groupSize" class="pod-product-cell"><div class="pod-product"><span class="pod-product-avatar"><i class="bx bx-package"></i></span><div><strong>@groupFirstLine.ProductName</strong><small>@(string.IsNullOrWhiteSpace(groupFirstLine.Sku) ? "Chưa có SKU" : $"SKU: {groupFirstLine.Sku}")</small>@if(groupSize > 1){<span class="pod-unit-count">@groupSize đơn vị đặt hàng</span>}@if(groupFirstLine.ItemKind==PurchaseItemKind.FreeText && !groupFirstLine.ResolvedAtUtc.HasValue){<span class="pod-inline-state is-warning"><i class="bx bx-link"></i>Cần chuẩn hóa</span>}else if(groupFirstLine.ItemKind==PurchaseItemKind.FreeText){<span class="pod-inline-state is-success"><i class="bx bx-check"></i>Đã ghép danh mục</span>}</div></div></td>
                }
                <td><span class="pod-unit-badge">@line.UnitName <small>× @PurchaseQuantityFormatter.Display(line.ConversionFactor)</small></span><div class="pod-unit-base">@if(line.ItemKind==PurchaseItemKind.Catalog){<span>= @PurchaseQuantityFormatter.Display(line.ConversionFactor) @line.BaseUnitName</span>}@if(!string.IsNullOrWhiteSpace(line.ShortCloseReason)){<span class="pod-short-reason">Đóng thiếu: @line.ShortCloseReason</span>}</div></td>
                <td class="text-end"><strong class="pod-quantity">@PurchaseQuantityFormatter.Display(line.OrderedQuantity)</strong><small class="pod-quantity-unit">@line.UnitName</small></td>
                <td class="text-end"><strong class="pod-quantity is-success">@PurchaseQuantityFormatter.Display(line.ReceivedQuantity)</strong><small class="pod-quantity-unit">@line.UnitName</small></td>
                <td class="text-end"><strong class="pod-quantity is-primary">@PurchaseQuantityFormatter.Display(line.PendingQuantity)</strong><small class="pod-quantity-unit">@line.UnitName</small></td>
                <td class="text-end"><strong class="pod-quantity is-warning">@PurchaseQuantityFormatter.Display(line.ShortClosedQuantity)</strong><small class="pod-quantity-unit">@line.UnitName</small></td>
                <td class="text-end text-nowrap">
                    @if (Model.CanCloseOutstanding && line.PendingQuantity > 0m)
                    {
                        <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#closeOutstandingLine@(line.Id)">Đóng thiếu</button>
                    }
                    @if (Model.CanReopenOutstanding && line.ShortClosedQuantity > 0m)
                    {
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reopenOutstandingLine@(line.Id)">Mở lại</button>
                    }
                </td>
            </tr>
            }
        }
        </tbody></table></div>
        @if (order.Lines.Any(x => x.ItemKind == PurchaseItemKind.FreeText && x.ResolvedAtUtc.HasValue))
        {
            <div class="border-top p-3">
                <div class="small fw-semibold text-muted mb-2">LIÊN KẾT DANH MỤC ĐÃ XÁC NHẬN</div>
                <div class="vstack gap-2">
                    @foreach (var resolved in order.Lines.Where(x => x.ItemKind == PurchaseItemKind.FreeText && x.ResolvedAtUtc.HasValue))
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 small">
                            <span class="text-muted">@resolved.ProductName · @resolved.UnitName</span>
                            <i class="bx bx-right-arrow-alt"></i>
                            <span class="fw-semibold">@(resolved.ResolvedProductName ?? "Sản phẩm kho")</span>
                            <span class="badge bg-label-success">@(resolved.ResolvedSku ?? "Chưa có SKU") · @(resolved.ResolvedUnitName ?? "Đơn vị đã ghép") × @PurchaseQuantityFormatter.Display(resolved.ConversionFactor)</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.CanResolveItems)
    {
        <div class="card pod-card mb-4 border-warning" id="catalogResolutionCard"
             data-product-lookup-url="@Url.Action("ProductLookup", "PurchaseOrders", new { area = "Admin", supplierId = order.SupplierId })">
            <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="mb-1"><i class="bx bx-link-alt me-1"></i>Chuẩn hóa hàng trước khi nhập kho</h5>
                    <small class="text-muted">Tên và đơn vị nhân viên đã gõ vẫn được giữ nguyên. Hãy ghép với sản phẩm kho thật hoặc tạo sản phẩm chờ hoàn thiện.</small>
                </div>
                @if (Model.CanQuickCreateProduct)
                {
                    <span class="badge bg-label-warning">F4: tạo hàng mới</span>
                }
            </div>
            <div class="card-body">
                <div class="alert alert-warning py-2">
                    Không thể lập phiếu nhập cho các dòng dưới đây cho đến khi đã liên kết danh mục.
                </div>
                <div class="vstack gap-3">
                    @foreach (var line in order.Lines.Where(x =>
                        x.ItemKind == PurchaseItemKind.FreeText && x.PendingQuantity > 0m &&
                        (!x.ProductVariantId.HasValue || !x.ProductUnitConversionId.HasValue)))
                    {
                        <div class="border rounded-3 p-3 po-resolution-row" data-line-id="@line.Id"
                             data-product-name="@line.ProductName" data-unit-name="@line.UnitName">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4">
                                    <div class="small text-muted">Hàng nhân viên yêu cầu</div>
                                    <div class="fw-semibold">@line.ProductName</div>
                                    <div class="small">@line.UnitName · SL còn chờ @PurchaseQuantityFormatter.Display(line.PendingQuantity)</div>
                                </div>
                                <div class="col-lg-8">
                                    <form method="post" asp-action="ResolveLine" asp-route-id="@order.Id" asp-route-lineId="@line.Id"
                                          class="po-resolution-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RowVersion" value="@order.RowVersion" />
                                        <input type="hidden" name="ProductVariantId" class="po-resolution-variant-id" />
                                        <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch">
                                            <select class="form-select po-resolution-product" name="ProductUnitConversionId" required></select>
                                            <button type="submit" class="btn btn-primary text-nowrap">
                                                <i class="bx bx-link me-1"></i>Ghép sản phẩm
                                            </button>
                                            @if (Model.CanQuickCreateProduct)
                                            {
                                                <button type="button" class="btn btn-outline-warning text-nowrap btn-po-quick-create">
                                                    <i class="bx bx-plus-circle me-1"></i>Hàng mới
                                                </button>
                                            }
                                        </div>
                                        <input class="form-control mt-2" name="Note" maxlength="500"
                                               placeholder="Ghi chú liên kết (không bắt buộc)" />
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.CanSubmit || Model.CanReview || Model.CanMarkSent || Model.CanCancel ||
         Model.CanCloseOutstanding || Model.CanReopenOutstanding)
    {
        @if(Model.CanReview)
        {
            <section class="pod-review-card">
                <div class="pod-review-heading">
                    <span class="pod-review-icon"><i class="bx bx-check-shield"></i></span>
                    <div><span>QUẢN LÝ DUYỆT ĐƠN</span><h5>Chọn nhà cung cấp và ra quyết định</h5><p>Số lượng đã được khóa từ yêu cầu mua. Nhà cung cấp chỉ được chốt tại bước duyệt này.</p></div>
                    <span class="pod-review-badge">Cần xử lý</span>
                </div>
                @if (Model.IsCreatedByCurrentUser)
                {
                    <div class="pod-self-review"><i class="bx bx-info-circle"></i><span>Bạn là người lập đơn. Quyết định duyệt sẽ được ghi rõ tài khoản trong lịch sử.</span></div>
                }
                @if(Model.CanReview)
                {
                    <div class="pod-review-body">
                        <form method="post" asp-action="Approve" asp-route-id="@order.Id" id="purchaseOrderApproveForm" class="pod-approval-form" data-self-review="@(Model.IsCreatedByCurrentUser ? "true" : "false")" data-pod-primary-form>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RowVersion" value="@order.RowVersion"/>
                            <div class="pod-approval-supplier">
                                <label class="form-label required" for="approvalSupplierSelect">Nhà cung cấp cho đơn này</label>
                                <select class="form-select" id="approvalSupplierSelect" name="SupplierId" required>
                                    <option value=""></option>
                                    @if (order.SupplierId.HasValue)
                                    {
                                        <option value="@order.SupplierId" selected>@order.SupplierName</option>
                                    }
                                </select>
                                <small><i class="bx bx-search"></i> Tìm theo tên, mã, số điện thoại hoặc mã số thuế.</small>
                            </div>
                            <button class="btn btn-success pod-approve-btn" type="submit"><i class="bx bx-check-shield"></i><span><strong>Duyệt đơn</strong><small>Ctrl + Enter</small></span></button>
                        </form>
                        <div class="pod-review-secondary">
                            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#returnModal"><i class="bx bx-undo me-1"></i>Trả về chỉnh sửa</button>
                            <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="bx bx-x me-1"></i>Từ chối</button>
                        </div>
                    </div>
                }
            </section>
        }

        <div class="pod-action-dock">
            <div class="pod-action-context"><span class="pod-action-state @PurchaseOrderPresentation.StatusClass(order.Status)"><i class="bx bx-pulse"></i></span><div><small>Trạng thái hiện tại</small><strong>@PurchaseOrderPresentation.StatusLabel(order.Status)</strong></div></div>
            <div class="pod-action-buttons">
                @if(Model.CanEdit){<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@order.Id"><i class="bx bx-edit-alt me-1"></i>Sửa đơn</a>}
                @if(Model.CanSubmit){<form method="post" asp-action="Submit" asp-route-id="@order.Id" data-pod-primary-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><button class="btn btn-primary" type="submit"><i class="bx bx-send me-1"></i>Gửi duyệt <kbd>Ctrl+Enter</kbd></button></form>}
                @if(Model.CanMarkSent){<form method="post" asp-action="MarkSent" asp-route-id="@order.Id" data-pod-primary-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><button class="btn btn-primary" type="submit"><i class="bx bx-send me-1"></i>Đã gửi nhà cung cấp <kbd>Ctrl+Enter</kbd></button></form>}
                @if(Model.CanCloseOutstanding){<button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#closeAllOutstanding"><i class="bx bx-minus-circle me-1"></i>Đóng phần thiếu</button>}
                @if(Model.CanReopenOutstanding){<button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reopenAllOutstanding"><i class="bx bx-reset me-1"></i>Mở lại phần thiếu</button>}
                @if(Model.CanCancel){<button class="btn pod-more-danger" type="button" data-bs-toggle="modal" data-bs-target="#cancelModal" title="Hủy đơn"><i class="bx bx-trash"></i></button>}
            </div>
        </div>
    }

    @if((Model.CanCreateReceipt && !Model.CanResolveItems) || (receivingWorkbenchEnabled && pendingReceipt != null))
    {
        var receiptCandidateLines = order.Lines.Where(x => x.PendingQuantity > 0m).ToList();
        <div class="card pod-card mb-4"><div class="card-header border-bottom"><h5 class="mb-1">Nhận hàng từ đơn đặt hàng</h5><small class="text-muted">Kiểm hàng thực tế trước; tồn kho chỉ tăng sau khi quản lý duyệt phiếu.</small></div><div class="card-body">
        @if (receivingWorkbenchEnabled && pendingReceipt != null)
        {
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div><div class="fw-semibold text-warning"><i class="bx bx-time-five me-1"></i>Phiếu @pendingReceipt.DocumentNo đang chờ quản lý duyệt</div><div class="form-text">Kiểm tra và duyệt phiếu hiện tại trước khi ghi nhận đợt hàng tiếp theo.</div></div>
                <a class="btn btn-outline-primary" asp-controller="StockDocumentManagement" asp-action="Edit" asp-route-id="@pendingReceipt.Id"><i class="bx bx-show me-1"></i>Xem phiếu chờ duyệt</a>
            </div>
        }
        else if (receivingWorkbenchEnabled && Model.CanCreateReceipt && !Model.CanResolveItems)
        {
            <form method="post" asp-controller="PurchaseReceiving" asp-action="Start" asp-route-purchaseOrderId="@order.Id" class="mb-3">
                <button class="btn btn-primary" type="submit"><i class="bx bx-barcode-reader me-1"></i>@receivingActionTitle</button>
                <div class="form-text">Quét barcode bằng máy quét hoặc camera, nhập số lượng rồi tự động lưu theo đúng đơn vị.</div>
            </form>
        }
        @if (!receivingWorkbenchEnabled && Model.CanCreateReceipt && !Model.CanResolveItems)
        {
            @if (!receiptCandidateLines.Any(x => x.AvailableToAllocateQuantity > 0m) && receiptCandidateLines.Any(x => x.InFlightQuantity > 0m))
            {<div class="alert alert-warning">Toàn bộ số lượng còn lại đang nằm trong phiếu nhập chưa hoàn tất. Bạn vẫn có thể chủ động tạo Draft; phần vượt sẽ cần Manager/Admin xác nhận.</div>}
            <form method="post" asp-action="CreateReceipt" asp-route-id="@order.Id">
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Nhận</th><th>Dòng hàng</th><th>Số đặt</th><th>Đã nhập</th><th>Đang xử lý (đv gốc)</th><th>Còn theo kế hoạch (đv gốc)</th><th>Đã/Dự kiến vượt</th><th>Đơn vị nhận</th><th>Số nhận của phiếu mới</th><th>Xử lý phần thiếu</th><th>Lý do đóng thiếu</th></tr></thead>
                        <tbody>
                        @{var ri=0;}
                        @foreach(var line in receiptCandidateLines)
                        {
                            var defaultUnit = line.AllowedReceiptUnits.FirstOrDefault(x => x.IsOrderedUnit)
                                ?? line.AllowedReceiptUnits.FirstOrDefault();
                            var unavailable = defaultUnit == null || defaultUnit.MaximumEntryQuantity <= 0m;
                            var initiallyEnabled = !unavailable && line.AvailableToAllocateQuantity > 0m;
                            <tr class="receipt-row" data-base-unit="@line.BaseUnitName"
                                data-canonical-ordered="@PurchaseQuantityFormatter.Invariant(line.CanonicalOrderedQuantity)"
                                data-canonical-confirmed="@PurchaseQuantityFormatter.Invariant(line.CanonicalConfirmedReceivedQuantity)">
                                <td><input class="form-check-input receive-enabled" type="checkbox" checked="@initiallyEnabled" disabled="@(unavailable)" /></td>
                                <td>
                                    <input type="hidden" class="receipt-input receipt-index" name="Lines.Index" value="@ri" disabled="@(!initiallyEnabled)"/>
                                    <input type="hidden" class="receipt-input" name="Lines[@ri].PurchaseOrderLineId" value="@line.Id" disabled="@(!initiallyEnabled)"/>
                                    <div class="fw-semibold">@line.ProductName</div>
                                    <small class="text-muted">Đơn vị đặt: @line.UnitName × @PurchaseQuantityFormatter.Display(line.ConversionFactor) @line.BaseUnitName</small>
                                </td>
                                <td>@PurchaseQuantityFormatter.Display(line.OrderedQuantity) @line.UnitName</td>
                                <td>@PurchaseQuantityFormatter.Display(line.ConfirmedReceivedQuantity) @line.UnitName</td>
                                <td>@PurchaseQuantityFormatter.Display(line.InFlightQuantity) @line.BaseUnitName</td>
                                <td>@PurchaseQuantityFormatter.Display(line.AvailableToAllocateQuantity) @line.BaseUnitName</td>
                                <td><span class="text-danger">@PurchaseQuantityFormatter.Display(line.ConfirmedOverdeliveryQuantity)</span> / <span class="text-warning">@PurchaseQuantityFormatter.Display(line.ProjectedOverdeliveryQuantity)</span> @line.BaseUnitName</td>
                                <td>
                                    <select class="form-select receipt-input receipt-unit" name="Lines[@ri].ReceiptUnitId" disabled="@(!initiallyEnabled)" required>
                                        @foreach (var unit in line.AllowedReceiptUnits)
                                        {
                                            <option value="@unit.UnitId"
                                                    selected="@(unit.UnitId == defaultUnit?.UnitId)"
                                                    data-factor="@PurchaseQuantityFormatter.Invariant(unit.ConversionFactor)"
                                                    data-planned-max="@PurchaseQuantityFormatter.Invariant(unit.MaximumReceiptQuantity)"
                                                    data-entry-max="@PurchaseQuantityFormatter.Invariant(unit.MaximumEntryQuantity)">
                                                @unit.UnitName (× @PurchaseQuantityFormatter.Display(unit.ConversionFactor))
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control receipt-input receipt-quantity" type="number" min="0.001"
                                           max="@(defaultUnit == null ? "0" : PurchaseQuantityFormatter.Invariant(defaultUnit.MaximumEntryQuantity))"
                                           step="0.001" name="Lines[@ri].Quantity"
                                           value="@(defaultUnit == null ? "" : PurchaseQuantityFormatter.Invariant(defaultUnit.MaximumReceiptQuantity))"
                                           required disabled="@(!initiallyEnabled)"/>
                                    <small class="text-muted receipt-conversion">Tương đương: —</small>
                                    <small class="text-warning receipt-overdelivery d-block"></small>
                                </td>
                                <td><select class="form-select receipt-input" name="Lines[@ri].ShortageDisposition" disabled="@(!initiallyEnabled)"><option value="0">-- Không thiếu --</option><option value="1">Chờ giao bù</option><option value="2">Đóng phần thiếu</option></select></td>
                                <td><input class="form-control receipt-input" name="Lines[@ri].ShortageReason" maxlength="500" placeholder="Bắt buộc khi đóng thiếu" disabled="@(!initiallyEnabled)"/></td>
                            </tr>
                            ri++;
                        }
                        </tbody>
                    </table>
                </div>
                <div class="row g-2"><div class="col-md-3"><input class="form-control" type="date" name="DocumentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></div><div class="col-md-7"><input class="form-control" name="Note" placeholder="Ghi chú phiếu nhập"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Tạo phiếu nhập</button></div></div>
            </form>
        }
        </div></div>
    }

    <div class="pod-support-grid">
        <section class="card pod-card pod-support-card">
            <div class="pod-section-head"><div class="pod-section-icon is-green"><i class="bx bx-package"></i></div><div class="flex-grow-1"><h5>Phiếu nhập liên quan</h5><p>@order.Receipts.Count phiếu được tạo từ đơn này.</p></div></div>
            @if(!order.Receipts.Any())
            {
                <div class="pod-empty"><span><i class="bx bx-package"></i></span><strong>Chưa có phiếu nhập</strong><p>Phiếu nhập sẽ xuất hiện tại đây khi bắt đầu nhận hàng.</p></div>
            }
            else
            {
                <div class="pod-receipt-list">
                    @foreach(var receipt in order.Receipts)
                    {
                        <a class="pod-receipt-item" asp-controller="StockDocumentManagement" asp-action="Edit" asp-route-id="@receipt.Id">
                            <span class="pod-receipt-icon"><i class="bx bx-file"></i></span>
                            <span class="flex-grow-1"><strong>@receipt.DocumentNo</strong><small>@receipt.DocumentDate.ToString("dd/MM/yyyy")</small></span>
                            <span class="text-end"><span class="pod-receipt-status">@receipt.Status</span>@if(Model.CanViewCost){<small class="d-block">@Money(receipt.TotalAmount)</small>}</span>
                            <i class="bx bx-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        </section>
        <section class="card pod-card pod-support-card">
            <div class="pod-section-head"><div class="pod-section-icon is-blue"><i class="bx bx-history"></i></div><div class="flex-grow-1"><h5>Lịch sử xử lý</h5><p>Theo dõi người thực hiện và thời điểm thay đổi.</p></div></div>
            <div class="pod-timeline">
                @foreach(var action in order.Actions.OrderByDescending(x => x.OccurredAtUtc))
                {
                    <div class="pod-timeline-item"><span class="dot"></span><div class="flex-grow-1"><div class="pod-timeline-title"><strong>@PurchaseOrderPresentation.ActionLabel(action.ActionType)</strong><time>@action.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div><div class="pod-timeline-meta"><span>@action.ActorName</span><span>@PurchaseOrderPresentation.StatusLabel(action.FromStatus) <i class="bx bx-right-arrow-alt"></i> @PurchaseOrderPresentation.StatusLabel(action.ToStatus)</span></div>@if(!string.IsNullOrWhiteSpace(action.Note)){<div class="pod-timeline-note">@action.Note</div>}</div></div>
                }
            </div>
        </section>
    </div>
</div>

<div class="modal fade" id="purchaseOrderHelpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pod-help-modal">
            <div class="modal-header"><div><div class="pod-eyebrow">HƯỚNG DẪN NHANH</div><h5 class="modal-title">Xử lý đơn đặt hàng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="pod-help-grid">
                    <div><span>1</span><strong>Kiểm tra hàng hóa</strong><p>Đối chiếu đúng sản phẩm, đơn vị và số lượng trên từng dòng. Không cộng chung Hộp, Lốc hoặc các đơn vị khác nhau.</p></div>
                    <div><span>2</span><strong>Quản lý chọn nhà cung cấp</strong><p>Nhà cung cấp được chọn khi duyệt đơn. Nhân viên lập đơn không cần quyết định thông tin này.</p></div>
                    <div><span>3</span><strong>Gửi và nhận hàng</strong><p>Sau khi duyệt, đánh dấu đã gửi nhà cung cấp rồi tạo phiếu nhập khi hàng thực tế về kho.</p></div>
                    <div><span>4</span><strong>Xử lý chênh lệch</strong><p>Phần giao thiếu có thể tiếp tục chờ, đóng thiếu hoặc mở lại; mọi thao tác đều lưu trong lịch sử.</p></div>
                </div>
            </div>
            <div class="modal-footer justify-content-between"><small class="text-muted"><kbd>F1</kbd> mở hướng dẫn · <kbd>Ctrl+Enter</kbd> thao tác chính</small><button class="btn btn-primary" type="button" data-bs-dismiss="modal">Đã hiểu</button></div>
        </div>
    </div>
</div>

@if (Model.CanReview && Model.IsCreatedByCurrentUser)
{
    <div class="modal fade" id="selfApprovalConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content pod-confirm-modal">
                <div class="pod-confirm-visual">
                    <span class="pod-confirm-icon"><i class="bx bx-user-check"></i></span>
                </div>
                <div class="modal-body text-center">
                    <div class="pod-eyebrow">XÁC NHẬN QUYẾT ĐỊNH</div>
                    <h4>Bạn đang duyệt đơn do mình lập</h4>
                    <p>Hệ thống cho phép thao tác theo quyền hiện tại và sẽ lưu rõ tài khoản của bạn trong lịch sử xử lý.</p>
                    <div class="pod-confirm-summary"><i class="bx bx-receipt"></i><span><small>Đơn đặt hàng</small><strong>@order.OrderNumber · @(string.IsNullOrWhiteSpace(order.Title) ? "Không có tiêu đề" : order.Title)</strong></span></div>
                </div>
                <div class="modal-footer pod-confirm-actions">
