            </div>
        </div>
    </div>
}

@if (Model.CanQuickCreateProduct)
{
    <div class="modal fade" id="poQuickCreateProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" id="poQuickCreateProductForm"
                      data-action-prefix="/admin/purchase-orders/@order.Id/lines/">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RowVersion" value="@order.RowVersion" />
                    <input type="hidden" name="Product.SupplierId" value="@order.SupplierId" />
                    <div class="modal-header">
                        <div>
                            <div class="small text-primary fw-semibold text-uppercase">Sản phẩm chờ hoàn thiện</div>
                            <h5 class="modal-title mb-0">Tạo hàng mới và liên kết</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info py-2 small">
                            Sản phẩm được dùng ngay cho mua/nhập kho nhưng chưa xuất hiện ở POS cho đến khi quản lý hoàn thiện danh mục.
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Tên sản phẩm</label>
                            <input class="form-control" id="poQuickProductName" name="Product.Name" maxlength="200" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Danh mục</label>
                            <select class="form-select" name="Product.CategoryId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var option in Model.QuickCreateOptions.Categories)
                                {
                                    <option value="@option.Id">@option.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Đơn vị gốc</label>
                            <select class="form-select" id="poQuickUnitId" name="Product.UnitId">
                                <option value="">-- Chọn đơn vị --</option>
                                @foreach (var option in Model.QuickCreateOptions.Units)
                                {
                                    <option value="@option.Id">@option.Text</option>
                                }
                                @if (Model.CanCreateUnit)
                                {
                                    <option value="__other">Đơn vị khác...</option>
                                }
                            </select>
                        </div>
                        @if (Model.CanCreateUnit)
                        {
                            <div class="mb-3 d-none" id="poQuickNewUnitWrap">
                                <label class="form-label required">Tên đơn vị khác</label>
                                <input class="form-control" id="poQuickNewUnitName" name="Product.NewUnitName" maxlength="200"
                                       placeholder="Ví dụ: khay, túi, can..." />
                            </div>
                        }
                        <div>
                            <label class="form-label">Ghi chú liên kết</label>
                            <input class="form-control" name="ResolutionNote" maxlength="500"
                                   value="Tạo nhanh từ dòng hàng mô tả trên đơn @order.OrderNumber" />
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <small class="text-muted">Ctrl+Enter: tạo · Esc: đóng</small>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-warning"><i class="bx bx-plus-circle me-1"></i>Tạo và liên kết</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if(Model.CanReview)
{
    <div class="modal fade" id="returnModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Return" asp-route-id="@order.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Trả đơn về chỉnh sửa</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label required">Nội dung cần chỉnh sửa</label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-warning">Xác nhận trả sửa</button></div></form></div></div></div>
    <div class="modal fade" id="rejectModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Reject" asp-route-id="@order.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Từ chối đơn đặt hàng</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-warning small">Đơn bị từ chối sẽ kết thúc. Yêu cầu mua nguồn vẫn gắn với đơn này và không thể tạo đơn đặt hàng thứ hai.</div><label class="form-label required">Lý do từ chối</label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger">Xác nhận từ chối</button></div></form></div></div></div>
}
@if(Model.CanCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Cancel" asp-route-id="@order.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Hủy đơn đặt hàng</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Thao tác này kết thúc đơn. Nếu đơn đến từ yêu cầu mua, yêu cầu vẫn giữ liên kết với đơn đã hủy và không thể lập đơn thứ hai.</p><label class="form-label required">Lý do hủy</label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger">Xác nhận hủy</button></div></form></div></div></div>
}

@if (Model.CanCloseOutstanding)
{
    <div class="modal fade" id="closeAllOutstanding" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="CloseAllOutstanding" asp-route-id="@order.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Đóng toàn bộ phần còn thiếu</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-warning small">Các dòng đang có phiếu nhập chưa hoàn tất sẽ làm thao tác bị từ chối. Số lượng đã nhận không thay đổi.</div><label class="form-label required">Lý do đóng</label><textarea class="form-control" name="Reason" rows="4" maxlength="500" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-warning">Xác nhận đóng thiếu</button></div></form></div></div></div>
    @foreach (var line in order.Lines.Where(x => x.PendingQuantity > 0m))
    {
        <div class="modal fade" id="closeOutstandingLine@(line.Id)" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="CloseOutstandingLine" asp-route-id="@order.Id" asp-route-lineId="@line.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Đóng phần thiếu dòng @line.LineNo</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p class="mb-3"><strong>@line.ProductName</strong><br/>Phần còn thiếu: @PurchaseQuantityFormatter.Display(line.PendingQuantity) @line.UnitName</p><label class="form-label required">Lý do đóng</label><textarea class="form-control" name="Reason" rows="4" maxlength="500" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-warning">Xác nhận đóng thiếu</button></div></form></div></div></div>
    }
}

@if (Model.CanReopenOutstanding)
{
    <div class="modal fade" id="reopenAllOutstanding" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="ReopenAllOutstanding" asp-route-id="@order.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Mở lại toàn bộ phần đã đóng</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Phần đã đóng sẽ trở lại số lượng còn chờ; số lượng đã nhận không thay đổi.</p><label class="form-label">Ghi chú</label><textarea class="form-control" name="Reason" rows="3" maxlength="500" placeholder="Không bắt buộc"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Xác nhận mở lại</button></div></form></div></div></div>
    @foreach (var line in order.Lines.Where(x => x.ShortClosedQuantity > 0m))
    {
        <div class="modal fade" id="reopenOutstandingLine@(line.Id)" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="ReopenOutstandingLine" asp-route-id="@order.Id" asp-route-lineId="@line.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@order.RowVersion"/><div class="modal-header"><h5 class="modal-title">Mở lại phần đã đóng dòng @line.LineNo</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p class="mb-3"><strong>@line.ProductName</strong><br/>Phần mở lại: @PurchaseQuantityFormatter.Display(line.ShortClosedQuantity) @line.UnitName</p><label class="form-label">Ghi chú</label><textarea class="form-control" name="Reason" rows="3" maxlength="500" placeholder="Không bắt buộc"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Xác nhận mở lại</button></div></form></div></div></div>
    }
}

@section VendorScripts { <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script> }
@section PageScripts { <script src="~/Admin/js/purchase-order-details.js" asp-append-version="true"></script> }
