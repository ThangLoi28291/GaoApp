@model GaoApp.Web.Areas.Admin.ViewModels.Delivery.DeliveryBillViewModel
@using System.Globalization
@{
    Layout = null; var d = Model.Delivery; var p = Model.Picking; var source = Model.SourceReceipt; var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal v) => v.ToString("N0", vi); string Price(decimal v) => v.ToString("N2", vi);
    string Exact(string value, string format) => decimal.Parse(value, CultureInfo.InvariantCulture).ToString(format, vi);
    var hasWork = p?.PickerUserId is not null;
    var approved = hasWork && p!.ApprovedRevision is not null && p.ApprovedTotalText is not null;
    var badge = d.State switch { "Created" => "CHỜ SOẠN · CHƯA THU TIỀN", "Picking" => "ĐANG SOẠN · CHƯA THU TIỀN", "AwaitingApproval" => "CHỜ DUYỆT · CHƯA THU TIỀN", "ReadyForHandover" when approved => "ĐÃ CHỐT SOẠN · CHƯA THU TIỀN", "HandedOver" => "ĐÃ BÀN GIAO", "Delivering" => "ĐANG GIAO", "AwaitingReconciliation" => "CHỜ ĐỐI SOÁT", "ReadyToSettle" => "CHỜ CHỐT THANH TOÁN", "CancellationPending" => "CHỜ XỬ LÝ HỦY", "Settled" => "ĐÃ CHỐT", "Cancelled" => "ĐÃ HỦY", _ => d.State };
    var no = 0;
    (string Label, decimal Amount)[] sourceDiscounts = source is null ? Array.Empty<(string Label, decimal Amount)>() : new[] {
        ("Giảm giá dòng hàng", source.LineDiscountTotal), ("Khuyến mãi sản phẩm", source.PromotionDiscountTotal),
        ("Giảm combo" + (string.IsNullOrWhiteSpace(source.ComboPromotionName) ? "" : " · " + source.ComboPromotionName), source.ComboDiscountTotal),
        ("Giảm cấp đơn", source.OrderDiscount), ("Giảm voucher", source.VoucherDiscountTotal)
    };
    var otherDiscount = source is null ? 0 : Math.Max(0, source.DiscountTotal - sourceDiscounts.Sum(x => x.Amount));
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="referrer" content="no-referrer" /><title>Phiếu giao @d.Code</title><link rel="stylesheet" href="~/Admin/css/delivery.css" asp-append-version="true" /></head>
<body class="delivery-bill-body">
    <nav class="delivery-print-toolbar"><span>Phiếu giao A5 · 148 × 210 mm</span><button id="deliveryPrint" type="button">In phiếu A5</button><a href="@Model.LookupUrl">Xem hồ sơ đơn</a></nav>
    <main class="delivery-sheet">
        <header class="delivery-bill-header"><div><strong>@Model.StoreName</strong><h1>PHIẾU GIAO HÀNG</h1><p>@d.Code · Bản @d.Revision</p></div><span class="delivery-badge">@badge</span></header>
        <div class="delivery-bill-meta"><span>@d.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")</span><span>Quầy: @Model.TerminalName · Nhân viên: @Model.EmployeeName</span><span>Kho nguồn: @Model.WarehouseName · Giỏ: #@d.SourceCartId</span></div>
        <section class="delivery-recipient"><strong>@d.RecipientName</strong><span>Điện thoại: @d.RecipientPhone</span><span>Giao đến: @d.RecipientAddress</span>@if (!string.IsNullOrWhiteSpace(d.Note)) { <span>Ghi chú: @d.Note</span> }</section>
        @if (hasWork) { <p class="delivery-bill-picking">Người soạn: @p!.PickerName · @(approved ? "Lượng đã duyệt" : "Bản soạn dự kiến — cần kiểm tra trước giao")</p> }
        <table class="delivery-lines delivery-bill-lines"><thead><tr class="delivery-bill-ident"><th colspan="5">Phiếu giao @d.Code · Bản @d.Revision</th></tr><tr><th>#</th><th>Hàng / ĐVT</th><th>@(hasWork ? approved ? "SL duyệt" : "SL dự kiến" : "SL")</th><th>Giá gốc / ĐVT</th><th>Sau giảm</th></tr></thead><tbody>
        @if (hasWork)
        {
            foreach (var line in p!.Lines.Where(x => approved ? x.ApprovedQuantityText is not null && x.ApprovedQuantityText != "0" : x.IsActive || !x.IsReplacement))
            {
                var quantity = approved ? line.ApprovedQuantityText! : line.PlannedQuantityText;
                var net = approved ? line.ApprovedNetText! : line.DraftNetText;
                var gross = decimal.Round(decimal.Parse(quantity, CultureInfo.InvariantCulture) * decimal.Parse(line.UnitPriceText, CultureInfo.InvariantCulture), 0, MidpointRounding.AwayFromZero);
                var reduction = gross - decimal.Parse(net, CultureInfo.InvariantCulture);
                <tr><td>@(++no)</td><td>@line.ItemName <small>@line.UnitName @(line.IsReplacement ? "· Hàng thay thế" : "")</small>
                    @if (reduction > 0) { <small class="delivery-bill-discount">Giá gốc: @Money(gross) đ · Giảm giá đã phân bổ: −@Money(reduction) đ</small> }
                </td><td>@Exact(quantity, "0.####")</td><td>@Exact(line.UnitPriceText, "N2")</td><td><strong>@Exact(net, "N0")</strong></td></tr>
            }
        }
        else if (source is not null)
        {
            foreach (var line in source.Lines) {
                <tr><td>@(++no)</td><td>@line.ItemName <small>@(line.SellingUnitName ?? line.UnitName)</small>
                    @if (line.LineDiscount > 0) { <small class="delivery-bill-discount">Giảm dòng: −@Money(line.LineDiscount) đ</small> }
                    @if (line.PromotionDiscount > 0) { <small class="delivery-bill-discount">Khuyến mãi @(line.PromotionName ?? "sản phẩm"): −@Money(line.PromotionDiscount) đ</small> }
                    @if (line.IsPromotionGift) { <small>Hàng tặng · @line.GiftPromotionName</small> }
                    @if (!string.IsNullOrWhiteSpace(line.ComboPromotionName)) { <small>Combo @line.ComboPromotionName · giảm tại tổng đơn</small> }
                </td><td>@line.Quantity.ToString("0.####", vi)</td><td>@Price(line.UnitPrice)</td><td><small>Gốc @Money(line.GrossAmount)</small><strong>@Money(line.LineTotal)</strong></td></tr>
            }
        }
        else
        { foreach (var line in d.Lines) { <tr><td>@(++no)</td><td>@line.ItemName <small>@line.UnitName</small></td><td>@line.OrderedQuantity.ToString("0.####", vi)</td><td>@Price(line.UnitPrice)</td><td>@Money(line.Net)</td></tr> } }
        </tbody></table>
        @if (source is not null) {
            <section class="delivery-bill-source-breakdown">
                <h2>@(hasWork ? "Giá trị nguồn khi lập đơn · để đối chiếu" : "Chi tiết giá trị khi lập đơn")</h2>
                @if (hasWork) { <p>Giá trị nguồn đã lưu khi lập đơn; tổng lượng soạn hiện tại ở phần cuối phiếu.</p> }
                <dl class="delivery-bill-breakdown"><div><dt>Tiền hàng gốc</dt><dd>@Money(source.Subtotal) đ</dd></div>
                    @foreach (var discount in sourceDiscounts.Where(x => x.Amount > 0)) { <div><dt>@discount.Label</dt><dd>−@Money(discount.Amount) đ</dd></div> }
                    @if (otherDiscount > 0) { <div><dt>Giảm giá khác</dt><dd>−@Money(otherDiscount) đ</dd></div> }
                    @if (hasWork) { <div class="delivery-source-total"><dt>Giá trị dự kiến khi lập đơn</dt><dd>@Money(source.GrandTotal) đ</dd></div> }
                </dl>
            </section>
        }
        <section class="delivery-bill-summary"><div class="delivery-bill-total"><span>@(hasWork ? approved ? "Giá trị lượng đã duyệt" : "Giá trị bản soạn dự kiến" : "Giá trị dự kiến khi lập đơn")</span><strong>@(hasWork ? Exact(approved ? p!.ApprovedTotalText! : p!.DraftTotalText, "N0") : Money(source?.GrandTotal ?? d.QuotedTotal)) đ</strong></div>
        @if (hasWork) { <p class="delivery-payment-note">@if (source is null) { <span>Giá trị gốc khi lập đơn: @Exact(p!.QuotedTotalText, "N0") đ. </span> }@(approved ? "Chỉ giao theo lượng đã duyệt trên bản này." : "Bản này chưa xác nhận lượng được giao.")</p> }
        <p class="delivery-payment-note">Thanh toán theo lượng thực giao. Giá trị trên phiếu chưa phải số tiền đã thu.</p>
        <footer class="delivery-bill-footer"><img id="deliveryQr" src="@Model.QrDataUrl" alt="QR tra hồ sơ đơn giao @d.Code" /><div><strong>Quét QR để tra đơn</strong><p>Dùng cho soạn và giao hàng.<br />Có thể nhập mã đơn khi không quét được.</p><b>@d.Code</b></div></footer>
        </section>
    </main><script src="~/Admin/js/delivery.bill.js" asp-append-version="true"></script>
</body></html>
