@{ ViewData["Title"] = "Đơn giao hàng"; Layout = "_ContentNavbarLayout"; }
@section VendorStyles {
    <link rel="stylesheet" href="~/Admin/css/delivery.workspace.css" asp-append-version="true" />
}
<main class="dd" id="deliveryDesk" data-store="@ViewData["DeliveryStoreId"]" data-actor="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" aria-labelledby="ddTitle">
    @Html.AntiForgeryToken()
    <header class="dd-heading">
        <div><p class="dd-eyebrow">TỪ BILL ĐẾN BÀN GIAO TẠI QUẦY</p><h1 id="ddTitle">Đơn giao hàng</h1><p>Soạn hàng, giao đi và nhận lại hàng · tiền trong một nơi.</p></div>
        <a class="dd-button dd-button--primary" href="/admin/pos"><i class="bx bx-plus" aria-hidden="true"></i>Tạo đơn tại POS</a>
    </header>
    <nav class="dd-stages" aria-label="Các bước của đơn giao">
        <button type="button" data-dd-stage="picking" aria-pressed="true"><span class="dd-step">1</span><span>Chờ soạn<small>Kiểm hàng theo bill</small></span><b data-dd-count="picking">—</b></button>
        <button type="button" data-dd-stage="ready" aria-pressed="false"><span class="dd-step">2</span><span>Chờ giao<small>Chọn người mang đi</small></span><b data-dd-count="ready">—</b></button>
        <button type="button" data-dd-stage="delivering" aria-pressed="false"><span class="dd-step">3</span><span>Đang giao<small>Về quầy nhận bàn giao</small></span><b data-dd-count="delivering">—</b></button>
        <button type="button" data-dd-stage="completed" aria-pressed="false"><span class="dd-step">4</span><span>Hoàn tất<small>Đã chốt hàng và tiền</small></span><b data-dd-count="completed">—</b></button>
    </nav>
    <div class="dd-toolbar">
        <form id="ddSearch" role="search"><label class="visually-hidden" for="ddQuery">Tìm hoặc quét đơn giao</label><i class="bx bx-search" aria-hidden="true"></i><input id="ddQuery" type="search" maxlength="2048" placeholder="Tên khách, điện thoại, địa chỉ, mã đơn hoặc QR…" autocomplete="off" /><button class="dd-button" type="submit">Tìm đơn</button></form>
        <button type="button" class="dd-attention" data-dd-stage="attention" aria-pressed="false"><i class="bx bx-error-circle" aria-hidden="true"></i>Cần xử lý <b data-dd-count="attention">—</b></button>
        <button type="button" class="dd-button" id="ddRefresh" aria-label="Làm mới danh sách đơn"><i class="bx bx-refresh" aria-hidden="true"></i></button>
    </div>
    <div id="ddMessage" class="dd-message" role="status" aria-live="polite" hidden></div>
    <section id="ddPending" class="dd-pending" aria-label="Yêu cầu chưa xác nhận" hidden></section>
    <div class="dd-layout">
        <aside class="dd-list-panel" aria-labelledby="ddListTitle">
            <div class="dd-list-heading"><div><h2 id="ddListTitle">Đơn chờ soạn</h2><span id="ddListCount" aria-live="polite">Đang tải…</span></div><button type="button" class="dd-button dd-button--primary" id="ddBulkDispatch" hidden>Giao cùng người <span id="ddSelectedCount">0</span></button></div>
            <div id="ddList" class="dd-list" aria-busy="true"></div>
            <div class="dd-pagination"><button type="button" class="dd-button" id="ddPrev" aria-label="Trang trước">←</button><span id="ddPage">Trang 1</span><button type="button" class="dd-button" id="ddNext" aria-label="Trang tiếp">→</button></div>
        </aside>
        <section class="dd-detail" id="ddDetail" aria-label="Công việc của đơn đã chọn"><div class="dd-empty"><i class="bx bx-package" aria-hidden="true"></i><h2>Chọn một đơn để bắt đầu</h2><p>Mỗi bước hiển thị đúng việc cần làm tiếp theo.</p></div></section>
    </div>
    <dialog class="dd-dialog" id="ddDispatch" aria-labelledby="ddDispatchTitle">
        <form id="ddDispatchForm">
            <header><div><p class="dd-eyebrow">BÀN GIAO VÀ XUẤT PHÁT</p><h2 id="ddDispatchTitle">Giao hàng</h2></div><button type="button" class="dd-button" id="ddDispatchClose" aria-label="Đóng cửa sổ giao hàng">×</button></header>
            <div id="ddDispatchOrders" class="dd-dispatch-orders"></div>
            <label class="dd-field">Người giao<select id="ddCourier" required><option value="">Chọn người giao…</option></select></label>
            <label class="dd-field">Ghi chú chuyến <small>Không bắt buộc</small><textarea id="ddDispatchNote" maxlength="500" rows="2"></textarea></label>
            <label class="dd-confirm"><input id="ddDispatchConfirmed" type="checkbox" required /><span>Đã kiểm hàng, người giao được chọn đã nhận đủ hàng và bắt đầu đi giao.</span></label>
            <p class="dd-help">Có thể chọn nhiều đơn để cùng một người mang đi.</p>
            <p id="ddDispatchMessage" role="status" class="dd-form-message"></p>
            <footer><button type="button" class="dd-button" id="ddDispatchCancel">Để sau</button><button type="submit" class="dd-button dd-button--primary" id="ddDispatchSubmit">Xác nhận giao hàng</button></footer>
        </form>
    </dialog>
</main>
@section PageScripts {
    <script src="~/Admin/js/delivery.trip.js" asp-append-version="true"></script>
    <script src="~/Admin/js/delivery.workspace.js" asp-append-version="true"></script>
}
