@{ ViewData["Title"] = "Đơn giao hàng"; Layout = "_ContentNavbarLayout"; }
@section VendorStyles { <link rel="stylesheet" href="~/Admin/css/delivery.css" asp-append-version="true" /><link rel="stylesheet" href="~/Admin/css/delivery-picking.css" asp-append-version="true" /> }
<div class="delivery-workspace delivery-picking-workspace" data-actor="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)" data-store="@(ViewData["DeliveryStoreId"])">
    <div class="delivery-heading"><div><h2>Soạn hàng</h2><p>Nhập lượng thực có, lưu rồi gửi chốt.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" href="/admin/deliveries/trips">Chuyến giao</a><a class="btn btn-outline-primary" href="/admin/pos">Về POS</a></div></div>
    <form id="deliverySearch" class="delivery-search"><label for="deliveryKey">Tìm đơn</label><div class="d-flex gap-2"><input id="deliveryKey" class="form-control" placeholder="Quét QR hoặc nhập mã đơn…" autocomplete="off" required maxlength="2048" /><button class="btn btn-primary">Mở đơn</button></div></form>
    <div id="deliveryPageMessage" class="my-3" role="status" aria-live="polite"></div>
    <div class="delivery-columns"><aside class="delivery-panel delivery-list-panel"><h4>Đơn gần đây</h4><button type="button" id="deliveryRefreshList" class="delivery-link-button">Làm mới</button><div id="deliveryRecent"></div></aside><section id="deliveryDetail" class="delivery-panel" hidden aria-label="Chi tiết soạn hàng"></section></div>
</div>
@section PageScripts { <script src="~/Admin/js/delivery.page.js" asp-append-version="true"></script> }
