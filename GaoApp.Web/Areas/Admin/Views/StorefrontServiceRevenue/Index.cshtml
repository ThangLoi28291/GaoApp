@model GaoApp.Web.Areas.Admin.Models.StorefrontServiceSettingPage
@{ ViewData["Title"] = "Chủ thể và thuế phí giao website"; }
<main class="container-fluid py-3 sf-operations" id="sf-service-setting-page"><h1>Chủ thể và thuế phí giao website</h1><p>Phí khách đã xác nhận là tổng gồm thuế. Cấu hình này xác định nguồn doanh thu dịch vụ riêng; không tăng tổng phải trả và không suy chủ thể từ kho hàng.</p><p>Phí bằng 0 không cần cấu hình. Phí có thuế khác 0 sẽ phát hành hóa đơn riêng theo chính sách làm tròn hiện có.</p><p>Quyền thu hộ của tài khoản ngân hàng cho chủ thể dịch vụ phải có trước khi tiếp nhận khoản tiền. Bổ sung quyền về sau không hợp thức hóa khoản nhận cũ.</p>
<div id="sf-operation-status" role="status" aria-live="polite"></div>@Html.AntiForgeryToken()
<form id="sf-service-setting-form" data-setting-version="@Model.Setting?.Version"><label>Tên dịch vụ<input name="name" value="@(Model.Setting?.Name ?? "Phí dịch vụ giao hàng")" maxlength="200" required /></label><label>Chủ thể pháp lý ghi nhận phí<select name="legalEntityId" required><option value="">Chọn chủ thể</option>@foreach (var item in Model.LegalEntities) { <option value="@item.Id" selected="@(item.Id == Model.Setting?.LegalEntityId)">@item.Name</option> }</select></label><label>Thuế dịch vụ<select name="taxId" required><option value="">Chọn thuế đã cấu hình</option>@foreach (var tax in Model.Taxes) { <option value="@tax.Id" selected="@(tax.Id == Model.Setting?.TaxId)">@tax.Name</option> }</select></label><label>Tuyến hóa đơn<select name="invoiceRoute"><option value="1" selected="@(Model.Setting?.InvoiceRoute != GaoApp.Domain.Enums.InvoiceIssuanceRoute.Manual)">Hàng đợi phát hành tự động</option><option value="2" selected="@(Model.Setting?.InvoiceRoute == GaoApp.Domain.Enums.InvoiceIssuanceRoute.Manual)">Phát hành thủ công theo quyền hóa đơn</option></select></label>@if (Model.CanManage) { <button class="btn btn-success" type="submit">Lưu chủ thể, thuế và nguồn dịch vụ</button> } else { <p>Bạn có quyền xem; cần quyền sửa cấu hình website để lưu.</p> }</form><p><a href="/admin/storefront/fulfillment">Về đơn website</a></p><p>Đường dẫn cấu hình: <code>/admin/storefront/service-revenue</code>; tự thêm menu nếu cần.</p></main>
@section PageStyles { <link rel="stylesheet" href="~/Admin/css/storefront-fulfillment.css" asp-append-version="true" /> }
@section Scripts { <script src="~/Admin/js/storefront-fulfillment.js" asp-append-version="true" defer></script> }
