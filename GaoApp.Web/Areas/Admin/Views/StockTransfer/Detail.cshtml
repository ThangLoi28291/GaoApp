@using GaoApp.Application.Common.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Chi tiết phiếu chuyển kho";
    Layout = "_ContentNavbarLayout";

    var stockTransferDocumentId = ViewBag.StockTransferId;

    var canUpdate = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Inventory.StockTransfer.Update)).Succeeded;

    var canDelete = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Inventory.StockTransfer.Delete)).Succeeded;

    var canApprove = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Inventory.StockTransfer.Approve)).Succeeded;

    var canConfirm = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Inventory.StockTransfer.Confirm)).Succeeded;
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="~/Admin/css/stock-transfer.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y st-page">
    <input type="hidden" id="StockTransferDocumentId" value="@stockTransferDocumentId" />

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <div>
            <h4 class="mb-1 st-page-title">
                <i class="bx bx-transfer-alt me-1"></i>
                Chi tiết phiếu chuyển kho
            </h4>
            <div class="st-page-subtitle">
                Alt+A thêm sản phẩm · Ctrl+S lưu · Ctrl+Enter gửi duyệt/xác nhận
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/stock-transfers" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>

            @if (canUpdate)
            {
                <button type="button" class="btn btn-warning" id="btnSubmitStockTransfer">
                    <i class="bx bx-send me-1"></i> Gửi duyệt
                </button>
            }

            @if (canConfirm)
            {
                <button type="button" class="btn btn-success" id="btnConfirmStockTransfer">
                    <i class="bx bx-check-circle me-1"></i> Xác nhận
                </button>
            }

            @if (canApprove)
            {
                <button type="button" class="btn btn-danger" id="btnRejectStockTransfer">
                    <i class="bx bx-x-circle me-1"></i> Từ chối
                </button>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Số dòng</div>
                <div class="st-summary-value" id="sumTransferTotalLines">0</div>
            </div>
        </div>

        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Loại SP</div>
                <div class="st-summary-value" id="sumTransferProductTypes">0</div>
            </div>
        </div>

        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Tổng SL</div>
                <div class="st-summary-value" id="sumTransferTotalQty">0</div>
            </div>
        </div>

        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Số phiếu</div>
                <div class="st-summary-value fs-6" id="sumTransferDocumentNo">---</div>
            </div>
        </div>

        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Kho nguồn</div>
                <div class="fw-bold text-truncate" id="sumTransferFromWarehouse">---</div>
            </div>
        </div>

        <div class="col-6 col-md-2">
            <div class="st-summary-box">
                <div class="st-summary-title">Kho đích</div>
                <div class="fw-bold text-truncate" id="sumTransferToWarehouse">---</div>
            </div>
        </div>
    </div>

    <div class="card st-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Thông tin phiếu</span>
            <span id="TransferStatusBadge"></span>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Số phiếu</label>
                    <input type="text" class="form-control" id="TransferDocumentNo" readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Ngày phiếu</label>
                    <input type="datetime-local" class="form-control" id="TransferDocumentDate" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Kho nguồn</label>
                    <select id="TransferFromWarehouseId" class="form-select"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Kho đích</label>
                    <select id="TransferToWarehouseId" class="form-select"></select>
                </div>

                <div class="col-12">
                    <label class="form-label">Ghi chú</label>
                    <textarea class="form-control" id="TransferDocumentNote" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    @if (canUpdate)
    {
        <div class="card st-card mb-4">
            <div class="card-header">
                <i class="bx bx-barcode-reader me-1"></i>
                Thêm nhanh sản phẩm
            </div>

            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">Sản phẩm / Barcode / SKU</label>
                        <select id="QuickTransferLookupInput" class="form-select"></select>

                        <div class="form-text">
                            Gõ tên sản phẩm, SKU hoặc quét barcode. Nếu chỉ có 1 kết quả thì Enter tự chọn.
                        </div>

                        <input type="hidden" id="SelectedTransferProductVariantId" />
                        <input type="hidden" id="SelectedTransferUnitId" />
                        <input type="hidden" id="SelectedTransferFactor" />
                    </div>


                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary w-100" id="btnQuickAddTransferLine">
                            <i class="bx bx-plus"></i> Thêm
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card st-card">
        <div class="card-header">
            Dòng chuyển kho
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sản phẩm</th>
                            <th class="st-mobile-hide">Barcode</th>
                            <th>Đơn vị</th>
                            <th class="text-end st-mobile-hide">Factor</th>
                            <th class="text-end">SL</th>
                            <th class="text-end st-mobile-hide">SL gốc</th>
                            <th class="st-mobile-hide">Ghi chú</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>

                    <tbody id="stockTransferLineTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Đang tải dữ liệu...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SỬA DÒNG -->
<div class="modal fade" id="editStockTransferLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content st-card">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bx bx-edit me-1"></i>
                    Sửa dòng chuyển kho
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="EditTransferLineId" />
                <input type="hidden" id="EditTransferVariantId" />

                <div class="mb-3">
                    <label class="form-label">Đơn vị</label>
                    <select id="EditTransferLineUnitId" class="form-select"></select>
                    <div class="form-text" id="EditTransferUnitInfo"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Số lượng</label>
                    <input type="number" id="EditTransferQty" class="form-control" min="0.001" step="0.001" />
                    <div class="form-text">Nhấn Enter để lưu nhanh.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ghi chú</label>
                    <textarea id="EditTransferLineNote" class="form-control" rows="3"></textarea>
                </div>

                <div class="text-danger small fw-semibold" id="EditTransferLineMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveEditTransferLine">
                    <i class="bx bx-save me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XÓA DÒNG -->
<div class="modal fade" id="deleteStockTransferLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content st-card">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="bx bx-trash me-1"></i>
                    Xóa dòng chuyển kho
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="DeleteTransferLineId" />

                <div class="fw-bold mb-1" id="DeleteTransferLineName">Dòng chuyển kho</div>
                <div class="text-muted">
                    Dòng này sẽ bị xóa khỏi phiếu. Bạn có chắc muốn tiếp tục?
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" id="btnConfirmDeleteTransferLine">
                    <i class="bx bx-trash me-1"></i> Xóa dòng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TỪ CHỐI -->
<div class="modal fade" id="rejectStockTransferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content st-card">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="bx bx-x-circle me-1"></i>
                    Từ chối phiếu chuyển kho
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Lý do từ chối</label>
                <textarea id="RejectTransferReason" class="form-control" rows="3"
                          placeholder="Nhập lý do để người tạo phiếu biết cần chỉnh gì..."></textarea>

                <div class="text-danger small fw-semibold mt-2" id="RejectTransferMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" id="btnConfirmRejectTransfer">
                    <i class="bx bx-x me-1"></i> Từ chối
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XÁC NHẬN ACTION -->
<div class="modal fade" id="stockTransferActionConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content st-card">
            <div class="modal-header">
                <h5 class="modal-title" id="StockTransferActionTitle">Xác nhận thao tác</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="text-muted" id="StockTransferActionMessage">
                    Bạn có chắc muốn thực hiện thao tác này?
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary" id="btnConfirmStockTransferAction">
                    <i class="bx bx-check me-1"></i> Đồng ý
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade st-modal" id="stockTransferLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 st-line-popup">
            <div class="modal-header border-0">
                <div>
                    <h5 class="modal-title fw-bold" id="TransferLineModalTitle">
                        Xác nhận chuyển kho sản phẩm
                    </h5>
                    <small class="text-muted" id="TransferLineModalSubtitle">
                        Nhập số lượng rồi nhấn Enter để lưu vào phiếu.
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="TransferLineModalMode" />
                <input type="hidden" id="TransferLineModalLineId" />
                <input type="hidden" id="TransferLineModalVariantId" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="st-popup-product-img-box">
                            <img id="TransferLineModalProductImage" src="" class="img-fluid st-popup-product-img d-none" />
                            <div id="TransferLineModalNoImage" class="st-popup-no-img">
                                <i class="bx bx-image fs-1"></i>
                                <div class="small">Chưa có ảnh</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-9">
                        <h5 id="TransferLineModalProductName" class="st-popup-product-title mb-3">-</h5>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="st-popup-info-box">
                                    <div class="st-popup-info-label">Barcode</div>
                                    <div class="st-popup-info-value" id="TransferLineModalBarcode">-</div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="st-popup-info-box">
                                    <div class="st-popup-info-label">ĐVT</div>
                                    <div class="st-popup-info-value" id="TransferLineModalUnitName">-</div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="st-popup-info-box">
                                    <div class="st-popup-info-label">Factor</div>
                                    <div class="st-popup-info-value" id="TransferLineModalFactor">1</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="st-popup-info-box">
                                    <div class="st-popup-info-label">Số lượng chuyển</div>
                                    <div class="st-popup-info-value" id="TransferLineModalQtyPreview">0</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="st-popup-info-box">
                                    <div class="st-popup-info-label">SL gốc quy đổi</div>
                                    <div class="st-popup-info-value" id="TransferLineModalBaseQtyPreview">0</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Số lượng chuyển</label>
                            <input type="number" id="TransferLineModalQty" class="form-control form-control-lg"
                                   value="1" min="0.001" step="0.001" inputmode="decimal" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Đơn vị</label>
                            <select id="TransferLineModalUnitSelect" class="form-select"></select>
                            <div class="form-text" id="TransferLineModalUnitInfo"></div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Ghi chú</label>
                            <textarea id="TransferLineModalNote" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="text-danger small mt-2" id="TransferLineModalMessage"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between border-0">
                <div class="small text-muted">Enter: lưu dòng · Esc: đóng</div>

                <button type="button" class="btn btn-primary px-4" id="btnSaveTransferLineModal">
                    <i class="bx bx-save me-1"></i> Lưu dòng
                </button>
            </div>
        </div>
    </div>
</div>
@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
}

@section PageScripts {
    <script>
        window.stockTransferPage = {
        mode: 'detail',
        stockTransferDocumentId: @stockTransferDocumentId,
        permissions: {
        canUpdate: @canUpdate.ToString().ToLowerInvariant(),
        canDelete: @canDelete.ToString().ToLowerInvariant(),
        canApprove: @canApprove.ToString().ToLowerInvariant(),
        canConfirm: @canConfirm.ToString().ToLowerInvariant()
        }
        };
    </script>

    <script src="~/Admin/js/stock-transfer.js" asp-append-version="true"></script>
}