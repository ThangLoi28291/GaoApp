@using GaoApp.Application.Common.Security
@using GaoApp.Web.Areas.Admin.ViewModels.ProductAttributes
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@model ProductAttributeIndexVM

@{
    ViewData["Title"] = "Thuộc tính sản phẩm";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    var canCreate = (await AuthorizationService.AuthorizeAsync(
        User,
        PermissionCodes.Catalog.ProductAttribute.Create)).Succeeded;
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">Danh sách thuộc tính sản phẩm</h3>
            </div>

            @if (canCreate)
            {
                <div class="gds-page-header__actions">
                    <a asp-area="Admin"
                       asp-controller="ProductAttribute"
                       asp-action="Create"
                       class="btn btn-primary gds-action-button gds-action-button--primary">
                        <i class="bx bx-plus" aria-hidden="true"></i>
                        <span>Thêm thuộc tính</span>
                    </a>
                </div>
            }
        </div>
    </div>
}

<div data-gao-ui="modern" data-layout-consistency>
  <div data-product-attribute-shell
       data-search-url="@Url.Action("Search", "ProductAttribute", new { area = "Admin" })"
       data-toggle-url="@Url.Action("ToggleStatus", "ProductAttribute", new { area = "Admin" })"
       data-delete-url="@Url.Action("DeleteAjax", "ProductAttribute", new { area = "Admin" })"
       data-page="@Model.Page"
       class="gds-page">

    <section class="gds-kpi-grid" aria-label="Tổng quan thuộc tính sản phẩm">
        <article class="gds-kpi-card gds-kpi-card--primary gds-kpi-card--wide-mobile">
            <div class="gds-kpi-card__icon is-primary" aria-hidden="true">
                <i class="bx bx-slider-alt"></i>
            </div>
            <div class="gds-kpi-card__body">
                <div class="gds-kpi-card__label">Tổng thuộc tính</div>
                <div id="productAttributeTotalCount" class="gds-kpi-card__value">@Model.TotalAttributeCount</div>
            </div>
        </article>

        <article class="gds-kpi-card gds-kpi-card--success">
            <div class="gds-kpi-card__icon is-success" aria-hidden="true">
                <i class="bx bx-check-circle"></i>
            </div>
            <div class="gds-kpi-card__body">
                <div class="gds-kpi-card__label">Đang hoạt động</div>
                <div id="productAttributeActiveCount" class="gds-kpi-card__value">@Model.ActiveAttributeCount</div>
            </div>
        </article>

        <article class="gds-kpi-card gds-kpi-card--neutral">
            <div class="gds-kpi-card__icon is-neutral" aria-hidden="true">
                <i class="bx bx-pause-circle"></i>
            </div>
            <div class="gds-kpi-card__body">
                <div class="gds-kpi-card__label">Ngừng hoạt động</div>
                <div id="productAttributeInactiveCount" class="gds-kpi-card__value">@Model.InactiveAttributeCount</div>
            </div>
        </article>
    </section>

    <section class="gds-section gds-section--compact" aria-label="Bộ lọc thuộc tính sản phẩm">
        <div class="gds-filter-bar">
            <div class="gds-filter-bar__search">
                <label for="txtSearch" class="form-label">Tìm kiếm</label>
                <div class="gds-search-field">
                    <i class="bx bx-search" aria-hidden="true"></i>
                    <input id="txtSearch"
                           class="form-control"
                           placeholder="Tìm theo mã hoặc tên thuộc tính..."
                           autocomplete="off"
                           value="@Model.SearchString" />

                    <button type="button"
                            id="btnClearSearch"
                            class="gds-search-field__clear d-none"
                            title="Xóa tìm kiếm"
                            aria-label="Xóa tìm kiếm">
                        <i class="bx bx-x" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="gds-filter-control">
                <label for="ddlStatus" class="form-label">Trạng thái</label>
                <select id="ddlStatus" class="form-select">
                    <option value="" selected="@(!Model.Status.HasValue)">Tất cả</option>
                    <option value="true" selected="@(Model.Status == true)">Đang hoạt động</option>
                    <option value="false" selected="@(Model.Status == false)">Ngừng hoạt động</option>
                </select>
            </div>

            <div class="gds-filter-control gds-filter-control--compact">
                <label for="ddlPageSize" class="form-label">Số dòng / trang</label>
                <select id="ddlPageSize" class="form-select">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    <option value="200" selected="@(Model.PageSize == 200)">200</option>
                </select>
            </div>
        </div>
    </section>

    <form id="antiForgeryForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div id="productAttributeTableWrapper"
         class="gds-results-region"
         aria-live="polite"
         aria-busy="false">
        @await Html.PartialAsync("_ProductAttributeTable", Model)
    </div>
  </div>
</div>

@section PageScripts {
    <script src="~/admin/js/product-attributes.index.js" asp-append-version="true"></script>
}
