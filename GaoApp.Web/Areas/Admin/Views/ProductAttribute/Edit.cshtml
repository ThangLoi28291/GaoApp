@using GaoApp.Web.Areas.Admin.ViewModels.ProductAttributes
@model ProductAttributeEditViewModel

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Thêm thuộc tính sản phẩm" : "Cập nhật thuộc tính sản phẩm";
    Layout = "_ContentNavbarLayout";
}


@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/catalog-editor.css" asp-append-version="true" />
}
<div class="catalog-editor">
    <nav class="ce-breadcrumb" aria-label="Đường dẫn">
        <a asp-area="Admin" asp-controller="ProductAttribute" asp-action="Index">Thuộc tính</a>
        <i class="bx bx-chevron-right" aria-hidden="true"></i>
        <span>@(isCreate ? "Tạo mới" : "Chỉnh sửa")</span>
    </nav>
    <header class="ce-header">
        <div><span class="ce-eyebrow">DANH MỤC SẢN PHẨM</span><h1>@ViewData["Title"]</h1><p>Định nghĩa đặc điểm giúp phân biệt các phiên bản sản phẩm.</p></div>
        <a asp-area="Admin" asp-controller="ProductAttribute" asp-action="Index" class="ce-back"><i class="bx bx-arrow-back" aria-hidden="true"></i> Quay lại danh sách</a>
    </header>
    <form asp-area="Admin" asp-controller="ProductAttribute" asp-action="@(isCreate ? "Create" : "Edit")" method="post" novalidate>
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.RowVersion)
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="ce-layout">
            <section class="ce-card" aria-labelledby="ce-details-title">
                <div class="ce-section-heading">
                    <span class="ce-icon"><i class="bx bx-slider-alt" aria-hidden="true"></i></span>
                    <div><h2 id="ce-details-title">Thông tin thuộc tính</h2><p>Các trường có dấu <span class="ce-required">*</span> là bắt buộc.</p></div>
                </div>
                <div class="ce-fields">
                    <div class="ce-field ce-full">
                        <label asp-for="Name">Tên thuộc tính <span class="ce-required">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Màu sắc, Kích cỡ, Dung tích" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger"></span>

                    </div>
<div class="ce-field ce-full">
                        <label asp-for="Code">Mã thuộc tính</label>
                        @if (isCreate)
                        {
                            <input asp-for="Code" class="form-control text-uppercase" placeholder="Tự động tạo nếu để trống" autocomplete="off" />
                        }
                        else
                        {
                            <input asp-for="Code" class="form-control text-uppercase" readonly />
                        }
                        <span asp-validation-for="Code" class="text-danger"></span>
                        <p class="ce-field-help">@(isCreate ? "Bạn có thể để trống để hệ thống tự sinh mã." : "Mã được giữ cố định sau khi tạo.")</p>
                    </div>
                </div>
            </section>
            <aside class="ce-side">
                <section class="ce-card ce-guide" aria-labelledby="ce-guide-title">
                    <span class="ce-icon"><i class="bx bx-slider-alt" aria-hidden="true"></i></span>
                    <span class="ce-eyebrow">GỢI Ý THIẾT LẬP</span>
                    <h2 id="ce-guide-title">Bắt đầu từ đặc điểm sản phẩm</h2><p>Tạo nhóm thuộc tính trước, sau đó thêm các giá trị cụ thể cho nhóm đó.</p><div class="ce-example">Màu sắc → Đỏ, Xanh</div>
                </section>
                <section class="ce-card ce-status-card">
                    <div class="ce-status-top"><h2>Đang hoạt động</h2>
                        <div class="form-check form-switch">
                            <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" aria-describedby="ce-Status-help" />
                            <label asp-for="Status" class="visually-hidden">Đang hoạt động</label>
                        </div>
                    </div>
                    <p id="ce-Status-help">Bật khi đang sử dụng. Tắt khi tạm ngừng sử dụng thuộc tính này.</p>
                </section>
            </aside>
        </div>
        <footer class="ce-actions">
            <span>Kiểm tra thông tin trước khi lưu.</span>
            <div>
                <a asp-area="Admin" asp-controller="ProductAttribute" asp-action="Index" class="btn ce-cancel">Hủy bỏ</a>
                <button type="submit" class="btn ce-save"><i class="bx bx-check" aria-hidden="true"></i> @(isCreate ? "Tạo thuộc tính" : "Lưu thay đổi")</button>
            </div>
        </footer>
    </form>

</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
