@{ ViewData["Title"] = "Kích hoạt máy tự phục vụ"; Layout = "_ContentNavbarLayout"; }
<div class="card mx-auto" style="max-width:760px"><div class="card-body"><h3>Kích hoạt @ViewBag.TerminalName</h3><p>Trên máy cảm ứng, mở <strong>/kiosk</strong> tại đúng địa chỉ cửa hàng rồi nhập khóa bên dưới.</p><label class="form-label">Khóa dùng một lần · Hết hạn sau 30 phút</label><textarea class="form-control" rows="3" readonly>@ViewBag.Key</textarea><p class="mt-3">Khóa chỉ hiện ở lần tạo này. Không đặt khóa vào đường dẫn hoặc chia sẻ cho khách.</p><a href="/admin/kiosks" class="btn btn-primary">Về quản lý quầy</a></div></div>
