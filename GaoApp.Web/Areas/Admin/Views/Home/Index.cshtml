@inject GaoApp.Web.Services.AdminNavigationProvider Navigation
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService HomePageAuthorization
@using Microsoft.AspNetCore.Authorization
@{
    ViewData["Title"] = "Trang chủ";
    var shortcuts = await Navigation.GetPinsAsync(ViewContext);
    var showBusinessOverview = (await HomePageAuthorization.AuthorizeAsync(User, null,
        GaoApp.Application.Common.Security.PermissionCodes.Report.Sales.View)).Succeeded;
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/gaoapp.mobile-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/gaoapp.desktop-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/gaoapp.mobile-employee-home.css" asp-append-version="true" />
}

@section PageScripts {
    <script src="~/Admin/js/gaoapp.mobile-home.js" asp-append-version="true"></script>
    <script src="~/Admin/js/gaoapp.desktop-home.js" asp-append-version="true"></script>
    <script src="~/Admin/js/gaoapp.desktop-employee.js" asp-append-version="true"></script>
}

@if (showBusinessOverview)
{
    @await Html.PartialAsync("~/Areas/Admin/Views/Home/_MobileOverview.cshtml", shortcuts)
}

@await Html.PartialAsync("~/Areas/Admin/Views/Home/_DesktopWorkspace.cshtml", shortcuts)
