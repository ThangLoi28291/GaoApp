@model GaoApp.Web.Areas.Admin.ViewModels.Invoices.ViettelInvoiceSyncIndexViewModel

@{
    ViewData["Title"] = "Đồng bộ hóa đơn Viettel";

    var q = Model.Query;
    var result = Model.Result;
}

<style>
    .sync-card {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
    }

    .stat-box {
        border: 1px solid #edf0f2;
        border-radius: 14px;
        padding: 16px;
        background: #fff;
        height: 100%;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1.1;
    }

    .stat-label {
        color: #697a8d;
        font-size: 13px;
    }

    .remote-table th {
        white-space: nowrap;
        font-size: 12px;
        text-transform: uppercase;
        color: #697a8d;
    }

    .remote-table td {
        vertical-align: middle;
    }
</style>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1 fw-bold">
                Đồng bộ hóa đơn Viettel
            </h3>
            <div class="text-muted">
                Lấy danh sách hóa đơn từ Viettel theo ngày và đối soát về GaoApp.
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Admin"
                   asp-controller="InvoiceDashboard"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                Dashboard hóa đơn
            </a>

            <a asp-area="Admin"
                   asp-controller="InvoiceIntegrationLog"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                Log tích hợp
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="alert alert-info">
        Chỉ nên đồng bộ tối đa 3 tháng/lần. Hệ thống chỉ cập nhật hóa đơn đã có trong GaoApp theo TransactionUuid hoặc số hóa đơn, không tự tạo hóa đơn bán ra mới.
    </div>

    <div class="card shadow-sm sync-card mb-3">
        <div class="card-header bg-white fw-semibold">
            Bộ lọc đồng bộ
        </div>

        <div class="card-body">
            <form method="post"
                  asp-area="Admin"
                  asp-controller="ViettelInvoiceSync"
                  asp-action="Index">
                @Html.AntiForgeryToken()

                <input type="hidden" name="UpdateLocalInvoices" value="false" />

                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">Từ ngày</label>
                        <input type="date"
                               name="FromDate"
                               value="@q.FromDate.ToString("yyyy-MM-dd")"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Đến ngày</label>
                        <input type="date"
                               name="ToDate"
                               value="@q.ToDate.ToString("yyyy-MM-dd")"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Số dòng/trang</label>
                        <select name="PageSize" class="form-select">
                            <option value="50" selected="@(q.PageSize == 50)">50</option>
                            <option value="100" selected="@(q.PageSize == 100)">100</option>
                            <option value="200" selected="@(q.PageSize == 200)">200</option>
                            <option value="500" selected="@(q.PageSize == 500)">500</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="UpdateLocalInvoices"
                                   name="UpdateLocalInvoices"
                                   value="true"
                                   checked="@q.UpdateLocalInvoices" />
                            <label class="form-check-label" for="UpdateLocalInvoices">
                                Cập nhật GaoApp
                            </label>
                        </div>
                    </div>

                    <div class="col-md-2 text-end">
                        <button type="submit"
                                class="btn btn-primary"
                                onclick="return confirm('Xác nhận đồng bộ danh sách hóa đơn từ Viettel?');">
                            Đồng bộ
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @if (result != null)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="stat-box">
                    <div class="stat-value">@result.TotalRemoteRows.ToString("N0")</div>
                    <div class="stat-label">Tổng Viettel trả về</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-box">
                    <div class="stat-value">@result.RemoteItemsLoaded.ToString("N0")</div>
                    <div class="stat-label">Đã tải về</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-box">
                    <div class="stat-value">@result.UpdatedLocalInvoices.ToString("N0")</div>
                    <div class="stat-label">Đã cập nhật GaoApp</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-box">
                    <div class="stat-value">@result.NotMatched.ToString("N0")</div>
                    <div class="stat-label">Không khớp local</div>
                </div>
            </div>
        </div>

        @if (result.Messages.Any())
        {
            <div class="alert alert-light border">
                @foreach (var message in result.Messages)
                {
                    <div>@message</div>
                }
            </div>
        }

        <div class="card shadow-sm sync-card">
            <div class="card-header bg-white fw-semibold">
                Danh sách hóa đơn Viettel vừa tải
            </div>

            <div class="table-responsive">
                <table class="table table-hover remote-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Số HĐ</th>
                            <th>Ngày phát hành</th>
                            <th>Người mua</th>
                            <th>TransactionUuid</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thanh toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!result.RemoteInvoices.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Không có hóa đơn Viettel trong khoảng ngày này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in result.RemoteInvoices.Take(200))
                            {
                                <tr>
                                    <td>
                                        <strong>@item.InvoiceNo</strong>
                                        <br />
                                        <small class="text-muted">
                                            @item.TemplateCode - @item.InvoiceSeri
                                        </small>
                                    </td>
                                    <td>@(item.IssueDateStr ?? "-")</td>
                                    <td>@(item.BuyerName ?? "-")</td>
                                    <td>
                                        <small>@(item.TransactionUuid ?? "-")</small>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @item.Total.ToString("N0")
                                    </td>
                                    <td>
                                        @if (item.State == 1 || item.StateCode == 1)
                                        {
                                            <span class="badge bg-success">Đã phát hành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">State @(item.State?.ToString() ?? "-")</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.PaymentStatusName ?? item.PaymentStatus?.ToString() ?? "-")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (result.RemoteInvoices.Count > 200)
            {
                <div class="card-footer bg-white text-muted">
                    Chỉ hiển thị 200 dòng đầu để màn hình nhẹ. Tổng tải: @result.RemoteInvoices.Count.ToString("N0") dòng.
                </div>
            }
        </div>
    }

</div>