@model GaoApp.Web.Areas.Admin.ViewModels.Products.BarcodeHistoryIndexVm

@{
    ViewData["Title"] = "Lịch sử barcode";
}

<div class="container-fluid" id="barcodeHistoryPage">
    <div class="row">
        <div class="col-12 col-xl-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Bộ lọc</h5>
                </div>
                <div class="card-body">
                    <form id="barcodeHistoryFilterForm">
                        <div class="mb-3">
                            <label class="form-label">Từ khóa</label>
                            <input type="text"
                                   class="form-control"
                                   name="Keyword"
                                   value="@Model.Filter.Keyword"
                                   placeholder="Barcode, sản phẩm, SKU, lý do, người đổi..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Loại thao tác</label>
                            <select class="form-select" name="ActionType">
                                <option value="">-- Tất cả --</option>
                                <option value="Assigned">Assigned</option>
                                <option value="Replaced">Replaced</option>
                                <option value="Deactivated">Deactivated</option>
                                <option value="Reactivated">Reactivated</option>
                                <option value="Imported">Imported</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Từ ngày</label>
                            <input type="datetime-local" class="form-control" name="FromUtc" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Đến ngày</label>
                            <input type="datetime-local" class="form-control" name="ToUtc" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Lọc</button>
                            <button type="button" class="btn btn-outline-secondary" id="btnResetFilter">Đặt lại</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Lịch sử barcode</h5>
                    <span class="text-muted small" id="barcodeHistorySummary">
                        Tổng: @Model.Result.TotalItems
                    </span>
                </div>

                <div class="card-body p-0">
                    <div id="barcodeHistoryList" style="max-height:75vh; overflow-y:auto;">
                        @if (Model.Result.Items.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">Chưa có dữ liệu lịch sử barcode.</div>
                        }
                        else
                        {
                            foreach (var item in Model.Result.Items)
                            {
                                <div class="barcode-history-item border-bottom py-3 px-3">
                                    <div class="d-flex justify-content-between gap-3">
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">
                                                @item.ProductName
                                                @if (!string.IsNullOrWhiteSpace(item.UnitName))
                                                {
                                                    <span class="text-muted">- @item.UnitName</span>
                                                }
                                            </div>

                                            <div class="small text-muted mt-1">
                                                SKU: @item.VariantSku
                                            </div>

                                            <div class="mt-2">
                                                <span class="badge bg-light text-dark border">@item.ActionType</span>
                                            </div>

                                            <div class="mt-2 small">
                                                <div><strong>Mã cũ:</strong> @(item.OldBarcode ?? "-")</div>
                                                <div><strong>Mã mới:</strong> @(item.NewBarcode ?? "-")</div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Reason))
                                            {
                                                <div class="mt-2 small text-muted">
                                                    <strong>Lý do:</strong> @item.Reason
                                                </div>
                                            }

                                            <div class="mt-2 small text-muted">
                                                Người đổi: @(item.ChangedByUserName ?? "-")
                                            </div>
                                        </div>

                                        <div class="text-muted small text-nowrap">
                                            @item.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div id="barcodeHistoryLoading" class="text-center py-3 d-none">
                        <span class="text-muted">Đang tải thêm...</span>
                    </div>

                    <div id="barcodeHistoryEnd"
                         class="text-center py-3 @(Model.Result.Page < Model.Result.TotalPages ? "d-none" : "")">
                        <span class="text-muted small">Đã tải hết dữ liệu.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.barcodeHistoryPage = {
            apiUrl: '/admin/api/barcode-history',
            page: @Model.Result.Page,
            pageSize: @Model.Result.PageSize,
            totalPages: @Model.Result.TotalPages
        };
    </script>
    <script src="~/admin/js/barcode-history.js"></script>
}