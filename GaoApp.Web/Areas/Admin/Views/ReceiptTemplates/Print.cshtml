@using System.Text.Json
@using GaoApp.Web.Services.Printing
@model ReceiptPrintModel
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Hóa đơn @Model.Receipt.OrderNumber</title>
<style>
    body{margin:0;background:#edf1ee;font-family:Arial,sans-serif}.receipt-print-toolbar{padding:14px 20px;background:white;border-bottom:1px solid #dce5df;display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:13px}.receipt-print-toolbar button,.receipt-print-toolbar a{padding:9px 14px;border:1px solid #ccd7cf;border-radius:7px;cursor:pointer;text-decoration:none;color:#234b38;background:white}.receipt-print-toolbar button{background:#234b38;color:white}.receipt-print-toolbar select{padding:8px;max-width:300px}.receipt-print-toolbar label{font-size:12px}#receiptCanvas{padding:24px;overflow:auto}#receiptPaper{display:block;border:0;background:white;margin:auto;box-shadow:0 8px 30px #173e2a16}#printFeedback{padding:10px 20px;font-size:13px;color:#52685b;white-space:pre-line}
</style>
<link rel="stylesheet" href="~/Admin/css/print-page.mobile.css" asp-append-version="true" />
<script src="~/Admin/js/print-page.mobile.js" asp-append-version="true" defer></script>
</head><body>
<span hidden data-ui22-print-page="ReceiptTemplates/Print"></span>
<div class="receipt-print-toolbar"><button type="button" id="printReceipt">In hóa đơn</button><span>Mẫu cửa hàng: <strong id="printTemplateName"></strong></span>
<a href="@Url.Content("~/admin/pos/printer-settings")" target="_blank" rel="noopener">Máy in của quầy</a>
@if (Model.CanManageTemplates) { <a href="@Url.Content("~/admin/receipt-templates")" target="_blank" rel="noopener">Quản lý mẫu hóa đơn</a> }
<button type="button" id="closeReceipt">Đóng</button><button type="button" id="useBrowserPrint" hidden>Dùng hộp thoại in Chrome</button><button type="button" id="downloadPrintDiagnostic" hidden>Tải báo cáo lỗi</button></div>
<div id="printFeedback" role="status"></div><div id="receiptCanvas"><iframe id="receiptPaper" title="Hóa đơn bán hàng" sandbox="allow-same-origin allow-modals"></iframe></div>
@if (!string.IsNullOrWhiteSpace(Model.InvoiceBuyerSelfServiceUrl))
{
    <form id="replaceInvoiceBuyerLink" action="/admin/pos/receipt/@Model.Receipt.OrderId/buyer-link/replace" method="post">
        @Html.AntiForgeryToken()
        <button type="submit">Thu hồi QR nhập hóa đơn cũ và cấp lại</button>
        <span>Chỉ dùng khi nghi lộ link. QR cũ sẽ bị vô hiệu; hạn nhập thông tin không đổi.</span>
        <p role="status" id="replaceInvoiceBuyerLinkStatus"></p>
    </form>
    <script src="~/Admin/js/printing/receipt.buyer-link.js" asp-append-version="true"></script>
}
<script id="receiptPrintData" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model, ReceiptTemplateService.Json))</script>
<script src="~/Admin/js/printing/qz-tray.js" asp-append-version="true"></script>
<script src="~/Admin/js/pos/qrcodegen.js"
        asp-append-version="true"></script>
<script src="~/Admin/js/printing/receipt.templates.js" asp-append-version="true"></script>
<script src="~/Admin/js/printing/print.lifecycle.js" asp-append-version="true"></script>
    <script src="~/Admin/js/printing/pos.printing.js" asp-append-version="true"></script>
<script src="~/Admin/js/printing/receipt.print-page.js" asp-append-version="true"></script>
</body></html>
