@model GaoApp.Web.Areas.Admin.Controllers.CustomerInboxPage
@{ Layout="_ContentNavbarLayout";ViewData["Title"]="Hộp thư chăm sóc khách hàng"; }
<link rel="stylesheet" href="~/Admin/css/customer-inbox.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/customer-feedback.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/Admin/css/customer-inbox.mobile.css" asp-append-version="true"/>
<div id="customerInbox" class="ci-root" data-base="@Url.Content("~/admin/customer-service")" data-store="@Model.Staff.StoreId" data-user="@Model.Staff.UserId" data-reply="@Model.Staff.CanReply.ToString().ToLowerInvariant()" data-manage="@Model.Staff.CanManage.ToString().ToLowerInvariant()" data-verify="@Model.Staff.CanVerify.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <header class="ci-heading"><div><p class="text-muted mb-1">@Model.StoreName · CSKH</p><h3>Hộp thư khách hàng</h3><p>Tiếp nhận đúng người. Giữ trọn cuộc trò chuyện.</p></div><div class="d-flex flex-wrap gap-2 align-items-start">@if(Model.Staff.CanManage){<a class="btn btn-outline-secondary" href="@Url.Content("~/admin/customer-service/quality")">Chất lượng CSKH</a>}<a class="btn btn-outline-secondary" href="@Url.Content("~/admin/customer-service/channels")">Kênh liên hệ</a><a class="btn btn-outline-secondary" href="@Url.Content("~/admin/assistant/quality")">Chất lượng trợ lý</a><a class="btn btn-outline-primary" href="@Url.Content("~/support")" target="_blank" rel="noopener">Mở trang chat khách ↗</a></div></header>
    @if(TempData["CustomerServiceResult"] is string notice){<div class="alert alert-info" role="status">@notice</div>}
    @if(Model.Staff.CanManage){<form class="ci-settings" method="post" action="@Url.Content("~/admin/customer-service/settings")">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Model.Settings.Version"/><label><input type="checkbox" name="enabled" value="true" checked="@Model.Settings.Enabled"/> Bật chat khách cho cửa hàng này</label><button class="btn btn-outline-primary">Lưu cấu hình</button><small>Đường dẫn chia sẻ: <strong>@Url.Content("~/support")</strong> trên tên miền cửa hàng. Khi bật, khách được tra tên hàng đang bán, giá lẻ và chính sách đã duyệt của cửa hàng. Mặc định tắt.</small></form>}
    <p id="ciNotice" class="ci-notice" role="status" aria-live="polite"></p>
    <div class="ci-grid"><aside class="ci-queue" aria-label="Danh sách hội thoại"><div class="ci-filter"><label class="form-label" for="ciSource">Nguồn hội thoại</label><select id="ciSource" class="form-select"><option value="all">Tất cả nguồn</option><option value="zalo-direct">Zalo cá nhân</option><option value="zalo-group">Nhóm Zalo</option><option value="facebook">Messenger</option><option value="web">Web</option></select><label class="form-label" for="ciFilter">Hàng chờ</label><select id="ciFilter" class="form-select"><option value="waiting">Chờ nhân viên</option><option value="human">Đang có nhân viên</option><option value="bot">Trợ lý tự động</option><option value="closed">Đã kết thúc</option><option value="all">Tất cả</option></select><button class="btn btn-outline-secondary" id="ciRefresh" type="button">Tải lại</button></div><div id="ciList" class="ci-list"></div><div class="ci-pages"><button id="ciPrevious" type="button">Trước</button><span id="ciPage">Trang 1</span><button id="ciNext" type="button">Sau</button></div></aside>
    <section class="ci-detail" aria-label="Nội dung hỗ trợ"><div id="ciEmpty" class="ci-empty"><span aria-hidden="true">✉</span><h4>Sẵn sàng tiếp nhận</h4><p>Chọn một hội thoại để xem lịch sử và nhận hỗ trợ. AI dừng trả lời ngay khi chuyển sang nhân viên.</p></div>
        <div id="ciConversation" hidden><div class="ci-customer"><h4 id="ciName"></h4><p id="ciContact"></p><small>Thông tin khách tự khai · chưa xác minh tài khoản/đơn hàng</small><p id="ciState"></p></div><div class="ci-actions"><button id="ciClaim" type="button">Tôi tiếp nhận</button><button id="ciRelease" type="button">Trả hàng chờ</button><button id="ciBot" type="button">Chuyển lại AI</button><button id="ciClose" type="button">Kết thúc</button></div>
            @if(Model.Staff.CanVerify){<details id="ciIdentity" class="ci-identity"><summary>Xác minh hồ sơ khách</summary><p>Chỉ cấp mã sau khi đối chiếu trực tiếp hoặc gọi lại số đã lưu trong hồ sơ. Tên/liên hệ trong chat chưa chứng minh danh tính.</p>
                <form id="ciCustomerFind"><label for="ciCustomerQuery">Mã khách hoặc số điện thoại trong hồ sơ</label><input id="ciCustomerQuery" class="form-control" minlength="3" maxlength="50" autocomplete="off" required/><button type="submit">Tìm hồ sơ</button></form>
                <form id="ciIdentityForm"><label for="ciIdentityCustomer">Chọn đúng khách đã đối chiếu</label><select id="ciIdentityCustomer" class="form-select" required><option value="">Chưa chọn hồ sơ</option></select>
                    <label for="ciIdentityMethod">Cách xác minh</label><select id="ciIdentityMethod" class="form-select"><option value="in_person">Đối chiếu trực tiếp tại quầy</option><option value="verified_callback">Gọi lại số trong hồ sơ và đối chiếu</option></select>
                    <label for="ciIdentityReference">Ghi nhận căn cứ xác minh (không chép giấy tờ)</label><input id="ciIdentityReference" class="form-control" minlength="8" maxlength="120" required/>
                    <label class="ci-identity-confirm"><input id="ciIdentityConfirm" type="checkbox" required/> Tôi đã đối chiếu đúng chủ hồ sơ qua kênh đáng tin cậy.</label><button id="ciIdentityIssue" type="submit">Cấp mã một lần</button>
                </form><p id="ciIdentityNotice" role="status"></p><output id="ciIdentityCode"></output><p>Đọc mã trực tiếp hoặc gửi qua kênh đã xác minh. Không dán mã vào hội thoại này. Mã có hạn 10 phút; cấp lại thu hồi mã/quyền cũ.</p><button id="ciIdentityRevoke" type="button">Thu hồi mã và quyền tra cứu</button>
            </details>}
            <div id="ciMessages" class="ci-messages" role="log" aria-live="polite"></div><form id="ciReplyForm" class="ci-compose"><label class="visually-hidden" for="ciReply">Nội dung trả lời khách</label><textarea id="ciReply" class="form-control" rows="3" maxlength="4000" placeholder="Nhận hội thoại trước khi trả lời khách."></textarea><div id="ciUpload" class="ci-upload" hidden><input id="ciAsset" type="file" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" hidden/><button id="ciAttach" type="button" aria-describedby="ciUploadHint">📎 Đính kèm</button><small id="ciUploadHint">JPG/PNG ≤ 10 MiB · PDF, Word, Excel ≤ 20 MiB · 1 tệp/lượt</small><div id="ciAssetPreview" hidden><img id="ciAssetImage" alt="Ảnh chuẩn bị gửi" hidden/><span id="ciAssetName"></span><button id="ciRemoveAsset" type="button" aria-label="Bỏ tệp đính kèm">Bỏ tệp ×</button></div></div><button id="ciSend" type="submit">Gửi trả lời ↗</button></form>
        </div>
    </section></div>
</div>
@section PageScripts {<script src="~/js/customer-feedback.js" asp-append-version="true"></script><script src="~/Admin/js/customer-inbox.js" asp-append-version="true"></script><script src="~/Admin/js/customer-verification.js" asp-append-version="true"></script><script src="~/Admin/js/customer-inbox.mobile.js" asp-append-version="true"></script>}