<section class="acb-lookup" id="acbLookup" data-order-id="@ViewBag.OrderId">
    @Html.AntiForgeryToken()
    <header class="acb-heading">
        <div class="acb-heading-title">
            <span class="acb-bank-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3 9 9-6 9 6H3ZM5 10v7m5-7v7m4-7v7m5-7v7M3 20h18" /></svg></span>
            <div><span class="acb-eyebrow">LỊCH SỬ THANH TOÁN</span><h1 id="acbLookupTitle">Chuyển khoản · Đơn #@ViewBag.OrderId</h1><p>Giao dịch ngân hàng và các lần tạo mã QR.</p></div>
        </div>
        <button type="button" class="acb-button acb-primary" id="acbRefresh"><span aria-hidden="true">↻</span> Tra cứu ACB</button>
    </header>
    <div class="acb-overview" id="acbLookupSummary" aria-label="Tóm tắt chuyển khoản"></div>
    <div class="acb-status" id="acbLookupStatus" role="status" aria-live="polite">Đang tải lịch sử chuyển khoản…</div>
    <div id="acbLookupResults"></div>
    <footer class="acb-footer">Chốt đơn và in bill tại đúng máy POS đã tạo QR, sau khi xác nhận đủ tiền. Chuyển khoản thủ công được hiển thị theo khoản thu đã ghi nhận trên hóa đơn.</footer>
</section>
