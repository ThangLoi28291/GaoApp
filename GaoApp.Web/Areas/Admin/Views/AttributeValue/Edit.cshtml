@using GaoApp.Web.Areas.Admin.ViewModels.AttributeValues
@model AttributeValueEditViewModel

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Thêm giá trị thuộc tính" : "Cập nhật giá trị thuộc tính";
    Layout = "_ContentNavbarLayout";
}

@section Header {
    <div class="av-page-header">
        <div>
            <div class="av-kicker">Catalog</div>
            <h3 class="mb-1 fw-bold">@ViewData["Title"]</h3>
            <div class="text-muted">
                @(isCreate
                    ? "Tạo giá trị mới cho thuộc tính sản phẩm như màu sắc, kích cỡ, dung tích..."
                    : "Cập nhật thông tin giá trị thuộc tính sản phẩm.")
            </div>
        </div>

        <div>
            <a asp-area="Admin"
                   asp-controller="AttributeValue"
                   asp-action="Index"
                   class="btn btn-label-secondary">
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>
        </div>
    </div>
}

@section PageStyles {
    <link rel="stylesheet" href="~/admin/css/attribute-values.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">

        <div class="card border-0 shadow-sm av-edit-card">
            <div class="card-body p-lg-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="av-edit-icon">
                        <i class="bx bx-purchase-tag"></i>
                    </div>

                    <div>
                        <h5 class="mb-1 fw-bold">Thông tin giá trị</h5>
                        <div class="text-muted small">
                            Các trường có dấu <span class="text-danger">*</span> là bắt buộc.
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <form asp-area="Admin"
                      asp-controller="AttributeValue"
                      asp-action="@(isCreate ? "Create" : "Edit")"
                      method="post"
                      novalidate>

                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.Id)
                    @Html.HiddenFor(x => x.RowVersion)

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="AttributeId" class="form-label fw-semibold">
                                Thuộc tính <span class="text-danger">*</span>
                            </label>

                            <select asp-for="AttributeId" class="form-select form-select-lg">
                                <option value="0">-- Chọn thuộc tính --</option>
                                @foreach (var a in Model.Attributes)
                                {
                                    <option value="@a.Id">@a.Name (@a.Code)</option>
                                }
                            </select>

                            <span asp-validation-for="AttributeId" class="text-danger small"></span>

                            <div class="form-text">
                                Ví dụ: Màu sắc, Kích cỡ, Dung tích...
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-semibold">
                                Mã giá trị
                            </label>

                            @if (isCreate)
                            {
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">
                                        <i class="bx bx-barcode"></i>
                                    </span>

                                    <input asp-for="Code"
                                           class="form-control text-uppercase"
                                           placeholder="Tự sinh nếu để trống"
                                           autocomplete="off" />
                                </div>

                                <div class="form-text">
                                    Có thể để trống, hệ thống sẽ tự sinh mã.
                                </div>
                            }
                            else
                            {
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">
                                        <i class="bx bx-lock-alt"></i>
                                    </span>

                                    <input asp-for="Code"
                                           class="form-control text-uppercase"
                                           readonly />
                                </div>

                                <div class="form-text">
                                    Mã đã tạo không nên sửa để tránh ảnh hưởng dữ liệu liên kết.
                                </div>
                            }

                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Tên giá trị <span class="text-danger">*</span>
                            </label>

                            <div class="input-group input-group-lg">
                                <span class="input-group-text">
                                    <i class="bx bx-text"></i>
                                </span>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Ví dụ: Đỏ, Xanh, Size M, 500ml..."
                                       autocomplete="off"
                                       autofocus />
                            </div>

                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="av-status-panel">
                                <div>
                                    <div class="fw-bold mb-1">Trạng thái sử dụng</div>
                                    <div class="text-muted small">
                                        Tắt trạng thái nếu không muốn giá trị này xuất hiện khi tạo sản phẩm mới.
                                    </div>
                                </div>

                                <div class="form-check form-switch av-big-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="Status" />

                                    <label class="form-check-label fw-semibold" asp-for="Status">
                                        Đang hoạt động
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="av-edit-footer mt-5">
                        <a asp-area="Admin"
                               asp-controller="AttributeValue"
                               asp-action="Index"
                               class="btn btn-label-secondary">
                            Hủy bỏ
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i>
                            @(isCreate ? "Tạo giá trị" : "Lưu thay đổi")
                        </button>
                    </div>
                </form>
                @if (!isCreate)
                {
                    <div class="av-audit-box mt-4">
                        <div class="av-audit-title">
                            <i class="bx bx-history me-1"></i> Nhật ký dữ liệu
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="av-audit-item">
                                    <div class="text-muted small">Ngày tạo</div>
                                    <div class="fw-semibold">
                                        @(Model.CreatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")
                                    </div>
                                    <div class="text-muted small">
                                        Người tạo: @(Model.CreatedBy?.ToString() ?? "Hệ thống")
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="av-audit-item">
                                    <div class="text-muted small">Cập nhật cuối</div>
                                    <div class="fw-semibold">
                                        @(Model.UpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")
                                    </div>
                                    <div class="text-muted small">
                                        Người sửa: @(Model.UpdatedBy?.ToString() ?? "Chưa có")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}