@using GaoApp.Application.Common.Security
@using GaoApp.Web.Areas.Admin.ViewModels.AttributeValues
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@model AttributeValueIndexVM

@{
    ViewData["Title"] = "Giá trị thuộc tính";
    Layout = "_ContentNavbarLayout";

    var canCreate = (await AuthorizationService.AuthorizeAsync(User, PermissionCodes.Catalog.AttributeValue.Create)).Succeeded;
}

@section header {
    <div class="av-page-header">
        <div>
            <div class="av-kicker">Catalog</div>
            <h3 class="mb-1 fw-bold">Giá trị thuộc tính</h3>
            <div class="text-muted">
                Quản lý màu sắc, kích cỡ, dung tích, phân loại sản phẩm.
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="Admin"
                   asp-controller="ProductAttribute"
                   asp-action="Index"
                   class="btn btn-label-secondary">
                <i class="bx bx-slider-alt me-1"></i> Thuộc tính
            </a>

            @if (canCreate)
            {
                <a asp-area="Admin"
                       asp-controller="AttributeValue"
                       asp-action="Create"
                       class="btn btn-primary">
                    <i class="bx bx-plus me-1"></i> Thêm giá trị
                </a>
            }
        </div>
    </div>
}

@section PageStyles {
    <link rel="stylesheet" href="~/admin/css/attribute-values.css" asp-append-version="true" />
}

<div class="av-shell"
     data-search-url="@Url.Action("Search", "AttributeValue", new { area = "Admin" })"
     data-toggle-url="@Url.Action("ToggleStatus", "AttributeValue", new { area = "Admin" })"
     data-delete-url="@Url.Action("DeleteAjax", "AttributeValue", new { area = "Admin" })">

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="av-stat-card">
                <div class="av-stat-icon bg-primary-subtle text-primary">
                    <i class="bx bx-purchase-tag"></i>
                </div>
                <div>
                    <div class="av-stat-label">Tổng giá trị</div>
                    <div class="av-stat-value">@Model.Paged.TotalItems</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="av-stat-card">
                <div class="av-stat-icon bg-success-subtle text-success">
                    <i class="bx bx-check-circle"></i>
                </div>
                <div>
                    <div class="av-stat-label">Đang hiển thị</div>
                    <div class="av-stat-value">Đang dùng</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="av-stat-card">
                <div class="av-stat-icon bg-info-subtle text-info">
                    <i class="bx bx-filter-alt"></i>
                </div>
                <div>
                    <div class="av-stat-label">Bộ lọc</div>
                    <div class="av-stat-value">Nhanh</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm av-filter-card">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">Thuộc tính</label>
                    <select id="ddlAttribute" class="form-select">
                        <option value="">Tất cả thuộc tính</option>
                        @foreach (var a in Model.Attributes)
                        {
                            <option value="@a.Id" selected="@(Model.AttributeId == a.Id)">
                                @a.Name (@a.Code)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select id="ddlStatus" class="form-select">
                        <option value="" selected="@(!Model.Status.HasValue)">Tất cả</option>
                        <option value="true" selected="@(Model.Status == true)">Đang hoạt động</option>
                        <option value="false" selected="@(Model.Status == false)">Ngưng giao dịch</option>
                    </select>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <div class="av-search-box">
                        <i class="bx bx-search"></i>
                        <input id="txtSearch"
                               class="form-control"
                               placeholder="Nhập mã hoặc tên giá trị..."
                               autocomplete="off"
                               value="@Model.SearchString" />

                        <button type="button"
                                id="btnClearSearch"
                                class="av-clear-search d-none"
                                title="Xóa tìm kiếm">
                            <i class="bx bx-x"></i>
                        </button>
                    </div>
                </div>
               

                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold">Số dòng</label>
                    <select id="ddlPageSize" class="form-select">
                        <option value="10" selected="@(Model.PageSize == 10)">10 dòng</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20 dòng</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50 dòng</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100 dòng</option>
                    </select>
                </div>

                <div class="col-lg-1 col-md-6 d-grid">
                    <button type="button" id="btnReload" class="btn btn-label-primary">
                        <i class="bx bx-refresh"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div id="attributeValueTableWrapper" class="mt-4">
        @await Html.PartialAsync("_AttributeValueTable", Model)
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content av-modal">
            <div class="modal-body text-center p-4">
                <div class="av-danger-icon mb-3">
                    <i class="bx bx-trash"></i>
                </div>

                <h5 class="fw-bold mb-2">Xóa giá trị?</h5>
                <div class="text-muted mb-3">
                    Giá trị <b id="deleteName"></b> sẽ bị xóa khỏi danh sách.
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-label-secondary w-50" data-bs-dismiss="modal">
                        Hủy
                    </button>
                    <button type="button" class="btn btn-danger w-50" id="btnConfirmDelete">
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/admin/js/attribute-values.index.js" asp-append-version="true"></script>
}