@using GaoApp.Application.Common.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Quản lý hộ kinh doanh";
    var canCreate = (await AuthorizationService.AuthorizeAsync(
        User, PermissionCodes.System.LegalEntity.Create)).Succeeded;
    var canUpdate = (await AuthorizationService.AuthorizeAsync(
        User, PermissionCodes.System.LegalEntity.Update)).Succeeded;
    var canPreflight = (await AuthorizationService.AuthorizeAsync(
        User, PermissionCodes.System.LegalEntity.Activate)).Succeeded;
}

<div id="legalEntityPage"
     data-can-create="@canCreate.ToString().ToLowerInvariant()"
     data-can-update="@canUpdate.ToString().ToLowerInvariant()"
     data-can-preflight="@canPreflight.ToString().ToLowerInvariant()">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1">Hộ kinh doanh / chủ thể pháp lý</h4>
            <p class="text-muted mb-0">
                Cấu hình HKD, kho bán, hóa đơn và thứ tự ưu tiên phía sau POS.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="WarehouseManagement"
               asp-action="Index">
                <i class="bx bx-buildings me-1"></i> Quản lý kho
            </a>
            @if (canCreate)
            {
                <button class="btn btn-primary" type="button" id="btnCreateLegalEntity">
                    <i class="bx bx-plus me-1"></i> Thêm HKD
                </button>
            }
        </div>
    </div>

    <div class="alert alert-warning d-flex flex-column flex-lg-row gap-3 align-items-lg-center mb-4" id="featureGateBanner">
        <i class="bx bx-shield-quarter fs-4"></i>
        <div class="flex-grow-1">
            <div class="fw-semibold" id="featureGateTitle">Multi LegalEntity đang tắt</div>
            <div class="small" id="featureGateMessage">
                Chạy preflight trước khi bật phân bổ tồn kho theo HKD.
            </div>
        </div>
        <div class="feature-state-control">
            @if (canPreflight)
            {
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="multiLegalEntityEnabled" disabled />
                    <label class="form-check-label fw-semibold" for="multiLegalEntityEnabled"
                           id="multiLegalEntityEnabledLabel">Đang tắt</label>
                </div>
                <div class="small text-muted" id="multiLegalEntityActivatedAt">
                    Chờ kết quả preflight
                </div>
            }
            else
            {
                <span class="badge bg-label-secondary" id="multiLegalEntityReadOnlyState">Chỉ xem</span>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 legal-stat-card">
                <div class="card-body">
                    <div class="text-muted small mb-1">Tổng HKD</div>
                    <div class="legal-stat-value" id="legalEntityTotal">--</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 legal-stat-card">
                <div class="card-body">
                    <div class="text-muted small mb-1">Đang hoạt động</div>
                    <div class="legal-stat-value text-success" id="legalEntityActive">--</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 legal-stat-card">
                <div class="card-body">
                    <div class="text-muted small mb-1">Đã có kho bán</div>
                    <div class="legal-stat-value text-primary" id="legalEntityWarehouseReady">--</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 legal-stat-card">
                <div class="card-body">
                    <div class="text-muted small mb-1">Đã có cấu hình HĐĐT</div>
                    <div class="legal-stat-value text-info" id="legalEntityInvoiceReady">--</div>
                </div>
            </div>
        </div>
    </div>

    @if (canPreflight)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent d-flex flex-column flex-md-row justify-content-between gap-2 align-items-md-center">
                <div>
                    <h5 class="mb-1">Activation preflight</h5>
                    <div class="text-muted small">Chỉ khi toàn bộ điều kiện đạt mới có thể bật feature.</div>
                </div>
                <button class="btn btn-outline-primary btn-sm" type="button" id="btnRefreshPreflight">
                    <i class="bx bx-refresh me-1"></i> Kiểm tra lại
                </button>
            </div>
            <div class="card-body">
                <div class="alert mb-3" id="preflightSummary">Đang kiểm tra...</div>
                <div class="row g-3" id="preflightChecks"></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4" id="canaryPanel">
            <div class="card-header bg-transparent d-flex flex-column flex-md-row justify-content-between gap-2 align-items-md-center">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0">Canary activation</h5>
                        <span class="badge bg-label-secondary" id="canaryHealthBadge">Đang tải</span>
                    </div>
                    <div class="text-muted small mt-1" id="canaryHealthMessage">
                        Theo dõi sai lệch và trạng thái vận hành từ lần kích hoạt gần nhất.
                    </div>
                </div>
                <div class="text-md-end small text-muted">
                    <div id="canaryMonitoringSince">Chưa có lần kích hoạt</div>
                    <div id="canaryEvaluatedAt"></div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4" id="canaryMetrics"></div>
                <div class="row g-4">
                    <div class="col-lg-7">
                        <h6 class="mb-3">Kiểm tra sức khỏe</h6>
                        <div class="d-grid gap-2" id="canaryHealthChecks">
                            <div class="text-muted small">Đang tải...</div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <h6 class="mb-3">Nhật ký bật/tắt gần đây</h6>
                        <div class="d-grid gap-2" id="canaryEvents">
                            <div class="text-muted small">Chưa có lịch sử.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
            <h5 class="mb-1">Danh sách HKD</h5>
            <div class="text-muted small">
                Số ưu tiên nhỏ hơn sẽ được cấp tồn trước khi allocation được kích hoạt ở phase sau.
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 legal-entity-table" id="legalEntityTable">
                <thead>
                    <tr>
                        <th class="text-center">Ưu tiên</th>
                        <th>HKD</th>
                        <th>Thông tin pháp lý</th>
                        <th>Kho bán mặc định</th>
                        <th>Hóa đơn điện tử</th>
                        <th class="text-center">Nhập mặc định</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="8" class="text-center text-muted py-5">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="legalEntityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form id="legalEntityForm">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="legalEntityModalTitle">Thêm HKD</h5>
                        <div class="text-muted small">Thông tin này chỉ hiển thị cho người có quyền quản lý.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="legalEntityId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="legalEntityCode">Mã HKD <span class="text-danger">*</span></label>
                            <input class="form-control text-uppercase" id="legalEntityCode" maxlength="50" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="legalEntityName">Tên hiển thị <span class="text-danger">*</span></label>
                            <input class="form-control" id="legalEntityName" maxlength="200" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="legalEntitySalePriority">Ưu tiên bán <span class="text-danger">*</span></label>
                            <input class="form-control" id="legalEntitySalePriority" type="number" min="1" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="legalEntityLegalName">Tên pháp lý <span class="text-danger">*</span></label>
                            <input class="form-control" id="legalEntityLegalName" maxlength="300" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="legalEntityTaxCode">Mã số thuế</label>
                            <input class="form-control" id="legalEntityTaxCode" maxlength="50" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="legalEntityAddress">Địa chỉ pháp lý</label>
                            <input class="form-control" id="legalEntityAddress" maxlength="1200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="legalEntityPhone">Điện thoại</label>
                            <input class="form-control" id="legalEntityPhone" maxlength="30" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="legalEntityEmail">Email</label>
                            <input class="form-control" id="legalEntityEmail" type="email" maxlength="320" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="legalEntityDefaultWarehouse">Kho bán mặc định</label>
                            <select class="form-select" id="legalEntityDefaultWarehouse"></select>
                            <div class="form-text" id="defaultWarehouseHelp">
                                Tạo HKD trước, sau đó tạo kho thuộc HKD ở màn Quản lý kho.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="legalEntityInvoiceSetting">Cấu hình hóa đơn điện tử</label>
                            <select class="form-select" id="legalEntityInvoiceSetting"></select>
                            <div class="form-text">Mỗi cấu hình chỉ được gán cho một HKD.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="legalEntityDefaultPurchase" />
                                <label class="form-check-label" for="legalEntityDefaultPurchase">
                                    Dùng làm HKD nhập hàng mặc định
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="legalEntityNote">Ghi chú</label>
                            <textarea class="form-control" id="legalEntityNote" rows="3" maxlength="1000"></textarea>
                        </div>
                    </div>
                    <div class="alert alert-danger d-none mt-3 mb-0" id="legalEntityError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveLegalEntity">Lưu HKD</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .legal-stat-card { border-radius: 16px; }
    .legal-stat-value { font-size: 1.8rem; line-height: 1.1; font-weight: 700; }
    .legal-entity-table thead th { background: #f5f5f9; color: #566a7f; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
    .legal-priority { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(105,108,255,.12); color: #696cff; font-weight: 700; }
    .legal-code { font-size: .75rem; font-weight: 700; color: #696cff; letter-spacing: .04em; }
    .legal-muted { color: #8592a3; font-size: .8rem; }
    .preflight-check { border: 1px solid #e7e7ff; border-radius: 14px; height: 100%; padding: 1rem; }
    .preflight-check.is-failed { border-color: rgba(255,62,29,.3); background: rgba(255,62,29,.035); }
    .feature-state-control { min-width: 210px; padding: .7rem .9rem; border: 1px solid rgba(86,106,127,.18); border-radius: 12px; background: rgba(255,255,255,.72); }
    .feature-state-control .form-check-input { width: 2.7rem; height: 1.35rem; cursor: pointer; }
    .canary-metric { border: 1px solid #ececf3; border-radius: 12px; padding: .85rem; height: 100%; }
    .canary-metric-value { font-size: 1.35rem; font-weight: 700; line-height: 1.1; }
    .canary-check, .canary-event { border: 1px solid #ececf3; border-radius: 12px; padding: .8rem .9rem; }
    .canary-check.is-failed-critical { border-color: rgba(255,62,29,.35); background: rgba(255,62,29,.04); }
    .canary-check.is-failed-warning { border-color: rgba(255,171,0,.35); background: rgba(255,171,0,.05); }
</style>

@section Scripts {
    <script src="~/admin/js/legal-entity-management.js" asp-append-version="true"></script>
}
