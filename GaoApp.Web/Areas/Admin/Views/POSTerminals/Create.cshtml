@model GaoApp.Web.Areas.Admin.ViewModels.POSTerminals.POSTerminalVm
@{ ViewData["Title"] = "Thêm máy POS"; }
<div class="row justify-content-center"><div class="col-12 col-lg-7">
    <a asp-action="Index" class="d-inline-block mb-3">← Quản lý máy POS</a>
    <div class="card"><div class="card-body p-4">
        <h3>Thêm máy POS</h3>
        <p class="text-muted">Máy mới sẽ xuất hiện trong danh sách chọn máy tại trang đăng nhập.</p>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label">Mã máy POS</label>
                <input asp-for="Code" class="form-control" placeholder="POS02" maxlength="30" autofocus />
                <span asp-validation-for="Code" class="text-danger"></span>
                <div class="form-text">Mã riêng trong cửa hàng, ví dụ POS01, POS02.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên máy / quầy</label>
                <input asp-for="Name" class="form-control" placeholder="Quầy thu ngân 2" maxlength="150" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="form-label">Ghi chú</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="300"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tạo máy POS</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div></div>
</div></div>
@section PageScripts { <partial name="_ValidationScriptsPartial" /> }
