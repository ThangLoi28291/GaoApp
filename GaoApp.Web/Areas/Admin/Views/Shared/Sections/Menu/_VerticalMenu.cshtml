@using GaoApp.Web.Areas.Admin.ViewModels.Commerce
@using System.Text.Json
@inject GaoApp.Web.Services.AdminNavigationProvider Navigation
@{
    TempData.Keep();
    var navigation = await Navigation.GetAsync(ViewContext);
    var storeId = navigation.StoreId;
    var userId = navigation.UserId;
    var canConfigureReceipts = navigation.IsStoreAdmin;
    var canManageMenus = navigation.CanManageMenus;
    var menus = navigation.Nodes;
    var configuredPins = await Navigation.GetPinsAsync(ViewContext);
    var mobileDefaults = await Navigation.GetMobileDefaultsAsync(ViewContext);
    var mobileTabs = configuredPins.Count > 0
        ? configuredPins.Select(item => new GaoApp.Web.Services.MobilePrimaryTab("", item.Title, item, item.IsCurrent)).ToArray()
        : mobileDefaults;
}
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme gao-admin-nav"
       data-bg-class="bg-menu-theme" data-admin-navigation data-gao-theme="commerce" aria-label="Menu điều hướng">
    <div class='app-brand demo @((ViewData["navbarFull"] != null && Convert.ToBoolean(ViewData["navbarFull"])) ? "d-xl-none" : "")'>
        <a href="@navigation.Home?.Href" class="app-brand-link">
            <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
            <span class="app-brand-text demo menu-text fw-bold ms-2">@TempData.Peek("appName")</span>
        </a>
        <button type="button" class="layout-menu-toggle menu-link text-large ms-auto gao-nav-close" aria-label="Đóng menu điều hướng" data-nav-close><i class="icon-base bx bx-x" aria-hidden="true"></i></button>
    </div>
    <div class="gao-nav-heading"><span>KHÔNG GIAN CỦA BẠN</span><h2>Menu</h2></div>
    @if (canManageMenus && canConfigureReceipts)
    {
        <div class="gao-mobile-pin-settings"><a href="@Url.Action("Index", "AdminMenuPins", new { area = "Admin" })"><i class="bx bx-pin" aria-hidden="true"></i>Chỉnh mục ghim<i class="bx bx-chevron-right" aria-hidden="true"></i></a></div>
    }
    <div class="gao-nav-search-region" data-nav-search-region hidden>
        <label class="gao-nav-search" for="admin-nav-search"><i class="bx bx-search" aria-hidden="true"></i><input id="admin-nav-search" type="search" placeholder="Tìm chức năng…" autocomplete="off" aria-label="Tìm trong menu của bạn" aria-describedby="admin-nav-search-status" /></label>
        <button type="button" class="gao-nav-clear" data-nav-clear hidden aria-label="Xóa tìm kiếm menu"><i class="bx bx-x" aria-hidden="true"></i></button>
    </div>
    <p id="admin-nav-search-status" class="gao-nav-status" data-nav-status role="status" hidden></p>
    <div class="menu-inner-shadow"></div>
    <ul class="menu-inner py-1" aria-label="Các nhóm và chức năng đã cấu hình">@await Html.PartialAsync("Sections/Menu/_NavigationItems", menus)</ul>
    @if (menus.Count == 0)
    {
        <div class="gao-nav-empty" data-nav-empty>
            <span class="gao-nav-empty-icon"><i class="bx bx-grid-alt" aria-hidden="true"></i></span>
            <strong>Chưa có menu để hiển thị</strong><p>Menu hiển thị theo cấu hình cửa hàng và quyền của bạn.</p>
            @if (canManageMenus)
            {
                <a href="@(Url.Action("Index", "AdminMenus", new { area = "Admin" }) ?? Url.Content("~/Admin/AdminMenus"))" class="gao-nav-manage">Mở Quản lý menu<i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
            }
        </div>
    }
    <div class="gao-nav-empty" data-nav-no-results hidden>
        <span class="gao-nav-empty-icon"><i class="bx bx-search" aria-hidden="true"></i></span>
        <strong>Không tìm thấy chức năng</strong><p>Thử tên khác hoặc tìm không dấu.</p><button type="button" class="gao-nav-manage" data-nav-reset>Đặt lại tìm kiếm</button>
    </div>
</aside>
@if (storeId > 0 && userId > 0)
{
    <nav class="gao-mobile-pins" data-mobile-pins data-gao-theme="commerce"
         data-pins-url="@Url.Action("Configured", "AdminMenuPins", new { area = "Admin" })" aria-label="Điều hướng chính trên điện thoại">
        <script type="application/json" data-mobile-pin-defaults>@Html.Raw(JsonSerializer.Serialize(mobileDefaults.Select(tab => new { id = tab.Menu.Id, key = tab.Key, label = tab.Label, current = tab.IsCurrent })))</script>
        @foreach (var tab in mobileTabs)
        {
            <a class="gao-mobile-pin" href="@tab.Menu.Href" data-mobile-pin-id="@tab.Menu.Id" title="@tab.Menu.Title" aria-label="@tab.Label" aria-current="@(tab.IsCurrent ? "page" : null)">
                <i class="icon-base @tab.Menu.Icon" aria-hidden="true"></i><span>@tab.Label</span>
            </a>
        }
        <button type="button" class="gao-mobile-pin layout-menu-toggle" data-pins-menu aria-controls="layout-menu" aria-label="Mở menu điều hướng" aria-current="@(!mobileTabs.Any(tab => tab.IsCurrent) ? "page" : null)" aria-expanded="false"><i class="icon-base bx bx-menu" aria-hidden="true"></i><span>Menu</span></button>
    </nav>
}
