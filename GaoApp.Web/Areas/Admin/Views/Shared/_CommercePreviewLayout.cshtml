@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>GaoApp · Bộ giao diện thương mại</title>
    @* Same legacy base styles as Admin: check opt-in compatibility before migrating real pages. *@
    @await Html.PartialAsync("Sections/_Styles")
    <link rel="stylesheet" href="~/Admin/css/gaoapp.ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/gaoapp.design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/gaoapp.commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/ui-foundation.preview.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="~/Admin/js/gaoapp.commerce.js" asp-append-version="true" defer></script>
    <script src="~/Admin/js/ui-foundation.preview.js" asp-append-version="true" defer></script>
</body>
</html>
