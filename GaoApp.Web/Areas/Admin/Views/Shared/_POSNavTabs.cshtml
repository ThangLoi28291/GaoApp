@inject GaoApp.Web.Services.AdminNavigationProvider Navigation
@{
    var navigation = await Navigation.GetAsync(ViewContext);
    var posMenus = navigation.PosNodes();
}

<link rel="stylesheet" href="~/Admin/css/pos/pos-navigation.css" asp-append-version="true" />

@if (posMenus.Count > 0)
{
    <nav class="pos-top-nav pos-workspace-nav" data-configured-pos-nav data-gao-theme="commerce" aria-label="Điều hướng POS của cửa hàng">
        @foreach (var item in posMenus)
        {
            if (item.Children.Count > 0)
            {
                <div class="dropdown pos-nav-group">
                    <button type="button" id="posNavToggle-@item.Id" class="pos-nav-button @(item.ContainsCurrent ? "active" : "")"
                            data-bs-toggle="dropdown" aria-expanded="false" aria-controls="posNavMenu-@item.Id">
                        <i class="@item.Icon pos-nav-icon" aria-hidden="true"></i><span>@item.Title</span>
                        <i class="bx bx-chevron-down pos-nav-chevron" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu pos-nav-menu" id="posNavMenu-@item.Id" aria-labelledby="posNavToggle-@item.Id" data-configured-pos-menu>
                        @await Html.PartialAsync("_ConfiguredPOSMenuItems", item.Children)
                    </ul>
                </div>
            }
            else if (navigation.IsCustomerDisplay(item))
            {
                <button type="button" class="pos-nav-button customer-display" data-configured-customer-display data-url="@item.Href" data-menu-id="@item.Id">
                    <i class="@item.Icon pos-nav-icon" aria-hidden="true"></i><span>@item.Title</span>
                </button>
            }
            else
            {
                <a href="@item.Href" class="pos-nav-link @(item.IsCurrent ? "active" : "")" data-menu-id="@item.Id" aria-current="@(item.IsCurrent ? "page" : null)">
                    <i class="@item.Icon pos-nav-icon" aria-hidden="true"></i><span>@item.Title</span>
                </a>
            }
        }
    </nav>
}
