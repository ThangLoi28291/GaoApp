@inject GaoApp.Application.Interfaces.Services.Security.IStoreAdminAccess StoreAdminAccess
@{
    var canManageShifts = await StoreAdminAccess.IsAdminAsync(Context.RequestAborted);
    var path = Context.Request.Path.Value?.ToLowerInvariant().TrimEnd('/') ?? string.Empty;
    var isHandover = path.StartsWith("/admin/pos-shift/handover-slips");
    var isManager = path.StartsWith("/admin/pos-shift/manager-dashboard");
    var isPOS = path == "/admin/pos" || path == "/admin/pos/v3" || path == "/admin/pos/legacy";
    var isShift = path == "/admin/pos-shift";
    var isShiftHistory = path.Contains("/admin/pos-shift/history") || path.Contains("/admin/pos-shift-history");
    var isReconciliation = path.Contains("/pos-shift/reconciliation");
    var isRequests = path.Contains("/pos-shift/requests") || path.Contains("/cash-adjustments") || path.Contains("/payment-adjustments");
    var isOrders = path.Contains("/admin/pos/orders-page") || path.Contains("/admin/pos/order-detail");
    var isDashboard = path.Contains("/admin/pos/dashboard");
    var isShiftGroup = isShift || isShiftHistory || isHandover || isReconciliation;
    var isManagementGroup = isManager || isRequests || isOrders || isDashboard;
}

<link rel="stylesheet" href="~/Admin/css/pos/pos-navigation.css" asp-append-version="true" />

<nav class="pos-top-nav pos-workspace-nav" aria-label="Điều hướng POS">
    <a href="/admin/pos" class="pos-nav-link @(isPOS ? "active" : "")" aria-current="@(isPOS ? "page" : null)">
        <i class="bx bx-cart-alt pos-nav-icon" aria-hidden="true"></i>
        <span>Bán hàng</span>
    </a>

    <div class="dropdown pos-nav-group">
        <button type="button" id="posShiftNavToggle" class="pos-nav-button @(isShiftGroup ? "active" : "")"
                data-bs-toggle="dropdown" aria-expanded="false" aria-controls="posShiftNavMenu">
            <i class="bx bx-time-five pos-nav-icon" aria-hidden="true"></i>
            <span>Ca làm việc</span>
            <i class="bx bx-chevron-down pos-nav-chevron" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu pos-nav-menu" id="posShiftNavMenu" aria-labelledby="posShiftNavToggle">
            <li><h6 class="dropdown-header">CA LÀM VIỆC</h6></li>
            <li><a href="/admin/pos-shift" class="dropdown-item @(isShift ? "active" : "")" aria-current="@(isShift ? "page" : null)">
                <i class="bx bx-time-five" aria-hidden="true"></i><span>Ca POS</span></a></li>
            <li><a href="/admin/pos-shift/history" class="dropdown-item @(isShiftHistory ? "active" : "")" aria-current="@(isShiftHistory ? "page" : null)">
                <i class="bx bx-history" aria-hidden="true"></i><span>Lịch sử ca</span></a></li>
            @if (canManageShifts)
            {
                <li><a href="/admin/pos-shift/handover-slips" class="dropdown-item @(isHandover ? "active" : "")" aria-current="@(isHandover ? "page" : null)">
                    <i class="bx bx-transfer" aria-hidden="true"></i><span>Phiếu nhận ca</span></a></li>
            }
            <li><a href="/admin/pos-shift/reconciliation" class="dropdown-item @(isReconciliation ? "active" : "")" aria-current="@(isReconciliation ? "page" : null)">
                <i class="bx bx-check-shield" aria-hidden="true"></i><span>Đối soát ca</span></a></li>
        </ul>
    </div>

    <div class="dropdown pos-nav-group">
        <button type="button" id="posManagementNavToggle" class="pos-nav-button @(isManagementGroup ? "active" : "")"
                data-bs-toggle="dropdown" aria-expanded="false" aria-controls="posManagementNavMenu">
            <i class="bx bx-grid-alt pos-nav-icon" aria-hidden="true"></i>
            <span>Quản lý</span>
            <i class="bx bx-chevron-down pos-nav-chevron" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu pos-nav-menu" id="posManagementNavMenu" aria-labelledby="posManagementNavToggle">
            <li><h6 class="dropdown-header">BÁN HÀNG</h6></li>
            <li><a href="/admin/pos/orders-page" class="dropdown-item @(isOrders ? "active" : "")" aria-current="@(isOrders ? "page" : null)">
                <i class="bx bx-receipt" aria-hidden="true"></i><span>Đơn POS</span></a></li>
            <li><a href="/admin/pos/dashboard" class="dropdown-item @(isDashboard ? "active" : "")" aria-current="@(isDashboard ? "page" : null)">
                <i class="bx bx-bar-chart-alt-2" aria-hidden="true"></i><span>Dashboard</span></a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><h6 class="dropdown-header">NGHIỆP VỤ</h6></li>
            <li><a href="/admin/pos-shift/requests" class="dropdown-item @(isRequests ? "active" : "")" aria-current="@(isRequests ? "page" : null)">
                <i class="bx bx-edit" aria-hidden="true"></i><span>Yêu cầu nghiệp vụ</span></a></li>
            @if (canManageShifts)
            {
                <li><a href="/admin/pos-shift/manager-dashboard" class="dropdown-item @(isManager ? "active" : "")" aria-current="@(isManager ? "page" : null)">
                    <i class="bx bx-user-check" aria-hidden="true"></i><span>Quản lý / duyệt ca</span></a></li>
            }
        </ul>
    </div>

    <button type="button" id="btnOpenCustomerDisplay" class="pos-nav-button customer-display" data-url="/admin/pos/customer-display">
        <i class="bx bx-desktop pos-nav-icon" aria-hidden="true"></i><span>Màn hình khách</span>
    </button>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('btnOpenCustomerDisplay');
        if (!btn) return;
        btn.addEventListener('click', function () {
            const features = ['popup=yes', 'width=1280', 'height=720', 'left=1920', 'top=0',
                'menubar=no', 'toolbar=no', 'location=no', 'status=no', 'resizable=yes', 'scrollbars=no'].join(',');
            const win = window.open(btn.getAttribute('data-url') || '/admin/pos/customer-display', 'GaoMartCustomerDisplay', features);
            if (win) win.focus();
            else alert('Trình duyệt đang chặn popup. Hãy cho phép popup cho trang POS.');
        });
    });
</script>
