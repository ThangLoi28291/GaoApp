@model GaoApp.Web.Services.Acb.AcbCallbackHealth
@{
    string RouteState(string state) => state == "CurrentStore" ? "Đã chọn cửa hàng này" : state == "NotSelected" ? "Chưa chọn / Tạm ngưng" : "Đang chọn cửa hàng khác";
    string ErrorHint(string code) => code switch
    {
        "ACCEPTED" => "Đã lưu biên nhận; xem tiến độ xử lý bên dưới.",
        "AUTH_REJECTED" or "CONFLICTING_AUTH_HEADERS" => "Kiểm tra x-api-key ACB đã đăng ký và header qua IIS/proxy.",
        "CONFIG_DECRYPT_FAILED" => "Máy chủ không giải mã được khóa đã lưu; kiểm tra Data Protection hoặc lưu lại khóa đúng.",
        "CALLBACK_STORE_NOT_SELECTED" => "Chọn cửa hàng nhận callback từ URL cũ.",
        "CALLBACK_STORE_NOT_FOUND" => "Cửa hàng nhận đã ngừng hoạt động hoặc không tồn tại.",
        "HTTPS_REDIRECT" => "Kiểm tra HTTPS và scheme từ proxy; callback không được chuyển hướng.",
        "STORE_ACB_NOT_CONFIGURED" => "Chưa có cấu hình ACB tại cửa hàng nhận.",
        "INBOX_SAVE_FAILED" or "DATABASE_WRITE_FAILED" => "Kiểm tra database và migration ACB.",
        _ => "Dùng mã chẩn đoán để đối chiếu nhật ký callback trên máy chủ."
    };
}
<section class="acb-panel" aria-label="Theo dõi nhận callback">
    <div class="acb-panel-head"><h2>Theo dõi nhận callback</h2><span class="acb-panel-note">Không phụ thuộc bộ lọc ngày bên dưới</span></div>
    <div class="p-3">
        <div class="d-flex flex-wrap gap-3 mb-3">
            <div><span class="text-muted">Biên nhận hợp lệ gần nhất</span><strong class="d-block">@(Model.LastReceivedAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa nhận callback hợp lệ")</strong></div>
            <div><span class="text-muted">Chờ xử lý</span><strong class="d-block">@Model.PendingCount</strong></div>
            <div><span class="text-muted">Cần đối chiếu</span><strong class="d-block">@Model.ReviewCount</strong></div>
            <div><span class="text-muted">Khóa callback trên máy này</span><strong class="d-block">@(Model.KeyState == "Ready" ? "Đã lưu · Giải mã được" : Model.KeyState == "Unreadable" ? "Không giải mã được" : "Chưa có khóa")</strong></div>
        </div>
        @if (!Model.Enabled || Model.KeyState != "Ready")
        { <div class="alert alert-warning">@(Model.KeyState == "Unreadable" ? "Khóa callback đang lưu không đọc được trên máy chủ này." : Model.KeyState == "Missing" ? "Cần lưu đúng x-api-key đã đăng ký với ACB." : "Cấu hình QR ACB xác nhận tự động đang tắt.")</div> }
        <div class="mb-2"><strong>URL trên ứng dụng hiện tại</strong><code class="d-block text-break">@Model.CurrentUrl</code></div>
        @foreach (var route in Model.Routes)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><code class="text-break">@route.Url</code><span class="acb-badge @(route.State == "CurrentStore" ? "acb-success" : "acb-warning")">@RouteState(route.State)</span></div>
        }
        <p class="mb-2">ACB gửi tới URL đã đăng ký với ngân hàng. Lưu khóa hoặc chọn cửa hàng ở đây không đổi URL bên ACB và không tự nối hai website IIS. URL cũ phải chuyển POST tới ứng dụng này, giữ JSON và <code>x-api-key</code>.</p>
        @if (Model.CanManageRouting)
        { <a href="/admin/acb/callback-routing" class="acb-button">Chọn cửa hàng nhận URL cũ</a> }
        @if (ViewBag.CanRetry == true)
        { <a href="/admin/acb/settings" class="acb-button">Cài đặt ACB</a> }
        <details class="mt-3" open="@(Model.HttpAttempts.Any(x => x.Status >= 400) || Model.PendingCount > 0 || Model.ReviewCount > 0)">
            <summary class="fw-semibold">Biên nhận và lỗi nhận callback gần nhất</summary>
            <p class="text-muted mt-2">Biên nhận lưu trong database, gồm cả tức thời và cuối ngày. Chỉ có biên nhận hợp lệ mới chứng minh đã nhận thông báo; tiền được xác nhận tiếp qua API ACB.</p>
            <div class="acb-table-scroll"><table class="acb-ledger"><thead><tr><th>Biên nhận / Loại</th><th>Nhận lúc (Việt Nam)</th><th>Trang</th><th>Xử lý</th><th>Mã kết quả</th></tr></thead><tbody>
            @foreach (var receipt in Model.Receipts)
            {
                <tr><td>#@receipt.Id · @(receipt.RequestCode == "TRANSACTION_HISTORY" ? "Cuối ngày" : "Tức thời")</td><td>@receipt.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@receipt.Page / @receipt.TotalPages</td><td>@(receipt.NeedsReview ? "Cần đối chiếu" : receipt.ProcessedAtUtc.HasValue ? "Đã xử lý" : "Đang chờ / thử lại")<small class="d-block">@receipt.Attempts lần xử lý</small></td><td><code>@(receipt.LastErrorCode ?? "—")</code></td></tr>
            }
            @if (Model.Receipts.Count == 0) { <tr><td colspan="5">Chưa có biên nhận hợp lệ tại cửa hàng này.</td></tr> }
            </tbody></table></div>
            <p class="text-muted mt-3">20 lần POST gần nhất trên tiến trình đang chạy, theo dõi từ @Model.MonitoringStartedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm:ss"). Danh sách này đặt lại khi ứng dụng khởi động; nhật ký đầy đủ nằm ở <code>App_Data/Logs/acb-callback</code>.</p>
            <div class="acb-table-scroll"><table class="acb-ledger"><thead><tr><th>Lúc nhận / Host</th><th>HTTP / Kết quả</th><th>Biên nhận</th><th>Mã chẩn đoán</th></tr></thead><tbody>
            @foreach (var attempt in Model.HttpAttempts)
            {
                <tr><td>@attempt.AtUtc.ToVietnamTime().ToString("dd/MM HH:mm:ss")<small class="d-block text-break">@attempt.RequestHost</small></td><td><strong>@attempt.Status · @attempt.Outcome</strong><small class="d-block">@ErrorHint(attempt.Outcome)</small></td><td>@(attempt.ReceiptId.HasValue ? "#" + attempt.ReceiptId : "Chưa lưu")</td><td><code class="text-break">@attempt.DiagnosticId</code></td></tr>
            }
            @if (Model.HttpAttempts.Count == 0) { <tr><td colspan="4">Chưa thấy POST tới tiến trình này. Nếu đang thử trên host, kiểm tra URL đăng ký, binding HTTPS, chuyển tiếp IIS và lịch gửi của ACB.</td></tr> }
            </tbody></table></div>
        </details>
    </div>
</section>
