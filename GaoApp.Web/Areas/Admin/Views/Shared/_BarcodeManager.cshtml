@model GaoApp.Web.Areas.Admin.ViewModels.Products.BarcodeManagerVm

<div class="card shadow-sm barcode-manager"
     data-conversion-id="@Model.ProductUnitConversionId">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-semibold">Quản lý barcode</div>
            <div class="small text-muted">
                @Model.ProductName
                @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                {
                    <span>- @Model.UnitName</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.VariantSku))
                {
                    <span>- SKU: @Model.VariantSku</span>
                }
            </div>
        </div>

        <button type="button"
                class="btn btn-sm btn-primary btn-open-change-barcode">
            Đổi barcode
        </button>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <h6 class="mb-2">Barcode hiện có</h6>
            <div class="barcode-list border rounded p-2 bg-light-subtle">
                <div class="text-muted small">Đang tải barcode...</div>
            </div>
        </div>

        <div>
            <h6 class="mb-2">Lịch sử gần nhất</h6>
            <div class="barcode-history-list border rounded p-2">
                <div class="text-muted small">Đang tải lịch sử...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changeBarcodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="changeBarcodeForm">
                <div class="modal-header">
                    <h5 class="modal-title">Đổi barcode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="changeBarcodeConversionId" name="ProductUnitConversionId" />

                    <div class="mb-3">
                        <label class="form-label">Barcode mới</label>
                        <input type="text"
                               class="form-control"
                               id="changeBarcodeNewBarcode"
                               name="NewBarcode"
                               maxlength="64"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Lý do</label>
                        <textarea class="form-control"
                                  id="changeBarcodeReason"
                                  name="Reason"
                                  rows="3"
                                  placeholder="Ví dụ: Đổi theo tem NCC mới"></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="changeBarcodeSetPrimary"
                               name="SetAsPrimary"
                               checked />
                        <label class="form-check-label" for="changeBarcodeSetPrimary">
                            Đặt làm barcode chính
                        </label>
                    </div>

                    <div id="changeBarcodeError" class="text-danger small mt-3 d-none"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitChangeBarcode">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>