@model GaoApp.Application.DTOs.Purchases.PurchaseReceivingWorkbenchDto
@using GaoApp.Domain.Enums
@using System.Globalization
@{
    ViewData["Title"] = $"Nhận hàng {Model.PurchaseOrderNumber}";
    var editable = Model.SessionState == ReceivingSessionState.Active &&
                   Model.Status is StockDocumentStatus.Draft or StockDocumentStatus.Rejected;
    var canApproveOutsidePo = ViewData["CanApproveOutsidePo"] as bool? == true;
    var provisionalEnabled = ViewData["ProvisionalItemsEnabled"] as bool? == true;
    var receivingLineCount = Model.Components.Count(x => x.AllocationKind == ReceiptAllocationKind.PurchaseOrder);
    var outsideLineCount = Model.Components.Count(x => x.AllocationKind == ReceiptAllocationKind.OutsidePo);
    var completedPoLineCount = Model.Progress.Count(x => x.RemainingBaseQuantity <= 0m);
    string Qty(decimal value) => value.ToString("#,0.###", CultureInfo.GetCultureInfo("vi-VN"));
}
@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}
@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/purchase-receiving-workbench.css" asp-append-version="true" />
    @if (provisionalEnabled) { <link rel="stylesheet" href="~/Admin/css/provisional-receiving.css" asp-append-version="true" /> }
}

<form id="rw-antiforgery">@Html.AntiForgeryToken()</form>
@await Html.PartialAsync("_ReceiptBarcodeProposals", Model.StockDocumentId)
<main id="receivingWorkbench" class="rw-page"
      data-document-id="@Model.StockDocumentId"
      data-row-version="@Model.RowVersion"
      data-lease-token="@(ViewData["InitialLeaseToken"] ?? string.Empty)"
      data-lookup-url="/admin/api/stock-documents/@Model.StockDocumentId/barcode-proposals/lookup"
      data-decoder-url="@Url.Content("~/lib/zxing-browser/0.1.5/zxing-browser.min.js")"
      data-can-approve-outside="@canApproveOutsidePo.ToString().ToLowerInvariant()"
      data-editable="@editable.ToString().ToLowerInvariant()">
    <header class="rw-heading">
        <div class="rw-heading-main">
            <a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId" class="rw-back" aria-label="Quay lại đơn đặt hàng"><i class="bx bx-arrow-back"></i></a>
            <div>
                <div class="rw-eyebrow">NHẬN HÀNG THEO ĐƠN · @Model.PurchaseOrderNumber</div>
                <h3>Bàn nhận hàng</h3>
                <div class="rw-heading-meta"><span><i class="bx bx-receipt"></i> @Model.ReceiptNumber</span><span class="rw-status-badge">@Model.Status</span></div>
            </div>
        </div>
        <div id="rwSaveState" class="rw-save-state" role="status" aria-live="polite">
            <i class="bx bx-cloud"></i><span>@(Model.LastSavedAtUtc.HasValue ? "Đã tự lưu" : "Chưa lưu")</span>
        </div>
    </header>

    <section class="rw-stepper" aria-label="Quy trình nhập hàng">
        <div class="is-current"><span>1</span><div><strong>Kiểm hàng thực tế</strong><small>Quét và đếm hàng</small></div></div>
        <div><span>2</span><div><strong>Gửi quản lý duyệt</strong><small>Đối chiếu chênh lệch</small></div></div>
        <div><span>3</span><div><strong>Ghi nhận vào kho</strong><small>Tăng tồn sau khi duyệt</small></div></div>
    </section>

    <section class="rw-summary" aria-label="Tổng quan phiếu nhận">
        <div><span class="is-purple"><i class="bx bx-list-check"></i></span><div><small>Dòng thuộc PO</small><strong id="rwSummaryPoLines">@receivingLineCount</strong><em>Đã quét trong phiếu này</em></div></div>
        <div><span class="is-green"><i class="bx bx-check-circle"></i></span><div><small>Dòng đã nhận đủ</small><strong id="rwSummaryCompleted">@completedPoLineCount/@Model.Progress.Count</strong><em>Theo số lượng quy đổi</em></div></div>
        <div><span class="is-orange"><i class="bx bx-error-circle"></i></span><div><small>Ngoài đơn / cần xử lý</small><strong id="rwSummaryExceptions">@(outsideLineCount + Model.UnresolvedProvisionalCount)</strong><em>Quản lý kiểm tra trước khi nhập kho</em></div></div>
    </section>

    <div id="rwMessage" class="alert d-none" role="alert" tabindex="-1"></div>
    <div id="rwOwnerBanner" class="rw-owner-banner @(editable ? "is-active" : "is-readonly")">
        <i class="bx @(editable ? "bx-lock-open-alt" : "bx-lock-alt")"></i>
        <span>@(editable ? "Bạn đang giữ quyền chỉnh sửa phiếu. Mọi lần quét đều được tự động lưu."
            : "Phiếu đang ở trạng thái chỉ đọc và chờ quản lý xử lý.")</span>
    </div>

    <section class="rw-capture" aria-labelledby="captureTitle">
        <div class="rw-section-title"><span><i class="bx bx-barcode-reader"></i></span><div><h5 id="captureTitle">Nhận hàng thực tế</h5><p>Quét đúng barcode để hệ thống tự chọn Hộp, Lốc hoặc đơn vị tương ứng.</p></div></div>
        <div class="rw-unified-row">
            <div class="flex-grow-1">
                <label class="form-label" for="rwReceiveLookup">Quét barcode hoặc tìm sản phẩm...</label>
                <select id="rwReceiveLookup" class="form-select" data-placeholder="Quét barcode hoặc tìm sản phẩm..."
                        aria-describedby="rwReceiveHelp" @(editable ? null : "disabled")></select>
            </div>
            <div class="rw-quantity-field">
                <label class="form-label" for="rwReceiveQuantity">Số lượng</label>
                <input id="rwReceiveQuantity" class="form-control form-control-lg" type="number"
                       min="0.001" step="0.001" value="1" inputmode="decimal" @(editable ? null : "disabled") />
            </div>
            <button id="rwReceiveAdd" class="btn btn-primary btn-lg" type="button" @(editable ? null : "disabled")>
                <i class="bx bx-package"></i><span>Nhận hàng</span>
            </button>
            <button id="rwOpenCamera" class="btn btn-outline-primary btn-lg" type="button" @(editable ? null : "disabled")>
                <i class="bx bx-camera"></i><span>Quét camera</span>
            </button>
        </div>
        <div id="rwResolvedItem" class="rw-resolved-item d-none" role="status" aria-live="polite"></div>
        <div id="rwReceiveHelp" class="form-text">
            Quét hoặc tìm rồi Enter; số lượng sẽ được chọn sẵn là 1. Enter lần nữa để nhận hàng — không cần Tab.
        </div>
    </section>

    @if (provisionalEnabled)
    {
        <section id="provisionalReceivingPanel" class="rw-provisional" aria-labelledby="rwProvisionalTitle"
                 data-document-id="@Model.StockDocumentId"
                 data-document-row-version="@Model.RowVersion"
                 data-mode="warehouse" data-receipt-source="purchase-order">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h5 id="rwProvisionalTitle" class="mb-1">Hàng chưa có trong danh mục</h5>
                    <p class="text-muted mb-0">Giữ nguyên tên, barcode, đơn vị và số lượng thực nhận để Manager xử lý sau.</p>
                </div>
                <button type="button" class="btn btn-outline-primary" id="btnCaptureProvisional"
                        data-bs-toggle="modal" data-bs-target="#provisionalCaptureModal" @(editable ? null : "disabled")>
                    <i class="bx bx-plus-circle"></i> Ghi nhận hàng mới
                </button>
            </div>
            <div id="provisionalReceivingMessage" class="small mt-2" role="status" aria-live="polite"></div>
            <div id="provisionalReceivingItems" class="vstack gap-2 mt-3"></div>
        </section>
    }

    <section class="rw-grid" aria-label="Tiến độ đơn đặt hàng">
        <div>
            <div class="rw-column-title"><div><h5>Đối chiếu đơn đặt hàng</h5><p>Theo dõi riêng từng đơn vị đặt.</p></div><span>@Model.Progress.Count dòng</span></div>
            <div id="rwProgress" class="vstack gap-3">
                @foreach (var item in Model.Progress)
                {
                    var receivedBase = item.ConfirmedBaseQuantity + item.CurrentReceiptBaseQuantity;
                    var percent = item.OrderedBaseQuantity <= 0m
                        ? 0m
                        : Math.Min(100m, Math.Round(receivedBase * 100m / item.OrderedBaseQuantity));
                    <article class="rw-progress-card">
                        <div class="rw-progress-heading"><div><strong>@item.ProductName</strong><span class="rw-order-unit">@Qty(item.OrderedQuantity) @item.OrderedUnitName</span></div><b>@percent%</b></div>
                        <div class="progress my-2" role="progressbar" aria-label="Tiến độ nhận @item.ProductName" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@percent%"></div></div>
                        <div class="rw-metrics"><span><small>Đã nhập kho</small><strong>@Qty(item.ConfirmedBaseQuantity) @item.BaseUnitName</strong></span><span><small>Đợt này</small><strong>@Qty(item.CurrentReceiptBaseQuantity) @item.BaseUnitName</strong></span><span><small>Còn chờ</small><strong>@Qty(item.RemainingBaseQuantity) @item.BaseUnitName</strong></span></div>
                        @if (item.ProjectedOverdeliveryBaseQuantity > 0) { <div class="text-danger small mt-2"><i class="bx bx-error"></i> Dự kiến vượt @Qty(item.ProjectedOverdeliveryBaseQuantity) @item.BaseUnitName — Manager phải xác nhận khi duyệt.</div> }
                    </article>
                }
            </div>
        </div>
        <div>
            <div class="rw-column-title"><div><h5>Hàng vừa nhận</h5><p>Có thể sửa số lượng hoặc hoàn tác trước khi hoàn tất.</p></div><button id="rwUndo" type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!editable || !Model.CanUndo)"><i class="bx bx-undo"></i> Hoàn tác</button></div>
            <div id="rwComponents" class="vstack gap-2" aria-live="polite">
                @foreach (var line in Model.Components)
                {
                    <article class="rw-component @(line.AllocationKind == ReceiptAllocationKind.OutsidePo ? "is-outside" : null)" data-line-id="@line.Id">
                        <div class="flex-grow-1">
                            <strong>@line.ProductName</strong>
                            <div>
                                @Qty(line.Quantity) @line.UnitName
                                @if (!line.IsBaseUnit)
                                {
                                    <span class="text-muted">= @Qty(line.BaseQuantity) @line.BaseUnitName</span>
                                }
                            </div>
                            @if (line.AllocationKind == ReceiptAllocationKind.OutsidePo)
                            {
                                <span class="badge bg-label-warning">Ngoài PO · @line.OutsideStatus</span>
                                @if (canApproveOutsidePo && line.OutsideStatus == OutsidePoDecisionStatus.Pending)
                                {
                                    <div class="d-flex gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-success rw-outside-accept">Chấp nhận</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rw-outside-reject">Từ chối</button>
                                    </div>
                                }
                            }
                        </div>
                        @if (editable) { <button class="btn btn-icon btn-sm btn-outline-danger rw-remove" type="button" aria-label="Xóa @line.ProductName"><i class="bx bx-trash"></i></button> }
                    </article>
                }
            </div>
            @if (!Model.Components.Any()) { <div id="rwEmpty" class="rw-empty">Chưa có hàng. Hãy quét barcode hoặc tìm sản phẩm.</div> }
        </div>
    </section>

    <footer class="rw-actions">
        <span><i class="bx bx-info-circle"></i> Hoàn tất chỉ gửi phiếu sang quản lý duyệt; tồn kho chưa tăng ở bước này.</span>
        <button id="rwReview" class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#rwFinishModal" disabled="@(!editable || (!Model.Components.Any() && Model.UnresolvedProvisionalCount == 0))"><i class="bx bx-check-circle"></i> Xem lại &amp; hoàn tất nhận hàng</button>
    </footer>
</main>

<div class="modal fade" id="rwFinishModal" tabindex="-1" aria-labelledby="rwFinishTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content rw-finish-modal"><div class="modal-header border-0"><div><div class="rw-eyebrow">KIỂM TRA LẦN CUỐI</div><h5 id="rwFinishTitle" class="modal-title">Hoàn tất nhận hàng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body pt-0"><div class="rw-finish-icon"><i class="bx bx-clipboard"></i></div><p>Phiếu sẽ khóa chỉnh sửa và chuyển sang <strong>Chờ quản lý duyệt</strong>. Hàng chỉ tăng tồn kho sau khi được xác nhận.</p><div id="rwFinalSummary" class="rw-final-summary"></div></div><div class="modal-footer border-0"><button class="btn btn-label-secondary" data-bs-dismiss="modal">Tiếp tục kiểm hàng</button><button id="rwFinish" class="btn btn-success" type="button"><i class="bx bx-send"></i> Gửi quản lý duyệt</button></div></div></div>
</div>

<div class="modal fade" id="rwCameraModal" tabindex="-1" aria-labelledby="rwCameraTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down"><div class="modal-content rw-camera-modal">
        <div class="modal-header"><div><div class="rw-eyebrow">QUÉT BARCODE</div><h5 id="rwCameraTitle" class="modal-title">Camera nhận hàng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body"><div class="rw-camera-stage"><video id="rwCameraVideo" muted playsinline autoplay></video><div class="rw-camera-frame"></div><span>Đặt mã vạch vào giữa khung</span></div><div id="rwCameraMessage" class="rw-camera-message" role="status" aria-live="polite">Camera sẽ dừng sau khi đọc được một mã.</div></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" id="rwCameraTorch" hidden>Bật đèn</button><button type="button" class="btn btn-outline-primary" id="rwCameraRetry">Quét lại</button><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button></div>
    </div></div>
</div>

<div class="modal fade" id="rwAllocationModal" tabindex="-1" aria-labelledby="rwAllocationTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content rw-allocation-modal">
        <div class="modal-header"><div><div class="rw-eyebrow">CHỌN DÒNG PHÂN BỔ</div><h5 id="rwAllocationTitle" class="modal-title">Hàng giao khác đơn vị đặt</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><p id="rwAllocationDescription" class="text-muted"></p><div id="rwAllocationChoices" class="rw-allocation-choices"></div></div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Quay lại</button><button type="button" class="btn btn-outline-warning" id="rwAllocationOutside"><i class="bx bx-error-circle"></i> Ghi nhận ngoài PO</button></div>
    </div></div>
</div>

@if (provisionalEnabled)
{
    <div class="modal fade" id="provisionalCaptureModal" tabindex="-1" aria-labelledby="provisionalCaptureTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down"><div class="modal-content">
            <div class="modal-header"><h5 id="provisionalCaptureTitle" class="modal-title">Ghi nhận hàng mới</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label for="provisionalName" class="form-label">Tên hàng <span class="text-danger">*</span></label><input id="provisionalName" class="form-control" maxlength="200" autocomplete="off" /></div>
                <div class="mb-3"><label for="provisionalBarcode" class="form-label">Barcode thực tế</label><input id="provisionalBarcode" class="form-control" maxlength="256" autocomplete="off" /><div class="form-text">Barcode dài hoặc chưa hợp lệ vẫn được giữ làm bằng chứng, chưa ghi vào danh mục.</div></div>
                <div class="row g-3"><div class="col-sm-7"><label for="provisionalUnit" class="form-label">Đơn vị</label><select id="provisionalUnit" class="form-select"><option value="">Chưa rõ / nhập bên dưới</option></select></div><div class="col-sm-5"><label for="provisionalUnitName" class="form-label">Tên đơn vị ghi nhận</label><input id="provisionalUnitName" class="form-control" maxlength="100" /></div></div>
                <div class="mt-3"><label for="provisionalQuantity" class="form-label">Số lượng <span class="text-danger">*</span></label><input id="provisionalQuantity" class="form-control" type="number" min="0.001" step="0.001" value="1" inputmode="decimal" /></div>
                <div class="mt-3"><label for="provisionalNote" class="form-label">Ghi chú</label><textarea id="provisionalNote" class="form-control" maxlength="500" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-primary" id="btnSaveProvisional">Ghi nhận &amp; tự lưu</button></div>
        </div></div>
    </div>
}

@section VendorScripts { <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script> }
@section PageScripts {
    <script src="~/Admin/js/receipt-barcode-proposals.js" asp-append-version="true"></script>
    <script src="~/Admin/js/purchase-receiving-workbench.js" asp-append-version="true"></script>
    @if (provisionalEnabled) { <script src="~/Admin/js/provisional-receiving.js" asp-append-version="true"></script> }
}
