@using GaoApp.Web.Areas.Admin.ViewModels.POS
@{
    ViewData["Title"] = "Ca POS";
    Layout = "_ContentNavbarLayout";
    var posCtx = ViewBag.POSHeaderContext as POSHeaderContextViewModel ?? new POSHeaderContextViewModel();
}

@section VendorStyles {
    <style>
        .shift-shell {
            min-height: calc(100vh - 140px);
        }

        .shift-toolbar-card,
        .shift-card,
        .shift-panel {
            border: 1px solid #e7edf5;
            border-radius: 24px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(15, 23, 42, .05);
        }

        .shift-toolbar-card {
            padding: 18px 20px;
            margin-bottom: 16px;
        }

        .shift-card {
            overflow: hidden;
        }

            .shift-card .card-body,
            .shift-panel {
                padding: 20px;
            }

        .shift-section-head {
            margin-bottom: 16px;
        }

        .shift-section-title {
            margin: 0;
            font-size: 1.18rem;
            font-weight: 900;
            color: #101828;
            line-height: 1.25;
        }

        .shift-section-sub {
            margin-top: 6px;
            color: #667085;
            font-size: .96rem;
            font-weight: 600;
            line-height: 1.45;
        }

        .shift-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 14px;
            font-size: .84rem;
            font-weight: 800;
        }

            .shift-status-pill.loading {
                background: #eef2f6;
                color: #475467;
            }

            .shift-status-pill.open {
                background: #ecfdf3;
                color: #067647;
            }

            .shift-status-pill.closed {
                background: #f2f4f7;
                color: #344054;
            }

            .shift-status-pill.warning {
                background: #fffaeb;
                color: #b54708;
            }

        .shift-action-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .shift-toolbar-btn {
            min-height: 50px;
            border-radius: 16px;
            padding: 10px 18px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .shift-empty {
            border-radius: 18px;
            border: 1px dashed #f4b26c;
            background: #fff8ee;
            color: #9a5a12;
            padding: 16px 18px;
            font-weight: 700;
        }

        .shift-tabs-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .shift-tab-btn {
            border: 1px solid #dbe4ef;
            background: #fff;
            color: #344054;
            border-radius: 16px;
            padding: 10px 16px;
            font-weight: 800;
            min-height: 46px;
            transition: all .15s ease;
        }

            .shift-tab-btn.active {
                border-color: #2458b8;
                background: linear-gradient(180deg, #2d63cc 0%, #2458b8 100%);
                color: #fff;
                box-shadow: 0 8px 18px rgba(36, 88, 184, .18);
            }

        .shift-tab-pane {
            display: none;
        }

            .shift-tab-pane.active {
                display: block;
            }

        .shift-mini-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 14px;
            margin-bottom: 16px;
        }

        .shift-mini-box {
            border-radius: 18px;
            padding: 16px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e9eef5;
            min-height: 96px;
        }

            .shift-mini-box .k {
                font-size: .8rem;
                color: #667085;
                margin-bottom: 8px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .shift-mini-box .v {
                font-size: 1.05rem;
                font-weight: 900;
                color: #101828;
                line-height: 1.35;
                word-break: break-word;
            }

        .shift-stat-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 14px;
        }

        .shift-stat-box {
            border-radius: 18px;
            padding: 16px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e9eef5;
            min-height: 110px;
        }

            .shift-stat-box.accent {
                background: linear-gradient(180deg, #f6f9ff 0%, #eef4ff 100%);
                border-color: #d7e5ff;
            }

        .shift-stat-label {
            font-size: .8rem;
            color: #667085;
            margin-bottom: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .shift-stat-value {
            font-size: 1.35rem;
            font-weight: 900;
            color: #101828;
            line-height: 1.2;
            word-break: break-word;
        }

            .shift-stat-value.money {
                color: #2458b8;
            }

            .shift-stat-value.positive {
                color: #067647;
            }

            .shift-stat-value.negative {
                color: #c01048;
            }

        .shift-note-box {
            margin-top: 14px;
            border-radius: 18px;
            padding: 16px;
            background: #fbfcfe;
            border: 1px solid #edf1f5;
        }

        .shift-note-label {
            font-size: .8rem;
            color: #667085;
            margin-bottom: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .shift-note-text {
            color: #344054;
            line-height: 1.65;
            min-height: 28px;
            font-weight: 600;
            white-space: pre-line;
            word-break: break-word;
        }

        .shift-table-wrap {
            border: 1px solid #edf1f5;
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
        }

        .shift-table {
            margin-bottom: 0;
        }

            .shift-table thead th {
                background: #f8fafc;
                font-size: .84rem;
                font-weight: 800;
                color: #475467;
                border-bottom: 1px solid #e9eef5;
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: .04em;
                padding: 14px 16px;
            }

            .shift-table td,
            .shift-table th {
                vertical-align: middle;
            }

            .shift-table tbody td {
                padding: 15px 16px;
                border-top: 1px solid #edf2f7;
            }

            .shift-table tbody tr:hover {
                background: #f8fbff;
            }

        .shift-type-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 126px;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 800;
            line-height: 1;
        }

            .shift-type-badge.in {
                background: #eafaf0;
                color: #18794e;
            }

            .shift-type-badge.out {
                background: #fff1f3;
                color: #c01048;
            }

        .cash-time {
            font-weight: 700;
            color: #344054;
            font-size: .9rem;
            line-height: 1.45;
        }

        .cash-amount {
            font-size: 1.08rem;
            font-weight: 900;
        }

        .cash-reason {
            font-weight: 700;
            color: #101828;
            word-break: break-word;
        }

        .cash-note {
            color: #667085;
            white-space: pre-line;
            word-break: break-word;
        }

        .shift-money-positive {
            color: #067647;
            font-weight: 800;
        }

        .shift-money-negative {
            color: #c01048;
            font-weight: 800;
        }

        .shift-pager {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding-top: 14px;
        }

        .shift-pager-info {
            color: #667085;
            font-size: .9rem;
            font-weight: 700;
        }

        .shift-pager-actions {
            display: flex;
            gap: 10px;
        }

        .shift-pager-btn {
            min-height: 40px;
            border-radius: 12px;
            font-weight: 800;
        }

        .shift-modal .modal-dialog {
            max-width: 1180px;
        }

        .shift-modal .modal-content {
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(15, 23, 42, .20);
            max-height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
        }

        .shift-modal .modal-header {
            flex: 0 0 auto;
            padding: 18px 20px 14px;
            border-bottom: 1px solid #eef2f6;
        }

        .shift-modal .modal-title {
            font-weight: 900;
            color: #101828;
        }

        .shift-modal .modal-body {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 16px 20px 14px;
        }

        .shift-modal .modal-footer {
            flex: 0 0 auto;
            position: sticky;
            bottom: 0;
            background: #fff;
            z-index: 2;
            padding: 14px 20px 18px;
            border-top: 1px solid #eef2f6;
            box-shadow: 0 -8px 20px rgba(15, 23, 42, .04);
            gap: 10px;
        }

        .shift-modal-subtitle {
            margin-top: 6px;
            color: #667085;
            font-size: .94rem;
            font-weight: 600;
        }

        .shift-form-label {
            font-weight: 800;
            color: #344054;
            margin-bottom: .5rem;
            font-size: .93rem;
        }

        .shift-form-caption {
            font-size: .82rem;
            color: #667085;
            margin-top: .4rem;
            line-height: 1.45;
        }

        .shift-modal .form-control,
        .shift-modal .form-select {
            min-height: 48px;
            border-radius: 16px;
            border: 1px solid #d7dee8;
            box-shadow: none !important;
            font-size: 1rem;
            padding: 10px 13px;
        }

            .shift-modal .form-control:focus,
            .shift-modal .form-select:focus {
                border-color: #86b7fe;
            }

        .shift-modal textarea.form-control {
            min-height: 88px;
            resize: vertical;
        }

        .shift-denom-wrap {
            border: 1px solid #e7edf5;
            border-radius: 18px;
            padding: 12px;
            background: #fbfcfe;
        }

        .shift-denom-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 10px;
        }

        .shift-denom-item {
            border: 1px solid #e7edf5;
            border-radius: 14px;
            background: #fff;
            padding: 10px 12px;
        }

        .shift-denom-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .shift-denom-label {
            font-size: .9rem;
            font-weight: 900;
            color: #101828;
        }

        .shift-denom-total {
            font-size: .8rem;
            font-weight: 800;
            color: #667085;
        }

        .shift-stepper {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .shift-stepper-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid #d7dee8;
            background: #fff;
            font-size: 1rem;
            font-weight: 900;
            color: #344054;
        }

        .shift-stepper-input {
            text-align: center;
            font-weight: 900;
            min-height: 38px !important;
            padding: 8px 10px !important;
            font-size: 1rem;
        }

        .shift-header-total {
            min-width: 200px;
            padding: 9px 12px;
            border-radius: 14px;
            border: 1px solid #d7e5ff;
            background: linear-gradient(180deg, #f6f9ff 0%, #eef4ff 100%);
            text-align: right;
        }

        .shift-header-total-label {
            font-size: .76rem;
            color: #667085;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 4px;
        }

        .shift-header-total-value {
            font-size: 1.2rem;
            color: #2458b8;
            font-weight: 900;
            line-height: 1.15;
        }

        .shift-modal-btn {
            min-height: 48px;
            border-radius: 14px;
            min-width: 150px;
            font-weight: 900;
        }

        .shift-modal-left-col .mb-3:last-child,
        .shift-modal-left-col .mb-0:last-child {
            margin-bottom: 0 !important;
        }

        .shift-modal-note-compact {
            min-height: 82px !important;
        }

        @@media (max-width: 1199.98px) {
            .shift-mini-summary {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 991.98px) {
            .shift-denom-grid {
                grid-template-columns: 1fr;
            }

            .shift-modal .modal-dialog {
                max-width: calc(100vw - 20px);
                margin: 10px auto;
            }

            .shift-modal .modal-content {
                max-height: calc(100vh - 20px);
            }

            .shift-modal .modal-body {
                padding: 14px 14px 12px;
            }

            .shift-modal .modal-footer {
                padding: 12px 14px 14px;
            }

            .shift-header-total {
                width: 100%;
                text-align: left;
            }
        }

        @@media (max-width: 767.98px) {
            .shift-stat-grid {
                grid-template-columns: 1fr;
            }

            .shift-card .card-body,
            .shift-panel,
            .shift-toolbar-card {
                padding: 16px;
            }

            .shift-pager {
                flex-direction: column;
                align-items: stretch;
            }

            .shift-pager-actions {
                width: 100%;
            }

            .shift-pager-btn {
                flex: 1;
            }
        }

        .shift-close-compare-box {
            border: 1px solid #e7edf5;
            border-radius: 18px;
            background: linear-gradient(180deg, #fbfcfe 0%, #f8fafc 100%);
            padding: 14px 16px;
        }

        .shift-close-compare-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
        }

            .shift-close-compare-row + .shift-close-compare-row {
                border-top: 1px dashed #e5eaf1;
            }

            .shift-close-compare-row.total {
                margin-top: 4px;
                padding-top: 12px;
            }

        .shift-close-compare-label {
            font-size: .9rem;
            font-weight: 700;
            color: #475467;
        }

        .shift-close-compare-value {
            font-size: 1rem;
            font-weight: 900;
            color: #101828;
            text-align: right;
        }

            .shift-close-compare-value.expected {
                color: #2458b8;
            }

            .shift-close-compare-value.actual {
                color: #101828;
            }

            .shift-close-compare-value.match {
                color: #475467;
            }

            .shift-close-compare-value.positive {
                color: #067647;
            }

            .shift-close-compare-value.negative {
                color: #c01048;
            }

        .shift-close-compare-hint {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed #e5eaf1;
            font-size: .86rem;
            font-weight: 700;
            color: #667085;
        }

            .shift-close-compare-hint.match {
                color: #475467;
            }

            .shift-close-compare-hint.positive {
                color: #067647;
            }

            .shift-close-compare-hint.negative {
                color: #c01048;
            }
    </style>
}

@section header {
    <div class="py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3 class="mb-1 fw-bold">Ca POS</h3>
            <div class="text-muted">Mở ca, kiểm quỹ, ghi nhận thu chi và đóng ca theo terminal</div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span id="shiftStatusBadge" class="shift-status-pill loading">
                <i class="bx bx-loader-alt"></i>
                <span>Đang tải...</span>
            </span>
        </div>
    </div>
}

<partial name="~/Areas/Admin/Views/Shared/_POSNavTabs.cshtml" />
<partial name="~/Areas/Admin/Views/Shared/_POSWorkContextBar.cshtml" model="posCtx" />

<div class="shift-shell">
    @Html.AntiForgeryToken()

    <div class="shift-toolbar-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="shift-section-title mb-0">Thao tác ca POS</div>
                <div class="shift-section-sub">Tất cả thao tác mở ca, thu chi và đóng ca đều thực hiện qua popup để thao tác nhanh hơn</div>
            </div>

            <div class="shift-action-group">
                <button id="btnShowOpenModal" type="button" class="btn btn-primary shift-toolbar-btn" style="display:none;">
                    <i class="bx bx-play-circle"></i>
                    <span>Mở ca</span>
                </button>

                <button id="btnShowCashTxnModal" type="button" class="btn btn-outline-primary shift-toolbar-btn" style="display:none;">
                    <i class="bx bx-transfer-alt"></i>
                    <span>Thu / Chi tiền mặt</span>
                </button>

                <button id="btnShowCloseModal" type="button" class="btn btn-danger shift-toolbar-btn" style="display:none;">
                    <i class="bx bx-lock-alt"></i>
                    <span>Đóng ca</span>
                </button>
            </div>
        </div>
    </div>

    <div id="noOpenShiftSection" class="shift-card mb-3" style="display:none;">
        <div class="card-body">
            <div class="shift-empty">
                Chưa có ca POS đang mở tại terminal này. Nhấn nút <strong>Mở ca</strong> để bắt đầu làm việc.
            </div>
        </div>
    </div>

    <div id="openShiftSection" style="display:none;">
        <div class="shift-tabs-nav">
            <button type="button" class="shift-tab-btn active" data-shift-tab="summaryTab">Thông tin ca hiện tại</button>
            <button type="button" class="shift-tab-btn" data-shift-tab="historyTab">Lịch sử thu / chi tiền mặt</button>
        </div>

        <div id="summaryTab" class="shift-tab-pane active">
            <div class="card shift-card">
                <div class="card-body">
                    <div class="shift-section-head">
                        <h4 class="shift-section-title">Thông tin ca hiện tại</h4>
                        <div class="shift-section-sub">
                            Tổng hợp nhanh tình trạng ca, doanh thu, refund và tiền mặt dự kiến
                        </div>
                    </div>

                    <div class="shift-mini-summary">
                        <div class="shift-mini-box">
                            <div class="k">Mã ca</div>
                            <div id="shiftId" class="v">-</div>
                        </div>

                        <div class="shift-mini-box">
                            <div class="k">Shift code</div>
                            <div id="shiftCode" class="v">-</div>
                        </div>

                        <div class="shift-mini-box">
                            <div class="k">Mở lúc</div>
                            <div id="openedAt" class="v">-</div>
                        </div>
                    </div>

                    <div class="shift-stat-grid">
                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Tiền đầu ca</div>
                            <div id="openingCash" class="shift-stat-value money">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Doanh thu tiền mặt</div>
                            <div id="cashSalesTotal" class="shift-stat-value money">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Doanh thu không tiền mặt</div>
                            <div id="nonCashSalesTotal" class="shift-stat-value">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Hoàn tiền mặt</div>
                            <div id="cashRefundTotal" class="shift-stat-value negative">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Hoàn không tiền mặt</div>
                            <div id="nonCashRefundTotal" class="shift-stat-value negative">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Tổng tiền hoàn</div>
                            <div id="refundTotalShift" class="shift-stat-value negative">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Số giao dịch hoàn</div>
                            <div id="refundCountShift" class="shift-stat-value">0</div>
                        </div>
                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Số đơn void</div>
                            <div id="voidCountShift" class="shift-stat-value">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Thu thêm tiền mặt</div>
                            <div id="cashInTotal" class="shift-stat-value positive">0</div>
                        </div>

                        <div class="shift-stat-box">
                            <div class="shift-stat-label">Chi tiền mặt</div>
                            <div id="cashOutTotal" class="shift-stat-value negative">0</div>
                        </div>

                        <div class="shift-stat-box accent">
                            <div class="shift-stat-label">Tiền mặt dự kiến cuối ca</div>
                            <div id="closingCashExpected" class="shift-stat-value money">0</div>
                        </div>
                    </div>

                    <div class="shift-note-box">
                        <div class="shift-note-label">Ghi chú mở ca</div>
                        <div id="openNote" class="shift-note-text">-</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="historyTab" class="shift-tab-pane">
            <div class="card shift-card">
                <div class="card-body">
                    <div class="shift-section-head">
                        <h4 class="shift-section-title">Lịch sử thu / chi tiền mặt</h4>
                        <div class="shift-section-sub">
                            Theo dõi các giao dịch tiền mặt phát sinh trong ca hiện tại
                        </div>
                    </div>

                    <div class="shift-table-wrap">
                        <div class="table-responsive">
                            <table class="table align-middle shift-table">
                                <thead>
                                    <tr>
                                        <th style="width:170px;">Thời gian</th>
                                        <th style="width:150px;">Loại</th>
                                        <th style="width:140px;">Số tiền</th>
                                        <th style="width:180px;">Lý do</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody id="cashTxnBody">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Chưa có giao dịch.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="shift-pager">
                        <div id="cashTxnPagerInfo" class="shift-pager-info">0 giao dịch</div>
                        <div class="shift-pager-actions">
                            <button id="btnCashTxnPrev" type="button" class="btn btn-outline-secondary shift-pager-btn">Trang trước</button>
                            <button id="btnCashTxnNext" type="button" class="btn btn-outline-secondary shift-pager-btn">Trang sau</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Open Shift Modal -->
