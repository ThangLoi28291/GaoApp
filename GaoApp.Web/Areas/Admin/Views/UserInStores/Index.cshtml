@model GaoApp.Application.DTOs.Security.UserInStores.UserInStoreIndexVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Người dùng trong store";

    var canCreate = (bool?)ViewBag.CanCreate == true;
    var canUpdate = (bool?)ViewBag.CanUpdate == true;
    var canDelete = (bool?)ViewBag.CanDelete == true;

    var roleOptions = ViewBag.RoleFilterOptions as List<SelectListItem> ?? new();
}

<div class="container-fluid userinstore-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Người dùng trong store</h3>
            <div class="text-muted">Quản lý người dùng được gán vào cửa hàng và vai trò truy cập.</div>
        </div>

        @if (canCreate)
        {
            <a asp-area="Admin"
                   asp-controller="UserInStores"
                   asp-action="Create"
                   class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Thêm người dùng vào store
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 dashboard-card">
                <div class="card-body">
                    <div class="text-muted small">Tổng user đang hoạt động</div>
                    <div class="fs-3 fw-bold mt-2">@Model.TotalActiveUsers</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 dashboard-card">
                <div class="card-body">
                    <div class="text-muted small">User đang khóa trong store</div>
                    <div class="fs-3 fw-bold mt-2">@Model.TotalInactiveUsers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 filter-card">
        <div class="card-body">
            <form method="get"
                  asp-area="Admin"
                  asp-controller="UserInStores"
                  asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Từ khóa</label>
                        <input name="Keyword"
                               value="@Model.Query.Keyword"
                               class="form-control"
                               placeholder="Tìm theo username, họ tên, email" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Vai trò</label>
                        <select name="RoleId" class="form-select">
                            <option value="">-- Tất cả vai trò --</option>
                            @foreach (var item in roleOptions)
                            {
                                if (item.Selected)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select name="IsActive" class="form-select">
                            <option value="">-- Tất cả --</option>

                            @if (Model.Query.IsActive == true)
                            {
                                <option value="true" selected>Đang hoạt động</option>
                            }
                            else
                            {
                                <option value="true">Đang hoạt động</option>
                            }

                            @if (Model.Query.IsActive == false)
                            {
                                <option value="false" selected>Đang khóa</option>
                            }
                            else
                            {
                                <option value="false">Đang khóa</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-semibold">Số dòng</label>
                        <select name="PageSize" class="form-select">
                            @{
                                var pageSizes = new[] { 10, 20, 50 };
                            }
                            @foreach (var size in pageSizes)
                            {
                                if (Model.Query.PageSize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search me-1"></i> Lọc
                        </button>

                        <a asp-area="Admin"
                               asp-controller="UserInStores"
                               asp-action="Index"
                               class="btn btn-light border">
                            Reset
                        </a>
                    </div>
                </div>

                <input type="hidden" name="Page" value="1" />
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px;">#</th>
                        <th>Người dùng</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày gán</th>
                        <th style="width:220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Items == null || !Model.Items.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Chưa có dữ liệu người dùng trong store.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var startNo = ((Model.Items.Page - 1) * Model.Items.PageSize) + 1;

                        @for (int i = 0; i < Model.Items.Items.Count; i++)
                        {
                            var item = Model.Items.Items[i];

                            <tr>
                                <td>@(startNo + i)</td>
                                <td>
                                    <div class="fw-semibold">@item.FullName</div>
                                    <div class="text-muted small">@item.Username</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                                <td>
                                    <div class="fw-semibold">@item.RoleName</div>
                                    <div class="text-muted small">@item.RoleCode</div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">Đang khóa</span>
                                    }
                                </td>
                                <td>
                                    @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (canUpdate)
                                        {
                                            <a asp-area="Admin"
                                                   asp-controller="UserInStores"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                Sửa
                                            </a>
                                        }

                                        @if (canDelete)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="UserInStores"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa user này khỏi store không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Items.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav>
                    <ul class="pagination mb-0 flex-wrap">
                        @{
                            var currentPage = Model.Items.Page;
                            var totalPages = Model.Items.TotalPages;
                        }

                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="UserInStores"
                                   asp-action="Index"
                                   asp-route-Page="@(currentPage - 1)"
                                   asp-route-PageSize="@Model.Query.PageSize"
                                   asp-route-Keyword="@Model.Query.Keyword"
                                   asp-route-RoleId="@Model.Query.RoleId"
                                   asp-route-IsActive="@Model.Query.IsActive">
                                Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="UserInStores"
                                       asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-PageSize="@Model.Query.PageSize"
                                       asp-route-Keyword="@Model.Query.Keyword"
                                       asp-route-RoleId="@Model.Query.RoleId"
                                       asp-route-IsActive="@Model.Query.IsActive">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="UserInStores"
                                   asp-action="Index"
                                   asp-route-Page="@(currentPage + 1)"
                                   asp-route-PageSize="@Model.Query.PageSize"
                                   asp-route-Keyword="@Model.Query.Keyword"
                                   asp-route-RoleId="@Model.Query.RoleId"
                                   asp-route-IsActive="@Model.Query.IsActive">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .userinstore-page .dashboard-card,
    .userinstore-page .filter-card,
    .userinstore-page .table-card {
        border-radius: 18px;
    }
</style>