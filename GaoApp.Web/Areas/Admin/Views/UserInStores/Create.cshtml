@model GaoApp.Application.DTOs.Security.UserInStores.CreateUserInStoreRequest
@using GaoApp.Application.DTOs.Security.UserInStores
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Thêm nhân viên";
    var roleOptions = ViewBag.RoleOptions as List<SelectListItem> ?? new();
    var userOptions = ViewBag.UserOptions as List<SelectListItem> ?? new();
}

<div class="container-fluid create-userinstore-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Thêm nhân viên</h3>
            <div class="text-muted">
                Tạo nhân viên mới hoặc gán user có sẵn vào cửa hàng hiện tại.
            </div>
        </div>

        <a asp-area="Admin"
               asp-controller="UserInStores"
               asp-action="Index"
               class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 create-card">
        <div class="card-header bg-white border-0 pb-0">
            <ul class="nav nav-pills gap-2" id="employeeCreateTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="new-employee-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#new-employee-pane"
                            type="button"
                            role="tab">
                        <i class="bi bi-person-plus me-1"></i>
                        Tạo nhân viên mới
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="existing-user-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#existing-user-pane"
                            type="button"
                            role="tab">
                        <i class="bi bi-link-45deg me-1"></i>
                        Gán user có sẵn
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body pt-4">
            <div class="tab-content" id="employeeCreateTabsContent">

                <!-- ===================================================== -->
                <!-- TAB 1: TẠO NHÂN VIÊN MỚI -->
                <!-- ===================================================== -->
                <div class="tab-pane fade show active"
                     id="new-employee-pane"
                     role="tabpanel"
                     aria-labelledby="new-employee-tab">

                    <div class="mb-4">
                        <h5 class="mb-1">Tạo nhân viên mới</h5>
                        <div class="text-muted small">
                            Tạo tài khoản đăng nhập và tự động gán vào cửa hàng hiện tại.
                        </div>
                    </div>

                    <form asp-area="Admin"
                          asp-controller="UserInStores"
                          asp-action="CreateEmployee"
                          method="post"
                          autocomplete="off">
                        @Html.AntiForgeryToken()

                        <div class="row g-4">
                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                <input name="UserName"
                                       class="form-control"
                                       placeholder="Ví dụ: nv01"
                                       required />
                                <div class="form-text">Tên dùng để đăng nhập hệ thống.</div>
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Họ tên <span class="text-danger">*</span></label>
                                <input name="FullName"
                                       class="form-control"
                                       placeholder="Ví dụ: Nguyễn Văn A"
                                       required />
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input name="Password"
                                           id="newPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Tối thiểu 6 ký tự"
                                           required
                                           minlength="6" />
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="togglePasswordBtn">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Số điện thoại</label>
                                <input name="PhoneNumber"
                                       class="form-control"
                                       placeholder="Ví dụ: 0987654321"
                                       autocomplete="tel" />
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Email</label>
                                <input name="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="email@example.com" />
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                                <select name="RoleId" class="form-select" required>
                                    <option value="">-- Chọn vai trò --</option>
                                    @foreach (var item in roleOptions)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Chức vụ</label>
                                <input name="PositionName"
                                       class="form-control"
                                       placeholder="Thu ngân, Quản lý, Kho..." />
                            </div>

                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Ngày vào làm</label>
                                <input name="JoinedDate"
                                       type="date"
                                       class="form-control" />
                            </div>

                            <div class="col-lg-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input name="IsActive"
                                           value="true"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked />
                                    <input name="IsActive" value="false" type="hidden" />
                                    <label class="form-check-label fw-semibold">
                                        Kích hoạt ngay
                                    </label>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label fw-semibold">Ghi chú</label>
                                <textarea name="Note"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: Làm ca tối, phụ trách kho, ghi chú nội bộ..."></textarea>
                            </div>
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-check me-1"></i>
                                Tạo nhân viên
                            </button>

                            <a asp-area="Admin"
                                   asp-controller="UserInStores"
                                   asp-action="Index"
                                   class="btn btn-light border">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>

                <!-- ===================================================== -->
                <!-- TAB 2: GÁN USER CÓ SẴN -->
                <!-- ===================================================== -->
                <div class="tab-pane fade"
                     id="existing-user-pane"
                     role="tabpanel"
                     aria-labelledby="existing-user-tab">

                    <div class="mb-4">
                        <h5 class="mb-1">Gán user có sẵn vào cửa hàng</h5>
                        <div class="text-muted small">
                            Dùng khi user đã tồn tại trong hệ thống và chỉ cần gán thêm vào store hiện tại.
                        </div>
                    </div>

                    <form asp-area="Admin"
                          asp-controller="UserInStores"
                          asp-action="Create"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label class="form-label fw-semibold">Tìm user</label>
                                <input type="text"
                                       id="userKeyword"
                                       class="form-control mb-2"
                                       placeholder="Nhập username, họ tên, email..." />

                                <label asp-for="UserId" class="form-label fw-semibold">
                                    Người dùng <span class="text-danger">*</span>
                                </label>

                                <select asp-for="UserId" class="form-select" id="userSelect">
                                    <option value="">-- Chọn người dùng --</option>
                                    @foreach (var item in userOptions)
                                    {
                                        if (item.Selected)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="UserId" class="text-danger small"></span>

                                <div class="form-text">
                                    Gõ từ khóa để nạp nhanh danh sách user phù hợp.
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <label asp-for="RoleId" class="form-label fw-semibold">
                                    Vai trò <span class="text-danger">*</span>
                                </label>

                                <select asp-for="RoleId" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                    @foreach (var item in roleOptions)
                                    {
                                        if (item.Selected)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="RoleId" class="text-danger small"></span>

                                <div class="form-check form-switch mt-4">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">
                                        Kích hoạt ngay sau khi gán
                                    </label>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="Ví dụ: 0987654321"
                                       autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-lg-6">
                                <label asp-for="PositionName" class="form-label fw-semibold">Chức vụ</label>
                                <input asp-for="PositionName"
                                       class="form-control"
                                       placeholder="Ví dụ: Thu ngân, Quản lý, Kho..." />
                                <span asp-validation-for="PositionName" class="text-danger small"></span>
                            </div>

                            <div class="col-lg-6">
                                <label asp-for="JoinedDate" class="form-label fw-semibold">Ngày vào làm</label>
                                <input asp-for="JoinedDate"
                                       type="date"
                                       class="form-control" />
                                <span asp-validation-for="JoinedDate" class="text-danger small"></span>
                            </div>

                            <div class="col-lg-12">
                                <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
                                <textarea asp-for="Note"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: Làm ca tối, phụ trách kho, ghi chú nội bộ..."></textarea>
                                <span asp-validation-for="Note" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>
                                Gán user vào store
                            </button>

                            <a asp-area="Admin"
                                   asp-controller="UserInStores"
                                   asp-action="Index"
                                   class="btn btn-light border">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .create-userinstore-page {
        max-width: 1440px;
    }

        .create-userinstore-page .create-card {
            border-radius: 18px;
        }

        .create-userinstore-page .nav-pills .nav-link {
            border-radius: 999px;
            color: #475569;
            background: #f1f5f9;
            font-weight: 600;
        }

            .create-userinstore-page .nav-pills .nav-link.active {
                color: #fff;
                background: #4f46e5;
            }

        .create-userinstore-page .form-control,
        .create-userinstore-page .form-select {
            border-radius: 10px;
            min-height: 42px;
        }

        .create-userinstore-page textarea.form-control {
            min-height: 90px;
        }

        .create-userinstore-page .btn {
            border-radius: 10px;
            font-weight: 600;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const keywordInput = document.getElementById('userKeyword');
            const userSelect = document.getElementById('userSelect');
            let timer = null;

            function rebuildUserOptions(items) {
                const currentValue = userSelect.value;
                userSelect.innerHTML = '<option value="">-- Chọn người dùng --</option>';

                items.forEach(item => {
                    const option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.text;

                    if (String(item.id) === String(currentValue)) {
                        option.selected = true;
                    }

                    userSelect.appendChild(option);
                });
            }

            async function loadUsers(keyword) {
                const url = '@Url.Action("SearchUsers", "UserInStores", new { area = "Admin" })'
                    + '?keyword=' + encodeURIComponent(keyword || '');

                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) return;

                const data = await response.json();
                rebuildUserOptions(data);
            }

            keywordInput?.addEventListener('input', function () {
                clearTimeout(timer);

                timer = setTimeout(() => {
                    loadUsers(keywordInput.value);
                }, 300);
            });

            const passwordInput = document.getElementById('newPassword');
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');

            togglePasswordBtn?.addEventListener('click', function () {
                if (!passwordInput) return;

                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';

                togglePasswordBtn.innerHTML = isPassword
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
            });
        })();
    </script>
}