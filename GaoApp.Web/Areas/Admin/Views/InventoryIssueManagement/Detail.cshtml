@functions {
    private string GetDisplayBarcode(GaoApp.Web.Areas.Admin.ViewModels.Orders.InventoryIssueDetailLineVm line)
    {
        // Ưu tiên Barcode nếu ViewModel đã có.
        var barcodeProp = line.GetType().GetProperty("Barcode");
        if (barcodeProp != null)
        {
            var value = barcodeProp.GetValue(line)?.ToString();
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        // fallback nếu ViewModel có mã khác
        var scannedBarcodeProp = line.GetType().GetProperty("ScannedBarcode");
        if (scannedBarcodeProp != null)
        {
            var value = scannedBarcodeProp.GetValue(line)?.ToString();
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return string.Empty;
    }

    private string GetStatusClass(InventoryResolutionStatus status)
    {
        return status switch
        {
            InventoryResolutionStatus.PendingResolution => "bg-warning-subtle text-warning-emphasis",
            InventoryResolutionStatus.ReadyForApproval => "bg-info-subtle text-info-emphasis",
            InventoryResolutionStatus.Approved => "bg-success-subtle text-success-emphasis",
            InventoryResolutionStatus.Rejected => "bg-danger-subtle text-danger-emphasis",
            _ => "bg-secondary-subtle text-secondary-emphasis"
        };
    }

    private string GetSeverityClass(InventoryIssueSeverity severity)
    {
        return severity switch
        {
            InventoryIssueSeverity.Critical => "bg-danger-subtle text-danger-emphasis",
            InventoryIssueSeverity.Overdue => "bg-warning-subtle text-warning-emphasis",
            InventoryIssueSeverity.Warning => "bg-info-subtle text-info-emphasis",
            InventoryIssueSeverity.Normal => "bg-primary-subtle text-primary-emphasis",
            _ => "bg-secondary-subtle text-secondary-emphasis"
        };
    }

    private string GetStatusText(InventoryResolutionStatus status)
    {
        return status switch
        {
            InventoryResolutionStatus.PendingResolution => "Đang chờ hệ thống đối soát",
            InventoryResolutionStatus.ReadyForApproval => "Đã đủ điều kiện duyệt",
            InventoryResolutionStatus.Approved => "Đã duyệt hoàn tất",
            InventoryResolutionStatus.Rejected => "Đã từ chối",
            _ => "Đang xử lý"
        };
    }

    private string GetSeverityText(InventoryIssueSeverity severity)
    {
        return severity switch
        {
            InventoryIssueSeverity.Normal => "Bình thường",
            InventoryIssueSeverity.Warning => "Cảnh báo",
            InventoryIssueSeverity.Overdue => "Quá hạn",
            InventoryIssueSeverity.Critical => "Nghiêm trọng",
            _ => severity.ToString()
        };
    }

    private string GetActionDotClass(InventoryIssueActionType actionType)
    {
        return actionType switch
        {
            InventoryIssueActionType.Approved => "success",
            InventoryIssueActionType.Rejected => "danger",
            InventoryIssueActionType.Escalated => "warning",
            InventoryIssueActionType.Reopened => "secondary",
            _ => ""
        };
    }

    private string GetActionText(InventoryIssueActionType actionType)
    {
        return actionType switch
        {
            InventoryIssueActionType.CaseCreated => "Tạo case",
            InventoryIssueActionType.NegativeDetected => "Phát hiện âm kho",
            InventoryIssueActionType.MarkedReadyForApproval => "Sẵn sàng duyệt",
            InventoryIssueActionType.Approved => "Duyệt case",
            InventoryIssueActionType.Rejected => "Từ chối case",
            InventoryIssueActionType.Reopened => "Mở lại case",
            InventoryIssueActionType.Escalated => "Escalate case",
            InventoryIssueActionType.NoteAdded => "Thêm ghi chú",
            InventoryIssueActionType.LinkedReceipt => "Gắn phiếu nhập",
            InventoryIssueActionType.LinkedAdjustment => "Gắn phiếu điều chỉnh",
            _ => actionType.ToString()
        };
    }

    private string GetSimpleReason(GaoApp.Web.Areas.Admin.ViewModels.Orders.InventoryIssueDetailLineVm line)
    {
        if (!line.QuantityResolved)
            return "Chưa đủ số lượng bù";

        if (!line.DocumentResolved)
            return "Chưa phát hiện inbound";

        if (!line.CostResolved)
            return "Chưa chốt giá vốn";

        return "Đã đủ điều kiện";
    }
}