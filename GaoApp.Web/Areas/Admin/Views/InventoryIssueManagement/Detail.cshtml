@model GaoApp.Web.Areas.Admin.ViewModels.Orders.InventoryIssueDetailVm
@using GaoApp.Domain.Enums

@{
    ViewData["Title"] = "Chi tiết case tồn âm";

    var unresolvedLines = Model.Lines.Where(x => !x.IsResolved).ToList();
    var resolvedPercent = Model.TotalLines > 0
        ? Math.Round((decimal)Model.ResolvedLines * 100 / Model.TotalLines, 0)
        : 0;
}

<div class="container-fluid py-3 inventory-issue-detail-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm border-0">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 issue-hero">
        <div class="card-body p-4 p-xl-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-4">
                <div>
                    <div class="text-uppercase text-muted small fw-semibold mb-2">Inventory Issue</div>
                    <h2 class="fw-bold mb-2">@Model.Code</h2>
                    <div class="text-muted mb-2">
                        Đơn bán:
                        <a asp-action="Detail"
                           asp-controller="OrderManagement"
                           asp-route-id="@Model.OrderId"
                           class="text-decoration-none fw-semibold">
                            @Model.OrderCode
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill @GetStatusClass(Model.Status) px-3 py-2">@GetStatusText(Model.Status)</span>
                        <span class="badge rounded-pill @GetSeverityClass(Model.Severity) px-3 py-2">@GetSeverityText(Model.Severity)</span>
                        <span class="badge rounded-pill @(Model.IsOverdue ? "bg-danger-subtle text-danger-emphasis" : "bg-success-subtle text-success-emphasis") px-3 py-2">
                            @(Model.IsOverdue ? "Quá hạn" : "Trong hạn")
                        </span>
                    </div>
                </div>

                <div class="row g-3 stats-grid">
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="stat-label">Tổng line</div>
                            <div class="stat-value">@Model.TotalLines</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card success">
                            <div class="stat-label">Đã xử lý</div>
                            <div class="stat-value">@Model.ResolvedLines</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card warning">
                            <div class="stat-label">Chưa xử lý</div>
                            <div class="stat-value">@Model.UnresolvedLines</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card danger">
                            <div class="stat-label">Deadline</div>
                            <div class="stat-value small-value">@Model.DueAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="progress-wrap mt-4">
                <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                    <span>Tiến độ xử lý</span>
                    <span>@resolvedPercent%</span>
                </div>
                <div class="progress issue-progress">
                    <div class="progress-bar" style="width:@resolvedPercent%"></div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == InventoryResolutionStatus.PendingResolution)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 status-banner pending">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="banner-title">Hệ thống đang tự đối soát</div>
                    <div class="banner-subtitle">
                        Chưa đủ điều kiện duyệt. Khi đủ số lượng và giá vốn, case sẽ tự chuyển sang chờ duyệt.
                    </div>
                </div>
                <div class="banner-pill">Đang xử lý nền</div>
            </div>
        </div>
    }
    else if (Model.Status == InventoryResolutionStatus.ReadyForApproval)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 status-banner ready">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="banner-title">Đã đủ điều kiện duyệt</div>
                    <div class="banner-subtitle">
                        Quản lý chỉ cần kiểm tra nhanh và bấm duyệt.
                    </div>
                </div>
                <div class="banner-pill">Sẵn sàng duyệt</div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold">Tổng quan case</h5>

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary rounded-3"
                                data-bs-toggle="modal"
                                data-bs-target="#timelineModal">
                            Xem timeline
                        </button>

                        @if (!string.IsNullOrWhiteSpace(Model.InternalNote))
                        {
                            <button class="btn btn-outline-secondary rounded-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#internalNoteModal">
                                Ghi chú nội bộ
                            </button>
                        }
                    </div>
                </div>

                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Nguyên nhân</div>
                                <div class="value">@Model.ReasonType</div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Mở case</div>
                                <div class="value">@Model.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Deadline</div>
                                <div class="value">@Model.DueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Sẵn sàng duyệt</div>
                                <div class="value">@(Model.ReadyForApprovalAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Đã duyệt</div>
                                <div class="value">@(Model.ApprovedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="info-box">
                                <div class="label">Đã từ chối</div>
                                <div class="value">@(Model.RejectedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (unresolvedLines.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 unresolved-focus-card">
                    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="mb-1 fw-bold text-danger">Line cần xử lý</h5>
                            <div class="small text-muted">Các line này đang chặn case chuyển sang duyệt.</div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-2">
                            @unresolvedLines.Count line
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @foreach (var line in unresolvedLines)
                            {
                                <div class="col-12">
                                    <div class="quick-unresolved-item">
                                        <div>
                                            <div class="fw-semibold">@line.ProductName</div>
                                            <div class="small text-muted">
                                                Barcode: @(GetDisplayBarcode(line) ?? "-")
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-danger fw-semibold">Âm: @line.NegativeQty</div>
                                            <div class="small text-muted">@GetSimpleReason(line)</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold">Danh sách issue line</h5>
                    <span class="text-muted small">Bấm “Xem nhanh” để xem thông tin ngắn gọn</span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table issue-lines-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-end">Phần âm</th>
                                    <th class="text-end">Đã bù</th>
                                    <th class="text-center">Giá vốn</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Tác vụ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lines.Any())
                                {
                                    foreach (var line in Model.Lines)
                                    {
                                        var modalId = $"lineDetailModal_{line.Id}";
                                        var rowClass = line.IsResolved ? "issue-line-row resolved" : "issue-line-row unresolved";

                                        var provisionalAmount = line.ProvisionalCostAmount ?? 0m;
                                        var revaluationAmount = line.RevaluationAmount ?? 0m;
                                        var finalCostAmount = provisionalAmount + revaluationAmount;

                                        var displayUnitCost = line.NegativeQty > 0
                                            ? Math.Round(finalCostAmount / line.NegativeQty, 4, MidpointRounding.AwayFromZero)
                                            : 0m;

                                        var costLabel = line.CostResolved ? "Giá vốn cuối" : "Giá vốn tạm";
                                        var displayBarcode = GetDisplayBarcode(line);

                                        <tr class="@rowClass">
                                            <td>
                                                <div class="d-flex align-items-start gap-3">
                                                    <div class="line-state-dot @(line.IsResolved ? "ok" : "pending")"></div>
                                                    <div>
                                                        <div class="fw-semibold">@line.ProductName</div>
                                                        <div class="text-muted small">
                                                            Barcode: @(displayBarcode ?? "-")
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="text-end fw-bold text-danger">@line.NegativeQty</td>

                                            <td class="text-end">
                                                <div class="fw-semibold @(line.QuantityResolved ? "text-success" : "text-danger")">
                                                    @line.AutoDetectedInboundQty / @line.NegativeQty
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <div class="cost-chip @(line.CostResolved ? "final" : "temp")">
                                                    <div class="cost-chip-label">@costLabel</div>
                                                    <div class="cost-chip-value">@displayUnitCost.ToString("N2")</div>
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                @if (line.IsResolved)
                                                {
                                                    <div class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2">
                                                        Đã resolve
                                                    </div>
                                                    <div class="text-muted small mt-1">
                                                        @(line.ResolvedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-2">
                                                        Chưa resolve
                                                    </div>
                                                    <div class="small text-danger mt-1 fw-semibold">
                                                        @GetSimpleReason(line)
                                                    </div>
                                                }
                                            </td>

                                            <td class="text-center">
                                                <button class="btn btn-outline-primary btn-sm rounded-3"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#@modalId">
                                                    Xem nhanh
                                                </button>
                                            </td>
                                        </tr>

                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow-lg">
                                                    <div class="modal-header border-0 pb-0 px-4 pt-4">
                                                        <div>
                                                            <h5 class="modal-title fw-bold mb-1">@line.ProductName</h5>
                                                            <div class="text-muted small">
                                                                Barcode: @(displayBarcode ?? "-")
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>

                                                    <div class="modal-body px-4 pt-3 pb-4">
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-4">
                                                                <div class="metric-box">
                                                                    <div class="metric-label">Số lượng bán</div>
                                                                    <div class="metric-value">@line.OrderedQty</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="metric-box danger">
                                                                    <div class="metric-label">Phần âm phát sinh</div>
                                                                    <div class="metric-value text-danger">@line.NegativeQty</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="metric-box">
                                                                    <div class="metric-label">Đã bù</div>
                                                                    <div class="metric-value @(line.QuantityResolved ? "text-success" : "text-danger")">
                                                                        @line.AutoDetectedInboundQty / @line.NegativeQty
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-6">
                                                                <div class="simple-status-card @(line.QuantityResolved ? "ok" : "not-ok")">
                                                                    <div class="simple-status-title">Số lượng</div>
                                                                    <div class="simple-status-value">
                                                                        @(line.QuantityResolved ? "Đã đủ" : "Chưa đủ")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="simple-status-card @(line.CostResolved ? "ok" : "not-ok")">
                                                                    <div class="simple-status-title">Giá vốn</div>
                                                                    <div class="simple-status-value">
                                                                        @(line.CostResolved ? "Đã chốt" : "Tạm tính")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-6">
                                                                <div class="info-box highlight-box">
                                                                    <div class="label">Giá vốn hiển thị</div>
                                                                    <div class="value large @(line.CostResolved ? "text-success" : "text-warning-emphasis")">
                                                                        @displayUnitCost.ToString("N2")
                                                                    </div>
                                                                    <div class="small text-muted mt-2">
                                                                        @(line.CostResolved
                                                                            ? "Đây là giá vốn cuối đã chốt."
                                                                            : "Đây là giá vốn tạm để tham khảo.")
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <div class="info-box">
                                                                    <div class="label">Kết quả xử lý</div>
                                                                    <div class="value">
                                                                        @if (line.IsResolved)
                                                                        {
                                                                            <span class="text-success fw-semibold">Line đã đủ điều kiện</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-danger fw-semibold">@GetSimpleReason(line)</span>
                                                                        }
                                                                    </div>
                                                                    <div class="small text-muted mt-2">
                                                                        Available hiện tại: @line.CurrentAvailableQty
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row g-3">
                                                            <div class="col-md-4">
                                                                <div class="info-box">
                                                                    <div class="label">Tồn lúc bán</div>
                                                                    <div class="value">@line.StockBefore / @line.StockAfter</div>
                                                                    <div class="small text-muted mt-2">Trước / Sau</div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="info-box">
                                                                    <div class="label">Giá vốn tạm</div>
                                                                    <div class="value">@(line.ProvisionalUnitCost?.ToString("N2") ?? "-")</div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="info-box">
                                                                    <div class="label">Điều chỉnh giá vốn</div>
                                                                    <div class="value">@(line.RevaluationAmount?.ToString("N0") ?? "0")</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">Không có dòng issue.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4 sticky-xl-top issue-sidebar">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="mb-0 fw-bold">Thao tác case</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="case-status-box status-@Model.Status">
                        <div class="case-status-label">Trạng thái xử lý</div>
                        <div class="case-status-title">@GetStatusText(Model.Status)</div>
                        <div class="case-status-subtitle">
                            @if (Model.Status == InventoryResolutionStatus.PendingResolution)
                            {
                                @:Hệ thống sẽ tự chuyển sang chờ duyệt khi tất cả line đủ điều kiện.
                            }
                            else if (Model.Status == InventoryResolutionStatus.ReadyForApproval)
                            {
                                @:Case đã đủ điều kiện. Bạn có thể duyệt ngay.
                            }
                            else if (Model.Status == InventoryResolutionStatus.Approved)
                            {
                                @:Case đã hoàn tất.
                            }
                            else if (Model.Status == InventoryResolutionStatus.Rejected)
                            {
                                @:Case đã bị từ chối.
                            }
                        </div>
                    </div>

                    <form asp-area="Admin" asp-controller="InventoryIssueManagement" asp-action="AddNote" method="post" class="mb-4 action-box">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IssueId" value="@Model.Id" />
                        <label class="form-label fw-semibold">Thêm ghi chú</label>
                        <textarea name="Note" class="form-control rounded-3" rows="3" placeholder="Nhập ghi chú xử lý..."></textarea>
                        <button type="submit" class="btn btn-outline-dark rounded-3 w-100 mt-3">Thêm ghi chú</button>
                    </form>

                    <form asp-area="Admin" asp-controller="InventoryIssueManagement" asp-action="Approve" method="post" class="mb-4 action-box">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IssueId" value="@Model.Id" />
                        <label class="form-label fw-semibold">Ghi chú duyệt</label>
                        <textarea name="Note" class="form-control rounded-3" rows="2" placeholder="Đã kiểm tra đủ điều kiện..."></textarea>
                        <button type="submit" class="btn btn-success rounded-3 w-100 mt-3"
                                @(Model.Status != InventoryResolutionStatus.ReadyForApproval ? "disabled" : null)>
                            Duyệt case
                        </button>
                    </form>

                    <form asp-area="Admin" asp-controller="InventoryIssueManagement" asp-action="Reject" method="post" class="mb-4 action-box">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IssueId" value="@Model.Id" />
                        <label class="form-label fw-semibold">Lý do từ chối</label>
                        <textarea name="Note" class="form-control rounded-3" rows="3" placeholder="Nhập lý do..." required></textarea>
                        <button type="submit" class="btn btn-danger rounded-3 w-100 mt-3"
                                @(Model.Status == InventoryResolutionStatus.Approved ? "disabled" : null)>
                            Từ chối
                        </button>
                    </form>

                    <form asp-area="Admin" asp-controller="InventoryIssueManagement" asp-action="Escalate" method="post" class="mb-4 action-box">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IssueId" value="@Model.Id" />
                        <label class="form-label fw-semibold">Escalate</label>
                        <textarea name="Note" class="form-control rounded-3" rows="2" placeholder="Lý do escalate..." required></textarea>
                        <button type="submit" class="btn btn-outline-warning rounded-3 w-100 mt-3">Escalate</button>
                    </form>

                    <form asp-area="Admin" asp-controller="InventoryIssueManagement" asp-action="Reopen" method="post" class="action-box">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IssueId" value="@Model.Id" />
                        <label class="form-label fw-semibold">Mở lại case</label>
                        <textarea name="Note" class="form-control rounded-3" rows="2" placeholder="Lý do mở lại..." required></textarea>
                        <button type="submit" class="btn btn-outline-secondary rounded-3 w-100 mt-3">Reopen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="timelineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <h5 class="modal-title fw-bold mb-1">Timeline xử lý</h5>
                    <div class="text-muted small">Lịch sử xử lý đầy đủ của case</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-4 pt-3 pb-4">
                @if (Model.Actions.Any())
                {
                    <div class="timeline">
                        @foreach (var item in Model.Actions.OrderByDescending(x => x.ActionAtUtc))
                        {
                            var collapseId = $"timelineCollapse_{item.Id}";
                            var shortNote = string.IsNullOrWhiteSpace(item.Note)
                                ? "Không có ghi chú."
                                : (item.Note.Length > 120 ? item.Note.Substring(0, 120) + "..." : item.Note);

                            <div class="timeline-item">
                                <div class="timeline-dot @GetActionDotClass(item.ActionType)"></div>

                                <div class="timeline-content compact">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                        <div>
                                            <div class="fw-semibold timeline-title">@GetActionText(item.ActionType)</div>
                                            <div class="small text-muted">
                                                Người thực hiện:
                                                @(string.IsNullOrWhiteSpace(item.ActorName) ? "-" : item.ActorName)
                                            </div>
                                        </div>

                                        <div class="small text-muted">
                                            @item.ActionAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @if (item.ReferenceType != InventoryIssueReferenceType.None)
                                        {
                                            <span class="badge bg-light text-dark border">@item.ReferenceType</span>
                                        }
                                        @if (item.ReferenceId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">RefId: @item.ReferenceId</span>
                                        }
                                        @if (item.OrderInventoryIssueLineId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">IssueLineId: @item.OrderInventoryIssueLineId</span>
                                        }
                                    </div>

                                    <div class="timeline-preview-box">
                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                            <div class="small text-muted timeline-preview-text flex-grow-1">
                                                @shortNote
                                            </div>

                                            <button class="btn btn-sm btn-outline-secondary rounded-3 flex-shrink-0"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false"
                                                    aria-controls="@collapseId">
                                                Xem
                                            </button>
                                        </div>

                                        <div class="collapse mt-3" id="@collapseId">
                                            <div class="timeline-expand-box">
                                                <div class="row g-3 mb-3">
                                                    <div class="col-md-4">
                                                        <div class="info-box">
                                                            <div class="label">Người thực hiện</div>
                                                            <div class="value">@(string.IsNullOrWhiteSpace(item.ActorName) ? "-" : item.ActorName)</div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <div class="info-box">
                                                            <div class="label">Loại tham chiếu</div>
                                                            <div class="value">@item.ReferenceType</div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <div class="info-box">
                                                            <div class="label">RefId</div>
                                                            <div class="value">@(item.ReferenceId?.ToString() ?? "-")</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (item.OrderInventoryIssueLineId.HasValue)
                                                {
                                                    <div class="mb-3">
                                                        <span class="badge bg-light text-dark border">
                                                            IssueLineId: @item.OrderInventoryIssueLineId
                                                        </span>
                                                    </div>
                                                }

                                                <div class="timeline-note-full-box">
                                                    <div class="timeline-note-title">Chi tiết</div>
                                                    <div class="timeline-note-full">
                                                        @(string.IsNullOrWhiteSpace(item.Note) ? "Không có ghi chú." : item.Note)
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Chưa có timeline.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.InternalNote))
{
    <div class="modal fade" id="internalNoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Ghi chú nội bộ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="timeline-note-full">@Model.InternalNote</div>
                </div>
            </div>
        </div>
    </div>
}

