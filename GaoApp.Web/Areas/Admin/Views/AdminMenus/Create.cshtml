@model GaoApp.Application.DTOs.AdminMenus.SaveAdminMenuItemRequest

@{
    ViewData["Title"] = "Thêm menu";
    ViewData["ConfirmationHelp"] = "Menu có điều kiện quyền cần lý do và mật khẩu xác minh của quản trị viên đang thao tác.";
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/gaoapp.menu-management.mobile.css" asp-append-version="true" />
}
<div class="container-fluid admin-menu-form-page" data-menu-mobile-form data-menu-operation="create" data-menu-current-parent="@Model.ParentId" data-menu-current-icon="@Model.Icon" data-gao-theme="commerce">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Thêm menu</h3>
            <div class="text-muted">
                Tạo menu cha hoặc menu con và chọn điều kiện hiển thị.
            </div>
        </div>

        <a asp-area="Admin"
               asp-controller="AdminMenus"
               asp-action="Index"
               class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            Vui lòng kiểm tra lại thông tin menu.
        </div>
    }

    <form asp-area="Admin"
          asp-controller="AdminMenus"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()
        <partial name="_SecurityActionConfirmation" />

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h5 class="mb-1">Thông tin menu</h5>
                        <div class="text-muted small">
                            Cấu hình tên, cấp cha/con, đường dẫn và icon.
                        </div>
                    </div>

                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                Tên menu <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Ví dụ: Báo cáo doanh thu, Kho hàng..." />

                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="ParentId" class="form-label fw-semibold">
                                    Menu cha
                                </label>

                                <select asp-for="ParentId" class="form-select">
                                    <option value="">-- Là menu cha --</option>

                                    @if (ViewBag.ParentMenus != null)
                                    {
                                        foreach (var parent in ViewBag.ParentMenus)
                                        {
                                            <option value="@parent.Id">@parent.Title</option>

                                            if (parent.Children != null)
                                            {
                                                foreach (var child in parent.Children)
                                                {
                                                    <option value="@child.Id">-- @child.Title</option>
                                                }
                                            }
                                        }
                                    }
                                </select>

                                <div class="form-text">
                                    Để trống nếu tạo menu cha.
                                </div>

                                <span asp-validation-for="ParentId"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SortOrder" class="form-label fw-semibold">
                                    Thứ tự hiển thị
                                </label>

                                <input asp-for="SortOrder"
                                       class="form-control"
                                       type="number"
                                       min="0" />

                                <span asp-validation-for="SortOrder"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label asp-for="Area" class="form-label fw-semibold">
                                    Area
                                </label>

                                <input asp-for="Area"
                                       class="form-control"
                                       placeholder="Admin" />

                                <span asp-validation-for="Area"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Controller" class="form-label fw-semibold">
                                    Controller
                                </label>

                                <input asp-for="Controller"
                                       id="Controller"
                                       class="form-control"
                                       placeholder="Product, Reports, POS..." />

                                <span asp-validation-for="Controller"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Action" class="form-label fw-semibold">
                                    Action
                                </label>

                                <input asp-for="Action"
                                       id="Action"
                                       class="form-control"
                                       placeholder="Index" />

                                <span asp-validation-for="Action"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="mt-3">
                            <label asp-for="Url" class="form-label fw-semibold">
                                Url tùy chỉnh
                            </label>

                            <input asp-for="Url"
                                   class="form-control"
                                   placeholder="/Admin/POS hoặc để trống nếu dùng Controller/Action" />

                            <div class="form-text">
                                Nếu nhập Url thì sidebar dùng Url trực tiếp.
                            </div>

                            <span asp-validation-for="Url"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mt-3">
                            <label asp-for="Icon" class="form-label fw-semibold">
                                Icon
                            </label>

                            <select asp-for="Icon" class="form-select">
                                <option value="">-- Chọn icon --</option>
                                <option value="bx bx-home-smile">🏠 Trang chủ</option>
                                <option value="bx bx-box">📦 Danh mục</option>
                                <option value="bx bx-buildings">🏬 Kho</option>
                                <option value="bx bx-cart">🛒 Bán hàng</option>
                                <option value="bx bx-bar-chart">📊 Báo cáo</option>
                                <option value="bx bx-user">👤 Nhân sự</option>
                                <option value="bx bx-shield-quarter">🛡️ Bảo mật</option>
                                <option value="bx bx-cog">⚙️ Cài đặt</option>
                                <option value="bx bx-slideshow">🖥️ Màn hình khách</option>
                            </select>

                            <span asp-validation-for="Icon"
                                  class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch mt-4">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   role="switch" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-semibold">
                                Hiển thị menu
                            </label>
                        </div>

                    </div>
                </div>

                <partial name="_MenuPermissionSelector" model="Model" />

            </div>

            <div class="col-xl-4">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h5 class="mb-1">Gợi ý nhanh</h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="example-box mb-3">
                            <div class="fw-semibold mb-1">Menu cha</div>
                            <code>Title = Báo cáo</code><br />
                            <code>Icon = bx bx-bar-chart</code><br />
                            <code>Permission = trống</code>
                        </div>

                        <div class="example-box">
                            <div class="fw-semibold mb-1">Menu con</div>
                            <code>Controller = Reports</code><br />
                            <code>Action = Revenue</code><br />
                            <code>Permission = report.revenue.view</code>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>
                                Lưu menu
                            </button>

                            <a asp-area="Admin"
                                   asp-controller="AdminMenus"
                                   asp-action="Index"
                                   class="btn btn-light border">
                                Hủy
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </form>

</div>

<partial name="_MobileMenuReview" />
@await Html.PartialAsync("_MobileParentChoices", (IEnumerable<GaoApp.Application.DTOs.AdminMenus.AdminMenuItemDto>)(ViewBag.ParentMenus ?? new List<GaoApp.Application.DTOs.AdminMenus.AdminMenuItemDto>()))
<style>
    .admin-menu-form-page .card {
        border-radius: 18px;
    }

    .admin-menu-form-page .form-control,
    .admin-menu-form-page .form-select {
        border-radius: 12px;
    }

    .admin-menu-form-page .example-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem;
    }

    .admin-menu-form-page code {
        color: #db2777;
        background: #fdf2f8;
        padding: .15rem .35rem;
        border-radius: .45rem;
        font-size: .78rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/Admin/js/gaoapp.menu-form.mobile.js" asp-append-version="true"></script>
}
