@using GaoApp.Web.Areas.Admin.ViewModels.Units
@model UnitIndexVM

@{
    var items =
        Model.Paged.Items;

    var totalItems =
        Model.Paged.TotalItems;

    var pageSize =
        Model.PageSize <= 0
            ? 20
            : Model.PageSize;

    var currentPage =
        Model.Page <= 0
            ? 1
            : Model.Page;

    var totalPages =
        (int)Math.Ceiling(
            (double)totalItems /
            pageSize);

    var firstItem =
        totalItems == 0
            ? 0
            : ((currentPage - 1) * pageSize) + 1;

    var lastItem =
        totalItems == 0
            ? 0
            : Math.Min(
                currentPage * pageSize,
                totalItems);
}

<div data-unit-result
     data-total-units="@Model.TotalUnitCount"
     data-active-units="@Model.ActiveUnitCount"
     data-inactive-units="@Model.InactiveUnitCount">

    <section class="gds-list-panel"
             aria-label="Danh sách đơn vị tính">

        @if (items == null || !items.Any())
        {
            <div class="gds-empty">

                <div class="gds-empty__icon"
                     aria-hidden="true">
                    <i class="bx bx-ruler"></i>
                </div>

                <div class="fw-semibold mb-1">
                    Chưa có đơn vị tính phù hợp
                </div>

                <div class="gds-empty__copy">
                    Thử thay đổi từ khóa hoặc trạng thái lọc.
                </div>
            </div>
        }
        else
        {
            <div class="gds-desktop-list">
                <div class="table-responsive">

                    <table class="table align-middle gds-table">
                        <thead>
                            <tr>
                                <th style="width: 150px;">
                                    Mã đơn vị
                                </th>

                                <th>
                                    Tên đơn vị
                                </th>

                                <th style="width: 145px;">
                                    Loại
                                </th>

                                <th style="width: 100px;">
                                    Thứ tự
                                </th>

                                <th style="width: 185px;">
                                    Trạng thái
                                </th>

                                <th style="width: 145px;">
                                    Ngày tạo
                                </th>

                                <th class="text-end"
                                    style="width: 120px;">
                                    Thao tác
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var x in items)
                            {
                                <tr>
                                    <td>
                                        <span class="gds-code">
                                            @x.Code
                                        </span>
                                    </td>

                                    <td>
                                        <div class="gds-table__primary">
                                            @x.Name
                                        </div>
                                    </td>

                                    <td>
                                        @if (x.IsBase)
                                        {
                                            <span class="gds-status is-info">
                                                Đơn vị gốc
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="gds-table__secondary">
                                                Thường
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="gds-table__secondary">
                                            @x.SortOrder
                                        </span>
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="gds-status gds-status--dot gds-status-button js-toggle-status @(x.Status ? "is-success" : "is-neutral")"
                                                data-id="@x.Id"
                                                data-name="@x.Name"
                                                data-status="@x.Status.ToString().ToLowerInvariant()"
                                                aria-label="@(x.Status ? $"Ngừng hoạt động đơn vị {x.Name}" : $"Mở hoạt động đơn vị {x.Name}")"
                                                title="@(x.Status ? "Bấm để ngừng hoạt động" : "Bấm để mở hoạt động")"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top">

                                            @(x.Status
                                                ? "Đang hoạt động"
                                                : "Ngừng hoạt động")
                                        </button>
                                    </td>

                                    <td>
                                        <span class="gds-table__secondary">
                                            @(x.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy"))
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="gds-row-actions justify-content-end">

                                            <a asp-area="Admin"
                                               asp-controller="Unit"
                                               asp-action="Edit"
                                               asp-route-id="@x.Id"
                                               class="gds-icon-button gds-action-button"
                                               aria-label="Sửa đơn vị @x.Name"
                                               title="Sửa"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top">

                                                <i class="bx bx-edit"
                                                   aria-hidden="true"></i>
                                            </a>

                                            <button type="button"
                                                    class="gds-icon-button gds-action-button is-danger js-delete"
                                                    data-id="@x.Id"
                                                    data-name="@x.Name"
                                                    aria-label="Xóa đơn vị @x.Name"
                                                    title="Xóa"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top">

                                                <i class="bx bx-trash"
                                                   aria-hidden="true"></i>
                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="gds-mobile-list"
                 aria-label="Danh sách đơn vị tính trên thiết bị di động">

                @foreach (var x in items)
                {
                    <article class="gds-row-card">

                        <div class="gds-row-card__header">

                            <div>
                                <div class="gds-row-card__title">
                                    @x.Name
                                </div>

                                <div class="gds-code mt-1">
                                    @x.Code
                                </div>
                            </div>

                            <button type="button"
                                    class="gds-status gds-status--dot gds-status-button js-toggle-status @(x.Status ? "is-success" : "is-neutral")"
                                    data-id="@x.Id"
                                    data-name="@x.Name"
                                    data-status="@x.Status.ToString().ToLowerInvariant()"
                                    aria-label="@(x.Status ? $"Ngừng hoạt động đơn vị {x.Name}" : $"Mở hoạt động đơn vị {x.Name}")">

                                @(x.Status
                                    ? "Đang hoạt động"
                                    : "Ngừng hoạt động")
                            </button>
                        </div>

                        <div class="gds-row-card__meta">

                            @if (x.IsBase)
                            {
                                <span class="gds-status is-info me-2">
                                    Đơn vị gốc
                                </span>
                            }
                            else
                            {
                                <span class="me-2">
                                    Đơn vị thường
                                </span>
                            }

                            <span>
                                Thứ tự: @x.SortOrder
                            </span>
                        </div>

                        <div class="gds-row-card__meta">
                            <span>
                                <i class="bx bx-calendar me-1"
                                   aria-hidden="true"></i>

                                Tạo @(x.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy"))
                            </span>
                        </div>

                        <div class="gds-row-card__actions">

                            <a asp-area="Admin"
                               asp-controller="Unit"
                               asp-action="Edit"
                               asp-route-id="@x.Id"
                               class="btn btn-sm btn-label-primary gds-action-button">

                                <i class="bx bx-edit me-1"
                                   aria-hidden="true"></i>

                                Sửa
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-label-danger gds-action-button js-delete"
                                    data-id="@x.Id"
                                    data-name="@x.Name">

                                <i class="bx bx-trash me-1"
                                   aria-hidden="true"></i>

                                Xóa
                            </button>

                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="gds-list-footer">

        <div class="gds-list-footer__summary">

            @if (totalItems == 0)
            {
                <span>
                    0 kết quả
                </span>
            }
            else
            {
                <span>
                    <strong>
                        @firstItem–@lastItem
                    </strong>
                    / @totalItems kết quả
                </span>
            }

        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Phân trang đơn vị tính">
                <ul class="pagination mb-0">

                    @{
                        var start =
                            Math.Max(
                                1,
                                currentPage - 3);

                        var end =
                            Math.Min(
                                totalPages,
                                start + 6);

                        start =
                            Math.Max(
                                1,
                                end - 6);
                    }

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage - 1)"
                           aria-label="Trang trước">

                            <i class="bx bx-chevron-left"
                               aria-hidden="true"></i>
                        </a>
                    </li>

                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">

                            <a href="#"
                               class="page-link js-page-link"
                               data-page="@p"
                               aria-current="@(p == currentPage ? "page" : null)">
                                @p
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage + 1)"
                           aria-label="Trang sau">

                            <i class="bx bx-chevron-right"
                               aria-hidden="true"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>