                    <div><span>Số dòng</span><strong>@managerLines.Count</strong></div>
                    @if (canViewCost)
                    {
                        <div><span>Tổng</span><strong id="commercialApprovalModalMerchandiseTotal">@Model.TotalAmount.ToString("N0") đ</strong></div>
                    }
                    <div><span>Ngoài PO</span><strong>@(pendingOutsideCount == 0 ? "Đã xử lý" : $"Còn {pendingOutsideCount}")</strong></div>
                </div>

                <fieldset id="approvalInvoiceChoices" class="border rounded-3 p-3 mb-3">
                    <legend class="float-none w-auto fs-6 px-2 fw-semibold">Theo dõi hóa đơn sau khi duyệt</legend>
                    <label class="d-flex gap-2 border rounded-3 p-3 mb-2">
                        <input class="form-check-input flex-shrink-0" type="radio" name="approvalInvoiceExpectation" value="waiting" />
                        <span><strong>Chờ nhà cung cấp gửi hóa đơn</strong><small class="d-block text-muted">Ghi nhận kho và giá nhập ngay. Bổ sung XML sau.</small></span>
                    </label>
                    <label class="d-flex gap-2 border rounded-3 p-3">
                        <input class="form-check-input flex-shrink-0" type="radio" name="approvalInvoiceExpectation" value="notExpected" />
                        <span><strong>Hoàn tất, không chờ hóa đơn</strong><small class="d-block text-muted">Phiếu hoàn tất sau khi ghi sổ.</small></span>
                    </label>
                </fieldset>
                <div id="approvalInvoiceLinked" class="alert alert-info" hidden></div>
                @if (canPrintLabels)
                {
                    <label class="d-flex gap-2 border rounded-3 p-3 mb-3">
                        <input type="checkbox" class="form-check-input flex-shrink-0" id="approvalQueueLabels" />
                        <span><strong>Đưa phiếu vào danh sách chờ in tem</strong><small class="d-block text-muted">Chọn mẫu và số lượng tại màn in tem. Chưa gửi lệnh in lúc duyệt.</small></span>
                    </label>
                }
                <label class="form-label fw-semibold">Ghi chú duyệt</label>
                <textarea class="form-control"
                          id="approveNote"
                          rows="2"
                          placeholder="Nhập ghi chú duyệt nếu cần..."></textarea>

                <div class="form-text text-danger mt-2" id="approveMessage"></div>
            </div>

            <div class="modal-footer justify-content-end border-0 px-4 pb-4 pt-0">
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">
                        Quay lại
                    </button>

                    <button type="button"
                            class="btn btn-success px-4"
                            id="btnApprove">
                        <i class="bx bx-check me-1"></i>
                        Duyệt và ghi sổ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

