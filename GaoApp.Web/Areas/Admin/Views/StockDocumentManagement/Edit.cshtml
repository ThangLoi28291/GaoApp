@model GaoApp.Application.DTOs.Inventory.StockDocumentDto
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Inventory
@using GaoApp.Application.Common.Security
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Chi tiết phiếu nhập kho";
    Layout = "_ContentNavbarLayout";

    var hasCreatePermission = (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: AppPermissions.InventoryStockDocumentCreate)).Succeeded;

    var hasApprovePermission = (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: AppPermissions.InventoryStockDocumentApprove)).Succeeded;

    var canEditHeaderByStatus = Model.Status == StockDocumentStatus.Draft
                             || Model.Status == StockDocumentStatus.PendingApproval
                             || Model.Status == StockDocumentStatus.Rejected;

    var canEditLinesByStatus = Model.Status == StockDocumentStatus.Draft
                            || Model.Status == StockDocumentStatus.PendingApproval
                            || Model.Status == StockDocumentStatus.Rejected;

    var canSubmitApprovalByStatus = Model.Status == StockDocumentStatus.Draft
                                 || Model.Status == StockDocumentStatus.Rejected;

    var canApproveByStatus = Model.Status == StockDocumentStatus.PendingApproval;

    var canEditHeader = hasCreatePermission && canEditHeaderByStatus;
    var canEditLines = hasCreatePermission && canEditLinesByStatus;
    var canSubmitApproval = hasCreatePermission && canSubmitApprovalByStatus;
    var canApprove = hasApprovePermission && canApproveByStatus;

    string statusText = Model.Status switch
    {
        StockDocumentStatus.Draft => "Nháp",
        StockDocumentStatus.PendingApproval => "Chờ duyệt",
        StockDocumentStatus.Confirmed => "Đã duyệt",
        StockDocumentStatus.Rejected => "Bị từ chối",
        StockDocumentStatus.Cancelled => "Đã hủy",
        _ => Model.Status.ToString()
    };

    var linesTableVm = new StockDocumentLinesTableViewModel
    {
        CanEdit = canEditLines,
        Lines = Model.Lines?.OrderBy(x => x.LineNo).ToList()
            ?? new List<GaoApp.Application.DTOs.Inventory.StockDocumentLineDto>()
    };
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <link href="~/admin/css/stock-document-management.css" rel="stylesheet" />
}

<div class="container-xxl flex-grow-1 container-p-y">

    <input type="hidden" id="StockDocumentId" value="@Model.Id" />
    <input type="hidden" id="CurrentWarehouseId" value="@Model.WarehouseId" />
    <input type="hidden" id="CurrentWarehouseText" value="@Model.WarehouseName" />
    <input type="hidden" id="CurrentSupplierId" value="@(Model.SupplierId?.ToString() ?? "")" />
    <input type="hidden" id="CurrentSupplierText" value="@(Model.SupplierName ?? "")" />
    <input type="hidden" id="CanEditHeader" value="@canEditHeader.ToString().ToLower()" />
    <input type="hidden" id="CanEditLines" value="@canEditLines.ToString().ToLower()" />

    <div class="card sd-card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                    <h4 class="mb-1">Phiếu nhập kho: @Model.DocumentNo</h4>
                    <div class="sd-status-text">Trạng thái: @statusText</div>
                </div>

                <div class="sd-toolbar">
                    <a href="@Url.Action("Index", "StockDocumentManagement", new { area = "Admin" })"
                           class="btn btn-outline-secondary">
                        Quay lại danh sách
                    </a>

                    @if (canSubmitApproval)
                    {
                        <button type="button"
                                class="btn btn-warning"
                                id="btnOpenSubmitApprovalModal">
                            @(Model.Status == StockDocumentStatus.Rejected ? "Gửi duyệt lại" : "Gửi duyệt")
                        </button>
                    }

                    @if (canApprove)
                    {
                        <button type="button" class="btn btn-success" id="btnOpenApproveModal">
                            Duyệt phiếu
                        </button>

                        <button type="button" class="btn btn-danger" id="btnOpenRejectModal">
                            Từ chối
                        </button>
                    }
                </div>
            </div>
            @if (Model.Status == StockDocumentStatus.PendingApproval && Model.HasRevisionRequest)
            {
                <div class="alert alert-danger border-0 rounded-4 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="fw-bold mb-1">
                                ⚠ Nhân viên yêu cầu mở lại phiếu để chỉnh sửa
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.RevisionRequestNote))
                            {
                                <div>
                                    <b>Lý do:</b> @Model.RevisionRequestNote
                                </div>
                            }

                            @if (Model.RevisionRequestedAtUtc.HasValue)
                            {
                                <div class="small mt-1">
                                    Gửi lúc:
                                    @Model.RevisionRequestedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        </div>

                        @if (canApprove)
                        {
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-danger"
                                        id="btnReturnToEdit">
                                    Trả về sửa
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        id="btnIgnoreRevisionRequest">
                                    Bỏ qua yêu cầu
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mã phiếu</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@Model.DocumentNo"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Kho</label>
                    <select id="WarehouseId" class="form-select"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Nhà cung cấp</label>
                    <select id="SupplierId" class="form-select"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@statusText"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Ngày phiếu</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@Model.DocumentDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Gửi duyệt lúc</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@(Model.SubmittedAtUtc.HasValue ? Model.SubmittedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : string.Empty)"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Duyệt lúc</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@(Model.ApprovedAtUtc.HasValue ? Model.ApprovedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : string.Empty)"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Tổng tiền</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           id="txtTotalAmount"
                           value="@Model.TotalAmount.ToString("N0")"
                           readonly />
                </div>

                <div class="col-12">
                    <label class="form-label">Ghi chú phiếu</label>
                    <textarea id="DocumentNote"
                              class="form-control"
                              rows="2">@Model.Note</textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Ghi chú duyệt / từ chối</label>
                    <textarea id="ApprovalNote"
                              class="form-control"
                              rows="2">@Model.ApprovalNote</textarea>
                </div>
            </div>
        </div>
    </div>
    @if (Model.Status == StockDocumentStatus.PendingApproval && hasApprovePermission)
{
    <div class="card sd-card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <div class="sd-section-title mb-1">Hóa đơn điện tử đầu vào</div>
                    <small class="text-muted">
                        Upload XML hóa đơn đầu vào để đối chiếu từng dòng nhập kho.
                    </small>
                </div>

                @if (canEditLines)
                {
                    <div class="d-flex gap-2">
                        <input type="file"
                               id="inputInvoiceXmlFile"
                               class="form-control"
                               accept=".xml"
                               style="max-width:320px;" />

                        <button type="button"
                                id="btnUploadInputInvoiceXml"
                                class="btn btn-primary">
                            Upload XML
                        </button>
                    </div>
                }
            </div>

            <div id="inputInvoiceUploadMessage" class="small mb-3"></div>

            <div id="inputInvoiceInfoBox" class="border rounded-3 p-3 bg-light d-none">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-muted small">Ký hiệu</div>
                        <div class="fw-semibold" id="xmlInvoiceSeries">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">Số hóa đơn</div>
                        <div class="fw-semibold" id="xmlInvoiceNumber">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">Ngày hóa đơn</div>
                        <div class="fw-semibold" id="xmlInvoiceDate">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">Số dòng XML</div>
                        <div class="fw-semibold" id="xmlDetailCount">0</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">MST người bán</div>
                        <div class="fw-semibold" id="xmlSellerTaxCode">-</div>
                    </div>

                    <div class="col-md-8">
                        <div class="text-muted small">Tên người bán</div>
                        <div class="fw-semibold" id="xmlSellerName">-</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">Tiền trước thuế</div>
                        <div class="fw-semibold" id="xmlTotalBeforeTax">0</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">Tiền thuế</div>
                        <div class="fw-semibold" id="xmlTotalTaxAmount">0</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">Tổng thanh toán</div>
                        <div class="fw-bold text-primary" id="xmlTotalPaymentAmount">0</div>
                    </div>
                </div>
            </div>

            <div id="inputInvoiceListContainer" class="mt-3">
                <div class="text-muted small">
                    Chưa có hóa đơn XML nào được gắn với phiếu này.
                </div>
            </div>
        </div>
    </div>
    }
    @if (canEditLines)
    {
        <div class="card sd-card sd-product-search-card mb-3">
            <div class="card-body">
                <label class="form-label fw-semibold">Quét mã vạch / tìm sản phẩm</label>

                <select id="quickLookupInput" class="form-select"></select>

                <div class="sd-product-search-hint mt-1">
                    Quét barcode hoặc gõ tên sản phẩm. Enter chọn sản phẩm sẽ mở popup nhập số lượng.
                </div>
            </div>
        </div>
    }

    <div class="card sd-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div class="sd-section-title mb-0">Danh sách dòng nhập</div>

                    @if (canEditLines)
                    {
                        <div class="form-check form-switch d-flex align-items-center gap-2 mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="toggleAllInputInvoiceLines" />

                            <label class="form-check-label fw-semibold"
                                   for="toggleAllInputInvoiceLines"
                                   id="toggleAllInputInvoiceLinesLabel">
                                Không thuộc XML
                            </label>
                        </div>
                    }
                </div>

                <div class="sd-summary-box">
                    <div class="sd-summary-label">Tổng tiền phiếu</div>
                    <div class="sd-summary-value" id="stockDocumentTotalAmount">
                        @Model.TotalAmount.ToString("N0")
                    </div>
                </div>
            </div>

            <div id="stockDocumentLinesContainer">
                @await Html.PartialAsync("_StockDocumentLinesTable", linesTableVm)
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="submitApprovalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 sd-approval-modal">

            <div class="modal-body p-4">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="sd-approval-icon">
                            <i class="bx bx-send"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Gửi duyệt phiếu nhập</h5>
                            <div class="text-muted small">
                                Phiếu sẽ chuyển sang trạng thái chờ duyệt.
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="alert alert-warning border-0 rounded-3 small mb-3">
                    Kiểm tra lại danh sách dòng nhập trước khi gửi duyệt.
                </div>

                <label class="form-label fw-semibold">Ghi chú gửi duyệt</label>
                <textarea class="form-control"
                          id="submitApprovalNote"
                          rows="4"
                          placeholder="Nhập lý do / ghi chú gửi duyệt..."></textarea>

                <div class="form-text text-danger mt-2" id="submitApprovalMessage"></div>
            </div>

            <div class="modal-footer justify-content-between border-0 px-4 pb-4 pt-0">
                <div class="small text-muted">
                    Ctrl + Enter: gửi duyệt · Esc: đóng
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="button"
                            class="btn btn-warning px-4"
                            id="btnSubmitApproval">
                        <i class="bx bx-send me-1"></i>
                        Gửi duyệt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 sd-approve-modal">

            <div class="modal-body p-4">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="sd-approve-icon">
                            <i class="bx bx-check-shield"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Duyệt phiếu nhập kho</h5>
                            <div class="text-muted small">
                                Kiểm tra thông tin trước khi xác nhận nhập kho.
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="alert alert-success border-0 rounded-3 small mb-3">
                    Sau khi duyệt, phiếu sẽ được ghi nhận vào tồn kho và không nên chỉnh sửa thủ công.
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Mã phiếu</div>
                            <div class="sd-popup-info-value">@Model.DocumentNo</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Kho nhập</div>
                            <div class="sd-popup-info-value">@Model.WarehouseName</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Tổng tiền</div>
                            <div class="sd-popup-info-value text-primary">@Model.TotalAmount.ToString("N0")</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Số dòng</div>
                            <div class="sd-popup-info-value">@(Model.Lines?.Count ?? 0)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Loại sản phẩm</div>
                            <div class="sd-popup-info-value">
                                @(Model.Lines?.Select(x => x.ProductVariantId).Distinct().Count() ?? 0)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Gửi duyệt lúc</div>
                            <div class="sd-popup-info-value">
                                @(Model.SubmittedAtUtc.HasValue
                                    ? Model.SubmittedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    : "-")
                            </div>
                        </div>
                    </div>
                </div>

                <label class="form-label fw-semibold">Ghi chú duyệt</label>
                <textarea class="form-control"
                          id="approveNote"
                          rows="4"
                          placeholder="Nhập ghi chú duyệt nếu cần..."></textarea>

                <div class="form-text text-danger mt-2" id="approveMessage"></div>
            </div>

            <div class="modal-footer justify-content-between border-0 px-4 pb-4 pt-0">
                <div class="small text-muted">
                    Ctrl + Enter: duyệt phiếu · Esc: đóng
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="button"
                            class="btn btn-success px-4"
                            id="btnApprove">
                        <i class="bx bx-check me-1"></i>
                        Xác nhận duyệt
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối phiếu nhập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Lý do từ chối</label>
                <textarea class="form-control" id="rejectNote" rows="3"></textarea>
                <div class="form-text text-danger mt-2" id="rejectMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button" class="btn btn-danger" id="btnReject">
                    Từ chối
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="returnToEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Trả phiếu về cho nhân viên sửa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Ghi chú cho nhân viên</label>

                <textarea class="form-control"
                          id="returnToEditNote"
                          rows="4"
                          placeholder="Ví dụ: Đồng ý trả phiếu về để sửa theo yêu cầu."></textarea>

                <div class="text-danger small mt-2" id="returnToEditMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmReturnToEdit">
                    Trả về sửa
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Sửa dòng nhập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editLineId" />

                <div class="mb-3">
                    <label class="form-label">Đơn vị</label>
                    <select class="form-select" id="editLineUnitId"></select>
                    <div class="form-text" id="editLineUnitInfo"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Số lượng</label>
                    <input type="number"
                           class="form-control"
                           id="editLineQuantity"
                           min="0.001"
                           step="0.001" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Đơn giá nhập</label>
                    <input type="number"
                           class="form-control"
                           id="editLineUnitCost"
                           min="0"
                           step="100" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Ghi chú</label>
                    <textarea class="form-control" id="editLineNote" rows="3"></textarea>
                </div>

                <div class="form-text text-danger" id="editLineMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button" class="btn btn-primary" id="btnSaveEditLine">
                    Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mapInputInvoiceLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Gắn dòng nhập với dòng XML</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="mapStockDocumentLineId" />

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="mapUseInputInvoice" />
                    <label class="form-check-label" for="mapUseInputInvoice">
