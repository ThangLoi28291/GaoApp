@model GaoApp.Application.DTOs.Inventory.StockDocumentDto
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Inventory
@using GaoApp.Application.Common.Security
@using System.Globalization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Chi tiết phiếu nhập kho";
    Layout = "_ContentNavbarLayout";
    ViewData["container"] = "container-fluid sd-stock-document-shell";

    var isPurchaseOrderReceipt = Model.ReceiptSource == PurchaseReceiptSource.PurchaseOrder;
    var employeePolicy = isPurchaseOrderReceipt
        ? PermissionCodes.Purchase.Receipt.Update
        : PermissionCodes.Inventory.StockDocument.Update;
    var managerPolicy = isPurchaseOrderReceipt
        ? PermissionCodes.Purchase.Receipt.Approve
        : AppPermissions.InventoryStockDocumentApprove;

    var hasUpdatePermission = (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: employeePolicy)).Succeeded;

    var hasApprovePermission = (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: managerPolicy)).Succeeded;

    var canEditHeaderByStatus = Model.Status == StockDocumentStatus.Draft
                             || Model.Status == StockDocumentStatus.Rejected;

    var canEditLinesByStatus = Model.Status == StockDocumentStatus.Draft
                            || Model.Status == StockDocumentStatus.Rejected;

    var canSubmitApprovalByStatus = Model.Status == StockDocumentStatus.Draft
                                 || Model.Status == StockDocumentStatus.Rejected;

    var canApproveByStatus = Model.Status == StockDocumentStatus.PendingApproval;

    var canEditHeader = !isPurchaseOrderReceipt && hasUpdatePermission && canEditHeaderByStatus;
    var canEditPendingOwnership = !isPurchaseOrderReceipt &&
                                  hasApprovePermission &&
                                  Model.Status == StockDocumentStatus.PendingApproval;
    var canEditLines = !isPurchaseOrderReceipt && hasUpdatePermission && canEditLinesByStatus;
    var canSubmitApproval = hasUpdatePermission && canSubmitApprovalByStatus;
    var canApprove = hasApprovePermission && canApproveByStatus;
    var canPrintLabels = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.System.ProductLabel.Print)).Succeeded;
    var canManageInputInvoiceMapping = hasApprovePermission &&
        Model.Status == StockDocumentStatus.PendingApproval;
    var canSplitReceipt = !isPurchaseOrderReceipt &&
                          hasApprovePermission &&
                          Model.ReceiptSource == PurchaseReceiptSource.Direct &&
                          Model.Status == StockDocumentStatus.PendingApproval;
    var hasViewCostPermission = (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: PermissionCodes.Purchase.Order.ViewCost)).Succeeded;
    var canViewCost = hasApprovePermission || hasViewCostPermission;
    var canViewAudit = (await AuthorizationService
        .AuthorizeAsync(
            User,
            resource: null,
            policyName: PermissionCodes.System.AuditLog.View)).Succeeded;
    var showCommercialReview = hasApprovePermission &&
        Model.Status is StockDocumentStatus.PendingApproval or StockDocumentStatus.Confirmed;
    var receiptHeading = !string.IsNullOrWhiteSpace(Model.DocumentTitle) ? Model.DocumentTitle
        : isPurchaseOrderReceipt && !string.IsNullOrWhiteSpace(Model.PurchaseOrderTitle)
        ? $"Nhận hàng — {Model.PurchaseOrderTitle}"
        : $"Phiếu nhập kho: {Model.DocumentNo}";
    var hasReceiptSupplier = Model.SupplierId.HasValue;
    var hasSupplierTaxCode = !string.IsNullOrWhiteSpace(Model.SupplierTaxCode);
    var canOpenInputInvoicePicker = hasReceiptSupplier && hasSupplierTaxCode;
    var managerLines = Model.Lines?.OrderBy(x => x.LineNo).ToList()
        ?? new List<GaoApp.Application.DTOs.Inventory.StockDocumentLineDto>();
    var pendingOutsideCount = managerLines.Count(x =>
        x.ReceiptAllocationKind == ReceiptAllocationKind.OutsidePo &&
        x.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Pending);
    var overdeliveryCount = managerLines.Count(x => x.ProjectedOverdeliveryQuantity > 0m);
    var provisionalEnabled = Configuration.GetValue<bool>("ReceivingWorkbench:ProvisionalItemsEnabled");
    var unresolvedProvisionalCount = Model.UnresolvedProvisionalCount;
    var catalogReviewCount = managerLines.Count(x => x.RequiresCatalogReview);
    var canApproveWithoutOutsideBlocker = canApprove && pendingOutsideCount == 0 &&
        unresolvedProvisionalCount == 0 && catalogReviewCount == 0;
    ViewData["CanEditReceiptPhysical"] = canEditLines;
    ViewData["CanManageInputInvoiceMapping"] = canManageInputInvoiceMapping;
    ViewData["CanApproveOutsidePo"] = canApprove;
    ViewData["CanCompleteCatalogProduct"] = canApprove;
    var canEditSellingPrices = showCommercialReview && (await AuthorizationService
        .AuthorizeAsync(User, resource: null, policyName: PermissionCodes.Catalog.Product.Update)).Succeeded;
    ViewData["CanEditSellingPrices"] = canEditSellingPrices;

    string statusText = Model.Status switch
    {
        StockDocumentStatus.Draft => "Nháp",
        StockDocumentStatus.PendingApproval => "Chờ duyệt",
        StockDocumentStatus.Confirmed => "Đã duyệt",
        StockDocumentStatus.Rejected => "Đã trả về chỉnh sửa",
        StockDocumentStatus.Cancelled => "Đã hủy",
        _ => Model.Status.ToString()
    };

    var linesTableVm = new StockDocumentLinesTableViewModel
    {
        DocumentId = Model.Id,
        RowVersion = Model.RowVersion,
        CanEdit = canEditLines,
        CanViewCost = canViewCost,
        Lines = managerLines,
        ProvisionalItems = Model.ProvisionalItems
    };
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <link href="~/admin/css/stock-document-management.css" rel="stylesheet" />
    <link href="~/admin/css/purchase-receipt-approval.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/admin/css/receipt-selling-prices.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/admin/css/purchase-receipt-history.css" rel="stylesheet" asp-append-version="true" />
    @if (provisionalEnabled) { <link href="~/admin/css/provisional-receiving.css" rel="stylesheet" asp-append-version="true" /> }
}

<div class="container-fluid flex-grow-1 container-p-y sd-receipt-page">

    <input type="hidden" id="StockDocumentId" value="@Model.Id" />
    @{ ViewData["ReceiptDocumentActionsId"] = Model.Id; }
    @await Html.PartialAsync("_ReceiptDocumentActions")
    @if (canPrintLabels && Model.Status != StockDocumentStatus.Cancelled)
    {
        @await Html.PartialAsync("_ProductLabelReceiptLink", Model.Id)
    }
    @await Html.PartialAsync("_ReceiptIntake", Model.Id)
    <input type="hidden" id="CurrentLegalEntityId" value="@Model.LegalEntityId" />
    <input type="hidden" id="CurrentLegalEntityText" value="@Model.LegalEntityName" />
    <input type="hidden" id="CurrentWarehouseId" value="@Model.WarehouseId" />
    <input type="hidden" id="CurrentWarehouseText" value="@Model.WarehouseName" />
    <input type="hidden" id="CurrentSupplierId" value="@(Model.SupplierId?.ToString() ?? "")" />
    <input type="hidden" id="CurrentSupplierText" value="@(Model.SupplierName ?? "")" />
    <input type="hidden" id="CanEditHeader" value="@canEditHeader.ToString().ToLower()" />
    <input type="hidden" id="CanEditPendingOwnership" value="@canEditPendingOwnership.ToString().ToLower()" />
    <input type="hidden" id="CanEditLines" value="@canEditLines.ToString().ToLower()" />
    <input type="hidden" id="CanManageInputInvoiceMapping" value="@canManageInputInvoiceMapping.ToString().ToLower()" />
    <input type="hidden" id="CanApproveCommercial" value="@canApprove.ToString().ToLower()" />
    <input type="hidden" id="CanViewCost" value="@canViewCost.ToString().ToLower()" />
    <input type="hidden" id="IsConfirmedReceipt" value="@(Model.Status == StockDocumentStatus.Confirmed ? "true" : "false")" />
    @if (hasApprovePermission && Model.Status is StockDocumentStatus.PendingApproval or StockDocumentStatus.Confirmed)
    {
        <div id="receiptInvoiceFollowUp" class="card p-3 mb-3">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <strong>Theo dõi hóa đơn đầu vào</strong>
                <span id="receiptInvoiceFollowUpBadge" class="badge bg-label-secondary">Đang tải…</span>
                <button type="button" id="btnEndInvoiceWaiting" class="btn btn-sm btn-outline-secondary" hidden>Kết thúc chờ hóa đơn</button>
                <button type="button" id="btnReviewInvoice" class="btn btn-sm btn-primary" hidden>Xác nhận đã kiểm tra</button>
            </div>
            <div id="receiptInvoiceReviewDetails" class="small mt-2" hidden></div>
            @if (Model.Status == StockDocumentStatus.Confirmed)
            {
                <p class="small text-muted mb-0 mt-2">Đã ghi nhận kho và giá nhập. Khi quản lý xác nhận đã kiểm tra, các dòng nhập sẽ được ghi tăng tồn hóa đơn theo đúng đơn vị gốc và giá vốn của thẻ kho; XML chỉ hỗ trợ đối chiếu.</p>
            }
        </div>
    }
    @if (canApprove)
    {
        <form id="managerOutsidePoAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
        <form id="catalogReviewAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
    }
    @if (provisionalEnabled)
    {
        <form id="provisionalReceivingAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
    }

    <div class="card sd-card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                    <h4 class="mb-1" data-receipt-document-title>@receiptHeading</h4>
                    @if (isPurchaseOrderReceipt)
                    {
                        <div class="text-muted">
                            @(Model.PurchaseOrderNumber ?? "Chưa có số PO") · @(Model.SupplierName ?? "Chưa có nhà cung cấp")
                        </div>
                        <div class="small text-muted">
                            Phiếu nhận @Model.DocumentNo · @Model.WarehouseName · @statusText
                        </div>
                    }
                    else
                    {
                        <div class="sd-status-text">Trạng thái: @statusText</div>
                    }
                </div>

                <div class="sd-toolbar">
                    <a href="@Url.Action("Index", "StockDocumentManagement", new { area = "Admin" })"
                           class="btn btn-outline-secondary">
                        Quay lại danh sách
                    </a>

                    @if (canSubmitApproval)
                    {
                        <button type="button"
                                class="btn btn-warning"
                                id="btnOpenSubmitApprovalModal">
                            @(Model.Status == StockDocumentStatus.Rejected ? "Gửi duyệt lại" : "Gửi duyệt")
                        </button>
                    }

                    @if (canApprove)
                    {
                        @if (canSplitReceipt)
                        {
                            <a class="btn btn-outline-primary"
                               href="@Url.Action("Split", "StockDocumentManagement", new { area = "Admin", id = Model.Id })">
                                Tách phiếu nhập
                            </a>
                        }
                        <button type="button" class="btn btn-outline-danger" id="btnOpenRejectModal">
                            Trả về chỉnh sửa
                        </button>

                        <button type="button" class="btn btn-success" id="btnOpenApproveModal"
                                disabled="@(!canApproveWithoutOutsideBlocker)">
                            Duyệt và ghi sổ
                        </button>
                    }
                </div>
            </div>
            @if (Model.Status == StockDocumentStatus.PendingApproval && Model.HasRevisionRequest)
            {
                <div class="alert alert-danger border-0 rounded-4 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="fw-bold mb-1">
                                ⚠ Nhân viên yêu cầu mở lại phiếu để chỉnh sửa
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.RevisionRequestNote))
                            {
                                <div>
                                    <b>Lý do:</b> @Model.RevisionRequestNote
                                </div>
                            }

                            @if (Model.RevisionRequestedAtUtc.HasValue)
                            {
                                <div class="small mt-1">
                                    Gửi lúc:
                                    @Model.RevisionRequestedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        </div>

                        @if (canApprove)
                        {
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-danger"
                                        id="btnReturnToEdit">
                                    Trả về sửa
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        id="btnIgnoreRevisionRequest">
                                    Bỏ qua yêu cầu
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (showCommercialReview)
            {
                <div class="sd-manager-summary" aria-label="Tóm tắt phiếu nhận">
                    <div class="sd-manager-summary-item">
                        <span>Số dòng</span>
                        <strong>@managerLines.Count</strong>
                    </div>
                    @if (canViewCost)
                    {
                        <div class="sd-manager-summary-item">
                            <span>Tổng tiền</span>
                            <strong id="txtTotalAmount">@Model.TotalAmount.ToString("N0") đ</strong>
                        </div>
                    }
                    @if (overdeliveryCount > 0)
                    {
                        <div class="sd-manager-summary-item is-warning">
                            <span>Vượt PO</span>
                            <strong>@overdeliveryCount dòng</strong>
                        </div>
                    }
                    @if (pendingOutsideCount > 0)
                    {
                        <div class="sd-manager-summary-item is-warning">
                            <span>Ngoài PO</span>
                            <strong>@pendingOutsideCount chờ xử lý</strong>
                        </div>
                    }
                    @if (unresolvedProvisionalCount > 0)
                    {
                        <div class="sd-manager-summary-item is-warning">
                            <span>Chưa có danh mục</span>
                            <strong>@unresolvedProvisionalCount chờ xử lý</strong>
                        </div>
                    }
                    @if (catalogReviewCount > 0)
                    {
                        <div class="sd-manager-summary-item is-warning">
                            <span>Sản phẩm tạm</span>
                            <strong>@catalogReviewCount cần hoàn thiện</strong>
                        </div>
                    }
                </div>
            }
            else
            {
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mã phiếu</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@Model.DocumentNo"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Pháp nhân (lọc kho)</label>
                    <select id="LegalEntityId" class="form-select"></select>
                    <div class="form-text">Chủ thể phiếu luôn lấy từ kho đã chọn; trường này không ghi đè owner.</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Kho</label>
                    <select id="WarehouseId" class="form-select"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Nhà cung cấp</label>
                    <select id="SupplierId" class="form-select"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@statusText"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Ngày phiếu</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@Model.DocumentDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Gửi duyệt lúc</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@(Model.SubmittedAtUtc.HasValue ? Model.SubmittedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : string.Empty)"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Duyệt lúc</label>
                    <input type="text"
                           class="form-control sd-readonly"
                           value="@(Model.ApprovedAtUtc.HasValue ? Model.ApprovedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : string.Empty)"
                           readonly />
                </div>

                @if (canViewCost)
                {
                    <div class="col-md-3">
                        <label class="form-label">Tổng tiền</label>
                        <input type="text"
                               class="form-control sd-readonly"
                               id="txtTotalAmount"
                               value="@Model.TotalAmount.ToString("N0")"
                               readonly />
                    </div>
                }

                <div class="col-12">
                    <label class="form-label">Ghi chú phiếu</label>
                    <textarea id="DocumentNote"
                              class="form-control"
                              rows="2">@Model.Note</textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Ghi chú duyệt / từ chối</label>
                    <textarea id="ApprovalNote"
                              class="form-control"
                              rows="2">@Model.ApprovalNote</textarea>
                </div>
                <div class="col-12">
                    <div id="editHeaderMessage"
                         class="small"
                         role="alert"
                         aria-live="assertive"></div>
                </div>
            </div>
            }
        </div>
    </div>

    @if (provisionalEnabled && ((canEditLines && !isPurchaseOrderReceipt) || (canApprove && unresolvedProvisionalCount > 0)))
    {
        <section id="provisionalReceivingPanel" class="card sd-card mb-3 provisional-panel"
                 hidden
                 data-document-id="@Model.Id" data-document-row-version="@Model.RowVersion"
                 data-mode="@(canApprove && Model.Status == StockDocumentStatus.PendingApproval ? "manager" : "warehouse")"
                 data-receipt-source="@(isPurchaseOrderReceipt ? "purchase-order" : "direct")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <div class="sd-section-title mb-1">Sản phẩm chưa có trong danh mục</div>
                        <div class="small text-muted">Bằng chứng vật lý được giữ nguyên; dòng chưa xử lý không tham gia tồn kho, FIFO, giá vốn, công nợ hoặc XML.</div>
                        @if (canApprove)
                        {
                            <div class="small mt-1">Manager có thể <strong>Liên kết sản phẩm có sẵn</strong>, <strong>Tạo sản phẩm mới</strong>, hoặc <strong>Loại khỏi phiếu</strong>.</div>
                        }
                    </div>
                </div>
                <div id="provisionalReceivingMessage" class="small mt-2" role="status" aria-live="polite"></div>
                <div id="provisionalReceivingItems" class="vstack gap-2 mt-3"></div>
            </div>
        </section>
    }
    <section id="receiptPriceReviewSummary" class="card sd-card mb-3" aria-label="Đánh giá giá bán">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <h5 class="mb-0">Đánh giá giá bán</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="refreshPriceReviews">Tải lại đánh giá</button>
            </div>
            <div id="priceReviewCounts" class="d-flex gap-2 flex-wrap mt-2" aria-live="polite">Đang tải đánh giá…</div>
            <div class="small text-muted mt-2">Viền vàng: cần xem lại · Đỏ: có giá bán dưới vốn · Xanh: đã đánh giá. Nhãn “Đã cập nhật giá” ghi nhận thay đổi trên phiếu này.</div>
        </div>
    </section>
    @if (showCommercialReview)
    {
        @await Html.PartialAsync("_CommercialApprovalWorkbench", Model, ViewData)
    }

    @if ((Model.Status is StockDocumentStatus.PendingApproval or StockDocumentStatus.Confirmed) && hasApprovePermission)
    {
        <details class="card sd-card mb-3 sd-optional-xml">
            <summary class="sd-optional-xml-summary">
                <span>
                    <strong>Đối chiếu XML — tùy chọn</strong>
                    <small>Thông tin hỗ trợ, không bắt buộc để duyệt phiếu.</small>
                </span>
                <i class="bx bx-chevron-down" aria-hidden="true"></i>
            </summary>
        <div id="inputInvoicePickerSection">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="sd-section-title mb-1">Hóa đơn điện tử đầu vào</div>
                    <div class="small text-muted">
                        Nhà cung cấp: <strong id="inputInvoiceSupplierName">@(Model.SupplierName ?? "Chưa chọn")</strong>
                        <span class="mx-1">·</span>
                        MST: <strong id="inputInvoiceSupplierTaxCode">@(hasSupplierTaxCode ? Model.SupplierTaxCode : "Chưa có")</strong>
                    </div>
                    <div class="small mt-1">
                        Chủ thể phiếu: <strong>@(Model.Status == StockDocumentStatus.Confirmed
                            ? Model.ConfirmedLegalEntityName ?? "Thiếu snapshot"
                            : Model.LegalEntityName)</strong>
                        @if (Model.Status == StockDocumentStatus.Confirmed)
                        {
                            <span class="badge text-bg-secondary ms-1">Đã chốt khi xác nhận</span>
                        }
                    </div>
                        <div id="inputInvoiceSupplierMissing" class="small text-danger mt-1" hidden="@hasReceiptSupplier">
                            <div>Chưa chọn nhà cung cấp.</div>
                            <div>Vui lòng chọn nhà cung cấp trước khi chọn hóa đơn.</div>
                        </div>
                        <div id="inputInvoiceSupplierTaxMissing" class="small text-danger mt-1" hidden="@(!hasReceiptSupplier || hasSupplierTaxCode)">
                            <div>Nhà cung cấp chưa có mã số thuế.</div>
                            <div>Vui lòng cập nhật danh mục nhà cung cấp trước khi chọn hóa đơn.</div>
                        </div>
                    @if (Model.Status == StockDocumentStatus.Confirmed)
                    {
                        <div class="small text-muted mt-1">
                            Việc liên kết hóa đơn sau xác nhận không thay đổi số lượng, giá, tồn kho hoặc công nợ đã ghi nhận.
                        </div>
                    }
                    <div id="inputInvoiceAssociationState" class="small mt-2" role="status" aria-live="polite">
                        Đang kiểm tra trạng thái liên kết XML...
                    </div>
                </div>
                <button type="button" id="btnOpenInputInvoicePicker" class="btn btn-primary"
                        disabled="@(!canOpenInputInvoicePicker)">
                    <i class="bx bx-receipt me-1"></i>Chọn hóa đơn
                </button>
            </div>
            <div id="inputInvoicePickerPageMessage" class="small px-4 pb-3" role="status" aria-live="polite"></div>
            <div id="inputInvoiceListContainer" class="px-4 pb-4">
                <div class="text-muted small">Chưa có hóa đơn nào được gắn với phiếu này.</div>
            </div>
            <section id="inputInvoiceReconciliationPanel" class="mx-4 mb-4 border rounded-3 p-3 d-none"
                     aria-labelledby="inputInvoiceReconciliationTitle"
                     aria-describedby="inputInvoiceReconciliationTolerance inputInvoiceReconciliationMessage">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h6 id="inputInvoiceReconciliationTitle" class="mb-1" tabindex="0">Đối chiếu XML — tùy chọn</h6>
                        <div id="inputInvoiceReconciliationTolerance" class="small text-muted">
                            Sai số cho phép: 0,0001 đơn vị gốc · tiền/VAT/header: 1 ₫.
                        </div>
                    </div>
                    <span id="inputInvoiceReconciliationState" class="badge bg-label-secondary">Đang tải</span>
                </div>
                <div id="inputInvoiceReconciliationMessage" class="small mt-2" role="status" aria-live="polite"></div>
                <div id="inputInvoiceReconciliationHeader" class="mt-3"></div>
