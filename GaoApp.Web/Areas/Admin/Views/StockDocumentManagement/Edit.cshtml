@if (canViewAudit)
{
    <div class="container-xxl flex-grow-1">
        <div class="card sd-card mb-3" id="purchaseReceiptAuditCard">
            <div class="card-header d-flex align-items-center justify-content-between rh-heading">
                <div>
                    <h5 class="mb-0">Lịch sử phiếu nhập</h5>
                    <p class="rh-subtitle">Theo dõi ai đã thao tác và những nội dung thay đổi trên phiếu.</p>
                </div>
                <div class="rh-header-actions">
                    <span class="text-muted small"><i class="bx bx-lock-alt" aria-hidden="true"></i> Chỉ đọc</span>
                    <button type="button" id="receiptHistoryRefresh" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-refresh me-1" aria-hidden="true"></i>Tải lại
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="rh-controls">
                    <div class="rh-search-control">
                        <label for="receiptHistorySearch">Tìm trong lịch sử</label>
                        <input type="search" id="receiptHistorySearch" class="form-control" placeholder="Tên nhân viên, tên hàng, nội dung…" autocomplete="off" />
                    </div>
                    <div>
                        <label for="receiptHistoryFilter">Loại thao tác</label>
                        <select id="receiptHistoryFilter" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="receipt">Thông tin phiếu</option>
                            <option value="goods">Hàng nhập</option>
                            <option value="approval">Duyệt phiếu</option>
                            <option value="invoice">Hóa đơn</option>
                        </select>
                    </div>
                    <div>
                        <label for="receiptHistorySort">Thứ tự</label>
                        <select id="receiptHistorySort" class="form-select">
                            <option value="newest">Mới nhất</option>
                            <option value="oldest">Cũ nhất</option>
                        </select>
                    </div>
                </div>
                <div class="rh-overview">
                    <span id="purchaseReceiptAuditStatus" role="status" aria-live="polite">Đang tải lịch sử...</span>
                    <span id="receiptHistoryStats"></span>
                </div>
                <div id="purchaseReceiptAuditTimeline"></div>
                <div class="rh-footer">
                    <button type="button" id="receiptHistoryMore" class="btn btn-sm btn-outline-primary" hidden>Xem thêm thao tác</button>
                </div>
            </div>
        </div>
    </div>
}
<!-- Popup xác nhận xóa đẹp -->
<div class="modal fade" id="deleteLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-body text-center p-4">
                <input type="hidden" id="deleteLineId" />

                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                     style="width:58px;height:58px;background:#fff1f0;color:#ff3e1d;">
                    <i class="bx bx-trash fs-2"></i>
                </div>

                <h5 class="fw-bold mb-2">Xóa dòng nhập?</h5>

                <div class="text-muted small mb-3">
                    Dòng sản phẩm này sẽ bị xóa khỏi phiếu nhập. Thao tác này không tự hoàn tác.
                </div>

                <div class="border rounded-3 p-2 bg-light mb-3 text-start">
                    <div class="small text-muted">Sản phẩm</div>
                    <div class="fw-bold" id="deleteLineProductName">-</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary flex-fill"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="button"
                            class="btn btn-danger flex-fill"
                            id="btnConfirmDeleteLine">
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
}

@section PageScripts {
    <script src="~/Admin/js/receipt-document-actions.js" asp-append-version="true"></script>
    <script src="~/Admin/js/receipt-barcode-proposals.js" asp-append-version="true"></script>
    <script src="~/Admin/js/receipt-intake.js" asp-append-version="true"></script>
    <script src="~/Admin/js/receipt-quantity-controls.js" asp-append-version="true"></script>
    @if (canViewAudit)
    {
        <script src="~/Admin/js/purchase-receipt-history.js" asp-append-version="true"></script>
    }
    @if (canPrintLabels)
    {
        <link rel="stylesheet" href="~/Admin/css/label-printing.css" asp-append-version="true" />
        <script src="~/Admin/js/printing/label-print-controls.js" asp-append-version="true"></script>
        <script src="~/Admin/js/printing/label-receipt-links.js" asp-append-version="true"></script>
    }
    <script>
        window.stockDocumentPage = {
        mode: 'edit',
        documentId: @Model.Id,
        rowVersion: @Json.Serialize(Model.RowVersion),
        editableHeader: @canEditHeader.ToString().ToLower(),
        editableLines: @canEditLines.ToString().ToLower(),
        canSubmitApproval: @canSubmitApproval.ToString().ToLower(),
        canApproveCommercial: @canApprove.ToString().ToLower(),
        canViewCost: @canViewCost.ToString().ToLower(),
        canViewAudit: @canViewAudit.ToString().ToLower(),
        receiptSource: @((int)Model.ReceiptSource)
        };
    </script>

    <script src="~/admin/js/receipt-invoice-follow-up.js" asp-append-version="true"></script>
    <script src="~/admin/js/stock-document-management.js" asp-append-version="true"></script>
    <script src="~/admin/js/input-invoice-picker.js" asp-append-version="true"></script>
    <script src="~/admin/js/receipt-price-drafts.js" asp-append-version="true"></script>
    <script src="~/admin/js/receipt-quick-price.js" asp-append-version="true"></script>
    <script src="~/admin/js/purchase-receipt-approval.js" asp-append-version="true"></script>
    <script src="~/admin/js/receipt-price-reviews.js" asp-append-version="true"></script>
    @if (canEditSellingPrices)
    {
        <partial name="_ReceiptSellingPrices" />
        <script src="~/admin/js/receipt-selling-prices.js" asp-append-version="true"></script>
    }
    @if (provisionalEnabled) { <script src="~/admin/js/provisional-receiving.js" asp-append-version="true"></script> }
}
