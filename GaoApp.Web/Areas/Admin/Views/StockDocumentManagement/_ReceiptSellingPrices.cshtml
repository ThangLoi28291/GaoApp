@inject Microsoft.AspNetCore.Authorization.IAuthorizationService LabelAuthorization
<div class="modal fade" id="receiptSellingPrices" tabindex="-1" aria-labelledby="rspTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header">
            <div class="rsp-heading">
                <span class="rsp-heading-icon" aria-hidden="true"><i class="bx bx-purchase-tag-alt"></i></span>
                <div><h5 class="modal-title" id="rspTitle">Giá bán &amp; lãi gộp</h5><div id="rspProduct"></div></div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            <div id="rspMessage" class="alert alert-info" role="status" aria-live="polite">Đang tải giá bán…</div>
            <div id="rspContent" hidden>
                <div class="rsp-cost-summary">
                    <div>
                        <span class="rsp-eyebrow">Giá vốn dự kiến</span>
                        <div class="rsp-cost-caption">Theo giá nhập, thuế và cước được tính vào vốn</div>
                    </div>
                    <div class="rsp-cost-value"><strong id="rspCostDisplay">—</strong><span> / <span id="rspBaseUnit"></span></span></div>
                </div>
                <div class="rsp-section-heading">
                    <h6>Đối chiếu giá bán</h6>
                    <span>Nhập giá muốn đổi; giá đang bán được giữ nguyên khi mở.</span>
                </div>
                <div id="rspUnits" class="rsp-units"></div>
                <p class="rsp-profit-note">Lãi gộp = giá bán − giá vốn dự kiến, chưa trừ chi phí vận hành. Tỷ lệ lãi hiển thị theo giá bán.</p>
                <div id="rspWarning" class="alert alert-warning rsp-warning" role="status" aria-live="polite" hidden></div>

                <details class="rsp-details" id="rspCalculator">
                    <summary><span><i class="bx bx-calculator" aria-hidden="true"></i>Tính giá đề xuất</span><small>Tùy chọn</small></summary>
                    <div class="rsp-details-body">
                        <p class="rsp-help">Chọn mức lãi và cách làm tròn. Giá chỉ được điền khi bạn bấm dùng đề xuất.</p>
                        <div class="rsp-controls">
                            <label class="form-label" for="rspTarget">Mức lãi bán lẻ (%)
                                <input id="rspTarget" class="form-control" type="number" min="0" max="95" step="0.1" value="10" />
                            </label>
                            <label class="form-label" for="rspWholesaleTarget">Mức lãi bán sỉ (%)
                                <input id="rspWholesaleTarget" class="form-control" type="number" min="0" max="95" step="0.1" value="10" />
                            </label>
                            <label class="form-label" for="rspBasis">Cách tính mức lãi
                                <select id="rspBasis" class="form-select"><option value="margin">Lãi trên giá bán</option><option value="markup">Cộng trên giá vốn</option></select>
                            </label>
                            <label class="form-label" for="rspRound">Làm tròn giá lên
                                <select id="rspRound" class="form-select"><option value="1">1 đ</option><option value="100" selected>100 đ</option><option value="500">500 đ</option><option value="1000">1.000 đ</option></select>
                            </label>
                        </div>
                        <div class="rsp-calculator-footer">
                            <span class="rsp-help" id="rspBasisHelp">Ví dụ: lãi trên giá bán 10% nghĩa là lãi chiếm 10% giá bán.</span>
                            <button class="btn btn-outline-primary" id="rspUseSuggestions" type="button"><i class="bx bx-check-double" aria-hidden="true"></i>Điền đề xuất cho tất cả đơn vị</button>
                        </div>
                    </div>
                </details>

                <details class="rsp-details" id="rspAdvanced">
                    <summary><span><i class="bx bx-slider-alt" aria-hidden="true"></i>Tùy chọn nâng cao</span></summary>
                    <div class="rsp-details-body">
                        <label class="form-label rsp-cost-editor" for="rspCost">Giá vốn dùng để tính đề xuất (đ / đơn vị gốc)
                            <input id="rspCost" class="form-control" type="number" min="0.0001" max="999999999999" step="any" />
                            <span class="form-text" id="rspCostNote"></span>
                        </label>
                        <p class="rsp-help">Chỉ thay đổi con số ước tính trong popup; không ghi lại giá nhập hay giá vốn tồn kho.</p>
                        <div class="rsp-default-price-option">
                            <label class="rsp-checkbox-label" for="rspUpdateProductPrice"><input id="rspUpdateProductPrice" class="form-check-input" type="checkbox" /><span>Cập nhật giá lẻ mặc định</span></label>
                            <p class="rsp-help">Biến thể chưa có giá riêng sẽ dùng giá lẻ mặc định của sản phẩm.</p>
                            <label class="form-label" for="rspProductSource">Lấy giá từ đơn vị
                                <select id="rspProductSource" class="form-select"></select>
                                <span class="form-text">Giá được quy về đơn vị gốc của sản phẩm.</span>
                            </label>
                            <div class="alert alert-primary rsp-default-preview" id="rspProductPrice" aria-live="polite" hidden></div>
                        </div>
                    </div>
                </details>

                <details class="rsp-details rsp-history">
                    <summary><span><i class="bx bx-history" aria-hidden="true"></i>Lịch sử đổi giá</span><small>30 lần gần nhất</small></summary>
                    <div id="rspHistory" class="rsp-details-body"></div>
                </details>

                <section id="rspConfirmation" class="rsp-confirmation" aria-labelledby="rspConfirmationTitle" hidden>
                    <div class="rsp-confirmation-heading"><span class="rsp-step" aria-hidden="true">✓</span><div><h6 id="rspConfirmationTitle">Xem lại thay đổi</h6><p>Kiểm tra các giá bên dưới trước khi áp dụng.</p></div></div>
                    <div id="rspConfirmationLines" class="rsp-confirmation-lines"></div>
                    <div id="rspConfirmationWarning" class="rsp-confirmation-warning" role="status" hidden></div>
                    <p class="rsp-confirmation-note"><strong>Giá mới có hiệu lực ngay</strong> cho các lần bán tiếp theo. Giỏ hàng đang mở không tự đổi giá; thao tác này không duyệt phiếu nhập.</p>
                    <button id="rspBackToEdit" class="btn btn-link" type="button"><i class="bx bx-arrow-back" aria-hidden="true"></i>Quay lại chỉnh giá</button>
                </section>
            </div>
        </div>
        <div class="modal-footer rsp-footer">
            <div id="rspDiscardChanges" class="rsp-discard" role="alert" hidden>
                <span>Giá đang chỉnh chưa được áp dụng.</span>
                <div><button id="rspKeepEditing" type="button" class="btn btn-outline-secondary">Quay lại chỉnh</button><button id="rspDiscardAndClose" type="button" class="btn btn-outline-danger">Đóng, bỏ thay đổi</button></div>
            </div>
            <div class="rsp-footer-status" aria-live="polite"><strong id="rspCount">Chưa thay đổi giá</strong><span id="rspEffectNote">Giá mới có hiệu lực ngay sau khi áp dụng.</span><span id="rspEditingHint" class="rsp-editing-hint"></span></div>
            <div class="rsp-footer-actions">
                @if ((await LabelAuthorization.AuthorizeAsync(User, null, GaoApp.Application.Common.Security.PermissionCodes.System.ProductLabel.Print)).Succeeded)
                {
                    <a id="rspPrintLabels" class="btn btn-outline-primary" target="_blank" rel="noopener" hidden><i class="bx bx-barcode" aria-hidden="true"></i>In tem giá mới</a>
                }
                <button type="button" class="btn btn-outline-secondary" id="rspReview" disabled>Đã kiểm tra, giữ giá</button>
                <button type="button" class="btn btn-primary" id="rspSave" disabled>Xem lại thay đổi<i class="bx bx-right-arrow-alt" aria-hidden="true"></i></button>
            </div>
        </div>
    </div></div>
</div>
