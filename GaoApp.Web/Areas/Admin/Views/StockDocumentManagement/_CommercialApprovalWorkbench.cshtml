@model GaoApp.Application.DTOs.Inventory.StockDocumentDto
@using System.Globalization
@using GaoApp.Application.Common.Exceptions
@using GaoApp.Application.DTOs.Inventory
@using GaoApp.Domain.Enums
@inject GaoApp.Application.Interfaces.Services.Inventory.IReceiptSellingPriceService ReceiptPrices
@inject GaoApp.Application.Interfaces.Services.Inventory.IPurchaseReceiptPricingAllocationService PricingAllocation
@inject GaoApp.Application.Common.ITenantContext PricingTenant
@inject GaoApp.Application.Common.Interfaces.ICurrentUser PricingUser
@{
    var retailPrices = (await ReceiptPrices.GetRetailComparisonAsync(Model.Id, Context.RequestAborted)).ToDictionary(x => x.LineId);
    var taxes = ViewData["ReceiptTaxOptions"] as IEnumerable<StockReceiptTaxOptionDto>
        ?? Enumerable.Empty<StockReceiptTaxOptionDto>();
    var readOnly = Model.Status == StockDocumentStatus.Confirmed;
    var allocationApplied = await PricingAllocation.HasAppliedPlanAsync(Model.Id, Context.RequestAborted);
    var quickPriceLines = new Dictionary<int, PurchaseReceiptPricingPhysicalLine>();
    string? quickPriceUnavailable = null;
    if (!readOnly)
    {
        try
        {
            var quickPriceWorkspace = await PricingAllocation.GetAsync(Model.Id, Context.RequestAborted);
            quickPriceLines = quickPriceWorkspace.PhysicalLines.ToDictionary(x => x.StockDocumentLineId);
        }
        catch (BusinessRuleException error)
        {
            // Invalid catalog conversions must not stop the existing receipt review.
            quickPriceUnavailable = error.SafeMessage;
        }
    }
    var canApproveOutsidePo = ViewData["CanApproveOutsidePo"] as bool? == true;
    var canCompleteCatalogProduct =
        ViewData["CanCompleteCatalogProduct"] as bool? == true;
    var revisionReview = Model.Status == StockDocumentStatus.PendingApproval
        ? Model.RevisionReview : null;
    var revisionLineCount = (revisionReview?.AddedLineCount ?? 0) +
        (revisionReview?.ChangedLineCount ?? 0);
    var lines = Model.Lines
        .OrderByDescending(x => revisionReview is not null &&
            x.RevisionChangeKind is "added" or "changed")
        .ThenBy(x => x.LineNo).ThenBy(x => x.Id).ToList();
    var isPurchaseOrderReceipt = Model.PurchaseOrderId.HasValue ||
        Model.ReceiptSource == PurchaseReceiptSource.PurchaseOrder;
    var outsideLines = lines
        .Where(x => isPurchaseOrderReceipt && x.ReceiptAllocationKind == ReceiptAllocationKind.OutsidePo)
        .ToList();
    var pendingOutsideLines = outsideLines
        .Where(x => x.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Pending)
        .ToList();
    var overdeliveryLines = lines
        .Where(x => isPurchaseOrderReceipt && x.ProjectedOverdeliveryQuantity > 0m)
        .ToList();
    var unresolvedProvisionalCount = Model.UnresolvedProvisionalCount;
    var catalogReviewLines = lines.Where(x => x.RequiresCatalogReview).ToList();
    var missingPriceCount = lines.Count(x => !x.EditableUnitPriceBeforeVat.HasValue);
    var exceptionCount = pendingOutsideLines.Count + overdeliveryLines.Count +
        unresolvedProvisionalCount + catalogReviewLines.Count;
}

<section class="card sd-card sd-commercial-workbench sd-review-workspace mb-3"
         id="commercialApprovalWorkbench"
         data-source="@(isPurchaseOrderReceipt ? "purchase-order" : "direct")"
         data-readonly="@readOnly.ToString().ToLowerInvariant()"
         data-has-revision-request="@Model.HasRevisionRequest.ToString().ToLowerInvariant()"
         data-merchandise-paid="@(readOnly && Model.IsMerchandisePaid ? "true" : "false")"
         data-freight-paid="@(readOnly && Model.IsFreightPaid ? "true" : "false")"
         data-allocation-applied="@allocationApplied.ToString().ToLowerInvariant()"
         data-has-pending-outside="@(pendingOutsideLines.Count > 0 ? "true" : "false")"
         data-has-unresolved-provisional="@(unresolvedProvisionalCount > 0 ? "true" : "false")"
         data-has-catalog-review="@(catalogReviewLines.Count > 0 ? "true" : "false")"
         data-unresolved-count="@unresolvedProvisionalCount"
         data-catalog-count="@catalogReviewLines.Count"
         data-outside-count="@pendingOutsideLines.Count">
    <div class="card-header sd-review-workspace-heading">
        <div class="sd-review-workspace-title">
            <div class="d-flex align-items-center gap-2">
                <span class="sd-commercial-icon"><i class="bx bx-check-shield" aria-hidden="true"></i></span>
                <div>
                    <h5 class="mb-0">@(readOnly ? "Chi tiết hàng đã nhập kho" : "Đối chiếu và duyệt phiếu")</h5>
                    <span class="small text-muted">@lines.Count dòng thực nhận · @(isPurchaseOrderReceipt ? "Theo đơn đặt hàng" : "Nhập trực tiếp")</span>
                </div>
            </div>
            @if (readOnly)
            {
                <span class="badge bg-label-success"><i class="bx bx-lock-alt me-1" aria-hidden="true"></i>Đã ghi sổ</span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (!readOnly)
        {
            <section class="sd-review-readiness" id="receiptApprovalReadiness" aria-live="polite" aria-atomic="false" aria-labelledby="receiptApprovalReadinessTitle">
                <details id="receiptApprovalIssuesDisclosure">
                    <summary>
                        <span class="sd-review-readiness-title" id="receiptApprovalReadinessTitle">Đang kiểm tra điều kiện duyệt…</span>
                        <span class="sd-review-readiness-counts">
                            <span class="sd-review-issue-count is-blocking"><b id="receiptApprovalBlockingCount">0</b> bắt buộc</span>
                            <span class="sd-review-issue-count is-acknowledgement"><b id="receiptApprovalAcknowledgementCount">0</b> cần xác nhận</span>
                            <span class="sd-review-issue-count is-warning"><b id="receiptApprovalWarningCount">0</b> tham khảo</span>
                        </span>
                        <i class="bx bx-chevron-down" aria-hidden="true"></i>
                    </summary>
                    <ul id="receiptApprovalIssues" class="sd-review-issues" aria-label="Các điều kiện và cảnh báo của phiếu"></ul>
                    <p class="sd-review-rule-note">Bắt buộc: hoàn tất trước khi duyệt. Cần xác nhận: quản lý kiểm tra và chấp nhận. Tham khảo: hỗ trợ quyết định, không chặn duyệt.</p>
                </details>
            </section>
            <div class="sd-review-price-draft" id="receiptPriceDraftBar">
                <div><strong class="small d-block" id="receiptPriceDraftStatus" role="status" aria-live="polite">Giá nhập được tự động lưu nháp</strong>
                    <span class="small text-muted">Giá nhập lưu nháp; VAT, thanh toán và vận chuyển được áp dụng khi duyệt.</span></div>
                <button type="button" class="btn btn-sm btn-outline-primary" id="receiptPriceDraftSave">Lưu nháp ngay</button>
            </div>
        }

        <nav class="sd-workbench-tabs" aria-label="Các bước duyệt phiếu" role="tablist">
            <button type="button" class="active" role="tab" aria-selected="true"
                    data-workbench-tab="goods">
                <i class="bx bx-package"></i>
                <span>Hàng hóa</span>
                <b>@lines.Count</b>
            </button>
            <button type="button" role="tab" aria-selected="false"
                    data-workbench-tab="pricing">
                <i class="bx bx-gift"></i><span>Giá &amp; khuyến mãi <small>(tùy chọn)</small></span>
            </button>
            <button type="button" role="tab" aria-selected="false"
                    data-workbench-tab="settlement">
                <i class="bx bx-wallet"></i>
                <span>Thanh toán &amp; thuế</span>
            </button>
            <button type="button" role="tab" aria-selected="false"
                    data-workbench-tab="freight">
                <i class="bx bx-car" aria-hidden="true"></i>
                <span>Vận chuyển</span>
                <b id="commercialFreightTabTotal" hidden="@(!Model.HasFreight)">@Model.FreightTotal.ToString("N0") đ</b>
            </button>
        </nav>

        <div class="sd-review-layout">
        <div class="sd-review-main">
        <div class="sd-workbench-tab-panel" data-workbench-panel="pricing" hidden>
            <section id="receiptPricingAllocation" aria-label="Giá và khuyến mãi của bill"
                     data-draft-store-id="@PricingTenant.StoreId" data-draft-user-id="@PricingUser.UserId">
                <div class="sd-pricing-toolbar"><h5 class="mb-0">Giá &amp; khuyến mãi</h5><span class="text-muted">Trước VAT</span></div>
                <p class="small text-muted mt-2 mb-0">Công cụ tính giá tùy chọn. Không dùng phần này vẫn có thể nhập giá thủ công và duyệt phiếu tại tab Hàng hóa. Khi không có chương trình, giá được tính theo bill và quy đổi đơn vị như thông thường.</p>
                <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
                    <span id="pricingLocalDraftStatus" class="small text-muted" role="status" aria-live="polite">Bill và chương trình tự nhớ trên trình duyệt này khi đang nhập.</span>
                    <button type="button" id="pricingRestoreLocalDraft" class="btn btn-sm btn-outline-primary" hidden>Khôi phục bản nháp trên máy</button>
                </div>
                <nav class="sd-pricing-steps" aria-label="Các bước nhập giá">
                    <button type="button" class="btn" data-pricing-step="bill" aria-pressed="true">1. Nhập bill</button>
                    <button type="button" class="btn" data-pricing-step="program" aria-pressed="false">2. Chương trình</button>
                    <button type="button" class="btn" data-pricing-step="price" aria-pressed="false">3. Giá nhập cuối</button>
                </nav>
                <div id="pricingQuantityOverview" class="sd-pricing-quantity-overview" role="status" aria-live="polite"></div>
                <div data-pricing-page="bill">
                    <p class="small text-muted mt-3">Nhập số lượng theo bill bằng tay hoặc thêm từ XML để đối chiếu với hàng nhân viên thực nhận. Cả hai cách dùng chung danh sách bill bên dưới; mỗi dòng chỉ cần nhập một lần.</p>
                    <div class="sd-pricing-xml-toolbar">
                        <div><strong>Nhập nhanh từ hóa đơn XML</strong><p class="small text-muted mb-0">Chọn sản phẩm nhân viên đã nhập và đơn vị tương ứng. Nhớ ghép cho lần sau hoặc thêm dòng để đối chiếu phiếu hiện tại.</p></div>
                        <button type="button" id="pricingXmlImport" class="btn btn-outline-primary">Thêm từ XML</button>
                    </div>
                    <div id="pricingXmlSourceWarning" class="alert alert-warning" role="alert" hidden></div>
                    <section id="pricingXmlPanel" class="sd-pricing-xml-panel" aria-label="Nhập dòng bill từ XML đã liên kết" hidden>
                        <div class="sd-pricing-section-heading"><div><h6 class="mb-1">Các dòng XML đã liên kết</h6><span id="pricingXmlSummary" class="small text-muted" role="status" aria-live="polite"></span></div><button type="button" id="pricingXmlClose" class="btn btn-sm btn-link">Đóng</button></div>
                        <p class="small text-muted"><strong>Nhớ:</strong> chỉ lưu ghép sản phẩm và đơn vị cho lần sau, không thêm số lượng. <strong>Thêm dòng:</strong> chép số lượng và giá đã gồm VAT từng dòng XML vào bill; nếu phiếu đang bật Có VAT để tính thuế riêng thì chép giá trước VAT để tránh cộng thuế hai lần. Không tự lưu ghép. Sau khi thêm, bạn có thể sửa dòng bill bên dưới. Dòng quà cần được gắn chương trình ở bước 2.</p>
                        <div id="pricingXmlMessage" role="status" aria-live="polite" class="small mb-2"></div>
                        <div id="pricingXmlRows"></div>
                        <div class="sd-pricing-xml-footer"><span class="small text-muted">Các dòng đã thêm sẽ được bỏ qua; bill nhập tay và chương trình đang có được giữ.</span><button type="button" id="pricingXmlAddAll" class="btn btn-primary">Thêm các dòng đã nhận diện</button></div>
                    </section>
                    <div class="sd-bill-entry">
                        <h6 class="mb-3">Nhập theo bill bằng tay</h6>
                        <div class="sd-bill-search"><label for="pricingBillSearch" class="form-label">Sản phẩm trên phiếu nhập</label><input id="pricingBillSearch" class="form-control" placeholder="Gõ tên sản phẩm theo bill…" autocomplete="off" aria-expanded="false" aria-controls="pricingBillSuggestions" /><div id="pricingBillSuggestions" class="sd-bill-suggestions" hidden></div></div>
                        <div id="pricingSelectedProduct" class="sd-bill-selected-product" hidden></div>
                        <div class="sd-bill-entry-fields">
                            <label>Loại dòng<select id="pricingBillKind" class="form-select"><option value="buy">Hàng mua</option><option value="gift">Hàng tặng</option></select></label>
                            <label>Đơn vị bill<select id="pricingBillUnit" class="form-select" disabled></select></label>
                            <label>Số lượng<input id="pricingBillQuantity" class="form-control" type="number" min="0.000000001" step="any" value="1" /></label>
                        </div>
                        <div class="sd-bill-price-fields">
                            <label>Nhập giá theo<select id="pricingBillPriceMode" class="form-select"><option value="unit">Đơn giá</option><option value="amount">Thành tiền</option></select></label>
                            <label><span>Đơn giá bill (<span data-pricing-price-basis>theo chế độ VAT của phiếu</span>)</span><input id="pricingBillPrice" class="form-control" type="number" min="0" step="any" inputmode="decimal" /></label>
                            <label>Thành tiền dòng bill<input id="pricingBillAmount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" readonly /></label>
                        </div>
                        <div id="pricingBillPriceHint" class="small text-muted mt-2" role="status" aria-live="polite"></div>
                        <div class="sd-bill-entry-footer"><span id="pricingBillConversion" class="text-muted"></span><div class="d-flex gap-2"><button type="button" id="pricingBillAdd" class="btn btn-primary">Thêm dòng bill</button><button type="button" id="pricingBillCancelEdit" class="btn btn-outline-secondary" hidden>Hủy dòng đang nhập</button></div></div>
                    </div>
                    <div class="sd-pricing-section-heading"><h6 class="mb-0">Danh sách theo bill</h6><span id="pricingBillCount" class="text-muted"></span></div>
                    <div id="pricingAllocationLines" aria-label="Các dòng trên bill"></div>
                    <div class="sd-bill-total"><span>Tiền hàng trên các dòng bill</span><strong id="pricingBillTotal">—</strong></div>
                    <details class="sd-pricing-quantity-check" open><summary>Đối chiếu số lượng theo sản phẩm <span id="pricingQuantitySummary" class="text-muted"></span></summary><div id="pricingQuantityComparison"></div></details>
                    <div class="sd-pricing-next"><button type="button" class="btn btn-primary" data-pricing-step="program">Tiếp: chương trình</button></div>
                </div>
                <div data-pricing-page="program" hidden>
                    <div class="sd-pricing-section-heading"><h6 class="mb-0">Chương trình trên bill</h6><button type="button" id="pricingNewProgram" class="btn btn-primary">Thêm chương trình</button></div>
                    <div id="pricingRuleList" class="sd-pricing-rule-list" aria-label="Chương trình của bill"></div>
                    <div id="pricingRuleEditor" class="sd-pricing-program-editor" hidden>
                        <div class="sd-pricing-section-heading"><h6 id="pricingRuleEditorTitle" class="mb-0">Chương trình mới</h6><button type="button" id="pricingCloseRule" class="btn btn-link">Hủy</button></div>
                        <div class="sd-pricing-program-fields"><label>Loại chương trình<select id="pricingRuleType" class="form-select"><option value="1">Tặng hàng</option><option value="2">Giảm %</option><option value="3">Giảm số tiền</option></select></label></div>
                        <div class="sd-bill-search sd-program-search">
                            <label for="pricingRuleSearch" class="form-label">Chọn dòng trên bill</label>
                            <input id="pricingRuleSearch" class="form-control" placeholder="Gõ tên sản phẩm hoặc số dòng trên bill…" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="pricingRuleSuggestions" aria-haspopup="listbox" />
                            <div id="pricingRuleSuggestions" class="sd-bill-suggestions" role="listbox" aria-label="Các dòng bill để chọn vào chương trình" hidden></div>
                        </div>
                        <p id="pricingRuleSearchHint" class="small text-muted mt-2"></p>
                        <h6 class="mt-3">Dòng mua tham gia</h6><div id="pricingRuleSources"></div>
                        <div id="pricingDiscountFields" hidden><label for="pricingRuleDiscount" class="form-label mt-3">Mức giảm (%)</label><input id="pricingRuleDiscount" class="form-control" type="number" min="0.0001" max="99.9999" step="0.0001" value="10" /></div>
                        <div id="pricingDiscountAmountFields" hidden><label for="pricingRuleDiscountAmount" class="form-label mt-3">Số tiền giảm theo giá bill cho các dòng tham gia</label><input id="pricingRuleDiscountAmount" class="form-control" type="number" min="0.01" step="0.01" /><p class="small text-muted mt-2">Phân bổ theo tiền hàng của số lượng tham gia. Tiền giảm phải nhỏ hơn tổng tiền hàng tham gia.</p></div>
                        <div id="pricingGiftFields">
                            <div class="sd-pricing-section-heading"><h6 class="mb-0">Quà tặng đã chọn</h6></div><div id="pricingGiftTargets"></div>
                            <details id="pricingExtraGiftChooser" class="sd-program-extra-gift">
                                <summary>Quà chỉ ghi trong nội dung chương trình, không có dòng riêng trên bill</summary>
                                <div class="sd-bill-search sd-program-search">
                                    <label for="pricingExtraGiftSearch" class="form-label">Tìm quà trong sản phẩm thực nhận</label>
                                    <input id="pricingExtraGiftSearch" class="form-control" placeholder="Gõ tên sản phẩm quà…" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="pricingExtraGiftSuggestions" aria-haspopup="listbox" />
                                    <div id="pricingExtraGiftSuggestions" class="sd-bill-suggestions" role="listbox" aria-label="Quà ghi trong nội dung chương trình" hidden></div>
                                </div>
                            </details>
                        </div>
                        <details class="sd-program-optional-name"><summary>Thêm tên / ghi chú chương trình (không bắt buộc)</summary><label for="pricingRuleName" class="form-label mt-2">Tên / nội dung trên bill</label><input id="pricingRuleName" class="form-control" maxlength="200" placeholder="Có thể để trống" /></details>
                        <div id="pricingRuleError" class="text-danger mt-3" role="alert"></div>
                        <div class="sd-pricing-next"><button type="button" id="pricingSaveRule" class="btn btn-primary">Gắn chương trình</button></div>
                    </div>
                    <details class="sd-pricing-quantity-check" open><summary>Đối chiếu số lượng sau chương trình</summary><div id="pricingProgramQuantityComparison"></div></details>
                    <div class="sd-pricing-next"><button type="button" class="btn btn-primary" data-pricing-step="price">Xem giá nhập cuối</button></div>
                </div>
                <div data-pricing-page="price" hidden>
                    <div class="sd-pricing-section-heading"><h6 id="pricingFinalTitle" class="mb-0">Giá nhập tính theo bill</h6><span class="text-muted">Trước VAT / đơn vị thực nhận</span></div>
                    <div id="pricingFinalPrices"></div>
                    <div class="sd-pricing-reconciliation">
                        <label>Tiền hàng thực trả trên bill (<span data-pricing-price-basis>theo chế độ VAT của phiếu</span>)<input id="pricingActualBillTotal" class="form-control" type="number" min="0.01" step="0.01" /></label>
                        <div class="sd-global-discount">
                            <label for="pricingGlobalDiscountMode">Giảm toàn bill</label>
                            <select id="pricingGlobalDiscountMode" class="form-select" aria-label="Cách giảm toàn bill"><option value="amount">Giảm tiền (đ)</option><option value="percent">Giảm %</option></select>
                            <label id="pricingGlobalAmountField" for="pricingGlobalDiscountAmount">Tiền giảm (đ)<input id="pricingGlobalDiscountAmount" class="form-control" type="number" min="0" step="0.01" value="0" inputmode="decimal" /></label>
                            <label id="pricingGlobalPercentField" for="pricingGlobalDiscount" hidden>Giảm (%)<input id="pricingGlobalDiscount" class="form-control" type="number" min="0" max="99.9999" step="0.0001" /></label>
                        </div>
                        <div><span>Tổng hệ thống</span><strong id="pricingSystemTotal">—</strong></div><div><span>Hệ thống − bill</span><strong id="pricingDifference">—</strong></div>
                    </div>
                </div>
                <div id="pricingAllocationMessage" role="status" aria-live="polite" class="my-3"></div>
                <div id="pricingManualHelp" class="small text-muted mb-3" hidden>Chưa thể áp dụng kết quả tính từ bill. Bạn vẫn có thể nhập giá thủ công tại Hàng hóa và duyệt phiếu theo các giá đã lưu.</div>
                <div class="sd-pricing-actions"><button type="button" id="pricingReload" class="btn btn-outline-secondary">Tải lại kế hoạch</button><div id="pricingFinalActions" class="d-flex gap-2 flex-wrap" hidden><button type="button" id="pricingPreview" class="btn btn-outline-primary">Tính lại / đối chiếu</button><button type="button" id="pricingSave" class="btn btn-outline-primary">Lưu kế hoạch</button><button type="button" id="pricingApply" class="btn btn-primary" disabled>Áp dụng giá nhập</button></div></div>
                @if (!readOnly)
                {
                    <button type="button" id="pricingManualGoods" class="btn btn-sm btn-outline-secondary mt-3">Nhập giá thủ công tại Hàng hóa</button>
                }
                <p class="text-muted small mt-2">Áp dụng giá nhập điền giá đã tính sang tab Hàng hóa. Bạn vẫn có thể sửa giá thủ công tại đó trước khi Duyệt và ghi sổ. Áp dụng lại sẽ thay các giá này bằng kết quả tính mới.</p>
            </section>
        </div>
        <div class="sd-workbench-tab-panel" data-workbench-panel="goods">
        <section class="sd-manager-exceptions mb-3" id="managerExceptionQueue"
                 aria-labelledby="managerExceptionQueueTitle" hidden="@(exceptionCount == 0)">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h6 class="mb-1" id="managerExceptionQueueTitle">Xử lý danh mục và đơn đặt hàng</h6>
                    <div class="small text-muted">Hoàn tất các lựa chọn dưới đây để tiếp tục đối chiếu hàng.</div>
                </div>
                @if (pendingOutsideLines.Count > 0)
                {
                    <span class="badge bg-label-warning">@pendingOutsideLines.Count chờ xử lý</span>
                }
                @if (unresolvedProvisionalCount > 0)
                {
                    <span class="badge bg-label-warning">@unresolvedProvisionalCount sản phẩm chưa có danh mục</span>
                }
                @if (catalogReviewLines.Count > 0)
                {
                    <span class="badge bg-label-danger">@catalogReviewLines.Count tên sản phẩm tạm</span>
                }
            </div>

            @foreach (var line in catalogReviewLines)
            {
                <article class="sd-manager-exception-card is-catalog" id="catalogReview-@line.Id">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div class="d-flex align-items-center gap-3">
                            <span class="sd-catalog-warning-icon"><i class="bx bx-package"></i></span>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <span class="badge bg-label-danger">Tên dữ liệu cũ</span>
                                    <span class="small text-muted">Variant #@line.ProductVariantId</span>
                                </div>
                                <div class="fw-semibold">@line.CatalogDisplayName</div>
                                <div class="small text-muted">
                                    SKU: @(line.CatalogSku ?? line.SkuSnapshot ?? "—") · Mã vạch: @(line.BarcodeSnapshot ?? "—")
                                </div>
                            </div>
                        </div>
                        @if (!readOnly && canCompleteCatalogProduct)
                        {
                            <button type="button" class="btn btn-primary js-complete-catalog-product"
                                    data-line-id="@line.Id"
                                    data-variant-id="@line.ProductVariantId"
                                    data-legacy-name="@line.ProductNameSnapshot"
                                    data-sku="@(line.CatalogSku ?? line.SkuSnapshot)"
                                    data-barcode="@line.BarcodeSnapshot">
                                <i class="bx bx-edit-alt me-1"></i>Hoàn thiện sản phẩm
                            </button>
                        }
                    </div>
                </article>
            }

            @if (overdeliveryLines.Count > 0)
            {
                <article class="sd-manager-exception-card is-warning">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <span class="badge bg-label-warning mb-2">Vượt PO</span>
                            @foreach (var line in overdeliveryLines)
                            {
                                <div class="fw-semibold">@line.CatalogDisplayName</div>
                                <div class="small text-muted mb-1">
                                    Thực nhận @line.Quantity.ToString("0.###") @line.UnitName · vượt
                                    @line.ProjectedOverdeliveryQuantity.ToString("0.###") @line.BaseUnitName
                                </div>
                            }
                        </div>
                        @if (!readOnly)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="acceptOverdelivery" />
                                <label class="form-check-label fw-semibold" for="acceptOverdelivery">
                                    Chấp nhận vượt
                                </label>
                            </div>
                        }
                    </div>
                    @if (!readOnly)
                    {
                        <details class="mt-2">
                            <summary class="small text-primary">Thêm ghi chú (tùy chọn)</summary>
                            <textarea class="form-control form-control-sm mt-2" id="overdeliveryNote"
                                      rows="2" maxlength="1000" placeholder="Có thể để trống"></textarea>
                        </details>
                    }
                </article>
            }

            @foreach (var line in outsideLines)
            {
                var isPending = line.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Pending;
                var isAccepted = line.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Accepted;
                <article class="sd-manager-exception-card @(isPending ? "is-warning" : "is-resolved")"
                         id="outsidePoDecision-@line.Id" data-outside-line-id="@line.Id">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                                <span class="badge bg-label-warning">Ngoài PO</span>
                                <span class="badge bg-label-@(isPending ? "warning" : isAccepted ? "success" : "secondary")">
                                    @(isPending ? "Chờ quản lý" : isAccepted ? "Đã chấp nhận" : "Đã loại")
                                </span>
                            </div>
                            <div class="fw-semibold">@line.CatalogDisplayName</div>
                            <div class="small text-muted">
                                @line.Quantity.ToString("0.###") @line.UnitName
                                @if (!line.IsBaseUnit)
                                {
                                    <span> · tương đương @line.BaseQuantity.ToString("0.###") @line.BaseUnitName</span>
                                }
                            </div>
                        </div>
                        @if (isPending && canApproveOutsidePo && !readOnly)
                        {
                            <div class="d-flex gap-2 flex-wrap" role="group"
                                 aria-label="Xử lý hàng ngoài PO @line.CatalogDisplayName">
                                <button type="button" class="btn btn-sm btn-outline-success js-manager-outside-decision"
                                        data-line-id="@line.Id" data-accept="true">
                                    Chấp nhận ngoài PO
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-manager-outside-decision"
                                        data-line-id="@line.Id" data-accept="false">
                                    Loại khỏi phiếu
                                </button>
                            </div>
                        }
                    </div>
                    <div class="small text-danger mt-2 d-none js-manager-outside-message"
                         role="alert" aria-live="assertive"></div>
                </article>
            }
        </section>
        </div>

        <div class="sd-workbench-tab-panel" data-workbench-panel="settlement" hidden>
        <section class="sd-commercial-settlement" aria-labelledby="commercialSettlementTitle">
            <div class="mb-3">
                <h5 class="mb-1" id="commercialSettlementTitle">Thanh toán &amp; thuế</h5>
                <div class="small text-muted">Kiểm tra nhà cung cấp, VAT và tình trạng thanh toán tiền hàng.</div>
            </div>
            <div class="sd-settlement-grid">
                <article class="sd-setting-block is-supplier">
                    <div class="sd-setting-heading">
                        <span class="sd-setting-icon"><i class="bx bx-store"></i></span>
                        <div><strong>Nhà cung cấp</strong><small>Đơn vị phát sinh tiền hàng và công nợ</small></div>
                    </div>
                    <label class="form-label" for="commercialSupplierId">
                        Chọn nhà cung cấp <span class="sd-supplier-required text-danger">*</span>
                    </label>
                    <select class="form-select" id="commercialSupplierId" disabled="@readOnly">
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @if (Model.SupplierId.HasValue)
                        {
                            <option value="@Model.SupplierId" selected>@Model.SupplierName</option>
                        }
                    </select>
                    @if (readOnly)
                    {
                        <div class="form-text">Sửa nhà cung cấp tại Tác vụ khác. Phiếu có lịch sử thanh toán phải dùng chứng từ điều chỉnh.</div>
                    }
                    <div class="form-text">Nhà cung cấp bắt buộc để ghi nhận công nợ khi duyệt.</div>
                    <div id="commercialSupplierSaveState" class="small mt-1" role="status" aria-live="polite"></div>
                </article>

                <article class="sd-setting-block">
                    <div class="sd-setting-heading">
                        <span class="sd-setting-icon is-vat"><i class="bx bx-receipt"></i></span>
                        <div><strong>Thuế VAT</strong><small>Cách tính giá vốn của hàng nhập</small></div>
                    </div>
                    <div class="sd-commercial-switch">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="commercialHasVat"
                                   checked="@Model.HasVat" disabled="@readOnly" />
                            <label class="form-check-label fw-semibold" for="commercialHasVat">Có VAT</label>
                        </div>
                        <small class="text-muted">Giá chưa VAT</small>
                    </div>
                    <div class="sd-inline-check mt-2">
                        <input class="form-check-input" type="checkbox" id="includeVatInInventoryCost"
                               checked="@Model.IncludeVatInInventoryCost" disabled="@(readOnly || !Model.HasVat)" />
                        <label for="includeVatInInventoryCost">
                            <strong>Đưa VAT vào giá vốn</strong>
                            <small>Áp dụng khi thuế không được khấu trừ</small>
                        </label>
                    </div>
                </article>

                <article class="sd-setting-block">
                    <div class="sd-setting-heading">
                        <span class="sd-setting-icon is-payment"><i class="bx bx-credit-card"></i></span>
                        <div><strong>Tiền hàng</strong><small>Trạng thái chi trả cho nhà cung cấp</small></div>
                    </div>
                    <div class="sd-receipt-payment-rule" role="note">
                        <strong>@(readOnly && Model.IsMerchandisePaid ? "Đã thanh toán theo sổ công nợ" : readOnly ? "Theo sổ công nợ nhà cung cấp" : "Ghi nhận khoản phải trả khi duyệt")</strong>
                        <p class="mb-0">Thanh toán được ghi nhận bằng phiếu chi tại Thu/chi sau khi duyệt.</p>
                        @if (ViewData["CanRecordReceiptPayment"] as bool? == true)
                        {
                            <a class="btn btn-sm btn-outline-primary mt-2" href="/admin/reports/cashflow">Mở Thu/chi <i class="bx bx-link-external" aria-hidden="true"></i></a>
                        }
                    </div>
                </article>
            </div>
        </section>
        </div>

        <div class="sd-workbench-tab-panel" data-workbench-panel="goods">
        <div class="sd-manager-goods">
            <div class="sd-review-goods-toolbar">
                <div class="sd-review-search-row">
                    <label class="sd-review-search" for="commercialLineSearch">
                        <i class="bx bx-search" aria-hidden="true"></i>
                        <span class="visually-hidden">Tìm dòng hàng theo tên, SKU hoặc mã vạch</span>
                        <input type="search" class="form-control" id="commercialLineSearch" placeholder="Tìm tên, SKU, mã vạch…" autocomplete="off" />
                    </label>
                    @if (!readOnly)
                    {
                        <button type="button" class="btn btn-outline-primary sd-review-next-issue" id="commercialNextIssue"><i class="bx bx-skip-next" aria-hidden="true"></i><span>Mục cần xử lý tiếp theo</span></button>
                    }
                    <span class="sd-review-visible-count" id="commercialVisibleCount" role="status" aria-live="polite">@lines.Count / @lines.Count dòng</span>
                </div>
                <div class="sd-filter-chips" role="group" aria-label="Lọc dòng hàng">
                    <button type="button" class="active" data-commercial-filter="all" aria-pressed="true">Tất cả <span>@lines.Count</span></button>
                    @if (revisionLineCount > 0)
                    {
                        <button type="button" data-commercial-filter="revision" aria-pressed="false">Đã sửa / bổ sung <span>@revisionLineCount</span></button>
                    }
                    <button type="button" data-commercial-filter="catalog" aria-pressed="false">Cần xử lý SP <span>@catalogReviewLines.Count</span></button>
                    <button type="button" data-commercial-filter="price" aria-pressed="false">Thiếu giá <span data-commercial-filter-count>@missingPriceCount</span></button>
                    <button type="button" data-commercial-filter="exception" aria-pressed="false">Ngoại lệ <span>@exceptionCount</span></button>
                    @if (!readOnly)
                    {
                        <button type="button" data-commercial-filter="blocking" aria-pressed="false">Cần hoàn tất <span data-commercial-filter-count>0</span></button>
                        <button type="button" data-commercial-filter="warning" aria-pressed="false">Cần kiểm tra <span data-commercial-filter-count>0</span></button>
                    }
                </div>
            </div>
            @if (revisionReview is not null)
            {
                <div class="sd-revision-summary" role="note">
                    <i class="bx bx-revision" aria-hidden="true"></i>
                    <div>
                        <strong>Thay đổi sau lần trả về gần nhất</strong>
                        <details class="sd-revision-history">
                        <summary>
                            <span>
                            @revisionReview.AddedLineCount dòng bổ sung · @revisionReview.ChangedLineCount dòng chỉnh sửa
                            @if (revisionReview.RemovedLineCount > 0)
                            {
                                <text> · @revisionReview.RemovedLineCount dòng đã xóa</text>
                            }
                            </span>
                            <span class="sd-revision-history-toggle">Lịch sử <i class="bx bx-chevron-down" aria-hidden="true"></i></span>
                        </summary>
                        <small>
                            Trả về lúc @revisionReview.ReturnedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")
                            @if (revisionReview.ResubmittedAtUtc.HasValue)
                            {
                                <text> · Gửi duyệt lại lúc @revisionReview.ResubmittedAtUtc.Value.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</text>
                            }
                            <span class="d-block mt-1">Các dòng bổ sung hoặc chỉnh sửa được đưa lên đầu để đối chiếu; giá nháp đã lưu được giữ lại.</span>
                        </small>
                        </details>
                    </div>
                </div>
            }
            <div class="table-responsive sd-commercial-table-wrap">
                <table class="table align-middle mb-0 sd-commercial-table">
                    <thead>
                        <tr>
                            <th class="sd-commercial-image-column">Ảnh</th>
                            <th>Sản phẩm</th>
                            <th>Thực nhận</th>
                            <th>Giá nhập</th>
                            <th data-commercial-vat hidden="@(!Model.HasVat)">VAT</th>
                            <th>Giá bán lẻ hiện tại</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lines)
                        {
                            var selectedTaxId = line.TaxId ?? (!readOnly ? line.SuggestedTaxId : null);
                            var editableUnitPriceBeforeVat = readOnly ||
                                (allocationApplied && line.UnitPriceBeforeVat == 0m)
                                ? line.UnitPriceBeforeVat : line.EditableUnitPriceBeforeVat;
                            var isOutside = isPurchaseOrderReceipt && line.ReceiptAllocationKind == ReceiptAllocationKind.OutsidePo;
                            var isOverdelivery = isPurchaseOrderReceipt && line.ProjectedOverdeliveryQuantity > 0m;
                            var quickPriceLine = quickPriceLines.GetValueOrDefault(line.Id);
                            var isRevisionLine = revisionReview is not null &&
                                line.RevisionChangeKind is "added" or "changed";
                            <tr class="commercial-line @(isRevisionLine ? "sd-revision-line" : string.Empty)"
                                data-line-id="@line.Id"
                                data-row-version="@line.RowVersion"
                                data-line-no="@line.LineNo"
                                data-line-number="@line.LineNo"
                                data-product-name="@line.CatalogDisplayName"
                                data-barcode="@line.BarcodeSnapshot"
                                data-search="@($"{line.CatalogDisplayName} {line.CatalogSku} {line.SkuSnapshot} {line.BarcodeSnapshot}")"
                                data-revision-changed="@isRevisionLine.ToString().ToLowerInvariant()"
                                data-revision-change="@(isRevisionLine ? line.RevisionChangeKind : string.Empty)"
                                data-catalog-review="@line.RequiresCatalogReview.ToString().ToLowerInvariant()"
                                data-price-missing="@(!editableUnitPriceBeforeVat.HasValue ? "true" : "false")"
                                data-exception="@(isOutside || isOverdelivery || line.RequiresCatalogReview ? "true" : "false")"
                                data-quantity="@line.Quantity.ToString(CultureInfo.InvariantCulture)"
                                data-factor="@line.Factor.ToString(CultureInfo.InvariantCulture)"
                                data-exact-before-vat="@((line.LineTotal - line.VatAmount).ToString(CultureInfo.InvariantCulture))"
                                data-exact-unit-price="@line.UnitPriceBeforeVat.ToString("0.##", CultureInfo.InvariantCulture)">
                                <td data-label="Ảnh" class="sd-commercial-image-column">
                                    @if (!string.IsNullOrWhiteSpace(line.ProductImageUrl))
                                    {
                                        <button type="button" class="sd-commercial-image-button"
                                                aria-label="Xem ảnh phóng to của @line.CatalogDisplayName"
                                                aria-controls="commercialImagePreview" aria-expanded="false">
                                            <img class="sd-commercial-thumbnail" src="@line.ProductImageUrl"
                                                 alt="@line.CatalogDisplayName" loading="lazy" />
                                            <i class="bx bx-image" aria-hidden="true" hidden></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="sd-commercial-image-empty" title="Chưa có ảnh" role="img" aria-label="Chưa có ảnh sản phẩm">
                                            <i class="bx bx-image" aria-hidden="true"></i>
                                        </span>
                                    }
                                </td>
                                <td data-label="Sản phẩm">
                                    <div class="sd-product-identity">
                                        <div class="fw-semibold">@line.CatalogDisplayName</div>
                                        @if (isRevisionLine)
                                        {
                                            <div class="sd-revision-change">
                                                <span class="sd-revision-badge"><i class="bx @(line.RevisionChangeKind == "added" ? "bx-plus-circle" : "bx-edit")" aria-hidden="true"></i>@(line.RevisionChangeKind == "added" ? "Bổ sung" : "Đã chỉnh sửa")</span>
                                                @if (!string.IsNullOrWhiteSpace(line.RevisionChangeSummary))
                                                {
                                                    <small>@line.RevisionChangeSummary</small>
                                                }
                                            </div>
                                        }
                                        @if (line.RequiresCatalogReview)
                                        {
                                            <a class="small text-danger fw-semibold" href="#catalogReview-@line.Id">Cần hoàn thiện tên sản phẩm</a>
                                        }
                                        else if (line.UsesLegacyProductSnapshot &&
                                                 !string.Equals(line.CatalogDisplayName, line.ProductNameSnapshot, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="small text-success"><i class="bx bx-check-circle me-1"></i>Đã nhận diện từ danh mục</div>
                                            <div class="small text-muted">Dữ liệu cũ: @line.ProductNameSnapshot</div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(line.CatalogSku ?? line.SkuSnapshot))
                                    {
                                        <div class="small text-muted">SKU: @(line.CatalogSku ?? line.SkuSnapshot)</div>
                                    }
                                </td>
                                <td data-label="Thực nhận">
                                    <strong>@line.Quantity.ToString("0.###") @line.UnitName</strong>
                                    @if (!line.IsBaseUnit)
                                    {
                                        <div class="small text-muted">
                                            Tương đương @line.BaseQuantity.ToString("0.###") @line.BaseUnitName
                                        </div>
                                    }
                                </td>
                                <td data-label="Giá nhập">
                                    <div class="receipt-quick-price-entry">
                                    <div class="input-group input-group-sm">
                                        <input class="form-control text-end commercial-unit-price" type="number"
                                               readonly="@readOnly"
                                               data-line-version="@line.RowVersion"
                                               min="0.01" step="0.01"
                                               value="@(editableUnitPriceBeforeVat?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty)"
                                               disabled="@readOnly" aria-label="Giá nhập chưa VAT của @line.CatalogDisplayName" />
                                        <span class="input-group-text">đ/@line.UnitName</span>
                                    </div>
                                    @if (!readOnly)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-qprice-open disabled="@(quickPriceLine is null)"
                                                aria-expanded="false" aria-controls="receiptQuickPrice-@line.Id"
                                                aria-label="Tính nhanh giá nhập của @line.CatalogDisplayName"
                                                title="@quickPriceUnavailable">
                                            <i class="bx bx-calculator" aria-hidden="true"></i><span>Tính nhanh</span>
                                        </button>
                                    }
                                    </div>
                                    @if (!readOnly && quickPriceLine is not null)
                                    {
                                        <section id="receiptQuickPrice-@line.Id" class="receipt-quick-price"
                                                 data-qprice-panel hidden
                                                 data-qprice-product-name="@line.CatalogDisplayName"
                                                 data-qprice-unit-id="@quickPriceLine.UnitId"
                                                 data-qprice-unit-name="@line.UnitName"
                                                 data-qprice-base-unit-name="@line.BaseUnitName"
                                                 data-qprice-factor="@line.Factor.ToString(CultureInfo.InvariantCulture)"
                                                 aria-label="Tính nhanh giá nhập của @line.CatalogDisplayName">
                                            <div class="receipt-quick-price-heading">
                                                <div><strong>Tính nhanh · @line.CatalogDisplayName</strong><div class="small text-muted">Chỉ điền giá khi bấm Duyệt hoặc Enter</div></div>
                                                <button type="button" class="btn btn-sm btn-link" data-qprice-close aria-label="Đóng phần tính nhanh"><i class="bx bx-x" aria-hidden="true"></i></button>
                                            </div>
                                            <div class="receipt-quick-price-fields">
                                                <label>Số lượng mua
                                                    <div class="receipt-quick-price-quantity">
                                                        <input class="form-control" data-qprice-buy type="number" min="0" step="any" inputmode="decimal"
                                                               value="@line.Quantity.ToString(CultureInfo.InvariantCulture)" aria-label="Số lượng mua" />
                                                        <select class="form-select" data-qprice-buy-unit aria-label="Đơn vị hàng mua">
                                                            @foreach (var priceUnit in quickPriceLine.Units)
                                                            {
                                                                <option value="@priceUnit.UnitId" selected="@(priceUnit.UnitId == quickPriceLine.UnitId)"
                                                                        data-factor="@priceUnit.Factor.ToString(CultureInfo.InvariantCulture)"
                                                                        data-name="@priceUnit.Name">@priceUnit.Name ×@priceUnit.Factor.ToString("0.####")</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </label>
                                                <label>Tổng tiền hàng trước VAT
                                                    <div class="input-group">
                                                        <input class="form-control" data-qprice-money type="text" inputmode="decimal" placeholder="Nhập tổng tiền đã trả" aria-label="Tổng tiền hàng trước VAT" />
                                                        <span class="input-group-text">đ</span>
                                                    </div>
                                                </label>
                                            </div>
                                            <label class="receipt-quick-price-gift-toggle">
                                                <input class="form-check-input" data-qprice-has-gift type="checkbox" />
                                                Có tặng thêm cùng sản phẩm
                                            </label>
                                            <div data-qprice-gift-fields class="receipt-quick-price-gift-fields" hidden>
                                                <label>Số lượng được tặng
                                                    <div class="receipt-quick-price-quantity">
                                                        <input class="form-control" data-qprice-gift type="number" min="0" step="any" inputmode="decimal" value="0" aria-label="Số lượng được tặng" />
                                                        <select class="form-select" data-qprice-gift-unit aria-label="Đơn vị hàng tặng">
                                                            @foreach (var priceUnit in quickPriceLine.Units)
                                                            {
                                                                <option value="@priceUnit.UnitId" selected="@(priceUnit.UnitId == quickPriceLine.UnitId)"
                                                                        data-factor="@priceUnit.Factor.ToString(CultureInfo.InvariantCulture)"
                                                                        data-name="@priceUnit.Name">@priceUnit.Name ×@priceUnit.Factor.ToString("0.####")</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="small text-danger mt-2" data-qprice-error role="alert" hidden></div>
                                            <div data-qprice-results aria-live="polite" hidden>
                                                <div class="receipt-quick-price-total"><span>Tổng mua + tặng sau quy đổi</span><strong data-qprice-total></strong></div>
                                                <div class="receipt-quick-price-result"><span>Giá nhập tính được</span><strong data-qprice-result></strong><small class="text-muted" data-qprice-base></small></div>
                                            </div>
                                            <div class="receipt-quick-price-actions">
                                                <button type="button" class="btn btn-outline-secondary" data-qprice-cancel>Hủy <kbd>Esc</kbd></button>
                                                <button type="button" class="btn btn-primary" data-qprice-approve disabled>Duyệt <kbd>Enter</kbd></button>
                                            </div>
                                        </section>
                                    }
                                    @if (!readOnly) { <div class="small mt-1 commercial-price-save-state" role="status"></div> }
                                    @if (!editableUnitPriceBeforeVat.HasValue)
                                    {
                                        <div class="small text-warning commercial-price-missing">
                                            Chưa có giá nhập — quản lý cần nhập giá trước khi duyệt.
                                        </div>
                                    }
                                    <div class="small text-muted mt-1">
                                        Giá gần nhất:
                                        <span class="commercial-last-price"
                                              data-value="@(line.LastPurchaseUnitPriceBeforeVat?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)">
                                            @(line.LastPurchaseUnitPriceBeforeVat.HasValue ? line.LastPurchaseUnitPriceBeforeVat.Value.ToString("N0") + " đ" : "Chưa có")
                                        </span>
                                    </div>
                                    <div class="small commercial-price-variance text-muted" aria-live="polite"></div>
                                    <div class="sd-price-review mt-2" data-price-review-line-id="@line.Id" aria-live="polite">Đang tải đánh giá…</div>
                                    @if (ViewData["CanEditSellingPrices"] as bool? == true)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2 js-receipt-selling-prices"
                                                data-line-id="@line.Id" data-variant-id="@line.ProductVariantId">
                                            <i class="bx bx-purchase-tag-alt me-1"></i>Giá bán &amp; lợi nhuận
                                        </button>
                                    }
                                    <div class="small commercial-price-error text-danger"></div>
                                </td>
                                <td data-label="VAT" data-commercial-vat hidden="@(!Model.HasVat)">
                                    <select class="form-select form-select-sm commercial-tax"
                                            disabled="@(readOnly || !Model.HasVat)"
                                            aria-label="Thuế suất của @line.CatalogDisplayName">
                                        <option value="" data-rate="">-- Chọn --</option>
                                        @foreach (var tax in taxes)
                                        {
                                            <option value="@tax.Id" data-rate="@tax.Rate.ToString(CultureInfo.InvariantCulture)"
                                                    selected="@(selectedTaxId == tax.Id)">@tax.Name (@tax.Rate.ToString("0.##")%)</option>
                                        }
                                    </select>
                                </td>
                                <td data-label="Giá bán lẻ hiện tại" class="sd-review-money">
                                    @if (retailPrices.TryGetValue(line.Id, out var retail))
                                    {
                                        <div class="fw-semibold text-nowrap" data-retail-variant="@retail.VariantId" data-retail-unit="@retail.UnitId">
                                            @(retail.Price.HasValue ? retail.Price.Value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + $" đ/{retail.UnitName}" : "Chưa có giá bán")
                                        </div>
                                    }
                                    else { <span class="text-muted">Chưa có giá bán</span> }
                                </td>
                                <td data-label="Thành tiền" class="sd-review-money">
                                    <strong class="commercial-line-after-vat">@line.LineTotal.ToString("N0") đ</strong>
                                    <div class="small text-muted" data-commercial-vat hidden="@(!Model.HasVat)">VAT: <span class="commercial-line-vat">@line.VatAmount.ToString("N0") đ</span></div>
                                </td>
                                <td data-label="Trạng thái">
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (line.RequiresCatalogReview)
                                        {
                                            <span class="badge bg-label-danger">Danh mục: cần xử lý</span>
                                        }
                                        @if (isOutside)
                                        {
                                            <span class="badge bg-label-warning">Ngoài PO</span>
                                            <span class="badge bg-label-@(line.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Accepted ? "success" : "warning")">
                                                @(line.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Accepted ? "Đã chấp nhận" : "Chờ xử lý")
                                            </span>
                                        }
                                        else if (isPurchaseOrderReceipt)
                                        {
                                            <span class="sd-review-line-origin">Trong PO</span>
                                        }
                                        else
                                        {
                                            <span class="sd-review-line-origin">Nhập trực tiếp</span>
                                        }
                                        @if (isOverdelivery)
                                        {
                                            <span class="badge bg-label-warning">Vượt PO</span>
                                        }
                                    </div>
                                    @if (isOutside && line.OutsidePoDecisionStatus == OutsidePoDecisionStatus.Pending)
                                    {
                                        <a class="small d-inline-block mt-2" href="#outsidePoDecision-@line.Id">Xử lý</a>
                                    }
                                    <div class="commercial-line-freight mt-2 @(Model.HasFreight && Model.CapitalizeFreightInInventoryCost ? string.Empty : "d-none")">
                                        <label class="small text-muted" for="commercialFreightAllocation-@line.Id">Phí phân bổ</label>
                                        <div class="input-group input-group-sm">
                                            <input class="form-control text-end commercial-freight-allocation" type="number"
                                                   id="commercialFreightAllocation-@line.Id" min="0" step="0.01"
                                                   value="@line.FreightAllocation.ToString("0.##", CultureInfo.InvariantCulture)"
                                                   disabled="@(readOnly || !Model.HasFreight || !Model.CapitalizeFreightInInventoryCost)" />
                                            <span class="input-group-text">đ</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="commercialFilterEmpty" class="text-center border rounded-3 p-4 mt-3" role="status" hidden>
                <p id="commercialFilterEmptyMessage" class="text-muted mb-2">Không có dòng hàng phù hợp với bộ lọc này.</p>
                <button type="button" class="btn btn-sm btn-outline-primary" data-commercial-filter="all">Hiện tất cả dòng</button>
            </div>
        </div>
        </div>

        <div class="sd-workbench-tab-panel" data-workbench-panel="freight" hidden>
        <section class="sd-commercial-disclosure sd-commercial-freight sd-tab-surface"
                 id="commercialFreightDisclosure">
            <header>
                <span>
                    <strong id="commercialFreightHeading">Phí vận chuyển: @(Model.HasFreight ? Model.FreightTotal.ToString("N0") + " đ" : "Không phát sinh")</strong>
                    <small id="commercialFreightDescription">@(Model.HasFreight ? "Kiểm tra thanh toán và phân bổ." : "Bật khi phiếu có phát sinh phí vận chuyển.")</small>
                </span>
                <i class="bx bx-car" aria-hidden="true"></i>
            </header>
            <div class="sd-commercial-disclosure-body">
                <div class="small text-muted mb-3">
                    Mặc định ghi nhận riêng. Khi vốn hóa, hệ thống phân bổ theo tiền hàng sau VAT.
                </div>
                <div class="d-flex justify-content-end mb-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="commercialAutoAllocate"
                            disabled="@(readOnly || !Model.HasFreight || !Model.CapitalizeFreightInInventoryCost)">
                        <i class="bx bx-reset me-1"></i>Đặt lại phân bổ tự động
                    </button>
                </div>
                <div class="row g-3 align-items-end sd-freight-grid">
                    <div class="col-12 col-md-2">
                        <div class="form-check form-switch sd-paid-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="commercialHasFreight"
                                   checked="@Model.HasFreight" disabled="@readOnly" />
                            <label class="form-check-label fw-semibold" for="commercialHasFreight">Có phí vận chuyển</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-check form-switch sd-paid-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="capitalizeFreightInInventoryCost"
                                   checked="@Model.CapitalizeFreightInInventoryCost" disabled="@(readOnly || !Model.HasFreight)" />
                            <label class="form-check-label fw-semibold" for="capitalizeFreightInInventoryCost">Vốn hóa vào giá vốn</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label" for="commercialFreightTotal">Tổng phí</label>
                        <div class="input-group">
                            <input class="form-control text-end" type="number" min="0" step="0.01"
                                   id="commercialFreightTotal"
                                   value="@Model.FreightTotal.ToString("0.##", CultureInfo.InvariantCulture)"
                                   disabled="@(readOnly || !Model.HasFreight)" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="commercialFreightPayee">Người/đơn vị nhận tiền</label>
                        <input class="form-control" id="commercialFreightPayee" maxlength="250"
                               value="@Model.FreightPayeeName" disabled="@(readOnly || !Model.HasFreight)" />
                    </div>
                    <div class="col-12">
                        <div class="sd-receipt-payment-rule" role="note">Phí vận chuyển tạo khoản phải trả riêng khi duyệt. Thanh toán bằng phiếu chi tại Thu/chi.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="commercialFreightNote">Ghi chú vận chuyển</label>
                        <input class="form-control" id="commercialFreightNote" maxlength="1000"
                               value="@Model.FreightNote" disabled="@(readOnly || !Model.HasFreight)" />
                    </div>
                </div>
                <div class="sd-allocation-status mt-3" id="commercialAllocationStatus"></div>
            </div>
        </section>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="commercialValidationMessage" role="alert" tabindex="-1"></div>
        </div>
        <aside class="sd-review-financial-summary" aria-label="Tổng tiền và khoản phải trả">
            <details class="sd-review-financial-disclosure" open>
                <summary><span>Tổng tiền &amp; công nợ</span><i class="bx bx-chevron-down" aria-hidden="true"></i></summary>
                <div class="sd-review-financial-body">
                    <section class="sd-review-money-section">
                        <span class="sd-review-money-label">Tiền hàng gồm VAT</span>
                        <strong class="sd-review-money-total" id="commercialMerchandiseTotal">0 đ</strong>
                        <span class="sd-review-money-note" id="commercialMerchandisePaymentState">@(Model.IsMerchandisePaid ? "Đã trả tiền hàng" : "Chưa trả nhà cung cấp")</span>
                    </section>
                    <section class="sd-review-money-section is-inventory">
                        <span class="sd-review-money-label">Giá trị nhập kho</span>
                        <strong class="sd-review-money-total" id="commercialLandedTotal">0 đ</strong>
                        <span class="sd-review-money-note">Theo lựa chọn đưa VAT và cước vào giá vốn.</span>
                    </section>
                    <section class="sd-review-money-section sd-review-outstanding">
                        <h6 class="mb-2">@(readOnly ? "Khoản phải trả lúc ghi sổ" : "Khoản phải trả khi duyệt")</h6>
                        <div class="sd-review-money-row"><span>Tiền hàng</span><strong id="commercialOutstandingMerchandise">0 đ</strong></div>
                        <div class="sd-review-money-row"><span>Vận chuyển</span><strong id="commercialOutstandingFreight">0 đ</strong></div>
                        <span class="sd-review-money-note" id="commercialFreightPaymentState">@(!Model.HasFreight ? "Không có phí vận chuyển" : Model.IsFreightPaid ? "Đã trả phí vận chuyển" : "Chưa trả phí vận chuyển")</span>
                        @if (readOnly)
                        {
                            <span class="sd-review-money-note">Các số tiền trên là giá trị ghi nhận ban đầu. Số dư hiện tại và từng lần thanh toán xem tại Thu/chi.</span>
                        }
                    </section>
                    <details class="sd-review-money-breakdown">
                        <summary>Chi tiết cách tính <i class="bx bx-chevron-down" aria-hidden="true"></i></summary>
                        <div class="sd-review-money-row"><span>Tiền trước VAT</span><strong id="commercialSubtotal">0 đ</strong></div>
                        <div class="sd-review-money-row"><span>Tiền VAT</span><strong id="commercialVatTotal">0 đ</strong></div>
                        <div class="sd-review-money-row"><span>Phí vận chuyển</span><strong id="commercialFreightSummary">0 đ</strong></div>
                        <p>Tiền hàng gồm VAT dùng để đối chiếu thanh toán. Giá trị nhập kho dùng ghi nhận tồn kho; VAT và cước chỉ được cộng khi chọn đưa vào giá vốn.</p>
                    </details>
                    @if (!readOnly)
                    {
                        <p class="sd-review-apply-note"><i class="bx bx-info-circle" aria-hidden="true"></i><span>VAT và vận chuyển áp dụng khi <strong>Duyệt và ghi sổ</strong>. Thanh toán ghi nhận bằng phiếu chi riêng.</span></p>
                    }
                </div>
            </details>
        </aside>
        </div>
    </div>

    @if (!readOnly)
    {
        <div class="sd-commercial-sticky-actions">
            <div class="sd-manager-save-state">
                <i class="bx bx-check-circle" aria-hidden="true"></i>
                <span>Đang kiểm tra giá nháp…</span>
            </div>
            <div class="sd-manager-blocker-summary @(pendingOutsideLines.Count > 0 || unresolvedProvisionalCount > 0 || catalogReviewLines.Count > 0 ? "is-blocked" : string.Empty)"
                 id="managerApprovalBlockerSummary" role="status" aria-live="polite" tabindex="-1">
                @(catalogReviewLines.Count > 0
                    ? $"Còn {catalogReviewLines.Count} sản phẩm tạm cần hoàn thiện"
                    : unresolvedProvisionalCount > 0
                    ? $"Còn {unresolvedProvisionalCount} sản phẩm chưa có trong danh mục"
                    : pendingOutsideLines.Count > 0
                    ? $"Còn {pendingOutsideLines.Count} hàng Ngoài PO chưa xử lý"
                    : "Đang kiểm tra điều kiện duyệt…")
            </div>
            <div class="d-flex gap-2 ms-auto sd-manager-primary-actions">
                <button type="button" class="btn btn-outline-danger" id="commercialRejectButton">
                    Trả về chỉnh sửa
                </button>
                <button type="button" class="btn btn-success" id="commercialApproveButton"
                        disabled="@(pendingOutsideLines.Count > 0 || unresolvedProvisionalCount > 0 || catalogReviewLines.Count > 0)">
                    <i class="bx bx-check-shield me-1"></i>Duyệt và ghi sổ
                </button>
            </div>
        </div>
    }
</section>

@if (!readOnly && canCompleteCatalogProduct)
{
    <div class="modal fade" id="completeCatalogProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 sd-catalog-modal">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <div class="text-uppercase text-primary small fw-semibold">Hoàn thiện danh mục</div>
                        <h5 class="modal-title">Đặt tên chính thức cho sản phẩm</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="catalogReviewLineId" />
                    <div class="sd-catalog-legacy-box mb-3">
                        <span>Tên dữ liệu cũ</span>
                        <strong id="catalogReviewLegacyName">—</strong>
                        <small id="catalogReviewIdentity">—</small>
                    </div>
                    <label class="form-label fw-semibold" for="catalogReviewProductName">
                        Tên sản phẩm chính thức <span class="text-danger">*</span>
                    </label>
                    <input class="form-control form-control-lg" id="catalogReviewProductName"
                           maxlength="200" autocomplete="off"
                           placeholder="Ví dụ: Nước giặt OMO Matic 3,6 kg" />
                    <div class="form-text">
                        Hệ thống giữ nguyên variant, SKU, mã vạch, tồn kho và lịch sử giá; chỉ hoàn thiện tên đang tạm.
                    </div>
                    <div class="small text-danger mt-2" id="catalogReviewMessage" role="alert" aria-live="assertive"></div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnSaveCatalogProduct">
                        <i class="bx bx-check me-1"></i>Lưu và nhận diện
                    </button>
                </div>
            </div>
        </div>
    </div>
}
