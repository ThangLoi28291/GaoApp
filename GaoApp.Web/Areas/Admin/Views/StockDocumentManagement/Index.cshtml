@using GaoApp.Application.Common.Security
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Phiếu nhập kho";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    var canCreate = (await AuthorizationService
        .AuthorizeAsync(User, null, AppPermissions.InventoryStockDocumentCreate)).Succeeded;
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">Phiếu nhập kho</h3>
                <p class="gds-page-header__subtitle mb-0">
                    Theo dõi tiến độ, kiểm tra giá trị và xử lý phiếu cần duyệt.
                </p>
            </div>

            <a class="btn btn-outline-primary" href="/admin/input-invoices"><i class="bx bx-folder-open me-1"></i> Thư viện hóa đơn XML</a>
            @if (canCreate)
            {
                <div class="gds-page-header__actions">
                    <button class="btn btn-primary gds-action-button gds-action-button--primary"
                            id="btnCreateReceipt">
                        <i class="bx bx-plus" aria-hidden="true"></i>
                        <span>Tạo phiếu nhập</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@section VendorStyles {
    <link href="~/admin/css/stock-document-management.css" rel="stylesheet" asp-append-version="true" />
}

<div data-gao-ui="modern" data-stock-document-index class="gds-page sd-index-page">
    <section aria-label="Tổng quan phiếu nhập kho">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-3">
            <div class="col">
                <button type="button" id="sdWaitingInvoiceKpi" class="sd-index-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100" aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-warning text-warning" aria-hidden="true"><i class="bx bx-receipt"></i></span>
                    <span class="gds-kpi-card__body"><span class="gds-kpi-card__label">Chờ hóa đơn</span><span class="gds-kpi-card__value text-warning" id="sdCountWaitingInvoice">0</span></span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="sd-index-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--primary h-100 w-100"
                        data-status-filter="all"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon" aria-hidden="true"><i class="bx bx-file"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Tổng phiếu</span>
                        <span class="gds-kpi-card__value" id="sdCountAll">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="sd-index-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-status-filter="working"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-danger text-danger" aria-hidden="true"><i class="bx bx-edit"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Đang làm</span>
                        <span class="gds-kpi-card__value text-danger" id="sdCountWorking">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="sd-index-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-status-filter="pending"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-warning text-warning" aria-hidden="true"><i class="bx bx-time-five"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Chờ duyệt</span>
                        <span class="gds-kpi-card__value text-warning" id="sdCountPending">0</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="sd-index-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--success h-100 w-100"
                        data-status-filter="confirmed"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon is-success" aria-hidden="true"><i class="bx bx-check-circle"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Đã duyệt</span>
                        <span class="gds-kpi-card__value text-success" id="sdCountConfirmed">0</span>
                    </span>
                </button>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0" aria-label="Bộ lọc phiếu nhập kho">
        <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm rounded bg-label-primary"><i class="bx bx-filter-alt" aria-hidden="true"></i></span>
                <div>
                    <h5 class="mb-0 text-dark">Tra cứu phiếu nhập</h5>
                    <small class="text-muted">Tìm theo mã phiếu, tên phiếu, đơn mua, nhà cung cấp hoặc kho.</small>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="gds-filter-bar">
                <div class="gds-filter-bar__search">
                    <label for="sdSearchKeyword" class="form-label">Tìm kiếm</label>
                    <div class="gds-search-field">
                        <i class="bx bx-search" aria-hidden="true"></i>
                        <input type="search"
                               class="form-control"
                               id="sdSearchKeyword"
                               autocomplete="off"
                               placeholder="Nhập nội dung cần tìm..." />
                    </div>
                </div>
                <div class="gds-filter-control">
                    <label for="sdStatusFilter" class="form-label">Trạng thái</label>
                    <select class="form-select" id="sdStatusFilter">
                        <option value="needsAction" selected>Cần xử lý</option>
                        <option value="active">Nháp + Chờ duyệt</option>
                        <option value="all">Tất cả trạng thái</option>
                        <option value="working">Đang làm + Cần sửa</option>
                        <option value="draft">Nháp</option>
                        <option value="pending">Chờ duyệt</option>
                        <option value="confirmed">Đã duyệt</option>
                        <option value="rejected">Từ chối</option>
                    </select>
                </div>
                <div class="gds-filter-control">
                    <label for="sdInvoiceFilter" class="form-label">Tình trạng hóa đơn</label>
                    <select class="form-select" id="sdInvoiceFilter">
                        <option value="all">Tất cả</option>
                        <option value="Waiting">Chờ hóa đơn</option>
                        <option value="NeedsReview">Cần kiểm tra hóa đơn</option>
                        <option value="Reviewed">Đã kiểm tra hóa đơn</option>
                        <option value="Complete">Đủ hóa đơn</option>
                        <option value="NotExpected">Không chờ hóa đơn</option>
                        <option value="Unclassified">Chưa phân loại (phiếu cũ)</option>
                    </select>
                </div>
                <div class="gds-filter-control gds-filter-control--compact">
                    <label for="sdPageSize" class="form-label">Số dòng / trang</label>
                    <select class="form-select" id="sdPageSize">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <button type="button" class="btn btn-outline-secondary" id="sdBtnResetFilter">Xóa lọc</button>
            </div>
        </div>
    </section>

    <section class="gds-list-panel sd-index-list-panel" aria-label="Danh sách phiếu nhập kho">
        <div class="gds-desktop-list sd-index-desktop-list table-responsive">
            <table class="table table-hover align-middle mb-0 sd-index-table">
                <thead>
                    <tr>
                        <th class="sd-index-col-document">Phiếu nhập</th>
                        <th class="sd-index-col-employee" title="Người tạo phiếu và quầy tại thời điểm tạo">Nhân viên / Quầy nhập</th>
                        <th class="sd-index-col-progress">Tiến độ</th>
                        <th class="sd-index-col-products text-end">Loại SP</th>
                        <th class="sd-index-col-amount text-end">Tổng tiền</th>
                        <th class="sd-index-col-updated">Cập nhật</th>
                        <th class="sd-index-col-actions text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="sdReceiptTableBody">
                    <tr><td colspan="7" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="gds-mobile-list sd-index-mobile-list" id="sdReceiptMobileList">
            <div class="text-center text-muted py-4">Đang tải dữ liệu...</div>
        </div>

        <div class="gds-list-footer sd-pagination">
            <div class="gds-list-footer__summary" id="sdPaginationInfo">Đang tải...</div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="sdBtnPrevPage">Trước</button>
                <button type="button" class="btn btn-outline-secondary btn-sm disabled" id="sdCurrentPageText">1 / 1</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="sdBtnNextPage">Sau</button>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="createReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 sd-create-modal">

            <div class="sd-create-modal-header d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center gap-3">
                    <div class="sd-create-icon">
                        <i class="bx bx-package"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold mb-1 text-white">Tạo phiếu nhập kho</h5>
                        <div class="text-muted small">
                            Đặt tên phiếu để dễ tìm lại và quản lý.
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên phiếu</label>
                    <input type="text"
                           class="form-control"
                           id="createDocumentTitle"
                           placeholder="VD: Nhập hàng NCC A - buổi sáng" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">HKD nhập hàng <span class="text-danger">*</span></label>
                    <select class="form-select" id="createLegalEntityId">
                        <option value="">-- Chọn HKD --</option>
                    </select>
                    <div class="form-text">Kho bên dưới chỉ hiển thị các kho thuộc HKD đã chọn.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Kho <span class="text-danger">*</span></label>
                    <select class="form-select" id="createWarehouseId">
                        <option value="">-- Chọn kho --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nhà cung cấp</label>
                    <input type="text"
                           class="form-control"
                           id="createSupplierKeyword"
                           placeholder="Gõ tên nhà cung cấp..." />

                    <div class="list-group mt-2" id="supplierLookupList"></div>
                    <input type="hidden" id="createSupplierId" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ngày phiếu</label>
                    <input type="datetime-local"
                           class="form-control"
                           id="createDocumentDate" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nguồn nhập <span class="text-danger">*</span></label>
                    <select class="form-select" id="createDirectReceiptReason">
                        <option value="Nhà phân phối giao" selected>Nhà phân phối giao</option>
                        <option value="NCC chào hàng">NCC chào hàng</option>
                        <option value="Mua gấp">Mua gấp</option>
                        <option value="Hàng đổi/trả">Hàng đổi/trả</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <div class="form-text">Không cần đơn đặt hàng. Giá và VAT do người duyệt chốt sau.</div>
                </div>

                <div class="mb-0">
                    <label class="form-label fw-semibold">Ghi chú thêm</label>
                    <textarea class="form-control"
                              id="createNote"
                              rows="3"
                              placeholder="Ghi chú thêm nếu cần..."></textarea>
                </div>

                <div class="form-text mt-2 text-danger" id="createReceiptMessage"></div>
            </div>

            <div class="modal-footer justify-content-between border-0 px-4 pb-4 pt-0">
                <div class="small text-muted">
                    Enter: tạo phiếu · Esc: đóng
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="button"
                            class="btn btn-primary px-4"
                            id="btnSubmitCreateReceipt">
                        <i class="bx bx-check me-1"></i>
                        Tạo phiếu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="stockDocumentInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 sd-approval-modal">
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" id="sdInfoTitle">Chi tiết phiếu</h5>
                        <div class="text-muted small" id="sdInfoSubTitle">-</div>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Trạng thái</div>
                            <div class="sd-popup-info-value" id="sdInfoStatus">-</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Kho</div>
                            <div class="sd-popup-info-value" id="sdInfoWarehouse">-</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Nhà cung cấp</div>
                            <div class="sd-popup-info-value" id="sdInfoSupplier">-</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Nhân viên tạo phiếu</div>
                            <div class="sd-popup-info-value" id="sdInfoCreatedBy">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Quầy lúc tạo phiếu</div>
                            <div class="sd-popup-info-value" id="sdInfoEntryTerminal">-</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Ngày phiếu</div>
                            <div class="sd-popup-info-value" id="sdInfoDocumentDate">-</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Ngày tạo</div>
                            <div class="sd-popup-info-value" id="sdInfoCreatedAt">-</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Ngày sửa</div>
                            <div class="sd-popup-info-value" id="sdInfoUpdatedAt">-</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Gửi duyệt</div>
                            <div class="sd-popup-info-value" id="sdInfoSubmittedAt">-</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Tổng dòng</div>
                            <div class="sd-popup-info-value" id="sdInfoTotalLines">0</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Tổng loại sản phẩm</div>
                            <div class="sd-popup-info-value" id="sdInfoTotalProducts">0</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="sd-popup-info-box">
                            <div class="sd-popup-info-label">Tổng tiền</div>
                            <div class="sd-popup-info-value text-primary" id="sdInfoTotalAmount">0</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>

                <a class="btn btn-primary" id="sdInfoOpenDetail" href="#">
                    Mở chi tiết
                </a>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    @await Html.PartialAsync("_ReceiptDocumentActions")
    <script src="~/Admin/js/receipt-document-actions.js" asp-append-version="true"></script>
    @if ((await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.System.ProductLabel.Print)).Succeeded)
    {
        <link rel="stylesheet" href="~/Admin/css/label-printing.css" asp-append-version="true" />
        <script src="~/Admin/js/printing/label-print-controls.js" asp-append-version="true"></script>
        <script src="~/Admin/js/printing/label-receipt-links.js" asp-append-version="true"></script>
    }
    <script>
        window.stockDocumentPage = {
            mode: 'index'
        };
    </script>

    <script src="~/admin/js/receipt-invoice-follow-up.js" asp-append-version="true"></script>
    <script src="~/admin/js/stock-document-management.js" asp-append-version="true"></script>
}
