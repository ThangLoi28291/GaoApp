@model List<GaoApp.Application.DTOs.Display.DisplayPromotionDto>
@{
    ViewData["Title"] = "Màn hình khách";
}
@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/display-promotion.css" asp-append-version="true" />
}
@section header {
    <div class="dp-heading">
        <div><span class="dp-eyebrow">TRẢI NGHIỆM TẠI QUẦY</span><h1>Màn hình khách</h1><p>Chào đón khách bằng những thông tin hữu ích từ cửa hàng.</p></div>
        <a href="/admin/pos/customer-display" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="bx bx-desktop" aria-hidden="true"></i>Mở màn hình khách<i class="bx bx-link-external" aria-hidden="true"></i></a>
    </div>
}
@await Html.PartialAsync("_Workspace", Model)

<div class="modal fade" id="promotionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <form id="promotionForm" class="modal-content" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" id="promotionId" name="id" value="0" />

            <div class="modal-header">
                <div>
                    <h5 id="promotionModalTitle" class="modal-title">
                        Thêm nội dung màn hình khách
                    </h5>
                    <div class="text-muted small">
                        Chuẩn bị lời chào, hình ảnh hoặc video cho khách tại quầy.
                    </div>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-4">

                    <div class="col-lg-7">
                        <div class="mb-3">
                            <label class="form-label">Tiêu đề</label>
                            <input id="title" name="Title" class="form-control" required maxlength="250" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea id="description" name="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Loại nội dung</label>
                                <select id="mediaType" name="MediaType" class="form-select" onchange="syncPreview()">
                                    <option value="text">Văn bản</option>
                                    <option value="image">Hình ảnh</option>
                                    <option value="video">Video</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thời lượng giây</label>
                                <input id="durationSeconds" name="DurationSeconds" type="number" min="3" max="60" class="form-control" value="6" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thứ tự</label>
                                <input id="sortOrder" name="SortOrder" type="number" min="0" class="form-control" value="0" />
                            </div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-3">
                                <label class="form-label">Ưu tiên</label>
                                <input id="priority"
                                       name="Priority"
                                       type="number"
                                       min="0"
                                       max="999"
                                       class="form-control"
                                       value="0" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Đếm ngược đến</label>
                                <input id="countdownToUtc"
                                       name="CountdownToUtc"
                                       type="datetime-local"
                                       class="form-control" />
                            </div>

                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input id="isFlashSale"
                                           name="IsFlashSale"
                                           class="form-check-input"
                                           type="checkbox"
                                           value="true" />
                                    <label class="form-check-label" for="isFlashSale">Ưu đãi chớp nhoáng</label>
                                </div>
                            </div>

                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input id="isFullscreen"
                                           name="IsFullscreen"
                                           class="form-check-input"
                                           type="checkbox"
                                           value="true" />
                                    <label class="form-check-label" for="isFullscreen">Toàn màn hình</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">File ảnh/video</label>
                            <input id="mediaFile" name="mediaFile" type="file" class="form-control" accept="image/*,video/*" onchange="previewFile(this)" />
                            <div class="form-text">
                                Để trống để giữ hình ảnh hoặc video hiện tại.
                            </div>
                        </div>

                        <input id="mediaUrl" name="MediaUrl" type="hidden" />

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">Màu nền</label>
                                <input id="backgroundColor" name="BackgroundColor" class="form-control" placeholder="#0f172a" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Màu chữ</label>
                                <input id="textColor" name="TextColor" class="form-control" placeholder="#ffffff" />
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">Bắt đầu</label>
                                <input id="startAt" name="StartAt" type="datetime-local" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Kết thúc</label>
                                <input id="endAt" name="EndAt" type="datetime-local" class="form-control" />
                            </div>
                        </div>

                        <div class="form-check form-switch mt-4">
                            <input id="isActive" name="IsActive" class="form-check-input" type="checkbox" checked value="true" />
                            <label class="form-check-label" for="isActive">
                                Đang bật hiển thị
                            </label>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <label class="form-label">Xem trước trên màn hình khách</label>

                        <div id="livePreview"
                             class="display-preview-box">
                            <div id="previewText" class="display-preview-text">
                                Kính chào quý khách
                            </div>
                            <img id="previewImage" class="display-preview-media d-none" />
                            <video id="previewVideo" class="display-preview-media d-none" muted controls></video>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-label-secondary"
                        data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="submit"
                        id="btnSavePromotion"
                        class="btn btn-primary">
                    Lưu nội dung
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/js/display-promotion.js" asp-append-version="true"></script>
}
