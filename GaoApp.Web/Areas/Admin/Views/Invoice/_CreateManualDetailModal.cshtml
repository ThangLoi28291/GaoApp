@model GaoApp.Web.Areas.Admin.ViewModels.Invoices.CreateManualInvoiceDetailViewModel

<form id="manualDetailForm"
      asp-area="Admin"
      asp-controller="Invoice"
      asp-action="CreateManualDetail"
      method="post"
      data-is-adjustment-amount-invoice="@Model.IsAdjustmentAmountInvoice.ToString().ToLower()">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="InvoiceHeadId" />
    <input type="hidden" asp-for="ProductVariantId" id="manualProductVariantId" />
    <input type="hidden" asp-for="IsAdjustmentAmountInvoice" />

    <div class="modal-header">
        <div>
            <h5 class="modal-title">Thêm dòng manual</h5>
            <div class="text-muted small">
                Chọn sản phẩm như POS, nhưng dòng này không gắn OrderLine.
            </div>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>
    </div>

    <div class="modal-body">

        @if (Model.IsAdjustmentAmountInvoice)
        {
            <div class="alert alert-warning small mb-3">
                <div class="fw-semibold">
                    Hóa đơn điều chỉnh tiền
                </div>
                <div>
                    Được phép nhập số lượng âm để điều chỉnh giảm.
                    Ví dụ: <strong>-1</strong> × <strong>36.000</strong> = <strong>-36.000</strong>.
                </div>
                <div>
                    Đơn giá vẫn nhập số dương. Muốn giảm tiền thì nhập <strong>số lượng âm</strong>.
                </div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-semibold">
                Chọn sản phẩm
            </label>

            <div class="invoice-product-search-wrap">
                <input type="text"
                       id="manualProductSearch"
                       class="form-control"
                       placeholder="Gõ tên sản phẩm / SKU / barcode..."
                       autocomplete="off" />

                <div id="manualProductAutocomplete"
                     class="invoice-autocomplete-menu"
                     style="display:none;">
                </div>
            </div>

            <small class="text-muted">
                Sau khi chọn, hệ thống tự điền tên, đơn vị, đơn giá.
            </small>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                Nội dung hàng hóa/dịch vụ
            </label>

            <input asp-for="ItemName"
                   id="manualItemName"
                   class="form-control"
                   placeholder="Tên hàng hóa/dịch vụ..." />
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">ĐVT</label>
                <input asp-for="UnitName"
                       id="manualUnitName"
                       class="form-control"
                       placeholder="Cái, hộp, bịch..." />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Số lượng
                    @if (Model.IsAdjustmentAmountInvoice)
                    {
                        <span class="text-danger">(cho phép âm)</span>
                    }
                </label>

                @if (Model.IsAdjustmentAmountInvoice)
                {
                    <input asp-for="Quantity"
                           id="manualQuantity"
                           type="number"
                           step="0.001"
                           class="form-control"
                           placeholder="VD: -1 để điều chỉnh giảm"
                           required />

                    <div class="form-text text-warning">
                        Nhập số âm nếu điều chỉnh giảm. Không được nhập 0.
                    </div>
                }
                else
                {
                    <input asp-for="Quantity"
                           id="manualQuantity"
                           type="number"
                           step="0.001"
                           min="0.001"
                           class="form-control"
                           placeholder="VD: 1"
                           required />
                }
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Đơn giá</label>
                <input asp-for="UnitPrice"
                       id="manualUnitPrice"
                       type="number"
                       step="1"
                       min="0"
                       class="form-control"
                       placeholder="VD: 36000"
                       required />

                @if (Model.IsAdjustmentAmountInvoice)
                {
                    <div class="form-text">
                        Đơn giá nhập số dương.
                    </div>
                }
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label class="form-label fw-semibold">VAT %</label>
                <input asp-for="VatRate"
                       id="manualVatRate"
                       type="number"
                       step="0.01"
                       min="0"
                       max="100"
                       class="form-control" />
            </div>

            <div class="col-md-8">
                <label class="form-label fw-semibold">Ghi chú</label>
                <input asp-for="Note"
                       class="form-control"
                       placeholder="Ghi chú dòng điều chỉnh, nếu có" />
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Đóng
        </button>

        <button type="submit"
                class="btn btn-primary">
            <i class="bx bx-save"></i>
            Lưu dòng manual
        </button>
    </div>
</form>

@if (Model.IsAdjustmentAmountInvoice)
{
    <script>
        (function () {
            const quantityInput = document.getElementById('manualQuantity');

            if (!quantityInput) {
                return;
            }

            quantityInput.removeAttribute('min');
            quantityInput.setAttribute('step', '0.001');
            quantityInput.setAttribute('placeholder', 'VD: -1 để điều chỉnh giảm');
        })();
    </script>
}