@using System.Globalization
@using GaoApp.Application.DTOs.Invoices
@using GaoApp.Domain.Enums
@model GaoApp.Web.Areas.Admin.ViewModels.Invoices.InvoiceIndexViewModel

@{
    ViewData["Title"] = "Hóa đơn bán ra";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";
    var q = Model.Query ?? new InvoiceListQueryDto();
    var items = Model.Items ?? new List<InvoiceListItemDto>();
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var hasFilters = q.FromDate.HasValue || q.ToDate.HasValue || q.OrderId.HasValue ||
        !string.IsNullOrWhiteSpace(q.Keyword) || q.DisplayMode != InvoiceListDisplayMode.All;
    var firstItem = items.Count == 0 ? 0 : (Math.Max(Model.CurrentPage, 1) - 1) * q.PageSize + 1;
    var lastItem = items.Count == 0 ? 0 : firstItem + items.Count - 1;
    var workspaces = new Dictionary<InvoiceListDisplayMode, string>
    {
        [InvoiceListDisplayMode.All] = "Tất cả hóa đơn",
        [InvoiceListDisplayMode.ManualWaitingInfo] = "Chờ khách nhập thông tin",
        [InvoiceListDisplayMode.ManualReady] = "Sẵn sàng phát hành",
        [InvoiceListDisplayMode.ManualNeedsAttention] = "Cần xử lý"
    };
    var listTitle = q.DisplayMode switch
    {
        InvoiceListDisplayMode.ManualWaitingInfo => "Chờ khách nhập thông tin",
        InvoiceListDisplayMode.ManualReady => "Sẵn sàng phát hành thủ công",
        InvoiceListDisplayMode.ManualNeedsAttention => "Hóa đơn cần xử lý",
        _ => "Danh sách hóa đơn"
    };
    var displayModes = new Dictionary<InvoiceListDisplayMode, string>
    {
        [InvoiceListDisplayMode.All] = "Tất cả hóa đơn",
        [InvoiceListDisplayMode.HasQuantity] = "Có số lượng",
        [InvoiceListDisplayMode.Empty] = "Chưa có dòng / số lượng",
        [InvoiceListDisplayMode.Locked] = "Đã khóa",
        [InvoiceListDisplayMode.Unlocked] = "Chưa khóa",
        [InvoiceListDisplayMode.HasAutoLines] = "Có dòng từ đơn hàng",
        [InvoiceListDisplayMode.HasManualLines] = "Có dòng thêm tay",
        [InvoiceListDisplayMode.ManualWaitingInfo] = workspaces[InvoiceListDisplayMode.ManualWaitingInfo],
        [InvoiceListDisplayMode.ManualReady] = workspaces[InvoiceListDisplayMode.ManualReady],
        [InvoiceListDisplayMode.ManualNeedsAttention] = workspaces[InvoiceListDisplayMode.ManualNeedsAttention]
    };
    var sortModes = new Dictionary<InvoiceListSortMode, string>
    {
        [InvoiceListSortMode.OrderIdDesc] = "Đơn hàng mới nhất",
        [InvoiceListSortMode.HasLinesThenOrderIdDesc] = "Có sản phẩm trước, đơn mới nhất",
        [InvoiceListSortMode.OrderIdAsc] = "Đơn hàng cũ nhất",
        [InvoiceListSortMode.InvoiceDateDesc] = "Ngày hóa đơn mới nhất",
        [InvoiceListSortMode.InvoiceDateAsc] = "Ngày hóa đơn cũ nhất",
        [InvoiceListSortMode.GrandTotalDesc] = "Tổng tiền cao nhất",
        [InvoiceListSortMode.GrandTotalAsc] = "Tổng tiền thấp nhất",
        [InvoiceListSortMode.QuantityDesc] = "Số lượng nhiều nhất",
        [InvoiceListSortMode.QuantityAsc] = "Số lượng ít nhất",
        [InvoiceListSortMode.AutoLineCountDesc] = "Nhiều dòng từ đơn hàng nhất",
        [InvoiceListSortMode.ManualLineCountDesc] = "Nhiều dòng thêm tay nhất"
    };
    string PageUrl(int page, InvoiceListDisplayMode? displayMode = null) => Url.Action("Index", "Invoice", new
    {
        area = "Admin", page, pageSize = q.PageSize,
        fromDate = q.FromDate?.ToString("yyyy-MM-dd"), toDate = q.ToDate?.ToString("yyyy-MM-dd"),
        orderId = q.OrderId, keyword = q.Keyword, displayMode = (int)(displayMode ?? q.DisplayMode), sortMode = (int)q.SortMode
    }) ?? "";
    var pageNumbers = new SortedSet<int> { 1, Model.TotalPages };
    for (var page = Math.Max(1, Model.CurrentPage - 2); page <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); page++)
        pageNumbers.Add(page);
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/invoice-index.css" asp-append-version="true" />
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h1 class="gds-page-header__title">Hóa đơn bán ra</h1>
                <div class="gds-page-header__meta">Tra cứu hóa đơn, người mua và tình trạng phát hành.</div>
            </div>
            <span class="gds-status is-primary">@Model.TotalItems.ToString("N0", vi) hóa đơn</span>
        </div>
    </div>
}

<div data-gao-ui="modern" data-layout-consistency>
  <div class="gds-page invoice-index">
    <nav class="d-flex flex-wrap gap-2" aria-label="Không gian làm việc hóa đơn">
        @foreach (var workspace in workspaces)
        {
            <a href="@PageUrl(1, workspace.Key)"
               class="btn @(q.DisplayMode == workspace.Key ? "btn-primary" : "btn-outline-primary")"
               aria-current="@(q.DisplayMode == workspace.Key ? "page" : null)">@workspace.Value</a>
        }
    </nav>
    <section class="gds-section gds-section--compact invoice-filter" aria-label="Tìm kiếm và lọc hóa đơn">
      <form method="get" asp-area="Admin" asp-controller="Invoice" asp-action="Index">
        <input type="hidden" name="Page" value="1" />
        <div class="invoice-filter__main">
            <div>
                <label for="invoiceKeyword" class="form-label">Tìm hóa đơn</label>
                <div class="gds-search-field">
                    <i class="bx bx-search" aria-hidden="true"></i>
                    <input id="invoiceKeyword" name="Keyword" type="search" class="form-control"
                           placeholder="Số hóa đơn, tên người mua, mã đơn hàng…" value="@q.Keyword" />
                </div>
            </div>
            <div>
                <label for="invoiceFromDate" class="form-label">Từ ngày</label>
                <input id="invoiceFromDate" type="date" class="form-control" name="FromDate" value="@(q.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label for="invoiceToDate" class="form-label">Đến ngày</label>
                <input id="invoiceToDate" type="date" class="form-control" name="ToDate" value="@(q.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label for="invoiceOrderId" class="form-label">Số thứ tự đơn hàng</label>
                <input id="invoiceOrderId" type="number" class="form-control" name="OrderId" min="1" step="1" placeholder="Ví dụ: 14" value="@q.OrderId" />
            </div>
        </div>
        <div class="invoice-filter__options">
            <div>
                <label for="invoiceDisplayMode" class="form-label">Hiển thị</label>
                <select id="invoiceDisplayMode" name="DisplayMode" class="form-select">
                    @foreach (var option in displayModes)
                    {
                        <option value="@((int)option.Key)" selected="@(q.DisplayMode == option.Key)">@option.Value</option>
                    }
                </select>
            </div>
            <div>
                <label for="invoiceSortMode" class="form-label">Sắp xếp</label>
                <select id="invoiceSortMode" name="SortMode" class="form-select">
                    @foreach (var option in sortModes)
                    {
                        <option value="@((int)option.Key)" selected="@(q.SortMode == option.Key)">@option.Value</option>
                    }
                </select>
            </div>
            <div>
                <label for="invoicePageSize" class="form-label">Mỗi trang</label>
                <select id="invoicePageSize" name="PageSize" class="form-select">
                    @foreach (var size in new[] { 20, 50, 100, q.PageSize }.Where(size => size > 0).Distinct().OrderBy(size => size))
                    {
                        <option value="@size" selected="@(q.PageSize == size)">@size hóa đơn</option>
                    }
                </select>
            </div>
            <div class="invoice-filter__actions">
                <button type="submit" class="btn btn-primary"><i class="bx bx-search" aria-hidden="true"></i> Tìm kiếm</button>
                <a asp-area="Admin" asp-controller="Invoice" asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </div>
      </form>
    </section>

    <section class="gds-list-panel invoice-results" aria-labelledby="invoiceResultsTitle">
        <div class="invoice-results__header">
            <div>
                <h2 id="invoiceResultsTitle" class="gds-list-panel__title">@listTitle</h2>
                <div class="gds-list-panel__meta">@Model.TotalItems.ToString("N0", vi) kết quả@(hasFilters ? " theo bộ lọc" : "")</div>
            </div>
            <span class="invoice-results__range">Hiển thị @firstItem–@lastItem</span>
        </div>
        @if (items.Count == 0)
        {
            <div class="gds-empty invoice-empty" role="status">
                <i class="bx bx-file-find gds-empty__icon" aria-hidden="true"></i>
                <h3>@(Model.TotalItems > 0 ? "Trang này không có hóa đơn" : hasFilters ? "Không tìm thấy hóa đơn phù hợp" : "Chưa có hóa đơn bán ra")</h3>
                <p class="gds-empty__copy">@(Model.TotalItems > 0 ? "Chuyển về trang đầu để xem các hóa đơn trong danh sách." : hasFilters ? "Thử thay đổi từ khóa, khoảng ngày hoặc xóa bộ lọc để xem lại danh sách." : "Hóa đơn được tạo từ đơn hàng sẽ xuất hiện tại đây.")</p>
                @if (Model.TotalItems > 0)
                {
                    <a href="@PageUrl(1)" class="btn btn-outline-primary">Về trang đầu</a>
                }
                else if (hasFilters)
                {
                    <a asp-area="Admin" asp-controller="Invoice" asp-action="Index" class="btn btn-outline-primary">Xóa bộ lọc</a>
                }
            </div>
        }
        else
        {
            <div class="invoice-table-wrap" tabindex="0" role="region" aria-label="Danh sách hóa đơn, có thể cuộn">
                <table class="table gds-table invoice-table">
                    <caption class="visually-hidden">Hóa đơn bán ra và thông tin đơn hàng, người mua, trạng thái, dòng hàng và giá trị.</caption>
                    <thead><tr>
                        <th scope="col">Hóa đơn</th><th scope="col">Đơn hàng</th><th scope="col">HKD phát hành</th>
                        <th scope="col">Người mua</th><th scope="col">Trạng thái</th><th scope="col">Dòng hàng</th>
                        <th scope="col" class="text-end">Giá trị hóa đơn</th><th scope="col"><span class="visually-hidden">Thao tác</span></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="invoice-cell-identity" data-label="Hóa đơn">
                                    <a asp-area="Admin" asp-controller="Invoice" asp-action="Detail" asp-route-id="@item.Id" class="invoice-reference">#@item.Id</a>
                                    <time datetime="@item.InvoiceDate.ToString("s")" class="invoice-secondary">@item.InvoiceDate.ToString("dd/MM/yyyy")<span> · @item.InvoiceDate.ToString("HH:mm")</span></time>
                                </td>
                                <td data-label="Đơn hàng">
                                    <strong class="invoice-order">#@(item.OrderId?.ToString() ?? item.LegacySourceId?.ToString())</strong>
                                    <span class="invoice-secondary">@(item.OrderNumber ?? (item.LegacySourceId.HasValue ? "OrderID GaoStore — chưa liên kết đơn mới" : ""))</span>
                                    @if (item.LegacySourceId.HasValue)
                                    {
                                        <span class="invoice-secondary">GaoStore · Nhóm @item.LegacyOrderCategoryId @(item.LegacyReadOnly ? "· Chỉ tra cứu" : "")</span>
                                    }
                                </td>
                                <td data-label="HKD phát hành">
                                    @if (item.LegalEntityId.HasValue)
                                    {
                                        <strong>@(string.IsNullOrWhiteSpace(item.LegalEntityCode) ? $"HKD #{item.LegalEntityId}" : item.LegalEntityCode)</strong>
                                        <span class="invoice-secondary">@item.LegalEntityName</span>
                                    }
                                    else
                                    {
                                        <span class="invoice-secondary">Chưa gắn HKD</span>
                                    }
                                </td>
                                <td data-label="Người mua">@(string.IsNullOrWhiteSpace(item.BuyerName) ? "Chưa có thông tin" : item.BuyerName)</td>
                                <td class="invoice-cell-status" data-label="Trạng thái">
                                    <div class="invoice-status-stack">
                                        @if (!string.IsNullOrWhiteSpace(item.InvoiceNumber))
                                        {
                                            <span class="gds-status is-success"><i class="bx bx-check-circle" aria-hidden="true"></i> Đã phát hành</span>
                                            <strong class="invoice-number">@item.InvoiceNumber</strong>
                                        }
                                        else
                                        {
                                            <span class="gds-status is-warning"><i class="bx bx-time-five" aria-hidden="true"></i> Chưa phát hành</span>
                                        }
                                        @switch (item.InvoiceIssuanceRoute)
{
    case InvoiceIssuanceRoute.Automatic:
        <span class="badge text-bg-primary">
            <i class="bx bx-bot me-1"
               aria-hidden="true"></i>
            Tự động
        </span>
        break;

    case InvoiceIssuanceRoute.Manual:
        <span class="badge text-bg-info">
            <i class="bx bx-user me-1"
               aria-hidden="true"></i>
            Thủ công
        </span>
        break;

    default:
        <span class="badge text-bg-secondary">
            <i class="bx bx-help-circle me-1"
               aria-hidden="true"></i>
            Chưa phân loại
        </span>
        break;
}
                                        <span class="invoice-lock"><i class="bx @(item.IsLocked ? "bx-lock-alt" : "bx-lock-open-alt")" aria-hidden="true"></i> @(item.IsLocked ? "Đã khóa" : "Chưa khóa")</span>
                                        @if (item.InvoiceIssuanceRoute == InvoiceIssuanceRoute.Manual)
                                        {
                                            @switch (q.DisplayMode)
                                            {
                                                case InvoiceListDisplayMode.ManualWaitingInfo:
                                                    <span class="gds-status is-warning">Chờ thông tin</span>
                                                    break;
                                                case InvoiceListDisplayMode.ManualReady:
                                                    <span class="gds-status is-success">Sẵn sàng</span>
                                                    break;
                                                case InvoiceListDisplayMode.ManualNeedsAttention:
                                                    <span class="gds-status is-warning">Cần xử lý</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.LastErrorMessage))
                                                    {
                                                        <span class="invoice-secondary text-break">@item.LastErrorMessage</span>
                                                    }
                                                    break;
                                            }
                                        }
                                    </div>
                                </td>
                                <td data-label="Dòng hàng">
                                    <strong class="invoice-quantity">SL: @item.TotalQuantity.ToString("#,0.###", vi)</strong>
                                    @if (item.TotalQuantity <= 0 && item.DetailCount <= 0)
                                    {
                                        <span class="invoice-secondary">Chưa có dòng hàng</span>
                                    }
                                    <span class="invoice-secondary">Từ đơn: @item.AutoLineCount · Thêm tay: @item.ManualLineCount</span>
                                </td>
                                <td class="invoice-cell-money" data-label="Giá trị hóa đơn">
                                    <strong class="invoice-total">@item.GrandTotal.ToString("N0", vi)</strong>
                                    <span class="invoice-secondary">Tạm tính: @item.SubTotal.ToString("N0", vi)</span>
                                    <span class="invoice-secondary">VAT: @item.VatAmount.ToString("N0", vi)</span>
                                </td>
                                <td class="invoice-cell-action">
                                    @if (item.InvoiceIssuanceRoute == InvoiceIssuanceRoute.Manual &&
                                         q.DisplayMode == InvoiceListDisplayMode.ManualReady)
                                    {
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="ViettelPayload" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary invoice-detail">
                                            Chuẩn bị phát hành <i class="bx bx-chevron-right" aria-hidden="true"></i>
                                        </a>
                                    }
                                    else if (item.InvoiceIssuanceRoute == InvoiceIssuanceRoute.Manual &&
                                             q.DisplayMode == InvoiceListDisplayMode.ManualWaitingInfo)
                                    {
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary invoice-detail">Nhập thông tin</a>
                                    }
                                    else if (item.InvoiceIssuanceRoute == InvoiceIssuanceRoute.Manual &&
                                             q.DisplayMode == InvoiceListDisplayMode.ManualNeedsAttention)
                                    {
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary invoice-detail">Xử lý</a>
                                    }
                                    else
                                    {
                                    <a asp-area="Admin" asp-controller="Invoice" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary invoice-detail" aria-label="Xem chi tiết hóa đơn @item.Id">
                                        Chi tiết <i class="bx bx-chevron-right" aria-hidden="true"></i>
                                    </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.TotalPages > 1)
        {
            <nav class="gds-pagination invoice-pagination" aria-label="Phân trang hóa đơn">
                <span class="gds-pagination__summary">Trang @Model.CurrentPage / @Model.TotalPages</span>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1) { <a class="page-link" href="@PageUrl(Model.CurrentPage - 1)" aria-label="Trang trước"><i class="bx bx-chevron-left" aria-hidden="true"></i></a> }
                        else { <span class="page-link" aria-disabled="true"><i class="bx bx-chevron-left" aria-hidden="true"></i><span class="visually-hidden">Trang trước</span></span> }
                    </li>
                    @{ var previousPage = 0; }
                    @foreach (var page in pageNumbers)
                    {
                        if (previousPage > 0 && page > previousPage + 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                        <li class="page-item @(page == Model.CurrentPage ? "active" : "")"><a class="page-link" href="@PageUrl(page)" aria-label="Trang @(page)" aria-current="@(page == Model.CurrentPage ? "page" : null)">@(page)</a></li>
                        previousPage = page;
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages) { <a class="page-link" href="@PageUrl(Model.CurrentPage + 1)" aria-label="Trang sau"><i class="bx bx-chevron-right" aria-hidden="true"></i></a> }
                        else { <span class="page-link" aria-disabled="true"><i class="bx bx-chevron-right" aria-hidden="true"></i><span class="visually-hidden">Trang sau</span></span> }
                    </li>
                </ul>
            </nav>
        }
    </section>
  </div>
</div>
