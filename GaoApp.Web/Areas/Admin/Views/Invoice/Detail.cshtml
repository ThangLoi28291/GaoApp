@using GaoApp.Domain.Enums
@model GaoApp.Web.Areas.Admin.ViewModels.Invoices.InvoiceDetailViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn bán ra";

    var invoice = Model.Invoice;

    var issuedStatuses = new[]
    {
        InvoiceProviderStatus.Issued,
        InvoiceProviderStatus.PdfDownloaded,
        InvoiceProviderStatus.ZipDownloaded,
        InvoiceProviderStatus.EmailSent
    };

    var isViettelIssued =
        !string.IsNullOrWhiteSpace(invoice.ProviderInvoiceNo)
        || issuedStatuses.Contains(invoice.ProviderStatus);

    var isHardLocked = invoice.IsLocked || isViettelIssued;

    var isCorrectionInvoice =
        invoice.OriginalInvoiceHeadId.HasValue ||
        invoice.CorrectionType.HasValue;

    var isAdjustmentAmountInvoice =
        invoice.CorrectionType == InvoiceCorrectionType.AdjustmentAmount;

    var correctionHistory =
        ViewBag.CorrectionHistory as GaoApp.Application.DTOs.Invoices.InvoiceCorrectionHistoryDto;
}

@section VendorStyles {
    <style>
        .invoice-detail-page .page-title {
            font-weight: 700;
            letter-spacing: -.02em;
        }

        .invoice-card {
            border: 0;
            border-radius: 14px;
            overflow: hidden;
        }

            .invoice-card .card-header {
                background: #fff;
            }

        .invoice-product-search-wrap {
            position: relative;
        }

        .invoice-autocomplete-menu {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 6px);
            z-index: 1085;
            background: #fff;
            border: 1px solid #d9dee3;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(67, 89, 113, .18);
            max-height: 340px;
            overflow-y: auto;
            padding: 6px;
        }

        .invoice-ac-item {
            width: 100%;
            border: 0;
            background: #fff;
            text-align: left;
            padding: 10px 12px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            cursor: pointer;
        }

            .invoice-ac-item:hover,
            .invoice-ac-item.active {
                background: #f0f3ff;
            }

        .invoice-ac-title {
            font-weight: 700;
            color: #344767;
        }

        .invoice-ac-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
            font-size: 12px;
            color: #697a8d;
        }

        .invoice-ac-price {
            min-width: 90px;
            text-align: right;
            font-weight: 700;
            color: #696cff;
            white-space: nowrap;
        }

        .invoice-ac-loading,
        .invoice-ac-empty {
            padding: 10px 12px;
            color: #697a8d;
            font-size: 13px;
        }

        .manual-detail-row.is-editing {
            background: #fff8e1 !important;
        }

        .manual-detail-row.is-saving {
            opacity: .65;
            pointer-events: none;
        }

        .manual-detail-row.is-locked {
            opacity: .75;
        }

            .manual-detail-row.is-locked:hover {
                cursor: not-allowed;
            }

        .manual-edit-input {
            min-width: 90px;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #edf0f2;
        }

            .meta-row:last-child {
                border-bottom: 0;
            }

        .meta-label {
            color: #697a8d;
            white-space: nowrap;
        }

        .meta-value {
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        .status-pill {
            padding: 8px 10px;
            border-radius: 10px;
        }

        .invoice-toolbar {
            flex-wrap: wrap;
        }

        @@media (max-width: 768px) {
            .invoice-detail-page .page-header {
                gap: 12px;
                align-items: flex-start !important;
                flex-direction: column;
            }

            .invoice-toolbar .btn,
            .invoice-toolbar a,
            .invoice-toolbar button {
                width: 100%;
            }

            .meta-row {
                display: block;
            }

            .meta-value {
                text-align: left;
            }
        }
    </style>
}

<div class="container-fluid invoice-detail-page"
     id="invoiceDetailPage"
     data-invoice-head-id="@invoice.Id"
     data-is-locked="@isHardLocked.ToString().ToLower()"
     data-is-correction-invoice="@isCorrectionInvoice.ToString().ToLower()"
     data-is-adjustment-amount-invoice="@isAdjustmentAmountInvoice.ToString().ToLower()">

    <form id="invoiceAntiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceDetailHeader.cshtml",
        Model)

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceDetailAlerts.cshtml",
        Model)

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceCorrectionHistory.cshtml",
        correctionHistory)

    <div id="invoiceSummaryBox">
        @await Html.PartialAsync("_InvoiceSummary", invoice)
    </div>

    @await Html.PartialAsync(
    "~/Areas/Admin/Views/Invoice/_InvoiceBuyerViettelCards.cshtml",
    Model.Invoice)

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceAutoLinesTable.cshtml",
        Model)

    <div class="card shadow-sm invoice-card"
         id="manualLinesBox">
        @await Html.PartialAsync("_ManualLinesTable", invoice)
    </div>
</div>

@await Html.PartialAsync(
    "~/Areas/Admin/Views/Invoice/_InvoiceManualModals.cshtml",
    Model)

@section Scripts {
    <script src="~/admin/js/invoice-detail.js" asp-append-version="true"></script>
}