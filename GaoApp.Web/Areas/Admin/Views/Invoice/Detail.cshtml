@using GaoApp.Domain.Enums
@model GaoApp.Web.Areas.Admin.ViewModels.Invoices.InvoiceDetailViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn bán ra";

    var invoice = Model.Invoice;

    var issuedStatuses = new[]
    {
        InvoiceProviderStatus.Issued,
        InvoiceProviderStatus.PdfDownloaded,
        InvoiceProviderStatus.ZipDownloaded,
        InvoiceProviderStatus.EmailSent
    };

    var isViettelIssued =
        !string.IsNullOrWhiteSpace(invoice.ProviderInvoiceNo)
        || issuedStatuses.Contains(invoice.ProviderStatus);

    var isHardLocked = invoice.IsLocked || isViettelIssued;

    var isCorrectionInvoice =
        invoice.OriginalInvoiceHeadId.HasValue ||
        invoice.CorrectionType.HasValue;

    var isAdjustmentAmountInvoice =
        invoice.CorrectionType == InvoiceCorrectionType.AdjustmentAmount;
        var route =
    invoice.InvoiceIssuanceRoute;

var isRouteSwitchCandidate =
    route is
        InvoiceIssuanceRoute.Automatic or
        InvoiceIssuanceRoute.Manual;

var isPreProviderSafeStatus =
    invoice.ProviderStatus is
        InvoiceProviderStatus.LocalDraft or
        InvoiceProviderStatus.ReadyToIssue or
        InvoiceProviderStatus.Previewed;

var canShowRouteChange =
    invoice.OrderId.HasValue &&
    !isHardLocked &&
    isRouteSwitchCandidate &&
    isPreProviderSafeStatus;

    var correctionHistory =
        ViewBag.CorrectionHistory as GaoApp.Application.DTOs.Invoices.InvoiceCorrectionHistoryDto;
}

@section VendorStyles {
    <style>
        .invoice-detail-page .page-title {
            font-weight: 700;
            letter-spacing: -.02em;
        }

        .invoice-card {
            border: 0;
            border-radius: 14px;
            overflow: hidden;
        }

            .invoice-card .card-header {
                background: #fff;
            }

        .invoice-product-search-wrap {
            position: relative;
        }

        .invoice-autocomplete-menu {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 6px);
            z-index: 1085;
            background: #fff;
            border: 1px solid #d9dee3;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(67, 89, 113, .18);
            max-height: 340px;
            overflow-y: auto;
            padding: 6px;
        }

        .invoice-ac-item {
            width: 100%;
            border: 0;
            background: #fff;
            text-align: left;
            padding: 10px 12px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            cursor: pointer;
        }

            .invoice-ac-item:hover,
            .invoice-ac-item.active {
                background: #f0f3ff;
            }

        .invoice-ac-title {
            font-weight: 700;
            color: #344767;
        }

        .invoice-ac-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
            font-size: 12px;
            color: #697a8d;
        }

        .invoice-ac-main { min-width: 0; }
        .invoice-ac-stock { margin-top: 6px; color: #24715b; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
        .invoice-selected-stock { padding: 10px 12px; border: 1px solid #cce5dc; border-radius: 9px; background: #f2faf6; color: #24715b; line-height: 1.7; overflow-wrap: anywhere; }
        .invoice-selected-stock[data-kind="error"] { color: #9a3545; background: #fff5f6; border-color: #efcbd2; }

        .invoice-ac-price {
            min-width: 90px;
            text-align: right;
            font-weight: 700;
            color: #696cff;
            white-space: nowrap;
        }

        .invoice-ac-loading,
        .invoice-ac-empty {
            padding: 10px 12px;
            color: #697a8d;
            font-size: 13px;
        }

        .manual-detail-row.is-editing {
            background: #fff8e1 !important;
        }

        .manual-detail-row.is-saving {
            opacity: .65;
            pointer-events: none;
        }

        .manual-detail-row.is-locked {
            opacity: .75;
        }

            .manual-detail-row.is-locked:hover {
                cursor: not-allowed;
            }

        .manual-edit-input {
            min-width: 90px;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #edf0f2;
        }

            .meta-row:last-child {
                border-bottom: 0;
            }

        .meta-label {
            color: #697a8d;
            white-space: nowrap;
        }

        .meta-value {
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        .status-pill {
            padding: 8px 10px;
            border-radius: 10px;
        }

        .invoice-toolbar {
            flex-wrap: wrap;
        }

        .invoice-stock-heading,
        .invoice-stock-cell {
            min-width: 150px;
        }

        .invoice-stock-quantity {
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .invoice-stock-cell small {
            display: block;
            font-size: 12px;
        }

        .invoice-stock-cell .text-success,
        #invoiceStockStatus.text-success {
            color: #157347 !important;
        }

        .invoice-stock-cell .text-danger,
        #invoiceStockStatus.text-danger {
            color: #b42318 !important;
        }

        .invoice-stock-shortage > td {
            background-color: #fff5f5;
        }

        @@media (max-width: 768px) {
            .invoice-detail-page .page-header {
                gap: 12px;
                align-items: flex-start !important;
                flex-direction: column;
            }

            .invoice-toolbar .btn,
            .invoice-toolbar a,
            .invoice-toolbar button {
                width: 100%;
            }

            .meta-row {
                display: block;
            }

            .meta-value {
                text-align: left;
            }
        }
    </style>
}

<div class="container-fluid invoice-detail-page"
     id="invoiceDetailPage"
     data-invoice-head-id="@invoice.Id"
     data-is-locked="@((!invoice.CanEditDetails).ToString().ToLower())"
     data-is-correction-invoice="@isCorrectionInvoice.ToString().ToLower()"
     data-is-adjustment-amount-invoice="@isAdjustmentAmountInvoice.ToString().ToLower()">

    <form id="invoiceAntiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceDetailHeader.cshtml",
        Model)
        <div class="card shadow-sm invoice-card mb-3">
    <div class="card-body d-flex flex-wrap
                justify-content-between
                align-items-center gap-3">

        <div>
            <div class="text-muted small mb-1">
                Phương thức phát hành
            </div>

            @switch (route)
            {
                case InvoiceIssuanceRoute.Automatic:
                    <span class="badge text-bg-primary">
                        Tự động
                    </span>

                    <span class="text-muted ms-2">
                        AutoInvoice chịu trách nhiệm phát hành.
                    </span>
                    break;

                case InvoiceIssuanceRoute.Manual:
                    <span class="badge text-bg-info">
                        Thủ công
                    </span>

                    <span class="text-muted ms-2">
                        Chờ thông tin người mua và quản lý phát hành.
                    </span>
                    break;

                default:
                    <span class="badge text-bg-secondary">
                        Chưa phân loại
                    </span>

                    <span class="text-muted ms-2">
                        Hóa đơn lịch sử hoặc chưa có phương thức phát hành.
                    </span>
                    break;
            }
        </div>

        @if (canShowRouteChange)
        {
            if (route == InvoiceIssuanceRoute.Automatic)
            {
                <form asp-area="Admin"
                      asp-controller="Invoice"
                      asp-action="ChangeIssuanceRoute"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@invoice.Id" />

                    <input type="hidden"
                           name="route"
                           value="@((int)InvoiceIssuanceRoute.Manual)" />

                    <button type="submit"
                            class="btn btn-outline-primary"
                            data-csp-confirm="Chuyển hóa đơn này sang phát hành thủ công?">
                        <i class="bx bx-user me-1"></i>
                        Chuyển sang thủ công
                    </button>
                </form>
            }
            else if (route == InvoiceIssuanceRoute.Manual)
            {
                <form asp-area="Admin"
                      asp-controller="Invoice"
                      asp-action="ChangeIssuanceRoute"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@invoice.Id" />

                    <input type="hidden"
                           name="route"
                           value="@((int)InvoiceIssuanceRoute.Automatic)" />

                    <button type="submit"
                            class="btn btn-outline-secondary"
                            data-csp-confirm="Chuyển hóa đơn này sang hàng đợi phát hành tự động?">
                        <i class="bx bx-bot me-1"></i>
                        Chuyển sang tự động
                    </button>
                </form>
            }
        }
    </div>
</div>
    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceDetailAlerts.cshtml",
        Model)

    @await Html.PartialAsync(
        "~/Areas/Admin/Views/Invoice/_InvoiceCorrectionHistory.cshtml",
        correctionHistory)

    <div id="invoiceSummaryBox">
        @await Html.PartialAsync("_InvoiceSummary", invoice)
    </div>
    <div id="invoiceTaxBox">@await Html.PartialAsync("_InvoiceRevenueTax", invoice)</div>

    @await Html.PartialAsync(
    "~/Areas/Admin/Views/Invoice/_InvoiceBuyerViettelCards.cshtml",
    Model.Invoice)

    <div class="card shadow-sm invoice-card mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div id="invoiceStockStatus" class="fw-semibold" role="status" aria-live="polite">Đang kiểm tra tồn trước phát hành…</div>
                <small class="text-muted">SL hiện tại là tồn có hóa đơn đầu vào có thể dùng để phát hành, sau khi trừ các hóa đơn đã xuất/đang giữ khác. Hiển thị theo ĐVT của dòng.</small>
                <small id="invoiceStockCheckedAt" class="d-block text-muted"></small>
            </div>
            <button type="button" id="btnRefreshInvoiceStock" class="btn btn-sm btn-outline-primary flex-shrink-0">
                <i class="bx bx-refresh me-1" aria-hidden="true"></i>Cập nhật tồn
            </button>
        </div>
    </div>

    <div id="autoLinesBox">
        @await Html.PartialAsync(
            "~/Areas/Admin/Views/Invoice/_InvoiceAutoLinesTable.cshtml",
            Model)
    </div>

    <div class="card shadow-sm invoice-card"
         id="manualLinesBox">
        @await Html.PartialAsync("_ManualLinesTable", invoice)
    </div>
</div>

@await Html.PartialAsync(
    "~/Areas/Admin/Views/Invoice/_InvoiceManualModals.cshtml",
    Model)

@section Scripts {
    <script src="~/Admin/js/invoice-tax-reduction.js" asp-append-version="true"></script>
    <script src="~/admin/js/invoice-detail.js" asp-append-version="true"></script>
    <script src="~/admin/js/invoice-detail-stock.js" asp-append-version="true"></script>
    <script src="~/Admin/js/invoice-workspace.mobile.js" asp-append-version="true"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/invoice-tax-reduction.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/invoice-workspace.mobile.css" asp-append-version="true" />
}
