@using GaoApp.Domain.Enums
@model GaoApp.Web.ViewModels.Invoices.InvoiceDetailViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn bán ra";

    var invoice = Model.Invoice;

    var autoLines = invoice.Details
        .Where(x => x.SourceType == InvoiceDetailSourceType.FromOrderLine)
        .ToList();
}

@section VendorStyles {
    <style>
        .invoice-product-search-wrap {
            position: relative;
        }

        .invoice-autocomplete-menu {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 6px);
            z-index: 1085;
            background: #fff;
            border: 1px solid #d9dee3;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(67, 89, 113, .18);
            max-height: 340px;
            overflow-y: auto;
            padding: 6px;
        }

        .invoice-ac-item {
            width: 100%;
            border: 0;
            background: #fff;
            text-align: left;
            padding: 10px 12px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            cursor: pointer;
        }

            .invoice-ac-item:hover,
            .invoice-ac-item.active {
                background: #f0f3ff;
            }

        .invoice-ac-title {
            font-weight: 700;
            color: #344767;
        }

        .invoice-ac-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
            font-size: 12px;
            color: #697a8d;
        }

        .invoice-ac-price {
            min-width: 90px;
            text-align: right;
            font-weight: 700;
            color: #696cff;
            white-space: nowrap;
        }

        .invoice-ac-loading,
        .invoice-ac-empty {
            padding: 10px 12px;
            color: #697a8d;
            font-size: 13px;
        }

        .manual-detail-row.is-editing {
            background: #fff8e1 !important;
        }

        .manual-detail-row.is-saving {
            opacity: .65;
            pointer-events: none;
        }

        .manual-detail-row.is-locked {
            opacity: .75;
        }

            .manual-detail-row.is-locked:hover {
                cursor: not-allowed;
            }

        .manual-edit-input {
            min-width: 90px;
        }
    </style>
}

<div class="container-fluid"
     id="invoiceDetailPage"
     data-invoice-head-id="@invoice.Id"
     data-is-locked="@invoice.IsLocked.ToString().ToLower()">

    <form id="invoiceAntiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">
                Hóa đơn bán ra #@invoice.Id
            </h3>

            <div class="text-muted">
                Ngày tạo: @invoice.InvoiceDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (invoice.IsLocked)
            {
                <div class="mt-2">
                    <span class="badge bg-danger">LOCKED</span>
                    <span class="text-muted small ms-2">
                        @(string.IsNullOrWhiteSpace(invoice.LockReason)
                            ? "Hóa đơn đã khóa."
                            : invoice.LockReason)
                    </span>
                </div>
            }
            else
            {
                <div class="mt-2">
                    <span class="badge bg-success">EDITABLE</span>
                </div>
            }
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (!invoice.IsLocked)
            {
                <button type="button"
                        class="btn btn-primary"
                        id="btnOpenManualDetailModal"
                        data-invoice-head-id="@invoice.Id">
                    <i class="bx bx-plus"></i>
                    Thêm dòng manual (F2)
                </button>
            }

            @if (invoice.IsLocked)
            {
                <button type="button"
                        class="btn btn-outline-warning"
                        id="btnUnlockInvoice"
                        data-invoice-head-id="@invoice.Id">
                    <i class="bx bx-lock-open"></i>
                    Mở khóa
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-danger"
                        id="btnLockInvoice"
                        data-invoice-head-id="@invoice.Id">
                    <i class="bx bx-lock"></i>
                    Khóa hóa đơn
                </button>
            }

            <a asp-area="Admin"
                   asp-controller="Invoice"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div id="invoiceSummaryBox">
        @await Html.PartialAsync("_InvoiceSummary", invoice)
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            Thông tin người mua
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-muted">Người mua</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(invoice.BuyerName) ? "-" : invoice.BuyerName)
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted">MST</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(invoice.BuyerTaxCode) ? "-" : invoice.BuyerTaxCode)
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted">Địa chỉ</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(invoice.BuyerAddress) ? "-" : invoice.BuyerAddress)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="fw-bold">
                <span class="badge bg-info me-2">AUTO</span>
                Dòng tự sinh từ OrderLine
            </div>

            <div>
                Tổng:
                <strong>@autoLines.Count</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Sản phẩm</th>
                        <th>ĐVT</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th>OrderLine</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!autoLines.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Không có dòng tự sinh.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in autoLines)
                        {
                            <tr>
                                <td>#@item.Id</td>

                                <td>
                                    <div class="fw-semibold">@item.ItemName</div>
                                    <small class="text-muted">
                                        ProductVariantId: @(item.ProductVariantId?.ToString() ?? "-")
                                    </small>
                                </td>

                                <td>@item.UnitName</td>

                                <td class="text-end">@item.Quantity.ToString("N2")</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                                <td class="text-end fw-bold text-primary">@item.TotalAmount.ToString("N0")</td>

                                <td>#@item.OrderLineId</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm" id="manualLinesBox">
        @await Html.PartialAsync("_ManualLinesTable", invoice)
    </div>
</div>

<div class="modal fade"
     id="manualDetailModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content"
             id="manualDetailModalContent">
        </div>
    </div>
</div>

<div class="modal fade"
     id="deleteManualDetailModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger text-white"
                     style="width:56px;height:56px;font-size:28px;">
                    !
                </div>

                <h5 class="fw-bold mb-2">Xóa dòng manual?</h5>

                <div class="text-muted mb-3">
                    Bạn có chắc muốn xóa dòng:
                    <br />
                    <strong id="deleteManualDetailName"></strong>
                </div>

                <input type="hidden" id="deleteManualDetailId" />

                <div class="d-flex justify-content-center gap-2">
                    <button type="button"
                            class="btn btn-light px-4"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="button"
                            class="btn btn-danger px-4"
                            id="btnConfirmDeleteManualDetail">
                        Xóa dòng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/invoice-detail.js" asp-append-version="true"></script>
}