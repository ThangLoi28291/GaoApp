@{
    ViewData["Title"] = "Đơn hàng POS";
    ViewData["container"] = "container-fluid";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/Admin/css/pos/acb.lookup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/pos/pos-orders-page.css" asp-append-version="true" />
}

<div class="pos-orders-page">
    <partial name="~/Areas/Admin/Views/Shared/_POSNavTabs.cshtml" />
    <header class="po-header">
        <div class="po-heading">
            <span class="po-heading-icon" aria-hidden="true"><i class="bx bx-receipt"></i></span>
            <div>
                <p class="po-eyebrow">QUẢN LÝ BÁN HÀNG</p>
                <h1>Đơn hàng POS<span class="po-title-dot" aria-hidden="true">.</span></h1>
                <p class="po-subtitle">Tra cứu đơn hàng, kiểm tra thanh toán và xử lý sau bán.</p>
            </div>
        </div>
        <div class="po-header-actions">
            <a href="/admin/pos/legacy-returns" class="po-button">Trả hàng cũ chưa liên kết</a>
            <a href="/admin/acb/reconciliation" class="po-button"><i class="bx bx-transfer-alt" aria-hidden="true"></i> Đối soát QR ACB</a>
            <a href="/admin/pos" class="po-button po-button-primary"><i class="bx bx-plus" aria-hidden="true"></i> Bán hàng</a>
        </div>
    </header>

    <section class="po-metrics" aria-label="Tổng quan danh sách đơn">
        <article class="po-metric po-metric-count">
            <div class="po-metric-label">Đơn khớp bộ lọc <i class="bx bx-receipt" aria-hidden="true"></i></div>
            <div class="po-metric-value" id="metricCount">—</div>
            <span class="po-metric-note">Tất cả các trang</span>
        </article>
        <article class="po-metric">
            <div class="po-metric-label">Tổng tiền đơn <i class="bx bx-wallet" aria-hidden="true"></i></div>
            <div class="po-metric-value" id="metricTotal">—</div>
            <span class="po-metric-note">Các đơn trên trang này</span>
        </article>
        <article class="po-metric">
            <div class="po-metric-label">Đã thanh toán <i class="bx bx-check-circle" aria-hidden="true"></i></div>
            <div class="po-metric-value po-text-success" id="metricPaid">—</div>
            <span class="po-metric-note">Các đơn trên trang này</span>
        </article>
        <article class="po-metric">
            <div class="po-metric-label">Còn thiếu <i class="bx bx-time-five" aria-hidden="true"></i></div>
            <div class="po-metric-value" id="metricDue">—</div>
            <span class="po-metric-note">Các đơn trên trang này</span>
        </article>
    </section>

    <section class="po-workspace" aria-label="Tra cứu đơn hàng">
        <form id="ordersFilters" class="po-filters" role="search">
            <div class="po-filter-grid">
                <div class="po-field po-field-search">
                    <label for="keyword">Tìm đơn hàng</label>
                    <div class="po-search-input"><i class="bx bx-search" aria-hidden="true"></i><input type="search" id="keyword" placeholder="Nhập mã đơn hoặc ghi chú…" autocomplete="off" /></div>
                </div>
                <div class="po-field"><label for="fromDate">Từ ngày</label><input type="date" id="fromDate" /></div>
                <div class="po-field"><label for="toDate">Đến ngày</label><input type="date" id="toDate" /></div>
                <div class="po-field">
                    <label for="status">Trạng thái đơn</label>
                    <select id="status">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Completed">Đã chốt</option>
                        <option value="Draft">Nháp</option>
                        <option value="OnHold">Đang giữ</option>
                        <option value="Cancelled">Đã hủy</option>
                        <option value="Voided">Hủy sau chốt</option>
                        <option value="Refunded">Đã hoàn tiền</option>
                    </select>
                </div>
                <button type="submit" class="po-button po-button-primary" id="btnSearch"><i class="bx bx-search" aria-hidden="true"></i> Tìm kiếm</button>
                <button type="button" class="po-button po-filter-toggle" id="btnToggleFilters" aria-expanded="false" aria-controls="fromDate toDate status"><i class="bx bx-filter-alt" aria-hidden="true"></i> Bộ lọc</button>
            </div>
            <div class="po-filter-bottom">
                <div class="po-periods" role="group" aria-label="Khoảng thời gian nhanh">
                    <span class="po-period-label"><i class="bx bx-calendar" aria-hidden="true"></i> Thời gian</span>
                    <button type="button" class="po-chip" data-range="clear" aria-pressed="true">Tất cả</button>
                    <button type="button" class="po-chip" data-range="today" aria-pressed="false">Hôm nay</button>
                    <button type="button" class="po-chip" data-range="7days" aria-pressed="false">7 ngày</button>
                    <button type="button" class="po-chip" data-range="30days" aria-pressed="false">30 ngày</button>
                </div>
                <button type="button" class="po-reset" id="btnResetFilters"><i class="bx bx-reset" aria-hidden="true"></i> Xóa bộ lọc</button>
            </div>
        </form>

        <div class="po-list-heading">
            <div><h2>Danh sách đơn hàng <span id="totalOrdersText" class="po-count" aria-live="polite">Đang tải</span></h2><p id="filterSummary">Tất cả thời gian · Tất cả trạng thái</p></div>
            <div class="po-list-controls">
                <label for="pageSize">Hiển thị</label>
                <select id="pageSize" aria-label="Số đơn trên mỗi trang"><option value="10">10 đơn</option><option value="20" selected>20 đơn</option><option value="50">50 đơn</option></select>
                <button type="button" class="po-icon-button" id="btnRefresh" aria-label="Tải lại danh sách" title="Tải lại danh sách"><i class="bx bx-refresh" aria-hidden="true"></i></button>
            </div>
        </div>
        <p class="po-inline-notice" id="ordersNotice" role="status" hidden></p>
        <div class="po-table-wrap">
            <table class="po-table" aria-label="Danh sách đơn hàng POS" aria-busy="true">
                <thead><tr><th scope="col">Đơn hàng</th><th scope="col">Trạng thái</th><th scope="col" class="po-align-right">Tổng tiền</th><th scope="col" class="po-align-right">Thanh toán</th><th scope="col">Sau bán &amp; voucher</th><th scope="col"><span class="po-sr-only">Thao tác</span></th></tr></thead>
                <tbody id="ordersBody"><tr><td colspan="6"><div class="po-state">Đang tải danh sách đơn…</div></td></tr></tbody>
            </table>
        </div>
        <footer class="po-pagination">
            <span id="pagingInfo" aria-live="polite">Đang tải…</span>
            <nav aria-label="Phân trang đơn hàng">
                <button type="button" class="po-icon-button" id="btnPrevPage" aria-label="Trang trước" disabled><i class="bx bx-chevron-left" aria-hidden="true"></i></button>
                <span id="pageIndicator">Trang 1</span>
                <button type="button" class="po-icon-button" id="btnNextPage" aria-label="Trang sau" disabled><i class="bx bx-chevron-right" aria-hidden="true"></i></button>
            </nav>
        </footer>
    </section>

    <dialog id="orderPreview" class="po-drawer" aria-labelledby="previewTitle">
        <header class="po-drawer-header"><div><p class="po-eyebrow">XEM NHANH ĐƠN HÀNG</p><h2 id="previewTitle">Chi tiết đơn</h2></div><button type="button" class="po-icon-button" id="btnClosePreview" aria-label="Đóng xem nhanh" autofocus><i class="bx bx-x" aria-hidden="true"></i></button></header>
        <div id="previewBody" class="po-drawer-body" aria-busy="false"></div>
        <footer class="po-drawer-footer"><button type="button" class="po-button" id="btnPreviewPrint"><i class="bx bx-printer" aria-hidden="true"></i> In lại</button><a id="previewDetailLink" class="po-button po-button-primary">Mở chi tiết đầy đủ <i class="bx bx-arrow-back po-arrow-right" aria-hidden="true"></i></a></footer>
    </dialog>
</div>

@section PageScripts {
    <script src="~/Admin/js/pos/acb.lookup.launcher.js" asp-append-version="true"></script>
    <script src="~/Admin/js/pos/pos.orders.page.js" asp-append-version="true"></script>
}
