@{
    ViewData["Title"] = "Quản lý kho";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    var authorizationService = (Microsoft.AspNetCore.Authorization.IAuthorizationService)
        Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Authorization.IAuthorizationService))!;
    var canCreateWarehouse = (await authorizationService.AuthorizeAsync(
        User, null, GaoApp.Application.Common.Security.PermissionCodes.Inventory.Warehouse.Create)).Succeeded;
    var canUpdateWarehouse = (await authorizationService.AuthorizeAsync(
        User, null, GaoApp.Application.Common.Security.PermissionCodes.Inventory.Warehouse.Update)).Succeeded;
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">
                    <i class="bx bx-store-alt text-primary" aria-hidden="true"></i>
                    Quản lý kho
                </h3>
                <p class="gds-page-header__subtitle mb-0">
                    Quản lý kho tổng, kho quầy, cấu hình âm kho và kho mặc định.
                </p>
            </div>

            @if (canCreateWarehouse)
            {
                <div class="gds-page-header__actions">
                    <button type="button"
                            class="btn btn-primary gds-action-button gds-action-button--primary"
                            id="btnCreateWarehouse">
                        <i class="bx bx-plus" aria-hidden="true"></i>
                        <span>Thêm kho</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@section VendorStyles {
    <link href="~/admin/css/warehouse-management.css" rel="stylesheet" asp-append-version="true" />
}

<div class="warehouse-page gds-page"
     data-gao-ui="modern"
     data-warehouse-management-index
     data-can-create="@canCreateWarehouse.ToString().ToLowerInvariant()"
     data-can-update="@canUpdateWarehouse.ToString().ToLowerInvariant()">

    <section aria-label="Tổng quan kho">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
            <div class="col">
                <button type="button"
                        class="warehouse-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--primary h-100 w-100"
                        data-kpi-filter="all"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon" aria-hidden="true"><i class="bx bx-package"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Tổng kho</span>
                        <span class="gds-kpi-card__value" id="totalWarehouseCount">--</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="warehouse-kpi-filter card shadow-sm border-0 gds-kpi-card gds-kpi-card--success h-100 w-100"
                        data-kpi-filter="active"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon is-success" aria-hidden="true"><i class="bx bx-check-shield"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Đang hoạt động</span>
                        <span class="gds-kpi-card__value text-success" id="activeWarehouseCount">--</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="warehouse-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-kpi-filter="negative"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-danger text-danger" aria-hidden="true"><i class="bx bx-error-circle"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Cho âm kho</span>
                        <span class="gds-kpi-card__value text-danger" id="negativeWarehouseCount">--</span>
                    </span>
                </button>
            </div>
            <div class="col">
                <button type="button"
                        class="warehouse-kpi-filter card shadow-sm border-0 gds-kpi-card h-100 w-100"
                        data-kpi-filter="default"
                        aria-pressed="false">
                    <span class="gds-kpi-card__icon bg-label-warning text-warning" aria-hidden="true"><i class="bx bx-star"></i></span>
                    <span class="gds-kpi-card__body">
                        <span class="gds-kpi-card__label">Kho mặc định</span>
                        <span class="gds-kpi-card__value text-warning warehouse-default-value" id="defaultWarehouseName">--</span>
                    </span>
                </button>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0" aria-label="Tra cứu kho">
        <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm rounded bg-label-primary"><i class="bx bx-search" aria-hidden="true"></i></span>
                <div>
                    <h5 class="mb-0 text-dark">Tra cứu kho</h5>
                    <small class="text-muted">Tìm nhanh và thu hẹp danh sách kho.</small>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="gds-filter-bar warehouse-filter-bar">
                <div class="gds-filter-bar__search">
                    <label class="form-label" for="warehouseSearch">Tìm kiếm</label>
                    <div class="gds-search-field">
                        <i class="bx bx-search" aria-hidden="true"></i>
                        <input type="search"
                               class="form-control"
                               id="warehouseSearch"
                               autocomplete="off"
                               placeholder="Tên kho, mã kho, HKD hoặc vị trí..." />
                    </div>
                </div>
                <div class="gds-filter-control">
                    <label class="form-label" for="warehouseLegalEntityFilter">HKD sở hữu</label>
                    <select class="form-select" id="warehouseLegalEntityFilter">
                        <option value="all">Tất cả HKD</option>
                    </select>
                </div>
                <div class="gds-filter-control">
                    <label class="form-label" for="warehouseLifecycleFilter">Trạng thái</label>
                    <select class="form-select" id="warehouseLifecycleFilter">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Ngưng hoạt động</option>
                    </select>
                </div>
                <div class="gds-filter-control gds-filter-control--compact">
                    <label class="form-label" for="warehousePageSize">Số dòng / trang</label>
                    <select class="form-select" id="warehousePageSize">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
        </div>
    </section>

    <aside class="warehouse-negative-warning" role="note">
        <i class="bx bx-error-circle" aria-hidden="true"></i>
        <div>
            <strong>Lưu ý cấu hình âm kho</strong>
            <span>Chỉ bật khi thật sự muốn POS vẫn bán dù thiếu tồn.</span>
        </div>
    </aside>

    <section class="gds-list-panel warehouse-list-panel" aria-label="Danh sách kho">
        <div class="warehouse-desktop-list table-responsive">
            <table class="table table-hover align-middle mb-0 warehouse-table" id="warehouseTable">
                <thead>
                    <tr>
                        <th>Kho</th>
                        <th>HKD sở hữu</th>
                        <th>Vị trí &amp; ghi chú</th>
                        <th>Cấu hình</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="6" class="text-center text-muted py-5">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="warehouse-mobile-list" id="warehouseMobileList">
            <div class="text-center text-muted py-4">Đang tải dữ liệu...</div>
        </div>

        <div class="gds-list-footer warehouse-pagination">
            <div class="gds-list-footer__summary" id="warehousePaginationInfo">Đang tải...</div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="warehousePrevPage">Trước</button>
                <button type="button" class="btn btn-outline-secondary btn-sm disabled" id="warehouseCurrentPage">1 / 1</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="warehouseNextPage">Sau</button>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="warehouseModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="warehouseForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="warehouseModalTitle">Thêm kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="warehouseId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Mã kho <span class="text-danger">*</span></label>
                            <input type="text" id="warehouseCode" class="form-control" maxlength="50" placeholder="VD: KHO-TONG" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Tên kho <span class="text-danger">*</span></label>
                            <input type="text" id="warehouseName" class="form-control" maxlength="200" placeholder="VD: Kho tổng" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label" for="warehouseLegalEntityId">HKD sở hữu <span class="text-danger">*</span></label>
                            <select id="warehouseLegalEntityId" class="form-select"></select>
                            <div class="form-text" id="warehouseLegalEntityHelp">
                                Khi sửa kho, không cho đổi HKD để bảo toàn lịch sử tồn.
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Vị trí</label>
                            <input type="text" id="warehouseLocation" class="form-control" maxlength="255" placeholder="VD: Sau quầy bán hàng" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea id="warehouseNote" class="form-control" maxlength="500" rows="3"></textarea>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="warehouseIsDefault">
                                <label class="form-check-label" for="warehouseIsDefault">
                                    Kho mặc định
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4" id="activeWrapper">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="warehouseIsActive" checked>
                                <label class="form-check-label" for="warehouseIsActive">
                                    Đang sử dụng
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="warehouseAllowNegativeInventory">
                                <label class="form-check-label text-danger" for="warehouseAllowNegativeInventory">
                                    Cho phép âm kho
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-danger small mt-3 d-none" id="warehouseError"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                        Đóng
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnSaveWarehouse">
                        Lưu kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/admin/js/warehouse-management.js" asp-append-version="true"></script>
}
