@using GaoApp.Web.Areas.Admin.ViewModels.Products
@model ProductIndexVM
<style>
    .p-thumb {
        width: 100px;
        height: 100px;
        border-radius: 14px;
        overflow: hidden;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0,0,0,.08);
    }

        .p-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .p-empty {
        font-size: 13px;
        color: #6b7280;
    }

</style>
@if (Model.Paged.Items == null || !Model.Paged.Items.Any())
{
    <div class="text-center text-muted py-5">
        Không có dữ liệu.
    </div>
}
else
{
    <div class="table-responsive" style="overflow: visible;">

        <table class="table align-middle">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th style="width:110px;">Ảnh</th>


                    <th>Tên</th>
                    <th>Alias</th>
                    <th>Danh mục</th>
                    <th>Đơn vị</th>
                    <th class="text-end">Giá</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Paged.Items)
                {
                    <tr>
                        <td>@x.Id</td>
                        <td style="width:70px;">
                            <div class="p-thumb-hover">
                                @if (!string.IsNullOrWhiteSpace(x.PrimaryImageUrl))
                                {
                                    <img src="@x.PrimaryImageUrl" class="p-thumb-sm" />
                                    <div class="p-thumb-preview">
                                        <img src="@x.PrimaryImageUrl" />
                                    </div>
                                }
                                else
                                {
                                    <div class="p-empty">No</div>
                                }
                            </div>
                        </td>




                        <td class="fw-semibold">@x.Name</td>

                        <td class="text-muted">@x.Alias</td>
                        <td>@x.CategoryName</td>
                        <td>@x.BaseUnitName</td>
                        <td class="text-end">@x.BasePrice.ToString("n0")</td>
                        <td class="text-center">
                            <span class="badge @(x.IsActive ? "bg-success" : "bg-secondary") js-toggle-status"
                                  role="button"
                                  title="Bấm để đổi trạng thái"
                                  data-toggle-id="@x.Id"
                                  style="cursor:pointer">
                                @(x.IsActive ? "Đang bán" : "Ngưng")
                            </span>
                        </td>

                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/Admin/Product/Detail/@x.Id">Chi tiết</a>

                           <a class="btn btn-sm btn-outline-primary"
   asp-area="Admin"
   asp-controller="Product"
   asp-action="Edit"
   asp-route-id="@x.Id"
   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
    Sửa
</a>


                         

                            <button class="btn btn-sm btn-outline-danger"
                                    type="button"
                                    data-delete-id="@x.Id">
                                Xóa
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small"
             data-current-page="@Model.Paged.Page">
            Trang @Model.Paged.Page / @Model.Paged.TotalPages — @Model.Paged.TotalItems dòng
        </div>

        @if (Model.Paged.TotalPages > 1)
        {
            var cur = Model.Paged.Page;
            var total = Model.Paged.TotalPages;

            var start = Math.Max(1, cur - 2);
            var end = Math.Min(total, cur + 2);

            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(cur == 1 ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(cur - 1)">«</a>
                    </li>

                    @for (int i = start; i <= end; i++)
                    {
                        <li class="page-item @(i == cur ? "active" : "")">
                            <a class="page-link" href="#" data-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(cur == total ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(cur + 1)">»</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
