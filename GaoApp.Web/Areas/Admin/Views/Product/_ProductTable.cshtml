@using GaoApp.Web.Areas.Admin.ViewModels.Products
@using GaoApp.Application.DTOs.Products
@using System.Text.Json
@model ProductIndexVM
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService LabelAuthorization

@{
    var canPrintLabels = (await LabelAuthorization.AuthorizeAsync(User, null, GaoApp.Application.Common.Security.PermissionCodes.System.ProductLabel.Print)).Succeeded;
    var canViewSupplier = (await LabelAuthorization.AuthorizeAsync(User, null, GaoApp.Application.Common.Security.PermissionCodes.Catalog.Supplier.View)).Succeeded;
    var priceJsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    string WholesaleLabel(ProductListItemDto product)
    {
        var units = product.SaleUnits.Where(x => x.IsBaseUnit && x.IsActive).ToList();
        if (units.Count == 0) return "Chưa có giá";
        if (units.All(x => !x.WholesalePrice.HasValue)) return "Theo giá lẻ";
        var prices = units.Select(x => x.WholesalePrice ?? x.RetailPrice).Where(x => x.HasValue).Select(x => x!.Value).ToList();
        if (prices.Count == 0) return "Chưa có giá";
        var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
        return prices.Min() == prices.Max() ? prices.Min().ToString("N0", vi) + " ₫" : prices.Min().ToString("N0", vi) + " – " + prices.Max().ToString("N0", vi) + " ₫";
    }
    var items = Model.Paged.Items;
    var totalItems = Model.Paged.TotalItems;
    var pageSize = Model.PageSize <= 0 ? 20 : Model.PageSize;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    var firstItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastItem = totalItems == 0 ? 0 : Math.Min(currentPage * pageSize, totalItems);
    var returnUrl = Url.Action(
        "Index",
        "Product",
        new
        {
            area = "Admin",
            search = Model.SearchString,
            categoryId = Model.CategoryId,
            supplierId = Model.Filters.SupplierId,
            brandId = Model.Filters.BrandId,
            baseUnitId = Model.Filters.BaseUnitId,
            dataIssue = Model.Filters.DataIssue,
            lifecycle = Model.Lifecycle,
            page = currentPage,
            pageSize
        }) ?? "/Admin/Product";
}

<div data-product-result
     data-current-page="@currentPage"
     data-total-pages="@totalPages"
     data-total-products="@Model.TotalProductCount"
     data-pos-allowed-products="@Model.PosAllowedProductCount"
     data-not-for-pos-products="@Model.NotForPosProductCount"
     data-inactive-products="@Model.InactiveProductCount">

    <section class="gds-list-panel" aria-label="Danh sách sản phẩm">
        @if (items == null || !items.Any())
        {
            <div class="gds-empty">
                <div class="gds-empty__icon" aria-hidden="true">
                    <i class="bx bx-package"></i>
                </div>
                <div class="fw-semibold mb-1">Chưa có sản phẩm phù hợp</div>
                <div class="gds-empty__copy">
                    Thử bỏ bớt bộ lọc hoặc chọn Tất cả trạng thái để tìm cả sản phẩm ngừng hoạt động.
                </div>
            </div>
        }
        else
        {
            <div class="gds-desktop-list">
                <div class="table-responsive">
                    <table class="table align-middle gds-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Đơn vị &amp; đơn giá</th>
                                <th class="text-center">Biến thể</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in items)
                            {
                                var stateLabel = !product.IsActive
                                    ? "Ngừng hoạt động"
                                    : product.IsSellable
                                        ? "Được phép bán POS"
                                        : "Chưa bán tại POS";
                                var stateClass = !product.IsActive
                                    ? "is-neutral"
                                    : product.IsSellable
                                        ? "is-success"
                                        : "is-warning";
                                var detailUrl = Url.Action(
                                    "Detail",
                                    "Product",
                                    new { area = "Admin", id = product.Id }) ?? $"/Admin/Product/Detail/{product.Id}";
                                var priceLabel = $"{product.BasePrice:n0} ₫";

                                <tr data-product-row
                                    tabindex="0"
                                    title="Nhấp đúp để xem nhanh"
                                    data-quick-name="@product.Name"
                                    data-quick-alias="@product.Alias"
                                    data-quick-brand="@product.BrandName"
                                    data-quick-category="@product.CategoryName"
                                    data-quick-supplier="@(canViewSupplier ? product.SupplierName : null)"
                                    data-quick-units="@JsonSerializer.Serialize(product.SaleUnits, priceJsonOptions)"
                                    data-quick-tax="@product.TaxName"
                                    data-quick-unit="@product.BaseUnitName"
                                    data-quick-price="@priceLabel"
                                    data-quick-variants="@product.VariantCount"
                                    data-quick-state="@stateLabel"
                                    data-quick-state-class="@stateClass"
                                    data-quick-image="@product.PrimaryImageUrl"
                                    data-quick-detail-url="@detailUrl">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <button type="button"
                                                    class="avatar avatar-lg rounded bg-label-secondary flex-shrink-0 overflow-hidden border-0 p-0 js-product-image js-quick-view"
                                                    aria-label="Phóng ảnh và xem nhanh sản phẩm @product.Name"
                                                    title="Phóng ảnh và xem nhanh">
                                                @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl))
                                                {
                                                    <img src="@product.PrimaryImageUrl"
                                                         alt="Ảnh sản phẩm @product.Name"
                                                         class="w-100 h-100 rounded"
                                                         style="object-fit: cover;"
                                                         loading="lazy" />
                                                }
                                                else
                                                {
                                                    <i class="bx bx-image fs-4" aria-hidden="true"></i>
                                                }
                                            </button>

                                            <div class="min-w-0">
                                                <div class="fs-6 fw-bold text-dark lh-sm">@product.Name</div>
                                                <div class="gds-code mt-1 text-truncate">@product.Alias</div>
                                                @if (!string.IsNullOrWhiteSpace(product.BrandName))
                                                {
                                                    <div class="gds-table__secondary text-truncate mt-1">
                                                        <i class="bx bx-purchase-tag-alt me-1" aria-hidden="true"></i>@product.BrandName
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">
                                            @(string.IsNullOrWhiteSpace(product.CategoryName) ? "—" : product.CategoryName)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @(string.IsNullOrWhiteSpace(product.BaseUnitName) ? "—" : product.BaseUnitName)
                                        </div>
                                        <div class="fw-bold text-primary fs-6 mt-1">
                                            Giá lẻ: @priceLabel
                                        </div>
                                        <div class="fw-semibold mt-1 product-wholesale-price">Giá sỉ: @WholesaleLabel(product)</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="gds-code">@product.VariantCount</span>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="gds-status gds-status--dot gds-status-button js-toggle-status @stateClass"
                                                data-id="@product.Id"
                                                data-name="@product.Name"
                                                data-status="@product.IsActive.ToString().ToLowerInvariant()"
                                                aria-label="@(product.IsActive ? $"Ngừng hoạt động sản phẩm {product.Name}" : $"Kích hoạt lại sản phẩm {product.Name}")"
                                                title="@(product.IsActive ? "Bấm để ngừng hoạt động" : "Bấm để kích hoạt lại")"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top">
                                            @stateLabel
                                        </button>
                                    </td>
                                    <td class="text-end">
                                        <div class="gds-row-actions justify-content-end">
                                            @if (canPrintLabels)
                                            {
                                                <a href="/admin/label-printing?tab=quick&amp;productId=@product.Id" class="gds-icon-button gds-action-button" title="In tem" aria-label="In tem @product.Name"><i class="bx bx-barcode" aria-hidden="true"></i></a>
                                            }
                                            <button type="button"
                                               class="gds-icon-button gds-action-button js-quick-view"
                                               aria-label="Xem nhanh sản phẩm @product.Name"
                                               title="Xem nhanh"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top">
                                                <i class="bx bx-show" aria-hidden="true"></i>
                                            </button>

                                            <a asp-area="Admin"
                                               asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               asp-route-returnUrl="@returnUrl"
                                               class="gds-icon-button gds-action-button"
                                               aria-label="Mở sản phẩm @product.Name"
                                               title="Mở sản phẩm"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top">
                                                <i class="bx bx-edit" aria-hidden="true"></i>
                                            </a>

                                            <button type="button"
                                                    class="gds-icon-button gds-action-button is-danger js-delete"
                                                    data-id="@product.Id"
                                                    data-name="@product.Name"
                                                    aria-label="Xóa sản phẩm @product.Name"
                                                    title="Xóa"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top">
                                                <i class="bx bx-trash" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="gds-mobile-list" aria-label="Danh sách sản phẩm trên thiết bị di động">
                @foreach (var product in items)
                {
                    var stateLabel = !product.IsActive
                        ? "Ngừng hoạt động"
                        : product.IsSellable
                            ? "Được phép bán POS"
                            : "Chưa bán tại POS";
                    var stateClass = !product.IsActive
                        ? "is-neutral"
                        : product.IsSellable
                            ? "is-success"
                            : "is-warning";
                    var detailUrl = Url.Action(
                        "Detail",
                        "Product",
                        new { area = "Admin", id = product.Id }) ?? $"/Admin/Product/Detail/{product.Id}";
                    var priceLabel = $"{product.BasePrice:n0} ₫";

                    <article class="gds-row-card"
                             data-product-row
                             tabindex="0"
                             title="Nhấp đúp để xem nhanh"
                             data-quick-name="@product.Name"
                             data-quick-alias="@product.Alias"
                             data-quick-brand="@product.BrandName"
                             data-quick-category="@product.CategoryName"
                             data-quick-supplier="@(canViewSupplier ? product.SupplierName : null)"
                             data-quick-units="@JsonSerializer.Serialize(product.SaleUnits, priceJsonOptions)"
                             data-quick-tax="@product.TaxName"
                             data-quick-unit="@product.BaseUnitName"
                             data-quick-price="@priceLabel"
                             data-quick-variants="@product.VariantCount"
                             data-quick-state="@stateLabel"
                             data-quick-state-class="@stateClass"
                             data-quick-image="@product.PrimaryImageUrl"
                             data-quick-detail-url="@detailUrl">
                        <div class="gds-row-card__header">
                            <div class="d-flex align-items-center gap-3 min-w-0">
                                <button type="button"
                                        class="avatar avatar-lg rounded bg-label-secondary flex-shrink-0 overflow-hidden border-0 p-0 js-product-image js-quick-view"
                                        aria-label="Phóng ảnh và xem nhanh sản phẩm @product.Name">
                                    @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl))
                                    {
                                        <img src="@product.PrimaryImageUrl"
                                             alt="Ảnh sản phẩm @product.Name"
                                             class="w-100 h-100 rounded"
                                             style="object-fit: cover;"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bx bx-image fs-4" aria-hidden="true"></i>
                                    }
                                </button>

                                <div class="min-w-0">
                                    <div class="gds-row-card__title fs-6 fw-bold text-dark">@product.Name</div>
                                    <div class="gds-code mt-1 text-truncate">@product.Alias</div>
                                    @if (!string.IsNullOrWhiteSpace(product.BrandName))
                                    {
                                        <div class="gds-table__secondary text-truncate">@product.BrandName</div>
                                    }
                                </div>
                            </div>

                            <button type="button"
                                    class="gds-status gds-status--dot gds-status-button js-toggle-status @stateClass"
                                    data-id="@product.Id"
                                    data-name="@product.Name"
                                    data-status="@product.IsActive.ToString().ToLowerInvariant()"
                                    aria-label="@(product.IsActive ? $"Ngừng hoạt động sản phẩm {product.Name}" : $"Kích hoạt lại sản phẩm {product.Name}")">
                                @stateLabel
                            </button>
                        </div>

                        <div class="gds-row-card__meta row g-2">
                            <span class="col-6">
                                <i class="bx bx-category me-1" aria-hidden="true"></i>
                                @(string.IsNullOrWhiteSpace(product.CategoryName) ? "—" : product.CategoryName)
                            </span>
                            <span class="col-6">
                                <i class="bx bx-cube me-1" aria-hidden="true"></i>
                                @(string.IsNullOrWhiteSpace(product.BaseUnitName) ? "—" : product.BaseUnitName)
                            </span>
                            <span class="col-6">
                                <i class="bx bx-purchase-tag me-1" aria-hidden="true"></i>
                                <strong class="text-primary">Giá lẻ: @priceLabel</strong>
                                <strong class="d-block product-wholesale-price">Giá sỉ: @WholesaleLabel(product)</strong>
                            </span>
                            <span class="col-6">
                                <i class="bx bx-layer me-1" aria-hidden="true"></i>
                                @product.VariantCount biến thể
                            </span>
                        </div>

                        <div class="gds-row-card__actions">
                            <button type="button"
                                    class="btn btn-sm btn-label-primary gds-action-button js-quick-view">
                                <i class="bx bx-show me-1" aria-hidden="true"></i>Xem nhanh
                            </button>

                            @if (canPrintLabels)
                            {
                                <a href="/admin/label-printing?tab=quick&amp;productId=@product.Id" class="btn btn-sm btn-outline-primary gds-action-button"><i class="bx bx-barcode me-1"></i>In tem</a>
                            }
                            <a asp-area="Admin"
                               asp-controller="Product"
                               asp-action="Edit"
                               asp-route-id="@product.Id"
                               asp-route-returnUrl="@returnUrl"
                               class="btn btn-sm btn-primary gds-action-button flex-grow-1">
                                <i class="bx bx-edit me-1" aria-hidden="true"></i>Mở sản phẩm
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-label-danger gds-action-button js-delete"
                                    data-id="@product.Id"
                                    data-name="@product.Name">
                                <i class="bx bx-trash" aria-hidden="true"></i>
                                <span class="visually-hidden">Xóa @product.Name</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="gds-list-footer">
        <div class="gds-list-footer__summary">
            @if (totalItems == 0)
            {
                <span>0 kết quả</span>
            }
            else
            {
                <span><strong>@firstItem–@lastItem</strong> / @totalItems kết quả</span>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Phân trang danh sách sản phẩm">
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage - 1)"
                           aria-label="Trang trước">
                            <i class="bx bx-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>

                    @{
                        var start = Math.Max(1, currentPage - 3);
                        var end = Math.Min(totalPages, start + 6);
                        start = Math.Max(1, end - 6);
                    }

                    @for (var page = start; page <= end; page++)
                    {
                        <li class="page-item @(page == currentPage ? "active" : string.Empty)">
                            <a href="#"
                               class="page-link js-page-link"
                               data-page="@(page)"
                               aria-current="@(page == currentPage ? "page" : null)">@(page)</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                        <a href="#"
                           class="page-link js-page-link"
                           data-page="@(currentPage + 1)"
                           aria-label="Trang sau">
                            <i class="bx bx-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
