@using GaoApp.Web.Areas.Admin.ViewModels.Products
@model ProductIndexVM

<style>
    .product-table-wrap {
        padding: 0 22px 22px;
    }

    .product-table {
        margin-bottom: 0;
    }

        .product-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 900;
            border-bottom: 1px solid #e5e7eb;
            padding: 14px 12px;
            white-space: nowrap;
        }

        .product-table tbody td {
            padding: 16px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }

    .product-row:hover {
        background: #f8fafc;
    }

    .product-id {
        font-weight: 900;
        color: #64748b;
    }

    .product-thumb {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        overflow: hidden;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .product-thumb-empty {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
        color: #94a3b8;
        font-size: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #cbd5e1;
    }

    .product-name {
        font-weight: 900;
        color: #1f2937;
        line-height: 1.35;
    }

    .product-sub {
        margin-top: 4px;
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
    }

    .product-code-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 900;
        max-width: 210px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .product-category {
        font-weight: 800;
        color: #334155;
    }

    .product-unit {
        display: inline-flex;
        min-width: 46px;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-weight: 900;
    }

    .product-price {
        font-weight: 900;
        color: #0f172a;
        font-size: 16px;
    }

    .product-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        cursor: pointer;
        user-select: none;
    }

        .product-status.is-active {
            background: #dcfce7;
            color: #15803d;
        }

        .product-status.is-inactive {
            background: #e5e7eb;
            color: #475569;
        }

    .product-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
    }

        .product-actions .btn {
            border-radius: 10px;
            font-weight: 800;
        }

    .product-empty-state {
        padding: 58px 20px;
        text-align: center;
    }

    .product-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 24px;
        margin: 0 auto 16px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .product-empty-title {
        font-size: 20px;
        font-weight: 900;
        color: #334155;
    }

    .product-empty-text {
        color: #64748b;
        font-weight: 600;
        margin-top: 6px;
    }

    .product-pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 18px;
    }

    .product-pager-info {
        color: #64748b;
        font-weight: 700;
    }

    .product-pager .page-link {
        border-radius: 10px;
        margin: 0 2px;
        font-weight: 900;
    }

    @@media (max-width: 992px) {
        .product-table-wrap {
            padding: 0 12px 16px;
        }

        .product-table {
            min-width: 980px;
        }

        .product-pager {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

@if (Model.Paged.Items == null || !Model.Paged.Items.Any())
{
    <div class="product-empty-state" data-current-page="@Model.Paged.Page">
        <div class="product-empty-icon">
            <i class="bx bx-package"></i>
        </div>
        <div class="product-empty-title">Không có sản phẩm</div>
        <div class="product-empty-text">
            Thử đổi từ khóa tìm kiếm hoặc tạo sản phẩm mới.
        </div>
    </div>
}
else
{
    <div class="product-table-wrap">
        <div class="table-responsive">
            <table class="table align-middle product-table">
                <thead>
                    <tr>
                        <th style="width:80px;">Mã</th>
                        <th style="width:84px;">Ảnh</th>
                        <th>Sản phẩm</th>
                        <th style="width:230px;">Barcode / Alias</th>
                        <th style="width:150px;">Danh mục</th>
                        <th style="width:110px;" class="text-center">Đơn vị</th>
                        <th style="width:130px;" class="text-end">Giá</th>
                        <th style="width:130px;" class="text-center">Trạng thái</th>
                        <th style="width:250px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var x in Model.Paged.Items)
                    {
                        var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

                        <tr class="product-row">
                            <td>
                                <div class="product-id">#@x.Id</div>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(x.PrimaryImageUrl))
                                {
                                    <div class="product-thumb">
                                        <img src="@x.PrimaryImageUrl"
                                             alt="@x.Name"
                                             loading="lazy"
                                             onerror="this.closest('.product-thumb').outerHTML='<div class=&quot;product-thumb-empty&quot;><i class=&quot;bx bx-image&quot;></i></div>';" />
                                    </div>
                                }
                                else
                                {
                                    <div class="product-thumb-empty">
                                        <i class="bx bx-image"></i>
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="product-name">@x.Name</div>
                                <div class="product-sub">
                                    ID sản phẩm: @x.Id
                                </div>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(x.Alias))
                                {
                                    <span class="product-code-chip" title="@x.Alias">
                                        <i class="bx bx-barcode"></i>
                                        @x.Alias
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold">—</span>
                                }
                            </td>

                            <td>
                                <div class="product-category">
                                    @(string.IsNullOrWhiteSpace(x.CategoryName) ? "—" : x.CategoryName)
                                </div>
                            </td>

                            <td class="text-center">
                                <span class="product-unit">
                                    @(string.IsNullOrWhiteSpace(x.BaseUnitName) ? "—" : x.BaseUnitName)
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="product-price">@x.BasePrice.ToString("n0")</div>
                            </td>

                            <td class="text-center">
                                <span class="product-status @(x.IsActive ? "is-active" : "is-inactive")"
                                      role="button"
                                      title="Bấm để đổi trạng thái"
                                      data-toggle-id="@x.Id">
                                    <i class="bx @(x.IsActive ? "bx-check-circle" : "bx-pause-circle")"></i>
                                    @(x.IsActive ? "Đang bán" : "Ngưng")
                                </span>
                            </td>

                            <td>
                                <div class="product-actions">
                                    <a class="btn btn-sm btn-light border"
                                           href="/Admin/Product/Detail/@x.Id">
                                        <i class="bx bx-show me-1"></i>
                                        Chi tiết
                                    </a>

                                    <a class="btn btn-sm btn-outline-primary"
                                           asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@x.Id"
                                           asp-route-returnUrl="@returnUrl">
                                        <i class="bx bx-edit me-1"></i>
                                        Sửa
                                    </a>

                                    <button class="btn btn-sm btn-outline-danger"
                                            type="button"
                                            data-delete-id="@x.Id"
                                            data-product-name="@x.Name">
                                        <i class="bx bx-trash me-1"></i>
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="product-pager">
            <div class="product-pager-info"
                 data-current-page="@Model.Paged.Page">
                Trang @Model.Paged.Page / @Model.Paged.TotalPages
                · @Model.Paged.TotalItems dòng
            </div>

            @if (Model.Paged.TotalPages > 1)
            {
                var cur = Model.Paged.Page;
                var total = Model.Paged.TotalPages;

                var start = Math.Max(1, cur - 2);
                var end = Math.Min(total, cur + 2);

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(cur == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" data-page="@(cur - 1)">
                                <i class="bx bx-chevron-left"></i>
                            </a>
                        </li>

                        @if (start > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="#" data-page="1">1</a>
                            </li>

                            @if (start > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (int i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == cur ? "active" : "")">
                                <a class="page-link" href="#" data-page="@i">@i</a>
                            </li>
                        }

                        @if (end < total)
                        {
                            @if (end < total - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link" href="#" data-page="@total">@total</a>
                            </li>
                        }

                        <li class="page-item @(cur == total ? "disabled" : "")">
                            <a class="page-link" href="#" data-page="@(cur + 1)">
                                <i class="bx bx-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
}