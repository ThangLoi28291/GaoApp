@using GaoApp.Web.Areas.Admin.ViewModels.Products
@using Microsoft.AspNetCore.Mvc.Rendering
@model ProductVariantVM

<div class="vv-shell mt-3">
    <div class="vv-topbar">
        <div class="vv-topbar-left">
            <div class="vv-title">Biến thể sản phẩm</div>
            <div class="vv-step-help">Làm nhanh hơn bằng cách chọn thuộc tính, chọn biến thể và điền thông tin trong khối chi tiết.</div>
        </div>
        <div class="vv-topbar-actions">
            <div class="vv-top-badge">
                <span class="text-muted">Biến thể</span>
                <strong data-variant-count>0</strong>
            </div>
        </div>
    </div>

    <div class="vv-workspace">
        <section class="vv-panel vv-panel-left">
            <div class="vv-panel-head">
                <div class="vv-step-copy">
                    <span class="vv-step-badge">1</span>
                    <div>
                        <div class="vv-step-title">Nhóm thuộc tính</div>
                        <div class="vv-step-help">Chọn tổ hợp trước, nhấn “Tạo tổ hợp đã chọn”.</div>
                    </div>
                </div>
            </div>
            <div id="attrBox" class="vv-attr-grid"></div>
        </section>

        <section class="vv-panel vv-panel-center">
            <div class="vv-list-head">
                <div class="vv-step-copy">
                    <span class="vv-step-badge">2</span>
                    <div>
                        <div class="vv-step-title">Danh sách biến thể</div>
                        <div class="vv-step-help">Nhấp 1 dòng để chỉnh ở panel phải, bấm đúp để xem nhanh.</div>
                    </div>
                </div>
                <div class="vv-list-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm px-3" id="btnGenVariants">
                        Tạo tổ hợp đã chọn
                    </button>
                </div>
            </div>
            <div id="variantBody" class="vv-list-body">
                <div class="vv-empty">Chưa có biến thể</div>
            </div>
            <div class="vv-mobile-detail-cta">
                <button type="button" class="btn btn-outline-primary btn-sm w-100" id="btnOpenMobileVariantDetail">
                    Chi tiết biến thể đang chọn
                </button>
            </div>
        </section>

        <section class="vv-panel vv-panel-right">
            <div class="vv-panel-head">
                <div class="vv-step-copy">
                    <span class="vv-step-badge">3</span>
                    <div>
                        <div class="vv-step-title">Chi tiết biến thể</div>
                        <div class="vv-step-help">Chỉnh nhanh tên/SKU/giá vốn, trạng thái, ảnh, Barcode.</div>
                    </div>
                </div>
            </div>
            <div id="variantDetailPanel" class="vv-detail-panel">
                <div class="vv-empty">Chưa chọn biến thể</div>
            </div>
        </section>
    </div>

        <div class="vv-save-row">
            <button type="button" class="btn btn-primary px-4 py-2" id="btnSaveVariants">Lưu tất cả biến thể</button>
        </div>
</div>

<div class="vv-detail-sheet" id="variantDetailSheet" aria-hidden="true">
    <div class="vv-detail-sheet-inner">
        <div class="vv-detail-sheet-handle"></div>
        <div id="variantDetailSheetContent"></div>
        <div class="px-2 pb-2">
            <button type="button" class="btn btn-light w-100" id="btnCloseVariantDetailSheet">Đóng</button>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlVariantDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold">Xóa biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="vv-confirm-wrap">
                    <div class="vv-confirm-icon">!</div>
                    <div class="flex-grow-1">
                        <div class="fw-bold mb-2">Bạn có chắc muốn xóa biến thể này?</div>
                        <div class="vv-confirm-meta">
                            <div><span>SKU</span><b id="mdlVariantDeleteSku">-</b></div>
                            <div><span>Thuộc tính</span><b id="mdlVariantDeleteCombo">-</b></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" id="btnCancelDeleteVariant">Hủy</button>
                <button type="button" class="btn btn-danger px-3" id="btnConfirmDeleteVariant">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="spDeleteVariant"></span>
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlPickVariantImage" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold">Chọn ảnh cho biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="d-flex justify-content-end mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearVariantImage">
                        Bỏ chọn ảnh riêng
                    </button>
                </div>

                <div id="pickImgGrid" class="row g-2"></div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlVariantQuickView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold">Thông tin nhanh biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-0">
                <div id="variantQuickViewBody" class="vv-quick-view"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@{
    var unitConvVm = new ProductUnitConversionManageVm
    {
        Units = ((IEnumerable<SelectListItem>)(ViewBag.Units ?? new List<SelectListItem>()))
            .Select(x => new UnitOptionVm
            {
                Id = int.Parse(x.Value),
                Name = x.Text
            }).ToList(),

        BarcodeTypes = new List<BarcodeTypeOptionVm>
{
    new() { Value = 0, Name = "Nội bộ" },
    new() { Value = 1, Name = "Mã nhà sản xuất" },
    new() { Value = 2, Name = "Mã nhà cung cấp" },
    new() { Value = 3, Name = "Mã đóng gói" },
    new() { Value = 4, Name = "Mã hệ thống cũ" }
}
    };
}

@await Html.PartialAsync("_VariantUnitConversionsModal", unitConvVm)

<style>
    .vv-variant-item.is-invalid { border-color: #dc3545; }

    .vv-shell {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 14px 36px rgba(15,23,42,.05);
        overflow: hidden;
    }

    .vv-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: #fff;
    }

    .vv-topbar-left {
        display: grid;
        gap: 6px;
    }

    .vv-title {
        font-size: 1.25rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.15;
    }

    .vv-step-help {
        color: #64748b;
        font-size: .9rem;
    }

    .vv-topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vv-top-badge {
        border: 1px solid rgba(148,163,184,.26);
        border-radius: 999px;
        background: #f8fafc;
        padding: 8px 12px;
        color: #334155;
        font-weight: 700;
    }

        .vv-top-badge strong {
            font-size: 1.1rem;
            margin-left: 4px;
        }

    .vv-workspace {
        display: grid;
        grid-template-columns: minmax(280px, 1.1fr) minmax(320px, 1.3fr) minmax(300px, 1fr);
        gap: 14px;
        padding: 14px;
        background: #f9fbff;
    }

    .vv-panel {
        border: 1px solid rgba(148,163,184,.24);
        border-radius: 16px;
        background: #fff;
        min-height: 400px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(15,23,42,.04);
    }

    .vv-panel-head {
        padding: 10px 12px;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: #f8fafc;
    }

    .vv-step-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: flex-start;
    }

    .vv-step-copy {
        display: flex;
        gap: 10px;
    }

    .vv-step-badge {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #fff;
        flex: 0 0 auto;
    }

    .vv-step-title {
        font-size: 1rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .vv-step-help {
        color: #64748b;
        font-size: .86rem;
    }

    .vv-attr-grid {
        padding: 12px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .vv-attr-card {
        border: 1px solid rgba(148,163,184,.22);
        border-radius: 14px;
        background: #fff;
        padding: 12px;
    }

    .vv-attr-name {
        font-size: .96rem;
        font-weight: 800;
        color: #334155;
        margin-bottom: 10px;
    }

    .vv-chip-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .vv-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        min-height: 34px;
        border-radius: 999px;
        border: 1px solid rgba(148,163,184,.24);
        background: #fff;
        cursor: pointer;
        transition: all .15s ease;
        font-size: .86rem;
    }

        .vv-chip:hover {
            border-color: rgba(59,130,246,.4);
        }

        .vv-chip input {
            margin: 0;
        }

        .vv-chip.is-checked {
            border-color: rgba(59,130,246,.55);
            background: rgba(59,130,246,.08);
            box-shadow: 0 0 0 .16rem rgba(59,130,246,.08);
        }

    .vv-chip-dot {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: #93c5fd;
        display: inline-block;
    }

    .vv-chip.is-checked .vv-chip-dot {
        background: #2563eb;
    }

    .vv-chip-text {
        color: #334155;
        font-weight: 700;
        line-height: 1;
    }

    .vv-list-head {
        padding: 12px;
    }

    .vv-list-head .btn {
        border-radius: 10px;
        font-weight: 700;
    }

    .vv-list-body {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #fff;
        overflow: auto;
        flex: 1;
    }

    .vv-empty {
        border: 1px dashed rgba(148,163,184,.30);
        border-radius: 16px;
        padding: 26px 16px;
        text-align: center;
        color: #64748b;
        background: #fff;
        font-weight: 700;
    }

    .vv-variant-item {
        border: 1px solid #dbe2ea;
        border-radius: 14px;
        padding: 10px;
        background: #fff;
        cursor: pointer;
        transition: all .15s ease;
    }

        .vv-variant-item:hover {
            border-color: rgba(37,99,235,.35);
            box-shadow: 0 8px 20px rgba(15,23,42,.08);
        }

        .vv-variant-item.is-selected {
            border-color: #2563eb;
            box-shadow: 0 10px 24px rgba(37,99,235,.18);
            background: #f8fbff;
        }

    .vv-variant-item.is-invalid {
        border-color: #dc2626;
        box-shadow: 0 0 0 .16rem rgba(220,38,38,.12);
    }

    .vv-item-main {
        display: grid;
        grid-template-columns: 56px 1fr;
        gap: 10px;
        align-items: center;
    }

    .vv-item-body {
        min-width: 0;
    }

    .vv-variant-item-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-top: 2px;
    }

    .vv-variant-item-name {
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        font-size: 0.96rem;
    }

    .vv-variant-item-sku {
        color: #64748b;
        font-size: .88rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .vv-meta-label {
        color: #94a3b8;
        font-size: .74rem;
        font-weight: 700;
    }

    .vv-variant-item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 6px;
    }

    .vv-item-tag {
        font-size: .74rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #334155;
        border-radius: 999px;
        padding: 3px 8px;
        white-space: nowrap;
    }

    .vv-item-side {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin-top: 10px;
        align-items: flex-start;
    }

    .vv-item-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: stretch;
        min-width: 200px;
    }

    .vv-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .vv-item-meta-pill {
        font-size: .72rem;
        border-radius: 999px;
        padding: 3px 9px;
        border: 1px solid transparent;
        font-weight: 800;
        white-space: nowrap;
        line-height: 1.2;
    }

    .vv-item-meta-pill.ok {
        color: #166534;
        border-color: #86efac;
        background: #ecfdf5;
    }

    .vv-item-meta-pill.warn {
        color: #9a3412;
        border-color: #fdba74;
        background: #fff7ed;
    }

    .vv-item-meta-pill.soft {
        color: #334155;
        border-color: #dbeafe;
        background: #eff6ff;
    }

    .vv-item-side .btn {
        border-radius: 9px;
        font-size: .75rem;
        font-weight: 700;
        min-height: 32px;
    }

    .vv-item-note {
        font-size: .78rem;
        color: #64748b;
    }

    .vv-item-tag-wrap {
        margin-top: 6px;
        margin-bottom: 4px;
    }

    .vv-detail-panel {
        padding: 12px;
        display: grid;
        gap: 10px;
        flex: 1;
    }

    .vv-detail-card {
        border-radius: 14px;
        border: 1px solid #dbe2ea;
        background: #fff;
        padding: 10px;
    }

    .vv-detail-title {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: flex-start;
    }

    .vv-detail-title-text {
        font-size: 1rem;
        line-height: 1.35;
        color: #0f172a;
        font-weight: 900;
    }

    .vv-detail-image-wrap {
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 8px;
        display: flex;
        justify-content: center;
        background: #f8fafc;
    }

    .vv-field-row {
        display: grid;
        gap: 10px;
        grid-template-columns: 1fr 1fr;
    }

    .vv-field {
        display: grid;
        gap: 4px;
    }

    .vv-field-label {
        font-size: .78rem;
        color: #64748b;
        font-weight: 700;
    }

    .vv-input {
        border-radius: 10px !important;
        min-height: 36px;
        border-color: rgba(148,163,184,.34);
        font-weight: 700;
    }

    .vv-save-row {
        padding: 14px 20px 16px;
        border-top: 1px solid rgba(15,23,42,.06);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #fff;
    }

    .vv-thumb {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid rgba(0,0,0,.10);
        cursor: pointer;
        background: #fff;
    }

    .vv-actions {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
        flex-wrap: wrap;
        align-items: stretch;
    }

    .vv-actions .btn {
        border-radius: 10px;
        font-weight: 800;
        white-space: nowrap;
        min-height: 34px;
        padding: 0.34rem 0.72rem;
    }

    .vv-compact-btn {
        border-radius: 10px !important;
        min-height: 32px;
        padding: .30rem .62rem;
        line-height: 1.25;
    }

    .vv-unit-price-box {
        border: 1px dashed rgba(148,163,184,.55);
        border-radius: 12px;
        padding: 8px 10px;
        background: #f8fafc;
        font-size: .82rem;
    }

        .vv-unit-price-box > div {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .vv-unit-price-box span {
            color: #64748b;
            font-weight: 700;
        }

        .vv-unit-price-box b {
            color: #0f172a;
            font-weight: 900;
        }

        .vv-unit-price-box small {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-weight: 700;
        }

    .vv-mobile-detail-cta {
        display: none;
    }

    .vv-quick-view {
        display: grid;
        gap: 12px;
    }

    .vv-detail-actions {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-top: 4px;
        flex-wrap: wrap;
    }

    .vv-action-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px;
    }

    .vv-detail-summary {
        margin-bottom: 4px;
        display: grid;
        gap: 6px;
    }

    .vv-status-stack {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
    }

    .vv-status {
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        padding: 0.25rem 0.64rem;
        display: inline-flex;
        align-items: center;
    }

    .vv-status + .vv-status {
        border: 1px solid #e2e8f0;
        background: #fff;
    }

    @@media (max-width: 1200px) {
        .vv-workspace {
            grid-template-columns: minmax(260px, 1fr) minmax(320px, 1fr);
        }

        .vv-panel-right {
            grid-column: 1 / -1;
            min-height: 220px;
        }
    }

    @@media (max-width: 992px) {
        .vv-workspace {
            grid-template-columns: 1fr;
        }

        .vv-panel-right {
            display: none;
        }

        .vv-mobile-detail-cta {
            display: block;
            padding: 10px 12px;
        }

        .vv-panel-left,
        .vv-panel-center {
            min-height: auto;
        }

        .vv-field-row,
        .vv-action-grid {
            grid-template-columns: 1fr;
        }

        .vv-detail-title {
            align-items: center;
        }

        .vv-item-side {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .vv-item-actions {
            justify-content: flex-start;
            min-width: 0;
        }
    }

    .vv-detail-sheet {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: #fff;
        border-top-left-radius: 18px;
        border-top-right-radius: 18px;
        box-shadow: 0 -18px 40px rgba(15,23,42,.12);
        border: 1px solid rgba(15,23,42,.1);
        transform: translateY(110%);
        transition: transform .25s ease;
        z-index: 1100;
        padding-bottom: env(safe-area-inset-bottom);
    }

    .vv-detail-sheet.is-open {
        transform: translateY(0);
    }

    .vv-detail-sheet-inner {
        max-height: 70vh;
        overflow: auto;
        padding: 12px 12px 16px;
    }

    .vv-detail-sheet-handle {
        width: 44px;
        height: 6px;
        border-radius: 999px;
        margin: 8px auto 12px;
        background: #cbd5e1;
    }

    .vv-thumb {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid rgba(0,0,0,.10);
        cursor: pointer;
        background: #fff;
    }

    .vv-input {
        border-radius: 10px !important;
        min-height: 36px;
        border-color: rgba(148,163,184,.34);
        font-weight: 700;
    }

    .vv-name-input {
        min-width: 260px;
    }

    .vv-sku-input {
        min-width: 180px;
    }

    .vv-cost-input {
        width: 96px;
    }

    .vv-base-price-box {
        min-width: 116px;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 7px 9px;
        background: #f8fafc;
        font-size: 12px;
        line-height: 1.35;
    }

        .vv-base-price-box .unit {
            font-weight: 900;
            color: #334155;
            margin-bottom: 4px;
        }

        .vv-base-price-box .line {
            display: flex;
            justify-content: space-between;
            gap: 8px;
        }

        .vv-base-price-box span {
            color: #64748b;
            font-weight: 800;
        }

        .vv-base-price-box b {
            color: #0f172a;
            font-weight: 900;
        }

    .vv-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        max-width: 220px;
    }

    .vv-tag {
        min-height: 24px;
        padding: 4px 8px;
        border-radius: 999px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    @@media (max-width: 1100px) {
        .vv-variant-table {
            min-width: 1050px;
        }
    }

    .vv-confirm-wrap {
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

    .vv-confirm-icon {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(239,68,68,.10);
        color: #dc2626;
        font-weight: 900;
        font-size: 18px;
        flex: 0 0 auto;
    }

    .vv-confirm-meta {
        display: grid;
        gap: 8px;
    }

        .vv-confirm-meta div {
            display: grid;
            grid-template-columns: 78px 1fr;
            gap: 10px;
            font-size: .9rem;
        }

        .vv-confirm-meta span {
            color: #64748b;
            font-weight: 700;
        }

        .vv-confirm-meta b {
            color: #1e293b;
            word-break: break-word;
        }

    .pick-img-item {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.10);
        cursor: pointer;
        background: #fff;
        transition: all .12s ease;
    }

        .pick-img-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(15,23,42,.10);
        }

        .pick-img-item img {
            width: 100%;
            height: 104px;
            object-fit: cover;
            display: block;
        }

        .pick-img-item.is-selected {
            outline: 2px solid rgba(37,99,235,.70);
            outline-offset: 2px;
        }

    .pick-img-badge {
        position: absolute;
        left: 8px;
        bottom: 8px;
        background: rgba(37,99,235,.92);
        color: #fff;
        font-weight: 900;
        font-size: 11px;
        padding: 3px 7px;
        border-radius: 999px;
    }

    .img-zoom-preview {
        position: fixed;
        pointer-events: none;
        z-index: 9999;
        width: 240px;
        height: 240px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(0,0,0,.25);
        border: 1px solid rgba(0,0,0,.15);
        background: #fff;
        display: none;
    }

        .img-zoom-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    @@media (max-width: 1100px) {
        .vv-attr-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .vv-row {
            grid-template-columns: 56px 1fr;
        }

        .vv-side {
            grid-column: 1 / -1;
            align-items: flex-start;
        }

        .vv-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 767px) {
        .vv-topbar {
            flex-direction: column;
            align-items: stretch;
        }

        .vv-topbar-actions {
            justify-content: flex-start;
        }

        .vv-body {
            padding: 14px;
        }

        .vv-attr-grid {
            grid-template-columns: 1fr;
        }

        .vv-price-stack {
            grid-template-columns: 1fr;
        }

        .vv-field-row {
            grid-template-columns: 1fr;
        }

        .vv-detail-actions {
            flex-direction: column;
        }

        .vv-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    .vv-unit-price-box {
        border: 1px dashed rgba(148,163,184,.55);
        border-radius: 12px;
        padding: 8px 10px;
        background: #f8fafc;
        font-size: .82rem;
    }

        .vv-unit-price-box > div {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .vv-unit-price-box span {
            color: #64748b;
            font-weight: 700;
        }

        .vv-unit-price-box b {
            color: #0f172a;
            font-weight: 900;
        }

        .vv-unit-price-box small {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-weight: 700;
        }
</style>

<script>
    (() => {
        const productId = window.gaoProductCtx?.productId || @Model.ProductId;
        const defaultAlias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductAlias ?? string.Empty));
        const initialVariantSetup = window.gaoProductCtx?.initialVariantSetup === true;

        if (!productId) return;

        function token() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function slugifyVN(text) {
            if (!text) return '';
            return text.toString().trim().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                .replace(/-+/g, '-');
        }

        let ATTRS = [];
        const selectedMap = new Map();
        let variants = [];
        let freshDefaultReuseConsumed = false;
        let selectedVariantIdx = -1;
        let hasValidatedVariants = false;

        function hasValidCost(variant) {
            const cost = Number(variant.costPrice ?? 0);
            return Number.isFinite(cost) && cost > 0;
        }

        let PRODUCT_IMAGES = [];
        let _pickVariantIdx = null;
        let _productPrimaryUrl = '';

        async function loadProductImages() {
            if (PRODUCT_IMAGES.length) return PRODUCT_IMAGES;

            const res = await fetch(`/Admin/Product/ImagesData?productId=${productId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const json = await res.json().catch(() => null);

            PRODUCT_IMAGES = json?.data || [];
            const pri = PRODUCT_IMAGES.find(x => x.isPrimary) || PRODUCT_IMAGES[0];
            _productPrimaryUrl = pri?.url || '';

            return PRODUCT_IMAGES;
        }

        function openPickImageModal(variantIdx) {
            _pickVariantIdx = variantIdx;

            loadProductImages().then(() => {
                renderPickGrid();

                const modalEl = document.getElementById('mdlPickVariantImage');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl, {
                        backdrop: 'static',
                        keyboard: true
                    }).show();
                }
            });
        }

        function closePickImageModal() {
            const modalEl = document.getElementById('mdlPickVariantImage');
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getInstance(modalEl)?.hide();
            }
        }

        function renderPickGrid() {
            const grid = document.getElementById('pickImgGrid');
            if (!grid) return;

            grid.innerHTML = '';

            const current = variants?.[_pickVariantIdx];
            const selectedId = current?.primaryProductImageId ?? null;

            if (!PRODUCT_IMAGES.length) {
                grid.innerHTML = `<div class="text-muted">Sản phẩm chưa có ảnh.</div>`;
                return;
            }

            PRODUCT_IMAGES.forEach(img => {
                const col = document.createElement('div');
                col.className = 'col-4 col-md-3';

                const item = document.createElement('div');
                item.className = 'pick-img-item';
                if (selectedId && selectedId === img.id) item.classList.add('is-selected');

                item.innerHTML = `
                    <img src="${img.url}" alt="img"/>
                    ${img.isPrimary ? `<span class="pick-img-badge">CHÍNH</span>` : ``}
                `;

                item.addEventListener('click', async () => {
                    const v = variants[_pickVariantIdx];

                    v.primaryProductImageId = img.id;
                    v.primaryImageUrl = img.url;
                    renderVariants();

                    if (v.id) {
                        const res = await fetch('/Admin/Product/SetVariantImage', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': token()
                            },
                            body: JSON.stringify({
                                variantId: v.id,
                                primaryProductImageId: img.id
                            }),
                            credentials: 'same-origin'
                        });

                        const json = await res.json().catch(() => null);
                        if (json?.ok) toastr?.success(json.message || 'Đã lưu ảnh biến thể.');
                        else toastr?.error(json?.message || 'Lưu ảnh thất bại.');
                    } else {
                        toastr?.info('Biến thể mới chưa lưu.');
                    }

                    closePickImageModal();
                });

                col.appendChild(item);
                grid.appendChild(col);
            });
        }

        document.getElementById('btnClearVariantImage')?.addEventListener('click', async () => {
            if (_pickVariantIdx == null) return;
            const v = variants[_pickVariantIdx];

            v.primaryProductImageId = null;
            v.primaryImageUrl = '';
            renderVariants();

            if (v.id) {
                const res = await fetch('/Admin/Product/SetVariantImage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify({
                        variantId: v.id,
                        primaryProductImageId: null
                    }),
                    credentials: 'same-origin'
                });

                const json = await res.json().catch(() => null);
                if (json?.ok) toastr?.success('Đã bỏ ảnh riêng.');
                else toastr?.error(json?.message || 'Lưu thất bại.');
            }

            closePickImageModal();
        });

        function getCurrentProductName() {
            const txt = document.getElementById('txtName');
            return (txt?.value || '').trim();
        }

        function findValue(id) {
            for (const a of ATTRS) {
                const v = (a.values || []).find(x => x.id === id);
                if (v) {
                    return {
                        id: v.id,
                        name: v.name,
                        code: v.code,
                        attributeId: a.attributeId,
                        attributeName: a.attributeName,
                        sortOrder: a.sortOrder || 0
                    };
                }
            }
            return null;
        }

        function comboKey(ids) {
            return (ids || []).slice().sort((a, b) => a - b).join('-');
        }

        function buildSku(alias, valueIds) {
            const parts = (valueIds || [])
                .map(id => {
                    const v = findValue(id);
                    return v ? slugifyVN(v.name || '') : '';
                })
                .filter(Boolean);

            return slugifyVN([alias, ...parts].join('-'));
        }

        function buildVariantDisplayName(productName, valueIds) {
            productName = (productName || '').trim();
            if (!productName) return '';

            const parts = (valueIds || [])
                .map(id => findValue(id))
                .filter(Boolean)
                .sort((a, b) => {
                    if ((a.sortOrder || 0) !== (b.sortOrder || 0)) {
                        return (a.sortOrder || 0) - (b.sortOrder || 0);
                    }
                    return (a.attributeId || 0) - (b.attributeId || 0);
                })
                .map(x => {
                    const attrName = (x.attributeName || '').trim().toLowerCase();
                    const valueName = (x.name || '').trim();
                    return attrName && valueName ? `${attrName} ${valueName}` : valueName;
                })
                .filter(Boolean);

            if (!parts.length) return productName;
            return `${productName} ${parts.join(' ')}`.trim();
        }

        function normSku(s) {
            return (s || '').trim().toLowerCase();
        }

        function makeUniqueSku(baseSku, currentId = null) {
            baseSku = (baseSku || '').trim();
            if (!baseSku) return baseSku;

            const used = new Set(
                (variants || [])
                    .filter(x => (x.id ?? null) !== currentId)
                    .map(x => normSku(x.sku))
                    .filter(Boolean)
            );

            let sku = baseSku;
            if (!used.has(normSku(sku))) return sku;

            let i = 1;
            while (i < 5000) {
                const cand = `${baseSku}-${i}`;
                if (!used.has(normSku(cand))) return cand;
                i++;
            }
            return `${baseSku}-${Date.now()}`;
        }

        function renderAttrs() {
            const box = document.getElementById('attrBox');
            box.innerHTML = '';
            selectedMap.clear();

            ATTRS.forEach(a => {
                selectedMap.set(a.attributeId, new Set());

                const card = document.createElement('div');
                card.className = 'vv-attr-card';

                const title = document.createElement('div');
                title.className = 'vv-attr-name';
                title.textContent = a.attributeName;

                const wrap = document.createElement('div');
                wrap.className = 'vv-chip-wrap';

                (a.values || []).forEach(v => {
                    const lb = document.createElement('label');
                    lb.className = 'vv-chip';

                    const cb = document.createElement('input');
                    cb.type = 'checkbox';
                    cb.className = 'form-check-input js-attr-cb';
                    cb.dataset.attrId = a.attributeId;
                    cb.dataset.valueId = v.id;

                    const dot = document.createElement('span');
                    dot.className = 'vv-chip-dot';

                    const text = document.createElement('span');
                    text.className = 'vv-chip-text';
                    text.textContent = v.name;

                    lb.appendChild(cb);
                    lb.appendChild(dot);
                    lb.appendChild(text);

                    cb.addEventListener('change', () => {
                        lb.classList.toggle('is-checked', cb.checked);
                    });

                    wrap.appendChild(lb);
                });

                card.appendChild(title);
                card.appendChild(wrap);
                box.appendChild(card);
            });
        }

        document.getElementById('attrBox')?.addEventListener('change', function (e) {
            const cb = e.target.closest('.js-attr-cb');
            if (!cb) return;

            const attrId = parseInt(cb.dataset.attrId || '0');
            const valueId = parseInt(cb.dataset.valueId || '0');
            if (!attrId || !valueId) return;

            let set = selectedMap.get(attrId);
            if (!set) {
                set = new Set();
                selectedMap.set(attrId, set);
            }

            if (cb.checked) set.add(valueId);
            else set.delete(valueId);
        });

        let _deleteTarget = null;

        function setDeleteLoading(isLoading) {
            const sp = document.getElementById('spDeleteVariant');
            const btn = document.getElementById('btnConfirmDeleteVariant');
            const btnCancel = document.getElementById('btnCancelDeleteVariant');

            if (sp) sp.classList.toggle('d-none', !isLoading);
            if (btn) btn.disabled = isLoading;
            if (btnCancel) btnCancel.disabled = isLoading;
        }

        function openDeleteVariantModal(target) {
            _deleteTarget = target;

            document.getElementById('mdlVariantDeleteSku').textContent = target.sku || '(trống)';
            document.getElementById('mdlVariantDeleteCombo').textContent = target.comboText || '(không có)';

            const modalEl = document.getElementById('mdlVariantDelete');
            if (!window.bootstrap || !bootstrap.Modal) {
                if (confirm('Xóa biến thể này?')) {
                    document.getElementById('btnConfirmDeleteVariant')?.click();
                }
                return;
            }

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
                backdrop: 'static',
                keyboard: true
            });
            modal.show();
        }

        function renderComboTags(ids) {
            const items = (ids || [])
                .map(id => {
                    const val = findValue(id);
                    if (!val) return null;
                    const an = (val.attributeName || '').trim();
                    const vn = (val.name || '').trim();
                    return an ? `${an}: ${vn}` : vn;
                })
                .filter(Boolean);

            if (!items.length) return '';
            return `<div class="vv-tags">${items.map(x => `<span class="vv-tag">${x}</span>`).join('')}</div>`;
        }
            function escapeHtml(value) {
        return (value ?? '')
            .toString()
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function money(value) {
        if (value === null || value === undefined || value === '') return '—';

        const n = Number(value);
        if (!Number.isFinite(n)) return '—';

        return n.toLocaleString('vi-VN');
    }
    function publishVariantState() {
        const persisted = (variants || []).filter(v => !!v.id);
        const hasSellingUnit = persisted.some(v => Number(v.unitConversionCount || 0) > 0);
        const hasRetailPrice = persisted.some(v => Number(v.baseUnitPrice || 0) > 0);
        const hasActiveBarcode = persisted.some(v => Number(v.activeBarcodeCount || 0) > 0);

        document.querySelectorAll('[data-variant-count]').forEach(element => {
            element.textContent = String((variants || []).length);
        });

        window.dispatchEvent(new CustomEvent('gao:product-variants-state', {
            detail: {
                variantCount: (variants || []).length,
                persistedCount: persisted.length,
                hasRetailPrice: hasRetailPrice,
                hasSellingUnit: hasSellingUnit,
                hasActiveBarcode: hasActiveBarcode
            }
        }));
    }

    function formatUnitMeta(v) {
        const unitCount = Number(v.unitConversionCount || 0);
        const activeBarcodeCount = Number(v.activeBarcodeCount || 0);

        const unitText = unitCount > 0
            ? `Đơn vị: ${unitCount}`
            : 'Chưa có đơn vị';
        const barcodeText = activeBarcodeCount > 0
            ? `Barcode: ${activeBarcodeCount}`
            : 'Chưa có barcode';

        const unitClass = unitCount > 0 ? 'ok' : 'warn';
        const barcodeClass = activeBarcodeCount > 0 ? 'ok' : 'warn';

        return `<div class="vv-item-meta">
            <span class="vv-item-meta-pill ${unitClass}">${escapeHtml(unitText)}</span>
            <span class="vv-item-meta-pill ${barcodeClass}">${escapeHtml(barcodeText)}</span>
            ${v.baseUnitName ? `<span class="vv-item-meta-pill soft">Mặc định: ${escapeHtml(v.baseUnitName)}</span>` : ''}
            ${v.baseUnitPrice > 0 ? `<span class="vv-item-meta-pill soft">Giá lẻ: ${money(v.baseUnitPrice)}</span>` : ''}
        </div>`;
    }

    function renderComboText(v) {
        return (v.attributeValueIds || [])
            .map(id => {
                const val = findValue(id);
                if (!val) return id;
                const an = (val.attributeName || '').trim();
                const vn = (val.name || '').trim();
                return an ? `${an}: ${vn}` : vn;
            })
            .join(' | ');
    }

    function setSelectedVariant(idx, opts = {}) {
        const list = variants || [];
        if (!list.length) {
            selectedVariantIdx = -1;
            renderVariantInspector();
            return;
        }

        const target = Number.isInteger(idx) ? idx : Number(idx);
        let next = Number.isFinite(target) ? target : 0;
        if (next < 0) next = 0;
        if (next >= list.length) next = list.length - 1;
        selectedVariantIdx = next;

        renderVariantDetailSelection();
        renderVariantInspector();

        if (!opts.silent && opts.showInMobile && window.innerWidth <= 992) {
            const sheet = document.getElementById('variantDetailSheet');
            sheet?.classList.add('is-open');
            sheet?.setAttribute('aria-hidden', 'false');
        }
    }

    function renderVariantDetailSelection() {
        const body = document.getElementById('variantBody');
        if (!body) return;

        body.querySelectorAll('.vv-variant-item').forEach((item, idx) => {
            item.classList.toggle('is-selected', idx === selectedVariantIdx);
        });
    }

    function getVariantTagBadges(v) {
        const items = (v.attributeValueIds || [])
            .map(id => {
                const val = findValue(id);
                if (!val) return null;
                const an = (val.attributeName || '').trim();
                const vn = (val.name || '').trim();
                return an ? `${an}: ${vn}` : vn;
            })
            .filter(Boolean);

        if (!items.length) return '<span class="vv-item-tag">Chưa có thuộc tính</span>';
        return `<div class="vv-variant-item-tags">${items.slice(0, 3).map(x => `<span class="vv-item-tag">${escapeHtml(x)}</span>`).join('')}${items.length > 3 ? '<span class="vv-item-tag">...</span>' : ''}</div>`;
    }

    function renderVariantInspector() {
        const panel = document.getElementById('variantDetailPanel');
        const sheetBody = document.getElementById('variantDetailSheetContent');
        const v = variants?.[selectedVariantIdx];

        if (!v) {
            const emptyHtml = `<div class="vv-empty">Chưa chọn biến thể để chỉnh.</div>`;
            if (panel) panel.innerHTML = emptyHtml;
            if (sheetBody) sheetBody.innerHTML = emptyHtml;
            return;
        }

        const isLocked = !!v.isLocked;
        const isActive = !!(v.isActive ?? true);
        const hasInputInvoice = !!v.hasInputInvoice;
        const delBtn = !isLocked
            ? `<button type="button" class="btn btn-sm vv-compact-btn btn-outline-danger js-detail-delete" data-idx="${selectedVariantIdx}"><i class="bx bx-trash me-1"></i>Xóa biến thể</button>`
            : `<button type="button" class="btn btn-sm vv-compact-btn btn-outline-secondary" disabled>Không thể xóa</button>`;
        const unitConversionDisabled = !v.id;

            const html = `
            <div class="vv-detail-card">
                <div class="vv-detail-title">
                    <span class="vv-detail-title-text">${escapeHtml((v.productVariantName || 'Biến thể mới').trim())}</span>
                    <button type="button" class="btn btn-outline-primary btn-sm vv-compact-btn js-inspector-open-quick-view" data-idx="${selectedVariantIdx}">
                        <i class="bx bx-search-alt me-1"></i>Xem nhanh
                    </button>
                </div>
                <div class="vv-detail-image-wrap">
                    <img class="vv-thumb js-detail-pick-img" data-idx="${selectedVariantIdx}" src="${v.primaryImageUrl || _productPrimaryUrl || '/img/placeholder.png'}" alt="Ảnh biến thể" />
                </div>
            </div>

            <div class="vv-detail-card">
                <div class="vv-field">
                    <label class="vv-field-label">Tên hiển thị</label>
                    <input class="form-control form-control-sm vv-input js-detail-name"
                           value="${escapeHtml(v.productVariantName || '')}"
                           data-idx="${selectedVariantIdx}">
                </div>
                <div class="vv-field-row">
                    <div class="vv-field">
                        <label class="vv-field-label">SKU</label>
                        <input class="form-control form-control-sm vv-input js-detail-sku"
                               value="${escapeHtml(v.sku || '')}"
                               data-idx="${selectedVariantIdx}"
                               ${isLocked ? 'readonly' : ''}>
                        ${isLocked ? '<div class="vv-item-note">SKU đã khóa</div>' : ''}
                    </div>
                    <div class="vv-field">
                        <label class="vv-field-label">Giá vốn</label>
                        <input type="number" min="0" step="1000"
                               class="form-control form-control-sm vv-input text-end js-detail-cost ${hasValidatedVariants && !hasValidCost(v) ? 'is-invalid' : ''}"
                               aria-label="Giá vốn" aria-invalid="${hasValidatedVariants && !hasValidCost(v)}" required
                               value="${v.costPrice ?? 0}"
                               data-idx="${selectedVariantIdx}">
                        <div class="invalid-feedback js-detail-cost-feedback">Nhập giá vốn lớn hơn 0 đ trước khi lưu.</div>
                    </div>
                </div>

                <div class="vv-field">
                    <label class="vv-field-label">Biến thể</label>
                    <div class="vv-item-note">${escapeHtml(renderComboText(v) || 'Chưa có thuộc tính')}</div>
                </div>

                <div class="vv-unit-price-box">
                    <div class="unit">${escapeHtml(v.baseUnitName || 'Đơn vị gốc')}</div>
                    <div class="line">
                        <span>Giá bán lẻ</span><b>${money(v.baseUnitPrice)}</b>
                    </div>
                    <div class="line">
                        <span>Giá bán sỉ</span><b>${money(v.baseUnitWholesalePrice)}</b>
                    </div>
                    <small>Chỉ đọc tại khối biến thể.</small>
                </div>

