<script>
    (() => {
        const productId = window.gaoProductCtx?.productId || @Model.ProductId;
        const defaultAlias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductAlias ?? string.Empty));

        if (!productId) return;

        function token() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function slugifyVN(text) {
            if (!text) return '';
            return text.toString().trim().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                .replace(/-+/g, '-');
        }

        let ATTRS = [];
        const selectedMap = new Map();
        let variants = [];

        let PRODUCT_IMAGES = [];
        let _pickVariantIdx = null;
        let _productPrimaryUrl = '';

        async function loadProductImages() {
            if (PRODUCT_IMAGES.length) return PRODUCT_IMAGES;

            const res = await fetch(`/Admin/Product/ImagesData?productId=${productId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const json = await res.json().catch(() => null);

            PRODUCT_IMAGES = json?.data || [];
            const pri = PRODUCT_IMAGES.find(x => x.isPrimary) || PRODUCT_IMAGES[0];
            _productPrimaryUrl = pri?.url || '';

            return PRODUCT_IMAGES;
        }

        function openPickImageModal(variantIdx) {
            _pickVariantIdx = variantIdx;

            loadProductImages().then(() => {
                renderPickGrid();

                const modalEl = document.getElementById('mdlPickVariantImage');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl, {
                        backdrop: 'static',
                        keyboard: true
                    }).show();
                }
            });
        }

        function closePickImageModal() {
            const modalEl = document.getElementById('mdlPickVariantImage');
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getInstance(modalEl)?.hide();
            }
        }

        function renderPickGrid() {
            const grid = document.getElementById('pickImgGrid');
            if (!grid) return;

            grid.innerHTML = '';

            const current = variants?.[_pickVariantIdx];
            const selectedId = current?.primaryProductImageId ?? null;

            if (!PRODUCT_IMAGES.length) {
                grid.innerHTML = `<div class="text-muted">Sản phẩm chưa có ảnh.</div>`;
                return;
            }

            PRODUCT_IMAGES.forEach(img => {
                const col = document.createElement('div');
                col.className = 'col-4 col-md-3';

                const item = document.createElement('div');
                item.className = 'pick-img-item';
                if (selectedId && selectedId === img.id) item.classList.add('is-selected');

                item.innerHTML = `
                    <img src="${img.url}" alt="img"/>
                    ${img.isPrimary ? `<span class="pick-img-badge">CHÍNH</span>` : ``}
                `;

                item.addEventListener('click', async () => {
                    const v = variants[_pickVariantIdx];

                    v.primaryProductImageId = img.id;
                    v.primaryImageUrl = img.url;
                    renderVariants();

                    if (v.id) {
                        const res = await fetch('/Admin/Product/SetVariantImage', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': token()
                            },
                            body: JSON.stringify({
                                variantId: v.id,
                                primaryProductImageId: img.id
                            }),
                            credentials: 'same-origin'
                        });

                        const json = await res.json().catch(() => null);
                        if (json?.ok) toastr?.success(json.message || 'Đã lưu ảnh biến thể.');
                        else toastr?.error(json?.message || 'Lưu ảnh thất bại.');
                    } else {
                        toastr?.info('Biến thể mới chưa lưu.');
                    }

                    closePickImageModal();
                });

                col.appendChild(item);
                grid.appendChild(col);
            });
        }

        document.getElementById('btnClearVariantImage')?.addEventListener('click', async () => {
            if (_pickVariantIdx == null) return;
            const v = variants[_pickVariantIdx];

            v.primaryProductImageId = null;
            v.primaryImageUrl = '';
            renderVariants();

            if (v.id) {
                const res = await fetch('/Admin/Product/SetVariantImage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify({
                        variantId: v.id,
                        primaryProductImageId: null
                    }),
                    credentials: 'same-origin'
                });

                const json = await res.json().catch(() => null);
                if (json?.ok) toastr?.success('Đã bỏ ảnh riêng.');
                else toastr?.error(json?.message || 'Lưu thất bại.');
            }

            closePickImageModal();
        });

        function getCurrentProductName() {
            const txt = document.getElementById('txtName');
            return (txt?.value || '').trim();
        }

        function findValue(id) {
            for (const a of ATTRS) {
                const v = (a.values || []).find(x => x.id === id);
                if (v) {
                    return {
                        id: v.id,
                        name: v.name,
                        code: v.code,
                        attributeId: a.attributeId,
                        attributeName: a.attributeName,
                        sortOrder: a.sortOrder || 0
                    };
                }
            }
            return null;
        }

        function comboKey(ids) {
            return (ids || []).slice().sort((a, b) => a - b).join('-');
        }

        function buildSku(alias, valueIds) {
            const parts = (valueIds || [])
                .map(id => {
                    const v = findValue(id);
                    return v ? slugifyVN(v.name || '') : '';
                })
                .filter(Boolean);

            return slugifyVN([alias, ...parts].join('-'));
        }

        function buildVariantDisplayName(productName, valueIds) {
            productName = (productName || '').trim();
            if (!productName) return '';

            const parts = (valueIds || [])
                .map(id => findValue(id))
                .filter(Boolean)
                .sort((a, b) => {
                    if ((a.sortOrder || 0) !== (b.sortOrder || 0)) {
                        return (a.sortOrder || 0) - (b.sortOrder || 0);
                    }
                    return (a.attributeId || 0) - (b.attributeId || 0);
                })
                .map(x => {
                    const attrName = (x.attributeName || '').trim().toLowerCase();
                    const valueName = (x.name || '').trim();
                    return attrName && valueName ? `${attrName} ${valueName}` : valueName;
                })
                .filter(Boolean);

            if (!parts.length) return productName;
            return `${productName} ${parts.join(' ')}`.trim();
        }

        function normSku(s) {
            return (s || '').trim().toLowerCase();
        }

        function makeUniqueSku(baseSku, currentId = null) {
            baseSku = (baseSku || '').trim();
            if (!baseSku) return baseSku;

            const used = new Set(
                (variants || [])
                    .filter(x => (x.id ?? null) !== currentId)
                    .map(x => normSku(x.sku))
                    .filter(Boolean)
            );

            let sku = baseSku;
            if (!used.has(normSku(sku))) return sku;

            let i = 1;
            while (i < 5000) {
                const cand = `${baseSku}-${i}`;
                if (!used.has(normSku(cand))) return cand;
                i++;
            }
            return `${baseSku}-${Date.now()}`;
        }

        function renderAttrs() {
            const box = document.getElementById('attrBox');
            box.innerHTML = '';
            selectedMap.clear();

            ATTRS.forEach(a => {
                selectedMap.set(a.attributeId, new Set());

                const card = document.createElement('div');
                card.className = 'vv-attr-card';

                const title = document.createElement('div');
                title.className = 'vv-attr-name';
                title.textContent = a.attributeName;

                const wrap = document.createElement('div');
                wrap.className = 'vv-chip-wrap';

                (a.values || []).forEach(v => {
                    const lb = document.createElement('label');
                    lb.className = 'vv-chip';

                    const cb = document.createElement('input');
                    cb.type = 'checkbox';
                    cb.className = 'form-check-input js-attr-cb';
                    cb.dataset.attrId = a.attributeId;
                    cb.dataset.valueId = v.id;

                    const dot = document.createElement('span');
                    dot.className = 'vv-chip-dot';

                    const text = document.createElement('span');
                    text.className = 'vv-chip-text';
                    text.textContent = v.name;

                    lb.appendChild(cb);
                    lb.appendChild(dot);
                    lb.appendChild(text);

                    cb.addEventListener('change', () => {
                        lb.classList.toggle('is-checked', cb.checked);
                    });

                    wrap.appendChild(lb);
                });

                card.appendChild(title);
                card.appendChild(wrap);
                box.appendChild(card);
            });
        }

        document.getElementById('attrBox')?.addEventListener('change', function (e) {
            const cb = e.target.closest('.js-attr-cb');
            if (!cb) return;

            const attrId = parseInt(cb.dataset.attrId || '0');
            const valueId = parseInt(cb.dataset.valueId || '0');
            if (!attrId || !valueId) return;

            let set = selectedMap.get(attrId);
            if (!set) {
                set = new Set();
                selectedMap.set(attrId, set);
            }

            if (cb.checked) set.add(valueId);
            else set.delete(valueId);
        });

        let _deleteTarget = null;

        function setDeleteLoading(isLoading) {
            const sp = document.getElementById('spDeleteVariant');
            const btn = document.getElementById('btnConfirmDeleteVariant');
            const btnCancel = document.getElementById('btnCancelDeleteVariant');

            if (sp) sp.classList.toggle('d-none', !isLoading);
            if (btn) btn.disabled = isLoading;
            if (btnCancel) btnCancel.disabled = isLoading;
        }

        function openDeleteVariantModal(target) {
            _deleteTarget = target;

            document.getElementById('mdlVariantDeleteSku').textContent = target.sku || '(trống)';
            document.getElementById('mdlVariantDeleteCombo').textContent = target.comboText || '(không có)';

            const modalEl = document.getElementById('mdlVariantDelete');
            if (!window.bootstrap || !bootstrap.Modal) {
                if (confirm('Xóa biến thể này?')) {
                    document.getElementById('btnConfirmDeleteVariant')?.click();
                }
                return;
            }

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
                backdrop: 'static',
                keyboard: true
            });
            modal.show();
        }

        function renderComboTags(ids) {
            const items = (ids || [])
                .map(id => {
                    const val = findValue(id);
                    if (!val) return null;
                    const an = (val.attributeName || '').trim();
                    const vn = (val.name || '').trim();
                    return an ? `${an}: ${vn}` : vn;
                })
                .filter(Boolean);

            if (!items.length) return '';
            return `<div class="vv-tags">${items.map(x => `<span class="vv-tag">${x}</span>`).join('')}</div>`;
        }
            function escapeHtml(value) {
        return (value ?? '')
            .toString()
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function money(value) {
        if (value === null || value === undefined || value === '') return '—';

        const n = Number(value);
        if (!Number.isFinite(n)) return '—';

        return n.toLocaleString('vi-VN');
    }
          function renderVariants() {
        const tb = document.getElementById('variantBody');
        if (!tb) return;

        tb.innerHTML = '';

        if (!variants || !variants.length) {
            tb.innerHTML = `<div class="vv-empty">Chưa có biến thể</div>`;
            return;
        }

        const table = document.createElement('div');
        table.className = 'table-responsive';

        table.innerHTML = `
            <table class="vv-variant-table">
                <thead>
                    <tr>
                        <th style="width:64px;">Ảnh</th>
                        <th>Tên hiển thị</th>
                        <th>SKU</th>
                        <th class="text-end">Giá vốn</th>
                        <th>Giá gốc</th>
                        <th>Thuộc tính</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="variantTableRows"></tbody>
            </table>
        `;

        tb.appendChild(table);

        const body = table.querySelector('#variantTableRows');

        (variants || []).forEach((v, idx) => {
            const isLocked = !!v.isLocked;
            const isActive = (v.isActive ?? true);
            const hasInputInvoice = !!v.hasInputInvoice;

            const comboText = (v.attributeValueIds || [])
                .map(id => {
                    const val = findValue(id);
                    if (!val) return id;
                    const an = (val.attributeName || '').trim();
                    const vn = (val.name || '').trim();
                    return an ? `${an}: ${vn}` : vn;
                })
                .join(' | ');

            const statusBtn = isActive
                ? `<button type="button" class="btn btn-sm btn-outline-success vv-status js-toggle">Đang bán</button>`
                : `<button type="button" class="btn btn-sm btn-outline-secondary vv-status js-toggle">Ngưng</button>`;

            const inputInvoiceBtn = hasInputInvoice
                ? `<button type="button" class="btn btn-sm btn-outline-primary vv-status js-toggle-input-invoice">Có HĐ vào</button>`
                : `<button type="button" class="btn btn-sm btn-outline-dark vv-status js-toggle-input-invoice">Không HĐ vào</button>`;

            const delBtn = !isLocked
                ? `<button type="button" class="btn btn-sm btn-outline-danger js-del">Xóa</button>`
                : `<button type="button" class="btn btn-sm btn-outline-secondary" disabled>Xóa</button>`;

            const imgUrl = v.primaryImageUrl || _productPrimaryUrl || '';
            const rowName = (v.productVariantName || '').trim();

            const tr = document.createElement('tr');

            tr.innerHTML = `
                <td>
                    <img class="vv-thumb js-pick-img"
                         src="${imgUrl || '/img/placeholder.png'}"
                         title="Chọn ảnh"
                         data-idx="${idx}" />
                </td>

                <td>
                    <input class="form-control form-control-sm vv-input vv-name-input js-variant-name"
                           value="${escapeHtml(rowName)}"
                           placeholder="Tên hiển thị"
                           ${!isActive ? 'readonly' : ''}/>
                </td>

                <td>
                    <input class="form-control form-control-sm vv-input vv-sku-input js-sku"
                           value="${escapeHtml(v.sku || '')}"
                           ${isLocked ? 'readonly' : ''}/>
                    ${isLocked ? `<div class="vv-sku-lock">SKU đã khóa</div>` : ``}
                </td>

                <td class="text-end">
                    <input class="form-control form-control-sm text-end vv-input vv-cost-input js-cost"
                           type="number" step="1000" min="0"
                           value="${v.costPrice ?? 0}"
                           placeholder="Giá vốn"
                           ${!isActive ? 'readonly' : ''}/>
                </td>

                <td>
                    <div class="vv-base-price-box">
                        <div class="unit">${escapeHtml(v.baseUnitName || 'Đơn vị gốc')}</div>
                        <div class="line">
                            <span>Lẻ</span>
                            <b>${money(v.baseUnitPrice)}</b>
                        </div>
                        <div class="line">
                            <span>Sỉ</span>
                            <b>${money(v.baseUnitWholesalePrice)}</b>
                        </div>
                    </div>
                </td>

                <td>
                    ${renderComboTags(v.attributeValueIds || []) || '<span class="text-muted fw-bold">—</span>'}
                </td>

                <td>
                    <div class="vv-status-stack">
                        ${statusBtn}
                        ${inputInvoiceBtn}
                    </div>
                </td>

                <td>
                    <div class="vv-actions">
                        <button type="button" class="btn btn-sm btn-outline-info js-unit-conv">
                            Đơn vị & Barcode
                        </button>
                        ${delBtn}
                    </div>
                </td>
            `;

            tr.querySelector('.js-variant-name')?.addEventListener('blur', e => {
                const raw = (e.target.value || '').trim();
                v.productVariantName = raw;
                e.target.value = raw;
            });

            tr.querySelector('.js-sku')?.addEventListener('blur', e => {
                const raw = (e.target.value || '').trim();
                v.sku = raw;
                e.target.value = raw;
            });

            tr.querySelector('.js-cost')?.addEventListener('input', e => {
                v.costPrice = parseInt(e.target.value || '0');
                e.target.classList.remove('is-invalid');
            });

            tr.querySelector('.js-toggle')?.addEventListener('click', async () => {
                if (!v.id) {
                    v.isActive = !isActive;
                    renderVariants();
                    return;
                }

                await toggleVariantStatus(v.id);
                await loadVariants();
            });

            tr.querySelector('.js-toggle-input-invoice')?.addEventListener('click', () => {
                v.hasInputInvoice = !hasInputInvoice;
                renderVariants();
            });

            tr.querySelector('.js-del')?.addEventListener('click', () => {
                openDeleteVariantModal({
                    id: v.id ?? null,
                    idx: idx,
                    sku: (v.sku || '').trim(),
                    comboText: comboText
                });
            });

            tr.querySelector('.js-pick-img')?.addEventListener('click', () => {
                openPickImageModal(idx);
            });

            tr.querySelector('.js-unit-conv')?.addEventListener('click', () => {
                if (!window.GaoVariantUnitConversion) return;

                window.GaoVariantUnitConversion.open({
                    id: v.id,
                    sku: v.sku || '',
                    name: v.productVariantName || ''
                });
            });

            body.appendChild(tr);
        });
    }
      
        async function toggleVariantStatus(variantId) {
            const res = await fetch('/Admin/Product/ToggleVariantStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token()
                },
                body: JSON.stringify({ id: variantId }),
                credentials: 'same-origin'
            });

            const json = await res.json().catch(() => null);
            if (json?.ok) toastr?.success(json.message || 'Đã đổi trạng thái.');
            else toastr?.error(json?.message || 'Không thể đổi trạng thái.');
        }

        async function deleteVariant(variantId) {
            const res = await fetch('/Admin/Product/DeleteVariant', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token()
                },
                body: JSON.stringify({ id: variantId }),
                credentials: 'same-origin'
            });

            const json = await res.json().catch(() => null);
            if (json?.ok) toastr?.success(json.message || 'Đã xóa.');
            else toastr?.error(json?.message || 'Xóa thất bại.');
        }

        document.getElementById('btnConfirmDeleteVariant')?.addEventListener('click', async () => {
            if (!_deleteTarget) return;

            try {
                setDeleteLoading(true);

                if (!_deleteTarget.id) {
                    variants.splice(_deleteTarget.idx, 1);
                    renderVariants();
                    toastr?.success('Đã xóa biến thể.');
                } else {
                    await deleteVariant(_deleteTarget.id);
                    await loadVariants();
                }

                const modalEl = document.getElementById('mdlVariantDelete');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                }
            } catch (e) {
                toastr?.error('Xóa thất bại.');
            } finally {
                setDeleteLoading(false);
                _deleteTarget = null;
            }
        });

        function cartesian(groups) {
            const arrays = groups.map(g => g.valueIds);
            if (!arrays.length) return [];
            return arrays.reduce((acc, cur) => acc.flatMap(a => cur.map(b => a.concat([b]))), [[]]);
        }

        function genVariants() {
            const groups = [];
            for (const [attrId, set] of selectedMap.entries()) {
                if (set && set.size > 0) {
                    groups.push({ attrId, valueIds: Array.from(set) });
                }
            }

            if (!groups.length) {
                toastr?.error('Chọn ít nhất 1 giá trị thuộc tính.');
                return;
            }

            const alias = (document.getElementById('txtAlias')?.value || '').trim() || defaultAlias;
            if (!alias) {
                toastr?.error('Alias sản phẩm đang rỗng.');
                return;
            }

            const productName = getCurrentProductName();
            if (!productName) {
                toastr?.error('Hãy nhập tên sản phẩm trước.');
                return;
            }

            const combos = cartesian(groups);
            const existed = new Set((variants || []).map(x => comboKey(x.attributeValueIds || [])));

            combos.forEach(ids => {
                const key = comboKey(ids);
                if (existed.has(key)) return;

                const baseSku = buildSku(alias, ids);
                const finalSku = makeUniqueSku(baseSku, null);
                const generatedName = buildVariantDisplayName(productName, ids);

                variants.push({
                    id: null,
                    sku: finalSku,
                    productVariantName: generatedName,
                    costPrice: 0,
                    price: null,
                    isActive: true,
                    isLocked: false,
                    primaryProductImageId: null,
                    primaryImageUrl: '',
                    attributeValueIds: ids
                });

                existed.add(key);
            });

            renderVariants();
            toastr?.success('Đã tạo biến thể.');
        }

        async function loadAttrs() {
            const res = await fetch('/Admin/Product/AttributesData', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const json = await res.json().catch(() => null);
            ATTRS = json?.data || [];
            renderAttrs();
        }

        async function loadVariants() {
            await loadProductImages();

            const res = await fetch(`/Admin/Product/VariantsData?productId=${productId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const json = await res.json().catch(() => null);
            const raw = json?.data || [];

               variants = raw.map(v => {
        const img = PRODUCT_IMAGES.find(x => x.id === v.primaryProductImageId);
        return {
            ...v,
            productVariantName: v.productVariantName || '',
            hasInputInvoice: v.hasInputInvoice ?? false,
            primaryImageUrl: img?.url || ''
        };
    });

            renderVariants();
        }

        function markInvalid(el, ok) {
            if (!el) return;
            el.classList.toggle('is-invalid', !ok);
        }

        function validateVariantsBeforeSave() {
            document.querySelectorAll('#variantBody .is-invalid')
                .forEach(x => x.classList.remove('is-invalid'));

            let ok = true;

            const rows = document.querySelectorAll('#variantBody .vv-row');

            (variants || []).forEach((v, idx) => {
                const row = rows[idx];
                if (!row) return;

                const cost = parseInt(v.costPrice ?? 0);
                if (!(cost > 0)) {
                    ok = false;
                    markInvalid(row.querySelector('.js-cost'), false);
                }

                const sku = (v.sku || '').trim();
                if (!sku) {
                    ok = false;
                    markInvalid(row.querySelector('.js-sku'), false);
                }

                const variantName = (v.productVariantName || '').trim();
                if (!variantName) {
                    ok = false;
                    markInvalid(row.querySelector('.js-variant-name'), false);
                }
            });

            if (!ok) toastr?.error('Dữ liệu biến thể chưa hợp lệ.');
            return ok;
        }

        async function saveVariants() {
            const payload = {
                productId: productId,
                variants: (variants || []).map(v => ({
                    id: v.id ?? null,
                    sku: (v.sku || '').trim(),
                    productVariantName: (v.productVariantName || '').trim() || null,
                    costPrice: v.costPrice ?? 0,
                      // Giá bán không sửa ở bảng Variant nữa.
    // Giá lẻ/giá sỉ nằm ở ProductUnitConversion.
    price: v.price,
                      isActive: v.isActive ?? true,

    // PHASE 1:
    // Gửi cờ hóa đơn đầu vào về SaveVariants.
    hasInputInvoice: v.hasInputInvoice ?? false,

    isLocked: v.isLocked ?? false,
    primaryProductImageId: v.primaryProductImageId ?? null,
                    attributeValueIds: v.attributeValueIds || []
                }))
            };

            if (payload.variants.length === 0) {
                return { ok: true, message: 'Không có biến thể để lưu.' };
            }

            if (!validateVariantsBeforeSave()) {
                return { ok: false, message: 'Dữ liệu biến thể không hợp lệ.' };
            }

            const anti = token();
            if (!anti) {
                toastr?.error('Thiếu AntiForgeryToken.');
                return { ok: false, message: 'Thiếu AntiForgeryToken.' };
            }

            const res = await fetch('/Admin/Product/SaveVariants', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': anti
                },
                body: JSON.stringify(payload),
                credentials: 'same-origin'
            });

            const text = await res.text();
            let json = null;
            try { json = JSON.parse(text); } catch { }

            if (!res.ok) {
                toastr?.error(`HTTP ${res.status}`);
                return { ok: false, message: text || `HTTP ${res.status}` };
            }

            if (json?.ok) {
                toastr?.success(json.message || 'Lưu biến thể thành công.');
                await loadVariants();
                return { ok: true, message: json.message || 'OK' };
            }

            toastr?.error(json?.message || text || 'Thất bại');
            return { ok: false, message: json?.message || text || 'Thất bại' };
        }

        window.GaoVariant = {
            save: saveVariants,
            reload: loadVariants,
            hasAnyVariant: () => (variants?.length || 0) > 0
        };

        document.getElementById('btnGenVariants')?.addEventListener('click', genVariants);
        document.getElementById('btnSaveVariants')?.addEventListener('click', async () => {
            await saveVariants();
        });

        document.addEventListener('keydown', function (e) {
            const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
            const mod = isMac ? e.metaKey : e.ctrlKey;

            if (mod && (e.key === 's' || e.key === 'S')) {
                e.preventDefault();
                const btnSaveAll = document.getElementById('btnSaveAll');
                if (btnSaveAll) {
                    btnSaveAll.click();
                    return;
                }
                document.getElementById('btnSaveVariants')?.click();
                return;
            }

            if (e.key === 'F6') {
                e.preventDefault();
                const btnSaveAll = document.getElementById('btnSaveAll');
                if (btnSaveAll) {
                    btnSaveAll.click();
                    return;
                }
                document.getElementById('btnSaveVariants')?.click();
            }
        });

        (async function init() {
            await loadAttrs();
            await loadProductImages();
            await loadVariants();
        })();
    })();

    let _zoomEl = null;

    function ensureZoomEl() {
        if (_zoomEl) return _zoomEl;
        const el = document.createElement('div');
        el.className = 'img-zoom-preview';
        el.innerHTML = `<img src="" alt="zoom" />`;
        document.body.appendChild(el);
        _zoomEl = el;
        return el;
    }

    document.addEventListener('mouseover', (e) => {
        const img = e.target.closest('.vv-thumb');
        if (!img) return;

        const el = ensureZoomEl();
        el.querySelector('img').src = img.src;
        el.style.display = 'block';
    });

    document.addEventListener('mousemove', (e) => {
        if (!_zoomEl || _zoomEl.style.display !== 'block') return;
        const pad = 18;
        _zoomEl.style.left = (e.clientX + pad) + 'px';
        _zoomEl.style.top = (e.clientY + pad) + 'px';
    });

    document.addEventListener('mouseout', (e) => {
        const img = e.target.closest('.vv-thumb');
        if (!img) return;
        if (_zoomEl) _zoomEl.style.display = 'none';
    });
</script>
