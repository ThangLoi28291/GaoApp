@using GaoApp.Web.Areas.Admin.ViewModels.Products
@using Microsoft.AspNetCore.Mvc.Rendering
@model ProductVariantVM

<div class="vv-shell mt-3">
    <div class="vv-topbar">
        <div class="vv-topbar-left">
            <div class="vv-title">Biến thể sản phẩm</div>
        </div>

        <div class="vv-topbar-actions">
            <button type="button" class="btn btn-outline-primary btn-sm px-3" id="btnGenVariants">
                Tạo biến thể
            </button>
            <button type="button" class="btn btn-primary btn-sm px-3" id="btnSaveVariants">
                Lưu biến thể
            </button>
        </div>
    </div>

    <div class="vv-filter-panel">
        <div class="vv-filter-title">Thuộc tính</div>
        <div id="attrBox" class="vv-attr-grid"></div>
    </div>

    <div class="vv-list-panel">
        <div class="vv-list-head">
            <div class="vv-list-title">Danh sách biến thể</div>
        </div>
        <div id="variantBody" class="vv-list-body"></div>
    </div>
</div>

<div class="modal fade" id="mdlVariantDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold">Xóa biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="vv-confirm-wrap">
                    <div class="vv-confirm-icon">!</div>
                    <div class="flex-grow-1">
                        <div class="fw-bold mb-2">Bạn có chắc muốn xóa biến thể này?</div>
                        <div class="vv-confirm-meta">
                            <div><span>SKU</span><b id="mdlVariantDeleteSku">-</b></div>
                            <div><span>Thuộc tính</span><b id="mdlVariantDeleteCombo">-</b></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" id="btnCancelDeleteVariant">Hủy</button>
                <button type="button" class="btn btn-danger px-3" id="btnConfirmDeleteVariant">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="spDeleteVariant"></span>
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlPickVariantImage" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold">Chọn ảnh cho biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="d-flex justify-content-end mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearVariantImage">
                        Bỏ chọn ảnh riêng
                    </button>
                </div>

                <div id="pickImgGrid" class="row g-2"></div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@{
    var unitConvVm = new ProductUnitConversionManageVm
    {
        Units = ((IEnumerable<SelectListItem>)(ViewBag.Units ?? new List<SelectListItem>()))
            .Select(x => new UnitOptionVm
            {
                Id = int.Parse(x.Value),
                Name = x.Text
            }).ToList(),

        BarcodeTypes = new List<BarcodeTypeOptionVm>
{
    new() { Value = 0, Name = "Nội bộ" },
    new() { Value = 1, Name = "Mã nhà sản xuất" },
    new() { Value = 2, Name = "Mã nhà cung cấp" },
    new() { Value = 3, Name = "Mã đóng gói" },
    new() { Value = 4, Name = "Mã hệ thống cũ" }
}
    };
}

@await Html.PartialAsync("_VariantUnitConversionsModal", unitConvVm)

