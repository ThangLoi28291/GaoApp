        function markInvalid(el, ok) {
            if (!el) return;
            el?.classList.toggle('is-invalid', !ok);
        }

        function validateVariantsBeforeSave() {
            hasValidatedVariants = true;
            document.querySelectorAll('#variantBody .is-invalid')
                .forEach(x => x.classList.remove('is-invalid'));
            const missingCosts = [], missingSkus = [];
            const list = document.querySelectorAll('#variantBody .vv-variant-item');
            (variants || []).forEach((v, idx) => {
                if (!hasValidCost(v)) { missingCosts.push(idx); markInvalid(list[idx], false); }
                if (!(v.sku || '').trim()) { missingSkus.push(idx); markInvalid(list[idx], false); }
            });
            if (!missingCosts.length && !missingSkus.length) return { ok: true };

            const costMissing = missingCosts.length > 0;
            const first = costMissing ? missingCosts[0] : missingSkus[0];
            const variant = variants[first];
            const name = variant.productVariantName || variant.sku || `Biến thể ${first + 1}`;
            const message = costMissing
                ? `Có ${missingCosts.length} biến thể chưa có giá vốn hợp lệ. Vui lòng nhập giá vốn lớn hơn 0 đ cho "${name}" trước khi lưu.`
                : `Vui lòng nhập SKU cho "${name}" trước khi lưu.`;

            setSelectedVariant(first, { showInMobile: true });
            const mobile = window.innerWidth <= 992;
            const container = document.getElementById(mobile ? 'variantDetailSheetContent' : 'variantDetailPanel');
            const input = container?.querySelector(costMissing ? '.js-detail-cost' : '.js-detail-sku');
            markInvalid(input, false);
            window.setTimeout(() => {
                input?.scrollIntoView({ block: 'center' });
                input?.focus({ preventScroll: true });
                input?.select();
            }, mobile ? 260 : 0);
            toastr?.warning(message, 'Chưa thể lưu', { escapeHtml: true });
            return { ok: false, message, handled: true };
        }

        async function saveVariants() {
            // Keyboard save must commit the current name/SKU before the inspector is re-rendered.
            if (document.activeElement?.matches('.js-detail-name, .js-detail-sku')) document.activeElement.blur();
            const payload = {
                productId: productId,
                variants: (variants || []).map(v => ({
                    id: v.id ?? null,
                    sku: (v.sku || '').trim(),
                    productVariantName: (v.productVariantName || '').trim() || null,
                    costPrice: v.costPrice ?? 0,
                      // Giá bán không sửa ở bảng Variant nữa.
    // Giá lẻ/giá sỉ nằm ở ProductUnitConversion.
    price: v.price,
                      isActive: v.isActive ?? true,

    // PHASE 1:
    // Gửi cờ hóa đơn đầu vào về SaveVariants.
    hasInputInvoice: v.hasInputInvoice ?? false,

    isLocked: v.isLocked ?? false,
    primaryProductImageId: v.primaryProductImageId ?? null,
                    attributeValueIds: v.attributeValueIds || []
                }))
            };

            if (payload.variants.length === 0) {
                return { ok: true, message: 'Không có biến thể để lưu.' };
            }

            const validation = validateVariantsBeforeSave();
            if (!validation.ok) return validation;

            const anti = token();
            if (!anti) {
                toastr?.error('Thiếu AntiForgeryToken.');
                return { ok: false, message: 'Thiếu AntiForgeryToken.' };
            }

            const res = await fetch('/Admin/Product/SaveVariants', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': anti
                },
                body: JSON.stringify(payload),
                credentials: 'same-origin'
            });

            const text = await res.text();
            let json = null;
            try { json = JSON.parse(text); } catch { }

            if (!res.ok) {
                toastr?.error(`HTTP ${res.status}`);
                return { ok: false, message: text || `HTTP ${res.status}` };
            }

            if (json?.ok) {
                toastr?.success(json.message || 'Lưu biến thể thành công.');
                await loadVariants();
                return { ok: true, message: json.message || 'OK' };
            }

            toastr?.error(json?.message || text || 'Thất bại');
            return { ok: false, message: json?.message || text || 'Thất bại' };
        }

        window.GaoVariant = {
            save: saveVariants,
            reload: loadVariants,
            hasAnyVariant: () => (variants?.length || 0) > 0,
            getCompletionState: () => {
                const persisted = (variants || []).filter(v => !!v.id);
                const hasSellingUnit = persisted.some(v => Number(v.unitConversionCount || 0) > 0);
                return {
                    persistedCount: persisted.length,
                    hasRetailPrice: persisted.some(v => Number(v.baseUnitPrice || 0) > 0),
                    hasSellingUnit: hasSellingUnit,
                    hasActiveBarcode: persisted.some(v => Number(v.activeBarcodeCount || 0) > 0)
                };
            }
        };

        document.getElementById('btnGenVariants')?.addEventListener('click', genVariants);
        document.getElementById('btnOpenMobileVariantDetail')?.addEventListener('click', () => {
            if (!variants?.length) return;
            const sheet = document.getElementById('variantDetailSheet');
            sheet?.classList.add('is-open');
            sheet?.setAttribute('aria-hidden', 'false');
        });

        document.getElementById('btnCloseVariantDetailSheet')?.addEventListener('click', () => {
            document.getElementById('variantDetailSheet')?.classList.remove('is-open');
            document.getElementById('variantDetailSheet')?.setAttribute('aria-hidden', 'true');
        });
        document.getElementById('btnSaveVariants')?.addEventListener('click', async () => {
            await saveVariants();
        });

        document.addEventListener('keydown', function (e) {
            const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
            const mod = isMac ? e.metaKey : e.ctrlKey;

            if (mod && (e.key === 's' || e.key === 'S')) {
                e.preventDefault();
                const btnSaveAll = document.getElementById('btnSaveAll');
                if (btnSaveAll) {
                    btnSaveAll.click();
                    return;
                }
                document.getElementById('btnSaveVariants')?.click();
                return;
            }

            if (e.key === 'F6') {
                e.preventDefault();
                const btnSaveAll = document.getElementById('btnSaveAll');
                if (btnSaveAll) {
                    btnSaveAll.click();
                    return;
                }
                document.getElementById('btnSaveVariants')?.click();
            }
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 992) {
                document.getElementById('variantDetailSheet')?.classList.remove('is-open');
                document.getElementById('variantDetailSheet')?.setAttribute('aria-hidden', 'true');
            }
        });

        (async function init() {
            await loadAttrs();
            await loadProductImages();
            await loadVariants();
        })();
    })();

    let _zoomEl = null;

    function ensureZoomEl() {
        if (_zoomEl) return _zoomEl;
        const el = document.createElement('div');
        el.className = 'img-zoom-preview';
        el.innerHTML = `<img src="" alt="zoom" />`;
        document.body.appendChild(el);
        _zoomEl = el;
        return el;
    }

    document.addEventListener('mouseover', (e) => {
        const img = e.target.closest('.vv-thumb');
        if (!img) return;

        const el = ensureZoomEl();
        el.querySelector('img').src = img.src;
        el.style.display = 'block';
    });

    document.addEventListener('mousemove', (e) => {
        if (!_zoomEl || _zoomEl.style.display !== 'block') return;
        const pad = 18;
        _zoomEl.style.left = (e.clientX + pad) + 'px';
        _zoomEl.style.top = (e.clientY + pad) + 'px';
    });

    document.addEventListener('mouseout', (e) => {
        const img = e.target.closest('.vv-thumb');
        if (!img) return;
        if (_zoomEl) _zoomEl.style.display = 'none';
    });
</script>
