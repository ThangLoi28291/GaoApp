@using GaoApp.Web.Areas.Admin.ViewModels.Products
@model ProductIndexVM

@{
    ViewData["Title"] = "Sản phẩm";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">Danh sách sản phẩm</h3>
                <p class="gds-page-header__subtitle mb-0">
                    Tra cứu danh mục và trạng thái sẵn sàng bán tại POS.
                </p>
            </div>

            <div class="gds-page-header__actions">
                <a href="/admin/media-library" class="btn btn-outline-primary gds-action-button">
                    <i class="bx bx-images" aria-hidden="true"></i><span>Quản lý hình ảnh</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-primary gds-action-button gds-action-button--primary">
                    <i class="bx bx-plus" aria-hidden="true"></i>
                    <span>Tạo sản phẩm</span>
                </a>
            </div>
        </div>
    </div>
}

<div data-gao-ui="modern" data-product-page>
  <div data-product-shell
       data-index-url="@Url.Action("Index", "Product", new { area = "Admin" })"
       data-search-url="@Url.Action("Search", "Product", new { area = "Admin" })"
       data-toggle-url="@Url.Action("ToggleStatus", "Product", new { area = "Admin" })"
       data-delete-url="@Url.Action("SoftDelete", "Product", new { area = "Admin" })"
       data-page="@Model.Page"
       class="gds-page">

    <section aria-label="Tổng quan mức độ sẵn sàng của sản phẩm">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
            <div class="col">
                <article class="card shadow-sm border-0 gds-kpi-card gds-kpi-card--primary h-100">
                    <div class="gds-kpi-card__icon is-primary" aria-hidden="true">
                        <i class="bx bx-package"></i>
                    </div>
                    <div class="gds-kpi-card__body">
                        <div class="gds-kpi-card__label fw-semibold text-dark">Tổng sản phẩm</div>
                        <div id="productTotalCount" class="gds-kpi-card__value fw-bold text-primary">@Model.TotalProductCount</div>
                    </div>
                </article>
            </div>

            <div class="col">
                <article class="card shadow-sm border-0 gds-kpi-card gds-kpi-card--success h-100">
                    <div class="gds-kpi-card__icon is-success" aria-hidden="true">
                        <i class="bx bx-check-circle"></i>
                    </div>
                    <div class="gds-kpi-card__body">
                        <div class="gds-kpi-card__label fw-semibold text-dark">Được phép bán POS</div>
                        <div id="productPosAllowedCount" class="gds-kpi-card__value fw-bold text-success">@Model.PosAllowedProductCount</div>
                    </div>
                </article>
            </div>

            <div class="col">
                <article class="card shadow-sm border-0 gds-kpi-card h-100">
                    <div class="gds-kpi-card__icon bg-label-warning text-warning" aria-hidden="true">
                        <i class="bx bx-time-five"></i>
                    </div>
                    <div class="gds-kpi-card__body">
                        <div class="gds-kpi-card__label fw-semibold text-dark">Chưa bán tại POS</div>
                        <div id="productNotForPosCount" class="gds-kpi-card__value fw-bold text-warning">@Model.NotForPosProductCount</div>
                    </div>
                </article>
            </div>

            <div class="col">
                <article class="card shadow-sm border-0 gds-kpi-card gds-kpi-card--neutral h-100">
                    <div class="gds-kpi-card__icon is-neutral" aria-hidden="true">
                        <i class="bx bx-pause-circle"></i>
                    </div>
                    <div class="gds-kpi-card__body">
                        <div class="gds-kpi-card__label fw-semibold text-dark">Ngừng hoạt động</div>
                        <div id="productInactiveCount" class="gds-kpi-card__value fw-bold text-secondary">@Model.InactiveProductCount</div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0" aria-label="Bộ lọc danh sách sản phẩm">
        <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm rounded bg-label-primary">
                    <i class="bx bx-filter-alt" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="mb-0 text-dark">Tra cứu sản phẩm</h5>
                    <small class="text-muted">Tìm nhanh theo tên, alias, SKU hoặc barcode và thu hẹp bằng bộ lọc.</small>
                </div>
            </div>
        </div>

        <div class="card-body pt-3">
          <div class="gds-filter-bar">
            <div class="gds-filter-bar__search">
                <label for="txtSearch" class="form-label fw-semibold text-dark">Tìm kiếm</label>
                <div class="gds-search-field">
                    <i class="bx bx-search" aria-hidden="true"></i>
                    <input id="txtSearch"
                           class="form-control"
                           placeholder="Tên, alias, SKU hoặc barcode..."
                           autocomplete="off"
                           value="@Model.SearchString" />

                    <button type="button"
                            id="btnClearSearch"
                            class="gds-search-field__clear d-none"
                            title="Xóa tìm kiếm"
                            aria-label="Xóa tìm kiếm">
                        <i class="bx bx-x" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="gds-filter-control">
                <label for="ddlCategory" class="form-label fw-semibold text-dark">Danh mục</label>
                <select id="ddlCategory" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        <option value="@option.Id" selected="@(Model.CategoryId == option.Id)">
                            @option.Name
                        </option>
                    }
                </select>
            </div>

            <div class="gds-filter-control">
                <label for="ddlLifecycle" class="form-label fw-semibold text-dark">Sẵn sàng bán</label>
                <select id="ddlLifecycle" class="form-select">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Lifecycle))">Tất cả trạng thái</option>
                    <option value="pos-allowed" selected="@(Model.Lifecycle == "pos-allowed")">Được phép bán POS</option>
                    <option value="not-for-pos" selected="@(Model.Lifecycle == "not-for-pos")">Chưa bán tại POS</option>
                    <option value="inactive" selected="@(Model.Lifecycle == "inactive")">Ngừng hoạt động</option>
                </select>
            </div>

            <div class="gds-filter-control gds-filter-control--compact">
                <label for="ddlPageSize" class="form-label fw-semibold text-dark">Số dòng / trang</label>
                <select id="ddlPageSize" class="form-select">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    <option value="200" selected="@(Model.PageSize == 200)">200</option>
                </select>
            </div>
          </div>
        </div>
    </section>

    <form id="antiForgeryForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div id="productTableWrapper"
         class="gds-results-region"
         aria-live="polite"
         aria-busy="false">
        @await Html.PartialAsync("_ProductTable", Model)
    </div>

    <div class="modal fade"
         id="productQuickViewModal"
         tabindex="-1"
         aria-labelledby="productQuickViewTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <div>
                        <div class="text-primary fw-semibold small text-uppercase">Xem nhanh sản phẩm</div>
                        <h4 class="modal-title text-dark" id="productQuickViewTitle">Thông tin sản phẩm</h4>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-4 align-items-start">
                        <div class="col-md-5">
                            <div class="rounded-3 bg-label-secondary d-flex align-items-center justify-content-center overflow-hidden p-3">
                                <img id="productQuickViewImage"
                                     class="img-fluid rounded d-none"
                                     style="max-height: 360px; object-fit: contain;"
                                     alt="Ảnh xem nhanh sản phẩm" />
                                <div id="productQuickViewImageEmpty" class="text-center text-muted py-5">
                                    <i class="bx bx-image fs-1 d-block mb-2" aria-hidden="true"></i>
                                    Chưa có hình ảnh
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                <div>
                                    <h4 id="productQuickViewName" class="text-dark fw-bold mb-1">—</h4>
                                    <div id="productQuickViewAlias" class="gds-code">—</div>
                                </div>
                                <span id="productQuickViewState" class="gds-status gds-status--dot is-neutral">—</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="text-muted small">Danh mục</div>
                                    <div id="productQuickViewCategory" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Thương hiệu</div>
                                    <div id="productQuickViewBrand" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Nhà cung cấp</div>
                                    <div id="productQuickViewSupplier" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Thuế</div>
                                    <div id="productQuickViewTax" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Đơn vị</div>
                                    <div id="productQuickViewUnit" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Số biến thể</div>
                                    <div id="productQuickViewVariantCount" class="fw-semibold text-dark">—</div>
                                </div>
                                <div class="col-12">
                                    <div class="rounded-3 bg-label-primary p-3">
                                        <div class="text-muted small">Đơn giá</div>
                                        <div id="productQuickViewPrice" class="fs-3 fw-bold text-primary">—</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
                    <a id="productQuickViewDetailLink"
                       class="btn btn-primary"
                       href="#">
                        <i class="bx bx-show me-1" aria-hidden="true"></i>Xem trang chi tiết
                    </a>
                </div>
            </div>
        </div>
    </div>
  </div>
</div>

@section PageScripts {
    <script src="~/admin/js/products.index.js" asp-append-version="true"></script>
}
