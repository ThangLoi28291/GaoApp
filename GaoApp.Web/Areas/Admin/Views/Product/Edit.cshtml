@model GaoApp.Application.DTOs.Products.ProductEditDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sửa sản phẩm";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    var categories = (List<SelectListItem>)ViewBag.Categories;
    var suppliers  = (List<SelectListItem>)ViewBag.Suppliers;
    var brands     = (List<SelectListItem>)ViewBag.Brands;
    var taxes      = (List<SelectListItem>)ViewBag.Taxes;
    var units      = (List<SelectListItem>)ViewBag.Units;
    var isInitialProductSetup = ViewBag.IsInitialProductSetup is true;
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <link href="~/lib/filepond/filepond.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/filepond/filepond-plugin-image-preview.min.css" rel="stylesheet" asp-append-version="true" />

<style>
    .req::after { content: " *"; color: #dc3545; }
    .help { font-size: .84rem; color: #64748b; margin-top: .3rem; }

    .gm-page { max-width: 1280px; margin: 0 auto; }

    .gm-card{
        border-radius:22px;
        border:1px solid rgba(15,23,42,.07);
        box-shadow:0 12px 30px rgba(15,23,42,.05);
        overflow:hidden;
        background:#fff;
    }

    .gm-card .card-header{
        background:linear-gradient(180deg,#fff 0%,#f8fafc 100%);
        font-weight:900;
        padding:16px 18px;
        border-bottom:1px solid rgba(15,23,42,.06);
    }

    .gm-card .card-body{ padding:18px; }

    .gm-section-title{
        font-weight:900;
        font-size:1rem;
        margin-bottom:12px;
        display:flex;
        align-items:center;
        gap:10px;
        color:#0f172a;
    }

    .gm-section-title .dot{
        width:10px;
        height:10px;
        border-radius:999px;
        background:#2563eb;
        display:inline-block;
    }

    .select2-container--bootstrap-5 .select2-selection { min-height: 42px; }
    .select2-container { z-index: 9999 !important; }
    .select2-dropdown { z-index: 99999 !important; }

    .gm-sticky{ position: sticky; top: 92px; }
    @@media (max-width: 991px){ .gm-sticky{ position: static; top:auto; } }

    .gm-banner{
        border-radius:18px;
        border:1px solid rgba(37,99,235,.16);
        background:linear-gradient(180deg,rgba(37,99,235,.06) 0%,rgba(37,99,235,.03) 100%);
        padding:14px 16px;
        color:#334155;
        font-weight:700;
    }

    .gm-summary{
        border-radius:20px;
        border:1px solid rgba(15,23,42,.06);
        background:#fff;
        padding:16px;
        box-shadow:0 10px 26px rgba(15,23,42,.04);
    }

    .gm-summary h6{
        font-weight:900;
        margin-bottom:12px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        color:#0f172a;
    }

    .gm-pill{
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:5px 10px;
        border-radius:999px;
        font-size:12px;
        font-weight:900;
        border:1px solid rgba(0,0,0,.08);
        background:#fff;
        color:#64748b;
        white-space:nowrap;
    }

    .gm-pill.is-dirty{
        border-color: rgba(220,53,69,.25);
        background: rgba(220,53,69,.08);
        color:#dc3545;
    }

    .gm-summary .rowline{
        display:flex;
        justify-content:space-between;
        gap:12px;
        padding: 8px 0;
        border-bottom: 1px dashed rgba(0,0,0,.08);
    }

    .gm-summary .rowline:last-child{ border-bottom:0; }
    .gm-summary .k{ color:#64748b; font-size:.88rem; }
    .gm-summary .v{ font-weight:900; text-align:right; color:#0f172a; }

    .gm-actions { position: sticky; bottom: 12px; z-index: 10; }
    .gm-actions .gm-actions-inner{
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 18px;
        padding: 12px 14px;
        box-shadow: 0 10px 26px rgba(0,0,0,.08);
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:12px;
    }
    @@media (max-width: 991px){ .gm-actions{ position: static; } }

    .gm-pond-wrap .filepond--list-scroller,
    .gm-pond-wrap .filepond--items { display:none !important; }

    .gm-pond-wrap .filepond--panel-root { border-radius: 14px; }
    .gm-pond-wrap .filepond--drop-label {
        min-height: 40px !important;
        padding: 8px 10px !important;
        font-size: .9rem;
        background:#f8fafc;
        border:1px dashed rgba(0,0,0,.18);
    }

    .gm-pond-wrap .filepond--root { margin-bottom: 0; min-height: 40px; }
    .gm-pond-wrap .filepond--label-action{ text-decoration:none; font-weight:900; }

    .gm-main-preview{
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 160px;
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,.08);
        background:#fff;
        overflow:hidden;
        display:flex;
        align-items:center;
        justify-content:center;
    }

    .gm-main-preview img{ width:100%; height:100%; object-fit:contain; background:#fff; }
    .gm-main-empty{ color:#64748b; font-size:.9rem; padding:10px 12px; text-align:center; }

    .gm-main-badge{
        position:absolute;
        top:10px; left:10px;
        background: rgba(37,99,235,.94);
        color:#fff;
        font-weight:900;
        font-size:12px;
        padding:4px 8px;
        border-radius:999px;
    }

    .gm-thumbbar-title{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        gap:12px;
        margin-bottom:10px;
    }

    .gm-thumbstrip{
        display:flex;
        gap:10px;
        overflow-x:auto;
        padding:10px;
        border-radius:16px;
        border:1px dashed rgba(37,99,235,.24);
        background:rgba(37,99,235,.03);
    }

    .gm-thumbstrip::-webkit-scrollbar{ height: 10px; }
    .gm-thumbstrip::-webkit-scrollbar-thumb{ background: rgba(0,0,0,.15); border-radius: 999px; }
    .gm-thumbstrip::-webkit-scrollbar-track{ background: rgba(0,0,0,.05); border-radius: 999px; }

    .gm-thumb{
        width:96px; min-width:96px;
        height:72px;
        border-radius:14px;
        overflow:hidden;
        position:relative;
        border:1px solid rgba(0,0,0,.08);
        background:#fff;
        cursor:pointer;
    }

    .gm-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
    .gm-thumb.is-active{ outline: 2px solid rgba(37,99,235,.40); }
    .gm-thumb.is-primary{ outline: 2px solid rgba(37,99,235,.78); }

    .gm-thumb .gm-remove{
        position:absolute;
        top:6px; right:6px;
        width:20px; height:20px;
        border-radius:999px;
        border:0;
        background: rgba(0,0,0,.55);
        color:#fff;
        font-weight:900;
        line-height:20px;
        text-align:center;
        cursor:pointer;
    }

    .gm-thumb .gm-remove:hover{ background: rgba(220,53,69,.88); }

    .gm-thumb .gm-primary-badge{
        position:absolute;
        left:6px;
        bottom:6px;
        padding:3px 7px;
        border-radius:999px;
        font-size:11px;
        font-weight:900;
        background: rgba(37,99,235,.94);
        color:#fff;
        display:none;
    }

    .gm-thumb.is-primary .gm-primary-badge{ display:inline-block; }

    .gm-thumbstrip.is-drag,
    #mainPreview.is-drag {
        outline: 2px dashed rgba(37,99,235,.55);
        outline-offset: 4px;
        background: rgba(37,99,235,.06);
    }
</style>
<link href="~/admin/css/product-setup-workspace.css" rel="stylesheet" asp-append-version="true" />
}

@section header {
    <div class="py-2">
        <h3 class="mb-0 fw-bold">Thiết lập sản phẩm</h3>
        <div class="text-muted mt-1">Cập nhật thông tin, hình ảnh và biến thể trong cùng một không gian làm việc.</div>
    </div>
}

<div class="gm-page product-setup-workspace"
     data-product-setup-workspace
     data-product-setup-stage="edit"
     data-initial-setup="@isInitialProductSetup.ToString().ToLowerInvariant()">
    @if (isInitialProductSetup)
    {
        <div class="psw-continuation-banner" role="status">
            <span class="psw-continuation-icon"><i class="bx bx-check"></i></span>
            <strong>Đã tạo sản phẩm · Tiếp tục thiết lập biến thể</strong>
        </div>
    }
    @if (!Model.IsSellable)
    {
        <div class="alert alert-warning d-flex gap-2 align-items-start">
            <i class="bx bx-error-circle fs-4"></i>
            <div><strong>Sản phẩm đang chờ hoàn thiện</strong><div>Hàng vẫn dùng được cho mua/nhập kho nhưng chưa xuất hiện tại POS. Bật “Cho phép bán tại POS” sau khi đã kiểm tra đầy đủ thông tin.</div></div>
        </div>
    }
    <form asp-area="Admin"
          asp-controller="Product"
          asp-action="Edit"
          id="productSetupForm"
          method="post"
          novalidate
          data-upload-state="ready">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="row g-3">
            <!-- LEFT -->
            <div class="col-lg-8">
                <div class="card gm-card mb-3">
                    <div class="card-header">1) Thông tin chung</div>
                    <div class="card-body">

                        <div class="gm-section-title"><span class="dot"></span> Thông tin cơ bản</div>

                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label req" for="txtName">Tên sản phẩm</label>
                                <input asp-for="Name" class="form-control" autocomplete="off" id="txtName" />
                                <div class="help">Tên hiển thị cho khách hàng.</div>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label" for="txtAlias">Mã hiển thị (Alias)</label>
                                <div class="input-group">
                                    <input asp-for="Alias" class="form-control" id="txtAlias" readonly tabindex="-1" />
                                    <button class="btn btn-outline-secondary" type="button" id="btnRegenAlias" title="Tạo lại alias theo tên">⟳</button>
                                </div>
                                <div class="help">Alias tự sinh theo tên, trùng sẽ tự thêm -1, -2…</div>
                                <span asp-validation-for="Alias" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Danh mục</label>
                                <select asp-for="CategoryId" class="form-select select2" id="ddlCategory" data-placeholder="Chọn danh mục...">
                                    <option value=""></option>
                                    @foreach (var x in categories) { <option value="@x.Value">@x.Text</option> }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Nhà cung cấp</label>
                                <select asp-for="SupplierId" class="form-select select2" id="ddlSupplier" data-placeholder="Chọn nhà cung cấp...">
                                    <option value=""></option>
                                    @foreach (var x in suppliers) { <option value="@x.Value">@x.Text</option> }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Đơn vị cơ bản</label>
                                <select asp-for="BaseUnitId" class="form-select select2" id="ddlUnit" data-saved-unit-id="@Model.BaseUnitId" data-placeholder="Chọn đơn vị...">
                                    <option value=""></option>
                                    @foreach (var x in units) { <option value="@x.Value">@x.Text</option> }
                                </select>
                                <span asp-validation-for="BaseUnitId" class="text-danger"></span>
                                <div class="help">Khi lưu, đơn vị này sẽ đồng bộ thành đơn vị gốc (×1) của tất cả biến thể. Sản phẩm đã có chứng từ hoặc tồn kho cần giữ đơn vị gốc và thêm quy đổi.</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="gm-section-title"><span class="dot"></span> Giá & tuỳ chọn</div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Giá bán lẻ</label>
                                <!-- ✅ VNĐ: không .00 -->
                                <input asp-for="BasePrice"
                                       asp-format="{0:0}"
                                       class="form-control"
                                       id="txtBasePrice"
                                       type="number"
                                       min="0"
                                       step="1000" />
                                <div class="help">Dùng khi biến thể hoặc đơn vị bán chưa có giá riêng.</div>
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thương hiệu</label>
                                <select asp-for="BrandId" class="form-select select2" id="ddlBrand" data-placeholder="(Không bắt buộc)">
                                    <option value=""></option>
                                    @foreach (var x in brands) { <option value="@x.Value">@x.Text</option> }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thuế</label>
                                <select asp-for="TaxId" class="form-select select2" id="ddlTax" data-placeholder="(Không bắt buộc)">
                                    <option value=""></option>
                                    @foreach (var x in taxes) { <option value="@x.Value">@x.Text</option> }
                                </select>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch psw-pos-switch @(Model.IsSellable ? "" : "border-warning bg-label-warning")">
                                    <input asp-for="IsSellable" class="form-check-input" role="switch" />
                                    <label asp-for="IsSellable" class="form-check-label fw-bold">Cho phép bán tại POS</label>
                                    <div class="help mb-0">Tắt: chỉ dùng cho mua/nhập kho. Bật: sản phẩm có thể xuất hiện trong luồng bán hàng/POS.</div>
                                    <span class="psw-pos-state" data-pos-state>@(Model.IsSellable ? "Đang bật" : "Đang tắt")</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mô tả ngắn</label>
                                <input asp-for="Description" class="form-control" id="txtDesc" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Nội dung</label>
                                <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">
                <div class="gm-sticky">

                    <div class="card gm-card mb-3">
                        <div class="card-header">2) Hình ảnh</div>
                        <div class="card-body">

                            <div class="gm-pond-wrap">
                                <input type="file" id="productImages" name="file" multiple />
                            </div>

                            <div class="gm-main-preview mt-3" id="mainPreview">
                                <div class="gm-main-empty">Chưa có ảnh. Kéo thả hoặc bấm <b>Chọn ảnh</b>.</div>
                                <img id="mainPreviewImg" alt="preview" style="display:none;" />
                                <div class="gm-main-badge" id="mainBadge" style="display:none;">ẢNH CHÍNH</div>
                            </div>

                            <div class="psw-context-help">
                                <i class="bx bx-info-circle fs-5"></i>
                                <span>Kéo thả để đổi thứ tự; chọn thumbnail để xem và đặt ảnh đang xem làm ảnh chính.</span>
                            </div>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm w-100 mt-2"
                                    id="btnSetPrimaryImage"
                                    data-set-primary-image>
                                <i class="bx bx-star me-1"></i> Đặt ảnh đang xem làm ảnh chính
                            </button>
                            <div class="psw-upload-state mt-2" id="productUploadState" aria-live="polite">
                                <i class="bx bx-check-circle"></i>
                                <span>Ảnh đã sẵn sàng.</span>
                            </div>

                            <div class="gm-thumbbar mt-3">
                                <div class="gm-thumbbar-title">
                                    <div class="fw-bold">Ảnh đã chọn</div>
                                    <div class="small text-muted">Kéo ngang để xem thêm</div>
                                </div>
                                <div id="thumbStrip" class="gm-thumbstrip"></div>
                            </div>

                            <!-- Backend fields -->
                            <input type="hidden" id="ImagesStateJson" name="ImagesStateJson" value="[]" />
                            <input type="hidden" id="PrimaryKey" name="PrimaryKey" value="" />
                        </div>
                    </div>

                    <div class="d-none" aria-hidden="true">
                        <span id="sumName">—</span><span id="chgName"></span>
                        <span id="sumCategory">—</span><span id="chgCategory"></span>
                        <span id="sumSupplier">—</span><span id="chgSupplier"></span>
                        <span id="sumUnit">—</span><span id="chgUnit"></span>
                        <span id="sumBrand">—</span><span id="chgBrand"></span>
                        <span id="sumTax">—</span><span id="chgTax"></span>
                        <span id="sumPrice">—</span><span id="chgPrice"></span>
                        <span id="sumImages">0</span><span id="chgImages"></span>
                    </div>

                </div>
            </div>
        </div>
        @using GaoApp.Web.Areas.Admin.ViewModels.Products

        <section id="variants" class="psw-variant-stage" tabindex="-1">
            @await Html.PartialAsync("_Variants", new ProductVariantVM
                    {
                ProductId = Model.Id,
                    ProductAlias = Model.Alias
                    })
        </section>

        <!-- ACTION BAR -->
<div class="gm-actions mt-3">
    <div class="gm-actions-inner">
        <div class="psw-progress" data-completion-progress data-readiness-checklist>
            <button type="button"
                    class="psw-progress-trigger"
                    data-completion-toggle
                    aria-expanded="false"
                    aria-controls="productCompletionPanel">
                <span class="psw-progress-title">
                    <span>Hoàn thiện hồ sơ</span>
                    <strong class="psw-progress-percent"><span data-completion-percent>0</span>%</strong>
                </span>
                <span class="psw-progress-track"
                      data-completion-track
                      role="progressbar"
                      aria-label="Mức độ hoàn thiện hồ sơ"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="0">
                    <span class="psw-progress-bar" data-completion-bar></span>
                </span>
                <span class="psw-progress-meta">
                    <span data-completion-count>0/10 tiêu chí hoàn tất</span>
                    <span data-product-save-state>Đã lưu</span>
                </span>
            </button>

            <div class="psw-completion-backdrop" data-completion-backdrop hidden></div>
            <section class="psw-completion-panel"
                     id="productCompletionPanel"
                     data-completion-panel
                     aria-label="Chi tiết hoàn thiện hồ sơ"
                     hidden>
                <div class="psw-completion-head">
                    <div>
                        <h6>Hoàn thiện hồ sơ sản phẩm</h6>
                        <p><span data-completion-count>0/10 tiêu chí hoàn tất</span> · không chặn thao tác lưu.</p>
                    </div>
                    <button type="button" class="btn-close" data-completion-close aria-label="Đóng"></button>
                </div>
                <div class="psw-completion-body">
                    <div class="psw-completion-group">
                        <div class="psw-completion-group-title">Bắt buộc / nền tảng</div>
                        <button type="button" class="psw-completion-item" data-readiness-item="name" data-completion-target="#txtName"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Tên sản phẩm</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="alias" data-completion-target="#txtName"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Mã hiển thị</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="category" data-completion-target="#ddlCategory"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Danh mục</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="supplier" data-completion-target="#ddlSupplier"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Nhà cung cấp</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="unit" data-completion-target="#ddlUnit"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Đơn vị cơ bản</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="variant" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Biến thể đã lưu</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                    </div>
                    <div class="psw-completion-group">
                        <div class="psw-completion-group-title">Khuyến nghị bán hàng</div>
                        <button type="button" class="psw-completion-item" data-readiness-item="price" data-completion-target="#txtBasePrice"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Giá bán lẻ</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="images" data-completion-target=".gm-pond-wrap"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Ảnh chính</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="selling-unit" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Đơn vị bán đang hoạt động</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                        <button type="button" class="psw-completion-item" data-readiness-item="barcode" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Barcode đang hoạt động</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                    </div>
                    <div class="psw-pos-summary"><span>Trạng thái bán tại POS</span><strong class="psw-pos-state" data-pos-state>@(Model.IsSellable ? "Đang bật" : "Đang tắt")</strong></div>
                </div>
            </section>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg" id="btnSaveAll" type="button">
                Lưu thay đổi
            </button>
            <a class="btn btn-outline-primary btn-lg"
               asp-area="Admin"
               asp-controller="Product"
               asp-action="Index">
                Hoàn tất và về danh sách
            </a>
        </div>
    </div>
</div>
    </form>
</div>

@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/lib/filepond/filepond.min.js" asp-append-version="true"></script>
    <script src="~/lib/filepond/filepond-plugin-image-preview.min.js" asp-append-version="true"></script>
    <script src="~/admin/js/product-variant-unit-conversion.js" asp-append-version="true"></script>
    <script>
        window.GaoVariantUnitConversion?.bind();
    </script>
}
 
@section PageScripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- 1) Bơm danh sách ảnh cũ từ server (Edit) -->
    <script>
        window.__existingImages = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.Images
                    .OrderBy(x => x.SortOrder)
                    .Select(x => new {
                        productImageId = x.ProductImageId,
                        url = x.Url,
                        isPrimary = x.IsPrimary,
                        sortOrder = x.SortOrder
                    })
            )
        );
    </script>
<script>
    window.gaoProductCtx = {
        productId: @Model.Id,
        productAlias: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Alias ?? string.Empty)),
        initialVariantSetup: @(isInitialProductSetup ? "true" : "false")
    };
</script>


<script>
        /* =========================================================
           ✅ EDIT PRODUCT - FINAL SCRIPT (Fix drop + append new file)
           ========================================================= */

    let pond = null;
        let activePondId = '';

    function hasPendingProductUploads() {
          if (!pond) return false;

      return pond.getFiles().some(file => {
            const metadata = file.getMetadata?.();
            const isExisting = !!(metadata && metadata.productImageId);
            return !isExisting && !file.serverId;
          });
        }

    function syncProductUploadState() {
          const pending = hasPendingProductUploads();
          const form = document.getElementById('productSetupForm');
          if (form) form.dataset.uploadState = pending ? 'pending' : 'ready';

      window.GaoProductSetup?.setUploadState({
            pending,
            count: pond ? pond.getFiles().length : 0
          });
        }

    function setActiveImageAsPrimary() {
          if (!pond || !activePondId) return;

      const files = pond.getFiles();
          const index = files.findIndex(file => file.id === activePondId);
          if (index < 0) return;

      if (index > 0) pond.moveFile(index, 0);

      setTimeout(() => {
            rebuildThumbStrip();
            syncImagesStateAndPrimary();
            toastr?.success('Đã chọn ảnh chính.');
          }, 0);
        }

    /* ========== Helpers ========== */
        function getCsrf() {
          const el = document.querySelector('input[name="__RequestVerificationToken"]');
          return el ? el.value : '';
        }

    function fmtMoney(v) {
          const s = (v ?? '').toString().trim();
          if (!s) return '—';
          const n = Number(s.replaceAll(',', ''));
          if (Number.isNaN(n)) return s;
          return n.toLocaleString('vi-VN');
        }

    function selText(selector) {
          const el = document.querySelector(selector);
          if (!el || !el.value) return '—';
          const opt = el.options && el.selectedIndex >= 0 ? el.options[el.selectedIndex] : null;
          const t = opt ? (opt.text || '').trim() : '';
          return t || '—';
        }

    /* ========== Select2 ========== */
        function initSelect2(ctx) {
          if (!window.jQuery || !$.fn.select2) return;
          $(ctx).find('select.select2').each(function () {
            const $el = $(this);
            if ($el.data('select2')) return;
            $el.select2({
              theme: 'bootstrap-5',
              width: '100%',
              allowClear: true,
              placeholder: $el.data('placeholder') || 'Chọn...',
              dropdownParent: $('body'),
              closeOnSelect: true,
              selectOnClose: false
            });
          });
        }

    $(document).on('keydown', '.select2-selection', function (e) {
          const k = e.key || e.which || e.keyCode;
          const isDown = (k === 'ArrowDown' || k === 40);
          const isEnter = (k === 'Enter' || k === 13);
          if (!isDown && !isEnter) return;
          e.preventDefault();
          const $select = $(this).closest('.select2-container').prev('select');
          if ($select.length) $select.select2('open');
        });

    $(document).on('select2:open', function () {
          setTimeout(() => {
            const f = document.querySelector('.select2-container--open .select2-search__field');
            if (f) f.focus();
          }, 0);
        });

    /* ========== Drop guard (DON'T block mainPreview/thumbStrip) ========== */
        function isAllowedDropTarget(target) {
          const el = target && target.closest ? target : null;
          if (!el) return false;
          return !!el.closest(
            '.filepond--root, .filepond, .filepond--drop-label, .filepond--panel-root,' +
            '#mainPreview, #thumbStrip'
          );
        }

    // prevent browser open new tab when drop outside allowed zones
        document.addEventListener('dragover', (e) => {
          if (!isAllowedDropTarget(e.target)) e.preventDefault();
        }, true);

    document.addEventListener('drop', (e) => {
          if (!isAllowedDropTarget(e.target)) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);

    /* ========== Web image drop helpers ========== */
        function dataUrlToFile(dataUrl, filename) {
          const arr = dataUrl.split(',');
          const mime = arr[0].match(/:(.*?);/)?.[1] || 'image/jpeg';
          const bstr = atob(arr[1]);
          let n = bstr.length;
          const u8arr = new Uint8Array(n);
          while (n--) u8arr[n] = bstr.charCodeAt(n);
          return new File([u8arr], filename, { type: mime });
        }

    async function urlToFile(url) {
          const res = await fetch(url, { mode: 'cors' });
          if (!res.ok) throw new Error('Fetch failed');
          const blob = await res.blob();
          const ext = blob.type.includes('png') ? 'png' : (blob.type.includes('webp') ? 'webp' : 'jpg');
          return new File([blob], `web_${Date.now()}.${ext}`, { type: blob.type || 'image/jpeg' });
        }

    /* ✅ Drop zone -> add files into pond (MainPreview / ThumbStrip) */
        function bindDropAddFiles(el) {
          if (!el) return;

      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
            el.addEventListener(evt, function (e) {
              e.preventDefault();
              e.stopPropagation();
            }, true);
          });

      el.addEventListener('dragenter', () => el.classList.add('is-drag'), true);
          el.addEventListener('dragleave', () => el.classList.remove('is-drag'), true);

      el.addEventListener('drop', async function (e) {
            el.classList.remove('is-drag');
            if (!pond) return;

        const dt = e.dataTransfer;
            if (!dt) return;

        // 1) File from PC
            const files = Array.from(dt.files || []);
            if (files.length) {
              for (const f of files) {
                if (!f.type || !f.type.startsWith('image/')) continue;
                await pond.addFile(f);
              }
              return;
            }

        // 2) Web image (data:image or url)
            const uri = dt.getData('text/uri-list') || dt.getData('text/plain');
            if (!uri) return;

        try {
              if (uri.startsWith('data:image/')) {
                await pond.addFile(dataUrlToFile(uri, `web_${Date.now()}.jpg`));
              } else if (uri.startsWith('http://') || uri.startsWith('https://')) {
                await pond.addFile(await urlToFile(uri));
              }
            } catch (err) {
              console.warn(err);
              alert('Không kéo ảnh web được do CORS. Hãy lưu ảnh về máy rồi kéo vào.');
            }
          }, true);
        }

    /* ========== Summary ========== */
        function syncSummary() {
          $('#sumName').text((($('#txtName').val() || '').toString().trim()) || '—');
          $('#sumCategory').text(selText('#ddlCategory'));
          $('#sumSupplier').text(selText('#ddlSupplier'));
          $('#sumUnit').text(selText('#ddlUnit'));
          $('#sumBrand').text(selText('#ddlBrand'));
          $('#sumTax').text(selText('#ddlTax'));

      const p = ($('#txtBasePrice').val() || '').toString().trim();
          $('#sumPrice').text(p ? fmtMoney(p) : '—');

      $('#sumImages').text(pond ? pond.getFiles().length : 0);
        }

    /* ========== Main Preview ========== */
        function setMainPreviewFromItem(item) {
          const img = document.getElementById('mainPreviewImg');
          const empty = document.querySelector('#mainPreview .gm-main-empty');
          const badge = document.getElementById('mainBadge');
          if (!img || !badge) return;

      if (!item) {
            img.style.display = 'none';
            badge.style.display = 'none';
            if (empty) empty.style.display = 'block';
            activePondId = '';
            return;
          }

      if (empty) empty.style.display = 'none';
          img.style.display = 'block';

      const md = item.getMetadata?.();
          if (md && md.url) img.src = md.url;
          else {
            try { img.src = URL.createObjectURL(item.file); } catch {}
          }

      activePondId = item.id;

      const files = pond ? pond.getFiles() : [];
          badge.style.display = (files.length && files[0].id === item.id) ? 'block' : 'none';
        }

    /* ========== Thumb Strip ========== */
        function rebuildThumbStrip() {
          const strip = document.getElementById('thumbStrip');
          if (!strip || !pond) return;

      strip.innerHTML = '';
          const files = pond.getFiles();
          if (!activePondId && files.length) activePondId = files[0].id;

      files.forEach((item, index) => {
            const md = item.getMetadata?.();

        const thumb = document.createElement('div');
            thumb.className = 'gm-thumb';
            thumb.dataset.pondId = item.id;

        if (item.id === activePondId) thumb.classList.add('is-active');
            if (index === 0) thumb.classList.add('is-primary');

        const img = document.createElement('img');
            if (md && md.url) img.src = md.url;
            else {
              try { img.src = URL.createObjectURL(item.file); } catch {}
            }

        const btnRemove = document.createElement('button');
            btnRemove.type = 'button';
            btnRemove.className = 'gm-remove';
            btnRemove.innerHTML = '&times;';

        const badge = document.createElement('span');
            badge.className = 'gm-primary-badge';
            badge.textContent = 'CHÍNH';

        // click => view
            thumb.addEventListener('click', function () {
              const f = pond.getFiles().find(x => x.id === this.dataset.pondId);
              if (!f) return;

          activePondId = f.id;
              document.querySelectorAll('.gm-thumb').forEach(x => x.classList.remove('is-active'));
              this.classList.add('is-active');
              setMainPreviewFromItem(f);
            });

        // dblclick => move to first => primary
            thumb.addEventListener('dblclick', function (e) {
              e.preventDefault();
              activePondId = this.dataset.pondId || activePondId;
              setActiveImageAsPrimary();
            });

        // remove
            btnRemove.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              pond.removeFile(item.id, { revert: true });
            });

        thumb.appendChild(img);
            thumb.appendChild(btnRemove);
            thumb.appendChild(badge);
            strip.appendChild(thumb);
          });

      const current = files.find(x => x.id === activePondId) || files[0];
          setMainPreviewFromItem(current);
          syncSummary();
        }

    /* ========== Backend sync ========== */
        function syncImagesStateAndPrimary() {
          if (!pond) return;

      const files = pond.getFiles();

      const orderedItems = files.map(f => {
            const md = f.getMetadata?.();
            if (md && md.productImageId) {
              return { ExistingProductImageId: Number(md.productImageId), TempToken: null };
            }
            const token = f.serverId;
            return token ? { ExistingProductImageId: null, TempToken: String(token) } : null;
          }).filter(Boolean);

      const stateEl = document.querySelector('#ImagesStateJson');
          const primaryEl = document.querySelector('#PrimaryKey');
          if (stateEl) stateEl.value = JSON.stringify(orderedItems);

      // Primary = first
          if (primaryEl) {
            if (orderedItems.length === 0) primaryEl.value = '';
            else {
              const first = orderedItems[0];
              if (first.ExistingProductImageId) primaryEl.value = `id:${first.ExistingProductImageId}`;
              else if (first.TempToken) primaryEl.value = `temp:${first.TempToken}`;
              else primaryEl.value = '';
            }
          }

      // badge update
          const current = files.find(x => x.id === activePondId) || files[0];
          setMainPreviewFromItem(current);

      syncSummary();
        }

    /* ✅ Ensure NEW image always appended (not become primary) */
        async function moveNewFileToEndIfNeeded(item) {
          if (!pond || !item) return;

      // local existing has metadata.productImageId
          const md = item.getMetadata?.();
          const isExisting = !!(md && md.productImageId);

      if (isExisting) return;

      const all = pond.getFiles();
          const idx = all.findIndex(x => x.id === item.id);
          if (idx < 0) return;

      const lastIdx = all.length - 1;
          if (idx !== lastIdx) {
            pond.moveFile(idx, lastIdx);
          }
        }

    /* ========== INIT ========== */
        $(function () {
          initSelect2(document);

      // summary bindings
          $(document).on('change input',
            '#txtName, #ddlCategory, #ddlSupplier, #ddlUnit, #ddlBrand, #ddlTax, #txtBasePrice, #txtDesc, #IsSellable, textarea[name="Content"]',
            syncSummary
          );
          $(document).on('select2:select select2:clear',
            '#ddlCategory, #ddlSupplier, #ddlUnit, #ddlBrand, #ddlTax',
            syncSummary
          );

      // FilePond
          if (window.FilePondPluginImagePreview) FilePond.registerPlugin(FilePondPluginImagePreview);

      const input = document.querySelector('#productImages');
          if (!input || !window.FilePond) {
            syncSummary();
            setMainPreviewFromItem(null);
            syncProductUploadState();
            return;
          }

      // preload existing images
          const existing = (window.__existingImages || []).map(x => ({
            source: String(x.productImageId),
            options: {
              type: 'local',
              metadata: { productImageId: x.productImageId, url: x.url }
            }
          }));

      pond = FilePond.create(input, {
            allowMultiple: true,
            allowReorder: false,
            name: 'file',
            allowImagePreview: false,
            labelIdle: 'Thêm ảnh (<span class="filepond--label-action">Chọn</span>)',
            dropOnPage: false,
            dropOnElement: true,

        server: {
              load: (source, load, error) => {
                const img = (window.__existingImages || []).find(z => String(z.productImageId) === String(source));
                if (!img || !img.url) { error('not found'); return; }

            fetch(img.url)
                  .then(r => r.blob())
                  .then(blob => load(blob))
                  .catch(() => error('load failed'));
              },
              process: {
                url: '/admin/media/temp',
                method: 'POST',
                headers: { 'RequestVerificationToken': getCsrf() },
                onload: (res) => res
              },
              revert: {
                url: '/admin/media/temp',
                method: 'DELETE',
                headers: { 'RequestVerificationToken': getCsrf() }
              }
            },

        files: existing
          });

      // ✅ drop add files for preview + strip
          bindDropAddFiles(document.getElementById('mainPreview'));
          bindDropAddFiles(document.getElementById('thumbStrip'));

      // events
      pond.on('addfile', async (err, item) => {
            if (err) {
              syncProductUploadState();
              return;
            }

        // ✅ append new image to end, keep primary unchanged
            await moveNewFileToEndIfNeeded(item);

        // keep active as current viewed (don’t auto jump to new)
            const first = pond.getFiles()[0];
            if (!activePondId && first) activePondId = first.id;

        rebuildThumbStrip();
            syncImagesStateAndPrimary();
            syncProductUploadState();
          });

      pond.on('removefile', () => {
            const left = pond.getFiles();
            activePondId = left.length ? left[0].id : '';
            rebuildThumbStrip();
            syncImagesStateAndPrimary();
            syncProductUploadState();
          });

      pond.on('processfile', () => {
            rebuildThumbStrip();
            syncImagesStateAndPrimary();
            syncProductUploadState();
          });

      pond.on('updatefiles', () => {
            rebuildThumbStrip();
            syncImagesStateAndPrimary();
            syncProductUploadState();
          });

      pond.on('processfileabort', syncProductUploadState);
      pond.on('processfilerevert', syncProductUploadState);
      pond.on('error', syncProductUploadState);

      // init
          rebuildThumbStrip();
          syncImagesStateAndPrimary();
          syncProductUploadState();

      document.getElementById('btnSetPrimaryImage')
            ?.addEventListener('click', setActiveImageAsPrimary);

      $('#productSetupForm').on('submit', function (event) {
            if (hasPendingProductUploads()) {
              event.preventDefault();
              event.stopImmediatePropagation();
              syncProductUploadState();
              toastr?.warning('Vui lòng chờ tất cả hình ảnh tải lên xong trước khi lưu.');
              return false;
            }

            syncImagesStateAndPrimary();
            return true;
          });

      syncSummary();
        });
    </script>
    <script>
    // =========================================================
    // GỘP 2 NÚT LƯU:
    // - Lưu thay đổi = lưu _Variants trước
    // - nếu _Variants OK => submit form Edit
    // =========================================================
    (() => {
        const formEl = document.querySelector('form[asp-action="Edit"]') || document.querySelector('form');
        const btnSaveAll = document.getElementById('btnSaveAll');

        if (!formEl || !btnSaveAll) return;

        let isSavingAll = false;

        function setSaveAllLoading(isLoading) {
            btnSaveAll.disabled = isLoading || hasPendingProductUploads();
            btnSaveAll.innerHTML = isLoading
                ? '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...'
                : 'Lưu thay đổi';
        }

        async function saveAll() {
            if (isSavingAll) return;

            if (hasPendingProductUploads()) {
                syncProductUploadState();
                toastr?.warning('Vui lòng chờ tất cả hình ảnh tải lên xong trước khi lưu.');
                return;
            }

            try {
                isSavingAll = true;
                setSaveAllLoading(true);

                // 1) đồng bộ ảnh trước khi submit Edit
                if (typeof syncImagesStateAndPrimary === 'function') {
                    syncImagesStateAndPrimary();
                }

                // 2) lưu Variants trước
                if (window.GaoVariant?.save) {
                    const result = await window.GaoVariant.save();

                    if (!result?.ok) {
                        if (!result?.handled) toastr?.error(result?.message || 'Lưu biến thể thất bại.');
                        return;
                    }
                }

                // 3) submit form Edit
                formEl.submit();
            }
            catch (err) {
                console.error(err);
                toastr?.error('Có lỗi khi lưu dữ liệu.');
            }
            finally {
                isSavingAll = false;
                setSaveAllLoading(false);
            }
        }

        btnSaveAll.addEventListener('click', async function () {
            await saveAll();
        });
    })();
</script>
    <script src="~/admin/js/product-setup-workspace.js" asp-append-version="true"></script>
}
