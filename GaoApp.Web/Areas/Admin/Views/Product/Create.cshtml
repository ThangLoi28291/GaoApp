@model GaoApp.Application.DTOs.Products.ProductCreateDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tạo sản phẩm";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    var categories = (List<SelectListItem>)ViewBag.Categories;
    var suppliers = (List<SelectListItem>)ViewBag.Suppliers;
    var brands = (List<SelectListItem>)ViewBag.Brands;
    var taxes = (List<SelectListItem>)ViewBag.Taxes;
    var units = (List<SelectListItem>)ViewBag.Units;
}

@section VendorStyles {
    <!-- Nếu layout đã có select2 thì bỏ 2 dòng CDN này -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <link href="~/lib/filepond/filepond.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/filepond/filepond-plugin-image-preview.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        .req::after {
            content: " *";
            color: #dc3545;
        }

        .help {
            font-size: .875rem;
            color: #6c757d;
            margin-top: .25rem;
        }

        .gm-page {
            max-width: 1200px;
            margin: 0 auto;
        }

        .gm-card {
            border-radius: 16px;
            border: 1px solid rgba(0,0,0,.06);
            box-shadow: 0 6px 18px rgba(0,0,0,.04);
            overflow: hidden;
        }

            .gm-card .card-header {
                background: #f8f9fa;
                font-weight: 800;
            }

            .gm-card .card-body {
                padding: 18px;
            }

        .gm-section-title {
            font-weight: 800;
            font-size: 1rem;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .gm-section-title .dot {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: #0d6efd;
                display: inline-block;
            }

        .select2-container--bootstrap-5 .select2-selection {
            min-height: 40px;
        }

        .select2-container {
            z-index: 9999 !important;
        }

        .select2-dropdown {
            z-index: 99999 !important;
        }

        .gm-sticky {
            position: sticky;
            top: 92px;
        }
        @@media (max-width: 991px) {
            .gm-sticky

        {
            position: static;
            top: auto;
        }

        }

        .gm-summary {
            border-radius: 16px;
            border: 1px dashed rgba(13,110,253,.35);
            background: rgba(13,110,253,.04);
            padding: 14px 14px 10px;
        }

            .gm-summary h6 {
                font-weight: 900;
                margin-bottom: 10px;
            }

            .gm-summary .rowline {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                padding: 6px 0;
                border-bottom: 1px dashed rgba(0,0,0,.08);
            }

                .gm-summary .rowline:last-child {
                    border-bottom: 0;
                }

            .gm-summary .k {
                color: #6c757d;
                font-size: .875rem;
            }

            .gm-summary .v {
                font-weight: 800;
                text-align: right;
            }

        .gm-banner {
            border-radius: 16px;
            border: 1px solid rgba(25,135,84,.18);
            background: rgba(25,135,84,.06);
            padding: 14px 16px;
        }

            .gm-banner b {
                font-weight: 900;
            }

        .gm-actions {
            position: sticky;
            bottom: 12px;
            z-index: 10;
        }

            .gm-actions .gm-actions-inner {
                background: rgba(255,255,255,.92);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(0,0,0,.06);
                border-radius: 16px;
                padding: 12px;
                box-shadow: 0 8px 22px rgba(0,0,0,.06);
                display: flex;
                justify-content: space-between;
                gap: 12px;
                align-items: center;
            }
        @@media (max-width: 991px) {
            .gm-actions

        {
            position: static;
        }

        }

        /* ===== FilePond: chỉ giữ Dropzone, ẩn list preview dọc ===== */
        .gm-pond-wrap .filepond--list-scroller {
            display: none !important;
        }

        .gm-pond-wrap .filepond--items {
            display: none !important;
        }

        .gm-pond-wrap .filepond--panel-root {
            border-radius: 14px;
        }

        .gm-pond-wrap .filepond--drop-label {
            min-height: 120px;
        }

        .gm-pond-wrap .filepond--root {
            margin-bottom: 0;
        }

        /* ===== Main preview (1 ảnh) ===== */
        /* Preview lớn – tỉ lệ 16:9, thấp gọn */
        .gm-main-preview {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9; /* 🔥 KEY */
            max-height: 150px; /* giới hạn tối đa cho màn nhỏ */
            border-radius: 14px;
            border: 1px solid rgba(0,0,0,.08);
            background: #fff;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .gm-main-preview img {
                width: 100%;
                height: 100%;
                object-fit: contain; /* thấy trọn ảnh */
                background: #fff;
            }


        .gm-main-empty {
            color: #6c757d;
            font-size: .9rem;
            padding: 10px 12px;
            text-align: center;
        }

        .gm-main-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(13,110,253,.92);
            color: #fff;
            font-weight: 900;
            font-size: 12px;
            padding: 4px 8px;
            border-radius: 999px;
        }

        .gm-main-tip {
            margin-top: 8px;
            font-size: .85rem;
            color: #6c757d;
        }

        /* ===== Thumb strip ngang ===== */
        .gm-thumbbar-title {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 12px;
            margin-bottom: 10px;
        }

        .gm-thumbstrip {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding: 8px;
            border-radius: 14px;
            border: 1px dashed rgba(13,110,253,.30);
            background: rgba(13,110,253,.03);
        }

            .gm-thumbstrip::-webkit-scrollbar {
                height: 10px;
            }

            .gm-thumbstrip::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.15);
                border-radius: 999px;
            }

            .gm-thumbstrip::-webkit-scrollbar-track {
                background: rgba(0,0,0,.05);
                border-radius: 999px;
            }

        .gm-thumb {
            width: 92px;
            min-width: 92px;
            height: 68px;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(0,0,0,.08);
            background: #fff;
            cursor: pointer;
        }

            .gm-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .gm-thumb.is-active {
                outline: 2px solid rgba(13,110,253,.45);
            }

            .gm-thumb.is-primary {
                outline: 2px solid rgba(13,110,253,.75);
            }

            .gm-thumb .gm-remove {
                position: absolute;
                top: 6px;
                right: 6px;
                width: 20px;
                height: 20px;
                border-radius: 999px;
                border: 0;
                background: rgba(0,0,0,.55);
                color: #fff;
                font-weight: 900;
                line-height: 20px;
                text-align: center;
                cursor: pointer;
            }

                .gm-thumb .gm-remove:hover {
                    background: rgba(220,53,69,.85);
                }

            .gm-thumb .gm-primary-badge {
                position: absolute;
                left: 6px;
                bottom: 6px;
                padding: 3px 7px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 900;
                background: rgba(13,110,253,.92);
                color: #fff;
                display: none;
            }

            .gm-thumb.is-primary .gm-primary-badge {
                display: inline-block;
            }
        /* ✅ Dropzone gọn hơn */
        .gm-pond-wrap .filepond--drop-label {
            min-height: 72px !important; /* 🔽 giảm thêm */
            padding: 8px 10px !important;
            font-size: .9rem;
        }

        .gm-pond-wrap .filepond--panel-root {
            border-radius: 12px;
        }

        .gm-pond-wrap .filepond--label-action {
            text-decoration: none;
            font-weight: 800;
        }

        /* (tuỳ chọn) giảm padding tổng của filepond */
        .gm-pond-wrap .filepond--root {
            margin-bottom: 0;
        }
        /* ✅ Drag & drop vào main preview không mở tab mới + có viền đẹp */
        .gm-main-preview.is-drag {
            outline: 2px dashed rgba(13,110,253,.6);
            outline-offset: 4px;
            background: rgba(13,110,253,.04);
        }

    </style>
    <link href="~/admin/css/product-setup-workspace.css" rel="stylesheet" asp-append-version="true" />
}

@section header {
    <div class="py-2">
        <h3 class="mb-0 fw-bold">Tạo sản phẩm</h3>
        <div class="text-muted mt-1">Điền theo thứ tự từ trên xuống. Mục có dấu <span class="text-danger">*</span> là bắt buộc.</div>
    </div>
}

<div class="gm-page product-setup-workspace"
     data-product-setup-workspace
     data-product-setup-stage="create">
    <form asp-area="Admin"
          asp-controller="Product"
          asp-action="Create"
          id="productSetupForm"
          method="post"
          novalidate
          data-submit-guard
          data-upload-state="ready"
          data-submit-loading-text="Đang lưu...">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="row g-3">
            <!-- LEFT -->
            <div class="col-lg-8">
                <div class="card gm-card mb-3">
                    <div class="card-header">1) Thông tin chung</div>
                    <div class="card-body">

                        <div class="gm-section-title"><span class="dot"></span> Thông tin cơ bản</div>

                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label req" for="txtName">Tên sản phẩm</label>
                                <input asp-for="Name" class="form-control" autocomplete="off" id="txtName" placeholder="VD: Nước Lavie 500ml" />
                                <div class="help">Tên hiển thị cho khách hàng.</div>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label" for="txtAlias">Mã hiển thị (Alias)</label>
                                <div class="input-group">
                                    <input asp-for="Alias" class="form-control" id="txtAlias" readonly tabindex="-1" placeholder="Tự động tạo" />
                                    <button class="btn btn-outline-secondary" type="button" id="btnRegenAlias" title="Tạo lại alias theo tên">⟳</button>
                                </div>
                                <div class="help">Tự sinh theo tên. Nếu trùng sẽ tự thêm -1, -2…</div>
                                <span asp-validation-for="Alias" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Danh mục</label>
                                <select asp-for="CategoryId" class="form-select select2" id="ddlCategory" data-placeholder="Chọn danh mục...">
                                    <option value=""></option>
                                    @foreach (var x in categories)
                                    {
                                        <option value="@x.Value">@x.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Nhà cung cấp</label>
                                <select asp-for="SupplierId" class="form-select select2" id="ddlSupplier" data-placeholder="Chọn nhà cung cấp...">
                                    <option value=""></option>
                                    @foreach (var x in suppliers)
                                    {
                                        <option value="@x.Value">@x.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label req">Đơn vị cơ bản</label>
                                <select asp-for="BaseUnitId" class="form-select select2" id="ddlUnit" data-placeholder="Chọn đơn vị...">
                                    <option value=""></option>
                                    @foreach (var x in units)
                                    {
                                        <option value="@x.Value">@x.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="BaseUnitId" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="gm-section-title"><span class="dot"></span> Giá & tuỳ chọn</div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Giá bán lẻ</label>
                                <input asp-for="BasePrice" class="form-control" id="txtBasePrice" type="number" min="0" step="1000" placeholder="VD: 12000" />
                                <div class="help">Dùng khi biến thể hoặc đơn vị bán chưa có giá riêng.</div>
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thương hiệu</label>
                                <select asp-for="BrandId" class="form-select select2" id="ddlBrand" data-placeholder="(Không bắt buộc)">
                                    <option value=""></option>
                                    @foreach (var x in brands)
                                    {
                                        <option value="@x.Value">@x.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Thuế</label>
                                <select asp-for="TaxId" class="form-select select2" id="ddlTax" data-placeholder="(Không bắt buộc)">
                                    <option value=""></option>
                                    @foreach (var x in taxes)
                                    {
                                        <option value="@x.Value">@x.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch psw-pos-switch">
                                    <input asp-for="IsSellable" class="form-check-input" role="switch" />
                                    <label asp-for="IsSellable" class="form-check-label fw-bold">Cho phép bán tại POS</label>
                                    <div class="help mb-0">Tắt nếu sản phẩm mới chỉ được tạo để nhập kho và còn chờ hoàn thiện mã, giá bán hoặc thông tin danh mục.</div>
                                    <span class="psw-pos-state" data-pos-state>Đang tắt</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mô tả ngắn</label>
                                <input asp-for="Description" class="form-control" id="txtDesc" placeholder="VD: Chai 500ml, nước khoáng thiên nhiên..." />
                                <div class="help">Hiển thị nhanh ở danh sách/hoá đơn.</div>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Nội dung chi tiết</label>
                                <textarea asp-for="Content" class="form-control" rows="7" placeholder="Thông tin chi tiết cho sản phẩm..."></textarea>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">
                <div class="gm-sticky">

                    <div class="card gm-card mb-3">
                        <div class="card-header">2) Hình ảnh</div>
                        <div class="card-body">

                            <div class="gm-pond-wrap">
                                <input type="file" id="productImages" name="file" multiple />
                            </div>

                            <!-- Preview lớn: chỉ 1 ảnh -->
                            <div class="gm-main-preview mt-3" id="mainPreview">
                                <div class="gm-main-empty">Chưa chọn ảnh. Kéo thả hoặc bấm Browse để thêm ảnh.</div>
                                <img id="mainPreviewImg" alt="preview" style="display:none;" />
                                <div class="gm-main-badge" id="mainBadge" style="display:none;">ẢNH CHÍNH</div>
                            </div>
                            <div class="psw-context-help">
                                <i class="bx bx-info-circle fs-5"></i>
                                <span>Kéo thả để đổi thứ tự; chọn thumbnail để xem và đặt ảnh đang xem làm ảnh chính.</span>
                            </div>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm w-100 mt-2"
                                    id="btnSetPrimaryImage"
                                    data-set-primary-image>
                                <i class="bx bx-star me-1"></i> Đặt ảnh đang xem làm ảnh chính
                            </button>
                            <div class="psw-upload-state mt-2" id="productUploadState" aria-live="polite">
                                <i class="bx bx-check-circle"></i>
                                <span>Ảnh đã sẵn sàng.</span>
                            </div>


                            <!-- Thumbnail strip -->
                            <div class="gm-thumbbar mt-3">
                                <div class="gm-thumbbar-title">
                                    <div class="fw-bold">Ảnh đã chọn</div>
                                    <div class="small text-muted">Kéo ngang để xem thêm</div>
                                </div>
                                <div id="thumbStrip" class="gm-thumbstrip"></div>
                            </div>

                            <div class="help mt-2">Bạn có thể xóa ảnh bằng nút × trên thumbnail.</div>

                            <input type="hidden" id="TempImageTokensJson" name="TempImageTokensJson" />
                            <input type="hidden" id="PrimaryTempToken" name="PrimaryTempToken" />
                        </div>
                    </div>

                    <div class="d-none" aria-hidden="true">
                        <span id="sumName">—</span>
                        <span id="sumCategory">—</span>
                        <span id="sumSupplier">—</span>
                        <span id="sumUnit">—</span>
                        <span id="sumImages">0</span>
                        <span class="d-none" id="sumBrand">—</span>
                        <span class="d-none" id="sumTax">—</span>
                        <span class="d-none" id="sumPrice">—</span>
                    </div>

                </div>
            </div>
        </div>

        <section id="variants"
                 class="psw-variant-locked"
                 data-variant-step-locked
                 aria-disabled="true">
            <div class="psw-step-number">3</div>
            <div>
                <h5>Thiết lập biến thể</h5>
                <p>Sau khi lưu thông tin chung, phần này sẽ mở ngay trên màn hình chỉnh sửa để bạn tạo màu sắc, kích cỡ hoặc quy cách sản phẩm.</p>
            </div>
            <span class="psw-lock-pill"><i class="bx bx-lock-alt"></i> Cần lưu sản phẩm</span>
        </section>

        <!-- ACTION BAR -->
        <div class="gm-actions mt-3">
            <div class="gm-actions-inner">
                <div class="psw-progress" data-completion-progress data-readiness-checklist>
                    <button type="button"
                            class="psw-progress-trigger"
                            data-completion-toggle
                            aria-expanded="false"
                            aria-controls="productCompletionPanel">
                        <span class="psw-progress-title">
                            <span>Hoàn thiện hồ sơ</span>
                            <strong class="psw-progress-percent"><span data-completion-percent>0</span>%</strong>
                        </span>
                        <span class="psw-progress-track"
                              data-completion-track
                              role="progressbar"
                              aria-label="Mức độ hoàn thiện hồ sơ"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              aria-valuenow="0">
                            <span class="psw-progress-bar" data-completion-bar></span>
                        </span>
                        <span class="psw-progress-meta">
                            <span data-completion-count>0/10 tiêu chí hoàn tất</span>
                            <span data-product-save-state>Chưa lưu</span>
                        </span>
                    </button>

                    <div class="psw-completion-backdrop" data-completion-backdrop hidden></div>
                    <section class="psw-completion-panel"
                             id="productCompletionPanel"
                             data-completion-panel
                             aria-label="Chi tiết hoàn thiện hồ sơ"
                             hidden>
                        <div class="psw-completion-head">
                            <div>
                                <h6>Hoàn thiện hồ sơ sản phẩm</h6>
                                <p><span data-completion-count>0/10 tiêu chí hoàn tất</span> · không chặn thao tác lưu.</p>
                            </div>
                            <button type="button" class="btn-close" data-completion-close aria-label="Đóng"></button>
                        </div>
                        <div class="psw-completion-body">
                            <div class="psw-completion-group">
                                <div class="psw-completion-group-title">Bắt buộc / nền tảng</div>
                                <button type="button" class="psw-completion-item" data-readiness-item="name" data-completion-target="#txtName"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Tên sản phẩm</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="alias" data-completion-target="#txtName"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Mã hiển thị</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="category" data-completion-target="#ddlCategory"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Danh mục</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="supplier" data-completion-target="#ddlSupplier"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Nhà cung cấp</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="unit" data-completion-target="#ddlUnit"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Đơn vị cơ bản</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="variant" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Biến thể đã lưu</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                            </div>
                            <div class="psw-completion-group">
                                <div class="psw-completion-group-title">Khuyến nghị bán hàng</div>
                                <button type="button" class="psw-completion-item" data-readiness-item="price" data-completion-target="#txtBasePrice"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Giá bán lẻ</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="images" data-completion-target=".gm-pond-wrap"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Ảnh chính</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="selling-unit" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Đơn vị bán đang hoạt động</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                                <button type="button" class="psw-completion-item" data-readiness-item="barcode" data-completion-target="#variants"><span class="psw-completion-icon"><i class="bx bx-right-arrow-alt"></i></span><span class="psw-completion-label">Barcode đang hoạt động</span><span class="psw-completion-status" data-readiness-status>Chưa có</span></button>
                            </div>
                            <div class="psw-pos-summary"><span>Trạng thái bán tại POS</span><strong class="psw-pos-state" data-pos-state>Đang tắt</strong></div>
                        </div>
                    </section>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-lg" type="submit" data-product-primary-action>
                        Lưu và thiết lập biến thể
                    </button>
                    <a class="btn btn-light btn-lg" asp-area="Admin" asp-controller="Product" asp-action="Index">Quay lại</a>
                </div>
            </div>
        </div>

    </form>
</div>

@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/lib/filepond/filepond.min.js" asp-append-version="true"></script>
    <script src="~/lib/filepond/filepond-plugin-image-preview.min.js" asp-append-version="true"></script>
}

@section PageScripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        /* =========================
           0) Select2
        ========================== */
        function initSelect2(ctx) {
            if (!window.jQuery || !$.fn.select2) return;

            $(ctx).find('select.select2').each(function () {
                const $el = $(this);
                if ($el.data('select2')) return;

                $el.select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    allowClear: true,
                    placeholder: $el.data('placeholder') || 'Chọn...',
                    dropdownParent: $('body'),
                    closeOnSelect: true,
                    selectOnClose: false
                });
            });
        }

        $(document).on('keydown', '.select2-selection', function (e) {
            const k = e.key || e.which || e.keyCode;
            const isDown = (k === 'ArrowDown' || k === 40);
            const isEnter = (k === 'Enter' || k === 13);
            if (!isDown && !isEnter) return;

            e.preventDefault();
            const $select = $(this).closest('.select2-container').prev('select');
            if ($select.length) $select.select2('open');
        });

        $(document).on('select2:open', function () {
            setTimeout(() => {
                const f = document.querySelector('.select2-container--open .select2-search__field');
                if (f) f.focus();
            }, 0);
        });

        /* =========================
           1) FLOW: Enter -> Next
        ========================== */
        const FLOW = [
            '#txtName',
            '#ddlCategory',
            '#ddlSupplier',
            '#ddlUnit',
            '#ddlBrand',
            '#ddlTax',
            '#txtBasePrice',
            '#txtDesc'
        ];

        function isSelect2(elOrSelector) {
            const $el = $(elOrSelector);
            return $el.is('select') && $el.hasClass('select2') && $el.data('select2');
        }

        function focusField(selector) {
            const $el = $(selector);
            if (!$el.length) return;

            if (isSelect2($el)) {
                $el.select2('open');
                return;
            }

            $el.focus();
            if ($el.is('input, textarea')) {
                try { $el.select(); } catch { }
            }
        }

        function nextField(currentSelector) {
            const idx = FLOW.indexOf(currentSelector);
            if (idx < 0) return null;

            for (let i = idx + 1; i < FLOW.length; i++) {
                if ($(FLOW[i]).length) return FLOW[i];
            }
            return null;
        }

        $(document).on('keydown', FLOW.join(','), function (e) {
            if (e.key !== 'Enter') return;
            if ($(this).is('textarea')) return;

            e.preventDefault();
            const sel = '#' + (this.id || '');
            const nxt = nextField(sel);
            if (nxt) focusField(nxt);
        });

        $(document).on('select2:close', '#ddlCategory, #ddlSupplier, #ddlUnit, #ddlBrand, #ddlTax', function () {
            const cur = '#' + this.id;
            const nxt = nextField(cur);
            if (nxt) setTimeout(() => focusField(nxt), 0);
        });

        /* =========================
           2) Alias unique (an toàn null)
        ========================== */
        let aliasTimer = null;
        const $name = document.getElementById('txtName');
        const $alias = document.getElementById('txtAlias');

        async function refreshAlias() {
            if (!$name || !$alias) return;

            const input = ($name.value || '').trim();
            if (!input) { $alias.value = ''; return; }

            const url = '@Url.Action("GetUniqueAlias", "Product", new { area = "Admin" })'
                + '?input=' + encodeURIComponent(input);

            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) return;
                const data = await res.json();
                $alias.value = data.alias || '';
                window.GaoProductSetup?.syncReadiness();
            } catch { }
        }

        if ($name) {
            $name.addEventListener('input', function () {
                clearTimeout(aliasTimer);
                aliasTimer = setTimeout(refreshAlias, 250);
                syncSummary();
            });
        }

        document.getElementById('btnRegenAlias')?.addEventListener('click', function () {
            refreshAlias();
        });

        /* =========================
           3) Ctrl + Enter = Lưu
        ========================== */
        document.addEventListener('keydown', function (e) {
            if (!(e.ctrlKey && e.key === 'Enter')) return;

            const form = document.querySelector('form');
            if (!form) return;

            e.preventDefault();
            try { $('.select2').select2('close'); } catch { }

            form.requestSubmit ? form.requestSubmit() : form.submit();
        });

        /* =========================
           4) Summary + FilePond + Main preview + Thumbs
        ========================== */
        function getCsrf() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        let pond = null;
        let primaryToken = '';
        let activePondId = '';
        let mainBlobUrl = '';

        function hasPendingProductUploads() {
            return !!pond && pond.getFiles().some(file => !file.serverId);
        }

        function syncProductUploadState() {
            const pending = hasPendingProductUploads();
            const form = document.getElementById('productSetupForm');
            const submit = form?.querySelector('[data-product-primary-action]');

            if (form) form.dataset.uploadState = pending ? 'pending' : 'ready';
            if (submit) submit.disabled = pending;

            window.GaoProductSetup?.setUploadState({
                pending,
                count: pond ? pond.getFiles().length : 0
            });
        }

        function setActiveImageAsPrimary() {
            if (!pond || !activePondId) return;

            const current = pond.getFiles().find(file => file.id === activePondId);
            const token = current?.serverId || '';
            if (!token) {
                toastr?.info('Vui lòng chờ ảnh tải lên xong.');
                syncProductUploadState();
                return;
            }

            primaryToken = token;
            $('#PrimaryTempToken').val(primaryToken);
            rebuildThumbStrip();
            toastr?.success('Đã chọn ảnh chính.');
        }

                function ensurePrimaryAfterProcess(item) {
            if (!item || !item.serverId) return;

            if (!primaryToken) {
                primaryToken = item.serverId;
                $('#PrimaryTempToken').val(primaryToken);
            }

            const tokens = pond ? pond.getFiles().map(f => f.serverId).filter(Boolean) : [];
            if (primaryToken && tokens.length && !tokens.includes(primaryToken)) {
                primaryToken = tokens[0];
                $('#PrimaryTempToken').val(primaryToken);
            }
        }

        function syncSummary(imagesCountOverride) {
            const name = ($('#txtName').val() || '').toString().trim();
            $('#sumName').text(name || '—');

            const cat = $('#ddlCategory option:selected').text();
            $('#sumCategory').text($('#ddlCategory').val() ? cat : '—');

            const sup = $('#ddlSupplier option:selected').text();
            $('#sumSupplier').text($('#ddlSupplier').val() ? sup : '—');

            const unit = $('#ddlUnit option:selected').text();
            $('#sumUnit').text($('#ddlUnit').val() ? unit : '—');

            const brand = $('#ddlBrand option:selected').text();
            $('#sumBrand').text($('#ddlBrand').val() ? brand : '—');

            const tax = $('#ddlTax option:selected').text();
            $('#sumTax').text($('#ddlTax').val() ? tax : '—');

            const priceVal = ($('#txtBasePrice').val() || '').toString().trim();
            $('#sumPrice').text(priceVal ? priceVal : '—');

            if (typeof imagesCountOverride === 'number') {
                $('#sumImages').text(imagesCountOverride);
                return;
            }
            if (pond) $('#sumImages').text(pond.getFiles().length);
        }

        function clearMainBlob() {
            if (mainBlobUrl) {
                try { URL.revokeObjectURL(mainBlobUrl); } catch { }
                mainBlobUrl = '';
            }
        }

        function setMainPreviewFromItem(item) {
            const img = document.getElementById('mainPreviewImg');
            const empty = document.querySelector('#mainPreview .gm-main-empty');
            const badge = document.getElementById('mainBadge');

            if (!img || !badge) return;

            if (!item) {
                clearMainBlob();
                img.style.display = 'none';
                badge.style.display = 'none';
                if (empty) empty.style.display = 'block';
                activePondId = '';
                return;
            }

            if (empty) empty.style.display = 'none';
            img.style.display = 'block';

            clearMainBlob();
            mainBlobUrl = URL.createObjectURL(item.file);
            img.src = mainBlobUrl;

            activePondId = item.id;

            const token = item.serverId || '';
            badge.style.display = (token && token === primaryToken) ? 'block' : 'none';
        }

        function rebuildThumbStrip() {
            const strip = document.getElementById('thumbStrip');
            if (!strip) return;

            strip.innerHTML = '';
            if (!pond) return;

            const files = pond.getFiles();

            if (!activePondId && files.length) activePondId = files[0].id;

            // nếu chưa có primary, ưu tiên file đầu có serverId
            if (!primaryToken) {
                const firstWithToken = files.find(x => x.serverId);
                if (firstWithToken) {
                    primaryToken = firstWithToken.serverId;
                    $('#PrimaryTempToken').val(primaryToken);
                }
            }

            files.forEach((item) => {
                const token = item.serverId || '';

                const thumb = document.createElement('div');
                thumb.className = 'gm-thumb';
                thumb.dataset.pondId = item.id;
                thumb.dataset.token = token;

                if (item.id === activePondId) thumb.classList.add('is-active');
                if (token && token === primaryToken) thumb.classList.add('is-primary');

                const img = document.createElement('img');
                const blob = URL.createObjectURL(item.file);
                img.src = blob;
                img.onload = () => { try { URL.revokeObjectURL(blob); } catch { } };

                const btnRemove = document.createElement('button');
                btnRemove.type = 'button';
                btnRemove.className = 'gm-remove';
                btnRemove.innerHTML = '&times;';

                const badge = document.createElement('span');
                badge.className = 'gm-primary-badge';
                badge.textContent = 'CHÍNH';

                thumb.addEventListener('click', function () {
                    const pondId = this.dataset.pondId;
                    const f = pond.getFiles().find(x => x.id === pondId);
                    if (!f) return;

                    activePondId = f.id;
                    document.querySelectorAll('.gm-thumb').forEach(x => x.classList.remove('is-active'));
                    this.classList.add('is-active');
                    setMainPreviewFromItem(f);
                });

                thumb.addEventListener('dblclick', function (e) {
                    e.preventDefault();
                    activePondId = this.dataset.pondId || activePondId;
                    setActiveImageAsPrimary();
                });

                btnRemove.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const pondId = thumb.dataset.pondId;
                    pond.removeFile(pondId, { revert: true });
                });

                thumb.appendChild(img);
                thumb.appendChild(btnRemove);
                thumb.appendChild(badge);
                strip.appendChild(thumb);
            });

            const current = pond.getFiles().find(x => x.id === activePondId) || pond.getFiles()[0];
            setMainPreviewFromItem(current);

            syncSummary(files.length);
        }

        function updateHiddenTokensBeforeSubmit() {
            const tokens = pond ? pond.getFiles().map(f => f.serverId).filter(x => x) : [];
            $('#TempImageTokensJson').val(JSON.stringify(tokens));

            if (tokens.length) {
                if (!primaryToken || !tokens.includes(primaryToken)) primaryToken = tokens[0];
                $('#PrimaryTempToken').val(primaryToken);
            } else {
                primaryToken = '';
                $('#PrimaryTempToken').val('');
            }
        }

        // ✅ KÉO THẢ VÀO MAIN PREVIEW: chặn open tab mới + add vào FilePond
        function bindMainPreviewDrop() {
            const preview = document.getElementById('mainPreview');
            if (!preview) return;

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
                preview.addEventListener(evt, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }, true);
            });

            preview.addEventListener('dragenter', () => preview.classList.add('is-drag'), true);
            preview.addEventListener('dragleave', () => preview.classList.remove('is-drag'), true);

            preview.addEventListener('drop', function (e) {
                preview.classList.remove('is-drag');
                if (!pond) return;

                const dt = e.dataTransfer;
                if (!dt) return;

                const files = Array.from(dt.files || []);
                if (!files.length) return;

                for (const f of files) {
                    if (!f.type || !f.type.startsWith('image/')) continue;
                    pond.addFile(f);
                }
            }, true);
        }

        $(function () {
            initSelect2(document);
            setTimeout(() => focusField('#txtName'), 120);

            refreshAlias();
            syncSummary(0);

            $(document).on('change input', '#ddlCategory, #ddlSupplier, #ddlUnit, #ddlBrand, #ddlTax, #txtBasePrice, #txtDesc, #IsSellable', syncSummary);
            $(document).on('select2:select select2:clear', '#ddlCategory, #ddlSupplier, #ddlUnit, #ddlBrand, #ddlTax', syncSummary);

            if (window.FilePondPluginImagePreview) {
                FilePond.registerPlugin(FilePondPluginImagePreview);
            }

            const input = document.querySelector('#productImages');
            if (input && window.FilePond) {
                pond = FilePond.create(input, {
                    allowMultiple: true,
                    name: 'file',
                    allowImagePreview: false,
                    labelIdle: 'Kéo thả ảnh hoặc <span class="filepond--label-action">Chọn ảnh</span>',
                    server: {
                        process: {
                            url: '/admin/media/temp',
                            method: 'POST',
                            headers: { 'RequestVerificationToken': getCsrf() }
                        },
                        revert: {
                            url: '/admin/media/temp',
                            method: 'DELETE',
                            headers: { 'RequestVerificationToken': getCsrf() }
                        }
                    }
                });

                pond.on('addfile', () => {
                    rebuildThumbStrip();
                    syncProductUploadState();
                });
                       pond.on('processfile', (error, file) => {
            if (!error) ensurePrimaryAfterProcess(file);
            rebuildThumbStrip();
            syncProductUploadState();
        });

                      pond.on('removefile', () => {

            // 🔴 BƯỚC 1: nếu ảnh bị xóa là ảnh chính → chọn ảnh còn lại làm primary
            const tokens = pond.getFiles()
                .map(f => f.serverId)
                .filter(Boolean);

            if (primaryToken && tokens.length && !tokens.includes(primaryToken)) {
                primaryToken = tokens[0]; // lấy ảnh đầu còn lại
                $('#PrimaryTempToken').val(primaryToken);
            }

            // 🔴 BƯỚC 2: cập nhật active preview
            const left = pond.getFiles();
            activePondId = left.length ? left[0].id : '';

            // 🔴 BƯỚC 3: rebuild UI
            rebuildThumbStrip();
            syncProductUploadState();
        });

                pond.on('processfileabort', syncProductUploadState);
                pond.on('processfilerevert', syncProductUploadState);
                pond.on('error', syncProductUploadState);


                rebuildThumbStrip();
                syncSummary(pond.getFiles().length);
                syncProductUploadState();

                // ✅ bind drop vào preview sau khi pond có rồi
                bindMainPreviewDrop();
            } else {
                setMainPreviewFromItem(null);
                syncSummary(0);
                syncProductUploadState();
            }

            document.getElementById('btnSetPrimaryImage')
                ?.addEventListener('click', setActiveImageAsPrimary);

            $('#productSetupForm').on('submit', function (event) {
                if (hasPendingProductUploads()) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    syncProductUploadState();
                    toastr?.warning('Vui lòng chờ tất cả hình ảnh tải lên xong trước khi lưu.');
                    return false;
                }

                updateHiddenTokensBeforeSubmit();
                return true;
            });
        });
    </script>
    <script src="~/admin/js/product-setup-workspace.js" asp-append-version="true"></script>
}
