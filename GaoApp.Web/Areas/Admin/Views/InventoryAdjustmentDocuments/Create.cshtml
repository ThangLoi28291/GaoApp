@{
    ViewData["Title"] = "Tạo phiếu điều chỉnh kho";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Admin/css/inventory-adjustment-documents.css" />
}

<div class="container-xxl flex-grow-1 container-p-y adj-page"
     data-mode="create"
     data-document-id="0">

    @await Html.PartialAsync("_AdjustmentDocumentForm")
</div>

@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
}

@section PageScripts {
    <script src="~/Admin/js/inventory-adjustment-document-form.js"></script>
}