@{
    ViewData["Title"] = "Sửa phiếu điều chỉnh kho";
    Layout = "_ContentNavbarLayout";
    var id = ViewBag.Id ?? 0;
}

@section VendorStyles {
    <link href="~/lib/select2/select2.min.css" rel="stylesheet"  asp-append-version="true" />
    <link href="~/lib/select2/select2-bootstrap-5-theme.min.css" rel="stylesheet"  asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/inventory-adjustment-documents.css"  asp-append-version="true" />
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/inventory-adjustment-documents.mobile.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y adj-page"
     data-mode="edit"
     data-document-id="@id">

    @await Html.PartialAsync("_AdjustmentDocumentForm")
</div>

@section VendorScripts {
    <script src="~/lib/select2/select2.min.js" asp-append-version="true"></script>
}

@section PageScripts {
    <script src="~/Admin/js/inventory-adjustment-document-form.js" asp-append-version="true"></script>
    <script src="~/Admin/js/inventory-adjustment-documents.mobile.js" asp-append-version="true"></script>
}