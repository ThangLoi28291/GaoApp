@model GaoApp.Application.Storefront.StorefrontShippingZoneRequest
@{
    ViewData["Title"] = Model.Id.HasValue ? "Sửa vùng giao" : "Thêm vùng giao";
}
<div class="container py-3">
    <h1 class="h3">@ViewData["Title"]</h1>
    <p>Phí áp dụng theo chế độ @(ViewBag.ByWeight == true ? "tổng kg" : "cố định") đã lưu trong cấu hình website.</p>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <form asp-action="SaveZone" method="post" class="card"><div class="card-body">
        <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
        <input asp-for="SettingsVersion" type="hidden" />
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Code" class="form-label">Mã vùng</label><input asp-for="Code" class="form-control" required maxlength="40" /></div>
            <div class="col-md-8"><label asp-for="Name" class="form-label">Tên vùng</label><input asp-for="Name" class="form-control" required maxlength="200" /></div>
            <div class="col-md-4"><label asp-for="DeliveryMethod" class="form-label">Hình thức</label><select asp-for="DeliveryMethod" class="form-select"><option value="0">Giao gần</option><option value="1">Toàn quốc</option></select></div>
            <div class="col-md-4"><label asp-for="ProvinceCode" class="form-label">Mã tỉnh/thành</label><input asp-for="ProvinceCode" class="form-control" maxlength="20" /></div>
            <div class="col-md-4"><label asp-for="WardCode" class="form-label">Mã phường/xã (nếu giới hạn)</label><input asp-for="WardCode" class="form-control" maxlength="20" /></div>
            <div class="col-12">Vùng toàn quốc có thể để trống tỉnh và xã. Giao gần cần chọn phạm vi tỉnh; vùng cụ thể sẽ được ưu tiên khi báo giá.</div>
            <div class="col-md-6"><label asp-for="BaseFee" class="form-label">Phí cố định / mức đầu (đ)</label><input asp-for="BaseFee" class="form-control" type="number" min="0" step="1" required /></div>
            <div class="col-md-6"><label asp-for="FreeFromGoodsAmount" class="form-label">Miễn ship từ tiền hàng (đ, để trống nếu không dùng)</label><input asp-for="FreeFromGoodsAmount" class="form-control" type="number" min="1" step="1" /></div>
            <div class="col-md-4"><label asp-for="FirstWeightKg" class="form-label">Kg mức đầu</label><input asp-for="FirstWeightKg" class="form-control" type="number" min="0.000001" step="0.000001" required /></div>
            <div class="col-md-4"><label asp-for="AdditionalStepKg" class="form-label">Kg mỗi bước thêm</label><input asp-for="AdditionalStepKg" class="form-control" type="number" min="0.000001" step="0.000001" required /></div>
            <div class="col-md-4"><label asp-for="AdditionalFee" class="form-label">Phí mỗi bước thêm (đ)</label><input asp-for="AdditionalFee" class="form-control" type="number" min="0" step="1" required /></div>
            <div class="col-md-6"><label asp-for="MinDeliveryDays" class="form-label">Giao sớm nhất (ngày)</label><input asp-for="MinDeliveryDays" class="form-control" type="number" min="0" max="365" /></div>
            <div class="col-md-6"><label asp-for="MaxDeliveryDays" class="form-label">Giao chậm nhất (ngày)</label><input asp-for="MaxDeliveryDays" class="form-control" type="number" min="0" max="365" /></div>
            <div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Sử dụng vùng giao</label></div>
        </div>
        <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Lưu vùng giao</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
    </div></form>
</div>
