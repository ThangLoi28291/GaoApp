@using GaoApp.Application.Storefront
@using GaoApp.Domain.Storefront
@model StorefrontFulfillmentQueue
@{ ViewData["Title"] = "Chuẩn bị và giao đơn website"; var q = ViewData["Query"] as StorefrontFulfillmentQuery ?? new(); }
<main class="container-fluid py-3 sf-operations"><h1>Chuẩn bị và giao đơn website</h1><p>Tiếp tục xử lý đơn đã nhận cả khi cửa hàng tạm ngừng nhận đơn mới.</p>
<form method="get" class="sf-filter" id="sf-fulfillment-filter"><label>Tìm mã đơn, tên hoặc số điện thoại<input name="Search" value="@q.Search" maxlength="100" /></label>
<label>Trạng thái<select name="Phase"><option value="">Tất cả</option>@foreach (var item in Enum.GetValues<StorefrontOrderPhase>()) { <option value="@((int)item)" selected="@(q.Phase == item)">@item</option> }</select></label>
<label>Giao hàng<select name="DeliveryMethod"><option value="">Tất cả</option><option value="0" selected="@(q.DeliveryMethod == StorefrontDeliveryMethod.Local)">Nội vùng</option><option value="1" selected="@(q.DeliveryMethod == StorefrontDeliveryMethod.Nationwide)">Toàn quốc</option></select></label>
<label>Thanh toán<select name="PaymentMethod"><option value="">Tất cả</option><option value="0" selected="@(q.PaymentMethod == StorefrontPaymentMethod.Cod)">COD</option><option value="1" selected="@(q.PaymentMethod == StorefrontPaymentMethod.Qr)">QR</option></select></label>
<label><input type="checkbox" name="ShortageOnly" value="true" checked="@q.ShortageOnly" /> Chỉ đơn thiếu hàng</label><button class="btn btn-success" type="submit">Lọc đơn</button></form>
@if (Model.Items.Count == 0) { <p role="status" class="alert alert-info">Chưa có đơn phù hợp bộ lọc.</p> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>Đơn</th><th>Người nhận</th><th>Giao / tiền</th><th>Trạng thái</th><th>Tổng đã chốt</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a href="/admin/storefront/fulfillment/@item.Id">@item.Code</a></td><td>@item.RecipientName</td><td>@(item.DeliveryMethod == StorefrontDeliveryMethod.Local ? "Nội vùng" : "Toàn quốc") · @item.PaymentMethod</td><td>@item.Phase · @item.PaymentState @if (item.HasInventoryShortage) { <strong class="text-danger">Thiếu hàng</strong> }</td><td>@item.TotalDue.ToString("#,0") đ</td></tr> }</tbody></table></div> }
<nav aria-label="Phân trang đơn"><span>Trang @Model.Page · @Model.TotalCount đơn</span>@if (Model.Page > 1) { <a asp-action="Index" asp-route-Page="@(Model.Page - 1)" asp-route-PageSize="@q.PageSize" asp-route-Phase="@q.Phase" asp-route-Search="@q.Search" asp-route-ShortageOnly="@q.ShortageOnly" asp-route-DeliveryMethod="@q.DeliveryMethod" asp-route-PaymentMethod="@q.PaymentMethod">Trang trước</a> } @if ((long)Model.Page * Model.PageSize < Model.TotalCount) { <a asp-action="Index" asp-route-Page="@(Model.Page + 1)" asp-route-PageSize="@q.PageSize" asp-route-Phase="@q.Phase" asp-route-Search="@q.Search" asp-route-ShortageOnly="@q.ShortageOnly" asp-route-DeliveryMethod="@q.DeliveryMethod" asp-route-PaymentMethod="@q.PaymentMethod">Trang sau</a> }</nav>
<p>Đường dẫn chức năng: <code>/admin/storefront/fulfillment</code>. Bạn có thể tự thêm vào cấu hình menu theo nhu cầu.</p></main>
@section PageStyles { <link rel="stylesheet" href="~/Admin/css/storefront-fulfillment.css" asp-append-version="true" /> }
