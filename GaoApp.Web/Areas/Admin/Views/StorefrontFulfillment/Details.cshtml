@using GaoApp.Domain.Storefront
@using System.Globalization
@model GaoApp.Web.Areas.Admin.Models.StorefrontFulfillmentPage
@{ ViewData["Title"] = "Giao đơn " + Model.Detail.Code; var d = Model.Detail; var local = d.DeliveryMethod == StorefrontDeliveryMethod.Local; }
<main class="container-fluid py-3 sf-operations" id="sf-operation-page" data-order-id="@d.Id" data-revision="@d.Revision" data-version="@d.Version" data-delivery-method="@((int)d.DeliveryMethod)">
<a href="/admin/storefront/fulfillment">← Danh sách đơn</a><h1>Đơn @d.Code</h1><p>@d.RecipientName · @d.RecipientPhone</p><p>@d.RecipientAddress</p>
<p><strong>@d.Phase</strong> · @(local ? "Nội vùng" : "Toàn quốc") · @Model.Snapshot.PaymentMethod · Tiền: @d.PaymentState</p>
<p>Tiền hàng @Model.Snapshot.GoodsAmountText · Phí giao @Model.Snapshot.ShippingChargeText · Tổng khách trả <strong>@Model.Snapshot.TotalDueText</strong></p>
<p><a href="/admin/storefront/orders/@d.Id">Xem toàn bộ hàng và ưu đãi đã chốt</a> · <a href="/admin/storefront/orders/@d.Id/bank-evidence">Bằng chứng QR</a> · <a href="/admin/storefront/refunds/@d.Id">Hủy đơn và hoàn tiền</a></p>
<div id="sf-operation-status" role="status" aria-live="polite"></div><div id="sf-operation-pending" class="alert alert-warning" hidden></div>
@Html.AntiForgeryToken()
@if (d.HasIncident) { <aside class="alert alert-danger" id="sf-custody-stop"><h2>Dừng bàn giao để đối soát sự cố</h2><p>Hàng có thể đang thực tế ngoài kho. Không bàn giao lần nữa hoặc coi là chưa xuất. Kiểm đếm đủ từng nguồn và đối soát theo chứng từ thực tế bên dưới.</p></aside> }
@if (d.PostingBlockReason is not null) { <p class="alert alert-warning">@d.PostingBlockReason</p> }
@if (Model.CanPrepare && d.Phase == StorefrontOrderPhase.AwaitingPreparation) { <form id="sf-prepare-form" data-operation="prepare"><h2>Bắt đầu chuẩn bị</h2><label>Ghi chú<textarea name="note" maxlength="2000"></textarea></label><button type="submit" class="btn btn-success">Nhận chuẩn bị đơn</button></form> }
@foreach (var child in d.Children) { <section class="sf-source"><h2>@child.WarehouseName · @child.LegalEntityName</h2><p>Trạng thái: @child.Stage @if (child.CourierUserId.HasValue) { <span>· Nhân viên giao cửa hàng</span> } @if (child.CarrierName is not null) { <span>· @child.CarrierName · Mã vận đơn @child.TrackingCode</span> }</p><div class="table-responsive"><table class="table"><thead><tr><th>Hàng</th><th>Cần / đã soạn</th><th>Đã bàn giao</th><th>Đã về kho</th></tr></thead><tbody>@foreach (var line in child.Lines) { <tr><td>@line.Name · @line.UnitName</td><td>@line.BaseQuantity / @line.PickedBaseQuantity @if (line.ShortageBaseQuantity != "0") { <strong class="text-danger">Thiếu @line.ShortageBaseQuantity</strong> }</td><td>@line.DispatchedBaseQuantity</td><td>@line.ReturnedBaseQuantity</td></tr> }</tbody></table></div></section> }
@if (Model.CanPrepare && d.Phase == StorefrontOrderPhase.Preparing && !d.HasIncident && d.Children.Count > 0) {
<form id="sf-pick-form" data-operation="pick"><h2>Ghi kết quả soạn thực tế</h2><p>Nhập tổng lượng đã soạn ở mỗi nguồn theo đơn vị gốc. Thiếu hàng vẫn được lưu; chỉ bàn giao khi đủ toàn bộ.</p>
@foreach (var child in d.Children) { @foreach (var line in child.Lines) { <label data-line-row data-source-id="@child.SourceId" data-order-line-id="@line.OrderLineId">@child.WarehouseName · @line.Name (@line.UnitName), cần @line.BaseQuantity<input type="text" inputmode="decimal" name="baseQuantity" value="@line.PickedBaseQuantity" required pattern="[0-9]+([.][0-9]{1,4})?" /></label> } }
<label>Lý do thiếu / ghi chú<textarea name="note" maxlength="2000"></textarea></label><button class="btn btn-success" type="submit">Lưu kết quả soạn</button></form> }
@if (Model.CanDispatch && d.Phase == StorefrontOrderPhase.Preparing && !d.HasIncident && d.Children.Count > 0) {
<form id="sf-dispatch-form" data-operation="dispatch"><h2>Bàn giao toàn đơn</h2><p>Chỉ xác nhận sau khi đã giao thực tế đủ tất cả nguồn cho bên vận chuyển. Thao tác ghi xuất kho một lần cho toàn đơn.</p>
@foreach (var child in d.Children) { <fieldset data-carrier-row data-source-id="@child.SourceId"><legend>@child.WarehouseName</legend>@if (local) { <label>Nhân viên thực nhận giao<select name="courierUserId" required><option value="">Chọn nhân viên</option>@foreach (var courier in Model.Couriers) { <option value="@courier.Id">@courier.Name</option> }</select></label> } else { <label>Đơn vị giao hàng<input name="carrierName" maxlength="200" required /></label><label>Mã vận đơn thực tế<input name="trackingCode" maxlength="200" required /></label> }</fieldset> }
<label>Chứng cứ / ghi chú bàn giao<textarea name="note" required maxlength="2000"></textarea></label><label><input type="checkbox" required /> Tôi xác nhận đã bàn giao thực tế đủ hàng các nguồn.</label><button class="btn btn-success" type="submit">Xác nhận đã bàn giao toàn đơn</button></form> }
@if (Model.CanDelivery && d.Phase == StorefrontOrderPhase.Shipping && !d.HasIncident) {
<form id="sf-outcome-form" data-operation="outcome"><h2>Kết quả giao thực tế</h2><label>Nguồn giao<select name="fulfillmentSourceId" required>@foreach (var child in d.Children.Where(x => x.Stage == StorefrontFulfillmentStage.Dispatched)) { <option value="@child.SourceId">@child.WarehouseName · @child.CarrierName</option> }</select></label><label>Kết quả<select name="delivered"><option value="true">Đã giao thành công</option><option value="false">Giao thất bại — chờ nhận hàng về</option></select></label><label>Thời điểm thực tế<input type="datetime-local" name="resultOccurredAt" required /></label><label>Mã chứng cứ giao / vận đơn<input name="evidenceReference" maxlength="500" required /></label><label>Nội dung kết quả<textarea name="note" maxlength="2000" required></textarea></label><button class="btn btn-success" type="submit">Ghi kết quả nguồn giao</button></form> }
@if (Model.CanReturn && d.Phase == StorefrontOrderPhase.Shipping && !d.HasIncident && d.Children.Any(x => x.Stage == StorefrontFulfillmentStage.ReturnPending)) {
<form id="sf-return-form" data-operation="return"><h2>Nhận hàng giao thất bại về kho</h2><p>Chỉ nhập lượng vừa thực nhận trong lần này. Nhận trả giữ đúng kho, chủ thể và lát giá vốn của lần xuất.</p>@foreach (var child in d.Children.Where(x => x.Stage == StorefrontFulfillmentStage.ReturnPending)) { @foreach (var line in child.Lines) { <label data-line-row data-source-id="@child.SourceId" data-order-line-id="@line.OrderLineId"><input type="checkbox" name="receive" /> @child.WarehouseName · @line.Name · @line.UnitName<input type="text" inputmode="decimal" name="baseQuantity" value="0" pattern="[0-9]+([.][0-9]{1,4})?" /></label> } }<label>Chứng cứ nhận về<textarea name="note" maxlength="2000" required></textarea></label><button class="btn btn-success" type="submit">Ghi nhận lượng vừa nhận về</button></form> }
@if (Model.CanDispatch && d.Phase is StorefrontOrderPhase.Preparing or StorefrontOrderPhase.Shipping && !d.HasIncident) {
<form id="sf-incident-form" data-operation="incident"><h2>Ghi sự cố hàng thực tế</h2><p>Nếu hàng đã rời kho nhưng kết quả ghi sổ chưa rõ, ghi sự cố và dừng thao tác. Không tự xuất lại.</p>@foreach (var child in d.Children) { <label><input type="checkbox" name="custodySourceId" value="@child.SourceId" /> Nguồn @child.WarehouseName đang thực tế ngoài kho / cần kiểm tra</label> }<label>Mã chứng cứ<input name="evidenceReference" maxlength="500" required /></label><label>Diễn biến thực tế<textarea name="note" maxlength="2000" required></textarea></label><button class="btn btn-outline-danger" type="submit">Ghi sự cố và dừng bàn giao</button></form> }
@if (Model.CanReconcile && d.HasIncident) {
<form id="sf-reconcile-incident-form" data-operation="reconcile-incident" data-incident-id="@Model.OpenIncidentId"><h2>Đối soát sự cố bằng kiểm đếm thực tế</h2><p>Hàng đã có chứng từ xuất chỉ được nhận về theo nguồn xuất. Hàng chưa ghi xuất nhưng thực tế đã bàn giao sẽ được đối soát một lần; không giao vật lý lần thứ hai. Nếu mới có kết quả một phần, giữ dừng để kiểm tra tiếp.</p><label>Kết quả kiểm tra toàn bộ<select name="resolution"><option value="0">Đã thu hồi đủ toàn bộ tại đúng kho nguồn</option><option value="1">Đã bàn giao đủ toàn bộ cho bên vận chuyển</option></select></label>
@foreach (var child in d.Children) { @foreach (var line in child.Lines) { <label data-line-row data-source-id="@child.SourceId" data-order-line-id="@line.OrderLineId">@child.WarehouseName · @line.Name · @line.UnitName, cần đối chiếu @line.BaseQuantity<input name="baseQuantity" inputmode="decimal" type="text" required pattern="[0-9]+([.][0-9]{1,4})?" /></label> } <fieldset data-carrier-row data-source-id="@child.SourceId"><legend>Bên nhận giao @child.WarehouseName (nếu đã bàn giao đủ)</legend>@if (local) { <label>Nhân viên<select name="courierUserId"><option value="">Chọn nhân viên</option>@foreach (var courier in Model.Couriers) { <option value="@courier.Id" selected="@(courier.Id == child.CourierUserId)">@courier.Name</option> }</select></label> } else { <label>Đơn vị giao<input name="carrierName" value="@child.CarrierName" maxlength="200" /></label><label>Mã vận đơn<input name="trackingCode" value="@child.TrackingCode" maxlength="200" /></label> }</fieldset> }
<label>Mã chứng cứ kiểm đếm<input name="evidenceReference" required maxlength="500" /></label><label>Nội dung kiểm tra<textarea name="note" required maxlength="2000"></textarea></label><button class="btn btn-warning" type="submit">Xác nhận đối soát toàn bộ sự cố</button></form> }
<section id="sf-money-summary"><h2>Đối soát tiền và ghi nhận bán</h2><dl><dt>Khách đã trả / đã phân bổ cho đơn</dt><dd>@Model.Money.CustomerPaidText</dd><dt>Cửa hàng thực nhận</dt><dd>@Model.Money.ActualStoreReceivedText</dd><dt>Hãng giữ lại có chứng từ chi phí</dt><dd>@Model.Money.WithheldExpenseText</dd><dt>Người thu còn phải nộp</dt><dd>@Model.Money.CollectorOutstandingText</dd></dl>@if (Model.Money.BlockReason is not null) { <p class="alert alert-warning">@Model.Money.BlockReason</p> } @if (Model.Money.SaleOrderId.HasValue) { <p>Đã ghi nhận bán, nguồn đơn bán #@Model.Money.SaleOrderId.</p> }</section>
@if (Model.CanReconcile && Model.Snapshot.PaymentMethod == StorefrontPaymentMethod.Cod && d.Phase is StorefrontOrderPhase.Shipping or StorefrontOrderPhase.Delivered) {
<form id="sf-customer-paid-form" data-operation="customer-paid"><h2>Ghi tiền khách đã trả cho người giao</h2><p>Đây là tiền khách trả; chưa phải cửa hàng đã nhận tiền từ người giao.</p><label>Nguồn thực giao<select name="fulfillmentSourceId" required>@foreach (var child in d.Children.Where(x => x.Stage == StorefrontFulfillmentStage.Delivered)) { <option value="@child.SourceId">@child.WarehouseName · @child.CarrierName</option> }</select></label><label>Số đồng khách thực trả<input name="amount" inputmode="numeric" pattern="[0-9]+" required /></label><label>Thời điểm khách trả<input type="datetime-local" name="customerPaidAt" required /></label><label>Chứng cứ khách trả<input name="evidenceReference" required maxlength="500" /></label><label>Ghi chú<textarea name="note" maxlength="2000"></textarea></label><button class="btn btn-success" type="submit">Ghi nhận khách đã trả</button></form> }
@if (Model.CanReconcile && Model.Snapshot.PaymentMethod == StorefrontPaymentMethod.Cod && d.Phase == StorefrontOrderPhase.Delivered) {
<form id="sf-import-notification-form" data-operation="import-notification"><h2>Kiểm tra nguồn thông báo ngân hàng</h2><p>Chỉ thông báo tiếp nhận qua thiết bị xác thực và còn đủ nguồn gốc mới được chứng nhận. Thiếu thời gian, trùng định danh hoặc mâu thuẫn vẫn giữ toàn bộ chứng cứ để đối soát.</p><label>Thông báo đã tiếp nhận<select name="notificationReceiptId" required><option value="">Chọn thông báo gốc</option>@foreach (var n in Model.Notifications) { <option value="@n.Id">@n.Name</option> }</select></label><button class="btn btn-outline-success" type="submit">Kiểm tra nguồn gốc thông báo</button></form>
<form id="sf-bank-remittance-form" data-operation="bank-remittance"><h2>Nhận tiền COD đã có bằng chứng ngân hàng</h2><label>Khoản ngân hàng chưa gắn đơn<select name="globalBankReceiptId" required><option value="">Chọn khoản thực nhận hợp lệ</option>@foreach (var r in Model.BankReceipts) { <option value="@r.GlobalReceiptId">@r.AmountText · @r.ExternalId · @r.BankTimeText</option> }</select></label><label>Chủ thể nhận tiền<select name="receivingLegalEntityId" required><option value="">Chọn chủ thể đã có quyền thu nguyên thủy</option>@foreach (var owner in Model.LegalEntities) { <option value="@owner.Id">@owner.Name</option> }</select></label><label>Mã chứng từ đối soát<input name="evidenceReference" maxlength="500" required /></label><label>Ghi chú<textarea name="note" maxlength="2000"></textarea></label><button class="btn btn-success" type="submit">Đối soát khoản ngân hàng vào đơn</button></form>
<form id="sf-cash-remittance-form" data-operation="cash-remittance"><h2>Nhận tiền COD thực nộp tại quầy</h2><p>Dùng phiếu thu tiền mặt tại quầy đã ghi nhận. Không cộng tiền vào két lần nữa khi ghi bán.</p><label>Phiếu thực thu tại quầy<select name="posShiftCashTransactionId" required><option value="">Chọn phiếu thu</option>@foreach (var cash in Model.CashReceipts) { <option value="@cash.Id">@cash.Name</option> }</select></label><label>Ghi chú<textarea name="note" maxlength="2000"></textarea></label><button class="btn btn-success" type="submit">Đối soát phiếu tiền mặt vào đơn</button></form>
<form id="sf-withholding-form" data-operation="withholding"><h2>Khoản hãng giao giữ lại</h2><p>Cần chi phí đã ghi nhận và chứng từ hãng giữ lại. Khoản này cấn trừ tiền phải nộp; không sinh thêm phiếu chi quỹ.</p><label>Chi phí đã ghi nhận, chưa thanh toán<select name="operatingExpenseId" required><option value="">Chọn chi phí có chứng từ</option>@foreach (var expense in Model.Expenses) { <option value="@expense.Id">@expense.Name</option> }</select></label><label>Chủ thể chịu chi phí<select name="legalEntityId" required><option value="">Chọn đúng chủ thể</option>@foreach (var owner in Model.LegalEntities) { <option value="@owner.Id">@owner.Name</option> }</select></label><label>Mã chứng từ hãng giữ lại<input name="carrierEvidenceReference" maxlength="500" required /></label><label>Nội dung chi phí / đối soát<textarea name="note" maxlength="2000" required></textarea></label><button class="btn btn-success" type="submit">Ghi khoản giữ lại có chứng từ</button></form> }
@if (Model.CanPostSale && d.Phase == StorefrontOrderPhase.Delivered) { <form id="sf-post-sale-form" data-operation="post-sale"><h2>Ghi nhận bán sau giao</h2><p>Cần mở ca thật do chính bạn sở hữu. Chỉ ghi khi hàng, tiền thực nhận và chi phí giữ lại đã khớp. Hệ thống dùng nguồn xuất giao; không xuất kho hoặc nhận tiền lần hai.</p><label>Ghi chú<textarea name="note" maxlength="2000"></textarea></label><button class="btn btn-success" type="submit" disabled="@(!Model.Money.CanPostSale)">Ghi nhận bán và tạo chứng từ nguồn</button></form> }
<section><h2>Lịch sử vận hành</h2>@if (d.History.Count == 0) { <p>Chưa có thao tác vận hành.</p> } else { <ol>@foreach (var item in d.History) { <li><time>@item.AtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time> · @item.ActorName · @item.Kind<p>@item.Note</p></li> }</ol> }</section>
</main>
@section PageStyles { <link rel="stylesheet" href="~/Admin/css/storefront-fulfillment.css" asp-append-version="true" /> }
@section Scripts { <script src="~/Admin/js/storefront-fulfillment.js" asp-append-version="true" defer></script> }
