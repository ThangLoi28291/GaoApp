@{
    ViewData["Title"] = "Phiếu kiểm kê kho";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <style>
        .sc-page {
            min-height: calc(100vh - 140px);
        }

        .sc-card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 0.125rem 0.75rem rgba(0,0,0,.08);
        }

            .sc-card .card-header {
                background: #fff;
                border-bottom: 1px solid #eef0f4;
                border-top-left-radius: 18px;
                border-top-right-radius: 18px;
                font-weight: 700;
            }

        .sc-empty {
            text-align: center;
            color: #6c757d;
            padding: 18px 0;
        }

        .sc-summary-box {
            border-radius: 16px;
            padding: 16px 18px;
            background: #f8f9fa;
            height: 100%;
        }

        .sc-summary-title {
            font-size: .9rem;
            color: #6c757d;
            margin-bottom: .35rem;
        }

        .sc-summary-value {
            font-size: 1.45rem;
            font-weight: 800;
            color: #212529;
        }

        .sc-status-draft {
            background: #e7f1ff;
            color: #0d6efd;
            border-radius: 999px;
            padding: .25rem .65rem;
            font-weight: 700;
            font-size: .78rem;
        }

        .sc-status-pending {
            background: #fff4db;
            color: #b54708;
            border-radius: 999px;
            padding: .25rem .65rem;
            font-weight: 700;
            font-size: .78rem;
        }

        .sc-status-confirmed {
            background: #e8f7ec;
            color: #067647;
            border-radius: 999px;
            padding: .25rem .65rem;
            font-weight: 700;
            font-size: .78rem;
        }

        .sc-status-rejected {
            background: #ffe5e5;
            color: #b42318;
            border-radius: 999px;
            padding: .25rem .65rem;
            font-weight: 700;
            font-size: .78rem;
        }

        .sc-status-cancelled {
            background: #eceff3;
            color: #475467;
            border-radius: 999px;
            padding: .25rem .65rem;
            font-weight: 700;
            font-size: .78rem;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y sc-page">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <div>
            <h4 class="mb-1">Phiếu kiểm kê kho</h4>
            <div class="text-muted">
                Quản lý danh sách phiếu kiểm kê, gửi duyệt và theo dõi trạng thái xử lý kiểm kê.
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" id="btnReloadStockCountList">
                <i class="bx bx-refresh me-1"></i> Tải lại
            </button>
            <button type="button" class="btn btn-primary" id="btnOpenCreateStockCountModal">
                <i class="bx bx-plus me-1"></i> Tạo phiếu kiểm kê
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="sc-summary-box">
                <div class="sc-summary-title">Tổng số phiếu</div>
                <div class="sc-summary-value" id="sumTotalDocuments">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sc-summary-box">
                <div class="sc-summary-title">Draft + Rejected</div>
                <div class="sc-summary-value" id="sumWorkingDocuments">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sc-summary-box">
                <div class="sc-summary-title">Chờ duyệt</div>
                <div class="sc-summary-value" id="sumPendingDocuments">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sc-summary-box">
                <div class="sc-summary-title">Đã xác nhận</div>
                <div class="sc-summary-value" id="sumConfirmedDocuments">0</div>
            </div>
        </div>
    </div>

    <div class="card sc-card">
        <div class="card-header pb-0">
            <ul class="nav nav-tabs card-header-tabs" id="stockCountTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pane-working" type="button">Draft / Rejected</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-pending" type="button">PendingApproval</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-confirmed" type="button">Confirmed</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-cancelled" type="button">Cancelled</button>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="tab-content px-0 pb-0">
                <div class="tab-pane fade show active" id="pane-working">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Số phiếu</th>
                                    <th>Ngày phiếu</th>
                                    <th>Kho</th>
                                    <th>Trạng thái</th>
                                    <th>Số dòng</th>
                                    <th>Ghi chú</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="stockCountWorkingBody">
                                <tr><td colspan="7" class="sc-empty">Đang tải dữ liệu...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-pending">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Số phiếu</th>
                                    <th>Ngày phiếu</th>
                                    <th>Kho</th>
                                    <th>Số dòng</th>
                                    <th>Ghi chú</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="stockCountPendingBody">
                                <tr><td colspan="6" class="sc-empty">Đang tải dữ liệu...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-confirmed">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Số phiếu</th>
                                    <th>Ngày phiếu</th>
                                    <th>Kho</th>
                                    <th>Số dòng</th>
                                    <th>Xác nhận lúc</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="stockCountConfirmedBody">
                                <tr><td colspan="6" class="sc-empty">Đang tải dữ liệu...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-cancelled">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Số phiếu</th>
                                    <th>Ngày phiếu</th>
                                    <th>Kho</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody id="stockCountCancelledBody">
                                <tr><td colspan="4" class="sc-empty">Đang tải dữ liệu...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createStockCountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo phiếu kiểm kê</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createStockCountForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="createStockCountWarehouseId">Kho</label>
                        <select id="createStockCountWarehouseId" class="form-select">
                            <option value="">-- Chọn kho --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="createStockCountDocumentDate">Ngày phiếu</label>
                        <input type="datetime-local" id="createStockCountDocumentDate" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="createStockCountNote">Ghi chú</label>
                        <textarea id="createStockCountNote" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="text-danger small" id="createStockCountMessage"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnCreateStockCount">Tạo phiếu</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        window.stockCountPage = { mode: 'index' };
    </script>
    <script src="~/Admin/js/stock-count.js"></script>
}