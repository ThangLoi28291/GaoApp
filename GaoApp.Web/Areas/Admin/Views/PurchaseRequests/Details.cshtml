@model GaoApp.Web.Areas.Admin.Models.Purchases.PurchaseRequestDetailsViewModel
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Purchases
@{
    var request = Model.Request;
    var lines = request.Lines.OrderBy(x => x.LineNo).ToList();
    var actions = request.Actions.OrderByDescending(x => x.OccurredAtUtc).ToList();
    var latestAction = actions.FirstOrDefault();
    var totalRequested = lines.Sum(x => x.RequestedQuantity);
    var requesterName = string.IsNullOrWhiteSpace(request.RequestedByName) ? "Chưa xác định" : request.RequestedByName.Trim();
    var requesterInitial = requesterName.Substring(0, 1).ToUpperInvariant();
    var showApprovedColumns = request.Status is PurchaseRequestStatus.Approved
        or PurchaseRequestStatus.PartiallyConverted
        or PurchaseRequestStatus.Converted;
    var showConvertedColumn = showApprovedColumns;

    ViewData["Title"] = request.Title;
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    string StatusLabel(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => "Bản nháp",
        PurchaseRequestStatus.PendingApproval => "Chờ duyệt",
        PurchaseRequestStatus.ReturnedForRevision => "Cần chỉnh sửa",
        PurchaseRequestStatus.Rejected => "Đã từ chối",
        PurchaseRequestStatus.Approved => "Đã duyệt",
        PurchaseRequestStatus.PartiallyConverted => "Đang tạo đơn đặt hàng",
        PurchaseRequestStatus.Converted => "Đã tạo đủ đơn đặt hàng",
        PurchaseRequestStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };
    string StatusClass(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => "bg-label-secondary",
        PurchaseRequestStatus.PendingApproval => "bg-label-warning",
        PurchaseRequestStatus.ReturnedForRevision => "bg-label-info",
        PurchaseRequestStatus.Rejected or PurchaseRequestStatus.Cancelled => "bg-label-danger",
        PurchaseRequestStatus.Approved or PurchaseRequestStatus.Converted => "bg-label-success",
        PurchaseRequestStatus.PartiallyConverted => "bg-label-primary",
        _ => "bg-label-secondary"
    };
    string ActionLabel(PurchaseRequestActionType action) => action switch
    {
        PurchaseRequestActionType.Created => "Tạo yêu cầu mua hàng",
        PurchaseRequestActionType.Updated => "Cập nhật yêu cầu",
        PurchaseRequestActionType.Submitted => "Gửi duyệt",
        PurchaseRequestActionType.ReturnedForRevision => "Trả về chỉnh sửa",
        PurchaseRequestActionType.Rejected => "Từ chối",
        PurchaseRequestActionType.Approved => "Quản lý duyệt",
        PurchaseRequestActionType.ConvertedToPurchaseOrder => "Tạo đơn đặt hàng",
        PurchaseRequestActionType.PurchaseOrderCancelled => "Đơn đặt hàng bị hủy",
        PurchaseRequestActionType.PurchaseOrderRejected => "Đơn đặt hàng bị từ chối",
        PurchaseRequestActionType.Cancelled => "Hủy đề xuất",
        _ => action.ToString()
    };
    string ActionIcon(PurchaseRequestActionType action) => action switch
    {
        PurchaseRequestActionType.Approved => "bx-check-shield",
        PurchaseRequestActionType.Rejected or PurchaseRequestActionType.Cancelled => "bx-x-circle",
        PurchaseRequestActionType.ReturnedForRevision => "bx-undo",
        PurchaseRequestActionType.Submitted => "bx-send",
        PurchaseRequestActionType.ConvertedToPurchaseOrder => "bx-receipt",
        _ => "bx-history"
    };
    string DeltaText(decimal delta) => delta switch
    {
        > 0 => $"+{PurchaseQuantityFormatter.Display(delta)}",
        < 0 => $"−{PurchaseQuantityFormatter.Display(Math.Abs(delta))}",
        _ => "Không đổi"
    };
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                    <a class="btn btn-icon btn-label-secondary rounded-pill" asp-action="Index" aria-label="Quay lại danh sách">
                        <i class="bx bx-arrow-back"></i>
                    </a>
                    <h3 class="gds-page-header__title mb-0">@request.Title</h3>
                    <span class="badge @StatusClass(request.Status)">@StatusLabel(request.Status)</span>
                </div>
                <p class="gds-page-header__subtitle mb-0">
                    <strong>@request.RequestNumber</strong><span class="mx-1">·</span>Người yêu cầu: @requesterName
                </p>
            </div>
            <div class="gds-page-header__actions pr-header-actions">
                @if (Model.CanEdit)
                {
                    <a class="btn btn-outline-primary gds-action-button" asp-action="Edit" asp-route-id="@request.Id">
                        <i class="bx bx-edit-alt"></i><span>Chỉnh sửa</span>
                    </a>
                }
                @if (Model.CanSubmit)
                {
                    <form method="post" asp-action="Submit" asp-route-id="@request.Id" class="d-inline" data-confirm="Gửi yêu cầu này để quản lý duyệt?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RowVersion" value="@request.RowVersion" />
                        <button class="btn btn-primary gds-action-button" type="submit"><i class="bx bx-send"></i><span>Gửi duyệt</span></button>
                    </form>
                }
                @if (Model.CanConvert)
                {
                    <a class="btn btn-success gds-action-button" asp-action="Prepare" asp-route-id="@request.Id">
                        <i class="bx bx-transfer-alt"></i><span>Tạo đơn đặt hàng</span>
                    </a>
                }
                <button type="button" class="btn btn-label-secondary gds-action-button" data-bs-toggle="modal" data-bs-target="#purchaseRequestHelpModal">
                    <i class="bx bx-help-circle"></i><span>Hướng dẫn</span><kbd>F1</kbd>
                </button>
            </div>
        </div>
    </div>
}

@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/purchase-request-details.css" asp-append-version="true" />
}

<div class="pr-review-page gds-page" data-gao-ui="modern" id="purchaseRequestDetailsPage">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible shadow-sm" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible shadow-sm" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (!string.IsNullOrWhiteSpace(request.WorkflowNote))
    {
        <div class="pr-workflow-note @(request.Status == PurchaseRequestStatus.Rejected ? "is-danger" : "is-warning")" role="alert">
            <i class="bx bx-message-detail"></i>
            <div><strong>Phản hồi xử lý</strong><span>@request.WorkflowNote</span></div>
        </div>
    }

    <div class="row g-3 align-items-start">
        <main class="col-12 col-xl-9">
            <section class="card border-0 shadow-sm pr-review-card" aria-labelledby="requestLinesTitle">
                <div class="card-header pr-card-header">
                    <div class="pr-section-heading">
                        <span class="pr-section-icon"><i class="bx @(Model.CanReview ? "bx-check-shield" : "bx-package")"></i></span>
                        <div>
                            <h5 class="mb-0" id="requestLinesTitle">@(Model.CanReview ? "Duyệt mặt hàng" : "Mặt hàng cần mua")</h5>
                            <small>@(Model.CanReview ? "Nhập số lượng cuối cùng cần mua cho từng mặt hàng." : "Đối chiếu số lượng đề xuất và kết quả xử lý.")</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-label-primary rounded-pill">@lines.Count mặt hàng</span>
                        @if (Model.CanReview)
                        {
                            <button type="button" class="btn btn-sm btn-label-secondary" id="resetApprovalQuantities">
                                <i class="bx bx-reset me-1"></i>Đặt lại theo yêu cầu
                            </button>
                        }
                    </div>
                </div>

                @if (Model.CanReview)
                {
                    <form method="post" asp-action="Approve" asp-route-id="@request.Id" id="approveRequestForm"
                          data-self-approval="@Model.IsOwner.ToString().ToLowerInvariant()" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RowVersion" value="@request.RowVersion" />

                        @if (Model.IsOwner)
                        {
                            <div class="pr-self-review" role="alert">
                                <i class="bx bx-error-circle"></i><span><strong>Tự duyệt:</strong> yêu cầu này do bạn tạo; thao tác sẽ được lưu trong lịch sử.</span>
                            </div>
                        }

                        <div class="table-responsive pr-review-table-wrap">
                            <table class="table align-middle mb-0 pr-review-table">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Tồn / đang về</th>
                                        <th class="text-end">Nhân viên yêu cầu</th>
                                        <th>Quản lý duyệt</th>
                                        <th class="text-center">Chênh lệch</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    var line = lines[i];
                                    var hasEnoughInventory = line.ItemKind == PurchaseItemKind.Catalog
                                        && line.CurrentStockQuantity + line.IncomingQuantity >= line.RequestedQuantity;
                                    <tr class="pr-approval-row is-unchanged"
                                        data-requested="@PurchaseQuantityFormatter.Invariant(line.RequestedQuantity)"
                                        data-unit="@line.UnitName">
                                        <td data-label="Sản phẩm">
                                            <div class="pr-product-cell">
                                                <span class="pr-product-index">@line.LineNo</span>
                                                <div class="min-w-0">
                                                    <div class="fw-semibold pr-product-name">@line.ProductName</div>
                                                    <div class="pr-product-meta">
                                                        @if (!string.IsNullOrWhiteSpace(line.Sku)) { <span>SKU: @line.Sku</span> }
                                                        <span>@line.UnitName</span>
                                                        @if (line.ItemKind == PurchaseItemKind.Catalog) { <span>Quy đổi ×@PurchaseQuantityFormatter.Display(line.ConversionFactor)</span> }
                                                    </div>
                                                    @if (line.ItemKind == PurchaseItemKind.FreeText)
                                                    {
                                                        <span class="pr-line-tag is-manual"><i class="bx bx-pencil"></i>Hàng chưa có trong danh mục</span>
                                                    }
                                                </div>
                                            </div>
                                            <input type="hidden" name="Lines[@i].PurchaseRequestLineId" value="@line.Id" />
                                        </td>
                                        <td data-label="Tồn / đang về">
                                            @if (line.ItemKind == PurchaseItemKind.Catalog)
                                            {
                                                <div class="pr-stock-pills">
                                                    <span class="pr-stock-pill"><i class="bx bx-cube"></i>Tồn <strong>@PurchaseQuantityFormatter.Display(line.CurrentStockQuantity)</strong></span>
                                                    <span class="pr-stock-pill is-incoming"><i class="bx bx-truck"></i>Về <strong>@PurchaseQuantityFormatter.Display(line.IncomingQuantity)</strong></span>
                                                </div>
                                                @if (hasEnoughInventory)
                                                {
                                                    <span class="pr-stock-status"><i class="bx bx-check-circle"></i>Đã đủ theo đề xuất</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="pr-stock-unknown"><i class="bx bx-help-circle"></i>Chưa có dữ liệu kho</span>
                                            }
                                        </td>
                                        <td class="text-end pr-quantity" data-label="Nhân viên yêu cầu">
                                            <strong>@PurchaseQuantityFormatter.Display(line.RequestedQuantity)</strong><small>@line.UnitName</small>
                                        </td>
                                        <td class="pr-approval-cell" data-label="Quản lý duyệt">
                                            <div class="input-group">
                                                <input class="form-control text-end pr-approval-input" type="text" inputmode="decimal" autocomplete="off"
                                                       value="@PurchaseQuantityFormatter.Input(line.RequestedQuantity)" aria-label="Số lượng quản lý duyệt cho @line.ProductName" />
                                                <span class="input-group-text">@line.UnitName</span>
                                            </div>
                                            <input type="hidden" class="pr-approval-value" name="Lines[@i].ApprovedQuantity" value="@PurchaseQuantityFormatter.Invariant(line.RequestedQuantity)" />
                                            <div class="invalid-feedback">Nhập số từ 0 trở lên, tối đa 3 số lẻ.</div>
                                        </td>
                                        <td class="text-center pr-approval-delta" data-label="Chênh lệch">
                                            <span class="pr-delta-badge is-unchanged">Không đổi</span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <div class="pr-approval-note-shell" id="approvalNoteShell">
                            <button type="button" class="pr-note-toggle" id="approvalNoteToggle" aria-expanded="false" aria-controls="approvalNotePanel">
                                <span><i class="bx bx-note"></i><strong>Thêm ghi chú</strong><small id="approvalNoteToggleHint">Không bắt buộc khi giữ nguyên số lượng</small></span>
                                <i class="bx bx-chevron-down pr-note-chevron"></i>
                            </button>
                            <div class="pr-note-panel" id="approvalNotePanel" hidden>
                                <label class="form-label fw-semibold" for="approvalNote">Lý do / ghi chú cho nhân viên <span class="text-danger d-none" id="approvalNoteRequiredMark">*</span></label>
                                <textarea class="form-control" id="approvalNote" name="Note" rows="3" maxlength="1000" placeholder="Nêu lý do tăng, giảm hoặc bỏ mặt hàng..."></textarea>
                                <div class="d-flex justify-content-between gap-2 mt-2">
                                    <small class="text-muted" id="approvalNoteHelp">Ghi chú được lưu trong lịch sử xử lý.</small>
                                    <small class="text-muted"><span id="approvalNoteCount">0</span>/1000</small>
                                </div>
                                <div class="invalid-feedback">Bắt buộc nhập lý do khi số lượng duyệt khác yêu cầu.</div>
                            </div>
                        </div>

                        <div class="pr-review-actionbar">
                            <div class="pr-review-summary" aria-live="polite">
                                <span><small>Tổng</small><strong id="approvalTotalCount">@lines.Count</strong></span>
                                <span class="is-neutral"><small>Giữ nguyên</small><strong id="approvalUnchangedCount">@lines.Count</strong></span>
                                <span class="is-increased"><small>Tăng</small><strong id="approvalIncreasedCount">0</strong></span>
                                <span class="is-decreased"><small>Giảm</small><strong id="approvalDecreasedCount">0</strong></span>
                                <span class="is-removed"><small>Không mua</small><strong id="approvalRemovedCount">0</strong></span>
                            </div>
                            <div class="pr-review-actions">
                                <button class="btn btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#returnRequestModal">
                                    <i class="bx bx-undo me-1"></i>Trả sửa <kbd>Alt R</kbd>
                                </button>
                                <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#rejectRequestModal">
                                    <i class="bx bx-x me-1"></i>Từ chối <kbd>Alt X</kbd>
                                </button>
                                <button class="btn btn-success" type="submit" id="approveRequestButton">
                                    <i class="bx bx-check-shield me-1"></i>Duyệt yêu cầu <kbd>Alt ↵</kbd>
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="table-responsive pr-review-table-wrap">
                        <table class="table align-middle mb-0 pr-review-table pr-readonly-table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Tồn / đang về</th>
                                    <th class="text-end">Nhân viên yêu cầu</th>
                                    @if (showApprovedColumns) { <th class="text-end">Quản lý duyệt</th><th class="text-center">Chênh lệch</th> }
                                    @if (showConvertedColumn) { <th class="text-end">Đã đưa vào PO</th> }
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var line in lines)
                            {
                                var approved = line.ApprovedQuantity ?? line.RequestedQuantity;
                                var delta = approved - line.RequestedQuantity;
                                var deltaClass = delta == 0 ? "is-unchanged" : delta > 0 ? "is-increased" : approved == 0 ? "is-removed" : "is-decreased";
                                var hasEnoughInventory = line.ItemKind == PurchaseItemKind.Catalog
                                    && line.CurrentStockQuantity + line.IncomingQuantity >= line.RequestedQuantity;
                                <tr>
                                    <td data-label="Sản phẩm">
                                        <div class="pr-product-cell">
                                            <span class="pr-product-index">@line.LineNo</span>
                                            <div class="min-w-0">
                                                <div class="fw-semibold pr-product-name">@line.ProductName</div>
                                                <div class="pr-product-meta">
                                                    @if (!string.IsNullOrWhiteSpace(line.Sku)) { <span>SKU: @line.Sku</span> }
                                                    <span>@line.UnitName</span>
                                                    @if (line.ItemKind == PurchaseItemKind.Catalog) { <span>Quy đổi ×@PurchaseQuantityFormatter.Display(line.ConversionFactor)</span> }
                                                </div>
                                                @if (line.ItemKind == PurchaseItemKind.FreeText) { <span class="pr-line-tag is-manual"><i class="bx bx-pencil"></i>Hàng chưa có trong danh mục</span> }
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Tồn / đang về">
                                        @if (line.ItemKind == PurchaseItemKind.Catalog)
                                        {
                                            <div class="pr-stock-pills">
                                                <span class="pr-stock-pill"><i class="bx bx-cube"></i>Tồn <strong>@PurchaseQuantityFormatter.Display(line.CurrentStockQuantity)</strong></span>
                                                <span class="pr-stock-pill is-incoming"><i class="bx bx-truck"></i>Về <strong>@PurchaseQuantityFormatter.Display(line.IncomingQuantity)</strong></span>
                                            </div>
                                            @if (hasEnoughInventory) { <span class="pr-stock-status"><i class="bx bx-check-circle"></i>Đã đủ theo đề xuất</span> }
                                        }
                                        else { <span class="pr-stock-unknown"><i class="bx bx-help-circle"></i>Chưa có dữ liệu kho</span> }
                                    </td>
                                    <td class="text-end pr-quantity" data-label="Nhân viên yêu cầu"><strong>@PurchaseQuantityFormatter.Display(line.RequestedQuantity)</strong><small>@line.UnitName</small></td>
                                    @if (showApprovedColumns)
                                    {
                                        <td class="text-end pr-quantity is-approved" data-label="Quản lý duyệt"><strong>@PurchaseQuantityFormatter.Display(approved)</strong><small>@line.UnitName</small></td>
                                        <td class="text-center" data-label="Chênh lệch"><span class="pr-delta-badge @deltaClass">@(approved == 0 ? "Không mua" : DeltaText(delta))</span></td>
                                    }
                                    @if (showConvertedColumn)
                                    {
                                        <td class="text-end pr-quantity" data-label="Đã đưa vào PO"><strong>@PurchaseQuantityFormatter.Display(line.ConvertedQuantity)</strong><small>@line.UnitName</small></td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (request.PurchaseOrders.Count > 0 && Model.CanViewPurchaseOrders)
            {
                <section class="card border-0 shadow-sm pr-orders-card mt-3" aria-labelledby="purchaseOrdersTitle">
                    <div class="card-header pr-card-header">
                        <div class="pr-section-heading">
                            <span class="pr-section-icon is-success"><i class="bx bx-receipt"></i></span>
                            <div><h5 class="mb-0" id="purchaseOrdersTitle">Đơn đặt hàng đã tạo</h5><small>@request.PurchaseOrders.Count đơn liên quan đến yêu cầu này.</small></div>
                        </div>
                    </div>
                    <div class="list-group list-group-flush">
                    @foreach (var order in request.PurchaseOrders)
                    {
                        <a class="list-group-item list-group-item-action pr-order-item" asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@order.Id">
                            <span class="pr-order-icon"><i class="bx bx-file"></i></span>
                            <span class="flex-grow-1 min-w-0"><strong>@order.OrderNumber</strong><small>@order.Title · @order.SupplierName</small></span>
                            <span class="badge bg-label-secondary">@order.Status</span><i class="bx bx-chevron-right"></i>
                        </a>
                    }
                    </div>
                </section>
            }
        </main>

        <aside class="col-12 col-xl-3">
            <section class="card border-0 shadow-sm pr-side-card" aria-labelledby="requestSummaryTitle">
                <div class="card-header"><h5 class="mb-0" id="requestSummaryTitle">Thông tin yêu cầu</h5></div>
                <div class="card-body">
                    <div class="pr-requester">
                        <span class="pr-requester-avatar">@requesterInitial</span>
                        <div><small>Người yêu cầu</small><strong>@requesterName</strong></div>
                    </div>
                    <div class="pr-fact-grid">
                        <div><i class="bx bx-calendar"></i><small>Ngày tạo</small><strong>@request.RequestDate.ToString("dd/MM/yyyy")</strong></div>
                        <div><i class="bx bx-package"></i><small>Mặt hàng</small><strong>@lines.Count</strong></div>
                        <div><i class="bx bx-layer"></i><small>Tổng số lượng</small><strong>@PurchaseQuantityFormatter.Display(totalRequested)</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(request.Note))
                    {
                        <div class="pr-request-note"><small>Ghi chú đề xuất</small><p>@request.Note</p></div>
                    }
                </div>
            </section>

            <section class="card border-0 shadow-sm pr-side-card mt-3" aria-labelledby="requestHistoryTitle">
                <div class="card-header"><h5 class="mb-0" id="requestHistoryTitle">Xử lý gần nhất</h5></div>
                <div class="card-body">
                    @if (latestAction == null)
                    {
                        <p class="text-muted mb-0">Chưa có lịch sử xử lý.</p>
                    }
                    else
                    {
                        <div class="pr-latest-action">
                            <span><i class="bx @ActionIcon(latestAction.ActionType)"></i></span>
                            <div><strong>@ActionLabel(latestAction.ActionType)</strong><small>@latestAction.ActorName · @latestAction.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(latestAction.Note)) { <p class="pr-latest-note">@latestAction.Note</p> }
                        <button type="button" class="btn btn-label-secondary w-100 mt-3" data-bs-toggle="modal" data-bs-target="#requestHistoryModal">
                            <i class="bx bx-history me-1"></i>Xem toàn bộ lịch sử
                        </button>
                    }
                </div>
            </section>

            @if (Model.CanCancel)
            {
                <button class="btn btn-outline-danger w-100 mt-3" type="button" data-bs-toggle="modal" data-bs-target="#cancelRequestModal">
                    <i class="bx bx-trash me-1"></i>Hủy đề xuất
                </button>
            }
        </aside>
    </div>
</div>

<div class="modal fade" id="purchaseRequestHelpModal" tabindex="-1" aria-labelledby="purchaseRequestHelpTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content pr-modal-content">
        <div class="modal-header"><div><span class="pr-modal-eyebrow">F1 · HƯỚNG DẪN</span><h5 class="modal-title" id="purchaseRequestHelpTitle">Duyệt yêu cầu mua hàng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="pr-help-grid">
                <div><span>1</span><div><strong>Đối chiếu nhu cầu</strong><p>Xem tồn kho, hàng đang về và số lượng nhân viên yêu cầu.</p></div></div>
                <div><span>2</span><div><strong>Nhập số lượng duyệt</strong><p>Giữ nguyên, tăng, giảm hoặc nhập 0 để không mua một mặt hàng.</p></div></div>
                <div><span>3</span><div><strong>Ghi lý do khi thay đổi</strong><p>Ghi chú tự mở và bắt buộc khi có ít nhất một dòng khác đề xuất.</p></div></div>
                <div><span>4</span><div><strong>Xác nhận</strong><p>Cần ít nhất một mặt hàng có số lượng lớn hơn 0 để duyệt.</p></div></div>
            </div>
            @if (Model.CanReview)
            {
                <div class="pr-shortcut-list"><span><kbd>Alt</kbd> + <kbd>Enter</kbd> Duyệt</span><span><kbd>Alt</kbd> + <kbd>R</kbd> Trả sửa</span><span><kbd>Alt</kbd> + <kbd>X</kbd> Từ chối</span></div>
            }
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đã hiểu</button></div>
    </div></div>
</div>

<div class="modal fade" id="requestHistoryModal" tabindex="-1" aria-labelledby="requestHistoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content pr-modal-content">
        <div class="modal-header"><div><span class="pr-modal-eyebrow">@request.RequestNumber</span><h5 class="modal-title" id="requestHistoryModalTitle">Lịch sử xử lý</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            @if (actions.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có lịch sử xử lý.</p>
            }
            else
            {
                <div class="pr-history-timeline">
                @foreach (var action in actions)
                {
                    <div class="pr-history-item">
                        <span class="pr-history-icon"><i class="bx @ActionIcon(action.ActionType)"></i></span>
                        <div><strong>@ActionLabel(action.ActionType)</strong><small>@action.ActorName · @action.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>@if (!string.IsNullOrWhiteSpace(action.Note)) { <p>@action.Note</p> }</div>
                    </div>
                }
                </div>
            }
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button></div>
    </div></div>
</div>

@if (Model.CanReview)
{
    <div class="modal fade" id="approveConfirmModal" tabindex="-1" aria-labelledby="approveConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content pr-confirm-modal">
            <div class="modal-header border-0 pb-0"><button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button></div>
            <div class="modal-body text-center pt-0">
                <span class="pr-confirm-icon"><i class="bx bx-check-shield"></i></span>
                <h4 id="approveConfirmTitle">Xác nhận duyệt yêu cầu</h4>
                <p class="text-muted" id="approveConfirmDescription">Kiểm tra lần cuối trước khi khóa số lượng.</p>
                @if (Model.IsOwner)
                {
                    <div class="pr-confirm-self"><i class="bx bx-error-circle"></i>Bạn đang duyệt yêu cầu do chính mình tạo.</div>
                }
                <div class="pr-confirm-summary">
                    <span><small>Giữ nguyên</small><strong id="confirmUnchangedCount">0</strong></span>
                    <span class="is-increased"><small>Tăng</small><strong id="confirmIncreasedCount">0</strong></span>
                    <span class="is-decreased"><small>Giảm</small><strong id="confirmDecreasedCount">0</strong></span>
                    <span class="is-removed"><small>Không mua</small><strong id="confirmRemovedCount">0</strong></span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Kiểm tra lại</button><button type="button" class="btn btn-success" id="confirmApproveButton"><i class="bx bx-check me-1"></i>Xác nhận duyệt</button></div>
        </div></div>
    </div>

    <div class="modal fade" id="returnRequestModal" tabindex="-1" aria-labelledby="returnRequestTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content"><form method="post" asp-action="Return" asp-route-id="@request.Id">
            @Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" />
            <div class="modal-header"><div><span class="pr-modal-eyebrow">YÊU CẦU CHỈNH SỬA</span><h5 class="modal-title" id="returnRequestTitle">Trả nhân viên chỉnh sửa</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label fw-semibold">Nội dung cần chỉnh sửa <span class="text-danger">*</span></label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required placeholder="Nêu rõ nội dung nhân viên cần bổ sung hoặc sửa..."></textarea></div>
            <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-warning" type="submit"><i class="bx bx-undo me-1"></i>Xác nhận trả sửa</button></div>
        </form></div></div>
    </div>

    <div class="modal fade" id="rejectRequestModal" tabindex="-1" aria-labelledby="rejectRequestTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content"><form method="post" asp-action="Reject" asp-route-id="@request.Id">
            @Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" />
            <div class="modal-header"><div><span class="pr-modal-eyebrow">KẾT THÚC YÊU CẦU</span><h5 class="modal-title" id="rejectRequestTitle">Từ chối đề xuất</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label fw-semibold">Lý do từ chối <span class="text-danger">*</span></label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required placeholder="Nêu rõ lý do không duyệt yêu cầu này..."></textarea></div>
            <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger" type="submit"><i class="bx bx-x me-1"></i>Xác nhận từ chối</button></div>
        </form></div></div>
    </div>
}

@if (Model.CanCancel)
{
    <div class="modal fade" id="cancelRequestModal" tabindex="-1" aria-labelledby="cancelRequestTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content"><form method="post" asp-action="Cancel" asp-route-id="@request.Id">
            @Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" />
            <div class="modal-header"><div><span class="pr-modal-eyebrow">HỦY ĐỀ XUẤT</span><h5 class="modal-title" id="cancelRequestTitle">Hủy yêu cầu mua hàng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><p class="text-muted">Yêu cầu sẽ dừng xử lý sau khi hủy.</p><label class="form-label fw-semibold">Lý do <span class="text-muted fw-normal">(không bắt buộc)</span></label><textarea class="form-control" name="Note" rows="3" maxlength="1000"></textarea></div>
            <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger" type="submit"><i class="bx bx-trash me-1"></i>Hủy đề xuất</button></div>
        </form></div></div>
    </div>
}

<div class="modal fade" id="genericConfirmModal" tabindex="-1" aria-labelledby="genericConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content pr-confirm-modal">
        <div class="modal-header border-0 pb-0"><button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button></div>
        <div class="modal-body text-center pt-0"><span class="pr-confirm-icon is-primary"><i class="bx bx-send"></i></span><h4 id="genericConfirmTitle">Xác nhận thao tác</h4><p class="text-muted mb-0" id="genericConfirmMessage"></p></div>
        <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Quay lại</button><button type="button" class="btn btn-primary" id="genericConfirmButton">Xác nhận</button></div>
    </div></div>
</div>

@section PageScripts {
    <script src="~/Admin/js/purchase-request-details.js" asp-append-version="true"></script>
}
