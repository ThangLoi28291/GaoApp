@model GaoApp.Web.Areas.Admin.Models.Purchases.PurchaseRequestDetailsViewModel
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Purchases
@{
    var request = Model.Request;
    ViewData["Title"] = request.Title;

    string StatusLabel(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => "Bản nháp",
        PurchaseRequestStatus.PendingApproval => "Chờ duyệt",
        PurchaseRequestStatus.ReturnedForRevision => "Cần chỉnh sửa",
        PurchaseRequestStatus.Rejected => "Đã từ chối",
        PurchaseRequestStatus.Approved => "Đã duyệt",
        PurchaseRequestStatus.PartiallyConverted => "Đang tạo đơn đặt hàng",
        PurchaseRequestStatus.Converted => "Đã tạo đủ đơn đặt hàng",
        PurchaseRequestStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };
    string StatusClass(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => "bg-label-secondary",
        PurchaseRequestStatus.PendingApproval => "bg-label-warning",
        PurchaseRequestStatus.ReturnedForRevision => "bg-label-info",
        PurchaseRequestStatus.Rejected or PurchaseRequestStatus.Cancelled => "bg-label-danger",
        PurchaseRequestStatus.Approved or PurchaseRequestStatus.Converted => "bg-label-success",
        PurchaseRequestStatus.PartiallyConverted => "bg-label-primary",
        _ => "bg-label-secondary"
    };
    string ActionLabel(PurchaseRequestActionType action) => action switch
    {
        PurchaseRequestActionType.Created => "Tạo yêu cầu mua hàng",
        PurchaseRequestActionType.Updated => "Cập nhật yêu cầu",
        PurchaseRequestActionType.Submitted => "Gửi duyệt",
        PurchaseRequestActionType.ReturnedForRevision => "Trả về chỉnh sửa",
        PurchaseRequestActionType.Rejected => "Từ chối",
        PurchaseRequestActionType.Approved => "Quản lý duyệt",
        PurchaseRequestActionType.ConvertedToPurchaseOrder => "Tạo đơn đặt hàng",
        PurchaseRequestActionType.PurchaseOrderCancelled => "Đơn đặt hàng bị hủy",
        PurchaseRequestActionType.PurchaseOrderRejected => "Đơn đặt hàng bị từ chối",
        PurchaseRequestActionType.Cancelled => "Hủy đề xuất",
        _ => action.ToString()
    };
    string DeltaText(decimal delta) => delta switch
    {
        > 0 => $"+{PurchaseQuantityFormatter.Display(delta)}",
        < 0 => $"−{PurchaseQuantityFormatter.Display(Math.Abs(delta))}",
        _ => "Không đổi"
    };
}

@section PageStyles {
    <style>
        .pr-detail-table th { white-space: nowrap; }
        .pr-detail-table .pr-qty { font-variant-numeric: tabular-nums; white-space: nowrap; }
        .pr-inventory-pills { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.35rem; }
        .pr-inventory-pill { display:inline-flex; align-items:center; gap:.25rem; padding:.22rem .48rem; border-radius:.45rem; background:#f5f5f7; color:#566a7f; font-size:.75rem; white-space:nowrap; }
        .pr-inventory-pill.incoming { background:rgba(3,195,236,.1); color:#03a9d9; }
        .pr-final-qty { color:var(--bs-success); font-weight:700; }
        .pr-delta-badge { display:inline-flex; min-width:64px; justify-content:center; padding:.25rem .48rem; border-radius:.45rem; font-size:.75rem; font-weight:700; white-space:nowrap; }
        .pr-delta-zero { background:#f1f2f4; color:#697a8d; }
        .pr-delta-up { background:rgba(255,171,0,.14); color:#b77900; }
        .pr-delta-down { background:rgba(3,195,236,.12); color:#0088a9; }
        .pr-approval-card { overflow:hidden; }
        .pr-approval-card .card-header { border-bottom:1px solid rgba(105,108,255,.14); }
        .pr-approval-table td { vertical-align:middle; }
        .pr-approval-table .pr-approval-row.is-increased { background:rgba(255,171,0,.055); }
        .pr-approval-input { min-width:120px; font-weight:700; font-variant-numeric:tabular-nums; }
        .pr-approval-inventory { min-width:170px; }
        .pr-approval-delta { min-width:88px; text-align:center; }
        .pr-approval-guidance { display:flex; align-items:flex-start; gap:.65rem; padding:.75rem .9rem; border:1px solid rgba(105,108,255,.18); border-radius:.6rem; background:rgba(105,108,255,.055); }
        .pr-change-summary { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
        .pr-change-summary .badge { font-size:.75rem; }
        @@media (max-width: 767.98px) {
            .pr-detail-table { min-width:920px; }
            .pr-approval-table { min-width:920px; }
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="d-flex gap-3 align-items-start">
        <a class="btn btn-icon btn-label-secondary rounded-pill" asp-action="Index" aria-label="Quay lại"><i class="bx bx-arrow-back"></i></a>
        <div>
            <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                <h4 class="mb-0">@request.Title</h4>
                <span class="badge @StatusClass(request.Status)">@StatusLabel(request.Status)</span>
            </div>
            <div class="text-muted"><span class="fw-medium">@request.RequestNumber</span> · Người yêu cầu: @request.RequestedByName</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@request.Id"><i class="bx bx-edit-alt me-1"></i>Chỉnh sửa yêu cầu</a>
        }
        @if (Model.CanSubmit)
        {
            <form method="post" asp-action="Submit" asp-route-id="@request.Id" class="d-inline" data-confirm="Gửi yêu cầu mua hàng này để quản lý duyệt số lượng?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RowVersion" value="@request.RowVersion" />
                <button class="btn btn-primary" type="submit"><i class="bx bx-send me-1"></i>Gửi duyệt</button>
            </form>
        }
        @if (Model.CanConvert)
        {
            <a class="btn btn-success" asp-action="Prepare" asp-route-id="@request.Id"><i class="bx bx-transfer-alt me-1"></i>Tạo đơn đặt hàng</a>
        }
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (!string.IsNullOrWhiteSpace(request.WorkflowNote))
{
    <div class="alert @(request.Status == PurchaseRequestStatus.Rejected ? "alert-danger" : "alert-warning") d-flex gap-2" role="alert">
        <i class="bx bx-message-detail fs-5"></i>
        <div><strong>Phản hồi xử lý</strong><div>@request.WorkflowNote</div></div>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-9">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="avatar avatar-sm bg-label-primary rounded"><i class="bx bx-package"></i></span>
                <div><h5 class="mb-0">Mặt hàng cần mua</h5><small class="text-muted">Số lượng nhân viên yêu cầu được giữ nguyên; số lượng quản lý duyệt hiển thị ở cột riêng.</small></div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 pr-detail-table">
                    <thead class="table-light"><tr><th>#</th><th>Sản phẩm / đơn vị</th><th class="text-end">Tồn hiện tại</th><th class="text-end">Đang về</th><th class="text-end">Nhân viên yêu cầu</th><th class="text-end">Quản lý duyệt</th><th class="text-center">Chênh lệch</th><th class="text-end">Đã đưa vào đơn</th></tr></thead>
                    <tbody>
                    @foreach (var line in request.Lines.OrderBy(x => x.LineNo))
                    {
                        var hasFinalQuantity = line.ApprovedQuantity.HasValue;
                        var delta = hasFinalQuantity ? line.ApprovedQuantity!.Value - line.RequestedQuantity : 0m;
                        var deltaClass = !hasFinalQuantity || delta == 0 ? "pr-delta-zero" : delta > 0 ? "pr-delta-up" : "pr-delta-down";
                        <tr>
                            <td class="text-muted">@line.LineNo</td>
                            <td><div class="fw-semibold">@line.ProductName</div><small class="text-muted">@if (!string.IsNullOrWhiteSpace(line.Sku)){<span>SKU: @line.Sku · </span>}@line.UnitName@if(line.ItemKind == PurchaseItemKind.Catalog){<span> · Quy đổi ×@PurchaseQuantityFormatter.Display(line.ConversionFactor)</span>}</small>@if(line.ItemKind == PurchaseItemKind.FreeText){<div><span class="badge bg-label-warning mt-1"><i class="bx bx-pencil me-1"></i>Hàng chưa có trong danh mục</span></div>}</td>
                            <td class="text-end pr-qty">@if(line.ItemKind == PurchaseItemKind.Catalog){<strong>@PurchaseQuantityFormatter.Display(line.CurrentStockQuantity)</strong> <small class="text-muted">@line.UnitName</small>}else{<span class="text-muted">—</span>}</td>
                            <td class="text-end pr-qty">@if(line.ItemKind == PurchaseItemKind.Catalog){<strong>@PurchaseQuantityFormatter.Display(line.IncomingQuantity)</strong> <small class="text-muted">@line.UnitName</small>}else{<span class="text-muted">—</span>}</td>
                            <td class="text-end pr-qty fw-semibold">@PurchaseQuantityFormatter.Display(line.RequestedQuantity) <small class="text-muted">@line.UnitName</small></td>
                            <td class="text-end pr-qty">
                                @if (hasFinalQuantity)
                                {
                                    <span class="pr-final-qty">@PurchaseQuantityFormatter.Display(line.ApprovedQuantity!.Value)</span> <small class="text-muted">@line.UnitName</small>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa duyệt</span>
                                }
                            </td>
                            <td class="text-center"><span class="pr-delta-badge @deltaClass">@(hasFinalQuantity ? DeltaText(delta) : "—")</span></td>
                            <td class="text-end pr-qty">@PurchaseQuantityFormatter.Display(line.ConvertedQuantity) <small class="text-muted">@line.UnitName</small></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.CanReview)
        {
            <div class="card border border-primary shadow-sm mb-4 pr-approval-card">
                <div class="card-header bg-label-primary">
                    <h5 class="mb-1"><i class="bx bx-check-shield me-1"></i>Quản lý xét duyệt số lượng</h5>
                    <small>Số lượng nhân viên yêu cầu không bị ghi đè. Quản lý có thể giữ nguyên, giảm hoặc tăng theo tình hình thực tế.</small>
                </div>
                <div class="card-body">
                    <div class="pr-approval-guidance mb-3">
                        <i class="bx bx-info-circle fs-5 text-primary"></i>
                        <div><strong>Cách xử lý:</strong> nhập số lượng cuối cùng sẽ mua cho từng dòng. Nếu bất kỳ dòng nào khác yêu cầu ban đầu, bắt buộc ghi rõ lý do. Trường hợp tăng số lượng sẽ được cảnh báo nổi bật trước khi xác nhận.</div>
                    </div>

                    @if (Model.IsOwner)
                    {
                        <div class="alert alert-warning d-flex gap-2" role="alert">
                            <i class="bx bx-error-circle fs-5"></i>
                            <div><strong>Bạn đang tự duyệt yêu cầu do mình tạo.</strong> Thao tác vẫn được phép theo quyền hiện có và sẽ được lưu đầy đủ trong lịch sử.</div>
                        </div>
                    }

                    <form method="post" asp-action="Approve" asp-route-id="@request.Id" id="approveRequestForm"
                          data-self-approval="@Model.IsOwner.ToString().ToLowerInvariant()" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RowVersion" value="@request.RowVersion" />
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle pr-approval-table">
                                <thead><tr><th>Sản phẩm / đơn vị</th><th class="text-end">Tồn &amp; đang về</th><th class="text-end">Nhân viên yêu cầu</th><th style="width:210px">Quản lý duyệt</th><th class="text-center">Chênh lệch</th></tr></thead>
                                <tbody>
                                @for (var i = 0; i < request.Lines.Count; i++)
                                {
                                    var line = request.Lines[i];
                                    <tr class="pr-approval-row" data-requested="@PurchaseQuantityFormatter.Invariant(line.RequestedQuantity)" data-unit="@line.UnitName">
                                        <td>
                                            <div class="fw-medium">@line.ProductName</div>
                                            <small class="text-muted">@if (!string.IsNullOrWhiteSpace(line.Sku)){<span>SKU: @line.Sku · </span>}@line.UnitName@if(line.ItemKind == PurchaseItemKind.Catalog){<span> · ×@PurchaseQuantityFormatter.Display(line.ConversionFactor)</span>}</small>
                                            @if(line.ItemKind == PurchaseItemKind.FreeText){<div><span class="badge bg-label-warning mt-1">Hàng chưa có trong danh mục</span></div>}
                                            <input type="hidden" name="Lines[@i].PurchaseRequestLineId" value="@line.Id" />
                                        </td>
                                        <td class="text-end pr-approval-inventory">
                                            <div class="pr-inventory-pills">
                                                @if(line.ItemKind == PurchaseItemKind.Catalog){<span class="pr-inventory-pill"><i class="bx bx-cube"></i>Tồn @PurchaseQuantityFormatter.Display(line.CurrentStockQuantity)</span><span class="pr-inventory-pill incoming"><i class="bx bx-truck"></i>Về @PurchaseQuantityFormatter.Display(line.IncomingQuantity)</span>}else{<span class="pr-inventory-pill"><i class="bx bx-help-circle"></i>Chưa có dữ liệu kho</span>}
                                            </div>
                                        </td>
                                        <td class="text-end pr-qty"><strong>@PurchaseQuantityFormatter.Display(line.RequestedQuantity)</strong> <small class="text-muted">@line.UnitName</small></td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input class="form-control text-end pr-approval-input" type="text" inputmode="decimal" autocomplete="off"
                                                       value="@PurchaseQuantityFormatter.Input(line.RequestedQuantity)" aria-label="Số lượng quản lý duyệt cho @line.ProductName" />
                                                <span class="input-group-text">@line.UnitName</span>
                                            </div>
                                            <input type="hidden" class="pr-approval-value" name="Lines[@i].ApprovedQuantity" value="@PurchaseQuantityFormatter.Invariant(line.RequestedQuantity)" />
                                            <div class="invalid-feedback pr-approval-error">Nhập số lượng hợp lệ, không nhỏ hơn 0 và tối đa 3 số lẻ.</div>
                                        </td>
                                        <td class="pr-approval-delta"><span class="pr-delta-badge pr-delta-zero">Không đổi</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-warning d-none" id="approvalIncreaseWarning" role="alert">
                            <div class="d-flex gap-2"><i class="bx bx-up-arrow-alt fs-5"></i><div><strong>Đang duyệt tăng số lượng</strong><div id="approvalIncreaseText"></div></div></div>
                        </div>

                        <div class="pr-change-summary mb-3">
                            <span class="badge bg-label-secondary" id="approvalUnchangedBadge">Tất cả dòng giữ nguyên</span>
                            <span class="badge bg-label-info d-none" id="approvalChangedBadge"></span>
                        </div>

                        <label class="form-label fw-semibold" for="approvalNote">Lý do / ghi chú cho nhân viên <span class="text-danger d-none" id="approvalNoteRequiredMark">*</span></label>
                        <textarea class="form-control" id="approvalNote" name="Note" rows="3" maxlength="1000" placeholder="Không bắt buộc nếu giữ nguyên toàn bộ số lượng. Nếu tăng hoặc giảm, hãy ghi rõ lý do..."></textarea>
                        <div class="form-text" id="approvalNoteHelp">Lý do sẽ được lưu trong lịch sử xử lý và hiển thị cho nhân viên.</div>
                        <div class="invalid-feedback">Bắt buộc nhập lý do khi số lượng quản lý duyệt khác yêu cầu của nhân viên.</div>

                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                            <button class="btn btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#returnRequestModal"><i class="bx bx-undo me-1"></i>Trả sửa</button>
                            <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#rejectRequestModal"><i class="bx bx-x me-1"></i>Từ chối</button>
                            <button class="btn btn-success" type="submit" id="approveRequestButton"><i class="bx bx-check me-1"></i>Duyệt yêu cầu</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (request.PurchaseOrders.Count > 0 && Model.CanViewPurchaseOrders)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-receipt me-1"></i>Đơn đặt hàng đã tạo</h5></div>
                <div class="list-group list-group-flush">
                @foreach (var order in request.PurchaseOrders)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@order.Id">
                        <div><div class="fw-semibold">@order.OrderNumber · @order.Title</div><small class="text-muted">@order.SupplierName</small></div>
                        <div class="text-end"><small class="text-muted">@order.Status</small></div>
                    </a>
                }
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-xl-3">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0">Thông tin yêu cầu</h5></div>
            <div class="card-body">
                <dl class="row mb-0 gy-3">
                    <dt class="col-5 text-muted fw-normal">Ngày đề xuất</dt><dd class="col-7 mb-0 text-end">@request.RequestDate.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-5 text-muted fw-normal">Cần trước ngày</dt><dd class="col-7 mb-0 text-end">@(request.NeedByDate?.ToString("dd/MM/yyyy") ?? "Không giới hạn")</dd>
                    <dt class="col-5 text-muted fw-normal">Nhân viên</dt><dd class="col-7 mb-0 text-end fw-medium">@request.RequestedByName</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(request.Note))
                {
                    <hr /><div class="small text-muted mb-1">Ghi chú đề xuất</div><div style="white-space:pre-wrap">@request.Note</div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0">Lịch sử xử lý</h5></div>
            <div class="card-body">
                @if (request.Actions.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có lịch sử xử lý.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                    @foreach (var action in request.Actions.OrderByDescending(x => x.OccurredAtUtc))
                    {
                        <div class="d-flex gap-3"><span class="avatar avatar-sm bg-label-secondary rounded-circle flex-shrink-0"><i class="bx bx-history"></i></span><div class="min-w-0"><div class="fw-medium">@ActionLabel(action.ActionType)</div><div class="small text-muted">@action.ActorName · @action.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>@if (!string.IsNullOrWhiteSpace(action.Note)){<div class="small mt-1">@action.Note</div>}</div></div>
                    }
                    </div>
                }
            </div>
        </div>

        @if (Model.CanCancel)
        {
            <button class="btn btn-outline-danger w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelRequestModal"><i class="bx bx-trash me-1"></i>Hủy đề xuất</button>
        }
    </div>
</div>

@if (Model.CanReview)
{
    <div class="modal fade" id="returnRequestModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Return" asp-route-id="@request.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" /><div class="modal-header"><h5 class="modal-title">Trả nhân viên chỉnh sửa</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Nội dung cần chỉnh sửa <span class="text-danger">*</span></label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-warning" type="submit">Xác nhận trả sửa</button></div></form></div></div></div>
    <div class="modal fade" id="rejectRequestModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Reject" asp-route-id="@request.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" /><div class="modal-header"><h5 class="modal-title">Từ chối đề xuất</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Lý do từ chối <span class="text-danger">*</span></label><textarea class="form-control" name="Note" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger" type="submit">Xác nhận từ chối</button></div></form></div></div></div>
}
@if (Model.CanCancel)
{
    <div class="modal fade" id="cancelRequestModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-action="Cancel" asp-route-id="@request.Id">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@request.RowVersion" /><div class="modal-header"><h5 class="modal-title">Hủy đề xuất mua hàng</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Đề xuất sẽ không thể tiếp tục xử lý sau khi hủy.</p><label class="form-label">Lý do (không bắt buộc)</label><textarea class="form-control" name="Note" rows="3" maxlength="1000"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger" type="submit">Hủy đề xuất</button></div></form></div></div></div>
}

@section PageScripts {
    <script>
        (function () {
            'use strict';

            document.querySelectorAll('[data-confirm]').forEach(function (element) {
                element.addEventListener(element.tagName === 'FORM' ? 'submit' : 'click', function (event) {
                    if (!window.confirm(element.dataset.confirm)) event.preventDefault();
                });
            });

            const form = document.getElementById('approveRequestForm');
            if (!form) return;

            const rows = Array.from(form.querySelectorAll('.pr-approval-row'));
            const note = document.getElementById('approvalNote');
            const increaseWarning = document.getElementById('approvalIncreaseWarning');
            const increaseText = document.getElementById('approvalIncreaseText');
            const unchangedBadge = document.getElementById('approvalUnchangedBadge');
            const changedBadge = document.getElementById('approvalChangedBadge');
            const requiredMark = document.getElementById('approvalNoteRequiredMark');
            const noteHelp = document.getElementById('approvalNoteHelp');
            const viDisplay = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 3 });
            const viInput = new Intl.NumberFormat('vi-VN', { useGrouping: false, maximumFractionDigits: 3 });
            let isSubmitting = false;

            rows.forEach(function (row) {
                const input = row.querySelector('.pr-approval-input');
                input.addEventListener('input', function () { syncRow(row, false); updateSummary(); });
                input.addEventListener('blur', function () {
                    const value = syncRow(row, true);
                    if (value !== null) input.value = viInput.format(value);
                    updateSummary();
                });
            });
            note.addEventListener('input', function () { note.classList.remove('is-invalid'); });
            updateSummary();

            form.addEventListener('submit', function (event) {
                if (isSubmitting) { event.preventDefault(); return; }

                let invalidInput = null;
                rows.forEach(function (row) {
                    if (syncRow(row, true) === null && !invalidInput)
                        invalidInput = row.querySelector('.pr-approval-input');
                });
                const summary = updateSummary();
                if (invalidInput) {
                    event.preventDefault();
                    invalidInput.focus();
                    return;
                }
                if (summary.positiveCount === 0) {
                    event.preventDefault();
                    window.alert('Phải duyệt ít nhất một sản phẩm với số lượng lớn hơn 0. Nếu không mua sản phẩm nào, hãy dùng thao tác Từ chối.');
                    rows[0].querySelector('.pr-approval-input').focus();
                    return;
                }
                if (summary.changedCount > 0 && !note.value.trim()) {
                    event.preventDefault();
                    note.classList.add('is-invalid');
                    note.focus();
                    return;
                }

                let message = summary.increaseCount > 0
                    ? 'Có ' + summary.increaseCount + ' dòng được duyệt tăng so với nhân viên yêu cầu. Bạn xác nhận tiếp tục?'
                    : summary.changedCount > 0
                        ? 'Xác nhận duyệt với ' + summary.changedCount + ' dòng đã điều chỉnh?'
                        : 'Xác nhận duyệt giữ nguyên toàn bộ số lượng nhân viên yêu cầu?';
                if (form.dataset.selfApproval === 'true')
                    message = 'CẢNH BÁO TỰ DUYỆT: yêu cầu này do chính bạn tạo.\n\n' + message;
                if (!window.confirm(message)) { event.preventDefault(); return; }

                isSubmitting = true;
                document.getElementById('approveRequestButton').disabled = true;
            });

            function syncRow(row, showInvalid) {
                const input = row.querySelector('.pr-approval-input');
                const hidden = row.querySelector('.pr-approval-value');
                const value = parseQuantity(input.value);
                const valid = value !== null && value >= 0 && value <= 999999999999;
                input.classList.toggle('is-invalid', showInvalid && !valid);
                if (!valid) {
                    hidden.value = '';
                    setDelta(row, null);
                    return null;
                }

                const rounded = Math.round((value + Number.EPSILON) * 1000) / 1000;
                hidden.value = String(rounded);
                setDelta(row, rounded - Number(row.dataset.requested));
                return rounded;
            }

            function setDelta(row, delta) {
                const badge = row.querySelector('.pr-delta-badge');
                badge.className = 'pr-delta-badge';
                row.classList.remove('is-increased');
                if (delta === null || !Number.isFinite(delta)) {
                    badge.classList.add('pr-delta-zero');
                    badge.textContent = 'Chưa hợp lệ';
                } else if (Math.abs(delta) < 0.0005) {
                    badge.classList.add('pr-delta-zero');
                    badge.textContent = 'Không đổi';
                } else if (delta > 0) {
                    badge.classList.add('pr-delta-up');
                    badge.textContent = '+' + viDisplay.format(delta);
                    row.classList.add('is-increased');
                } else {
                    badge.classList.add('pr-delta-down');
                    badge.textContent = '−' + viDisplay.format(Math.abs(delta));
                }
            }

            function updateSummary() {
                let changedCount = 0;
                let increaseCount = 0;
                let positiveCount = 0;
                rows.forEach(function (row) {
                    const hiddenValue = row.querySelector('.pr-approval-value').value;
                    if (!hiddenValue) return;
                    const finalQuantity = Number(hiddenValue);
                    const delta = finalQuantity - Number(row.dataset.requested);
                    if (finalQuantity > 0) positiveCount++;
                    if (Math.abs(delta) >= 0.0005) changedCount++;
                    if (delta >= 0.0005) increaseCount++;
                });

                note.required = changedCount > 0;
                requiredMark.classList.toggle('d-none', changedCount === 0);
                unchangedBadge.classList.toggle('d-none', changedCount > 0);
                changedBadge.classList.toggle('d-none', changedCount === 0);
                if (changedCount > 0)
                    changedBadge.textContent = changedCount + ' dòng đã điều chỉnh — bắt buộc có lý do';
                increaseWarning.classList.toggle('d-none', increaseCount === 0);
                if (increaseCount > 0)
                    increaseText.textContent = increaseCount + ' dòng cao hơn yêu cầu ban đầu. Hãy kiểm tra tồn kho, hàng đang về và ghi rõ lý do tăng.';
                noteHelp.textContent = changedCount > 0
                    ? 'Bắt buộc nhập lý do vì có số lượng duyệt khác yêu cầu ban đầu.'
                    : 'Không bắt buộc nếu giữ nguyên toàn bộ số lượng. Ghi chú sẽ được lưu trong lịch sử xử lý.';
                return { changedCount: changedCount, increaseCount: increaseCount, positiveCount: positiveCount };
            }

            function parseQuantity(raw) {
                let text = String(raw || '').trim().replace(/[\s\u00a0]/g, '').replace(/^\+/, '');
                if (!text || !/^\d[\d.,]*$/.test(text)) return null;

                const hasComma = text.includes(',');
                const hasDot = text.includes('.');
                let canonical = text;
                if (hasComma && hasDot) {
                    const decimalSeparator = text.lastIndexOf(',') > text.lastIndexOf('.') ? ',' : '.';
                    const groupingSeparator = decimalSeparator === ',' ? '.' : ',';
                    if (text.split(decimalSeparator).length !== 2) return null;
                    const parts = text.split(decimalSeparator);
                    const groups = parts[0].split(groupingSeparator);
                    if (groups.length > 1 && (groups[0].length < 1 || groups[0].length > 3 || groups.slice(1).some(function (x) { return x.length !== 3; })))
                        return null;
                    canonical = groups.join('') + '.' + parts[1];
                } else if (hasComma || hasDot) {
                    const separator = hasComma ? ',' : '.';
                    if (text.split(separator).length !== 2) return null;
                    canonical = text.replace(separator, '.');
                }

                const decimalPart = canonical.includes('.') ? canonical.split('.')[1] : '';
                if (decimalPart.length > 3) return null;
                const value = Number(canonical);
                return Number.isFinite(value) ? value : null;
            }
        })();
    </script>
}
