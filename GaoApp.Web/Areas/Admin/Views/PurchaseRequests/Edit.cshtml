@model GaoApp.Web.Areas.Admin.Models.Purchases.PurchaseRequestEditViewModel
@using GaoApp.Domain.Enums
@using GaoApp.Web.Areas.Admin.Models.Purchases
@{
    var isEdit = Model.Request.Id.HasValue;
    ViewData["Title"] = isEdit ? "Chỉnh sửa yêu cầu mua hàng" : "Tạo yêu cầu mua hàng";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";
    var selectedProducts = Model.SelectedProducts.ToDictionary(x => x.ProductUnitConversionId);
    var validLines = Model.Request.Lines
        .Where(x => x.Quantity > 0 &&
                    (x.ItemKind == PurchaseItemKind.FreeText
                        ? !string.IsNullOrWhiteSpace(x.ProductName) && !string.IsNullOrWhiteSpace(x.UnitName)
                        : x.ProductVariantId > 0 && x.ProductUnitConversionId > 0))
        .ToList();
    var statusLabel = Model.Status == PurchaseRequestStatus.ReturnedForRevision ? "Cần chỉnh sửa" : "Bản nháp";
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a class="btn btn-icon btn-label-secondary rounded-pill" asp-action="Index" aria-label="Quay lại danh sách"><i class="bx bx-arrow-back"></i></a>
                    <h3 class="gds-page-header__title mb-0">@ViewData["Title"]</h3>
                    <span class="badge @(Model.Status == PurchaseRequestStatus.ReturnedForRevision ? "bg-label-warning" : "bg-label-secondary")">@statusLabel</span>
                </div>
                <p class="gds-page-header__subtitle mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.RequestNumber)) { <span>@Model.RequestNumber · </span> }
                    Ghi đúng mặt hàng, đơn vị và số lượng; quản lý sẽ xử lý kho và đơn đặt hàng ở bước sau.
                </p>
            </div>
            <div class="gds-page-header__actions">
                <button type="button" class="btn btn-label-secondary gds-action-button pr-shortcut-help" data-bs-toggle="modal" data-bs-target="#shortcutHelpModal">
                    <i class="bx bx-command"></i><span>Phím tắt</span><kbd>Ctrl /</kbd>
                </button>
            </div>
        </div>
    </div>
}

@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}
@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/purchase-request-edit.css" asp-append-version="true" />
}

<div class="pr-page gds-page" data-gao-ui="modern" id="purchaseRequestPage"
     data-product-lookup-url="@Url.Content("~/admin/purchase-requests/product-lookup")"
     data-decoder-url="@Url.Content("~/lib/zxing-browser/0.1.5/zxing-browser.min.js")">
    <form method="post" asp-action="Save" id="purchaseRequestForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Request.Id" />
        <input type="hidden" name="RowVersion" value="@Model.Request.RowVersion" />
        <input type="hidden" name="RequestDate" value="@Model.Request.RequestDate.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="intent" id="formIntent" value="save" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger shadow-sm" role="alert"></div>
        }
        @if (Model.Status == PurchaseRequestStatus.ReturnedForRevision && !string.IsNullOrWhiteSpace(Model.WorkflowNote))
        {
            <div class="alert alert-warning shadow-sm d-flex gap-2" role="alert">
                <i class="bx bx-message-detail fs-5"></i>
                <div><strong>Quản lý yêu cầu chỉnh sửa</strong><div>@Model.WorkflowNote</div></div>
            </div>
        }

        <section class="card border-0 shadow-sm pr-title-card mb-3" aria-labelledby="requestInfoTitle">
            <div class="card-body">
                <div class="pr-section-heading mb-3">
                    <span class="pr-section-icon"><i class="bx bx-file"></i></span>
                    <div><h5 class="mb-0" id="requestInfoTitle">Thông tin yêu cầu</h5><small>Đặt tên dễ nhận biết và thêm ghi chú khi cần.</small></div>
                </div>
                <label class="form-label fw-semibold" for="Title">Tên yêu cầu mua hàng <span class="text-danger">*</span></label>
                <div class="position-relative">
                    <input class="form-control form-control-lg pr-title-input" id="Title" name="Title" value="@Model.Request.Title" maxlength="250" required autofocus
                           placeholder="Ví dụ: Mua bổ sung sữa bán tuần này" autocomplete="off" />
                    <span class="pr-field-shortcut">F2</span>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <small class="text-muted">Tên ngắn gọn giúp quản lý tìm và duyệt phiếu nhanh hơn.</small>
                    <small class="text-muted"><span id="titleCount">0</span>/250</small>
                </div>
                <div class="accordion accordion-flush mt-3" id="requestNoteAccordion">
                    <div class="accordion-item border rounded-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#requestNotePanel">
                                <i class="bx bx-note me-2"></i>Thêm ghi chú <span class="text-muted ms-1">(không bắt buộc)</span>
                            </button>
                        </h2>
                        <div id="requestNotePanel" class="accordion-collapse collapse @(string.IsNullOrWhiteSpace(Model.Request.Note) ? string.Empty : "show")">
                            <div class="accordion-body p-3">
                                <textarea class="form-control" id="Note" name="Note" rows="3" maxlength="1000" placeholder="Ghi rõ yêu cầu đặc biệt nếu có...">@Model.Request.Note</textarea>
                                <div class="text-end small text-muted mt-1"><span id="noteCount">0</span>/1000</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm pr-products-card" aria-labelledby="requestLinesTitle">
            <div class="card-header border-bottom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="pr-section-heading">
                        <span class="pr-section-icon"><i class="bx bx-package"></i></span>
                        <div><h5 class="mb-0" id="requestLinesTitle">Mặt hàng cần mua</h5><small>Quét mã hoặc tìm sản phẩm, sau đó chọn đúng đơn vị và nhập số lượng.</small></div>
                    </div>
                    <span class="badge bg-label-primary rounded-pill"><span id="lineCountBadge">@validLines.Count</span> mặt hàng</span>
                </div>
            </div>

            <div class="card-body border-bottom pr-product-toolbar">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-xl">
                        <label class="form-label fw-semibold" for="productSearch">Tìm hoặc quét sản phẩm</label>
                        <div class="position-relative">
                            <select id="productSearch" class="form-select" aria-label="Tìm sản phẩm"></select>
                            <span class="pr-search-shortcut">F3</span>
                        </div>
                    </div>
                    <div class="col-6 col-xl-auto">
                        <button type="button" class="btn btn-primary pr-camera-button w-100" id="openCameraScanner">
                            <i class="bx bx-barcode-reader me-1"></i>Quét camera <kbd>Alt C</kbd>
                        </button>
                    </div>
                    <div class="col-6 col-xl-auto">
                        <button type="button" class="btn btn-outline-primary w-100" id="openFreeTextModal">
                            <i class="bx bx-edit me-1"></i>Hàng chưa có <kbd>F4</kbd>
                        </button>
                    </div>
                </div>
                <div class="pr-toolbar-hint"><i class="bx bx-info-circle"></i><span>Quét đúng barcode sẽ tự chọn đơn vị tương ứng. Mã cũ sẽ được cảnh báo trước khi thêm.</span></div>
            </div>

            <div class="table-responsive pr-lines-wrap">
                <table class="table align-middle mb-0 pr-lines-table">
                    <thead><tr><th style="width:50px">#</th><th>Sản phẩm</th><th style="width:180px">Tồn / đang về</th><th style="width:180px">Đơn vị mua</th><th style="width:190px">Số lượng yêu cầu</th><th style="width:86px"></th></tr></thead>
                    <tbody id="lineRows">
                    @for (var i = 0; i < validLines.Count; i++)
                    {
                        var line = validLines[i];
                        GaoApp.Application.DTOs.Purchases.PurchaseRequestProductLookupDto? product = null;
                        if (line.ProductUnitConversionId.HasValue) selectedProducts.TryGetValue(line.ProductUnitConversionId.Value, out product);
                        var isFreeText = line.ItemKind == PurchaseItemKind.FreeText;
                        var productName = isFreeText ? line.ProductName : product?.Text ?? line.ProductName ?? $"Sản phẩm #{line.ProductVariantId}";
                        var unitName = isFreeText ? line.UnitName : product?.UnitName ?? line.UnitName ?? "Đơn vị";
                        var factor = isFreeText || product == null ? 1m : product.Factor;
                        var stock = factor > 0 ? (product?.CurrentStockBaseQuantity ?? 0) / factor : 0;
                        var incoming = factor > 0 ? (product?.IncomingBaseQuantity ?? 0) / factor : 0;
                        <tr class="request-line"
                            data-line-key="@(isFreeText ? $"free:{productName?.Trim().ToLowerInvariant()}|{unitName?.Trim().ToLowerInvariant()}" : $"catalog:{line.ProductUnitConversionId}")"
                            data-item-kind="@((int)line.ItemKind)" data-product-name="@productName" data-sku="@(product?.Sku ?? string.Empty)"
                            data-unit-name="@unitName" data-factor="@PurchaseQuantityFormatter.Invariant(factor)" data-stock-base="@(product?.CurrentStockBaseQuantity ?? 0)" data-incoming-base="@(product?.IncomingBaseQuantity ?? 0)">
                            <td class="pr-line-number" data-label="#">@(i + 1)</td>
                            <td data-label="Sản phẩm">
                                <input type="hidden" class="line-id" name="Lines[@i].Id" value="@line.Id" />
                                <input type="hidden" class="item-kind" name="Lines[@i].ItemKind" value="@((int)line.ItemKind)" />
                                <input type="hidden" class="variant-id" name="Lines[@i].ProductVariantId" value="@line.ProductVariantId" />
                                <input type="hidden" class="conversion-id" name="Lines[@i].ProductUnitConversionId" value="@line.ProductUnitConversionId" />
                                <input type="hidden" class="product-name-input" name="Lines[@i].ProductName" value="@productName" />
                                <input type="hidden" class="unit-name-input" name="Lines[@i].UnitName" value="@unitName" />
                                <div class="pr-product-cell"><span class="pr-product-thumb"><i class="bx bx-package"></i></span><div><div class="fw-semibold pr-product-name">@productName</div>
                                @if (isFreeText) { <small class="text-warning pr-free-text-badge"><i class="bx bx-pencil me-1"></i>Hàng chưa có trong danh mục</small> }
                                else { <small class="text-muted pr-product-sku">@(string.IsNullOrWhiteSpace(product?.Sku) ? string.Empty : $"SKU: {product.Sku}")</small> }
                                <span class="badge bg-label-warning ms-2 d-none pr-open-request-badge">Đã có yêu cầu mở</span></div></div>
                            </td>
                            <td data-label="Tồn / đang về"><div class="pr-inventory"><strong>@PurchaseQuantityFormatter.Display(stock) @unitName</strong><small>Đang về: @PurchaseQuantityFormatter.Display(incoming) @unitName</small></div></td>
                            <td data-label="Đơn vị mua"><span class="badge bg-label-primary pr-unit-name">@unitName</span>@if(!isFreeText){<small class="text-muted d-block mt-1">Quy đổi ×<span class="pr-factor">@PurchaseQuantityFormatter.Display(factor)</span></small>}</td>
                            <td data-label="Số lượng"><input class="form-control text-end quantity" type="number" min="0.001" step="0.001" name="Lines[@i].Quantity" value="@PurchaseQuantityFormatter.Invariant(line.Quantity)" required /></td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-text-danger rounded-pill remove-line" title="Xóa sản phẩm"><i class="bx bx-trash"></i></button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="pr-empty-state @(validLines.Count > 0 ? "d-none" : string.Empty)" id="emptyLineState">
                    <span class="pr-empty-icon"><i class="bx bx-basket"></i></span>
                    <h6>Chưa có sản phẩm nào</h6>
                    <p>Tìm theo tên, SKU, quét barcode hoặc dùng camera để bắt đầu.</p>
                    <div class="d-flex gap-2"><button type="button" class="btn btn-primary" id="emptyAddProduct"><i class="bx bx-search me-1"></i>Tìm sản phẩm</button><button type="button" class="btn btn-outline-primary" id="emptyOpenCamera"><i class="bx bx-barcode-reader me-1"></i>Quét camera</button></div>
                </div>
            </div>
            <div class="alert alert-danger m-3 d-none" id="lineValidationMessage" role="alert"></div>
        </section>

        <div class="pr-sticky-actions">
            <div class="pr-summary"><div><span>Mặt hàng</span><strong id="summaryLineCount">@validLines.Count</strong></div><div><span>Tổng số lượng</span><strong id="summaryQuantity">0</strong></div></div>
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a class="btn btn-label-secondary" asp-action="Index">Hủy</a>
                <button type="button" class="btn btn-outline-primary pr-submit-button" data-intent="save"><i class="bx bx-save me-1"></i>Lưu nháp <kbd>Ctrl S</kbd></button>
                @if (Model.CanSubmit) { <button type="button" class="btn btn-primary pr-submit-button" data-intent="submit"><i class="bx bx-send me-1"></i>Gửi duyệt <kbd>Alt ↵</kbd></button> }
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content pr-modal-content">
        <div class="modal-header"><div><div class="pr-modal-eyebrow">THÊM VÀO YÊU CẦU</div><h5 class="modal-title" id="productDetailModalLabel">Chọn đơn vị và số lượng</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="pr-selected-product"><span class="pr-selected-image" id="modalProductImage"><i class="bx bx-package"></i></span><div class="min-w-0"><h5 class="mb-1 text-truncate" id="modalProductName">—</h5><div class="small text-muted" id="modalProductMeta">—</div></div></div>
            <div class="pr-stock-strip"><div><span>Tồn hiện tại</span><strong id="modalCurrentStock">—</strong><small id="modalCurrentStockBase">—</small></div><div><span>Đang về</span><strong id="modalIncoming">—</strong><small id="modalIncomingBase">—</small></div></div>
            <div class="alert alert-warning py-2 d-none" id="modalOpenRequestWarning"><i class="bx bx-info-circle me-1"></i><span></span></div>
            <div class="alert alert-warning py-2 d-none" id="modalHistoricalBarcodeWarning"><i class="bx bx-history me-1"></i>Mã vừa quét là barcode cũ. Hệ thống đã chọn đơn vị đang sử dụng; hãy kiểm tra trước khi thêm.</div>
            <label class="form-label fw-semibold">Đơn vị mua <span class="text-danger">*</span></label>
            <div class="pr-unit-options" id="modalUnitOptions" role="radiogroup" aria-label="Chọn đơn vị mua"></div>
            <div class="mt-3"><label class="form-label fw-semibold" for="modalQuantity">Số lượng cần mua <span class="text-danger">*</span></label><input class="form-control form-control-lg text-end" id="modalQuantity" type="number" min="0.001" step="0.001" value="1" /></div>
            <div class="pr-base-equivalent" id="modalBaseEquivalent">—</div>
            <div class="alert alert-danger py-2 mt-3 mb-0 d-none" id="modalProductError"></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-outline-primary" id="saveProductAndContinue"><i class="bx bx-plus me-1"></i>Thêm &amp; tiếp tục <kbd>Ctrl ↵</kbd></button><button type="button" class="btn btn-primary" id="saveProductLine"><i class="bx bx-check me-1"></i>Thêm &amp; đóng <kbd>Enter</kbd></button></div>
    </div></div>
</div>

<div class="modal fade" id="purchaseCameraModal" tabindex="-1" aria-labelledby="purchaseCameraTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content">
        <div class="modal-header"><div><div class="pr-modal-eyebrow">QUÉT SẢN PHẨM</div><h5 class="modal-title" id="purchaseCameraTitle">Quét barcode bằng camera</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="pr-camera-stage"><video id="purchaseCameraVideo" muted playsinline autoplay></video><div class="pr-scan-frame" aria-hidden="true"></div><span>Giữ barcode rõ nét trong khung</span></div>
            <p class="pr-camera-message" id="purchaseCameraMessage" role="status" aria-live="polite"></p>
            <div class="d-flex gap-2 justify-content-between"><button type="button" class="btn btn-outline-secondary" id="purchaseCameraTorch" hidden>Bật đèn</button><button type="button" class="btn btn-outline-primary ms-auto" id="purchaseCameraRetry"><i class="bx bx-refresh me-1"></i>Quét lại</button></div>
        </div>
        <div class="modal-footer"><small class="text-muted me-auto">Camera dừng sau khi nhận một mã.</small><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button></div>
    </div></div>
</div>

<div class="modal fade" id="freeTextProductModal" tabindex="-1" aria-labelledby="freeTextProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content pr-modal-content">
        <div class="modal-header"><div><div class="pr-modal-eyebrow">HÀNG CHƯA CÓ TRONG DANH MỤC</div><h5 class="modal-title" id="freeTextProductModalLabel">Nhập mặt hàng cần mua</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="alert alert-info py-2"><i class="bx bx-info-circle me-1"></i>Quản lý sẽ ghép mặt hàng này với danh mục hoặc tạo sản phẩm trước khi nhập kho.</div>
            <div class="mb-3"><label class="form-label" for="freeTextProductName">Tên mặt hàng <span class="text-danger">*</span></label><input class="form-control form-control-lg" id="freeTextProductName" maxlength="250" autocomplete="off" placeholder="Ví dụ: Nước rửa tay hương chanh 500ml" /></div>
            <div class="mb-3"><label class="form-label" for="freeTextUnitName">Đơn vị mua <span class="text-danger">*</span></label><input class="form-control" id="freeTextUnitName" list="purchaseUnitNames" maxlength="100" autocomplete="off" placeholder="Gõ hoặc chọn đơn vị..." /><datalist id="purchaseUnitNames">@foreach (var unitName in Model.UnitNames){<option value="@unitName"></option>}<option value="Đơn vị khác"></option></datalist></div>
            <div><label class="form-label" for="freeTextQuantity">Số lượng <span class="text-danger">*</span></label><input class="form-control text-end" id="freeTextQuantity" type="number" min="0.001" step="0.001" value="1" /></div>
            <div class="alert alert-danger py-2 mt-3 mb-0 d-none" id="freeTextProductError"></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-outline-primary" id="saveFreeTextAndContinue"><i class="bx bx-plus me-1"></i>Thêm &amp; tiếp tục <kbd>Ctrl ↵</kbd></button><button type="button" class="btn btn-primary" id="saveFreeTextLine"><i class="bx bx-check me-1"></i>Thêm vào yêu cầu <kbd>Enter</kbd></button></div>
    </div></div>
</div>

<div class="modal fade" id="shortcutHelpModal" tabindex="-1" aria-labelledby="shortcutHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="shortcutHelpModalLabel"><i class="bx bx-command me-1"></i>Phím tắt thao tác nhanh</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="pr-shortcut-list"><div><span>Nhập tên yêu cầu</span><kbd>F2</kbd></div><div><span>Tìm hoặc quét sản phẩm</span><kbd>F3</kbd></div><div><span>Quét bằng camera</span><span><kbd>Alt</kbd> <kbd>C</kbd></span></div><div><span>Nhập hàng chưa có</span><kbd>F4</kbd></div><div><span>Thêm và đóng cửa sổ</span><kbd>Enter</kbd></div><div><span>Thêm rồi tiếp tục</span><span><kbd>Ctrl</kbd> <kbd>Enter</kbd></span></div><div><span>Lưu bản nháp</span><span><kbd>Ctrl</kbd> <kbd>S</kbd></span></div><div><span>Gửi duyệt</span><span><kbd>Alt</kbd> <kbd>Enter</kbd></span></div></div></div></div></div>
</div>

<template id="lineTemplate">
    <tr class="request-line"><td class="pr-line-number" data-label="#"></td><td data-label="Sản phẩm"><input type="hidden" class="line-id" /><input type="hidden" class="item-kind" /><input type="hidden" class="variant-id" /><input type="hidden" class="conversion-id" /><input type="hidden" class="product-name-input" /><input type="hidden" class="unit-name-input" /><div class="pr-product-cell"><span class="pr-product-thumb"><i class="bx bx-package"></i></span><div><div class="fw-semibold pr-product-name"></div><small class="text-muted pr-product-sku"></small><small class="text-warning d-none pr-free-text-badge"><i class="bx bx-pencil me-1"></i>Hàng chưa có trong danh mục</small><span class="badge bg-label-warning ms-2 d-none pr-open-request-badge">Đã có yêu cầu mở</span></div></div></td><td data-label="Tồn / đang về"><div class="pr-inventory"><strong class="pr-stock"></strong><small class="pr-incoming"></small></div></td><td data-label="Đơn vị mua"><span class="badge bg-label-primary pr-unit-name"></span><small class="text-muted d-block mt-1 pr-factor-wrap">Quy đổi ×<span class="pr-factor"></span></small></td><td data-label="Số lượng"><input class="form-control text-end quantity" type="number" min="0.001" step="0.001" required /></td><td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-text-danger rounded-pill remove-line" title="Xóa sản phẩm"><i class="bx bx-trash"></i></button></td></tr>
</template>

@section VendorScripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
}
@section PageScripts {
