@{
    ViewData["Title"] = "Chuẩn hóa barcode";
    Layout = "_ContentNavbarLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Chuẩn hóa barcode</h3>
            <div class="text-muted">
                Xử lý mã barcode do nhân viên nhập kho đề xuất.
            </div>
        </div>

        <button type="button" class="btn btn-outline-primary" id="btnReloadBarcodeRequests">
            Tải lại
        </button>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text"
                           class="form-control"
                           id="barcodeRequestKeyword"
                           placeholder="Tìm sản phẩm, đơn vị, barcode..." />
                </div>

                <div class="col-md-3">
                    <select class="form-select" id="barcodeRequestStatus">
                        <option value="1" selected>Chờ xử lý</option>
                        <option value="">Tất cả</option>
                        <option value="2">Đã duyệt</option>
                        <option value="3">Từ chối</option>
                        <option value="4">Đã xác nhận không có mã</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" id="btnSearchBarcodeRequests">
                        Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">#</th>
                        <th>Sản phẩm</th>
                        <th style="width:120px;">Đơn vị</th>
                        <th style="width:100px;">Factor</th>
                        <th style="width:180px;">Barcode đề xuất</th>
                        <th style="width:170px;">Loại</th>
                        <th style="width:150px;">Trạng thái</th>
                        <th style="width:170px;">Ngày gửi</th>
                        <th style="width:220px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody id="barcodeRequestTableBody">
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="barcodeResolveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="barcodeResolveTitle">Xử lý barcode</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="barcodeResolveId" />
                <input type="hidden" id="barcodeResolveAction" />

                <div class="mb-3">
                    <div class="text-muted small">Sản phẩm</div>
                    <div class="fw-bold" id="barcodeResolveProductName">-</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Đơn vị</div>
                    <div class="fw-bold" id="barcodeResolveUnitName">-</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Barcode đề xuất</div>
                    <div class="fw-bold text-primary" id="barcodeResolveSuggestedBarcode">-</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ghi chú quản lý</label>
                    <textarea class="form-control"
                              id="barcodeResolveManagerNote"
                              rows="3"
                              placeholder="Nhập ghi chú nếu có..."></textarea>
                </div>

                <div class="text-danger small" id="barcodeResolveMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button" class="btn btn-primary" id="btnConfirmBarcodeResolve">
                    Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/admin/js/barcode-normalization.js"></script>
}