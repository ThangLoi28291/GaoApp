@using System.Text.Json
@model GaoApp.Web.Areas.Admin.Models.LegacyReturnArchiveDetail
@{
    ViewData["Title"] = $"Phiếu trả hàng cũ {Model.LegacyOrderId}";
    Layout = "_ContentNavbarLayout";
    using var header = JsonDocument.Parse(Model.HeaderJson);
    using var details = JsonDocument.Parse(Model.DetailsJson);
    string Text(JsonElement row, string property) => row.TryGetProperty(property, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : "—";
}
<div class="card">
    <div class="card-header">
        <a href="/admin/pos/legacy-returns">← Lịch sử trả hàng cũ</a>
        <h1 class="h4 mt-3">Phiếu trả hàng cũ #@Model.LegacyOrderId</h1>
        <p class="text-muted">Chỉ tra cứu · Chưa liên kết đơn bán gốc</p>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Ngày (UTC+7)</dt><dd class="col-sm-9">@(Model.OccurredAtUtc?.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd>
            <dt class="col-sm-3">Khách hàng</dt><dd class="col-sm-9">@(Model.CustomerName ?? "—") · Mã cũ: @Model.LegacyCustomerId</dd>
            <dt class="col-sm-3">Nhân viên</dt><dd class="col-sm-9">@(Model.EmployeeName ?? "—") · Mã cũ: @Model.LegacyUserId</dd>
            <dt class="col-sm-3">Số tiền nguồn</dt><dd class="col-sm-9">@(Model.SourceTotal?.ToString("N0") ?? "—")</dd>
            <dt class="col-sm-3">Thanh toán ghi trong nguồn</dt><dd class="col-sm-9">@(Model.SourcePaymentFlag.HasValue ? (Model.SourcePaymentFlag.Value ? "Chuyển khoản" : "Tiền mặt") : "Không ghi")</dd>
            <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@Text(header.RootElement, "Note")</dd>
        </dl>
        <h2 class="h5">Chi tiết ghi trong nguồn</h2>
        <div class="table-responsive"><table class="table">
            <thead><tr><th>Mã dòng cũ</th><th>Mã hàng</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th>Ghi chú</th></tr></thead>
            <tbody>
            @foreach (var line in details.RootElement.EnumerateArray())
            {
                <tr><td>@Text(line,"ID")</td><td>@Text(line,"ProductCode")</td><td>@Text(line,"Quantity")</td><td>@Text(line,"Price")</td><td>@Text(line,"Total")</td><td>@Text(line,"Note")</td></tr>
            }
            @if (details.RootElement.GetArrayLength() == 0) { <tr><td colspan="6">Nguồn không có dòng chi tiết liên quan.</td></tr> }
            </tbody>
        </table></div>
        <details class="mt-3"><summary>Dữ liệu nguồn đầy đủ</summary><pre class="mt-2 text-wrap">@JsonSerializer.Serialize(header.RootElement, new JsonSerializerOptions { WriteIndented = true })</pre><pre class="text-wrap">@JsonSerializer.Serialize(details.RootElement, new JsonSerializerOptions { WriteIndented = true })</pre></details>
    </div>
</div>
