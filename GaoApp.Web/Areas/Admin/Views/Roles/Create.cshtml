@model GaoApp.Application.DTOs.Security.Roles.RoleCreateRequest

@{
    ViewData["Title"] = "Tạo vai trò";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Tạo vai trò</h3>
            <div class="text-muted">Tạo vai trò mới cho cửa hàng hiện tại.</div>
        </div>

        <a asp-area="Admin"
               asp-controller="Roles"
               asp-action="Index"
               class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-area="Admin"
          asp-controller="Roles"
          asp-action="Create"
          method="post">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pb-0">
                <h5 class="mb-1">Thông tin vai trò</h5>
                <div class="text-muted small">Nhập mã và tên vai trò cho cửa hàng hiện tại.</div>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label fw-semibold">Mã vai trò</label>
                        <input asp-for="Code"
                               class="form-control"
                               placeholder="Ví dụ: manager, cashier, warehouse_staff" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                        <div class="form-text">
                            Mã vai trò nên ngắn gọn, ổn định và không bị đổi thường xuyên.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">Tên vai trò</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Ví dụ: Quản lý, Thu ngân, Nhân viên kho" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i> Lưu
            </button>

            <a asp-area="Admin"
                   asp-controller="Roles"
                   asp-action="Index"
                   class="btn btn-light border">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}