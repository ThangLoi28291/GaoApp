@model GaoApp.Application.DTOs.Security.Roles.RoleIndexVm

@{
    ViewData["Title"] = "Quản lý vai trò";

    var canCreate = (bool?)ViewBag.CanCreate == true;
    var canUpdate = (bool?)ViewBag.CanUpdate == true;
    var canDelete = (bool?)ViewBag.CanDelete == true;
    var canPermissions = (bool?)ViewBag.CanPermissions == true;
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Quản lý vai trò</h3>
            <div class="text-muted">Quản lý vai trò theo cửa hàng hiện tại.</div>
        </div>

        @if (canCreate)
        {
            <a asp-area="Admin"
                   asp-controller="Roles"
                   asp-action="Create"
                   class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Tạo vai trò
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Vai trò đang hoạt động</div>
                    <div class="fs-4 fw-bold mt-2">@Model.TotalActiveRoles</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Vai trò ngưng sử dụng</div>
                    <div class="fs-4 fw-bold mt-2">@Model.TotalInactiveRoles</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get"
                  asp-area="Admin"
                  asp-controller="Roles"
                  asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Từ khóa</label>
                        <input name="Keyword"
                               value="@Model.Query.Keyword"
                               class="form-control"
                               placeholder="Tìm theo mã hoặc tên vai trò" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select name="IsActive" class="form-select">
                            <option value="">-- Tất cả --</option>

                            @if (Model.Query.IsActive == true)
                            {
                                <option value="true" selected>Đang hoạt động</option>
                            }
                            else
                            {
                                <option value="true">Đang hoạt động</option>
                            }

                            @if (Model.Query.IsActive == false)
                            {
                                <option value="false" selected>Ngưng sử dụng</option>
                            }
                            else
                            {
                                <option value="false">Ngưng sử dụng</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Số dòng</label>
                        <select name="PageSize" class="form-select">
                            @{
                                var pageSizes = new[] { 10, 20, 50 };
                            }

                            @foreach (var size in pageSizes)
                            {
                                if (Model.Query.PageSize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search me-1"></i> Tìm kiếm
                        </button>

                        <a asp-area="Admin"
                               asp-controller="Roles"
                               asp-action="Index"
                               class="btn btn-light border">
                            Đặt lại
                        </a>
                    </div>
                </div>

                <input type="hidden" name="Page" value="1" />
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px;">#</th>
                        <th>Mã vai trò</th>
                        <th>Tên vai trò</th>
                        <th>Loại</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Số quyền</th>
                        <th class="text-center">Số user</th>
                        <th>Ngày tạo</th>
                        <th style="width:260px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles.Items == null || !Model.Roles.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                Chưa có dữ liệu vai trò.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var startNo = ((Model.Roles.Page - 1) * Model.Roles.PageSize) + 1;

                        @for (int i = 0; i < Model.Roles.Items.Count; i++)
                        {
                            var item = Model.Roles.Items[i];

                            <tr>
                                <td>@(startNo + i)</td>
                                <td>
                                    <span class="fw-semibold">@item.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                </td>
                                <td>
                                    @if (item.IsSystemRole)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Hệ thống</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info">Tùy chỉnh</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Ngưng sử dụng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold">@item.PermissionCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold">@item.UserCount</span>
                                </td>
                                <td>
                                    @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (canUpdate)
                                        {
                                            <a asp-area="Admin"
                                                   asp-controller="Roles"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                Sửa
                                            </a>
                                        }

                                      
                                        @if (canPermissions)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="RolePermissions"
                                               asp-action="Index"
                                               asp-route-roleId="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Phân quyền
                                            </a>
                                        }
                                      

                                        @if (canDelete)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Roles"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa vai trò này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Roles.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav>
                    <ul class="pagination mb-0 flex-wrap">
                        @{
                            var currentPage = Model.Roles.Page;
                            var totalPages = Model.Roles.TotalPages;
                        }

                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="Roles"
                                   asp-action="Index"
                                   asp-route-Page="@(currentPage - 1)"
                                   asp-route-PageSize="@Model.Query.PageSize"
                                   asp-route-Keyword="@Model.Query.Keyword"
                                   asp-route-IsActive="@Model.Query.IsActive">
                                Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="Roles"
                                       asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-PageSize="@Model.Query.PageSize"
                                       asp-route-Keyword="@Model.Query.Keyword"
                                       asp-route-IsActive="@Model.Query.IsActive">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="Roles"
                                   asp-action="Index"
                                   asp-route-Page="@(currentPage + 1)"
                                   asp-route-PageSize="@Model.Query.PageSize"
                                   asp-route-Keyword="@Model.Query.Keyword"
                                   asp-route-IsActive="@Model.Query.IsActive">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>