@model GaoApp.Application.DTOs.Inventory.StockDocumentDto
@using GaoApp.Domain.Enums

@{
    var canEdit = Model.Status == StockDocumentStatus.Draft
               || Model.Status == StockDocumentStatus.Rejected;

    var lines = Model.Lines ?? new List<GaoApp.Application.DTOs.Inventory.StockDocumentLineDto>();
    var totalQty = lines.Sum(x => x.Quantity);
}

@if (!lines.Any())
{
    <div class="wrd-empty">
        <div class="fw-bold">Chưa có hàng nào</div>
        <div class="small mt-1">Quét barcode hoặc tìm sản phẩm để thêm vào phiếu.</div>
    </div>
}
else
{
    <div class="wrd-table-wrap">
        <table class="wrd-table">
            <thead>
                <tr>
                    <th style="width:56px;">#</th>
                    <th>Sản phẩm</th>
                    <th style="width:90px;">ĐVT</th>
                    <th style="width:130px;">SL nhập</th>
                    <th style="width:90px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var line in lines.OrderBy(x => x.LineNo))
                {
                    <tr data-line-id="@line.Id">
                        <td class="wrd-line-no">@line.LineNo</td>

                        <td>
                            <div class="wrd-product-cell">
                                <div class="wrd-line-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(line.ProductImageUrl))
                                    {
                                        <img src="@line.ProductImageUrl" class="wrd-line-img" />
                                    }
                                    else
                                    {
                                        <div class="wrd-line-img-empty">
                                            <i class="bx bx-image"></i>
                                        </div>
                                    }
                                </div>

                                <div class="wrd-product-info">
                                    <div class="wrd-line-name">@line.ProductNameSnapshot</div>
                                    <div class="wrd-line-meta">
                                        Barcode: @(line.BarcodeSnapshot ?? line.SkuSnapshot ?? "-")
                                        · Factor: @line.Factor.ToString("0.###")
                                        · SL gốc: @line.BaseQuantity.ToString("0.###")
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="fw-bold">@line.UnitName</td>

                        <td>
                            @if (canEdit)
                            {
                                <input type="number"
                                       class="form-control text-center js-receiving-qty wrd-table-qty"
                                       value="@line.Quantity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                       min="0.001"
                                       step="0.001"
                                       inputmode="decimal"
                                       data-line-id="@line.Id"
                                       data-unit-id="@line.UnitId"
                                       data-unit-cost="@line.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-note="@line.Note" />
                            }
                            else
                            {
                                <div class="wrd-readonly-qty">@line.Quantity.ToString("0.###")</div>
                            }
                        </td>

                        <td>
                            @if (canEdit)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-delete-receiving-line"
                                        data-line-id="@line.Id"
                                        data-product-name="@line.ProductNameSnapshot">
                                    Xóa
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Tổng SL nhập:</td>
                    <td class="fw-bold text-primary">@totalQty.ToString("0.###")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}