@model GaoApp.Application.Storefront.StorefrontGuestOrder
@{ ViewData["Title"] = "Đơn website " + Model.Code; var orderId=Context.Request.RouteValues["id"]; }
<div class="container-fluid py-3"><a asp-action="Index" class="sf-inbox-link">← Danh sách đơn website</a><h1 class="h3">Đơn @Model.Code</h1><p>Tiếp nhận: @Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC · Trạng thái: @Model.Phase</p><div class="alert alert-info">Thanh toán: @Model.PaymentState · Giao: @Model.DeliveryState · Hoàn: @Model.RefundState. Nhận tiền QR chưa phải đã giao hoặc hoàn tất doanh thu; COD thu khi nhận. Hàng chỉ xuất khi có bàn giao thực tế được ghi nhận.</div>@if (Model.PaymentMethod == GaoApp.Domain.Storefront.StorefrontPaymentMethod.Qr) { <p><a asp-action="BankEvidence" asp-route-id="@orderId" class="btn btn-outline-success sf-inbox-action">Xem bằng chứng và đối soát QR</a></p> }<p><a href="/admin/storefront/fulfillment/@orderId" class="btn btn-success sf-inbox-action">Chuẩn bị, giao và đối soát</a></p><section class="card mb-3"><div class="card-body"><h2 class="h5">Người nhận</h2><p>@Model.Recipient.Name · @Model.Recipient.Phone</p><p>@Model.Recipient.StreetAddress, @Model.Recipient.WardName, @Model.Recipient.ProvinceName</p>@if (!string.IsNullOrWhiteSpace(Model.Recipient.Note)) { <p>Ghi chú: @Model.Recipient.Note</p> }</div></section><div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Đơn vị / số lượng</th><th>Giá</th><th>Giảm giá</th><th>Làm tròn</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td>@line.Name<div>@line.VariantName</div>@if (line.IsGift) { <strong>Quà tặng</strong> }<div>@line.PromotionName</div></td><td>@line.Quantity.ToString("0.####") @line.UnitName</td><td>@line.UnitPriceText</td><td>@line.DiscountText</td><td>@line.RoundingAdjustmentText</td><td>@line.NetAmountText</td></tr> }</tbody></table></div><p>Tiền hàng: <strong>@Model.GoodsAmountText</strong> · Phí giao: <strong>@Model.ShippingChargeText</strong> · Tổng: <strong>@Model.TotalDueText</strong></p><p>Đây là bản chụp đã xác nhận; thay đổi hàng đăng hoặc bảng phí mới không sửa đơn này.</p></div>
@section PageStyles { <link rel="stylesheet" href="~/Admin/css/storefront-orders.css" asp-append-version="true" /> }

