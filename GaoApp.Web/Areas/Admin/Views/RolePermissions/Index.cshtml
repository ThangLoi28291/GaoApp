@model GaoApp.Application.DTOs.Security.Permissions.RolePermissionMatrixDto
@using GaoApp.Application.DTOs.Security.UserInStores
@{
    ViewData["Title"] = "Phân quyền nhân viên";
    ViewData["container"] = "container-fluid";
    var roles = ViewBag.Roles as List<RoleLookupItemDto> ?? new();
    var canView = (bool?)ViewBag.CanRoleView == true;
    var canEdit = canView && (bool?)ViewBag.CanRoleUpdate == true;
    var canCreate = canView && (bool?)ViewBag.CanRoleCreate == true;
}
@section PageStyles {
    <link rel="stylesheet" href="~/Admin/css/role-permissions.css" asp-append-version="true" />
}
<div class="rp-page" id="rolePermissionsPage">
    <header class="rp-header">
        <div><p class="rp-eyebrow">NHÂN SỰ & PHÂN QUYỀN</p><h1>Ai được làm gì?</h1><p>Chọn vai trò, cấp quyền theo công việc và lưu để áp dụng cho nhân viên.</p></div>
        <div class="rp-actions">
            @if (canView) { <a asp-controller="Roles" asp-action="Index" class="rp-btn">Danh sách vai trò</a> }
            @if (canCreate) { <a asp-controller="Roles" asp-action="Create" class="rp-btn rp-primary"><i class="bx bx-plus" aria-hidden="true"></i> Tạo vai trò</a> }
        </div>
    </header>
    @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
    <section class="rp-role-card" aria-label="Vai trò đang phân quyền">
        <div class="rp-role-field"><label for="rolePicker">Vai trò cần phân quyền</label>
            <select id="rolePicker" data-url="@Url.Action("Index", "RolePermissions")">
                <option value="0">— Chọn vai trò —</option>
                @foreach (var role in roles) { <option value="@role.RoleId" selected="@(role.RoleId == Model.RoleId)">@role.DisplayText</option> }
                @if (Model.RoleId > 0 && !roles.Any(r => r.RoleId == Model.RoleId)) { <option value="@Model.RoleId" selected>@Model.RoleName (@Model.RoleCode)</option> }
            </select>
        </div>
        @if (Model.RoleId > 0)
        {
            <div class="rp-role-meta"><span class="rp-status">@(Model.RoleIsActive ? "Đang hoạt động" : "Ngưng sử dụng")</span><span>@Model.UserCount nhân viên đang dùng vai trò này</span></div>
            @if (canEdit) { <a asp-controller="Roles" asp-action="Edit" asp-route-id="@Model.RoleId" class="rp-text-link">Sửa tên vai trò <i class="bx bx-pencil" aria-hidden="true"></i></a> }
        }
    </section>
    @if (Model.RoleId == 0)
    {
        <section class="rp-empty-start"><i class="bx bx-shield-quarter" aria-hidden="true"></i><h2>Bắt đầu từ vai trò của nhân viên</h2><p>Chọn một vai trò ở trên để xem và thêm quyền.</p><p>Ví dụ: Thu ngân, Nhân viên kho hoặc Quản lý cửa hàng.</p>
            @if (canCreate) { <a asp-controller="Roles" asp-action="Create" class="rp-btn rp-primary">Tạo vai trò mới</a> }
        </section>
    }
    else
    {
        <form asp-controller="RolePermissions" asp-action="Save" method="post" id="rolePermissionForm" data-role-id="@Model.RoleId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RoleId" value="@Model.RoleId" />
            <div class="rp-summary" aria-label="Tổng quan quyền">
                <button type="button" class="rp-stat" data-state="all" aria-pressed="true"><span>Toàn bộ quyền</span><strong>@Model.TotalPermissionCount</strong><small>Trong @Model.Groups.Count nhóm chức năng</small></button>
                <button type="button" class="rp-stat" data-state="selected" aria-pressed="false"><span>Đã chọn</span><strong id="selectedPermissionCount">@Model.SelectedPermissionCount</strong><small>Xem những việc được phép làm</small></button>
                <button type="button" class="rp-stat" data-state="unselected" aria-pressed="false"><span>Chưa chọn</span><strong id="unselectedPermissionCount">@(Model.TotalPermissionCount - Model.SelectedPermissionCount)</strong><small>Tìm và thêm quyền còn thiếu</small></button>
                <button type="button" class="rp-stat rp-stat-changes" data-state="changed" aria-pressed="false"><span>Thay đổi chưa lưu</span><strong id="changedPermissionCount">0</strong><small id="changeSummary">Chưa có thay đổi</small></button>
            </div>
            <div class="rp-workspace">
                <aside class="rp-sidebar" aria-label="Nhóm chức năng"><h2>Nhóm chức năng</h2>
                    <button type="button" class="rp-group-tab" data-group-filter="all" aria-pressed="true"><span>Tất cả nhóm</span><small>@Model.TotalPermissionCount</small></button>
                    @for (var i = 0; i < Model.Groups.Count; i++)
                    {
                        var group = Model.Groups[i];
                        <button type="button" class="rp-group-tab" data-group-filter="@i" aria-pressed="false"><span>@group.GroupName</span><small data-group-count="@i">@group.SelectedCount / @group.TotalCount</small></button>
                    }
                    <p class="rp-sidebar-note"><i class="bx bx-info-circle" aria-hidden="true"></i> Các thay đổi chỉ có hiệu lực khi bạn bấm lưu phân quyền.</p>
                </aside>
                <main class="rp-content">
                    <div class="rp-toolbar">
                        <label for="permissionSearch">Tìm chức năng hoặc quyền</label>
                        <div class="rp-search"><i class="bx bx-search" aria-hidden="true"></i><input id="permissionSearch" type="search" placeholder="Ví dụ: in tem, nhập hàng, hoàn tiền…" autocomplete="off" /></div>
                        <div class="rp-tools"><span id="resultCount" role="status">@Model.TotalPermissionCount quyền</span><button type="button" class="rp-text-link" id="clearFilters">Xóa bộ lọc</button><label class="rp-code-toggle"><input type="checkbox" id="showCodes" /> Hiện mã quyền</label></div>
                        <div class="rp-bulk"><span>Quyền đang hiển thị:</span><button type="button" class="rp-btn rp-small" id="selectVisible">Chọn tất cả</button><button type="button" class="rp-btn rp-small" id="clearVisible">Bỏ chọn</button><span class="rp-muted">Không đổi các quyền bị ẩn bởi bộ lọc.</span></div>
                    </div>
                    <div id="permissionGroups">
                        @for (var i = 0; i < Model.Groups.Count; i++)
                        {
                            <partial name="_PermissionGroupCard" model="Model.Groups[i]" view-data='new ViewDataDictionary(ViewData) { ["Index"] = i }' />
                        }
                    </div>
                    <div class="rp-empty" id="noResults" hidden><i class="bx bx-search-alt" aria-hidden="true"></i><h3>Không tìm thấy quyền phù hợp</h3><p>Thử từ khóa khác hoặc xóa bộ lọc để xem đầy đủ.</p><button type="button" class="rp-btn" id="resetSearch">Xóa bộ lọc</button></div>
                </main>
            </div>
            <footer class="rp-save-bar">
                <div><strong id="saveTitle">Chưa có thay đổi</strong><p id="saveSummary">Chọn quyền để thêm hoặc bỏ quyền của vai trò này.</p></div>
                <div class="rp-actions"><button type="button" class="rp-btn" id="undoChanges" disabled>Hoàn tác</button><button type="submit" class="rp-btn rp-primary" id="reviewChanges" disabled><i class="bx bx-check-shield" aria-hidden="true"></i> Kiểm tra & lưu</button></div>
            </footer>
            <dialog class="rp-dialog" id="changesDialog" aria-labelledby="changesTitle">
                <header><div><p class="rp-eyebrow">KIỂM TRA TRƯỚC KHI LƯU</p><h2 id="changesTitle">Cập nhật quyền cho @Model.RoleName</h2></div><button type="button" class="rp-btn rp-close" data-close-dialog aria-label="Đóng">×</button></header>
                <p class="rp-dialog-note">Áp dụng cho @Model.UserCount nhân viên đang dùng vai trò này. Những quyền khác được giữ nguyên.</p>
                <div id="changesList" class="rp-changes-list"></div>
                <footer><button type="button" class="rp-btn" data-close-dialog>Quay lại chỉnh sửa</button><button type="button" class="rp-btn rp-primary" id="confirmSave">Lưu phân quyền</button></footer>
            </dialog>
        </form>
    }
</div>
@section PageScripts {
    <script src="~/Admin/js/role-permissions.js" asp-append-version="true"></script>
}
