@model GaoApp.Application.DTOs.Security.Permissions.RolePermissionGroupDto
@{ var index = (int)(ViewData["Index"] ?? 0); }
<section class="rp-group" data-group="@index" aria-labelledby="groupTitle_@index">
    <header class="rp-group-heading"><h2 id="groupTitle_@index">@Model.GroupName</h2><span data-group-count="@index">@Model.SelectedCount / @Model.TotalCount</span></header>
    @foreach (var row in Model.Rows)
    {
        <section class="rp-feature" data-feature="@row.DisplayName">
            <header><h3>@row.DisplayName</h3><label class="rp-select-feature"><input type="checkbox" class="rp-feature-check" aria-label="Chọn các quyền đang hiển thị của @row.DisplayName" /> Chọn mục này</label></header>
            <div class="rp-permission-grid">
            @foreach (var cell in row.Cells.Where(c => c.IsAvailable && c.PermissionId.HasValue))
            {
                <label class="rp-permission" data-search="@Model.GroupName @row.DisplayName @cell.ActionDisplayName @cell.PermissionCode" data-title="@cell.ActionDisplayName" data-group-label="@Model.GroupName">
                    <input class="permission-checkbox" type="checkbox" name="SelectedPermissionIds" value="@cell.PermissionId" checked="@cell.IsChecked" data-initial="@(cell.IsChecked ? "true" : "false")" />
                    <span class="rp-permission-text"><span>@cell.ActionDisplayName</span><code class="rp-permission-code">@cell.PermissionCode</code></span>
                    <small class="rp-change-mark" aria-hidden="true"></small>
                </label>
            }
            </div>
        </section>
    }
</section>
