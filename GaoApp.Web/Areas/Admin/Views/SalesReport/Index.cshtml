@{
    ViewData["Title"] = "Báo cáo bán hàng";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";
    var overviewUrl = Url.Action("Index", "SalesExecutiveReport", new
    {
        area = "Admin",
        fromDate = Context.Request.Query["fromDate"].ToString(),
        toDate = Context.Request.Query["toDate"].ToString(),
        compare = Context.Request.Query["compare"].ToString(),
        terminalId = Context.Request.Query["terminalId"].ToString(),
        customerState = Context.Request.Query["customerState"].ToString()
    });
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/reports/sales-report.css" asp-append-version="true" />
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact sales-report-page-header">
            <div class="gds-page-header__main">
                <div class="sales-report-eyebrow">MANAGEMENT INTELLIGENCE</div>
                <h3 class="gds-page-header__title">Báo cáo bán hàng</h3>
                <p class="gds-page-header__subtitle mb-0">Đi từ chỉ số tổng hợp xuống đơn hàng, sản phẩm, giảm giá, trả hàng và Void.</p>
            </div>
            <div class="gds-page-header__actions">
                <a class="btn btn-label-secondary" data-sales-overview-link href="@overviewUrl">
                    <i class="bx bx-left-arrow-alt" aria-hidden="true"></i> Tổng quan kinh doanh
                </a>
                <button class="btn btn-outline-primary" type="button" id="salesDetailRefreshButton">
                    <i class="bx bx-refresh" aria-hidden="true"></i> Làm mới
                </button>
            </div>
        </div>
    </div>
}

<div class="sales-report-page sales-detail-page gds-page"
     data-sales-detail-report
     data-context-url="@Url.Action("Context", "SalesReport", new { area = "Admin" })"
     data-orders-url="@Url.Action("Orders", "SalesReport", new { area = "Admin" })"
     data-products-url="@Url.Action("Products", "SalesReport", new { area = "Admin" })"
     data-discounts-url="@Url.Action("Discounts", "SalesReport", new { area = "Admin" })"
     data-returns-url="@Url.Action("Returns", "SalesReport", new { area = "Admin" })"
     data-voids-url="@Url.Action("Voids", "SalesReport", new { area = "Admin" })"
     data-overview-data-url="@Url.Action("GetData", "SalesExecutiveReport", new { area = "Admin" })"
     data-order-detail-base-url="@Url.Content("~/admin/pos/order-detail")"
     aria-busy="true">

    <div id="salesDetailLiveRegion" class="visually-hidden" aria-live="polite"></div>

    <section class="card shadow-sm border-0 sales-report-filter-card" aria-label="Bộ lọc báo cáo bán hàng">
        <div class="card-body">
            <div class="sales-report-filter-bar sales-detail-filter-bar">
                <div><label class="form-label" for="salesDetailFromDate">Từ ngày</label><input class="form-control" type="date" id="salesDetailFromDate" /></div>
                <div><label class="form-label" for="salesDetailToDate">Đến ngày</label><input class="form-control" type="date" id="salesDetailToDate" /></div>
                <div><label class="form-label" for="salesDetailTerminal">Terminal</label><select class="form-select" id="salesDetailTerminal"><option value="">Tất cả terminal</option></select></div>
                <div><label class="form-label" for="salesDetailCustomerState">Khách hàng</label><select class="form-select" id="salesDetailCustomerState"><option value="all">Tất cả</option><option value="linked">Có khách hàng</option><option value="guest">Khách lẻ</option></select></div>
            </div>
            <div id="salesDetailDrillContext" class="sales-detail-drill-context mt-3" hidden></div>
        </div>
    </section>

    <nav class="sales-detail-tabs" aria-label="Nhóm báo cáo bán hàng">
        <button type="button" data-sales-detail-segment="overview">Tổng quan</button>
        <button type="button" data-sales-detail-segment="orders">Đơn bán</button>
        <button type="button" data-sales-detail-segment="products">Sản phẩm</button>
        <button type="button" data-sales-detail-segment="discounts">Giảm giá</button>
        <button type="button" data-sales-detail-segment="returns">Trả hàng & hoàn tiền</button>
        <button type="button" data-sales-detail-segment="void">Void</button>
    </nav>

    <section id="salesDetailOverview" class="sales-detail-overview" hidden>
        <div class="sales-detail-summary-grid">
            <article class="card shadow-sm border-0"><div class="card-body"><span>Net Sales</span><strong id="salesDetailOverviewNet">—</strong></div></article>
            <article class="card shadow-sm border-0"><div class="card-body"><span>Đơn bán</span><strong id="salesDetailOverviewOrders">—</strong></div></article>
            <article class="card shadow-sm border-0"><div class="card-body"><span>Returns</span><strong id="salesDetailOverviewReturns">—</strong></div></article>
            <article class="card shadow-sm border-0"><div class="card-body"><span>Refund Amount</span><strong id="salesDetailOverviewRefunds">—</strong></div></article>
        </div>
        <div class="card shadow-sm border-0 mt-3"><div class="card-body">
            <div class="d-flex justify-content-between gap-3 flex-wrap"><div><h5 class="mb-1">Sales Reconciliation</h5><p class="text-muted mb-0">Gross Sales − Discounts − Returns = Net Sales</p></div><a id="salesDetailOpenExecutive" class="btn btn-sm btn-label-primary" data-sales-overview-link href="@overviewUrl">Mở dashboard biểu đồ</a></div>
            <div class="sales-detail-bridge mt-3"><span>Gross Sales <strong id="salesDetailBridgeGross">—</strong></span><span>− Discounts <strong id="salesDetailBridgeDiscounts">—</strong></span><span>− Returns <strong id="salesDetailBridgeReturns">—</strong></span><span>= Net Sales <strong id="salesDetailBridgeNet">—</strong></span></div>
        </div></div>
    </section>

    <section id="salesDetailDataSection" class="card shadow-sm border-0" hidden>
        <div class="card-body">
            <div class="sales-detail-table-toolbar">
                <div><h5 id="salesDetailTitle" class="mb-1">Đơn bán</h5><p id="salesDetailSubtitle" class="text-muted mb-0"></p></div>
                <div class="sales-detail-table-controls">
                    <input id="salesDetailSearch" class="form-control" type="search" maxlength="100" placeholder="Tìm mã đơn, khách hàng..." />
                    <select id="salesDetailSort" class="form-select"></select>
                    <select id="salesDetailPageSize" class="form-select" aria-label="Số dòng mỗi trang"><option value="10">10 dòng</option><option value="25" selected>25 dòng</option><option value="50">50 dòng</option><option value="100">100 dòng</option></select>
                </div>
            </div>

            <div id="salesDetailLoading" class="sales-detail-loading py-5 text-center" hidden><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Đang tải...</div>
            <div id="salesDetailState" class="sales-detail-state py-5 text-center" hidden><i class="bx bx-search-alt"></i><h5 class="mt-2" id="salesDetailStateTitle">Chưa có dữ liệu</h5><p class="text-muted mb-0" id="salesDetailStateMessage"></p></div>
            <div id="salesDetailTableWrap" class="table-responsive" hidden><table class="table align-middle mb-0"><thead id="salesDetailTableHead"></thead><tbody id="salesDetailTableBody"></tbody></table></div>

            <div class="sales-detail-pagination mt-3">
                <span id="salesDetailPageMeta" class="text-muted">—</span>
                <div class="btn-group"><button class="btn btn-sm btn-label-secondary" id="salesDetailPrev">Trước</button><button class="btn btn-sm btn-label-secondary" id="salesDetailNext">Sau</button></div>
            </div>
        </div>
    </section>
</div>

@section VendorScripts {
    <script src="~/vendor/libs/apex-charts/apexcharts.js" asp-append-version="true"></script>
}
@section PageScripts {
    <script src="~/Admin/js/reports/sales-report.page.js" asp-append-version="true"></script>
}
