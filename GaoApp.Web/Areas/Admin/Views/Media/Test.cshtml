@{
    ViewData["Title"] = "Test Temp Upload";
    Layout = "_ContentNavbarLayout";
}

@section VendorStyles {
    <link href="~/lib/filepond/filepond.min.css" rel="stylesheet"  asp-append-version="true" />
    <link href="~/lib/filepond/filepond-plugin-image-preview.min.css" rel="stylesheet"  asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin/css/media-workspace.mobile.css" asp-append-version="true" />
}

<input type="file" id="testUpload" name="file" multiple />
@Html.AntiForgeryToken()

@section PageScripts {
    <script src="~/lib/filepond/filepond.min.js" asp-append-version="true"></script>
    <script src="~/lib/filepond/filepond-plugin-image-preview.min.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // register plugin (optional)
            if (window.FilePondPluginImagePreview) {
                FilePond.registerPlugin(FilePondPluginImagePreview);
            }

            const input = document.querySelector('#testUpload');
            if (!input) return;

            // lấy antiforgery token
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrf = tokenEl ? tokenEl.value : '';

            FilePond.create(input, {
                allowMultiple: true,
                name: 'file', // field name gửi lên server
                server: {
                    process: {
                        url: '/admin/media/temp',
                        method: 'POST',
                        headers: { 'RequestVerificationToken': csrf }
                    },
                    revert: {
                        url: '/admin/media/temp',
                        method: 'DELETE',
                        headers: { 'RequestVerificationToken': csrf }
                    }
                }
            });
        });
    </script>
    <script src="~/Admin/js/media-workspace.mobile.js" asp-append-version="true" defer></script>
}
