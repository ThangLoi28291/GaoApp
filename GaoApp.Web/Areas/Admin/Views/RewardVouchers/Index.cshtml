@using GaoApp.Application.Common.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Phiếu giảm giá khách hàng";
    ViewData["container"] = "container-fluid";
    ViewData["menuFixed"] = "layout-menu-fixed";
    Layout = "_ContentNavbarLayout";

    var canManageRewardSettings =
        (await AuthorizationService.AuthorizeAsync(
            User,
            PermissionCodes.System.Setting.Update))
        .Succeeded;
}

@section header {
    <div data-gao-ui="modern" class="w-100">
        <div class="gds-page-header gds-page-header--compact">
            <div class="gds-page-header__main">
                <h3 class="gds-page-header__title">Phiếu giảm giá khách hàng</h3>
                <p class="gds-page-header__subtitle mb-0">Theo dõi phiếu được đổi từ điểm thưởng và sử dụng tại POS.</p>
            </div>
            <div class="gds-page-header__actions">

                @if (canManageRewardSettings)
                {
                    <a asp-area="Admin"
                       asp-controller="RewardSettings"
                       asp-action="Index"
                       class="btn btn-label-primary gds-action-button"
                       title="Quản lý chính sách tích điểm và phát hành voucher">
                        <i class="bx bx-cog"></i>
                        <span>Cấu hình tích điểm</span>
                    </a>
                }

                <button type="button"
                        class="btn btn-label-secondary gds-action-button"
                        id="rewardVoucherReload">
                    <i class="bx bx-refresh"></i>
                    <span>Tải lại</span>
                </button>

            </div>
        </div>
    </div>
}

@section VendorStyles {
    <link rel="stylesheet" href="~/Admin/css/reward-voucher-index.css" asp-append-version="true" />
}

<div class="reward-voucher-index-page gds-page"
     data-gao-ui="modern"
     data-reward-voucher-index
     data-data-url="/admin/reward-vouchers/data"
     data-quick-view-base-url="/admin/reward-vouchers"
     data-legacy-api-base-url="/admin/api/customers/reward-vouchers">

    <div class="alert alert-danger reward-voucher-error d-none mb-0" id="rewardVoucherError" role="alert">
        <i class="bx bx-error-circle"></i><span id="rewardVoucherErrorMessage">Không thể xử lý yêu cầu.</span>
        <button type="button" class="btn-close" id="rewardVoucherDismissError" aria-label="Đóng"></button>
    </div>

    <section aria-label="Tổng quan phiếu giảm giá">
        <div class="row row-cols-2 row-cols-xl-4 g-3">
            <div class="col">
                <div class="card shadow-sm border-0 gds-kpi-card h-100" data-voucher-kpi="total">
                    <span class="gds-kpi-card__icon is-primary"><i class="bx bx-receipt"></i></span>
                    <span class="gds-kpi-card__body"><span class="gds-kpi-card__label">Tổng phiếu</span><span class="gds-kpi-card__value text-primary" id="rewardVoucherStatTotal">0</span><small>Trong phạm vi tra cứu</small></span>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 gds-kpi-card h-100" data-voucher-kpi="available">
                    <span class="gds-kpi-card__icon is-success"><i class="bx bx-check-circle"></i></span>
                    <span class="gds-kpi-card__body"><span class="gds-kpi-card__label">Khả dụng</span><span class="gds-kpi-card__value text-success" id="rewardVoucherStatAvailable">0</span><small>Có thể sử dụng tại POS</small></span>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 gds-kpi-card h-100" data-voucher-kpi="used">
                    <span class="gds-kpi-card__icon bg-label-info text-info"><i class="bx bx-cart-download"></i></span>
                    <span class="gds-kpi-card__body"><span class="gds-kpi-card__label">Đã sử dụng</span><span class="gds-kpi-card__value text-info" id="rewardVoucherStatUsed">0</span><small>Đã áp dụng cho đơn hàng</small></span>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 gds-kpi-card h-100" data-voucher-kpi="unavailable">
                    <span class="gds-kpi-card__icon bg-label-danger text-danger"><i class="bx bx-block"></i></span>
                    <span class="gds-kpi-card__body"><span class="gds-kpi-card__label">Không khả dụng</span><span class="gds-kpi-card__value text-danger" id="rewardVoucherStatUnavailable">0</span><small>Đã hủy + hết hạn + đã khóa</small></span>
                </div>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0 reward-voucher-filter-panel" aria-label="Bộ lọc phiếu giảm giá">
        <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm rounded bg-label-primary"><i class="bx bx-filter-alt"></i></span>
                <div><h5 class="mb-0 text-dark">Tra cứu phiếu</h5><small class="text-muted">Tìm theo mã phiếu, khách hàng, liên hệ hoặc mã tham chiếu.</small></div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="reward-voucher-filter-bar">
                <div class="reward-voucher-search-wrap">
                    <label for="rewardVoucherKeyword" class="form-label fw-semibold text-dark">Tìm kiếm</label>
                    <div class="gds-search-field">
                        <i class="bx bx-search"></i>
                        <input type="search" id="rewardVoucherKeyword" class="form-control" placeholder="Mã phiếu, khách hàng, SĐT, email, tham chiếu..." autocomplete="off" />
                        <button type="button" id="rewardVoucherClearSearch" class="gds-search-field__clear d-none" aria-label="Xóa tìm kiếm"><i class="bx bx-x"></i></button>
                    </div>
                </div>
                <div class="reward-voucher-desktop-filters">
                    <div>
                        <label for="rewardVoucherStatus" class="form-label">Trạng thái</label>
                        <select id="rewardVoucherStatus" class="form-select">
                            <option value="all">Tất cả trạng thái</option>
                            <option value="available">Khả dụng</option>
                            <option value="used">Đã sử dụng</option>
                            <option value="cancelled">Đã hủy</option>
                            <option value="expired">Hết hạn</option>
                            <option value="locked">Đã khóa</option>
                        </select>
                    </div>
                    <div><label for="rewardVoucherFromDate" class="form-label">Từ ngày</label><input type="date" id="rewardVoucherFromDate" class="form-control" /></div>
                    <div><label for="rewardVoucherToDate" class="form-label">Đến ngày</label><input type="date" id="rewardVoucherToDate" class="form-control" /></div>
                    <div class="reward-voucher-compact-filter"><label for="rewardVoucherPageSize" class="form-label">Số dòng / trang</label><select id="rewardVoucherPageSize" class="form-select"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select></div>
                    <button type="button" class="gds-icon-button reward-voucher-reset-button d-none" id="rewardVoucherResetFilters" aria-label="Xóa bộ lọc"><i class="bx bx-reset"></i></button>
                </div>
                <button type="button" class="btn btn-label-primary reward-voucher-mobile-filter-button" id="rewardVoucherOpenMobileFilters" data-bs-toggle="offcanvas" data-bs-target="#rewardVoucherMobileFilterSheet">
                    <i class="bx bx-filter-alt"></i><span>Bộ lọc</span><span class="badge bg-primary rounded-pill d-none" id="rewardVoucherActiveFilterCount">0</span>
                </button>
            </div>
        </div>
    </section>

    <section class="gds-list-panel reward-voucher-results-panel" id="rewardVoucherResultsPanel" aria-label="Danh sách phiếu giảm giá" aria-live="polite" aria-busy="false">
        <div class="reward-voucher-results-heading">
            <div><h5 class="mb-1 text-dark">Danh sách phiếu</h5><small class="text-muted">Nhấp đúp một dòng hoặc chọn biểu tượng mắt để xem nhanh.</small></div>
            <span class="reward-voucher-default-scope"><i class="bx bx-list-check"></i> Mặc định: Tất cả</span>
        </div>
        <div class="reward-voucher-desktop-list" id="rewardVoucherDesktopList">
            <div class="table-responsive">
                <table class="table align-middle gds-table mb-0 reward-voucher-table">
                    <thead><tr><th>Phiếu</th><th>Khách hàng</th><th>Giá trị</th><th>Phát hành / sử dụng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody id="rewardVoucherTableBody"><tr><td colspan="6" class="gds-empty">Đang tải dữ liệu...</td></tr></tbody>
                </table>
            </div>
        </div>
        <div class="reward-voucher-mobile-list" id="rewardVoucherMobileList"><div class="gds-empty">Đang tải dữ liệu...</div></div>
    </section>

    <div class="gds-list-footer reward-voucher-list-footer">
        <div class="gds-list-footer__summary" id="rewardVoucherPagingInfo">0 kết quả</div>
        <nav aria-label="Phân trang phiếu giảm giá"><ul class="pagination pagination-sm mb-0 reward-voucher-pagination" id="rewardVoucherPageNumbers"></ul></nav>
    </div>

    <form id="rewardVoucherAntiforgery" class="d-none" method="post">@Html.AntiForgeryToken()</form>

    <div class="offcanvas offcanvas-bottom reward-voucher-filter-sheet" tabindex="-1" id="rewardVoucherMobileFilterSheet" aria-labelledby="rewardVoucherMobileFilterTitle">
        <div class="offcanvas-header"><div><h5 class="offcanvas-title" id="rewardVoucherMobileFilterTitle">Bộ lọc phiếu</h5><small class="text-muted">Thu hẹp danh sách trên thiết bị di động.</small></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
        <div class="offcanvas-body">
            <div class="row g-3">
                <div class="col-12"><label for="rewardVoucherMobileStatus" class="form-label">Trạng thái</label><select id="rewardVoucherMobileStatus" class="form-select"><option value="all">Tất cả trạng thái</option><option value="available">Khả dụng</option><option value="used">Đã sử dụng</option><option value="cancelled">Đã hủy</option><option value="expired">Hết hạn</option><option value="locked">Đã khóa</option></select></div>
                <div class="col-6"><label for="rewardVoucherMobileFromDate" class="form-label">Từ ngày</label><input type="date" id="rewardVoucherMobileFromDate" class="form-control" /></div>
                <div class="col-6"><label for="rewardVoucherMobileToDate" class="form-label">Đến ngày</label><input type="date" id="rewardVoucherMobileToDate" class="form-control" /></div>
                <div class="col-12"><label for="rewardVoucherMobilePageSize" class="form-label">Số dòng / trang</label><select id="rewardVoucherMobilePageSize" class="form-select"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select></div>
            </div>
        </div>
        <div class="offcanvas-footer reward-voucher-filter-sheet__footer"><button type="button" class="btn btn-label-secondary" id="rewardVoucherMobileClearFilters">Xóa lọc</button><button type="button" class="btn btn-primary flex-grow-1" id="rewardVoucherMobileApplyFilters">Áp dụng</button></div>
    </div>

    <div class="modal fade reward-voucher-quick-sheet" id="rewardVoucherQuickView" tabindex="-1" aria-labelledby="rewardVoucherQuickTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0"><div><h5 class="modal-title" id="rewardVoucherQuickTitle">Thông tin phiếu</h5><small class="text-muted" id="rewardVoucherQuickCode">—</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="reward-voucher-profile-head"><span class="reward-voucher-avatar"><i class="bx bx-gift"></i></span><div><h4 id="rewardVoucherQuickCustomer">—</h4><div class="d-flex flex-wrap gap-2" id="rewardVoucherQuickBadges"></div></div></div>
                    <div class="reward-voucher-quick-grid">
                        <div class="reward-voucher-quick-item"><span>Điện thoại</span><strong id="rewardVoucherQuickPhone">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Email</span><strong id="rewardVoucherQuickEmail">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Giá trị phiếu</span><strong class="text-primary" id="rewardVoucherQuickValue">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Tiền tích lũy đã trừ</span><strong id="rewardVoucherQuickRequiredAmount">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Phát hành</span><strong id="rewardVoucherQuickIssuedAt">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Sử dụng</span><strong id="rewardVoucherQuickUsedAt">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Mã khách hàng</span><strong id="rewardVoucherQuickCustomerCode">—</strong></div>
                        <div class="reward-voucher-quick-item"><span>Tham chiếu</span><strong id="rewardVoucherQuickReference">—</strong></div>
                        <div class="reward-voucher-quick-item is-wide"><span>Liên kết đơn hàng</span><strong id="rewardVoucherQuickOrderLink">—</strong></div>
                        <div class="reward-voucher-quick-item is-wide"><span>Ghi chú</span><strong id="rewardVoucherQuickDescription">—</strong></div>
                    </div>
                </div>
                <div class="modal-footer border-0 reward-voucher-quick-actions">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-outline-info reward-voucher-action" id="rewardVoucherOpenHistory"><i class="bx bx-history"></i> Lịch sử</button>
                    <button type="button" class="btn btn-outline-primary reward-voucher-action" id="rewardVoucherPrint"><i class="bx bx-printer"></i> In phiếu</button>
                    <button type="button" class="btn btn-warning reward-voucher-action d-none" id="rewardVoucherLock"><i class="bx bx-lock"></i> Khóa</button>
                    <button type="button" class="btn btn-success reward-voucher-action d-none" id="rewardVoucherUnlock"><i class="bx bx-lock-open"></i> Mở khóa</button>
                    <button type="button" class="btn btn-danger reward-voucher-action d-none" id="rewardVoucherCancel"><i class="bx bx-x-circle"></i> Hủy phiếu</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade reward-voucher-history-sheet" id="rewardVoucherHistorySheet" tabindex="-1" aria-labelledby="rewardVoucherHistoryTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header border-0"><div><h5 class="modal-title" id="rewardVoucherHistoryTitle">Lịch sử phiếu hiện có</h5><small class="text-muted">Thông tin tổng hợp từ trạng thái và ghi chú hiện tại, không phải nhật ký kiểm toán đầy đủ.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="reward-voucher-history-list" id="rewardVoucherHistoryList"><div class="gds-empty">Đang tải lịch sử...</div></div></div><div class="modal-footer border-0"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button></div></div></div>
    </div>

    <div class="modal fade reward-voucher-confirmation-sheet" id="rewardVoucherConfirmation" tabindex="-1" aria-labelledby="rewardVoucherConfirmationTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header border-0"><div><h5 class="modal-title" id="rewardVoucherConfirmationTitle">Xác nhận thay đổi</h5><small class="text-muted" id="rewardVoucherConfirmationIdentity">—</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert mb-3" id="rewardVoucherConfirmationMessage"></div><label for="rewardVoucherActionReason" class="form-label">Lý do <span class="text-muted">(không bắt buộc)</span></label><textarea id="rewardVoucherActionReason" class="form-control" rows="3" maxlength="500" placeholder="Nhập lý do nếu cần..."></textarea><div class="alert alert-warning mt-3 mb-0 d-none" id="rewardVoucherCancelWarning"><i class="bx bx-error"></i> Hủy phiếu không tự hoàn lại điểm cho khách hàng.</div></div><div class="modal-footer border-0"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Quay lại</button><button type="button" class="btn" id="rewardVoucherConfirmationSubmit">Xác nhận</button></div></div></div>
    </div>
</div>

@section PageScripts {
    <script src="~/Admin/js/printing/print.lifecycle.js" asp-append-version="true"></script>
    <script src="~/Admin/js/reward-vouchers.js" asp-append-version="true"></script>
}
