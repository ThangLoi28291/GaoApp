@{
    Layout = "_Layout";
    var statusCode = ViewBag.StatusCode ?? 500;
    var message = ViewBag.Message ?? "Đã xảy ra lỗi.";
    var traceId = ViewBag.TraceId ?? "";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-5">
            <div class="mb-3">
                <span class="badge bg-danger">Lỗi @statusCode</span>
            </div>

            <h2 class="mb-3">Có lỗi xảy ra</h2>
            <p class="text-muted mb-4">@message</p>

            <div class="mb-4">
                <small class="text-secondary">TraceId: @traceId</small>
            </div>

            <div class="d-flex gap-2">
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Quay lại</a>
                <a href="/" class="btn btn-primary">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>