{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-E059ENS\\SQLEXPRESS;Database=GaoAppDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AppUrl": {
    "BaseUrl": "https://localhost:5001",
    "AdminUrl": "https://admin.localhost:5001"
  },
  "AcbCallbackRouting": {
    "Hosts": [ "www.gaomart.com.vn" ]
  },
  "Tenant": {
    "RootDomain": "gaomart.com.vn",
    "AdminSubdomain": "admin"
  },
  "Storage": {
    "UploadRoot": "wwwroot/uploads",
    "CreateIfMissing": true
  },
  "InputInvoiceLibrary": {
    "Enabled": false,
    "RootPath": "",
    "MaxMonthPartitions": 12,
    "MaxCandidates": 200
  },
  "TaxCodeLookup": {
    "Enabled": true,
    "Provider": "VietQR",
    "BaseUrl": "https://api.vietqr.io",
    "TimeoutSeconds": 10
  },
  "SeedData": {
    "EnableDemoSeed": false,
    "EnableDefaultAdminSeed": false
  },
  "ReceivingWorkbench": {
    "Enabled": false,
    "ProvisionalItemsEnabled": false
  },
  "Reports": {
    "Profit": {
      "MaxConcurrent": 2,
      "MaxQueued": 48,
      "QueueTimeoutMilliseconds": 5000,
      "ExecutionTimeoutSeconds": 30,
      "MaxSourceRows": 100000
    }
  },
  "Security": {
    "LoginRateLimit": {
      "IpAttemptsPerMinute": 120,
      "AccountAttemptsPerMinute": 10
    }
  },
  "DataProtection": {
    "KeysPath": "C:\\GaoAppData\\DataProtectionKeys"
  },
  "AllowedHosts": "localhost;127.0.0.1;admin.gaomart.com.vn;*.gaomart.com.vn",
  "Proxy": {
    "EnableForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "GaoApp.Web"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/Logs/web-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ]
  }
}
