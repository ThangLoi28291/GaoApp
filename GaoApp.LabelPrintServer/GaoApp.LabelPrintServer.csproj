<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <ProjectReference Include="../GaoApp.Infrastructure/GaoApp.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup><None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <None Update="README.md;Install-Service.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup><GaoAppDeploymentSettings>$(MSBuildThisFileDirectory)../eng/deployment/labelserver.appsettings.json</GaoAppDeploymentSettings></PropertyGroup>
  <Import Project="../eng/deployment/PublishSafety.targets" />
</Project>
