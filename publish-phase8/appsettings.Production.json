{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AppUrl": {
    "BaseUrl": "https://gaomart.com.vn",
    "AdminUrl": "https://admin.gaomart.com.vn"
  },
  "Tenant": {
    "RootDomain": "gaomart.com.vn",
    "AdminSubdomain": "admin"
  },
  "Storage": {
    "UploadRoot": "C:\\GaoAppData\\Uploads",
    "CreateIfMissing": false
  },
  "TaxCodeLookup": {
    "Enabled": true,
    "Provider": "VietQR",
    "BaseUrl": "https://api.vietqr.io",
    "TimeoutSeconds": 10
  },
  "SeedData": {
    "EnableDemoSeed": false,
    "EnableDefaultAdminSeed": false
  },
  "DataProtection": {
    "KeysPath": "C:\\GaoAppData\\DataProtectionKeys"
  },
  "AllowedHosts": "gaomart.com.vn;admin.gaomart.com.vn;*.gaomart.com.vn",
  "Proxy": {
    "EnableForwardedHeaders": true,
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "GaoApp.Web"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\GaoAppData\\Logs\\web-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ]
  }
}
