<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!--
			CHỈ giữ Microsoft.Extensions.Hosting.
			Không khai báo lại các package Microsoft.Extensions.* khác với version lệch,
			tránh lỗi downgrade/transitive conflict.
		-->
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

		<!-- EF design-time support -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Serilog -->
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>
	
	

	<ItemGroup>
		<!-- Vì GaoApp.Migrator nằm cùng cấp với GaoApp.Application / Infrastructure / Web -->
		<ProjectReference Include="..\GaoApp.Application\GaoApp.Application.csproj" />
		<ProjectReference Include="..\GaoApp.Infrastructure\GaoApp.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.Production.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

  <PropertyGroup>
    <GaoAppDeploymentSettings>$(MSBuildThisFileDirectory)..\eng\deployment\migrator.appsettings.json</GaoAppDeploymentSettings>
  </PropertyGroup>
  <Import Project="..\eng\deployment\PublishSafety.targets" />
</Project>
